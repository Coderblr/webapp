    // handler above — a form submit is the SINGLE MOST LIKELY trigger
    // for an immediate navigation (that's the entire point of submit),
    // so this had NO protection at all before this fix, unlike clicks.
    // `HTMLFormElement.submit()` (used to release it below) bypasses the
    // 'submit' event entirely per spec — no re-entry guard needed the
    // way clicked.click() needed one, this genuinely just submits.
    const form = e.target;
    if (form.__aiRecReleased) { form.__aiRecReleased = false; return; }
    e.preventDefault();
    pushAction('submit', form, {});
