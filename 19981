"""
Auto-generated Page Object.
Locators live in locators.json (not hard-coded here) so the self-healing
agent can patch a broken selector without touching this file.
"""
from __future__ import annotations
import json
import time
from pathlib import Path

from playwright.sync_api import Page, Error as PlaywrightError, TimeoutError as PlaywrightTimeoutError

LOCATORS_PATH = Path(__file__).parent / "locators.json"

# Self-heal writes go back to LOCATORS_PATH by default (same directory as
# the generated page object). This is the shared locators.json that
# build_artifacts() writes fresh on every run.
#
# Per-run scoping (Fix 1): if the environment sets LOCATORS_OVERRIDE_PATH,
# the page object reads from that path and writes healed locators there
# instead of the shared LOCATORS_PATH. run_recording.py sets this env var
# to a copy inside the run's output dir so healed locators from run N
# never corrupt run N+1.
import os as _os
_LOCATORS_OVERRIDE = _os.environ.get("LOCATORS_OVERRIDE_PATH")
_EFFECTIVE_LOCATORS_PATH = Path(_LOCATORS_OVERRIDE) if _LOCATORS_OVERRIDE else LOCATORS_PATH

import logging as _logging
logger = _logging.getLogger(__name__)

# A recorded link that is hidden inside a closed hover/dropdown menu gets
# its parent menus opened automatically before it is used (see
# BasePage._reveal_in_menu). Set AUTO_OPEN_MENUS=false to disable.
_AUTO_OPEN_MENUS = _os.environ.get("AUTO_OPEN_MENUS", "true").lower().strip() != "false"

# Menus are opened WITHOUT the mouse pointer: the browser is told to treat
# the parent items as hovered (the same "force :hover" switch DevTools has),
# so it makes no difference where the real mouse is, or whether anyone
# touches it during a run. Moving the pointer is kept only as the fallback.
# Set MENU_OPEN_WITHOUT_MOUSE=false to go back to pointer-only.
_POINTER_FREE_MENUS = _os.environ.get("MENU_OPEN_WITHOUT_MOUSE", "true").lower().strip() != "false"

