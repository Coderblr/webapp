import { useEffect } from "react";
import { useRouter } from "next/router";
import Head from "next/head";
import { useAuth } from "@/context/AuthContext";
import { setToken } from "@/lib/auth-storage";

/**
 * Not reachable yet - nothing redirects here until SSO is actually wired
 * up (see backend/auth_routes.py's sso_callback docstring for exactly how
 * it will: after validating the IdP's assertion and issuing our own JWT
 * the same way a normal login does, it redirects the browser to
 * `${FRONTEND_URL}/sso/complete?token=<jwt>`).
 *
 * This page's only job is to grab that token out of the URL, store it the
 * same way a normal username/password login does (see
 * context/AuthContext.js's login()), and continue into the app - so the
 * user's experience is identical either way once SSO lands, and nothing
 * here needs to change when it does.
 */
export default function SsoCompletePage() {
  const router = useRouter();
  const { refreshUser } = useAuth();

  useEffect(() => {
    if (!router.isReady) return;

    const { token, error } = router.query;

    if (error) {
      const reason = Array.isArray(error) ? error[0] : error;
      router.replace({ pathname: "/login", query: { reason } });
      return;
    }

    if (!token) {
      router.replace("/login");
      return;
    }

    setToken(Array.isArray(token) ? token[0] : token);
    refreshUser()
      .then((user) => router.replace(user.must_change_password ? "/change-password" : "/dashboard"))
      .catch(() =>
        router.replace({ pathname: "/login", query: { reason: "SSO sign-in failed - please try again." } })
      );
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [router.isReady, router.query]);

  return (
    <div className="flex min-h-screen items-center justify-center bg-paper text-sm text-muted">
      <Head>
        <title>Signing in... - AI Test Recorder</title>
      </Head>
      Completing sign-in...
    </div>
  );
}
