logger = logging.getLogger(__name__)

# A "menu check" step prints its per-link results between these two markers
# on one line of standard output. runner/run_recording.py reads them back
# (identical for a server-side run and a run on a local agent, which both
# return the test's output) and shows one report row per menu link instead
# of a single row for the whole step. Keep in sync with that file.
_MENU_RESULT_START = "@@MENU_CHECK_RESULT@@"
_MENU_RESULT_END = "@@END_MENU_CHECK_RESULT@@"

# Set CONTINUE_ON_STEP_FAILURE=false to restore the old behavior (a failed
# step stops the whole scenario, everything after it shows "Undefined") -
# default is to continue, logging clearly why each step that failed did,
# so one flaky/changed field doesn't kill an otherwise-working flow. See
# _run_step below.
_CONTINUE_ON_FAILURE = os.getenv("CONTINUE_ON_STEP_FAILURE", "true").lower() != "false"


def _run_step(context, description, fn, element_name=None, default=None):
    """
    Runs `fn()` (a zero-arg callable wrapping one step's real action/
    assertion) and returns (ok, value). On success, ok=True and value is
    whatever fn() returned. On any exception, ok=False, value=`default`,
    and the failure is recorded on context.step_failures (written out in
    after_all as output/reports/step_failures.json - see
    runner/environment.py, local_agent/agent_environment.py) instead of
    being re-raised.

    Why not just let it raise: Behave stops a SCENARIO at its first
    failed step, marking everything after it "Undefined" (never
    attempted) - there's no supported "continue after failed step" mode
    in Behave itself. Catching it HERE, before Behave ever sees it, means
    this step reports "passed" at the framework level and Behave moves on
    to the next one normally - runner/run_recording.py's _extract_steps()
    then overrides that back to "Failed" (with the real reason) using
    context.step_failures, so the report is still accurate even though
    Behave's own per-step status isn't.
    """
    if not _CONTINUE_ON_FAILURE:
        return True, fn()
    try:
        return True, fn()
    except Exception as e:
        context.step_failures.append({
            "step_index": context.step_counter + 1,  # same alignment as context.locator_log - see environment.py's after_step
            "step_name": description,
            "element_name": element_name,
            "error_type": type(e).__name__,
            "error": str(e),
        })
        logger.warning(f"Step failed but continuing: {description} - {type(e).__name__}: {e}")
        return False, default


@given('the user opens "{url}"')
def step_open(context, url):
    # Deliberately NOT routed through _run_step - nothing meaningful can
    # continue without a page having actually loaded, so a navigation
    # failure should still stop the scenario outright.
    context.raw_page.goto(url)


def _sync_browser_pages(context, previous_pages=None):
    """
    Detect tabs/windows opened by the previous browser action.

    Uses Playwright's BrowserContext.pages rather than Windows focus or the
    physical mouse cursor. A newly detected page becomes the active page.
    """
    try:
        previous_pages = list(previous_pages or [])
        current_pages = list(context.browser_session.context.pages)

        for page in current_pages:
            if page not in context.recorder_pages:
                try:
                    page.wait_for_load_state(
                        "domcontentloaded",
                        timeout=5000,
                    )
                except Exception:
                    pass

                context.recorder_pages.append(page)
                context.page.switch_page(page)

                try:
                    page.bring_to_front()
                except Exception:
                    pass

                print(
                    f"[browser] Detected new tab/window "
                    f"#{len(context.recorder_pages) - 1}"
                )

        return current_pages

    except Exception as exc:
        print(f"[browser] Page synchronization warning: {exc}")
        return previous_pages


