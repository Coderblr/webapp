"""SQLite-backed vector store for the RAG layer (Section 9).

Postgres/pgvector did cosine search in the database with an ANN index.
SQLite has no vector type, so embeddings are stored as JSON-encoded float
lists in a TEXT column and similarity is computed in Python. This is
brute-force (O(n) per search within the filtered namespace/transaction),
which is fine at the scale a single-machine knowledge repository holds.

Everything embeddable lands here: element descriptions, DOM fragments,
workflow paths, BRD text, framework artefacts and past AI decisions.
"""
from __future__ import annotations

import math
from typing import Any, Optional

from . import db
from .config import settings
from .llm import embed_batch, embed_text
from .logging_conf import get_logger

log = get_logger(__name__)

NAMESPACES = (
    "element", "dom", "workflow", "brd", "framework", "decision", "report"
)


def _encode_vec(values: list[float]) -> str:
    return db.jsonb(values)


def _decode_vec(raw: Any) -> list[float]:
    if raw is None:
        return []
    if isinstance(raw, list):
        return [float(x) for x in raw]
    import json
    return [float(x) for x in json.loads(raw)]


def _cosine(a: list[float], b: list[float]) -> float:
    if not a or not b or len(a) != len(b):
        return 0.0
    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a))
    nb = math.sqrt(sum(y * y for y in b))
    if na == 0.0 or nb == 0.0:
        return 0.0
    return dot / (na * nb)


def upsert(
    namespace: str,
    content: str,
    ref_type: str | None = None,
    ref_id: str | None = None,
    transaction_id: str | None = None,
    meta: dict[str, Any] | None = None,
    embedding: list[float] | None = None,
) -> Optional[int]:
    """Store one document + embedding.  Returns row id."""
    if not content or not content.strip():
        return None
    vec = embedding if embedding is not None else embed_text(content)
    row = db.insert_returning(
        """
        INSERT INTO knowledge_embeddings
            (namespace, ref_type, ref_id, transaction_id, content, meta, embedding)
        VALUES (%s, %s, %s, %s, %s, %s, %s)
        RETURNING id
        """,
        (
            namespace, ref_type, ref_id, transaction_id, content,
            db.jsonb(meta or {}), _encode_vec(vec),
        ),
    )
    return (row or {}).get("id")


def upsert_many(docs: list[dict[str, Any]]) -> int:
    """Batch-embed and store.  Each doc: namespace, content, [ref_type,
    ref_id, transaction_id, meta]."""
    docs = [d for d in docs if (d.get("content") or "").strip()]
    if not docs:
        return 0
    vectors = embed_batch([d["content"] for d in docs])
    rows = [
        (
            d["namespace"], d.get("ref_type"), d.get("ref_id"),
            d.get("transaction_id"), d["content"], db.jsonb(d.get("meta") or {}),
            _encode_vec(v),
        )
        for d, v in zip(docs, vectors)
    ]
    db.executemany(
        """
        INSERT INTO knowledge_embeddings
            (namespace, ref_type, ref_id, transaction_id, content, meta, embedding)
        VALUES (%s, %s, %s, %s, %s, %s, %s)
        """,
        rows,
    )
    return len(rows)


def search(
    query_text: str,
    namespace: str | None = None,
    transaction_id: str | None = None,
    top_k: int = 8,
    min_similarity: float = 0.0,
) -> list[dict[str, Any]]:
    """Cosine-similarity retrieval, computed in Python."""
    query_vec = embed_text(query_text)
    clauses, params = ["TRUE"], []
    if namespace:
        clauses.append("namespace = %s")
        params.append(namespace)
    if transaction_id:
        clauses.append("transaction_id = %s")
        params.append(transaction_id)
    sql = f"""
        SELECT id, namespace, ref_type, ref_id, transaction_id, content, meta, embedding
        FROM knowledge_embeddings
        WHERE {' AND '.join(clauses)}
    """
    candidates = db.query(sql, params)
    scored: list[dict[str, Any]] = []
    for row in candidates:
        vec = _decode_vec(row.pop("embedding", None))
        sim = _cosine(query_vec, vec)
        if sim >= min_similarity:
            row["similarity"] = sim
            scored.append(row)
    scored.sort(key=lambda r: r["similarity"], reverse=True)
    return scored[:top_k]


def delete_for_transaction(transaction_id: str, namespace: str | None = None) -> int:
    if namespace:
        return db.execute(
            "DELETE FROM knowledge_embeddings WHERE transaction_id=%s AND namespace=%s",
            (transaction_id, namespace),
        )
    return db.execute(
        "DELETE FROM knowledge_embeddings WHERE transaction_id=%s", (transaction_id,)
    )


def stats() -> dict[str, Any]:
    rows = db.query(
        "SELECT namespace, COUNT(*) AS n FROM knowledge_embeddings GROUP BY namespace"
    )
    return {
        "dimension": settings.embedding_dim,
        "by_namespace": {r["namespace"]: r["n"] for r in rows},
        "total": sum(r["n"] for r in rows),
    }
