/* ═══════════════════════════════════════════════════════════════════════
   Application Knowledge Collector — in-page agent  (Section 5)

   Injected on every document (via CDP Page.addScriptToEvaluateOnNewDocument)
   so it survives navigation.  It:
     • records every user interaction (click / type / select / check / submit)
     • crawls the WHOLE page for interactable elements — not just the ones
       the user touched — so future BRDs already know about them
     • builds a multi-strategy locator repository per element
     • captures validation / error / success messages
     • traverses iframes and open shadow roots

   It buffers events on window.__AIREC__ ; the Python side drains the buffer.
   ═══════════════════════════════════════════════════════════════════════ */
(function () {
  if (window.__AIREC__) { return; }

  const REC = {
    version: '1.0',
    enabled: true,
    // Off by default (Section 7's original rule) — set to true by
    // Python right after injection ONLY when the person recording
    // explicitly opted in to "use typed values as default test data"
    // for this session (see cdp_recorder.py's `capture_recorded_values`).
    captureValues: false,
    // A SEPARATE, second opt-in — deliberately not folded into
    // captureValues above. Someone can want "reuse my typed values" for
    // ordinary business fields WITHOUT also wanting password/PIN/OTP
    // values captured — bundling them into one checkbox would mean
    // whichever person just wants the common case ends up silently
    // capturing credentials too, without a distinct, informed decision
    // about that specific, higher-risk category. Only meaningful when
    // captureValues is ALSO true — this alone changes nothing.
    captureSensitiveValues: false,
    events: [],
    crawls: [],
    messages: [],
    seq: 0,
    pageKey: null
  };
  window.__AIREC__ = REC;

  /* ── helpers ───────────────────────────────────────────────────────── */
  const SENSITIVE_HINT = /pass|pwd|pin|otp|cvv|secret|token/i;

  /* ── live-DOM uniqueness verification (Section 5.3 accuracy fix) ────
     A locator candidate is only useful if it resolves to EXACTLY the
     element the user interacted with — not "probably", verified right
     now against the real page. Every css/xpath candidate below is
     checked here before being offered as a locator; ambiguous or
     non-matching candidates are dropped instead of being passed
     downstream with false confidence, since a fallback that quietly
     clicks the WRONG element (because it also matched something else)
     is worse than no fallback at all. */
  function cssCount(sel) {
    try { return document.querySelectorAll(sel).length; } catch (e) { return -1; }
  }
  function cssResolvesToElement(sel, el) {
    try {
      const nodes = document.querySelectorAll(sel);
      return nodes.length === 1 && nodes[0] === el;
    } catch (e) { return false; }
  }
  function xpathResolvesToElement(xp, el) {
    try {
      const result = document.evaluate(
        xp, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null
      );
      return result.snapshotLength === 1 && result.snapshotItem(0) === el;
    } catch (e) { return false; }
  }

  /* ── cross-frame relay (fixes the "popup iframe closes right after
     the action" race) ──────────────────────────────────────────────
     Python's poll loop drains buffers roughly once a second. A popped-up
     iframe that closes (gets removed from the DOM) within that window —
     a very common pattern for a confirm/OK modal — destroys its own
     `window.__AIREC__` buffer along with it, taking any not-yet-drained
     events with it, no matter how well Python switches into iframes to
     read them; by the time the NEXT poll tick runs, the iframe (and its
     buffer) is simply gone.

     The fix is to stop RELYING on being polled in time at all: every
     non-top frame pushes its own event straight into window.top's
     buffer over postMessage the INSTANT the event happens — synchronously,
     inside the very same click/change/submit handler that captured it,
     before the browser's event loop gets a chance to run whatever closes
     the popup next. By the time anything else can happen, the event
     already safely lives in the top document's buffer, which survives
     the iframe's removal and which Python already drains reliably every
     poll tick regardless of what happened to the iframe afterwards. */
  function relayToTop(kind, payload) {
    if (window === window.top) return;
    try {
      window.top.postMessage({ __airec_relay__: true, kind: kind, payload: payload }, '*');
    } catch (e) {
      // cross-origin postMessage failures (rare, sandboxed iframes) are
      // not fatal — the frame's own buffer still holds the event as a
      // fallback for the regular per-frame poll-drain.
    }
  }
  if (window === window.top) {
    window.addEventListener('message', function (e) {
      const data = e && e.data;
      if (!data || !data.__airec_relay__ || !REC.enabled) return;
      if (data.kind === 'action') { REC.events.push(data.payload); }
      else if (data.kind === 'crawl') { REC.crawls.push(data.payload); REC.events.push(data.payload); }
      else if (data.kind === 'messages') { REC.messages.push(data.payload); REC.events.push(data.payload); }
    });
  }

  function slug(text) {
    return (text || '')
      .toString().trim().toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '')
      .slice(0, 60);
  }

  /* Section 8 fix: the previous version computed this ONCE and cached
   * it forever (`if (!REC.pageKey)`), which was correct only for a
   * classic full-page-reload navigation (this script re-injects fresh
   * via Page.addScriptToEvaluateOnNewDocument on every real navigation
   * anyway, so a fresh REC object naturally gets a fresh pageKey then).
   * It silently broke for a client-side-routed SPA screen change —
   * title/pathname change WITHOUT a full reload, this script is NOT
   * re-injected, and every element/action after that point kept
   * getting attributed to the FIRST screen's stale page_key forever.
   * Now recomputes whenever title/pathname has actually changed since
   * the last check, and flags the transition so Python can treat it as
   * an action-grouping boundary (Section 7) the same way a real
   * navigation already is. */
  function pageKey() {
    const currentSignature = document.title + '|' + location.pathname;
    if (!REC.pageKey || REC._pageSignature !== currentSignature) {
      REC._pageSignature = currentSignature;
      REC.pageKey = slug(document.title) || slug(location.pathname) || 'page';
      REC._pageTransitioned = true;
    }
    return REC.pageKey;
  }

  function visibleText(el) {
    if (!el) return '';
    const t = (el.innerText || el.textContent || '').trim();
    return t.length > 120 ? t.slice(0, 120) : t;
  }

  // Structural container tags — almost NEVER a meaningful individual
  // "label" for a specific click target, even when they genuinely are
  // what got clicked (event delegation on a wide container, a click that
  // bubbled up past the actual intended cell/input). Falling back to
  // visibleText() on one of these dumps its ENTIRE aggregate text — a
  // real, confirmed bug: a whole denomination TABLE's header+data text
  // ("Denomination Current Quantity Current Balance Denom In Amount In
  // Denom Out Amount Out 500.00 10874") became the "label" for SEVERAL
  // DIFFERENT clicks inside that same table, producing repeated,
  // garbled, disambiguation-suffixed labels for what should have been
  // distinct, specific cells.
  const _CONTAINER_TAGS = new Set(['TABLE', 'TBODY', 'THEAD', 'TFOOT', 'TR', 'FORM', 'UL', 'OL']);

  function labelFor(el) {
    if (!el) return '';
    if (el.getAttribute && el.getAttribute('aria-label')) return el.getAttribute('aria-label');
    if (el.id) {
      const lab = document.querySelector('label[for="' + CSS.escape(el.id) + '"]');
      if (lab) return visibleText(lab);
    }
    let p = el.parentElement;
    for (let i = 0; i < 3 && p; i++, p = p.parentElement) {
      if (p.tagName === 'LABEL') return visibleText(p);
      const lab = p.querySelector && p.querySelector('label');
      if (lab && lab.contains && !lab.contains(el)) return visibleText(lab);
    }
    if (el.placeholder) return el.placeholder;
    if (el.title) return el.title;
    if (el.name) return el.name;
    if (_CONTAINER_TAGS.has(el.tagName)) {
      // A container's own DIRECT text (not counting its many descendant
      // elements) is often still meaningful and short (a caption, a
      // heading directly inside it) — but its FULL aggregate text is
      // not. `childNodes` filtered to direct text nodes only, never
      // recursing into children, is what actually avoids the dump.
      const directText = Array.from(el.childNodes || [])
        .filter(function (n) { return n.nodeType === 3; })
        .map(function (n) { return (n.textContent || '').trim(); })
        .filter(Boolean)
        .join(' ');
      return directText.length > 0 && directText.length <= 60 ? directText : '';
    }
    return visibleText(el);
  }

  function elementType(el) {
    const tag = (el.tagName || '').toLowerCase();
    const type = (el.getAttribute && (el.getAttribute('type') || '')).toLowerCase();
    if (tag === 'select') return 'dropdown';
    if (tag === 'textarea') return 'textarea';
    if (tag === 'a') return 'link';
    if (tag === 'table') return 'table';
    if (tag === 'input') {
      if (type === 'checkbox') return 'checkbox';
      if (type === 'radio') return 'radio';
      if (type === 'file') return 'upload';
      if (type === 'submit' || type === 'button') return 'button';
      if (type === 'date' || type === 'datetime-local') return 'calendar';
      if (type === 'password') return 'password';
      return 'textbox';
    }
    if (tag === 'button') return 'button';
    const role = el.getAttribute && el.getAttribute('role');
    if (role) return role;
    if (el.onclick || (el.className && /btn|button|clickable/i.test(el.className))) {
      return 'button';
    }
    return tag || 'element';
  }

  function absoluteXPath(el) {
    if (!el || el.nodeType !== 1) return '';
    if (el.id && !looksDynamicId(el.id)) return '//*[@id="' + el.id + '"]';
    const parts = [];
    let node = el;
    while (node && node.nodeType === 1 && node !== document.documentElement) {
      let index = 1;
      let sib = node.previousElementSibling;
      while (sib) {
        if (sib.tagName === node.tagName) index++;
        sib = sib.previousElementSibling;
      }
      parts.unshift(node.tagName.toLowerCase() + '[' + index + ']');
      node = node.parentElement;
    }
    return '/html/' + parts.join('/');
  }

  // JS-side mirror of locator_builder.py's `_DYNAMIC_ID` regex — same
  // patterns (long digit runs, UUIDs, ASP.NET ctl-ids, React :r0:-style
  // ids). Needed HERE, not just there, because of a real, confirmed bug:
  // cssPath() below used to trust ANY ancestor's id unconditionally,
  // baking a dynamically-regenerated modal/dialog id (e.g. a Bootstrap
  // dialog's own randomly-generated id, confirmed via DevTools inspection
  // on a real "CashDrawer" popup: id="629ab2e7-de4a-4bf0-824c-460f0635775f")
  // straight into the returned CSS selector as an ancestor scope. That
  // selector then only ever worked for THAT one instance of the dialog —
  // the very next time it opened with a freshly-generated id, the whole
  // locator broke, even though the STRUCTURE/CLASSES inside the dialog
  // were perfectly stable the entire time. locator_builder.py's own
  // dynamic-id penalty (Python-side, at SCORING time) can only downgrade
  // a selector's reliability after the fact — it can't undo a bad
  // ancestor segment already baked into the selector STRING itself; this
  // has to be caught here, before that string is ever built.
  const DYNAMIC_ID_PATTERN = /(\d{4,}|[0-9a-f]{8}-[0-9a-f]{4}|__\d+|_\d{3,}|ctl\d+|:r[0-9a-z]+:)/i;
  function looksDynamicId(id) {
    return !!(id && DYNAMIC_ID_PATTERN.test(id));
  }

  function cssPath(el) {
    if (!el || el.nodeType !== 1) return '';
    if (el.id && !looksDynamicId(el.id)) {
      const idSel = '#' + CSS.escape(el.id);
      // An id that ISN'T actually unique on this page (duplicate ids do
      // happen on messy enterprise markup) is worse than useless as a
      // locator — verify before trusting it.
      if (cssResolvesToElement(idSel, el)) return idSel;
    }
    const segments = [];
    let node = el;
    while (node && node.nodeType === 1 && segments.length < 8) {
      let seg = node.tagName.toLowerCase();
      if (node.classList && node.classList.length) {
        const cls = Array.from(node.classList)
          .filter(c => !/^(ng-|is-|active|selected|hover|focus)/.test(c))
          .slice(0, 2);
        if (cls.length) seg += '.' + cls.map(c => CSS.escape(c)).join('.');
      }
      const parent = node.parentElement;
      let indexedSeg = seg;
      if (parent) {
        const same = Array.from(parent.children).filter(c => c.tagName === node.tagName);
        if (same.length > 1) indexedSeg = seg + ':nth-of-type(' + (same.indexOf(node) + 1) + ')';
      }
      if (node.id && !looksDynamicId(node.id)) { indexedSeg = '#' + CSS.escape(node.id); }

      // Try the class/tag-only segment FIRST (survives DOM reordering /
      // row insertion) — only fall back to the position-based
      // :nth-of-type segment if the plain one isn't unique enough yet.
      segments.unshift(seg);
      let candidate = segments.join(' > ');
      if (cssResolvesToElement(candidate, el)) return candidate;

      if (indexedSeg !== seg) {
        segments[0] = indexedSeg;
        candidate = segments.join(' > ');
        if (cssResolvesToElement(candidate, el)) return candidate;
        segments[0] = seg; // keep the non-positional form for the next ancestor level
      }

      if (node.id && !looksDynamicId(node.id)) {
        segments[0] = '#' + CSS.escape(node.id); break;
      }
      node = parent;
    }
    // Nothing became unique within 8 ancestor levels (rare) — return the
    // best-effort deepest path; locator_builder.py penalises anything
    // that wasn't marked verified, below.
    return segments.join(' > ');
  }

  function relativeXPaths(el) {
    const out = [];
    const tag = (el.tagName || '').toLowerCase();
    const type = (el.getAttribute && (el.getAttribute('type') || '')).toLowerCase();
    // 'value' is deliberately EXCLUDED for free-text inputs — for a
    // textbox/textarea it's whatever the user just TYPED during
    // recording (an account number, a name, ...), which is both
    // guaranteed to differ on every future run and a way for recorded
    // data to leak into a "locator". It's kept only for elements whose
    // value IS the static, unchanging label (a <input type="submit"
    // value="Save">-style button), where it behaves like button text.
    const attrs = ['name', 'placeholder', 'aria-label', 'title'];
    if (tag !== 'input' || type === 'submit' || type === 'button' || type === 'reset') {
      attrs.push('value');
    }
    attrs.push('type');
    const candidates = [];
    attrs.forEach(function (a) {
      const v = el.getAttribute && el.getAttribute(a);
      if (v) candidates.push('//' + tag + '[@' + a + '="' + v + '"]');
    });
    Array.from(el.attributes || []).forEach(function (a) {
      if (a.name.indexOf('data-') === 0 && a.value) {
        candidates.push('//' + tag + '[@' + a.name + '="' + a.value + '"]');
      }
    });
    const txt = visibleText(el);
    if (txt && txt.length < 40) {
      candidates.push('//' + tag + '[normalize-space(text())="' + txt + '"]');
      candidates.push('//' + tag + '[contains(normalize-space(.),"' + txt + '")]');
    }
    const lab = labelFor(el);
    if (lab && lab.length < 40 && (tag === 'input' || tag === 'select' || tag === 'textarea')) {
      candidates.push('//label[contains(normalize-space(.),"' + lab + '")]/following::'
        + tag + '[1]');
      candidates.push('//td[contains(normalize-space(.),"' + lab + '")]/following::'
        + tag + '[1]');
    }
    // Keep only candidates VERIFIED, right now, to resolve to exactly
    // this element — an xpath that also matches other elements on the
    // page is a locator that can silently act on the wrong one, which is
    // worse than not offering it as a fallback at all.
    candidates.forEach(function (xp) {
      if (xpathResolvesToElement(xp, el)) out.push(xp);
    });
    return out;
  }

  function accessibilityInfo(el) {
    // A proper, unified accessibility snapshot — role/name/description/
    // state — rather than the same handful of aria-* attributes
    // scattered individually across other parts of this file. This is
    // what gives an AI self-healing agent (Part 10) real semantic
    // grounding to re-identify an element by MEANING when its locator
    // breaks, not just by whatever CSS/XPath happened to work before.
    let describedBy = null;
    const describedById = el.getAttribute && el.getAttribute('aria-describedby');
    if (describedById) {
      const describer = document.getElementById(describedById);
      if (describer) describedBy = visibleText(describer);
    }
    return {
      role: (el.getAttribute && el.getAttribute('role')) || null,
      name: labelFor(el),
      description: describedBy,
      checked: el.checked !== undefined ? !!el.checked
        : (el.getAttribute && el.getAttribute('aria-checked')) || null,
      selected: el.selected !== undefined ? !!el.selected
        : (el.getAttribute && el.getAttribute('aria-selected')) || null,
      expanded: (el.getAttribute && el.getAttribute('aria-expanded')) || null,
      disabled: !!el.disabled || (el.getAttribute && el.getAttribute('aria-disabled') === 'true'),
      hidden: !!el.hidden || (el.getAttribute && el.getAttribute('aria-hidden') === 'true'),
    };
  }

  function describe(el, interacted) {
    if (!el || el.nodeType !== 1) return null;
    const rect = (el.getBoundingClientRect && el.getBoundingClientRect()) || {};
    const style = window.getComputedStyle ? window.getComputedStyle(el) : {};
    const attrs = {};
    Array.from(el.attributes || []).forEach(function (a) {
      if (!SENSITIVE_HINT.test(a.name)) attrs[a.name] = a.value;
    });
    const label = labelFor(el);
    const key = slug(
      el.id || el.getAttribute('name') || label || elementType(el) + '_' + (REC.seq)
    ) || ('el_' + REC.seq);

    return {
      element_key: key,
      tag: (el.tagName || '').toLowerCase(),
      element_type: elementType(el),
      label: label,
      text: visibleText(el),
      visible: !!(rect.width || rect.height) && style.visibility !== 'hidden'
        && style.display !== 'none',
      enabled: !el.disabled,
      readonly: !!el.readOnly,
      required: !!el.required,
      maxlength: el.maxLength && el.maxLength > 0 ? el.maxLength : null,
      pattern: el.pattern || null,
      interacted: !!interacted,
      page_key: pageKey(),
      frame_url: location.href,
      attributes: attrs,
      accessibility: accessibilityInfo(el),
      options: (el.tagName === 'SELECT')
        ? Array.from(el.options || []).slice(0, 100)
            .map(function (o) { return { value: o.value, text: o.text }; })
        : null,
      position: { x: Math.round(rect.left || 0), y: Math.round(rect.top || 0),
                  w: Math.round(rect.width || 0), h: Math.round(rect.height || 0) },
      parent: el.parentElement ? {
        tag: el.parentElement.tagName.toLowerCase(),
        id: el.parentElement.id || null,
        cls: el.parentElement.className || null
      } : null,
      siblings: el.parentElement ? el.parentElement.children.length : 0,
      locators: (function () {
        const cssCandidate = cssPath(el);
        const cssVerified = cssCandidate ? cssResolvesToElement(cssCandidate, el) : false;
        // A duplicate id/name on the page (messy enterprise markup is
        // full of these) is not a usable locator even though the
        // attribute exists — verify before offering it, same as css/xpath
        // above. An id/name that fails verification is dropped (set to
        // null) rather than passed downstream with false confidence;
        // the verified css/xpath/relative_xpath candidates still cover
        // the element.
        const rawId = el.id || null;
        const idVerified = rawId ? cssResolvesToElement('#' + CSS.escape(rawId), el) : false;
        const rawName = el.getAttribute ? el.getAttribute('name') : null;
        const nameVerified = rawName
          ? cssResolvesToElement(
              (el.tagName || '').toLowerCase() + '[name="' + rawName + '"]', el
            )
          : false;
        return {
          id: idVerified ? rawId : null,
          id_ambiguous: !!(rawId && !idVerified),
          name: nameVerified ? rawName : null,
          name_ambiguous: !!(rawName && !nameVerified),
          css: cssCandidate,
          css_verified: cssVerified,
          xpath: absoluteXPath(el),
          relative_xpath: relativeXPaths(el),
          text: visibleText(el) || null,
          class: el.className || null,
          placeholder: el.placeholder || null,
          aria: el.getAttribute ? el.getAttribute('aria-label') : null,
          data: Object.keys(attrs)
            .filter(function (k) { return k.indexOf('data-') === 0; })
            .reduce(function (acc, k) { acc[k] = attrs[k]; return acc; }, {})
        };
      })()
    };
  }

  /* ── whole-page crawl (Section 5.2) ────────────────────────────────── */
  const CRAWL_SELECTOR = [
    'input', 'textarea', 'select', 'button', 'a[href]', 'table',
    '[role=button]', '[role=tab]', '[role=menuitem]', '[role=checkbox]',
    '[role=radio]', '[role=combobox]', '[role=link]', '[onclick]',
    '[contenteditable=true]', 'label', 'li[class*=menu]', 'div[class*=btn]',
    'span[class*=btn]', 'img[onclick]', 'i[class*=icon][onclick]'
  ].join(',');

  function collectRoots() {
    // Recursively pierces NESTED shadow DOM, not just one level — a
    // shadow root's own contents can themselves contain further shadow
    // roots (a component library built from nested custom elements is
    // a common real-world shape for this), and the original single-pass
    // version only ever found shadow roots attached directly to the
    // top-level light DOM, silently missing anything nested inside one.
    const roots = [];
    const seen = new Set();
    function visit(root) {
      if (seen.has(root)) return;
      seen.add(root);
      roots.push(root);
      let nodes = [];
      try { nodes = root.querySelectorAll('*'); } catch (e) { return; }
      nodes.forEach(function (el) {
        if (el.shadowRoot) visit(el.shadowRoot);
      });
    }
    visit(document);
    return roots;
  }

  function crawlPage(reason) {
    if (!REC.enabled) return null;
    const elements = [];
    const seen = new Set();
    collectRoots().forEach(function (root) {
      let nodes = [];
      try { nodes = Array.from(root.querySelectorAll(CRAWL_SELECTOR)); } catch (e) { }
      nodes.slice(0, 4000).forEach(function (el) {
        if (seen.has(el)) return;
        seen.add(el);
        const d = describe(el, false);
        if (d) elements.push(d);
      });
    });
    const crawl = {
      type: 'crawl',
      reason: reason || 'page_change',
      seq: REC.seq++,
      ts: Date.now(),
      page: {
        page_key: pageKey(),
        url: location.href,
        title: document.title,
        page_transitioned: !!REC._pageTransitioned,
        frames: Array.from(document.querySelectorAll('iframe,frame')).map(function (f) {
          return { src: f.getAttribute('src'), id: f.id || null, name: f.name || null };
        }),
        shadow_roots: collectRoots().length - 1
      },
      elements: elements,
      element_count: elements.length
    };
    // Reported once per genuine transition — the NEXT crawl on this same
    // page (no title/pathname change since) reports it as false again.
    REC._pageTransitioned = false;
    REC.crawls.push(crawl);
    REC.events.push(crawl);
    relayToTop('crawl', crawl);
    return crawl;
  }

  /* ── validation / message capture (Section 5.8) ────────────────────── */
  const MESSAGE_SELECTOR = [
    '.error', '.errorMessage', '.error-message', '.alert', '.alert-danger',
    '.alert-success', '.alert-warning', '.validation-message', '.help-block',
    '[role=alert]', '.msg', '.message', '.success', '.warning', '.toast',
    'span[class*=err]', 'div[class*=err]', 'label[class*=err]'
  ].join(',');

  function captureMessages() {
    const found = [];
    document.querySelectorAll(MESSAGE_SELECTOR).forEach(function (el) {
      const txt = visibleText(el);
      const rect = el.getBoundingClientRect();
      if (!txt || !(rect.width || rect.height)) return;
      let severity = 'info';
      const cls = (el.className || '') + ' ' + (el.getAttribute('role') || '');
      if (/err|danger|invalid|fail/i.test(cls)) severity = 'error';
      else if (/succ|ok|valid/i.test(cls)) severity = 'success';
      else if (/warn/i.test(cls)) severity = 'warning';
      found.push({ text: txt, severity: severity, page_key: pageKey(),
                   selector: cssPath(el) });
    });
    if (found.length) {
      const evt = { type: 'messages', seq: REC.seq++, ts: Date.now(),
                    page_key: pageKey(), messages: found };
      REC.messages.push(evt);
      REC.events.push(evt);
      relayToTop('messages', evt);
    }
    return found;
  }

  /* ── interaction hooks (Section 5.1 / 5.4) ─────────────────────────── */
  function pushAction(action, el, extra) {
    if (!REC.enabled) return;
    const d = describe(el, true);
    if (!d) return;
    const evt = Object.assign({
      type: 'action',
      action: action,
      seq: REC.seq++,
      ts: Date.now(),
      page_key: pageKey(),
      url: location.href,
      element: d
    }, extra || {});
    REC.events.push(evt);
    // Synchronous, same tick as the click/change/submit that produced
    // this event — see relayToTop()'s comment for why this has to happen
    // here and not on some later timer.
    relayToTop('action', evt);
  }

  document.addEventListener('click', function (e) {
    // composedPath()[0] is the TRUE originally-clicked element even when
    // it's inside a Shadow DOM component (a common way modern frameworks
    // render floaters/menus) — plain e.target can get "retargeted" to an
    // outer wrapper in that case, describing the wrong thing.
    const clicked = (e.composedPath && e.composedPath()[0]) || e.target;

    // ANY click can turn out to trigger an immediate navigation/AJAX
    // reload — not just a literal `type="submit"` element. A plain <a>
    // link, a "Home"/menu item, or a JS onclick handler that does its
    // own `location.href = ...` or triggers a client-side route change
    // all look identical to an ordinary click until they fire — there's
    // no reliable way to know in advance which ones will navigate and
    // which won't. The click gets recorded into memory just fine
    // either way (pushAction is synchronous), but Python only DRAINS
    // that memory periodically (~400ms poll) — if the page navigates
    // before the next poll, the whole in-memory event queue is
    // destroyed with it, and the click is silently lost even though it
    // was captured correctly. This used to only be guarded for
    // type="submit" elements specifically; generalised to (almost)
    // every click is what actually stops "some actions just don't get
    // recorded" for the (very common, in a banking UI) case of a
    // styled link or JS-driven nav button doing the same thing a
    // submit button does.
    //
    // Deliberately EXCLUDED: checkbox/radio inputs. Those already work
    // correctly via the separate 'change' listener below, which relies
    // on the click's NATIVE toggle behaviour actually happening —
    // preventDefault()-ing it here first, then re-dispatching 300ms
    // later, risks breaking that toggle (and the resulting 'change'
    // event) for no benefit, since a checkbox/radio click essentially
    // never triggers an immediate navigation the way a link/button does.
    const tag = (clicked.tagName || '').toLowerCase();
    const inputType = (clicked.type || '').toLowerCase();
    const isCheckboxLike = tag === 'input' && (inputType === 'checkbox' || inputType === 'radio');

    if (isCheckboxLike) {
      // Already recorded correctly by the 'change' listener elsewhere
      // in this file — do NOT push here too (that would double-record
      // every checkbox/radio toggle); just let the native click proceed
      // untouched, same as before this whole fix existed.
      return;
    }

    if (clicked.__aiRecReleased) {
      // This is our own re-dispatched click going through for real —
      // don't intercept it again, just let it proceed natively.
      clicked.__aiRecReleased = false;
      return;
    }
    e.preventDefault();
    e.stopImmediatePropagation();
    pushAction('click', clicked, {via: 'delayed_for_safe_drain'});
    setTimeout(function () {
      captureMessages();
      crawlPage('post_click');
      clicked.__aiRecReleased = true;
      try {
        clicked.click(); // re-dispatch — the real click/navigation happens now
      } catch (err) {
        // A detached/disabled element by the time this fires — nothing
        // more to do; the recorded event itself is already safe.
      }
    }, 600);
  }, true);

  document.addEventListener('change', function (e) {
    const el = e.target;
    const t = elementType(el);
    if (t === 'dropdown') {
      const extra = {
        selected_text: el.options && el.options[el.selectedIndex]
          ? el.options[el.selectedIndex].text : null,
        value_length: (el.value || '').length
      };
      if (REC.captureValues) {
        extra.recorded_value = el.value || '';
      }
      pushAction('select', el, extra);
    } else if (t === 'checkbox' || t === 'radio') {
      pushAction(el.checked ? 'check' : 'uncheck', el, {});
    } else if (t === 'upload') {
      pushAction('upload', el, { file_count: (el.files || []).length });
    } else {
      /* Raw value is ONLY ever captured when BOTH: (a) the field isn't
       * sensitive, and (b) the recording session opted in
       * (REC.captureValues, off by default — set explicitly by Python
       * right after injection, only when the person recording chose
       * "use typed values as default test data" for this session).
       * Section 7's original rule (never store the raw value) stays the
       * DEFAULT behaviour; this is an explicit, informed opt-in on top
       * of it, not a replacement for it — value_length is ALWAYS sent
       * either way, recorded_value only when both conditions hold. */
      const now = Date.now();
      if (el.__aiRecLastCapture && now - el.__aiRecLastCapture < 400) return;
      el.__aiRecLastCapture = now;
      const isSensitive = SENSITIVE_HINT.test(el.name || '') ||
                          SENSITIVE_HINT.test(el.id || '') ||
                          (el.type || '') === 'password';
      const extra = {
        value_length: (el.value || '').length,
        sensitive: isSensitive
      };
      // The element is STILL correctly labelled sensitive:true above
      // either way (screenshots/masking/display elsewhere all still
      // treat it as sensitive) — only the VALUE-capture decision itself
      // changes based on the second, explicit opt-in.
      if (REC.captureValues && (!isSensitive || REC.captureSensitiveValues)) {
        extra.recorded_value = el.value || '';
      }
      pushAction('type', el, extra);
    }
    setTimeout(captureMessages, 350);
  }, true);

  document.addEventListener('submit', function (e) {
    // Same "hold back until safely drained" reasoning as the click
    // handler above — a form submit is the SINGLE MOST LIKELY trigger
    // for an immediate navigation (that's the entire point of submit),
    // so this had NO protection at all before this fix, unlike clicks.
    // `HTMLFormElement.submit()` (used to release it below) bypasses the
    // 'submit' event entirely per spec — no re-entry guard needed the
    // way clicked.click() needed one, this genuinely just submits.
    const form = e.target;
    if (form.__aiRecReleased) { form.__aiRecReleased = false; return; }
    e.preventDefault();
    pushAction('submit', form, {});
    setTimeout(function () {
      captureMessages();
      try { form.submit(); } catch (err) { /* form already gone — nothing to do */ }
    }, 600);
  }, true);

  /* Drag & drop — recorded as ONE logical action (drag target -> drop
   * target), not as the several low-level dragstart/dragover/drop
   * events the browser actually fires; a business-meaning "moved X onto
   * Y" is what's replayable and readable, the intermediate dragover
   * noise is not. Native, unprevented — this only OBSERVES, it doesn't
   * intercept or hold anything back the way click/submit/Enter do,
   * since drag&drop very rarely triggers an immediate page navigation
   * the way those do. */
  let __aiRecDragSource = null;
  document.addEventListener('dragstart', function (e) {
    __aiRecDragSource = e.target;
  }, true);
  document.addEventListener('drop', function (e) {
    if (!__aiRecDragSource) return;
    const dropTarget = e.target;
    pushAction('drag_drop', __aiRecDragSource, {
      drop_target: describe(dropTarget, false),
    });
    __aiRecDragSource = null;
    setTimeout(function () { crawlPage('post_drop'); captureMessages(); }, 350);
  }, true);

  /* Meaningful scroll only — "sometimes you need to scroll to reveal a
   * field before interacting with it" (a scrollable table/modal body/
   * dropdown list hiding what's needed next) is worth a record of WHERE
   * scrolling happened and how far; continuous scroll-wheel ticks are
   * not (Section 5's own "usually ignore: insignificant scroll events").
   * Debounced — only fires once scrolling has actually STOPPED for a
   * beat, one entry per scroll gesture rather than dozens of
   * intermediate positions, and only when the total distance is large
   * enough to plausibly have revealed something that wasn't visible
   * before (a few pixels of jiggle is not that).
   */
  let __aiRecScrollTimer = null;
  let __aiRecScrollStart = null;
  document.addEventListener('scroll', function (e) {
    const target = e.target === document ? document.documentElement : e.target;
    if (!target || typeof target.scrollTop !== 'number') return;
    if (__aiRecScrollStart === null) __aiRecScrollStart = target.scrollTop;
    if (__aiRecScrollTimer) clearTimeout(__aiRecScrollTimer);
    __aiRecScrollTimer = setTimeout(function () {
      const distance = Math.abs(target.scrollTop - __aiRecScrollStart);
      __aiRecScrollStart = null;
      if (distance < 80) return;  // too small to plausibly matter
      pushAction('scroll', target === document.documentElement ? document.body : target, {
        distance_px: Math.round(distance),
      });
    }, 400);
  }, true);

  /* Search/query boxes overwhelmingly submit on Enter, with the page's
   * own JS intercepting the keydown (often via preventDefault()) to fire
   * an AJAX search or navigate immediately — the field never blurs in the
   * way needed for a native 'change' event to fire, so the standard
   * change-listener above never captures it. This was the actual cause of
   * a search box that's auto-focused after login (never clicked, typed
   * into immediately, Enter pressed) going completely unrecorded. Capture
   * on Enter BEFORE that navigation/AJAX can happen. */
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.keyCode !== 13) return;
    const el = e.target;
    const tag = (el.tagName || '').toLowerCase();
    if (tag !== 'input' && tag !== 'textarea') return;
    const t = elementType(el);
    if (t === 'dropdown' || t === 'checkbox' || t === 'radio' || t === 'upload') return;
    // Dedup: if a native 'change' already captured this exact field very
    // recently, don't double-record the same keystroke as two steps.
    const now = Date.now();
    if (el.__aiRecLastCapture && now - el.__aiRecLastCapture < 400) return;
    el.__aiRecLastCapture = now;

    // Same "hold back until safely drained" reasoning as click/submit
    // above. Pressing Enter in a search box (this platform's own
    // confirmed real-world case: type a transaction number, press
    // Enter, the transaction screen opens immediately) is exactly the
    // shape of action most likely to have been silently lost before
    // this fix — no protection existed here at all previously.
    if (el.__aiRecEnterReleased) { el.__aiRecEnterReleased = false; return; }
    e.preventDefault();
    pushAction('type', el, {
      value_length: (el.value || '').length,
      sensitive: SENSITIVE_HINT.test(el.name || '') ||
                 SENSITIVE_HINT.test(el.id || '') ||
                 (el.type || '') === 'password',
      via: 'enter_key'
    });
    setTimeout(function () {
      captureMessages();
      el.__aiRecEnterReleased = true;
      const form = el.form || (el.closest ? el.closest('form') : null);
      if (form) {
        // A standard HTML form's native auto-submit-on-Enter — bypass
        // the trusted-event restriction entirely by submitting directly,
        // the same way the 'submit' handler above releases itself.
        try { form.submit(); return; } catch (err) { /* fall through */ }
      }
      // No enclosing form (a JS-driven search box handling its own
      // keydown listener and doing its own navigation/AJAX call, which
      // this app's search box is — confirmed) — re-dispatch a synthetic
      // Enter keydown. The page's OWN JS listener still fires for a
      // synthetic event (only the BROWSER's native default action, e.g.
      // auto-submitting a real <form>, requires a trusted one — and
      // that case is already handled above).
      try {
        el.dispatchEvent(new KeyboardEvent('keydown', {
          key: 'Enter', code: 'Enter', keyCode: 13, which: 13,
          bubbles: true, cancelable: true,
        }));
      } catch (err) { /* nothing more to do */ }
    }, 600);
  }, true);


  window.addEventListener('load', function () {
    setTimeout(function () { crawlPage('load'); captureMessages(); }, 400);
  });

  /* Best-effort final safety net — a page teardown (logout, a session-
   * timeout auto-redirect, anything genuinely instant enough to outrun
   * even the 600ms hold-back above) leaves NO time for async work; a
   * beforeunload/unload handler can't reliably wait for anything. This
   * doesn't attempt to. It just marks that the page is going away RIGHT
   * NOW, on the (real, common) chance Python's poll happens to land in
   * the brief window between this firing and the page actually being
   * destroyed — logout being the very last thing recorded, rather than
   * silently missing, depends on catching that window when it can.
   */
  window.addEventListener('beforeunload', function () {
    try {
      // Deliberately NOT type: 'action' — this has none of the fields
      // (`action`, `element`) _ingest_action() expects, and would
      // otherwise route into it and produce a garbage/empty action
      // entry. This type doesn't match any of _ingest()'s structured
      // branches, so it's safely appended to the raw event log only —
      // evidence that a teardown was IMMINENT at this exact page/URL,
      // without pretending to be a structured recorded action itself.
      REC.events.push({
        type: 'page_unloading', ts: Date.now(),
        page: { page_key: pageKey(), url: location.href, title: document.title },
      });
    } catch (e) { /* nothing more can be done at this point */ }
  });

  /* SPA / dynamic DOM: re-crawl when the page materially changes.
   * Used to require >=3 new interactive elements before bothering to
   * re-crawl — small floaters/popups (a 2-button "Update Later / Update
   * Now" panel, a short dropdown) never crossed that threshold and were
   * silently never captured. Any change now triggers a re-crawl. */
  let mutationTimer = null;
  let lastCount = 0;
  const observer = new MutationObserver(function () {
    if (!REC.enabled) return;
    clearTimeout(mutationTimer);
    mutationTimer = setTimeout(function () {
      const count = document.querySelectorAll(CRAWL_SELECTOR).length;
      if (count !== lastCount) {
        lastCount = count;
        REC.pageKey = null;           // title may have changed
        crawlPage('dom_mutation');
      }
      captureMessages();
    }, 500);
  });
  try {
    observer.observe(document.documentElement || document.body,
      { childList: true, subtree: true, attributes: false });
  } catch (e) { }

  /* ── drain API used by the Python recorder ─────────────────────────── */
  REC.drain = function () {
    const batch = REC.events.splice(0, REC.events.length);
    return batch;
  };
  REC.snapshotDom = function () {
    return {
      url: location.href,
      title: document.title,
      html: document.documentElement ? document.documentElement.outerHTML : '',
      page_key: pageKey()
    };
  };
  REC.forceCrawl = function () { return crawlPage('manual'); };
  REC.stop = function () { REC.enabled = false; try { observer.disconnect(); } catch (e) { } };
  /* Pause/Resume (Section 25) — unlike stop(), does NOT disconnect the
   * MutationObserver permanently; click/change/submit/keydown listeners
   * already all check `REC.enabled` first thing, so toggling it back to
   * true picks capture back up exactly where it left off, in the same
   * browser session, without a fresh injection. */
  REC.pause = function () { REC.enabled = false; };
  REC.resume = function () { REC.enabled = true; };

  /* Progressive re-crawl, not a single fixed-delay snapshot. A slow-
   * rendering SPA (this platform's own hash-routed UAT login screen is
   * exactly this shape) can easily still be rendering its login form —
   * including the password/id fields — well past a single 600ms window.
   * A crawl that only ever fires once at a fixed delay silently misses
   * whatever hadn't rendered yet at that exact moment, with no second
   * chance to catch it later — which is the direct, confirmed cause of
   * "the recorder doesn't reliably capture the password/id field in
   * UAT". cdp_recorder.py's `_merge_element()` already de-dupes and
   * merges elements across repeated crawl events by their unique key
   * (locators accumulate, nothing gets overwritten) — so simply
   * crawling AGAIN at increasing intervals, rather than replacing the
   * single crawl with a longer fixed delay, is what actually closes
   * this gap: an early crawl still catches whatever's already there
   * fast, and each later one has another chance at anything that took
   * longer to render, all merging into the same knowledge instead of
   * requiring a guess at "the one right delay" for every screen.
   */
  [600, 1500, 3000, 6000].forEach(function (delay) {
    setTimeout(function () { crawlPage('init'); }, delay);
  });
})();
