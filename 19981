@router.get("/sso/status")
def sso_status():
    """The frontend calls this before showing/enabling its "Sign in with
    SSO" button - so the button can exist in the UI right now (as
    requested) without misleading anyone into thinking it already works.
    Flips to {"enabled": true} the moment AUTH_PROVIDER=sso is set, with
    no frontend code changes needed."""
    return {"enabled": AUTH_PROVIDER == "sso", "provider": AUTH_PROVIDER}


@router.get("/sso/login")
def sso_login_initiate():
    """NOT YET IMPLEMENTED. Once wired up, this redirects (302) the
    browser to the IdP's authorization endpoint - a SAML AuthnRequest URL
    or an OIDC /authorize URL, built from SBI's issued client id / entity
    id / redirect URI (new .env values to add alongside AUTH_PROVIDER).
    Example of what this becomes for OIDC:

        params = {
            "client_id": SSO_CLIENT_ID, "response_type": "code",
            "redirect_uri": f"{BACKEND_PUBLIC_URL}/api/auth/sso/callback",
            "scope": "openid profile email", "state": <csrf nonce>,
        }
        return RedirectResponse(f"{SSO_AUTHORIZE_URL}?{urlencode(params)}")
    """
    raise HTTPException(
        status_code=status.HTTP_501_NOT_IMPLEMENTED,
        detail=f"SSO is not configured yet (AUTH_PROVIDER={AUTH_PROVIDER!r}). See auth/providers.py.",
    )


@router.api_route("/sso/callback", methods=["GET", "POST"])
def sso_callback(request: Request):
    """NOT YET IMPLEMENTED. The IdP redirects here after the user
    authenticates - GET with ?code=&state= for OIDC, or POST with a
    SAMLResponse form field for SAML; which one depends on what SBI
    provides, hence accepting both methods now rather than guessing.

    Once implemented, the body becomes roughly:

        assertion = ... extract SAMLResponse / OIDC code from `request` ...
        with get_session() as db:
            user = authenticate_sso(db, assertion)  # auth/providers.py
            if user is None:
                return RedirectResponse(f"{FRONTEND_URL}/login?reason=SSO+sign-in+failed")
            login_response = _issue_session_and_token(
                db, user, get_client_ip(request), request.headers.get("user-agent"), action="SSO_LOGIN"
            )
        # Bearer tokens live in localStorage, not a cookie (see
        # frontend/lib/auth-storage.js) - so the token has to reach the
        # browser via the redirect URL itself; the frontend's
        # /sso/complete page (already built) picks it up from there.
        return RedirectResponse(f"{FRONTEND_URL}/sso/complete?token={login_response.access_token}")
    """
    raise HTTPException(
        status_code=status.HTTP_501_NOT_IMPLEMENTED,
        detail=f"SSO is not configured yet (AUTH_PROVIDER={AUTH_PROVIDER!r}). See auth/providers.py.",
    )
