import { useEffect, useState } from "react";
import { useRouter } from "next/router";
import Head from "next/head";
import Link from "next/link";
import Layout from "@/components/Layout";
import RequireAuth from "@/components/RequireAuth";
import { Tabs } from "@/components/Tabs";
import ActionTimeline from "@/components/ActionTimeline";
import VersionHistory from "@/components/VersionHistory";
import ShareDialog from "@/components/ShareDialog";
import ReportView from "@/components/ReportView";
import { recordingsApi, transactionsApi } from "@/lib/api";
import { Panel, Callout, Spinner, Metric, StatusBadge } from "@/components/ui";

function OverviewTab({ recording }) {
  return (
    <div className="space-y-4">
      <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <Metric label="Version" value={`v${recording.current_version_number}`} />
        <Metric label="Actions" value={recording.action_count} />
        <Metric
          label="Ownership"
          value={recording.is_owner ? "Owned by you" : recording.is_shared ? "Shared with you" : "Open (legacy)"}
        />
        <Metric label="Schema" value={recording.schema_version} />
      </div>
      <Panel>
        <div className="space-y-2 px-5 py-4 text-sm">
          <div>
            <span className="font-medium text-ink">Target URL: </span>
            <span className="break-all text-muted">{recording.target_url || "—"}</span>
          </div>
          <div>
            <span className="font-medium text-ink">Created: </span>
            <span className="text-muted">{new Date(recording.created_at).toLocaleString()}</span>
          </div>
          <div>
            <span className="font-medium text-ink">Last updated: </span>
            <span className="text-muted">{new Date(recording.updated_at).toLocaleString()}</span>
          </div>
        </div>
      </Panel>
      <Callout>
        To run, edit test data, or edit steps, open this recording in{" "}
        <Link href="/tool" className="font-medium text-brand-blue hover:underline">
          Record &amp; Run
        </Link>{" "}
        and select it from the dropdown there.
      </Callout>
    </div>
  );
}

function ReportsTab({ recordingId }) {
  const [transactions, setTransactions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedId, setSelectedId] = useState(null);
  const [selectedReport, setSelectedReport] = useState(null);
  const [reportLoading, setReportLoading] = useState(false);

  useEffect(() => {
    setLoading(true);
    setError(null);
    transactionsApi
      .list({ recording_id: recordingId, limit: 50 })
      .then(setTransactions)
      .catch((e) => setError(e.detail || e.message))
      .finally(() => setLoading(false));
  }, [recordingId]);

  async function handleView(transactionId) {
    setSelectedId(transactionId);
    setReportLoading(true);
    try {
      setSelectedReport(await transactionsApi.get(transactionId));
    } catch (e) {
      setError(e.detail || e.message);
    } finally {
      setReportLoading(false);
    }
  }

  if (loading) return <Spinner label="Loading execution history..." />;
  if (error) return <Callout tone="error">{error}</Callout>;
  if (transactions.length === 0) return <p className="text-sm text-muted">No executions of this recording yet.</p>;

  return (
    <div className="grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-[22rem_1fr]">
      <div className="max-h-[32rem] space-y-1 overflow-y-auto scroll-thin">
        {transactions.map((t) => (
          <button
            key={t.transaction_id}
            type="button"
            onClick={() => handleView(t.transaction_id)}
            className={`block w-full rounded-sm border px-3 py-2.5 text-left transition-colors ${
              selectedId === t.transaction_id ? "border-brand-blue bg-brand-blueLight" : "border-line bg-panel hover:border-brand-blue/40"
            }`}
          >
            <div className="flex items-center justify-between gap-2">
              <span className="text-sm text-ink">{t.date_time}</span>
              <StatusBadge status={t.status} />
            </div>
            <div className="mt-1 text-xs text-muted">
              {t.passed_count ?? "—"}/{t.step_count ?? "—"} passed
            </div>
          </button>
        ))}
      </div>
      <div className="min-w-0">
        {reportLoading && <Spinner label="Loading report..." />}
        {!reportLoading && selectedReport && <ReportView key={selectedReport.transaction_id} report={selectedReport} />}
        {!reportLoading && !selectedReport && <p className="text-sm text-muted">Pick an execution to see its report.</p>}
      </div>
    </div>
  );
}

export default function RecordingDetailPage() {
  const router = useRouter();
  const { id } = router.query;

  const [recording, setRecording] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!id) return;
    setLoading(true);
    setError(null);
    recordingsApi
      .get(id)
      .then(setRecording)
      .catch((e) => setError(e.detail || e.message))
      .finally(() => setLoading(false));
  }, [id]);

  return (
    <RequireAuth>
      <Layout>
        <Head>
          <title>{recording ? `${recording.name} - AI Test Recorder` : "Recording - AI Test Recorder"}</title>
        </Head>

        <div className="mb-6">
          <Link href="/tool" className="text-xs font-medium text-muted hover:text-ink">
            ← Back to Record &amp; Run
          </Link>
          <h1 className="mt-1 text-2xl font-semibold tracking-tight text-ink">{recording?.name || "Recording"}</h1>
          {recording && (
            <p className="mt-1 text-sm text-muted">
              {recording.is_owner ? "You own this recording." : recording.is_shared ? "Shared with you." : "Open to everyone (legacy recording)."}
            </p>
          )}
        </div>

        {loading && <Spinner label="Loading recording..." />}
        {error && <Callout tone="error">Could not load this recording: {error}</Callout>}

        {!loading && !error && recording && (
          <Tabs
            tabs={[
              { label: "Overview", content: <OverviewTab recording={recording} /> },
              { label: "Actions", content: <ActionTimeline recordingFile={recording.file} /> },
              { label: "Versions", content: <VersionHistory recordingId={recording.recording_id} bare /> },
              {
                label: "Sharing",
                content: recording.is_owner ? (
                  <ShareDialog recordingId={recording.recording_id} recordingName={recording.name} inline />
                ) : (
                  <Callout>Only this recording's owner can manage sharing.</Callout>
                ),
              },
              { label: "Reports", content: <ReportsTab recordingId={recording.recording_id} /> },
            ]}
          />
        )}
      </Layout>
    </RequireAuth>
  );
}
