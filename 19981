  padding: "18px 20px",
  background: "#f8fafc",
  border: "1px solid #e2e8f0",
  borderLeft: "4px solid #f59e0b",
  borderRadius: "10px",
  color: "#64748b",
  fontSize: "13px",
  lineHeight: "1.55",
},

legalHeader: {
  display: "flex",
  alignItems: "center",
  gap: "8px",
  marginBottom: "10px",
