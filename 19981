import { useEffect, useState } from "react";
import { api } from "@/lib/api";
import { recordingsApi } from "@/lib/api";
import ReportView from "@/components/ReportView";
import StepEditor from "@/components/StepEditor";
import ShareDialog from "@/components/ShareDialog";
import VersionHistory from "@/components/VersionHistory";
import Link from "next/link";
import { useAuth } from "@/context/AuthContext";
import { buildReportText, buildReportHtml, downloadBlob, openReportInBrowser } from "@/lib/report";
import { ReportDonut, StepSequenceBar } from "@/components/ReportCharts";
import {
  Button,
  Callout,
  Checkbox,
  DataTable,
  Disclosure,
  Field,
  Metric,
  Panel,
  PanelHeader,
  Select,
  Spinner,
  StatusBadge,
  TextInput,
} from "@/components/ui";

export default function RunSavedTab() {
  const { user } = useAuth();

  const [recordings, setRecordings] = useState([]);
  const [recordingsError, setRecordingsError] = useState(null);
  const [selectedRecFile, setSelectedRecFile] = useState("");
  const [runHeadless, setRunHeadless] = useState(false);

  // ---- test data (editable, shown before running - see generator/test_data.py) ----
  const [testData, setTestData] = useState([]);
  const [testDataLoading, setTestDataLoading] = useState(false);
  const [testDataError, setTestDataError] = useState(null);
  const [editValues, setEditValues] = useState({}); // { [action index]: current input value }
  const [savingData, setSavingData] = useState(false);
  const [saveDataNotice, setSaveDataNotice] = useState(null);
  const [saveDataError, setSaveDataError] = useState(null);

  const [runBusy, setRunBusy] = useState(false);
  const [runError, setRunError] = useState(null);
  const [report, setReport] = useState(null);

  const [regenBusy, setRegenBusy] = useState(false);
  const [regenNotice, setRegenNotice] = useState(null);
  const [regenFiles, setRegenFiles] = useState(null); // {feature_file, steps_file, page_file, locators_file} | null
  const [downloadingRegen, setDownloadingRegen] = useState(null);

  const [importBusy, setImportBusy] = useState(false);
  const [importNotice, setImportNotice] = useState(null);
  const [importFile, setImportFile] = useState(null);
  const [importName, setImportName] = useState("");
  const [importSheets, setImportSheets] = useState(null); // null = not checked yet; [] = single-sheet file, no picker needed
  const [importSheetsLoading, setImportSheetsLoading] = useState(false);
  const [selectedSheets, setSelectedSheets] = useState([]);

  // ---- ownership/sharing/versions/portable export-import (backend/recording_routes.py) ----
  const [shareDialogOpen, setShareDialogOpen] = useState(false);
  const [exportBusy, setExportBusy] = useState(false);
  const [pkgImportFile, setPkgImportFile] = useState(null);
  const [pkgImportBusy, setPkgImportBusy] = useState(false);
  const [pkgImportNotice, setPkgImportNotice] = useState(null);

  // (screenshot modal / download state now lives inside ReportView.js itself)

  const selectedRecording = recordings.find((r) => r.file === selectedRecFile) || null;

  async function loadRecordings() {
    try {
      const r = await api.getRecordings();
      setRecordings(r);
      setRecordingsError(null);
      if (r.length && !selectedRecFile) setSelectedRecFile(r[0].file);
    } catch (e) {
      setRecordingsError(e.detail || e.message);
    }
  }

  useEffect(() => {
    loadRecordings();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function loadTestData(file) {
    setTestDataLoading(true);
    setTestDataError(null);
    setSaveDataNotice(null);
    setSaveDataError(null);
    try {
      const data = await api.getRecordingTestData(file);
      setTestData(data.fields);
      setEditValues(Object.fromEntries(data.fields.map((f) => [f.index, f.value])));
    } catch (e) {
      setTestData([]);
      setEditValues({});
      setTestDataError(e.detail || e.message);
    } finally {
      setTestDataLoading(false);
    }
  }

  useEffect(() => {
    setReport(null); // a different recording's exit report shouldn't linger once you switch
    setRegenNotice(null);
    setRegenFiles(null);
    if (selectedRecFile) loadTestData(selectedRecFile);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedRecFile]);

  function updateValue(index, value) {
    setEditValues((prev) => ({ ...prev, [index]: value }));
    setSaveDataNotice(null);
  }

  async function saveTestDataOnly() {
    setSavingData(true);
    setSaveDataError(null);
    setSaveDataNotice(null);
    try {
      const data = await api.updateRecordingTestData(selectedRecFile, editValues);
      setTestData(data.fields);
      setSaveDataNotice("Test data saved - future runs of this recording will use these values too.");
    } catch (e) {
      setSaveDataError(e.detail || e.message);
    } finally {
      setSavingData(false);
    }
  }

  async function handleRun() {
    if (!selectedRecFile) return;
    setRunError(null);
    setRunBusy(true);
    try {
      // Whatever is currently in the grid is what gets run - saved to the
      // recording first (so it's also the new baseline for next time),
      // then executed. No separate "save" step required.
      if (testData.length > 0) {
        await api.updateRecordingTestData(selectedRecFile, editValues);
      }
      const r = await api.runRecording(selectedRecFile, runHeadless);
      setReport(r);
    } catch (e) {
      setRunError(e.detail || e.message);
    } finally {
      setRunBusy(false);
    }
  }

  async function handleRegenerate() {
    if (!selectedRecFile) return;
    setRegenNotice(null);
    setRegenFiles(null);
    setRegenBusy(true);
    try {
      const r = await recordingsApi.regenerate(selectedRecFile);
      setRegenNotice({
        tone: "success",
        text: `Regenerated (${r.build_result.step_count} steps) - download the scripts below, or just run this recording, which already uses the current code either way.`,
      });
      setRegenFiles({
        feature_file: r.build_result.feature_file,
        steps_file: r.build_result.steps_file,
        page_file: r.build_result.page_file,
        locators_file: r.build_result.locators_file,
      });
    } catch (e) {
      setRegenNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setRegenBusy(false);
    }
  }

  async function handleDownloadRegenFile(path, label) {
    setDownloadingRegen(path);
    try {
      await recordingsApi.downloadRegeneratedFile(path);
    } catch (e) {
      setRegenNotice({ tone: "error", text: `Could not download ${label}: ${e.detail || e.message}` });
    } finally {
      setDownloadingRegen(null);
    }
  }

  async function handleImportFileChosen(file) {
    setImportFile(file);
    setImportNotice(null);
    setImportSheets(null);
    setSelectedSheets([]);
    if (!file) return;
    setImportSheetsLoading(true);
    try {
      const r = await recordingsApi.listUipathSheets(file);
      // A single-sheet workbook needs no picker at all - just import its
      // one (active) sheet directly, exactly like before this feature
      // existed. Only a genuinely multi-sheet file shows the checklist.
      if (r.sheets.length > 1) {
        setImportSheets(r.sheets);
        setSelectedSheets(r.sheets); // default to "all sheets" selected - the common case
      } else {
        setImportSheets([]);
      }
    } catch (e) {
      setImportNotice({ tone: "error", text: e.detail || e.message });
      setImportFile(null);
    } finally {
      setImportSheetsLoading(false);
    }
  }

  function toggleSheetSelection(sheetName) {
    setSelectedSheets((prev) =>
      prev.includes(sheetName) ? prev.filter((s) => s !== sheetName) : [...prev, sheetName]
    );
  }

  async function handleImportUipath() {
    if (!importFile) return;
    if (importSheets && importSheets.length > 0 && selectedSheets.length === 0) {
      setImportNotice({ tone: "error", text: "Select at least one sheet to import, or use \"Select all\"." });
      return;
    }
    setImportNotice(null);
    setImportBusy(true);
    try {
      const r = await recordingsApi.importUipathExcel(importFile, importName, selectedSheets.length ? selectedSheets : undefined);
      const succeeded = r.results.filter((res) => !res.error);
      const failed = r.results.filter((res) => res.error);
      const totalWarnings = succeeded.reduce((n, res) => n + res.warnings.length, 0);

      const parts = [];
      if (succeeded.length) {
        const label = succeeded.length === 1 ? "1 recording" : `${succeeded.length} recordings`;
        parts.push(`Imported ${label} from ${importFile.name}${totalWarnings ? ` (${totalWarnings} warning${totalWarnings > 1 ? "s" : ""} - check each recording's steps)` : ""}.`);
      }
      if (failed.length) {
        parts.push(`${failed.length} sheet${failed.length > 1 ? "s" : ""} could not be imported: ${failed.map((f) => `${f.sheet_name || "sheet"} (${f.error})`).join("; ")}.`);
      }
      setImportNotice({
        tone: failed.length && !succeeded.length ? "error" : failed.length || totalWarnings ? "warning" : "success",
        text: parts.join(" "),
      });
      setImportFile(null);
      setImportName("");
      setImportSheets(null);
      setSelectedSheets([]);
      await loadRecordings();
      if (succeeded.length) setSelectedRecFile(succeeded[0].recording_file);
    } catch (e) {
      setImportNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setImportBusy(false);
    }
  }

  async function handleExport() {
    if (!selectedRecording?.recording_id) return;
    setExportBusy(true);
    try {
      await recordingsApi.exportRecording(selectedRecording.recording_id, `${selectedRecording.name}.zip`);
    } catch (e) {
      setRegenNotice({ tone: "error", text: `Export failed: ${e.detail || e.message}` });
    } finally {
      setExportBusy(false);
    }
  }

  async function handleImportPackage() {
    if (!pkgImportFile) return;
    setPkgImportNotice(null);
    setPkgImportBusy(true);
    try {
      const r = await recordingsApi.importRecordingPackage(pkgImportFile);
      setPkgImportNotice({
        tone: r.warnings.length ? "warning" : "success",
        text: `Imported "${r.name}" (${r.action_count} actions)${r.warnings.length ? ` - ${r.warnings.join(" ")}` : ""}.`,
      });
      setPkgImportFile(null);
      await loadRecordings();
    } catch (e) {
      setPkgImportNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setPkgImportBusy(false);
    }
  }

  return (
    <div className="grid min-w-0 gap-6 lg:grid-cols-[360px_1fr]">
      <Panel>
        <PanelHeader title="Run a saved recording" caption="Pick a recording, review/edit its test data, then run it." />
        <div className="space-y-4 px-5 py-5">
          <Callout>
            Running as <strong>{user?.first_name} {user?.last_name}</strong> ({user?.username}). Every run is logged
            against your account.
          </Callout>

          <Disclosure title="Import from a UiPath Excel sheet">
            <div className="space-y-3">
              <p className="text-xs text-muted">
                Upload a spreadsheet with Steps / NAME / Action-Method / present element / input columns - it's
                converted into a saved recording here, ready to run or regenerate like any other. A workbook with
                several sheets (e.g. one per test case) lets you pick which to import below.
              </p>
              <Field label="Excel file (.xlsx)">
                <input
                  type="file"
                  accept=".xlsx,.xlsm"
                  onChange={(e) => handleImportFileChosen(e.target.files?.[0] || null)}
                  className="block w-full text-sm text-ink file:mr-3 file:rounded-sm file:border-0 file:bg-rail file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink hover:file:bg-line"
                />
              </Field>

              {importSheetsLoading && <Spinner label="Checking sheets in this file..." />}

              {importSheets && importSheets.length > 0 && (
                <div className="border border-line bg-rail px-3 py-2.5">
                  <div className="mb-1.5 flex items-center justify-between">
                    <span className="text-xs font-medium text-ink">
                      This file has {importSheets.length} sheets - pick which to import as separate recordings:
                    </span>
                    <div className="flex gap-2 text-xs">
                      <button type="button" className="text-brand-blue hover:underline" onClick={() => setSelectedSheets(importSheets)}>
                        Select all
                      </button>
                      <button type="button" className="text-brand-blue hover:underline" onClick={() => setSelectedSheets([])}>
                        Select none
                      </button>
                    </div>
                  </div>
                  <div className="max-h-40 space-y-1 overflow-y-auto">
                    {importSheets.map((sheet) => (
                      <Checkbox
                        key={sheet}
                        label={sheet}
                        checked={selectedSheets.includes(sheet)}
                        onChange={() => toggleSheetSelection(sheet)}
                      />
                    ))}
                  </div>
                </div>
              )}

              <Field label={importSheets && importSheets.length > 0 ? "Name prefix for these recordings (optional)" : "Name this recording (optional)"}>
                <TextInput
                  value={importName}
                  onChange={(e) => setImportName(e.target.value)}
                  placeholder="e.g. LLMS Lite MCC Flow"
                />
              </Field>
              <Button variant="secondary" onClick={handleImportUipath} disabled={!importFile || importBusy || importSheetsLoading} className="w-full">
                {importBusy
                  ? "Importing..."
                  : importSheets && importSheets.length > 0
                  ? `Import ${selectedSheets.length} sheet${selectedSheets.length === 1 ? "" : "s"}`
                  : "Import"}
              </Button>
              {importNotice && <Callout tone={importNotice.tone}>{importNotice.text}</Callout>}
            </div>
          </Disclosure>

          <Disclosure title="Import recording package (.zip)">
            <div className="space-y-3 px-1 pb-2 pt-1">
              <p className="text-xs text-muted">
                Imports a portable package exported with the &ldquo;Export&rdquo; button below (from this server or
                another one) - always creates a brand-new recording of your own, never overwrites anything.
              </p>
              <Field label="Package file (.zip)">
                <input
                  type="file"
                  accept=".zip"
                  onChange={(e) => setPkgImportFile(e.target.files?.[0] || null)}
                  className="block w-full text-sm text-ink file:mr-3 file:rounded-sm file:border file:border-line file:bg-panel file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink hover:file:border-brand-blue"
                />
              </Field>
              <Button variant="secondary" onClick={handleImportPackage} disabled={!pkgImportFile || pkgImportBusy} className="w-full">
                {pkgImportBusy ? "Importing..." : "Import package"}
              </Button>
              {pkgImportNotice && <Callout tone={pkgImportNotice.tone}>{pkgImportNotice.text}</Callout>}
            </div>
          </Disclosure>

          {recordingsError && <Callout tone="error">Could not load recordings: {recordingsError}</Callout>}

          {recordings.length === 0 ? (
            <Callout>No saved recordings found yet. Record one in the &ldquo;Record &amp; Generate&rdquo; tab first.</Callout>
          ) : (
            <>
              <Field label="Saved recording">
                <Select value={selectedRecFile} onChange={(e) => setSelectedRecFile(e.target.value)}>
                  {recordings.map((r) => (
                    <option key={r.file} value={r.file}>
                      {r.name} — {r.target_url} ({r.action_count} actions)
                    </option>
                  ))}
                </Select>
              </Field>

              {selectedRecording && (
                <div className="flex flex-wrap items-center gap-2">
                  <span className="text-xs text-muted">
                    {selectedRecording.is_owner
                      ? "You own this recording."
                      : selectedRecording.is_shared
                      ? "Shared with you."
                      : "Open to everyone (legacy recording)."}
                  </span>
                  <div className="ml-auto flex gap-2">
                    {selectedRecording.recording_id && (
                      <Link
                        href={`/recordings/${selectedRecording.recording_id}`}
                        className="inline-flex items-center px-4 py-2 text-sm font-medium text-signal-slate underline decoration-line underline-offset-4 hover:text-ink"
                      >
                        View details →
                      </Link>
                    )}
                    {selectedRecording.is_owner && (
                      <Button variant="ghost" onClick={() => setShareDialogOpen(true)}>
                        Share
                      </Button>
                    )}
                    <Button variant="ghost" onClick={handleExport} disabled={exportBusy}>
                      {exportBusy ? "Exporting..." : "Export"}
                    </Button>
                  </div>
                </div>
              )}

              {shareDialogOpen && selectedRecording && (
                <ShareDialog
                  recordingId={selectedRecording.recording_id}
                  recordingName={selectedRecording.name}
                  onClose={() => setShareDialogOpen(false)}
                />
              )}

              <Checkbox label="headless" checked={runHeadless} onChange={setRunHeadless} />

              <Button onClick={handleRun} disabled={runBusy} className="w-full">
                {runBusy ? "Running..." : "Run recording"}
              </Button>

              {runBusy && <Spinner label="Running the saved recording..." />}
              {runError && <Callout tone="error">Run failed: {runError}</Callout>}

              <div className="border-t border-line pt-4">
                <Button variant="secondary" onClick={handleRegenerate} disabled={regenBusy} className="w-full">
                  {regenBusy ? "Regenerating..." : "Regenerate (no run)"}
                </Button>
                <p className="mt-1.5 text-xs text-muted">
                  Refreshes this recording's generated feature/steps/page files from the latest generator code -
                  without re-recording or running anything. Useful right after a code/template fix, to confirm it
                  applies here.
                </p>
                {regenNotice && (
                  <div className="mt-2">
                    <Callout tone={regenNotice.tone}>{regenNotice.text}</Callout>
                  </div>
                )}
                {regenFiles && (
                  <div className="mt-2 flex flex-wrap gap-2">
                    {[
                      { path: regenFiles.feature_file, label: "Feature file" },
                      { path: regenFiles.steps_file, label: "Steps (.py)" },
                      { path: regenFiles.page_file, label: "Page object (.py)" },
                      { path: regenFiles.locators_file, label: "Locators (.json)" },
                    ].map(
                      ({ path, label }) =>
                        path && (
                          <button
                            key={path}
                            type="button"
                            className="rounded-sm border border-line bg-panel px-2.5 py-1 text-xs font-medium text-brand-blue hover:border-brand-blue/40 disabled:opacity-40"
                            disabled={downloadingRegen === path}
                            onClick={() => handleDownloadRegenFile(path, label)}
                          >
                            {downloadingRegen === path ? "Downloading..." : `⬇ ${label}`}
                          </button>
                        )
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      </Panel>

      <div className="min-w-0 space-y-4">
        {selectedRecFile && (
          <Panel>
            <div className="flex items-center justify-between border-b border-line px-5 py-4">
              <div>
                <h2 className="text-sm font-semibold text-ink">Test data</h2>
                <p className="mt-0.5 text-xs text-muted">
                  The values this recording types/selects when it runs. Edit anything below, then hit{" "}
                  <strong>Run recording</strong> - no need to download or re-upload the Excel report; changes save
                  straight into this recording.
                </p>
              </div>
              {testData.length > 0 && (
                <Button variant="secondary" onClick={saveTestDataOnly} disabled={savingData}>
                  {savingData ? "Saving..." : "Save without running"}
                </Button>
              )}
            </div>
            <div className="px-5 py-4">
              {testDataLoading && <Spinner label="Loading test data..." />}
              {testDataError && <Callout tone="error">{testDataError}</Callout>}
              {saveDataError && <Callout tone="error">{saveDataError}</Callout>}
              {saveDataNotice && <Callout tone="success">{saveDataNotice}</Callout>}

              {!testDataLoading && !testDataError && testData.length === 0 && (
                <p className="text-sm text-muted">
                  This recording has no typed or selected values to edit (e.g. it's clicks/navigation only).
                </p>
              )}

              {testData.length > 0 && (
                <DataTable
                  columns={[
                    { key: "label", label: "Field" },
                    { key: "action", label: "Type", mono: true },
                    { key: "value", label: "Value" },
                  ]}
                  rows={testData.map((f) => ({
                    label: f.label,
                    action: f.action,
                    value: (
                      <TextInput
                        value={editValues[f.index] ?? ""}
                        onChange={(e) => updateValue(f.index, e.target.value)}
                      />
                    ),
                  }))}
                />
              )}
            </div>
          </Panel>
        )}

        {selectedRecFile && <StepEditor recordingFile={selectedRecFile} onSaved={() => loadTestData(selectedRecFile)} />}

        {selectedRecording?.recording_id && <VersionHistory recordingId={selectedRecording.recording_id} />}

        {report && <ReportView key={report.transaction_id} report={report} />}

        {!selectedRecFile && (
          <Panel>
            <div className="px-5 py-10 text-center text-sm text-muted">
              Pick a saved recording to review its test data and run it.
            </div>
          </Panel>
        )}
      </div>
    </div>
  );
}
