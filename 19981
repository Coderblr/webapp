"""
action_engine.py

The single place that knows how to translate a generic action
(click/type/select/...) plus a resolved locator into real Playwright
calls. Both the Excel-driven executor and every generated Page Object
(via generator/base_page.py) go through this class, which is what keeps
the platform's "generic action abstraction" principle real: we do not
generate a bespoke function per recorded click - we generate data
(locators, element names) and call these shared methods.

Every method takes an explicit `context` (a Playwright Page or Frame -
see recorder/iframe_handler.py's resolve_frame()) rather than assuming a
single shared "current frame", plus a (strategy, value) locator pair from
the recorded/healed locator. Playwright's Locators are lazy - `context.
locator(selector)` doesn't touch the page at all until an action is
actually performed on it, and is automatically re-queried fresh on every
call - which is what eliminates the whole StaleElementReferenceException
class of bug Selenium was prone to (a WebElement handle going stale the
moment the DOM re-rendered under it).

Compared to the old Selenium version, several things this module used to
do by hand are now built into Playwright itself and have been dropped
rather than ported 1:1:
  - _ensure_in_view()/scrollIntoView before every action - Playwright's
    own actionability checks already scroll an element into view before
    interacting with it.
  - The 3-attempt real-click retry loop - Playwright's click() already
    retries its own actionability checks (visible, stable, enabled,
    receives-events) internally up to its timeout, which is what the old
    retry loop was hand-rolling around Selenium's ElementClickIntercepted-
    Exception.
  - is_selected() checks before check()/uncheck() - Playwright's check()/
    uncheck() are already idempotent no-ops if the box is already in the
    requested state.
"""
from __future__ import annotations

import logging
from typing import Optional, Union

from playwright.sync_api import Error as PlaywrightError
from playwright.sync_api import Frame, Page
from playwright.sync_api import TimeoutError as PlaywrightTimeoutError

from backend.config import settings

logger = logging.getLogger("universal_automation.action_engine")

EvaluationContext = Union[Page, Frame]

# Our generic LocatorStrategy vocabulary -> a Playwright selector-engine
# string. Playwright has no separate "By.ID"/"By.NAME" concept the way
# Selenium did - everything is expressed as one selector string, so this
# replaces the old by_for()/STRATEGY_TO_BY dict entirely.
_KEY_ALIASES = {"ENTER": "Enter", "TAB": "Tab", "ESCAPE": "Escape", "ESC": "Escape", "SPACE": "Space", "BACKSPACE": "Backspace"}


def selector_for(strategy: str, value: str) -> str:
    s = (strategy or "CSS").upper()
    if s == "ID":
        # An attribute selector (rather than a bare `#id` CSS id selector)
        # sidesteps CSS identifier-escaping entirely - real ids seen in
        # the wild often start with a digit or contain characters (colons,
        # dots) that aren't valid in a bare `#id` selector without manual
        # escaping.
        return f'[id="{value}"]'
    if s == "NAME":
        return f'[name="{value}"]'
    if s in ("XPATH", "RELATIVE_XPATH", "TEXT"):
        # locator_engine.py already builds TEXT/RELATIVE_XPATH candidates
        # as XPath strings (e.g. `//tag[normalize-space(.)="..."]`).
        return value if value.startswith("xpath=") else f"xpath={value}"
    if s == "LINK_TEXT":
        return f'text="{value}"'  # quoted = exact match in Playwright's text engine
    if s == "PARTIAL_LINK_TEXT":
        return f"text={value}"  # unquoted = substring, case-insensitive
    # CSS, DATA_TESTID, ACCESSIBILITY, ATTRIBUTE, SHADOW_PATH already
    # produce full, valid CSS selector strings from locator_engine.py -
    # pass through unchanged. Playwright's CSS engine also automatically
    # pierces open shadow roots, which Selenium could never do without
    # manual JS traversal (see recorder/shadow_dom.py).
    return value


def _resolve_key(key: str) -> str:
    return _KEY_ALIASES.get((key or "").upper(), key)


class ActionEngine:
    """Generic Playwright action executor. Stateless with respect to any
    particular application - every method takes an explicit context plus
    a (strategy, value) locator."""

    def __init__(self, page: Page, timeout: Optional[float] = None):
        self.page = page
        self.timeout = timeout or settings.EXPLICIT_WAIT_SECONDS

    @property
    def _timeout_ms(self) -> float:
        return self.timeout * 1000

    def _locator(self, context: Optional[EvaluationContext], strategy: str, value: str):
        ctx = context if context is not None else self.page
        return ctx.locator(selector_for(strategy, value)).first

    # ------------------------------------------------------------------
    def click(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        """A genuine click, going through Playwright's real input
        pipeline (its own actionability checks already retry through
        transient overlays/animations up to `timeout`). Only if that
        fails outright does this fall back to dispatching a full
        synthetic pointer/mouse event sequence - not just a bare
        `element.click()` (which fires ONE "click" event and nothing
        else; a component wired to mousedown/pointerdown instead would
        silently do nothing in response - the "locator's right, nothing
        errors, button just doesn't respond" failure mode). That
        fallback is still technically `event.isTrusted === false`; a
        handful of security-conscious apps deliberately ignore untrusted
        events, in which case no client-side event simulation can help -
        see the README's Interaction robustness section.
        """
        loc = self._locator(context, strategy, value)
        try:
            loc.click(timeout=self._timeout_ms)
            return
        except PlaywrightError as exc:
            logger.warning("click(): real click failed (%s) - falling back to a synthetic pointer/mouse event sequence.", exc)
        for evt in ("pointerdown", "mousedown", "pointerup", "mouseup", "click"):
            loc.dispatch_event(evt)

    def double_click(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._locator(context, strategy, value).dblclick(timeout=self._timeout_ms)

    def right_click(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._locator(context, strategy, value).click(button="right", timeout=self._timeout_ms)

    def type(self, context: Optional[EvaluationContext], strategy: str, value: str, text: str, clear_first: bool = True) -> None:
        loc = self._locator(context, strategy, value)
        loc.wait_for(state="visible", timeout=self._timeout_ms)
        if clear_first:
            try:
                loc.fill("", timeout=self._timeout_ms)
            except PlaywrightError:
                pass
        loc.press_sequentially(text, timeout=self._timeout_ms)
        self._verify_typed_value(loc, text)

    def _verify_typed_value(self, loc, text: str) -> None:
        """Segmented/auto-advancing inputs (the most common real case:
        4-6 separate single-digit OTP/PIN boxes) are almost always
        React/Angular "controlled" fields - the app's own JS re-validates
        and can shift focus to the next box on every keystroke, racing
        against press_sequentially() and occasionally dropping or
        overwriting a character. One quick, cheap re-check (and a single
        retry if it doesn't match) closes that race without slowing down
        the much more common case where nothing needed retrying."""
        if not text:
            return
        try:
            actual = loc.input_value(timeout=1000)
        except PlaywrightError:
            return  # can't verify (e.g. not a value-bearing element) - not worth failing the step over
        if actual == text:
            return
        try:
            loc.fill("")
        except PlaywrightError:
            pass
        loc.press_sequentially(text)

    def read_current_text(self, context: Optional[EvaluationContext], strategy: str, value: str) -> str:
        """Reads the CURRENT live value out of an element for the
        Capture -> Store -> Reuse variable pipeline (see
        execution/variable_store.py). Prefers the DOM `value` (inputs/
        textareas), falling back to visible text for a read-only display
        element (a <span>/<div> showing a system-generated ID) - this is
        what lets a value the app regenerates fresh on every run be
        re-captured live during THIS execution instead of replaying
        whatever was recorded, which would be stale by definition."""
        loc = self._locator(context, strategy, value)
        loc.wait_for(state="attached", timeout=self._timeout_ms)
        text = ""
        try:
            text = loc.input_value(timeout=1000) or ""
        except PlaywrightError:
            text = ""
        if not text:
            try:
                text = loc.text_content(timeout=1000) or ""
            except PlaywrightError:
                text = ""
        return text

    def clear(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._locator(context, strategy, value).fill("", timeout=self._timeout_ms)

    def select(self, context: Optional[EvaluationContext], strategy: str, value: str, option_text: Optional[str] = None, option_value: Optional[str] = None) -> None:
        """Recorded <select> steps carry TWO pieces of the chosen option -
        see models.py's ActionRecord.select_option_text: `option_value`
        (the option's `value` attribute, preferred at capture time) and
        `option_text` (its visible label). Real-world `<option value="X">
        Visible Label</option>` elements very often have X != Visible
        Label, so a replay that only ever tries one of the two silently/
        reliably fails whenever the app under test uses distinct codes vs.
        display text (the common enterprise case) - mirrors the same
        "no fallback across candidates" bug class already fixed for
        locators elsewhere in this module. Try the value-attribute match
        first (it's the more stable of the two - display text is more
        likely to get relabelled), then the label match, so either one
        succeeding is enough.
        """
        loc = self._locator(context, strategy, value)
        attempts = []
        if option_value:
            attempts.append(("value", option_value))
        if option_text and option_text != option_value:
            attempts.append(("label", option_text))
        elif option_value:
            # No distinct label available (old recordings made before
            # select_option_text existed only ever populate option_value -
            # which, for an option with no value attribute at capture
            # time, is actually the visible text) - retry the same string
            # as a label match rather than giving up after one attempt.
            attempts.append(("label", option_value))
        if not attempts and option_text:
            attempts.append(("label", option_text))

        last_exc: Optional[Exception] = None
        for kind, val in attempts:
            try:
                if kind == "value":
                    loc.select_option(value=val, timeout=self._timeout_ms)
                else:
                    loc.select_option(label=val, timeout=self._timeout_ms)
                return
            except PlaywrightError as exc:
                last_exc = exc
                continue
        if last_exc is not None:
            raise last_exc

    def check(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._check_or_uncheck(context, strategy, value, checked=True)

    def uncheck(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._check_or_uncheck(context, strategy, value, checked=False)

    def _check_or_uncheck(self, context: Optional[EvaluationContext], strategy: str, value: str, checked: bool) -> None:
        """Radio buttons (recorded as CHECK - see bridge.js's `change`
        listener) are overwhelmingly rendered with the real `<input
        type="radio">` visually hidden (opacity:0, clipped, or positioned
        off-screen) behind a custom-styled `<span>`/`<label>` the user
        actually sees and clicks - kept in the DOM, not `display:none`,
        specifically so it stays focusable/clickable for accessibility. A
        real user's click always lands on and toggles that real input
        regardless of how it's styled, which is exactly why this records
        fine. Playwright's `.check()`/`.uncheck()` require the target to
        pass an actionability check that includes being visible, though -
        so a plain call here failed outright on precisely the elements
        real users click every day, with no retry at all (unlike click(),
        which already falls back for the same class of problem - see its
        docstring above).

        Three tiers, cheapest/safest first:
          1. A normal check()/uncheck() - respects current state, already
             a no-op if the element is already in the target state.
          2. The same call with force=True - still state-aware and still
             idempotent, just skips the visibility/stability actionability
             checks that reject a genuinely-clickable-but-hidden input.
          3. Last resort: set `.checked` directly via JS and fire
             input/change (the same events bridge.js itself listens for)
             so any React/Vue/Angular state bound to those events still
             updates. This sets the exact target state explicitly rather
             than toggling, so - unlike a raw synthetic click - it can't
             land in the wrong state regardless of what the element's
             current state was.
        """
        loc = self._locator(context, strategy, value)
        method = "check" if checked else "uncheck"
        try:
            getattr(loc, method)(timeout=self._timeout_ms)
            return
        except PlaywrightError as exc:
            logger.warning("%s(): real %s failed (%s) - retrying with force=True (common cause: a custom-styled radio/checkbox with a visually hidden native input).", method, method, exc)
        try:
            getattr(loc, method)(timeout=self._timeout_ms, force=True)
            return
        except PlaywrightError as exc:
            logger.warning("%s(): force=True also failed (%s) - falling back to setting the DOM state directly.", method, exc)
        loc.evaluate(
            "(el, checked) => { if (el.checked !== checked) { el.checked = checked; el.dispatchEvent(new Event('input', {bubbles: true})); el.dispatchEvent(new Event('change', {bubbles: true})); } }",
            checked,
        )

    def hover(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._locator(context, strategy, value).hover(timeout=self._timeout_ms)

    def scroll_to(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        self._locator(context, strategy, value).scroll_into_view_if_needed(timeout=self._timeout_ms)

    def press_key(self, context: Optional[EvaluationContext], strategy: str, value: str, key: str) -> None:
        self._locator(context, strategy, value).press(_resolve_key(key), timeout=self._timeout_ms)

    def submit(self, context: Optional[EvaluationContext], strategy: str, value: str) -> None:
        loc = self._locator(context, strategy, value)
        try:
            loc.evaluate(
                "el => { if (el.form) { el.form.requestSubmit ? el.form.requestSubmit() : el.form.submit(); } "
                "else { el.click(); } }",
                timeout=self._timeout_ms,
            )
        except PlaywrightError:
            loc.click(timeout=self._timeout_ms)

    def upload(self, context: Optional[EvaluationContext], strategy: str, value: str, file_path: str) -> None:
        # Playwright's set_input_files() is native support for file
        # inputs - it works even on inputs hidden via CSS (a common
        # pattern for custom-styled upload buttons), which Selenium's
        # send_keys()-onto-the-input hack could not reliably do.
        self._locator(context, strategy, value).set_input_files(file_path, timeout=self._timeout_ms)

    def navigate_back(self, page: Optional[Page] = None) -> None:
        (page or self.page).go_back()

    def navigate_forward(self, page: Optional[Page] = None) -> None:
        (page or self.page).go_forward()

    def is_present(self, context: Optional[EvaluationContext], strategy: str, value: str, timeout: float = 2.0) -> bool:
        try:
            self._locator(context, strategy, value).wait_for(state="attached", timeout=timeout * 1000)
            return True
        except PlaywrightTimeoutError:
            return False
