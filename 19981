"""Reporting Engine (Section 13).

Produces a self-contained interactive HTML report per execution containing:
  • transaction id, environment, data profile used
  • step-by-step pass/fail with screenshots
  • the password-change (9750) sub-step result
  • the teller-reset socket call result and CBS response
  • self-healing actions with before/after locator diff
  • timing / performance metrics
  • links back to the knowledge repository entry and version used
"""
from __future__ import annotations

import base64
import json
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from jinja2 import Environment, FileSystemLoader, select_autoescape

from ..core import db
from ..core.config import settings
from ..core.logging_conf import get_logger
from ..execution import store
from ..knowledge import repository as repo

log = get_logger(__name__)

TEMPLATE_DIR = Path(__file__).parent / "templates"
_env = Environment(
    loader=FileSystemLoader(str(TEMPLATE_DIR)),
    autoescape=select_autoescape(["html"]),
)

PHASE_LABELS = {
    "launch": "Launch & preflight",
    "login": "Login (teller credentials)",
    "password_change": "Password change — transaction 9750",
    "relogin": "Automatic re-login",
    "search": "Transaction search",
    "transaction": "Transaction execution",
    "logout": "Logout",
    "teller_reset": "CBS teller reset (socket)",
    "report": "Reporting",
}


def _embed_image(path: str | None, max_bytes: int = 400_000) -> str:
    if not path:
        return ""
    file = Path(path)
    if not file.exists() or file.stat().st_size > max_bytes:
        return ""
    try:
        return "data:image/png;base64," + base64.b64encode(
            file.read_bytes()
        ).decode()
    except Exception:
        return ""


def collect(execution_uid: str) -> dict[str, Any]:
    execution = store.get(execution_uid)
    if not execution:
        raise ValueError(f"execution {execution_uid} not found")

    transaction = repo.get_transaction(execution["transaction_id"])
    profile = db.query_one(
        "SELECT name, environment FROM test_data_profiles WHERE id=%s",
        (execution.get("profile_pk"),),
    ) if execution.get("profile_pk") else None

    steps = execution.get("steps", [])
    for step in steps:
        step["phase_label"] = PHASE_LABELS.get(step["phase"], step["phase"])
        step["screenshot_data"] = _embed_image(step.get("screenshot_ref"))

    by_phase: dict[str, list[dict[str, Any]]] = {}
    for step in steps:
        by_phase.setdefault(step["phase"], []).append(step)

    heals = execution.get("self_heal", [])
    totals = {
        "steps": len(steps),
        "passed": sum(1 for s in steps if s["status"] == "passed"),
        "failed": sum(1 for s in steps if s["status"] == "failed"),
        "skipped": sum(1 for s in steps if s["status"] == "skipped"),
        "healed": sum(1 for s in steps if s["status"] == "healed"),
    }
    # Test-level summary (one execution = one test), separate from the
    # step-level breakdown above — matches the "Total Tests / Passed /
    # Failed / Success Rate" framing used by the reference report style.
    exec_status = execution.get("status", "failed")
    test_summary = {
        "total_tests": 1,
        "passed": 1 if exec_status == "passed" else 0,
        "failed": 1 if exec_status in ("failed", "partial") else 0,
        "success_rate": 100 if exec_status == "passed" else 0,
    }
    durations = [s.get("duration_ms") or 0 for s in steps]
    metrics = {
        **(execution.get("metrics") or {}),
        "total_step_ms": sum(durations),
        "slowest_step_ms": max(durations) if durations else 0,
        "average_step_ms": int(sum(durations) / len(durations)) if durations else 0,
    }

    return {
        "execution": execution,
        "transaction": transaction,
        "profile": profile,
        "steps": steps,
        "by_phase": by_phase,
        "phase_labels": PHASE_LABELS,
        "self_heal": heals,
        "totals": totals,
        "test_summary": test_summary,
        "metrics": metrics,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
        "knowledge_dir": (transaction or {}).get("knowledge_dir"),
        "generated_files": (transaction or {}).get("generated_files") or {},
        "chart_data": json.dumps({
            "labels": [PHASE_LABELS.get(p, p) for p in by_phase],
            "durations": [
                sum(s.get("duration_ms") or 0 for s in group)
                for group in by_phase.values()
            ],
            "status": totals,
        }),
    }


def build(execution_uid: str) -> str:
    data = collect(execution_uid)
    html = _env.get_template("report.html.j2").render(**data)
    target_dir = settings.reports_path / execution_uid
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / "report.html"
    target.write_text(html, encoding="utf-8")
    (target_dir / "report.json").write_text(
        json.dumps(
            {k: v for k, v in data.items() if k not in ("steps", "chart_data")},
            indent=2, default=str,
        ),
        encoding="utf-8",
    )
    log.info("Report written: %s", target)
    return str(target)
