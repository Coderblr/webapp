"""
action_engine.py

Generic Selenium action executor.

Responsibilities:
- Translate generic locator strategies into Selenium By strategies.
- Resolve locators safely.
- NEVER silently select the first element when a locator matches
  multiple elements.
- Perform common browser actions through one shared ActionEngine.

Important:
A locator used for an action must resolve to exactly ONE element.

This is especially important for applications such as RLMS where
the DOM can contain duplicated IDs such as:

    id="dashboardPersonalLoan"

or repeated classes such as:

    mat-card
    dashboard-content
    col-md-3
    ng-star-inserted
"""

from __future__ import annotations

import logging
import time
from typing import Optional, Tuple

from selenium.common.exceptions import (
    ElementClickInterceptedException,
    ElementNotInteractableException,
    NoSuchElementException,
    StaleElementReferenceException,
    TimeoutException,
)
from selenium.webdriver.common.action_chains import ActionChains
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.remote.webdriver import WebDriver
from selenium.webdriver.remote.webelement import WebElement
from selenium.webdriver.support.ui import Select, WebDriverWait

from backend.config import settings
from backend.storage.models import LocatorStrategy


logger = logging.getLogger(
    "universal_automation.action_engine"
)


# ============================================================================
# Locator strategy -> Selenium By
# ============================================================================

STRATEGY_TO_BY = {
    LocatorStrategy.ID: By.ID,
    LocatorStrategy.NAME: By.NAME,
    LocatorStrategy.CSS: By.CSS_SELECTOR,
    LocatorStrategy.XPATH: By.XPATH,
    LocatorStrategy.RELATIVE_XPATH: By.XPATH,
    LocatorStrategy.LINK_TEXT: By.LINK_TEXT,
    LocatorStrategy.PARTIAL_LINK_TEXT: By.PARTIAL_LINK_TEXT,

    # locator_engine generates DATA_TESTID as CSS.
    LocatorStrategy.DATA_TESTID: By.CSS_SELECTOR,

    # locator_engine generates these as XPath.
    LocatorStrategy.ACCESSIBILITY: By.XPATH,
    LocatorStrategy.ATTRIBUTE: By.XPATH,
    LocatorStrategy.TEXT: By.XPATH,
}


# ---------------------------------------------------------------------------
# Backwards compatibility for string strategy names.
# ---------------------------------------------------------------------------

STRATEGY_TO_BY.update(
    {
        "ID": By.ID,
        "NAME": By.NAME,
        "CSS": By.CSS_SELECTOR,
        "XPATH": By.XPATH,
        "RELATIVE_XPATH": By.XPATH,
        "LINK_TEXT": By.LINK_TEXT,
        "PARTIAL_LINK_TEXT": By.PARTIAL_LINK_TEXT,
        "DATA_TESTID": By.CSS_SELECTOR,
        "ACCESSIBILITY": By.XPATH,
        "ATTRIBUTE": By.XPATH,
        "TEXT": By.XPATH,
    }
)


def by_for(strategy: str):
    """
    Convert a generic locator strategy into Selenium's By constant.
    """

    return STRATEGY_TO_BY.get(
        strategy,
        By.CSS_SELECTOR,
    )


# ============================================================================
# Action Engine
# ============================================================================

class ActionEngine:
    """
    Generic Selenium action executor.

    Every action takes a locator:

        by
        value

    The engine deliberately refuses to act when the locator matches
    multiple elements.

    This prevents the classic Selenium problem:

        find_element(...)
            -> silently returns first match
            -> wrong card gets clicked
    """

    def __init__(
        self,
        driver: WebDriver,
        timeout: Optional[float] = None,
    ):
        self.driver = driver

        self.timeout = (
            timeout
            or settings.EXPLICIT_WAIT_SECONDS
        )

    # ========================================================================
    # LOW-LEVEL LOCATOR RESOLUTION
    # ========================================================================

    def _find_elements(
        self,
        by,
        value: str,
    ) -> list[WebElement]:
        """
        Return ALL matching elements.

        This is intentionally different from Selenium's find_element().

        We need the complete result set so that we can detect:

            0 matches
            1 match
            2+ matches

        before performing an action.
        """

        try:
            return self.driver.find_elements(
                by,
                value,
            )

        except (
            NoSuchElementException,
            StaleElementReferenceException,
        ):
            return []

    def _find_unique_now(
        self,
        by,
        value: str,
    ) -> Optional[WebElement]:
        """
        Return an element only when the locator matches exactly one element.

        Returns:
            WebElement -> exactly one match
            None       -> zero or multiple matches

        IMPORTANT:
        Multiple matches are intentionally treated as unusable.
        """

        elements = self._find_elements(
            by,
            value,
        )

        if len(elements) == 0:
            return None

        if len(elements) > 1:

            logger.warning(
                "Ambiguous locator rejected: "
                "%s=%r matched %d elements",
                by,
                value,
                len(elements),
            )

            return None

        return elements[0]

    def _find_any_now(
        self,
        by,
        value: str,
    ) -> Optional[WebElement]:
        """
        Return the first matching element.

        This method is ONLY intended for non-action inspection
        where uniqueness is not required.

        Do NOT use this for clicks/types/selections.
        """

        elements = self._find_elements(
            by,
            value,
        )

        if not elements:
            return None

        return elements[0]

    # ========================================================================
    # WAIT
    # ========================================================================

    def wait_for(
        self,
        by,
        value: str,
        condition: str = "visible",
    ) -> WebElement:
        """
        Wait until a locator resolves to exactly one usable element.

        Conditions:

            clickable
            visible
            present

        IMPORTANT:
        If the locator matches multiple elements, it is considered
        ambiguous and the wait continues.

        This is the main protection against the RLMS duplicated-ID
        problem.
        """

        def resolve(_driver):

            element = self._find_unique_now(
                by,
                value,
            )

            if element is None:
                return False

            try:

                if condition == "present":
                    return element

                if condition == "clickable":

                    if not element.is_displayed():
                        return False

                    if not element.is_enabled():
                        return False

                    return element

                # Default = visible.
                if not element.is_displayed():
                    return False

                return element

            except (
                StaleElementReferenceException,
                ElementNotInteractableException,
            ):
                return False

        try:

            return WebDriverWait(
                self.driver,
                self.timeout,
                poll_frequency=0.2,
            ).until(resolve)

        except TimeoutException as exc:

            # Give a useful diagnostic.
            try:
                count = len(
                    self._find_elements(
                        by,
                        value,
                    )
                )
            except Exception:
                count = -1

            if count > 1:

                raise TimeoutException(
                    f"Ambiguous locator: "
                    f"{by}={value!r} "
                    f"matched {count} elements. "
                    f"Refusing to choose the first element."
                ) from exc

            raise TimeoutException(
                f"Element not found/usable: "
                f"{by}={value!r}, "
                f"condition={condition!r}"
            ) from exc

    # ========================================================================
    # FIND
    # ========================================================================

    def find(
        self,
        by,
        value: str,
    ) -> WebElement:
        """
        Find exactly one element.

        This replaces unsafe direct usage of:

            driver.find_element(by, value)

        for actions.
        """

        element = self._find_unique_now(
            by,
            value,
        )

        if element is None:

            elements = self._find_elements(
                by,
                value,
            )

            if len(elements) > 1:

                raise RuntimeError(
                    f"Ambiguous locator: "
                    f"{by}={value!r} "
                    f"matched {len(elements)} elements. "
                    f"Refusing to select the first element."
                )

            raise NoSuchElementException(
                f"No element found for "
                f"{by}={value!r}"
            )

        return element

    # ========================================================================
    # VIEW / SCROLL
    # ========================================================================

    def _ensure_in_view(
        self,
        element: WebElement,
    ) -> None:
        """
        Scroll the element into the center of the viewport.
        """

        try:

            self.driver.execute_script(
                """
                arguments[0].scrollIntoView({
                    block: 'center',
                    inline: 'center'
                });
                """,
                element,
            )

            # Small delay helps Angular/material animations settle.
            time.sleep(0.05)

        except Exception:
            logger.debug(
                "Could not scroll element into view",
                exc_info=True,
            )

    # ========================================================================
    # CLICK
    # ========================================================================

    def click(
        self,
        by,
        value: str,
    ) -> None:
        """
        Click exactly one unique element.
        """

        el = self.wait_for(
            by,
            value,
            condition="clickable",
        )

        self._ensure_in_view(el)

        try:

            el.click()

        except (
            ElementClickInterceptedException,
            ElementNotInteractableException,
        ):

            logger.warning(
                "Normal click failed; retrying with ActionChains: "
                "%s=%r",
                by,
                value,
            )

            # Re-resolve after scrolling/DOM changes.
            el = self.wait_for(
                by,
                value,
                condition="clickable",
            )

            self._ensure_in_view(el)

            ActionChains(
                self.driver
            ).move_to_element(el).click().perform()

    # ========================================================================
    # DOUBLE CLICK
    # ========================================================================

    def double_click(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="clickable",
        )

        self._ensure_in_view(el)

        ActionChains(
            self.driver
        ).double_click(el).perform()

    # ========================================================================
    # RIGHT CLICK
    # ========================================================================

    def right_click(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="clickable",
        )

        self._ensure_in_view(el)

        ActionChains(
            self.driver
        ).context_click(el).perform()

    # ========================================================================
    # TYPE
    # ========================================================================

    def type(
        self,
        by,
        value: str,
        text: str,
        clear_first: bool = True,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        if clear_first:

            try:
                el.clear()

            except (
                ElementNotInteractableException,
                StaleElementReferenceException,
            ):

                # Re-resolve once after DOM refresh.
                el = self.wait_for(
                    by,
                    value,
                    condition="visible",
                )

                try:
                    el.clear()
                except Exception:
                    pass

        el.send_keys(text)

    # ========================================================================
    # CLEAR
    # ========================================================================

    def clear(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        el.clear()

    # ========================================================================
    # SELECT
    # ========================================================================

    def select(
        self,
        by,
        value: str,
        option_text: Optional[str] = None,
        option_value: Optional[str] = None,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        select = Select(el)

        if option_value is not None:

            select.select_by_value(
                option_value
            )

        elif option_text is not None:

            select.select_by_visible_text(
                option_text
            )

        else:

            raise ValueError(
                "select() requires either "
                "option_text or option_value"
            )

    # ========================================================================
    # CHECK
    # ========================================================================

    def check(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="clickable",
        )

        self._ensure_in_view(el)

        if not el.is_selected():
            el.click()

    # ========================================================================
    # UNCHECK
    # ========================================================================

    def uncheck(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="clickable",
        )

        self._ensure_in_view(el)

        if el.is_selected():
            el.click()

    # ========================================================================
    # HOVER
    # ========================================================================

    def hover(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        ActionChains(
            self.driver
        ).move_to_element(el).perform()

    # ========================================================================
    # SCROLL TO
    # ========================================================================

    def scroll_to(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="present",
        )

        self.driver.execute_script(
            """
            arguments[0].scrollIntoView({
                block: 'center',
                inline: 'center'
            });
            """,
            el,
        )

    # ========================================================================
    # PRESS KEY
    # ========================================================================

    def press_key(
        self,
        by,
        value: str,
        key: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        key_obj = getattr(
            Keys,
            key.upper(),
            None,
        )

        el.send_keys(
            key_obj if key_obj else key
        )

    # ========================================================================
    # SUBMIT
    # ========================================================================

    def submit(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="present",
        )

        try:

            el.submit()

        except Exception:

            # Re-resolve before fallback click.
            el = self.wait_for(
                by,
                value,
                condition="clickable",
            )

            self._ensure_in_view(el)

            el.click()

    # ========================================================================
    # UPLOAD
    # ========================================================================

    def upload(
        self,
        by,
        value: str,
        file_path: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="visible",
        )

        self._ensure_in_view(el)

        el.send_keys(file_path)

    # ========================================================================
    # FRAME
    # ========================================================================

    def switch_to_frame(
        self,
        by,
        value: str,
    ) -> None:

        el = self.wait_for(
            by,
            value,
            condition="present",
        )

        self.driver.switch_to.frame(el)

    # ========================================================================
    # DEFAULT CONTENT
    # ========================================================================

    def switch_to_default(self) -> None:

        self.driver.switch_to.default_content()

    # ========================================================================
    # WINDOW
    # ========================================================================

    def switch_window(
        self,
        handle: Optional[str] = None,
    ) -> None:

        if handle:

            self.driver.switch_to.window(
                handle
            )

        else:

            handles = self.driver.window_handles

            if handles:

                self.driver.switch_to.window(
                    handles[-1]
                )

        # A freshly-opened window/tab can sometimes
        # swallow the first click/keystroke because
        # browser focus has not settled yet.

        try:

            self.driver.execute_script(
                "window.focus();"
            )

        except Exception:

            pass

    # ========================================================================
    # NAVIGATION
    # ========================================================================

    def navigate_back(self) -> None:

        self.driver.back()

    def navigate_forward(self) -> None:

        self.driver.forward()

    # ========================================================================
    # PRESENCE CHECK
    # ========================================================================

    def is_present(
        self,
        by,
        value: str,
        timeout: float = 2.0,
    ) -> bool:
        """
        Presence check.

        Unlike action methods, this method does NOT require uniqueness.

        If one or more elements exist, the element is considered present.

        This is useful for:
            if self.is_present(...):
                ...
        """

        end_time = time.monotonic() + timeout

        while time.monotonic() < end_time:

            try:

                elements = self._find_elements(
                    by,
                    value,
                )

                if elements:
                    return True

            except Exception:

                pass

            time.sleep(0.1)

        return False