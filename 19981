"""CBS Socket Client — teller reset (Section 11.4).

Opens a raw socket to the CBS endpoint, fires the user-provided reset
string, confirms the reset and logs the outcome into the execution report.

This ALWAYS runs as the final step of every execution, success or failure,
so a teller ID is never left locked or dirty.  The reset string itself is a
user-supplied secret — it is decrypted only here and masked everywhere else.
"""
from __future__ import annotations

import socket
import time
from dataclasses import dataclass, field
from typing import Any, Optional

from ..core.config import settings
from ..core.logging_conf import get_logger, register_secret

log = get_logger(__name__)

SUCCESS_MARKERS = ("SUCCESS", "OK", "DONE", "RESET", "00", "COMPLETED")
FAILURE_MARKERS = ("FAIL", "ERROR", "INVALID", "DENIED", "REJECT")


@dataclass
class ResetResult:
    ok: bool
    status: str                      # success | failed | skipped | unreachable
    response: str = ""
    detail: str = ""
    duration_ms: int = 0
    host: str = ""
    port: int = 0
    attempts: int = 0
    meta: dict[str, Any] = field(default_factory=dict)

    def as_dict(self) -> dict[str, Any]:
        return {
            "ok": self.ok, "status": self.status, "response": self.response,
            "detail": self.detail, "duration_ms": self.duration_ms,
            "host": self.host, "port": self.port, "attempts": self.attempts,
            **self.meta,
        }


# ═══════════════════════════════════════════════════════════════════════
# CBS BOG-protocol reset (the real production message format).
#
# Ported from the existing `/tellerr` endpoint used elsewhere. Only the
# "C" region is wired up here, per instruction — the rest of SERVER_CONFIG
# is kept commented out (verbatim from the source) so adding a region
# later is a one-line uncomment, not a rewrite.
# ═══════════════════════════════════════════════════════════════════════
SERVER_CONFIG: dict[str, dict[str, Any]] = {
    "C": {"host": "10.191.169.161", "port": 3348},
    # "X":  {"host": "10.189.15.243", "port": 5526},
    # "Y":  {"host": "10.189.15.239", "port": 3347},
    # "Y2": {"host": "10.191.169.33", "port": 6930},
    # "O":  {"host": "10.189.15.243", "port": 3347},
    # "Z":  {"host": "10.189.15.241", "port": 5526},
    # "K":  {"host": "10.189.15.241", "port": 3348},
    # "J":  {"host": "10.191.161.72", "port": 3305},
    # "L":  {"host": "10.191.169.44", "port": 3348},
    # "R1": {"host": "10.189.15.78", "port": 6930},
}

# Fixed-width base messages — copied verbatim. OLD_TELLER is replaced with
# the real runtime teller number at send time. Because this is a
# fixed-width record, the substituted teller number MUST be the same
# length as OLD_TELLER (7 chars) or every field after it shifts — see the
# length check in _build_bog_message().
OLD_TELLER = "2348212"

BOG_STRINGS = {
    "A": " 1097                    **  0000      003004370131011405009760000000000     0         10000000        1023605000000000000000000000002348212                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    10.0.18.82     10.177.137.217 ",
    # "B": " 1097                    **  0000      003004370131011406009760000000000     0         10000000        1011407000000000000000000000002348212                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    10.0.18.82     10.177.137.217 ",
    # "C": " 1097                    **  0000      003004370131011408009760000000000     0         10000000        1011409000000000000000000000002348212                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    10.0.18.82     10.177.137.217 ",
}


def _build_bog_message(bog: str, teller_no: str) -> str:
    base = BOG_STRINGS.get((bog or "A").upper(), BOG_STRINGS["A"])
    if len(teller_no) != len(OLD_TELLER):
        log.warning(
            "CBS teller number %r is %d chars, expected %d (fixed-width "
            "record) — the message layout may shift after substitution",
            teller_no, len(teller_no), len(OLD_TELLER),
        )
    return base.replace(OLD_TELLER, teller_no)


def reset_teller_cbs(
    teller_no: str,
    bog: str | None = None,
    region: str | None = None,
    timeout: int | None = None,
) -> ResetResult:
    """Fire the real CBS BOG-protocol reset message. Region "C" only."""
    region_key = (region or settings.cbs_region or "C").upper()
    if region_key not in SERVER_CONFIG:
        return ResetResult(
            ok=False, status="skipped",
            detail=f"CBS region '{region_key}' is not enabled — only 'C' is wired up",
        )
    server = SERVER_CONFIG[region_key]
    bog_key = (bog or settings.cbs_bog_variant or "A").upper()
    if bog_key not in BOG_STRINGS:
        return ResetResult(
            ok=False, status="skipped",
            detail=f"bog variant '{bog_key}' is not enabled — only 'A' is active "
                   f"(B/C are commented out in BOG_STRINGS)",
            host=server["host"], port=server["port"],
        )
    if not teller_no:
        return ResetResult(
            ok=False, status="skipped",
            detail="No teller number supplied for CBS reset",
            host=server["host"], port=server["port"],
        )

    message = _build_bog_message(bog_key, teller_no)
    register_secret(teller_no)
    tmo = int(timeout or settings.cbs_socket_timeout)
    started = time.time()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as client_socket:
            client_socket.settimeout(tmo)
            client_socket.connect((server["host"], server["port"]))
            client_socket.sendall(message.encode("utf-8"))
            response = client_socket.recv(1024).decode("utf-8")
        duration = int((time.time() - started) * 1000)
        # No response parsing — the reset is fire-and-confirm-connectivity
        # only. A non-empty reply means the CBS endpoint answered; that's
        # all this checks.
        ok = bool(response.strip())
        log.info(
            "CBS teller reset (region=%s bog=%s) -> %s (%dms)",
            region_key, bog_key, "response received" if ok else "empty response", duration,
        )
        return ResetResult(
            ok=ok,
            status="success" if ok else "failed",
            response=response[:2000],
            detail="" if ok else "CBS returned an empty response",
            duration_ms=duration,
            host=server["host"], port=server["port"], attempts=1,
            meta={"bog": bog_key, "region": region_key, "final_message": message},
        )
    except socket.timeout as exc:
        return ResetResult(
            ok=False, status="unreachable", detail=f"socket timeout: {exc}",
            duration_ms=int((time.time() - started) * 1000),
            host=server["host"], port=server["port"], attempts=1,
        )
    except OSError as exc:
        return ResetResult(
            ok=False, status="unreachable", detail=str(exc),
            duration_ms=int((time.time() - started) * 1000),
            host=server["host"], port=server["port"], attempts=1,
        )


# ═══════════════════════════════════════════════════════════════════════
# Generic line-terminated protocol — kept as a fallback for profiles that
# still use a free-text `cbs_reset_string` secret instead of the BOG
# protocol above. Selected via settings.cbs_reset_protocol="generic".
# ═══════════════════════════════════════════════════════════════════════
class CBSSocketClient:
    def __init__(
        self,
        host: str | None = None,
        port: int | None = None,
        timeout: int | None = None,
        encoding: str | None = None,
    ) -> None:
        self.host = host or settings.cbs_socket_host
        self.port = int(port or settings.cbs_socket_port or 0)
        self.timeout = int(timeout or settings.cbs_socket_timeout)
        self.encoding = encoding or settings.cbs_socket_encoding

    def configured(self) -> bool:
        return bool(self.host and self.port)

    def send(
        self,
        payload: str,
        terminator: str = "\n",
        expect_response: bool = True,
        retries: int = 2,
    ) -> ResetResult:
        """Fire the reset string and read the CBS response."""
        if not self.configured():
            return ResetResult(
                ok=False, status="skipped",
                detail="CBS_SOCKET_HOST / CBS_SOCKET_PORT not configured",
                host=self.host, port=self.port,
            )
        if not payload:
            return ResetResult(
                ok=False, status="skipped",
                detail="No CBS reset string supplied for this profile",
                host=self.host, port=self.port,
            )
        register_secret(payload)

        last_error = ""
        started = time.time()
        for attempt in range(1, retries + 1):
            try:
                with socket.create_connection((self.host, self.port), self.timeout) as sock:
                    sock.settimeout(self.timeout)
                    message = payload if payload.endswith(terminator) else payload + terminator
                    sock.sendall(message.encode(self.encoding, errors="replace"))
                    response = ""
                    if expect_response:
                        chunks: list[bytes] = []
                        try:
                            while True:
                                chunk = sock.recv(4096)
                                if not chunk:
                                    break
                                chunks.append(chunk)
                                if len(b"".join(chunks)) > 65536:
                                    break
                                if b"\n" in chunk:
                                    break
                        except socket.timeout:
                            pass
                        response = b"".join(chunks).decode(
                            self.encoding, errors="replace"
                        ).strip()
                    duration = int((time.time() - started) * 1000)
                    ok = self._interpret(response)
                    log.info(
                        "CBS teller reset attempt %d -> %s (%dms)",
                        attempt, "OK" if ok else "NOT-CONFIRMED", duration,
                    )
                    return ResetResult(
                        ok=ok,
                        status="success" if ok else "failed",
                        response=response[:2000],
                        detail="" if ok else "CBS response did not confirm reset",
                        duration_ms=duration,
                        host=self.host, port=self.port, attempts=attempt,
                    )
            except (socket.timeout, OSError) as exc:
                last_error = str(exc)
                log.warning("CBS socket attempt %d failed: %s", attempt, exc)
                time.sleep(min(2 * attempt, 5))

        return ResetResult(
            ok=False, status="unreachable", detail=last_error,
            duration_ms=int((time.time() - started) * 1000),
            host=self.host, port=self.port, attempts=retries,
        )

    @staticmethod
    def _interpret(response: str) -> bool:
        if not response:
            # Some CBS endpoints acknowledge silently; treat as unconfirmed.
            return False
        upper = response.upper()
        if any(marker in upper for marker in FAILURE_MARKERS):
            return False
        return any(marker in upper for marker in SUCCESS_MARKERS)


def reset_teller(
    reset_string: str,
    host: str | None = None,
    port: int | None = None,
    teller_id: str | None = None,
) -> ResetResult:
    """Convenience wrapper used by the Execution Agent's finally-node.

    Called ONLY after the transaction execution has been attempted (see
    ExecutionPipeline.run()'s `finally:` block / execution_graph.py's
    teller_reset_step, which every terminal path routes through) — never
    before, and always, whether execution passed, failed, or errored.

    Defaults to the real CBS BOG-protocol reset (region "C") — set
    `cbs_reset_protocol=generic` in .env to fall back to the older
    free-text/terminator protocol driven by a stored `reset_string` secret.
    `{TELLER_ID}` inside a generic-protocol reset string is substituted at
    send time so a single stored template works for any teller.
    """
    if (settings.cbs_reset_protocol or "bog").lower() == "bog":
        return reset_teller_cbs(teller_no=teller_id or "")

    payload = reset_string or ""
    if teller_id:
        payload = payload.replace("{TELLER_ID}", teller_id).replace(
            "{TELLERID}", teller_id
        )
    client = CBSSocketClient(host=host, port=port)
    result = client.send(payload)
    result.meta["teller_id_masked"] = (
        (teller_id[:2] + "***") if teller_id else ""
    )
    return result


def probe(host: str | None = None, port: int | None = None,
          timeout: int = 5) -> dict[str, Any]:
    """Connectivity check for the Execute screen — no payload is sent."""
    target_host = host or settings.cbs_socket_host
    target_port = int(port or settings.cbs_socket_port or 0)
    if not (target_host and target_port):
        return {"reachable": False, "detail": "CBS socket not configured"}
    started = time.time()
    try:
        with socket.create_connection((target_host, target_port), timeout):
            return {
                "reachable": True,
                "host": target_host,
                "port": target_port,
                "latency_ms": int((time.time() - started) * 1000),
            }
    except OSError as exc:
        return {"reachable": False, "host": target_host, "port": target_port,
                "detail": str(exc)}
