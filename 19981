// The server stores and sends times in UTC, written without a timezone marker (e.g. "2026-11-07T06:07:15").
// new Date() reads such a string as the browser's OWN local time, so it showed the UTC clock time as if it were
// local - wrong by the timezone offset. These helpers read it as UTC and show it in the viewer's PC date, time
// and timezone.

/** A Date for a server timestamp (UTC unless it already carries a timezone), or null. */
export function parseServerTime(value) {
  if (!value) return null;
  const s = String(value);
  const d = new Date(/(Z|[+-]\d\d:?\d\d)$/i.test(s) ? s : `${s}Z`);
  return Number.isNaN(d.getTime()) ? null : d;
}

/** "07 Nov 2026, 11:37:15 am IST" - the viewer's local date, time and timezone. */
export function fmtLocalDateTime(value, empty = "—") {
  const d = parseServerTime(value);
  if (!d) return empty;
  return d.toLocaleString(undefined, {
    day: "2-digit", month: "short", year: "numeric",
    hour: "2-digit", minute: "2-digit", second: "2-digit", timeZoneName: "short",
  });
}
