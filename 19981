    return {"updated": True, "row_count": len(req.steps)}


# ----------------------------------------------------------------------
# BRD/Solution Document change detection (backend/change_detection/):
# upload a document -> AI extracts "element added/removed" entries ->
# each entry is resolved to a real locator (ADD, via a live re-crawl) or
# an existing step (REMOVE) -> the user confirms -> apply patches
# execution.xlsx and remembers which step numbers were affected so they
# can be re-executed alone. See README's "BRD/SD change detection"
# section for the full flow.
# ----------------------------------------------------------------------
@app.post("/api/changes/detect")
async def detect_changes(request: Request, file: UploadFile = File(...), ai_provider: Optional[str] = Form(None)) -> Dict[str, Any]:
    suffix = Path(file.filename or "").suffix
    tmp_dir = Path(tempfile.mkdtemp())
    tmp_path = tmp_dir / f"upload{suffix}"
    try:
        tmp_path.write_bytes(await file.read())
        try:
            text = document_extractor.extract_text(tmp_path)
        except (document_extractor.UnsupportedDocumentError, ValueError) as exc:
            raise HTTPException(400, str(exc))

        try:
            changes = brd_parser.extract_changes(text, ai_provider)
        except brd_parser.BRDParsingUnavailableError as exc:
            raise HTTPException(400, str(exc))
    finally:
        import shutil as _shutil
        _shutil.rmtree(tmp_dir, ignore_errors=True)

    for entry in changes:
        match = transaction_matcher.find_recording(entry, recording_store)
        entry["matched_recording_id"] = match["recording_id"] if match else None
        entry["matched_recording_name"] = match["recording_name"] if match else ""
        entry["match_type"] = match["match_type"] if match else "none"
        entry["match_confidence"] = match["confidence"] if match else 0.0

    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "changes_detected",
        details={"source_document": file.filename or "uploaded_document", "change_count": len(changes)},
    )
    return {"source_document": file.filename or "uploaded_document", "changes": changes}


@app.post("/api/changes/resolve")
def resolve_change(req: ResolveChangeRequest) -> Dict[str, Any]:
    """Given one change entry (from /api/changes/detect, possibly edited by
    the user first - e.g. to correct which recording it applies to), works
    out where it goes and, for an ADD, what its live locator actually is.
    Nothing is written yet - the result is meant to be shown to the user
    for a final confirm/edit before /api/changes/apply."""
    if not recording_store.exists(req.recording_id):
        raise HTTPException(404, "Recording not found")
    meta = recording_store.load_metadata(req.recording_id)
    paths = recording_store.paths(req.recording_id)
    steps = ExcelExecutor(paths.execution_excel).load_steps()
    entry = dict(req.change_entry)
    change_type = entry.get("change_type")

    if change_type == "ADDED":
        result = element_resolver.resolve_added_element(
            entry, steps, meta.target_url if meta else "",
            browser=req.browser, remote_node_url=req.remote_node_url, ai_provider=req.ai_provider,
        )
    elif change_type == "REMOVED":
        result = element_resolver.resolve_removed_element(entry, steps)
    else:
        raise HTTPException(400, f"Unknown or missing change_type '{change_type}' - expected 'ADDED' or 'REMOVED'")

    return {**entry, **result}


@app.post("/api/changes/apply")
def apply_changes_endpoint(req: ApplyChangesRequest, request: Request) -> Dict[str, Any]:
    """Patches execution.xlsx with every confirmed change entry (each one
    already resolved via /api/changes/resolve, and reviewed/edited by the
    user) and records a change-set for audit + scoped re-execution."""
    if not recording_store.exists(req.recording_id):
        raise HTTPException(404, "Recording not found")
    if not req.entries:
        raise HTTPException(400, "entries must be a non-empty list")
    paths = recording_store.paths(req.recording_id)
    result = change_applier.apply_changes(paths, req.source_document, req.entries)
    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "changes_applied",
        recording_id=req.recording_id,
        details={"source_document": req.source_document, "entry_count": len(req.entries)},
    )
    return result


