@library.get("/{transaction_id}")
def get_transaction(transaction_id: str) -> dict[str, Any]:
    txn = repo.get_transaction(transaction_id)
    if not txn:
        raise HTTPException(404, f"transaction {transaction_id} not found")
    transaction_pk = int(txn["id"])
    return {
        "transaction": txn,
        "versions": versioning.history(transaction_id),
        "elements": repo.get_elements(transaction_pk),
        "actions": repo.get_actions(transaction_pk),
        "validations": repo.get_validation_rules(transaction_pk),
        "knowledge": knowledge_agent(action="check",
                                     transaction_id=transaction_id),
    }


@library.get("/{transaction_id}/versions")
def transaction_versions(transaction_id: str) -> list[dict[str, Any]]:
    return versioning.history(transaction_id)


@library.get("/{transaction_id}/components")
def transaction_components(transaction_id: str) -> dict[str, Any]:
    """Section 19 — reusable-component candidates for an already-KEPT
    transaction: elements/pages this transaction shares with OTHER
    already-known transactions."""
    txn = repo.get_transaction(transaction_id)
    if not txn:
        raise HTTPException(404, f"transaction {transaction_id} not known")
    from ..recorder import component_detector
    elements = repo.get_elements(int(txn["id"]))
    by_page: dict[str, list[dict[str, Any]]] = {}
    for element in elements:
        key = element.get("element_key", "")
        page_key = key.split("::", 1)[0] if "::" in key else "page"
        by_page.setdefault(page_key, []).append(element)

    components = []
    for page_key, page_elements in by_page.items():
        result = component_detector.detect_against_knowledge_base(
            transaction_id, page_key, page_elements
        )
        if result:
            components.append(result)
    return {"transaction_id": transaction_id, "components": components}


@library.get("/{transaction_id}/compare-recordings")
def compare_recordings(transaction_id: str) -> dict[str, Any]:
    """Section 20 — compares every STORED recording (regardless of
    whether it was ultimately kept, discarded, or superseded) for this
    transaction_id, to find stable vs. drifting locators and
    optional/conditional pages."""
    sessions = db.query(
        "SELECT session_uid, capture_dir, started_at FROM recording_sessions "
        "WHERE transaction_id=%s AND capture_dir IS NOT NULL ORDER BY started_at ASC",
        (transaction_id,),
    )
    manifests = []
    for session_row in sessions:
        manifest_path = Path(session_row["capture_dir"]) / "manifest.json"
        if manifest_path.exists():
            try:
                manifests.append(json.loads(manifest_path.read_text(encoding="utf-8")))
            except (json.JSONDecodeError, OSError):
                continue
    from ..recorder import recording_comparator
    result = recording_comparator.compare(manifests)
    result["sessions_found"] = len(sessions)
    result["manifests_readable"] = len(manifests)
    return result


