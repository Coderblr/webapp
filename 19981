@app.exception_handler(Exception)
async def unhandled_exception_handler(request: Request, exc: Exception):
    """
    Safety net for ANY endpoint that raises something not already turned
    into an HTTPException - without this, FastAPI's default behavior is to
    return a bare "500 Internal Server Error" with NOTHING in the response
    and (depending on how uvicorn's own logging is configured) not
    necessarily anything in a log file either - exactly the
    "Save & Generate failed: 500 Server Error" report with no way to
    diagnose it further. This logs the full traceback to logs/error.log
    (via the root logger - see logging.ini) and returns a JSON body that at
    least names the exception instead of an empty response.
    """
    logger.error(
        "Unhandled exception on %s %s\n%s",
        request.method, request.url.path,
        "".join(traceback.format_exception(type(exc), exc, exc.__traceback__)),
    )
    return JSONResponse(
        status_code=500,
        content={"detail": f"Internal server error ({type(exc).__name__}: {exc}). See logs/error.log for the full traceback."},
    )


