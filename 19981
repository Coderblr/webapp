"""
Entrypoint: `python -m local_agent.main`

This is what Electron's main process spawns as a child process (see
electron/main.js) - a plain Python script with no GUI of its own; all
interaction happens via the connection to the central backend (recording/
test commands) and via stdout/log files (see local_agent/logger.py) for
diagnostics Electron surfaces through its own status indicator.

Configuration is entirely via environment variables (spec section 22 -
"no localhost URLs in production"), set by Electron before spawning this
process:

    SERVER_URL   - e.g. https://recorder.yourbank.internal (required in production)
    WS_URL       - optional override; derived from SERVER_URL otherwise
    AGENT_VERSION - the installed desktop app's version, for the backend's agent listing
    LOG_LEVEL    - DEBUG/INFO/WARNING/ERROR (default INFO)

--behave-worker: a second, hidden mode this same entrypoint supports -
see runner/run_tests.py's run_behave_cli for the full explanation of why.
Short version: a PyInstaller-frozen local_agent.exe has no separate
"python.exe" to shell out to for running Behave in its own clean process
the way the non-frozen path does (sys.executable inside a frozen build
just points back at this exe) - and running Behave repeatedly IN-PROCESS
inside one long-lived agent turned out to leak internal behave state
across runs in ways that go beyond the documented step-registry (a second
test run in the same process failed with "AmbiguousStep... already
defined" even after resetting behave.step_registry.registry - something
else inside behave was still holding onto the first run's state). So
instead, run_behave_cli spawns THIS SAME EXE again as a subprocess with
"--behave-worker <behave CLI args>", and that invocation short-circuits
straight to behave's own entry point and exits - giving every single test
run a genuinely fresh, fully isolated OS process, exactly like the
non-frozen/server-side path already gets for free via a real python.exe.
"""
import sys


def _run_as_behave_worker(argv: list[str]) -> None:
    from behave.__main__ import main as behave_main
    try:
        returncode = behave_main(argv)
        sys.exit(returncode if isinstance(returncode, int) else 0)
    except SystemExit:
        raise
    except Exception as e:
        print(f"local_agent --behave-worker failed: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "--behave-worker":
        _run_as_behave_worker(sys.argv[2:])
        return  # unreachable (the branch above always sys.exit()s) - kept for clarity

    from local_agent.client import main as run_agent_main
    run_agent_main()


if __name__ == "__main__":
    main()
