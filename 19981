"""Step Definitions for transaction 9750 (mandatory password change).

Credentials come from the
encrypted secret store via environment variables set by the Execution
Agent — never from this file, never from the feature file, never from AI.

Every step uses @step (matches ANY of Given/When/Then) rather than
@given/@when/@then — see common_steps.py's module docstring for why: the
feature file's "And user logs in again with the new password" line
follows "Then the password change is confirmed" and so resolves to a THEN
step; a step registered with @when never matches that, and behave reports
it as undefined. That specific step was previously registered with
@when and silently never ran — the actual explicit logout+re-login click
never happened; the run only appeared to recover because the NEXT
scenario's Background step attempts a fresh login regardless.
"""
from __future__ import annotations

import os
import time

from behave import step

from core.driver_factory import get_driver
from pages.login_page import LoginPage
from pages.transaction_9750_page import Transaction9750Page
from utils import execution_context as ctx


def _page() -> Transaction9750Page:
    return Transaction9750Page(get_driver())


def _login() -> LoginPage:
    return LoginPage(get_driver())


def _current_password() -> str | None:
    return os.environ.get("SBI_TELLER_PASSWORD")


def _new_password() -> str:
    value = os.environ.get("SBI_TELLER_NEW_PASSWORD")
    if not value:
        raise RuntimeError(
            "SBI_TELLER_NEW_PASSWORD was not supplied. Add 'teller_new_password' "
            "to the profile in the Profile Manager.")
    return value


@step("the change password window is displayed")
def step_change_password_window_displayed(context):
    assert _page().is_visible(), "The forced Change Password window did not appear"
    ctx.record_step("password_change", "Change Password window displayed", "passed", 0, "", None)


@step("user enters the current password")
def step_user_enters_current_password(context):
    _page().enter_current_password(_current_password())


@step("user enters the new password")
def step_user_enters_new_password(context):
    _page().enter_new_password(_new_password())


@step("user confirms the new password")
def step_user_confirms_new_password(context):
    _page().confirm_new_password(_new_password())


@step("user submits the password change")
def step_user_submits_password_change(context):
    _page().submit()


@step("the password change is confirmed")
def step_password_change_is_confirmed(context):
    confirmed = _page().is_change_confirmed()
    ctx.record_step("password_change", "Password changed",
                     "passed" if confirmed else "failed", 0, "",
                     None if confirmed else "Password change was not confirmed by the app")
    assert confirmed, "Password change was not confirmed"


@step("user logs in again with the new password")
def step_user_logs_in_again(context):
    started = time.time()
    login = _login()
    # Explicit Logout first — matches the real application flow (old
    # password/new password/confirm -> submit -> LOGOUT -> log back in
    # with the new password). Navigating straight to the login URL
    # without clicking Logout can leave the prior session half-open on
    # apps that require a real logout to release the teller session
    # before a fresh login is accepted.
    login.logout()
    teller_id = os.environ.get("SBI_TELLER_ID")
    login.open(ctx.get("url", os.environ.get("SBI_TARGET_URL")))
    login.login_as(teller_id, _new_password())
    ctx.record_step("relogin", "Re-login with the new password", "passed",
                     int((time.time() - started) * 1000), "", None)
