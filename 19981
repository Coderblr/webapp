import { useEffect, useState } from "react";
import { api } from "@/lib/api";
import { recordingsApi } from "@/lib/api";
import ReportView from "@/components/ReportView";
import StepEditor from "@/components/StepEditor";
import ShareDialog from "@/components/ShareDialog";
import VersionHistory from "@/components/VersionHistory";
import Link from "next/link";
import { useAuth } from "@/context/AuthContext";
import {
  Button,
  Callout,
  Checkbox,
  DataTable,
  Disclosure,
  Field,
  Panel,
  Select,
  Spinner,
  TextInput,
} from "@/components/ui";

export default function RunSavedTab() {
  const { user } = useAuth();

  const [recordings, setRecordings] = useState([]);
  const [recordingsError, setRecordingsError] = useState(null);
  const [selectedRecFile, setSelectedRecFile] = useState("");
  const [applicationNames, setApplicationNames] = useState([]);
  const [runHeadless, setRunHeadless] = useState(false);

  // Test data
  const [testData, setTestData] = useState([]);
  const [testDataLoading, setTestDataLoading] = useState(false);
  const [testDataError, setTestDataError] = useState(null);
  const [editValues, setEditValues] = useState({});
  const [savingData, setSavingData] = useState(false);
  const [saveDataNotice, setSaveDataNotice] = useState(null);
  const [saveDataError, setSaveDataError] = useState(null);

  // Run state
  const [runBusy, setRunBusy] = useState(false);
  const [runError, setRunError] = useState(null);
  const [report, setReport] = useState(null);

  // Regeneration
  const [regenBusy, setRegenBusy] = useState(false);
  const [regenNotice, setRegenNotice] = useState(null);
  const [regenFiles, setRegenFiles] = useState(null);
  const [downloadingRegen, setDownloadingRegen] = useState(null);

  // UiPath import
  const [importBusy, setImportBusy] = useState(false);
  const [importNotice, setImportNotice] = useState(null);
  const [importFile, setImportFile] = useState(null);
  const [importName, setImportName] = useState("");
  const [importAppName, setImportAppName] = useState("");
  const [importSheets, setImportSheets] = useState(null);
  const [importSheetsLoading, setImportSheetsLoading] = useState(false);
  const [selectedSheets, setSelectedSheets] = useState([]);

  // Sharing / package
  const [shareDialogOpen, setShareDialogOpen] = useState(false);
  const [exportBusy, setExportBusy] = useState(false);
  const [pkgImportFile, setPkgImportFile] = useState(null);
  const [pkgImportBusy, setPkgImportBusy] = useState(false);
  const [pkgImportNotice, setPkgImportNotice] = useState(null);

  const selectedRecording =
    recordings.find((r) => r.file === selectedRecFile) || null;

  async function loadRecordings() {
    try {
      const r = await api.getRecordings();

      setRecordings(r);
      setRecordingsError(null);

      if (r.length && !selectedRecFile) {
        setSelectedRecFile(r[0].file);
      }
    } catch (e) {
      setRecordingsError(e.detail || e.message);
    }
  }

  useEffect(() => {
    loadRecordings();

    api
      .getApplications()
      .then((r) => setApplicationNames(r.applications || []))
      .catch(() => {});

    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function loadTestData(file) {
    setTestDataLoading(true);
    setTestDataError(null);
    setSaveDataNotice(null);
    setSaveDataError(null);

    try {
      const data = await api.getRecordingTestData(file);

      setTestData(data.fields);

      setEditValues(
        Object.fromEntries(
          data.fields.map((f) => [f.index, f.value])
        )
      );
    } catch (e) {
      setTestData([]);
      setEditValues({});
      setTestDataError(e.detail || e.message);
    } finally {
      setTestDataLoading(false);
    }
  }

  useEffect(() => {
    setReport(null);
    setRegenNotice(null);
    setRegenFiles(null);

    if (selectedRecFile) {
      loadTestData(selectedRecFile);
    }

    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedRecFile]);

  function updateValue(index, value) {
    setEditValues((prev) => ({
      ...prev,
      [index]: value,
    }));

    setSaveDataNotice(null);
  }

  async function saveTestDataOnly() {
    setSavingData(true);
    setSaveDataError(null);
    setSaveDataNotice(null);

    try {
      const data = await api.updateRecordingTestData(
        selectedRecFile,
        editValues
      );

      setTestData(data.fields);

      setSaveDataNotice(
        "Test data saved - future runs of this recording will use these values too."
      );
    } catch (e) {
      setSaveDataError(e.detail || e.message);
    } finally {
      setSavingData(false);
    }
  }

  // ============================================================
  // RUN RECORDING
  // ============================================================

  async function handleRun() {
    if (!selectedRecFile) return;

    setRunError(null);
    setReport(null);
    setRunBusy(true);

    try {
      // Save edited test data before execution.
      if (testData.length > 0) {
        await api.updateRecordingTestData(
          selectedRecFile,
          editValues
        );
      }

      const r = await api.runRecording(
        selectedRecFile,
        runHeadless
      );

      setReport(r);
    } catch (e) {
      setRunError(
        e?.detail ||
        e?.message ||
        "Execution failed."
      );
    } finally {
      setRunBusy(false);
    }
  }

  // ============================================================
  // STOP RECORDING
  // ============================================================

  async function handleStop() {
    if (!runBusy) return;

    try {
      await api.stopTest();

      // Immediately reset frontend state.
      setRunBusy(false);
      setRunError(null);
      setReport(null);
    } catch (e) {
      setRunError(
        e?.detail ||
        e?.message ||
        "Unable to stop execution."
      );
    }
  }

  // ============================================================
  // REGENERATE
  // ============================================================

  async function handleRegenerate() {
    if (!selectedRecFile) return;

    setRegenNotice(null);
    setRegenFiles(null);
    setRegenBusy(true);

    try {
      const r = await recordingsApi.regenerate(
        selectedRecFile
      );

      setRegenNotice({
        tone: "success",
        text:
          `Regenerated (${r.build_result.step_count} steps) - ` +
          "download the scripts below, or just run this recording, " +
          "which already uses the current code either way.",
      });

      setRegenFiles({
        feature_file: r.build_result.feature_file,
        steps_file: r.build_result.steps_file,
        page_file: r.build_result.page_file,
        locators_file: r.build_result.locators_file,
      });
    } catch (e) {
      setRegenNotice({
        tone: "error",
        text: e.detail || e.message,
      });
    } finally {
      setRegenBusy(false);
    }
  }

  async function handleDownloadRegenFile(path, label) {
    setDownloadingRegen(path);

    try {
      await recordingsApi.downloadRegeneratedFile(path);
    } catch (e) {
      setRegenNotice({
        tone: "error",
        text:
          `Could not download ${label}: ` +
          `${e.detail || e.message}`,
      });
    } finally {
      setDownloadingRegen(null);
    }
  }

  // ============================================================
  // UIPATH IMPORT
  // ============================================================

  async function handleImportFileChosen(file) {
    setImportFile(file);
    setImportNotice(null);
    setImportSheets(null);
    setSelectedSheets([]);

    if (!file) return;

    setImportSheetsLoading(true);

    try {
      const r = await recordingsApi.listUipathSheets(file);

      if (r.sheets.length > 1) {
        setImportSheets(r.sheets);
        setSelectedSheets(r.sheets);
      } else {
        setImportSheets([]);
      }
    } catch (e) {
      setImportNotice({
        tone: "error",
        text: e.detail || e.message,
      });

      setImportFile(null);
    } finally {
      setImportSheetsLoading(false);
    }
  }

  function toggleSheetSelection(sheetName) {
    setSelectedSheets((prev) =>
      prev.includes(sheetName)
        ? prev.filter((s) => s !== sheetName)
        : [...prev, sheetName]
    );
  }

  async function handleImportUipath() {
    if (!importFile) return;

    if (
      importSheets &&
      importSheets.length > 0 &&
      selectedSheets.length === 0
    ) {
      setImportNotice({
        tone: "error",
        text:
          'Select at least one sheet to import, or use "Select all".',
      });

      return;
    }

    setImportNotice(null);
    setImportBusy(true);

    try {
      const r =
        await recordingsApi.importUipathExcel(
          importFile,
          importName,
          selectedSheets.length
            ? selectedSheets
            : undefined,
          importAppName
        );

      const succeeded = r.results.filter(
        (res) => !res.error
      );

      const failed = r.results.filter(
        (res) => res.error
      );

      const totalWarnings = succeeded.reduce(
        (n, res) => n + res.warnings.length,
        0
      );

      const parts = [];

      if (succeeded.length) {
        const label =
          succeeded.length === 1
            ? "1 recording"
            : `${succeeded.length} recordings`;

        parts.push(
          `Imported ${label} from ${importFile.name}` +
            `${
              totalWarnings
                ? ` (${totalWarnings} warning${
                    totalWarnings > 1 ? "s" : ""
                  } - check each recording's steps)`
                : ""
            }.`
        );
      }

      if (failed.length) {
        parts.push(
          `${failed.length} sheet${
            failed.length > 1 ? "s" : ""
          } could not be imported: ` +
            failed
              .map(
                (f) =>
                  `${f.sheet_name || "sheet"} (${f.error})`
              )
              .join("; ") +
            "."
        );
      }

      setImportNotice({
        tone:
          failed.length && !succeeded.length
            ? "error"
            : failed.length || totalWarnings
            ? "warning"
            : "success",
        text: parts.join(" "),
      });

      setImportFile(null);
      setImportName("");
      setImportSheets(null);
      setSelectedSheets([]);
      setImportAppName("");

      await loadRecordings();

      if (succeeded.length) {
        setSelectedRecFile(
          succeeded[0].recording_file
        );
      }
    } catch (e) {
      setImportNotice({
        tone: "error",
        text: e.detail || e.message,
      });
    } finally {
      setImportBusy(false);
    }
  }

  // ============================================================
  // EXPORT
  // ============================================================

  async function handleExport() {
    if (!selectedRecording?.recording_id) return;

    setExportBusy(true);

    try {
      await recordingsApi.exportRecording(
        selectedRecording.recording_id
      );
    } catch (e) {
      setRunError(e.detail || e.message);
    } finally {
      setExportBusy(false);
    }
  }

  // ============================================================
  // PACKAGE IMPORT
  // ============================================================

  async function handleImportPackage() {
    if (!pkgImportFile) return;

    setPkgImportBusy(true);
    setPkgImportNotice(null);

    try {
      const r =
        await recordingsApi.importPackage(
          pkgImportFile
        );

      setPkgImportNotice({
        tone: "success",
        text:
          r.message ||
          "Package imported successfully.",
      });

      setPkgImportFile(null);

      await loadRecordings();
    } catch (e) {
      setPkgImportNotice({
        tone: "error",
        text: e.detail || e.message,
      });
    } finally {
      setPkgImportBusy(false);
    }
  }

  // ============================================================
  // UI
  // ============================================================

  return (
    <div className="grid min-w-0 gap-4 lg:grid-cols-2">
      <Panel>
        <PanelHeader
          title="Run Saved Recording"
          description="Run, regenerate, import and manage saved recordings."
        />

        <div className="space-y-4 px-5 py-5">

          {/* ====================================================
              UIPATH IMPORT
          ==================================================== */}

          <Disclosure title="Import from a UiPath Excel sheet">
            <div className="space-y-3">

              <Field label="UiPath Excel file">
                <input
                  type="file"
                  accept=".xlsx,.xls"
                  onChange={(e) =>
                    handleImportFileChosen(
                      e.target.files?.[0] || null
                    )
                  }
                  className="block w-full text-sm text-ink"
                />
              </Field>

              {importSheetsLoading && (
                <Spinner label="Reading Excel sheets..." />
              )}

              {importSheets &&
                importSheets.length > 1 && (
                  <div className="space-y-2">
                    <div className="text-sm font-medium text-ink">
                      Sheets
                    </div>

                    {importSheets.map((sheet) => (
                      <label
                        key={sheet}
                        className="flex items-center gap-2 text-sm"
                      >
                        <input
                          type="checkbox"
                          checked={selectedSheets.includes(
                            sheet
                          )}
                          onChange={() =>
                            toggleSheetSelection(sheet)
                          }
                        />

                        {sheet}
                      </label>
                    ))}
                  </div>
                )}

              <Field label="Recording name">
                <TextInput
                  value={importName}
                  onChange={(e) =>
                    setImportName(e.target.value)
                  }
                  placeholder="Optional recording name"
                />
              </Field>

              <Field label="Application">
                <TextInput
                  value={importAppName}
                  onChange={(e) =>
                    setImportAppName(e.target.value)
                  }
                  placeholder="Optional application name"
                />
              </Field>

              <Button
                variant="secondary"
                onClick={handleImportUipath}
                disabled={
                  !importFile ||
                  importBusy ||
                  importSheetsLoading
                }
                className="w-full"
              >
                {importBusy
                  ? "Importing..."
                  : "Import UiPath Excel"}
              </Button>

              {importNotice && (
                <Callout tone={importNotice.tone}>
                  {importNotice.text}
                </Callout>
              )}
            </div>
          </Disclosure>

          {/* ====================================================
              PACKAGE IMPORT
          ==================================================== */}

          <Disclosure title="Import recording package">
            <div className="space-y-3">

              <Field label="Recording package">
                <input
                  type="file"
                  accept=".zip"
                  onChange={(e) =>
                    setPkgImportFile(
                      e.target.files?.[0] || null
                    )
                  }
                  className="block w-full text-sm text-ink"
                />
              </Field>

              <Button
                variant="secondary"
                onClick={handleImportPackage}
                disabled={
                  !pkgImportFile ||
                  pkgImportBusy
                }
                className="w-full"
              >
                {pkgImportBusy
                  ? "Importing..."
                  : "Import package"}
              </Button>

              {pkgImportNotice && (
                <Callout tone={pkgImportNotice.tone}>
                  {pkgImportNotice.text}
                </Callout>
              )}
            </div>
          </Disclosure>

          {/* ====================================================
              RECORDINGS
          ==================================================== */}

          {recordingsError && (
            <Callout tone="error">
              Could not load recordings:{" "}
              {recordingsError}
            </Callout>
          )}

          {recordings.length === 0 ? (
            <Callout>
              No saved recordings found yet. Record one
              in the “Record &amp; Generate” tab first.
            </Callout>
          ) : (
            <>
              <Field label="Saved recording">
                <Select
                  value={selectedRecFile}
                  onChange={(e) =>
                    setSelectedRecFile(
                      e.target.value
                    )
                  }
                >
                  {Object.entries(
                    recordings.reduce(
                      (groups, r) => {
                        const app =
                          r.application ||
                          "Others";

                        groups[app] =
                          groups[app] || [];

                        groups[app].push(r);

                        return groups;
                      },
                      {}
                    )
                  )
                    .sort(([a], [b]) =>
                      a.localeCompare(b)
                    )
                    .map(([app, recs]) => (
                      <optgroup
                        key={app}
                        label={app}
                      >
                        {recs.map((r) => (
                          <option
                            key={r.file}
                            value={r.file}
                          >
                            {r.name} —{" "}
                            {r.target_url} (
                            {r.action_count} actions)
                            {r.migration_status &&
                            r.migration_status !==
                              "NATIVE" &&
                            r.migration_status !==
                              "UNKNOWN"
                              ? ` [${r.migration_status}]`
                              : ""}
                          </option>
                        ))}
                      </optgroup>
                    ))}
                </Select>
              </Field>

              {selectedRecording && (
                <div className="flex flex-wrap items-center gap-2">
                  <span className="text-xs text-muted">
                    {selectedRecording.is_owner
                      ? "You own this recording."
                      : selectedRecording.is_shared
                      ? "Shared with you."
                      : "Open to everyone (legacy recording)."}
                  </span>

                  <div className="ml-auto flex gap-2">

                    {selectedRecording.recording_id && (
                      <Link
                        href={`/recordings/${selectedRecording.recording_id}`}
                        className="inline-flex items-center px-4 py-2 text-sm font-medium text-signal-slate underline decoration-line underline-offset-4 hover:text-ink"
                      >
                        View details →
                      </Link>
                    )}

                    {selectedRecording.is_owner && (
                      <Button
                        variant="ghost"
                        onClick={() =>
                          setShareDialogOpen(true)
                        }
                      >
                        Share
                      </Button>
                    )}

                    <Button
                      variant="ghost"
                      onClick={handleExport}
                      disabled={exportBusy}
                    >
                      {exportBusy
                        ? "Exporting..."
                        : "Export"}
                    </Button>
                  </div>
                </div>
              )}

              {shareDialogOpen &&
                selectedRecording && (
                  <ShareDialog
                    recordingId={
                      selectedRecording.recording_id
                    }
                    recordingName={
                      selectedRecording.name
                    }
                    onClose={() =>
                      setShareDialogOpen(false)
                    }
                  />
                )}

              <Checkbox
                label="headless"
                checked={runHeadless}
                onChange={setRunHeadless}
              />

              {/* =================================================
                  RUN BUTTON
              ================================================= */}

              <Button
                onClick={handleRun}
                disabled={runBusy}
                className="w-full"
              >
                {runBusy
                  ? "Running..."
                  : "Run recording"}
              </Button>

              {/* =================================================
                  STOP BUTTON
              ================================================= */}

              {runBusy && (
                <Button
                  variant="secondary"
                  className="w-full"
                  onClick={handleStop}
                >
                  ⬛ Stop execution
                </Button>
              )}

              {runBusy && (
                <Spinner
                  label="Running the saved recording..."
                />
              )}

              {runError && (
                <Callout tone="error">
                  Run failed: {runError}
                </Callout>
              )}

              {/* =================================================
                  REGENERATE
              ================================================= */}

              <div className="border-t border-line pt-4">

                <Button
                  variant="secondary"
                  onClick={handleRegenerate}
                  disabled={regenBusy}
                  className="w-full"
                >
                  {regenBusy
                    ? "Regenerating..."
                    : "Regenerate (no run)"}
                </Button>

                <p className="mt-1.5 text-xs text-muted">
                  Refreshes this recording's generated
                  feature/steps/page files from the latest
                  generator code - without re-recording or
                  running anything. Useful right after a
                  code/template fix.
                </p>

                {regenNotice && (
                  <div className="mt-2">
                    <Callout
                      tone={regenNotice.tone}
                    >
                      {regenNotice.text}
                    </Callout>
                  </div>
                )}

                {regenFiles && (
                  <div className="mt-2 flex flex-wrap gap-2">
                    {[
                      {
                        path:
                          regenFiles.feature_file,
                        label: "Feature file",
                      },
                      {
                        path:
                          regenFiles.steps_file,
                        label: "Steps (.py)",
                      },
                      {
                        path:
                          regenFiles.page_file,
                        label: "Page object (.py)",
                      },
                      {
                        path:
                          regenFiles.locators_file,
                        label: "Locators (.json)",
                      },
                    ].map(
                      ({ path, label }) =>
                        path && (
                          <button
                            key={path}
                            type="button"
                            className="rounded-sm border border-line bg-panel px-2.5 py-1 text-xs font-medium text-brand-blue hover:border-brand-blue/40 disabled:opacity-40"
                            disabled={
                              downloadingRegen ===
                              path
                            }
                            onClick={() =>
                              handleDownloadRegenFile(
                                path,
                                label
                              )
                            }
                          >
                            {downloadingRegen ===
                            path
                              ? "Downloading..."
                              : `⬇ ${label}`}
                          </button>
                        )
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      </Panel>

      {/* ========================================================
          RIGHT SIDE
      ======================================================== */}

      <div className="min-w-0 space-y-4">

        {selectedRecFile && (
          <Panel>
            <div className="flex items-center justify-between border-b border-line px-5 py-4">

              <div>
                <h2 className="text-sm font-semibold text-ink">
                  Test data
                </h2>

                <p className="mt-0.5 text-xs text-muted">
                  The values this recording
                  types/selects when it runs. Edit
                  anything below, then hit{" "}
                  <strong>Run recording</strong>.
                </p>
              </div>

              {testData.length > 0 && (
                <Button
                  variant="secondary"
                  onClick={saveTestDataOnly}
                  disabled={savingData}
                >
                  {savingData
                    ? "Saving..."
                    : "Save without running"}
                </Button>
              )}
            </div>

            <div className="px-5 py-4">

              {testDataLoading && (
                <Spinner label="Loading test data..." />
              )}

              {testDataError && (
                <Callout tone="error">
                  {testDataError}
                </Callout>
              )}

              {saveDataError && (
                <Callout tone="error">
                  {saveDataError}
                </Callout>
              )}

              {saveDataNotice && (
                <Callout tone="success">
                  {saveDataNotice}
                </Callout>
              )}

              {!testDataLoading &&
                !testDataError &&
                testData.length === 0 && (
                  <p className="text-sm text-muted">
                    This recording has no typed or
                    selected values to edit.
                  </p>
                )}

              {testData.length > 0 && (
                <DataTable
                  columns={[
                    {
                      key: "label",
                      label: "Field",
                    },
                    {
                      key: "action",
                      label: "Type",
                      mono: true,
                    },
                    {
                      key: "value",
                      label: "Value",
                    },
                  ]}
                  rows={testData.map((f) => ({
                    label: f.label,
                    action: f.action,
                    value: (
                      <TextInput
                        value={
                          editValues[f.index] ??
                          ""
                        }
                        onChange={(e) =>
                          updateValue(
                            f.index,
                            e.target.value
                          )
                        }
                      />
                    ),
                  }))}
                />
              )}
            </div>
          </Panel>
        )}

        {selectedRecFile && (
          <StepEditor
            recordingFile={selectedRecFile}
            onSaved={() =>
              loadTestData(selectedRecFile)
            }
          />
        )}

        {selectedRecording?.recording_id && (
          <VersionHistory
            recordingId={
              selectedRecording.recording_id
            }
          />
        )}

        {report && (
          <ReportView
            key={report.transaction_id}
            report={report}
          />
        )}

        {!selectedRecFile && (
          <Panel>
            <div className="px-5 py-10 text-center text-sm text-muted">
              Pick a saved recording to review its
              test data and run it.
            </div>
          </Panel>
        )}
      </div>
    </div>
  );
}
