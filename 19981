@app.post("/api/change-plans/{plan_id}/batch-approve")
def batch_approve_change_plan(
    plan_id: str,
    application: str,
    min_confidence: float = 0.80,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Approve all PENDING items whose confidence meets `min_confidence`
    (default 0.80 = REVIEW threshold) in one call.
    Items below the threshold, already actioned, or requiring manual review
    are left untouched. Returns the updated plan."""
    app_access.require_application_access(current_user, application, "edit")
    from solution_analyzer.service import load_change_plan, save_change_plan
    from datetime import datetime, timezone

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    now = datetime.now(timezone.utc).isoformat()
    approved_count = 0
    skipped = []

    for item in plan["items"]:
        if item["approval_status"] != "PENDING":
            continue
        impact = item.get("impact_item", {})
        conf = impact.get("confidence", 0)
        is_impl = impact.get("is_implementable", True)
        needs_review = impact.get("manual_review_required", False)

        if not is_impl:
            skipped.append({"item_id": item["item_id"], "reason": "not_implementable"})
            continue
        if needs_review:
            skipped.append({"item_id": item["item_id"], "reason": "manual_review_required"})
            continue
        if conf < min_confidence:
            skipped.append({"item_id": item["item_id"], "reason": f"confidence {conf:.0%} < {min_confidence:.0%}"})
            continue

        item["approval_status"] = "APPROVED"
        item["approved_by"] = current_user.username
        item["approved_at"] = now
        approved_count += 1

    statuses = {i["approval_status"] for i in plan["items"]}
    if "PENDING" not in statuses:
        plan["status"] = "FULLY_APPROVED"
    elif approved_count > 0:
        plan["status"] = "PARTIALLY_APPROVED"

    save_change_plan(plan, application)
    return {"approved_count": approved_count, "skipped": skipped, "plan": plan}


@app.post("/api/change-plans/{plan_id}/batch-apply")
async def batch_apply_change_plan(
    plan_id: str,
    application: str,
    request: Request,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Apply ALL APPROVED, not-yet-applied, implementable items in the plan.
    Each item is applied independently — a failure on one item does not
    prevent the others from being applied, and the result details which
    succeeded and which failed. Returns the updated plan."""
    app_access.require_application_access(current_user, application, "edit")
    from solution_analyzer.service import load_change_plan, save_change_plan
    from solution_analyzer.change_engine import ChangeEngine, ChangeError
    from solution_analyzer.models import ChangePlanItemModel
    from datetime import datetime, timezone

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    candidates = [
        i for i in plan["items"]
        if i["approval_status"] == "APPROVED"
        and not i.get("applied")
        and i.get("impact_item", {}).get("is_implementable", True)
    ]
    if not candidates:
        raise HTTPException(
            status_code=400,
            detail="No approved, unapplied, implementable items to apply."
        )

    now = datetime.now(timezone.utc).isoformat()
    results = []
    with get_session() as session:
        engine = ChangeEngine(session, current_user)
        for item_data in candidates:
            try:
                item_model = ChangePlanItemModel(**item_data)
                result = await asyncio.to_thread(
                    engine.apply_item, item_model, plan.get("cr_number")
                )
                for item in plan["items"]:
                    if item["item_id"] == item_data["item_id"]:
                        item["applied"] = True
                        item["applied_at"] = now
                        item["new_version_number"] = result.get("new_version")
                        item["diff_after"] = result.get("diff", {})
                        item["validation_status"] = "NOT_RUN"
                        break
                results.append({"item_id": item_data["item_id"], "ok": True, "new_version": result.get("new_version")})
            except (ChangeError, Exception) as e:
                results.append({"item_id": item_data["item_id"], "ok": False, "error": str(e)})

    all_done = all(
        i.get("applied") or i.get("approval_status") == "REJECTED" or
        i.get("impact_item", {}).get("manual_review_required") or
        not i.get("impact_item", {}).get("is_implementable", True)
        for i in plan["items"]
    )
    if all_done:
        plan["status"] = "APPLIED"

    save_change_plan(plan, application)

    ip = get_client_ip(request)
    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id,
            action="BATCH_CHANGE_APPLIED", status="SUCCESS",
            details={"plan_id": plan_id, "applied": sum(1 for r in results if r["ok"]),
                     "failed": sum(1 for r in results if not r["ok"])},
            endpoint=f"/api/change-plans/{plan_id}/batch-apply", ip_address=ip,
        )
    return {"results": results, "plan": plan}


@app.post("/api/change-plans/{plan_id}/rollback")
def rollback_change_plan_item(
    plan_id: str,
    application: str,
    item_id: str,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Revert an applied change by restoring the recording to its state
    immediately before this item was applied.

    Uses the existing versioning system (backend/recording_access.py's
    snapshot_version) - reads the version that existed BEFORE the apply
    (new_version_number - 1), writes it back as a new snapshot
    (new_version_number + 1), so the version history is always append-only
    and the rollback itself is auditable."""
    app_access.require_application_access(current_user, application, "edit")
    from solution_analyzer.service import load_change_plan, save_change_plan
    from backend.recording_access import get_or_create_recording, snapshot_version
    from datetime import datetime, timezone
    import json as _json

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    item_data = next((i for i in plan["items"] if i["item_id"] == item_id), None)
    if item_data is None:
        raise HTTPException(status_code=404, detail="Item not found in change plan")
    if not item_data.get("applied"):
        raise HTTPException(status_code=400, detail="Item has not been applied — nothing to roll back.")

    # Find the recording file
    recording_file = (
        item_data.get("impact_item", {})
        .get("matched_recording", {})
        .get("recording_file")
    )
    if not recording_file:
        raise HTTPException(status_code=400, detail="No recording file in this item.")

    rec_path = Path(recording_file)
    if not rec_path.exists():
        raise HTTPException(status_code=404, detail=f"Recording file not found: {rec_path}")

    with get_session() as session:
        recording = get_or_create_recording(session, rec_path)
        applied_version = item_data.get("new_version_number")
        if not applied_version:
            raise HTTPException(status_code=400, detail="Applied version number not recorded — cannot roll back safely.")

        rollback_version = applied_version - 1
        if rollback_version < 1:
            raise HTTPException(status_code=400, detail="No previous version to roll back to.")

        from backend.recording_access import VERSIONS_DIR
        version_file = VERSIONS_DIR / str(recording.recording_id) / f"v{rollback_version}.json"
        if not version_file.exists():
            raise HTTPException(
                status_code=404,
                detail=f"Version {rollback_version} snapshot not found. Cannot roll back."
            )

        # Load the previous version's content
        previous_json = _json.loads(version_file.read_text())

        # Add rollback note to the change history
        previous_json.setdefault("change_history", []).append({
            "cr_number": plan.get("cr_number"),
            "change_type": "ROLLBACK",
            "rolled_back_version": applied_version,
            "restored_to_version": rollback_version,
            "applied_at": datetime.now(timezone.utc).isoformat(),
            "applied_by": current_user.username,
            "description": f"Rolled back change plan item {item_id}",
        })

        new_version_number = recording.current_version_number + 1
        snapshot_version(
            session,
            recording=recording,
            recording_json=previous_json,
            version_number=new_version_number,
            created_by_user_id=current_user.user_id,
            change_summary=f"[ROLLBACK] Reverted item {item_id} from v{applied_version} to v{rollback_version}",
        )

    # Update plan item
    now = datetime.now(timezone.utc).isoformat()
    for item in plan["items"]:
        if item["item_id"] == item_id:
            item["applied"] = False
            item["approval_status"] = "PENDING"
            item["rolled_back_at"] = now
            item["rolled_back_by"] = current_user.username
            item["rolled_back_from_version"] = applied_version
            item["new_version_number"] = None
            item["validation_status"] = "NOT_RUN"
            break

    if plan["status"] == "APPLIED":
        plan["status"] = "PARTIALLY_APPROVED"

    save_change_plan(plan, application)
    return {"ok": True, "rolled_back_to_version": rollback_version, "new_snapshot_version": new_version_number, "plan": plan}


@app.post("/api/change-plans/{plan_id}/mark-handled")
def mark_item_manually_handled(
    plan_id: str,
