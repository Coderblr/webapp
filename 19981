@app.put("/api/recordings/steps")
def update_recording_steps(file: str, req: StepsUpdateRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Replaces the recording's entire action list with the edited one from
    the step editor - add, delete, reorder, and edit are all just "submit
    the new list" from the frontend's point of view, so one endpoint
    handles all of them rather than four separate ones. Becomes the new
    baseline for every future run/regenerate of this recording, exactly
    like a test-data edit does - and, like that edit, snapshots a new
    version before overwriting (see backend/recording_access.py)."""
    path = _safe_recording_path(file)
    with get_session() as _s:   # authorise before validating/parsing anything
        recording_access.require_access(_s, path, current_user, "edit")
    recording = json.loads(path.read_text())

    if not req.steps:
        raise HTTPException(status_code=400, detail="A recording needs at least one step.")

    page_index = 0
    new_actions = []
    rt_errors = []
    for n, step in enumerate(req.steps, start=1):
        action = _step_edit_to_action(step, page_index=page_index)
        # Runtime configuration as the row now has it (set, changed or switched off) - see automation/runtime_config.py.
        # A caller that does not send the field at all keeps the step's existing configuration.
        raw = step.runtime_config if "runtime_config" in step.model_fields_set else action.get("runtime_config")
        cfg = runtime_config.from_editor(raw, action)
        action.pop("runtime_config", None)
        if cfg:
            action["runtime_config"] = cfg
            rt_errors.extend(f"Step {n}: {e}" for e in runtime_config.validate_config(action))
        new_actions.append(action)
        if action["action"] == "window_closed":
            page_index = max(0, page_index - 1)  # matches recorder.py's own convention: closing a tab returns focus to the previous one
    rt_errors.extend(runtime_config.variables({"actions": new_actions})[1])
    if rt_errors:
        raise HTTPException(status_code=400, detail="Runtime configuration: " + "; ".join(rt_errors[:8]))
    # Checks: "the same element as step N" / a page area -> the element's selectors, as the list is now ordered.
    check_errors = []
    for n, action in enumerate(new_actions, start=1):
        if action.get("action") == "assert":
            tgt = (action.get("assertion") or {}).get("target") or {}
            if tgt.get("step_no") and int(tgt["step_no"]) == n:
                check_errors.append(f"Step {n}: a check cannot look at itself - choose the step whose element it checks")
                continue
            action["assertion"] = _checks.finalize(action.get("assertion") or {}, new_actions, own_action=action)
            check_errors.extend(f"Step {n}: {p}" for p in _checks.problems(action["assertion"]))
        elif action.get("action") == "capture_text":
            from runner import text_capture as _tc
            cfg = action.get("capture_cfg") or {}
            if (cfg.get("target") or {}).get("step_no") or (cfg.get("target") or {}).get("preset"):
                fin = _checks.finalize({"type": "text_contains", "expected": "", "target": cfg["target"]}, new_actions)
                cfg = {**cfg, "target": fin.get("target") or {}}
                cfg.setdefault("source", "selector")
                action["capture_cfg"] = cfg
            check_errors.extend(f"Step {n}: {p}" for p in _tc.validate_config(cfg))
    if check_errors:
        raise HTTPException(status_code=400, detail="Checks: " + "; ".join(check_errors[:8]))

    from recorder.variable_capture import annotate_variables
    from recorder import upload_store
    upload_store.externalize(new_actions)   # an older recording's inline upload file moves to the upload store
    recording["actions"] = annotate_variables(new_actions)

    ip = get_client_ip(request)
    with get_session() as session:
        rec = recording_access.require_access(session, path, current_user, "edit")
        recording_access.snapshot_version(
            session, recording=rec, recording_json=recording, version_number=rec.current_version_number + 1,
            created_by_user_id=current_user.user_id, change_summary=f"Updated steps ({len(new_actions)} actions)",
        )
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="RECORDING_STEPS_UPDATED",
            status="SUCCESS", details={"recording_file": str(path), "step_count": len(new_actions)},
            endpoint="/api/recordings/steps", ip_address=ip,
        )
    return {"ok": True, "steps": [_action_to_step_edit(a) for a in recording["actions"]]}


def parse_plain_selector(text: str) -> list[dict]:
    """Plain selector text -> [{"strategy","value"}]. One selector per line. Understands
    "ID: x", "NAME: x", "CSS: x", "XPATH: x", "TEXT: x", "ROLE: x" (what the editor shows),
    Playwright "css=", "xpath=", "text=", "id=", "name=", XPath starting with / or (, and anything
    else as a CSS selector (e.g. "#username", "input[name=q]", "div > a.btn")."""
    out: list[dict] = []
    for raw in (text or "").replace("\r", "").split("\n"):
        line = raw.strip()
        if not line:
            continue
        m = re.match(r"^(ID|NAME|CSS|XPATH|TEXT|ROLE)\s*:\s*(.+)$", line, re.I)
        if m:
            out.append({"strategy": m.group(1).upper(), "value": m.group(2).strip()})
            continue
        m = re.match(r"^(css|xpath|text|id|name)\s*=\s*(.+)$", line, re.I)
        if m:
            kind = m.group(1).upper()
            val = m.group(2).strip()
            out.append({"strategy": kind, "value": val.strip("\"'") if kind in ("ID", "NAME") else val})
            continue
        if line.startswith(("/", "(/", "./")):
            out.append({"strategy": "XPATH", "value": line})
        elif line.startswith("<"):
            continue          # an HTML/UiPath tag we could not read - not a selector
        else:
            out.append({"strategy": "CSS", "value": line})
    return out[:8]


@app.post("/api/recordings/parse_selector")
def parse_uipath_selector_endpoint(req: ParseSelectorRequest, current_user: CurrentUser = Depends(get_current_user)):
    """Lets the step editor's Add/Edit form accept a pasted selector and see it translated into real locators
    immediately: a UiPath <webctrl .../> snippet (the same format the Excel importer reads, via
    generator/uipath_importer.py), or what people actually copy - the editor's own "ID: x" lines, Playwright
    "css=..." / "xpath=...", a browser-copied CSS selector, XPath, or a bare #id."""
    from generator.uipath_importer import build_locators_from_uipath_selector, _parse_webctrl_attrs

    locators = build_locators_from_uipath_selector(req.selector_text)
    attrs = _parse_webctrl_attrs(req.selector_text)
    suggested_label = attrs.get("visibleinnertext") or attrs.get("aaname") or attrs.get("name") or attrs.get("id") or ""
    if not locators:
        locators = parse_plain_selector(req.selector_text)
        if locators and not suggested_label:
            suggested_label = locators[0]["value"].lstrip("#").strip("[]\"'")[:40]
    return {"locators": locators, "suggested_label": suggested_label.strip()}


