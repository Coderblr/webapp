    "click", "type", "select", "keypress", "delay", "scroll", "window_closed",
    "assert_text", "assert_ocr_text", "file_upload", "copy", "ocr_capture",
    # "hover" is produced by the recorder itself (recorder_injector.js) -
    # without it here, saving ANY edit to a recording that contains a hover
    # step was rejected with "Unknown step action 'hover'".
    "hover",
    # Navigation menu check - see generator/build.py's "menu_check" branch.
    "menu_check",
    # Produced by the recorder itself. Without them here, saving ANY edit to a recording that contains a
    # pasted value or a date field was rejected with "Unknown step action 'paste'" / "'date'".
    "paste", "date",
    # Recorder-made, nothing to edit but must survive a save (and be movable / deletable).
    "dialog", "new_window",
    # Checks (automation/checks.py) and "remember this value" steps for before/after checks.
    "assert", "capture_text",
    # Platform steps the editor keeps as they are (made elsewhere) - without them here a recording that contained
    # one could not be saved from the editor at all.
    "checkpoint", "wait_condition", "workflow_ref",
}
# Steps the editor can only keep as they are (or move / delete) - they can't be created from scratch in it.
KEEP_ONLY_ACTIONS = {"dialog", "new_window", "checkpoint", "wait_condition", "workflow_ref"}
CHECK_ACTIONS = {"assert", "capture_text"}
# Steps that act on one element and so need a locator.
NEEDS_LOCATOR_ACTIONS = {"click", "type", "select", "file_upload", "hover", "paste", "date"}


def _action_to_step_edit(action: dict) -> dict:
    """Raw recording action -> editable shape (see StepEditModel) - the GET
    direction of /api/recordings/steps."""
    element = action.get("element") or {}
    kind = action.get("action", "click")
    # Scroll's "value" is displayed/edited as the same "DOWN-4"/"UP-2"
    # shorthand the Excel importer reads (see _step_edit_to_action's PUT-
    # direction counterpart) - lets the step editor's grid show a scroll
    # row's Input cell the exact same way that row would have looked in
    # the original spreadsheet.
    if kind == "scroll":
        display_value = f'{(action.get("scroll_direction") or "down").upper()}-{action.get("scroll_amount") or 1}'
    elif kind == "delay":
        seconds = action.get("value")
        display_value = (str(int(seconds)) if seconds == int(seconds) else str(seconds)) if seconds is not None else None
    else:
        display_value = str(action.get("value")) if action.get("value") is not None else None
    if kind in CHECK_ACTIONS or kind in ("checkpoint", "wait_condition", "workflow_ref"):
        # checks / remembered values: the grid shows the check's name and expected value; the full settings
        # travel as `assertion` / `capture_cfg` for the check editor
        cfg_key = {"assert": "assertion", "capture_text": "capture_cfg", "checkpoint": "checkpoint_cfg",
                   "wait_condition": "wait_cfg"}.get(kind)
        cfg = action.get(cfg_key) or {} if cfg_key else {}
        summary = _checks.summary_for_editor(action) if kind == "assert" else {
            "label": cfg.get("name") or action.get("label") or kind.replace("_", " "), "value": "", "where": ""}
        return {"action": kind, "label": summary["label"], "value": summary["value"], "locators": [],
                "raw_selector": None, "check_where": summary["where"],
                "assertion": action.get("assertion") if kind == "assert" else None,
                "capture_cfg": action.get("capture_cfg") if kind == "capture_text" else None,
                "check_source": action.get("check_source"), "check_suggestion": action.get("check_suggestion"),
                "runtime_config": None, "runtime_input_types": [], "runtime_suggested_options": [],
                "runtime_recorded_value": "", "original": action}
    return {
        "action": kind,
        "label": element.get("text") or element.get("ariaLabel") or element.get("name") or "",
        "value": display_value,
        "locators": action.get("locators") or [],
        "raw_selector": action.get("raw_selector"),
        "scroll_direction": action.get("scroll_direction"),
        "scroll_amount": action.get("scroll_amount"),
        "delay_seconds": float(action["value"]) if kind == "delay" and action.get("value") is not None else None,
        "captured_as": action.get("captured_as"),
        # Set when this paste/type's value was correlated to an earlier
        # copy in the SAME recording (see recorder/variable_capture.py) -
        # the actual Capture -> Store -> Reuse link. Surfaced read-only by
        # frontend/components/ActionTimeline.js; StepEditor.js's editable
        # grid doesn't need it (re-derived automatically by build.py on save).
        "resolved_var": action.get("resolved_var"),
        "runtime_config": action.get("runtime_config"),
        # which runtime input types this step supports (empty = it cannot be made configurable)
        "runtime_input_types": runtime_config.input_types_for(action),
        "runtime_suggested_options": runtime_config.suggested_options(action),
        "runtime_recorded_value": "" if (action.get("element") or {}).get("type") == "password" else runtime_config.recorded_value(
            {**action, "runtime_config": {"input_type": (runtime_config.input_types_for(action) or [""])[0]}}),
        "original": action,
    }


def _merge_step_edit(step: "StepEditModel", original: dict) -> dict:
    """Applies the editor row's edits on top of the recorded action it came from."""
    out = dict(original)
    before = _action_to_step_edit(original)
    kind = step.action

    if step.label != before["label"]:                      # renamed: update what names the step
        el = dict(out.get("element") or {})
        el["text"], el["ariaLabel"] = step.label[:60], step.label
        out["element"] = el
    if step.locators and step.locators != before["locators"]:
        out["locators"] = step.locators
        out["raw_selector"] = step.raw_selector
    elif step.raw_selector is not None and step.raw_selector != before["raw_selector"]:
        out["raw_selector"] = step.raw_selector

    if kind == "delay":
        seconds = step.delay_seconds if step.delay_seconds is not None else (float(step.value) if step.value else 1.0)
        out["value"] = seconds
    elif kind == "scroll":
        direction, amount = step.scroll_direction, step.scroll_amount
        if step.value and step.value != before["value"]:
            from generator.uipath_importer import _parse_scroll_input
            direction, amount = _parse_scroll_input(step.value)
        out["scroll_direction"] = direction or original.get("scroll_direction") or "down"
        out["scroll_amount"] = amount or original.get("scroll_amount") or 1
    elif kind in ("window_closed", "dialog", "new_window"):
        pass                                               # nothing editable
    elif step.value != before["value"]:                    # only touch the value when it was edited
        v = step.value
        if isinstance(original.get("value"), bool):
            v = v in ("true", "True")
        out["value"] = v
    if kind in ("copy", "ocr_capture") and step.captured_as:
        out["captured_as"] = step.captured_as
    return out


def _step_edit_to_action(step: "StepEditModel", page_index: int = 0) -> dict:
    """Editable shape -> raw recording action (see StepEditModel) - the PUT
    direction of /api/recordings/steps. Produces the same action dict shape
    generator/uipath_importer.py and recorder/recorder.py already produce,
    so an edited/added step flows through build_artifacts() identically to
    one that came from a real recording or a spreadsheet import."""
    if step.action not in ALLOWED_STEP_ACTIONS:
        raise HTTPException(status_code=400, detail=f"Unknown step action '{step.action}'.")

    orig = step.original if isinstance(step.original, dict) else None
    if step.action in CHECK_ACTIONS:
        # A check / "remember value" row: its settings are the whole step. The target ("same element as step N",
        # a preset area) is resolved once the full list is known - see update_recording_steps.
        out = dict(orig) if orig is not None and orig.get("action") == step.action else \
            {"page_index": page_index, "frame_path": [], "element": {}, "locators": [], "value": None, "check_source": "editor"}
        out["action"] = step.action
        if step.action == "assert":
            cfg = dict(step.assertion or (orig or {}).get("assertion") or {})
            if step.label and step.label != (cfg.get("name") or ""):
                cfg["name"] = step.label
            out["assertion"] = cfg
            out["label"] = cfg.get("name") or step.label or "Check"
        else:
            cfg = dict(step.capture_cfg or (orig or {}).get("capture_cfg") or {})
            cfg["name"] = (step.label or cfg.get("name") or "remembered_value").strip()
            out["capture_cfg"] = cfg
            out["label"] = cfg["name"]
        if "check_suggestion" in step.model_fields_set:
            if step.check_suggestion:
                out["check_suggestion"] = step.check_suggestion
            else:
                out.pop("check_suggestion", None)
        return out
    if orig is not None and orig.get("action") == step.action:
        merged = _merge_step_edit(step, orig)
        if step.action in NEEDS_LOCATOR_ACTIONS and not merged.get("locators"):
            raise HTTPException(status_code=400, detail=f'"{step.action}" steps need at least one locator - use "Parse selector" to add one.')
        return merged
    if step.action in KEEP_ONLY_ACTIONS:
        raise HTTPException(status_code=400, detail=f"A '{step.action}' step can only be kept, moved or deleted - it can't be created or changed into here.")

    base = {"page_index": page_index, "frame_path": []}
    element = {"tag": "", "type": "", "text": step.label[:60], "placeholder": "", "name": "", "ariaLabel": step.label}

    if step.action == "delay":
        seconds = step.delay_seconds if step.delay_seconds is not None else (float(step.value) if step.value else 1.0)
        return {**base, "action": "delay", "value": seconds, "element": {}, "locators": []}
    if step.action == "scroll":
        # Accepts the SAME shorthand the Excel importer reads ("DOWN-4",
        # "UP-2") directly in `value` - not just explicit scroll_direction/
        # scroll_amount fields - so the step editor's grid can stay a
        # plain 5-column layout (Action / Name / Selector / Value, matching
        # the spreadsheet exactly) instead of needing separate direction/
        # amount cells only scroll rows would ever use.
        direction, amount = step.scroll_direction, step.scroll_amount
        if not direction and step.value:
            from generator.uipath_importer import _parse_scroll_input
            direction, amount = _parse_scroll_input(step.value)
        return {
            **base, "action": "scroll", "value": None, "element": {}, "locators": [],
            "scroll_direction": direction or "down", "scroll_amount": amount or 1,
        }
    if step.action == "window_closed":
        return {**base, "action": "window_closed", "value": None, "element": {}, "locators": [], "opener_page_index": page_index}
    if step.action == "menu_check":
        # No target element - the menu is found on the live page at run
        # time. `value` is an optional CSS selector for the menu, for the
        # rare page where the automatic pick is wrong. Its settings and
        # saved baseline live at the recording's top level ("menu_check"),
        # which this endpoint never touches, so editing steps keeps them.
        return {
            **base, "action": "menu_check", "value": (step.value or "").strip() or None, "locators": [],
            "element": {"tag": "", "type": "", "text": "Navigation menu", "placeholder": "", "name": "", "ariaLabel": ""},
        }
    if step.action in ("copy", "ocr_capture"):
        if not step.locators:
            raise HTTPException(status_code=400, detail=f'"{step.action}" steps need at least one locator - use "Parse selector" to add one.')
        return {
            **base, "action": step.action, "value": step.value, "captured_as": step.captured_as or "captured_value",
            "element": element, "locators": step.locators, "raw_selector": step.raw_selector,
        }
    if step.action == "assert_text":
        if not step.locators:
            raise HTTPException(status_code=400, detail='"assert_text" steps need at least one locator - use "Parse selector" to add one.')
        return {**base, "action": "assert_text", "value": step.value or "", "element": element, "locators": step.locators, "raw_selector": step.raw_selector}
    if step.action == "assert_ocr_text":
        # Page-level - deliberately no locator required, unlike assert_text
        # above: this checks text is visible SOMEWHERE on screen via OCR,
        # not inside one specific DOM element (see generator/build.py's
        # "assert_ocr_text" branch and page.tmpl's assert_ocr_text_visible).
        if not (step.value or "").strip():
            raise HTTPException(status_code=400, detail='"assert_ocr_text" steps need the expected text in the value field.')
        return {**base, "action": "assert_ocr_text", "value": step.value, "element": {}, "locators": []}

    # click / type / select / paste / date / keypress / file_upload - all need a real target
    if step.action != "keypress" and not step.locators:
        raise HTTPException(status_code=400, detail=f'"{step.action}" steps need at least one locator - use "Parse selector" to add one.')
    value = step.value
    if step.action == "click" and value in ("true", "True"):
        value = True  # toggle (radio/checkbox) steps store a boolean, not the literal string
    return {**base, "action": step.action, "value": value, "element": element, "locators": step.locators, "raw_selector": step.raw_selector}


@app.put("/api/recordings/migration-status")
def update_migration_status(
    file: str,
    status: str,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Update the migration_status of a recording.
    Valid values: NOT_MIGRATED, MIGRATED, VALIDATING, VALIDATED, PRODUCTION, DEPRECATED.
    Part of the UiPath-to-Native migration tracking (Phase 2)."""
    VALID = {"NOT_MIGRATED", "MIGRATED", "VALIDATING", "VALIDATED", "PRODUCTION", "DEPRECATED", "NATIVE"}
    if status not in VALID:
        raise HTTPException(status_code=400, detail=f"Invalid status {status!r}. Valid: {sorted(VALID)}")
    path = _safe_recording_path(file)
    with get_session() as session:
        recording_access.require_access(session, path, current_user, "edit")
    recording = json.loads(path.read_text())
    recording["migration_status"] = status
    path.write_text(json.dumps(recording, indent=2))
    return {"ok": True, "file": str(path), "migration_status": status}



@app.get("/api/recordings/steps")
