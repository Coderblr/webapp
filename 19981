def _telnet_pre_auth(maker_id: str) -> None:
    server = _get_property("server")
    port = _get_property("port")
    if not server or not port:
        return  # environment not configured for the telnet pre-step — skip rather than fail hard
    telnet = TelnetHandler(server, int(port))
    telnet.send_command(_TELNET_REQUEST_DEFAULT.format(maker_id=maker_id))
    telnet.disconnect()


def _telnet_pre_auth_for_branch(maker_id: str, branch: str) -> None:
    server = _get_property("server")
    port = _get_property("port")
    if not server or not port:
        return
    for code, template in _TELNET_REQUEST_BY_BRANCH.items():
        if code in (branch or ""):
            telnet = TelnetHandler(server, int(port))
            telnet.send_command(template.format(maker_id=maker_id))
            telnet.disconnect()
            return


def _do_login_and_password_change(context, maker_id: str, maker_password: str) -> None:
    login = _login_page()
    context.txn_data[key.USER_ID] = maker_id
    context.txn_data[key.USER_PASSWORD] = maker_password
    reporter.add_step_log("Initiating login")
    login.open(_get_property("baseUrl"))
    login.login_as(maker_id, maker_password)
    reporter.add_step_log("Clicked on Login")

    password_change = _password_change_page()
    context.txn_data = password_change.change_password(context.txn_data)
    reporter.add_step_log("Re-login after password change")
    login.login_as(maker_id, context.txn_data.get(key.USER_PASSWORD))
    reporter.add_step_log("Clicked on Login")


