"""
js_bridge.py

Loads bridge.js and provides a thin, reusable helper for injecting it into
a Playwright browsing context and invoking its functions.

Every recorder submodule (dom_crawler, mutation_observer, event_listener,
modal_detector, shadow_dom) goes through this helper rather than each
re-implementing script injection. `context` here is deliberately typed
loosely (Page | Frame) - Playwright's Page and Frame objects both expose
the same `.evaluate()` method, so a single call() implementation works
identically whether the caller is talking to the top-level document or a
specific iframe's Frame object (see iframe_handler.py, which resolves
"which Frame/Page to act on" for a given FramePath rather than mutating
any shared "current context" the way Selenium's switch_to did).
"""
from __future__ import annotations

from pathlib import Path
from typing import Any, Optional, Union

from playwright.sync_api import Frame, Page

_JS_PATH = Path(__file__).parent / "js" / "bridge.js"
_BRIDGE_SOURCE = _JS_PATH.read_text(encoding="utf-8")

EvaluationContext = Union[Page, Frame]


def inject(context: EvaluationContext) -> None:
    """Idempotently install window.__UA__ into the given context.
    bridge.js itself guards against double-initialization, so re-running
    this on every call (matching the old Selenium behavior exactly) is
    safe and cheap."""
    context.evaluate(_BRIDGE_SOURCE)


def call(context: EvaluationContext, expression: str, timeout_seconds: Optional[float] = None) -> Any:
    """Ensure the bridge is present, then evaluate a `window.__UA__....`
    expression and return its value. `expression` should be valid JS that
    ends in a `return`-able value, e.g. 'return window.__UA__.crawlDom();'
    - matching the exact calling convention every recorder submodule
    already uses. Playwright's evaluate() (unlike Selenium's
    execute_script()) does not implicitly wrap a bare script string in a
    function body, so this wraps `expression` in an IIFE itself to get
    the same "return works, top-level statements work" behavior every
    caller was already written against.

    timeout_seconds: accepted for backward compatibility with callers
    that pass it (self_healer.py's Stage 4), but NOT implemented as an
    actual bound anymore - a previous version of this function ran
    evaluate() on a separate worker thread with Future.result(timeout=...)
    to enforce this, but Playwright's SYNC API is pinned to a single
    OS thread/greenlet per browser connection: calling any Page/Frame/
    Locator method from a different thread raises "Cannot switch to a
    different thread", which is exactly what broke self-healing here.
    There is no safe way to bound a hung evaluate() call without genuine
    async cancellation support, which the sync API doesn't offer. See
    HEALING_DOM_CRAWL_TIMEOUT_SECONDS's comment in config.py and
    self_healer.py's pre-check for how the unresponsive-page problem is
    actually addressed now (skipping the crawl when the browser is
    already known disconnected, rather than trying to bound a call that
    can't safely be bounded)."""
    inject(context)
    return context.evaluate(f"() => {{ {expression} }}")
