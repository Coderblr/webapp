import { useEffect, useState } from "react";
import Head from "next/head";
import Link from "next/link";
import Layout from "@/components/Layout";
import RequireAuth from "@/components/RequireAuth";
import { useAuth } from "@/context/AuthContext";
import { adminApi, profileApi, api } from "@/lib/api";
import { Callout, DataTable, Metric, Panel, PanelHeader, StatusBadge } from "@/components/ui";

function greeting() {
  const h = new Date().getHours();
  if (h < 12) return "Good morning";
  if (h < 17) return "Good afternoon";
  return "Good evening";
}

function ActionCard({ href, title, description, accent }) {
  return (
    <Link
      href={href}
      className="group block rounded-sm border border-line bg-panel p-5 shadow-crisp transition-colors hover:border-brand-blue"
    >
      <div className={`mb-3 h-1.5 w-8 rounded-full ${accent}`} />
      <h3 className="text-sm font-semibold text-ink group-hover:text-brand-blueDark">{title}</h3>
      <p className="mt-1.5 text-sm text-muted">{description}</p>
    </Link>
  );
}

function PendingChangesWidget({ summary }) {
  const total = (summary?.pending_approvals || 0) + (summary?.approved_not_applied || 0) + (summary?.applied_not_validated || 0);
  if (total === 0) return null;
  return (
    <div className="mb-8">
      <div className="mb-3 flex items-center justify-between">
        <h2 className="text-sm font-semibold uppercase tracking-wide text-muted">Solution documents</h2>
        <Link href="/solution-documents" className="text-sm font-medium text-brand-blue hover:text-brand-blueDark">
          View all &rarr;
        </Link>
      </div>
      <div className="rounded-sm border border-brand-gold/40 bg-[#FBF2DF] p-4">
        <div className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-sm font-semibold text-ink">Change plans need attention</p>
            <p className="mt-0.5 text-xs text-muted">
              {summary.applications_with_activity?.map(a => `${a.application} (${a.pending_count})`).join(", ")}
            </p>
          </div>
          <div className="flex gap-4 text-center">
            {summary.pending_approvals > 0 && (
              <div>
                <p className="text-xl font-bold text-brand-gold">{summary.pending_approvals}</p>
                <p className="text-xs text-muted">Awaiting approval</p>
              </div>
            )}
            {summary.approved_not_applied > 0 && (
              <div>
                <p className="text-xl font-bold text-brand-blue">{summary.approved_not_applied}</p>
                <p className="text-xs text-muted">Ready to apply</p>
              </div>
            )}
            {summary.applied_not_validated > 0 && (
              <div>
                <p className="text-xl font-bold text-signal-tealDark">{summary.applied_not_validated}</p>
                <p className="text-xs text-muted">Awaiting validation</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

export default function DashboardPage() {
  const { user } = useAuth();
  const [myActivity, setMyActivity] = useState([]);
  const [myActivityError, setMyActivityError] = useState(null);
  const [stats, setStats] = useState(null);
  const [statsError, setStatsError] = useState(null);
  const [changeSummary, setChangeSummary] = useState(null);

  useEffect(() => {
    profileApi
      .activity(8)
      .then(setMyActivity)
      .catch((e) => setMyActivityError(e.detail || e.message));

    api.getDashboardSummary()
      .then(setChangeSummary)
      .catch(() => {});

    if (user && user.role === "admin") {
      adminApi
        .dashboardStats()
        .then(setStats)
        .catch((e) => setStatsError(e.detail || e.message));
    }
  }, [user]);

  return (
    <RequireAuth>
      <Layout>
        <Head>
          <title>Dashboard - AI Test Recorder</title>
        </Head>

        {/* Page header */}
        <div className="mb-8 flex items-start justify-between">
          <div>
            <h1 className="text-2xl font-bold tracking-tight text-ink">
              {greeting()}, {user?.first_name || "there"}.
            </h1>
            <p className="mt-1 text-sm text-muted">
              Here&rsquo;s what&rsquo;s happening with your test recordings.
            </p>
          </div>
        </div>

        {/* Action cards — now 3 wide across the full content area */}
        <div className="mb-8 grid gap-5 sm:grid-cols-3">
          <ActionCard href="/tool" title="Record a new session" description="Capture clicks and typing on any app, then generate a Behave + Playwright suite." accent="bg-brand-blue"/>
          <ActionCard href="/tool" title="Run a saved recording" description="Re-run something you already recorded and get a full exit report." accent="bg-brand-gold"/>
          <ActionCard href="/solution-documents" title="Solution Documents" description="Upload a CR or Solution Document, analyze its impact, and apply changes safely." accent="bg-signal-tealDark"/>
        </div>

        {/* Pending changes widget */}
        {changeSummary && <PendingChangesWidget summary={changeSummary}/>}

        {/* Admin platform overview + activity side by side */}
        <div className={`grid gap-6 ${user?.role === "admin" ? "lg:grid-cols-2" : "lg:grid-cols-1"}`}>

          {user?.role === "admin" && (
            <div>
              <div className="mb-3 flex items-center justify-between">
                <h2 className="text-sm font-semibold uppercase tracking-wide text-muted">Platform overview</h2>
                <Link href="/admin/users" className="text-sm font-medium text-brand-blue hover:text-brand-blueDark">
                  Manage users &rarr;
                </Link>
              </div>
              {statsError && <Callout tone="error">Could not load platform stats: {statsError}</Callout>}
              {stats && (
                <>
                  <div className="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <Metric label="Total users" value={stats.total_users} />
                    <Metric label="Online now" value={stats.online_now} />
                    <Metric label="Runs today" value={stats.runs_today} />
                    <Metric label="Passed today" value={stats.runs_success_today} />
                  </div>
                  <Panel>
                    <PanelHeader title="Recent activity across all users" />
                    <div className="px-5 py-4">
                      <DataTable
                        columns={[
                          { key: "username", label: "User" },
                          { key: "action", label: "Action", mono: true },
                          { key: "status", label: "Status" },
                          { key: "timestamp", label: "When", mono: true },
                        ]}
                        rows={stats.recent_activity.map((a) => ({
                          username: a.username || "—",
                          action: a.action,
                          status: <StatusBadge status={a.status === "SUCCESS" ? "Success" : "Failed"} />,
                          timestamp: new Date(a.timestamp).toLocaleString(),
                        }))}
                      />
                    </div>
                  </Panel>
                </>
              )}
            </div>
          )}

          <div>
            <div className="mb-3 flex items-center justify-between">
              <h2 className="text-sm font-semibold uppercase tracking-wide text-muted">Your recent activity</h2>
              <Link href="/profile" className="text-sm font-medium text-brand-blue hover:text-brand-blueDark">
                View all &rarr;
              </Link>
            </div>
            {myActivityError && <Callout tone="error">Could not load your activity: {myActivityError}</Callout>}
            <Panel>
              <div className="px-5 py-4">
                <DataTable
                  columns={[
                    { key: "action", label: "Action", mono: true },
                    { key: "status", label: "Status" },
                    { key: "timestamp", label: "When", mono: true },
                  ]}
                  rows={myActivity.map((a) => ({
                    action: a.action,
                    status: <StatusBadge status={a.status === "SUCCESS" ? "Success" : "Failed"} />,
                    timestamp: new Date(a.timestamp).toLocaleString(),
                  }))}
                />
              </div>
            </Panel>
          </div>

        </div>
      </Layout>
    </RequireAuth>
  );
}
