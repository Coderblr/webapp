"""
File-based storage for "run a saved recording" history - one JSON file per
run under transactions/, alongside recordings/ (raw recorder JSON) and
output/ (generated feature/steps/page files + reports).

This intentionally does NOT touch the database. The database
(database/models.py) is reserved for auth/session/activity data only
(Users, Sessions, Activity Logs) - everything about what a recording did
when it ran (status, per-step results, files produced) lives here as plain
files instead, per-transaction, human-readable and greppable without a
DB client.

Each run's JSON, transactions/transaction_<id>.json, looks like:
    {
      "transaction_id": 7,
      "user_id": 3,
      "user": "Jane Doe",
      "transaction_name": "Loan Application",
      "status": "Success",
      "date_time": "2026-09-04T12:00:00",
      "steps": [{"step_name": "...", "status": "Passed", "error_message": null}, ...],
      "step_count": 5, "passed_count": 5, "failed_count": 0,
      "files": [{"file_name": "...", "folder_path": "..."}, ...],
      "report_file": "output/reports/transaction_7_exit_report.txt"
    }
"""
from __future__ import annotations
import json
from datetime import datetime
from pathlib import Path
from threading import Lock
from typing import Optional

ROOT = Path(__file__).parent.parent
TRANSACTIONS_DIR = ROOT / "transactions"

_id_lock = Lock()  # this process is already single-recorder-at-a-time (see backend STATE); this just protects the id counter


def _ensure_dir() -> None:
    TRANSACTIONS_DIR.mkdir(parents=True, exist_ok=True)


def next_transaction_id() -> int:
    """Highest existing transaction_<id>.json + 1. Good enough for a
    single-process backend (same assumption the rest of this app already
    makes - see backend/api.py's global recorder STATE)."""
    _ensure_dir()
    with _id_lock:
        existing = []
        for f in TRANSACTIONS_DIR.glob("transaction_*.json"):
            try:
                existing.append(int(f.stem.split("_")[1]))
            except (IndexError, ValueError):
                continue
        return (max(existing) + 1) if existing else 1


def save_transaction(txn: dict) -> Path:
    _ensure_dir()
    path = TRANSACTIONS_DIR / f"transaction_{txn['transaction_id']}.json"
    path.write_text(json.dumps(txn, indent=2, default=str))
    return path


def get_transaction(transaction_id: int) -> Optional[dict]:
    path = TRANSACTIONS_DIR / f"transaction_{transaction_id}.json"
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text())
    except Exception:
        return None


def list_transactions(user_id: Optional[int] = None, limit: int = 50, recording_id: Optional[int] = None) -> list[dict]:
    if not TRANSACTIONS_DIR.exists():
        return []
    out = []
    for f in TRANSACTIONS_DIR.glob("transaction_*.json"):
        try:
            data = json.loads(f.read_text())
        except Exception:
            continue
        if user_id is not None and data.get("user_id") != user_id:
            continue
        if recording_id is not None and data.get("recording_id") != recording_id:
            continue
        out.append(data)
    out.sort(key=lambda t: t.get("date_time") or "", reverse=True)
    return out[:limit]


def mark_interrupted_running_transactions() -> int:
    """Crash recovery: called once at backend startup (see backend/api.py's
    startup event). A transaction only ever stays "Running" if the process
    that was executing it died before reaching a terminal status (Success/
    Failed/Agent Disconnected) - runner/run_recording.py's own try/except
    already turns every in-process failure into a terminal status, so the
    only way a "Running" record can still exist here is a hard kill/restart
    mid-run. Rewrites each one found to "Interrupted" so it's visible (and
    retry-able) in the UI instead of either vanishing or looking like it's
    still going forever. Returns how many were swept, for a startup log line."""
    if not TRANSACTIONS_DIR.exists():
        return 0
    count = 0
    for f in TRANSACTIONS_DIR.glob("transaction_*.json"):
        try:
            data = json.loads(f.read_text())
        except Exception:
            continue
        if data.get("status") != "Running":
            continue
        data["status"] = "Interrupted"
        data["raw_output"] = (data.get("raw_output") or "") + \
            "\n[Marked Interrupted at backend startup - the process running this execution did not finish.]"
        f.write_text(json.dumps(data, indent=2, default=str))
        count += 1
    return count


def count_transactions_since(since: datetime, status: Optional[str] = None) -> int:
    """Used by the admin dashboard ("runs today" / "passed today") - reads
    the same JSON files rather than a DB table."""
    count = 0
    for t in list_transactions(limit=10_000):
        dt = t.get("date_time")
        if not dt:
            continue
        try:
            when = datetime.fromisoformat(dt)
        except ValueError:
            continue
        if when < since:
            continue
        if status is not None and t.get("status") != status:
            continue
        count += 1
    return count
