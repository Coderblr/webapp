# IMPORTANT - registration order: AuthMiddleware MUST be added before
# CORSMiddleware (i.e. earlier, textually, right here). Starlette's
# add_middleware() inserts each new middleware at the front of the stack,
# so whichever is added LAST ends up OUTERMOST - see AuthMiddleware's own
# docstring (backend/auth/middleware.py) for the empirically-verified
# details. Getting this order backwards breaks CORS preflight (OPTIONS)
# requests from the Next.js dev server.
app.add_middleware(AuthMiddleware)
app.add_middleware(
    CORSMiddleware,
    # NOT allow_origins=["*"] - Starlette's CORSMiddleware only reflects the
    # real Origin back on every response when it isn't in "allow all
    # origins" mode (i.e. a literal "*" isn't in allow_origins). With a
    # literal "*" here, its simple_response() heuristic only reflects the
    # real origin back once the request already carries a session cookie -
    # so it looks fine once you're logged in, but the very first response
    # of all (POST /api/auth/login, before any cookie exists) comes back
    # with "Access-Control-Allow-Origin: *" AND
    # "Access-Control-Allow-Credentials: true" together, which is invalid
    # per the fetch spec - browsers silently reject that combination, so
    # login itself fails cross-origin (Next.js dev server on a different
    # port, or a different machine on the LAN) with what looks like a CORS
    # preflight failure even though the preflight itself was fine.
    # allow_origin_regex matching everything sidesteps that "allow all
    # origins" fast path entirely - is_allowed_origin() then runs (and
    # correctly reflects the real origin) on every single response,
    # cookie or not.
    allow_origin_regex=r".*",
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.include_router(auth_router)
app.include_router(admin_router)

