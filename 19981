// ---------------------------------------------------------------------------
// Recording regeneration - refresh a saved recording's generated
// feature/steps/page files from its current JSON, without executing
// anything (see backend/api.py's regenerate_recording).
// ---------------------------------------------------------------------------

export const recordingsApi = {
  regenerate: (recording_file) =>
    request("/api/recordings/regenerate", { method: "POST", body: JSON.stringify({ recording_file }) }),

  // Deliberately NOT using request() above - it always forces
  // Content-Type: application/json, which would break a multipart file
  // upload (the browser needs to set that header itself, including the
  // random boundary string, when the body is a FormData object).
  async _postMultipart(path, formData) {
    const token = getToken();
    const headers = token ? { Authorization: `Bearer ${token}` } : {};

    let res;
    try {
      res = await fetch(`${API_BASE}${path}`, { method: "POST", body: formData, headers });
    } catch (e) {
      throw new ApiError(`Could not reach the backend at ${API_BASE}. Is it running? (${e.message})`, 0);
    }

    if (res.status === 401) {
      let detail = "Session expired - please log in again.";
      try {
        detail = (await res.json()).detail || detail;
      } catch {
        /* no body */
      }
      if (unauthorizedHandler) unauthorizedHandler(detail);
      throw new ApiError(detail, 401);
    }
    if (!res.ok) {
      let detail = `${res.status} ${res.statusText}`;
      try {
        detail = (await res.json()).detail || detail;
      } catch {
        /* no body */
      }
      throw new ApiError(detail, res.status);
    }
    return res.json();
  },

  // Lists every sheet name in an uploaded workbook, without importing
  // anything yet - call this first so the person can choose a specific
  // sheet, several, or "all of them" (see importUipathExcel below).
  listUipathSheets(file) {
    const formData = new FormData();
    formData.append("file", file);
    return this._postMultipart("/api/recordings/uipath_sheets", formData);
  },

  // sheetNames: optional array of sheet names to import, each becoming
  // its own saved recording (from listUipathSheets above - pass every
  // name to import "all sheets"). Omit entirely to import just the
  // workbook's active sheet (a single-sheet file needs no picker step at
  // all). Always returns {ok, results: [...]}, one entry per sheet
  // imported (or one entry with sheet_name: null for the omitted case).
  importUipathExcel(file, recordingName, sheetNames) {
    const formData = new FormData();
    formData.append("file", file);
    if (recordingName) formData.append("recording_name", recordingName);
    if (sheetNames && sheetNames.length) formData.append("sheet_names", sheetNames.join(","));
    return this._postMultipart("/api/recordings/import_uipath", formData);
  },
};

