import { useEffect, useState } from "react";
import { api, ApiError } from "@/lib/api";
import LiveRecordingView from "@/components/LiveRecordingView";
import {
  Button,
  Callout,
  Checkbox,
  DataTable,
  Disclosure,
  Field,
  Panel,
  PanelHeader,
  Select,
  Spinner,
  TextInput,
} from "@/components/ui";

const OTHERS = "Others";

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function actionLabel(a) {
  const el = a.element || {};
  return el.ariaLabel || el.placeholder || el.name || el.text || el.tag || "";
}

function actionDetail(a) {
  let detail = a.value || "";
  if (a.action === "keypress") {
    detail = a.value || "";
  } else if (a.captured_as) {
    detail = `${detail}  ->  {{${a.captured_as}}}`;
  } else if (a.resolved_var) {
    detail = `{{${a.resolved_var}}}  (recorded: ${detail})`;
  }
  return detail;
}

export default function RecordTab() {
  const [applicationNames, setApplicationNames] = useState([]);
  const [appsError, setAppsError] = useState(null);
  const [selectedApp, setSelectedApp] = useState(OTHERS);
  const [customUrl, setCustomUrl] = useState("");
  const [recordingName, setRecordingName] = useState("");
  const [headless, setHeadless] = useState(false);

  const [recordingActive, setRecordingActive] = useState(false);
  const [recordingHeadless, setRecordingHeadless] = useState(false);
  const [backendProcessId, setBackendProcessId] = useState(null);

  const [startBusy, setStartBusy] = useState(false);
  const [startPhase, setStartPhase] = useState(null);
  const [startError, setStartError] = useState(null);
  const [startNotice, setStartNotice] = useState(null);

  const [saveBusy, setSaveBusy] = useState(false);
  const [saveError, setSaveError] = useState(null);
  const [saveNotice, setSaveNotice] = useState(null);

  const [runBusy, setRunBusy] = useState(false);
  const [runError, setRunError] = useState(null);

  const [buildResult, setBuildResult] = useState(null);
  const [runResult, setRunResult] = useState(null);

  const [statusPreview, setStatusPreview] = useState(null);
  const [statusPreviewError, setStatusPreviewError] = useState(null);

  useEffect(() => {
    api
      .getApplications()
      .then((r) => setApplicationNames(r.applications))
      .catch((e) => setAppsError(e.detail));
  }, []);

  async function handleStart() {
    setStartError(null);
    setStartNotice(null);
    if (selectedApp === OTHERS && !customUrl.trim()) {
      setStartError("Enter a target URL for 'Others' first.");
      return;
    }
    setStartBusy(true);
    try {
      await api.startRecording({
        app_name: selectedApp === OTHERS ? "" : selectedApp,
        url: customUrl,
        recording_name: recordingName,
        headless,
      });

      setStartPhase("Launching browser...");
      let launched = false;
      let lastStatus = null;
      for (let i = 0; i < 30; i++) {
        await sleep(500);
        lastStatus = await api.getStatus();
        if (lastStatus.start_error) {
          setStartError(`Recording failed to start: ${lastStatus.start_error}`);
          break;
        }
        if (lastStatus.recording_active) {
          launched = true;
          break;
        }
      }
      if (!launched && !(lastStatus && lastStatus.start_error)) {
        setStartError("Browser launch is taking longer than expected - check the backend terminal for errors.");
      }
      if (launched && lastStatus) {
        setRecordingActive(true);
        setRecordingHeadless(!!lastStatus.headless);
        setBackendProcessId(lastStatus.process_id);
        setStartNotice("Recording started.");
      }
    } catch (e) {
      setStartError(e.detail || e.message);
    } finally {
      setStartPhase(null);
      setStartBusy(false);
    }
  }

  async function handleSaveAndGenerate() {
    setSaveError(null);
    setSaveNotice(null);
    setSaveBusy(true);
    try {
      const status = await api.getStatus().catch(() => null);
      if (status && status.process_id && status.process_id !== backendProcessId) {
        setRecordingActive(false);
        setSaveError(
          "The backend restarted since this recording started (its in-memory state, including the open browser, was lost) - start a new recording."
        );
        return;
      }
      const data = await api.stopAndSave();
      setBuildResult(data);
      setRecordingActive(false);
      setSaveNotice(
        `Generated ${data.build_result.step_count} steps / ${data.build_result.element_count} elements. (LLM used: ${data.llm_used})`
      );
    } catch (e) {
      setSaveError(e.detail || e.message);
    } finally {
      setSaveBusy(false);
    }
  }

  async function handleRun() {
    setRunError(null);
    setRunBusy(true);
    try {
      const result = await api.runCheck(headless);
      setRunResult(result);
    } catch (e) {
      setRunError(e.detail || e.message);
    } finally {
      setRunBusy(false);
    }
  }

  async function handleRefreshStatus() {
    setStatusPreviewError(null);
    try {
      setStatusPreview(await api.getStatus());
    } catch (e) {
      setStatusPreview(null);
      setStatusPreviewError(e.detail || e.message);
    }
  }

  const variables = (buildResult && buildResult.variables) || {};
  const recordedActions = (buildResult && buildResult.actions) || [];

  return (
    <div className="grid gap-6 lg:grid-cols-[360px_1fr]">
      {/* ---- Configuration panel -------------------------------------- */}
      <Panel>
        <PanelHeader title="Session" caption="Choose a target and start capturing." />
        <div className="space-y-4 px-5 py-5">
          {appsError && <Callout tone="error">Could not load application list: {appsError}</Callout>}

          <Field label="Application">
            <Select value={selectedApp} onChange={(e) => setSelectedApp(e.target.value)}>
              {applicationNames.map((name) => (
                <option key={name} value={name}>
                  {name}
                </option>
              ))}
              <option value={OTHERS}>{OTHERS}</option>
            </Select>
          </Field>

          {selectedApp === OTHERS && (
            <Field label="Target application URL">
              <TextInput
                placeholder="https://your-app.example.com"
                value={customUrl}
                onChange={(e) => setCustomUrl(e.target.value)}
              />
            </Field>
          )}

          <Field
            label="Recording name"
            hint="Used to label this recording in 'Run Saved Recording' and in exit reports."
          >
            <TextInput
              placeholder="e.g. a transaction number, or 'New Loan Application'"
              value={recordingName}
              onChange={(e) => setRecordingName(e.target.value)}
            />
          </Field>

          <Checkbox label="headless" checked={headless} onChange={setHeadless} />

          <div className="flex flex-col gap-2 border-t border-line pt-4">
            <Button onClick={handleStart} disabled={recordingActive || startBusy}>
              {startBusy ? "Starting..." : "Start Recording"}
            </Button>
            <Button variant="secondary" onClick={handleSaveAndGenerate} disabled={!recordingActive || saveBusy}>
              {saveBusy ? "Saving..." : "Save & Generate"}
            </Button>
            <Button variant="secondary" onClick={handleRun} disabled={!buildResult || runBusy}>
              {runBusy ? "Running..." : "Run / Check"}
            </Button>
          </div>

          <div className="space-y-2 pt-1">
            {startPhase && <Spinner label={startPhase} />}
            {startError && <Callout tone="error">{startError}</Callout>}
            {startNotice && <Callout tone="success">{startNotice}</Callout>}
            {saveBusy && <Spinner label="Stopping recording and generating feature/steps/page files..." />}
            {saveError && <Callout tone="error">{saveError}</Callout>}
            {saveNotice && <Callout tone="success">{saveNotice}</Callout>}
            {runBusy && <Spinner label="Running generated Behave suite..." />}
            {runError && <Callout tone="error">Run failed: {runError}</Callout>}
            {recordingActive && (
              <div className="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-signal-rust">
                <span className="pulse-dot h-2 w-2 rounded-full bg-signal-rust" />
                Recording in progress
              </div>
            )}
          </div>
        </div>
      </Panel>

      {/* ---- Log panel --------------------------------------------------- */}
      <div className="space-y-4">
        {recordingActive && recordingHeadless && (
          <Panel>
            <PanelHeader
              title="Live view"
              caption="This runs on the server - what you see and interact with here is the real, remote browser being recorded."
            />
            <div className="px-5 py-5">
              <LiveRecordingView active={recordingActive} />
            </div>
          </Panel>
        )}

        {recordingActive && !recordingHeadless && (
          <Panel>
            <div className="px-5 py-5">
              <Callout>
                A real Edge browser window has opened on the machine running the backend - interact with it there
                directly. (This is local/headed mode - the live view above only appears for headless/hosted
                recordings, where there's no visible window to work with directly.)
              </Callout>
            </div>
          </Panel>
        )}

        <Panel>
          <PanelHeader title="Log" caption="Generation output, recorded actions, and the last run." />
          <div className="space-y-3 px-5 py-5">
            {runResult && (
              <Callout tone={runResult.ok ? "success" : "error"}>
                {runResult.ok ? "PASSED" : "FAILED (see log below)"}
              </Callout>
            )}

            {buildResult ? (
              <div className="space-y-3">
                <Disclosure title="Generation result">
                  <pre className="max-h-72 overflow-auto whitespace-pre-wrap break-words rounded-sm bg-rail p-3 font-mono text-xs scroll-thin">
                    {JSON.stringify(buildResult.build_result, null, 2)}
                  </pre>
                </Disclosure>

                {Object.keys(variables).length > 0 && (
                  <Disclosure title={`Captured variables (${Object.keys(variables).length})`}>
                    <p className="mb-2 text-xs text-muted">
                      Values captured via copy/CTRL+C during recording, reused later via {"{{name}}"} placeholders.
                    </p>
                    <DataTable
                      columns={[
                        { key: "variable", label: "Variable", mono: true },
                        { key: "value", label: "Captured value", mono: true },
                      ]}
                      rows={Object.entries(variables).map(([k, v]) => ({
                        variable: `{{${k}}}`,
                        value: v,
                      }))}
                    />
                  </Disclosure>
                )}

                {recordedActions.length > 0 && (
                  <Disclosure title={`Recorded actions (${recordedActions.length})`}>
                    <DataTable
                      columns={[
                        { key: "n", label: "#" },
                        { key: "action", label: "Action" },
                        { key: "element", label: "Element" },
                        { key: "detail", label: "Value / key", mono: true },
                      ]}
                      rows={recordedActions.map((a, i) => ({
                        n: i + 1,
                        action: a.action || "",
                        element: actionLabel(a),
                        detail: actionDetail(a),
                      }))}
                    />
                  </Disclosure>
                )}
              </div>
            ) : (
              <p className="text-sm text-muted">Nothing generated yet.</p>
            )}

            <div className="pt-1">
              {runResult ? (
                <pre className="max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-sm bg-[#151B22] p-4 font-mono text-xs text-[#D7DDE3] scroll-thin">
                  {runResult.output || ""}
                </pre>
              ) : (
                <p className="text-sm text-muted">Nothing run yet.</p>
              )}
            </div>
          </div>
        </Panel>

        <Panel>
          <div className="flex items-center justify-between px-5 py-4">
            <div>
              <h2 className="text-sm font-semibold text-ink">Backend status</h2>
              {statusPreviewError && <p className="mt-0.5 text-xs text-signal-rust">{statusPreviewError}</p>}
            </div>
            <Button variant="secondary" onClick={handleRefreshStatus}>
              Refresh status
            </Button>
          </div>
          {statusPreview && (
            <div className="border-t border-line px-5 py-4">
              <pre className="overflow-auto whitespace-pre-wrap break-words rounded-sm bg-rail p-3 font-mono text-xs scroll-thin">
                {JSON.stringify(statusPreview, null, 2)}
              </pre>
            </div>
          )}
        </Panel>
      </div>
    </div>
  );
}
