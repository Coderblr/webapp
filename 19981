"""
ALL-IN-ONE DOM Interaction Recorder (No Playwright — uses Selenium)
---------------------------------------------------------------------
What it does, in ONE script:
  1. Opens a browser using Selenium.
  2. Injects JS that listens for clicks, typing, and dropdown changes.
  3. Records every interaction with its locator (CSS + XPath) and value.
  4. When you stop it (Ctrl+C):
       a. Saves the raw events      -> recorded_steps.json
       b. Cleans them up            -> clean_steps.json
          (collapses keystrokes into final values, removes duplicate
          consecutive clicks)
       c. Generates a ready-to-run  -> generated_test.py
          Selenium script from the cleaned steps.

     d. Builds a pandas DataFrame from the cleaned steps and saves it
        as an Excel file -> recorded_steps.xlsx

Install requirement:
    pip install selenium webdriver-manager pandas openpyxl

Run:
    python dom_recorder_all_in_one.py
"""

import json
import os
import time

import pandas as pd
from openpyxl.styles import Font, Alignment, PatternFill
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager


# ---------- JavaScript injected into the page to capture events ----------
JS_LISTENER = r"""
if (!window.__recordedSteps) {
    window.__recordedSteps = [];

    function getXPath(el) {
        if (el.id) return `//*[@id="${el.id}"]`;
        const parts = [];
        while (el && el.nodeType === 1) {
            let index = 1;
            let sibling = el.previousElementSibling;
            while (sibling) {
                if (sibling.nodeName === el.nodeName) index++;
                sibling = sibling.previousElementSibling;
            }
            parts.unshift(`${el.nodeName.toLowerCase()}[${index}]`);
            el = el.parentElement;
        }
        return "/" + parts.join("/");
    }

    function getCssSelector(el) {
        if (el.id) return `#${el.id}`;
        if (el.className && typeof el.className === "string") {
            const cls = el.className.trim().split(/\s+/).join(".");
            if (cls) return `${el.tagName.toLowerCase()}.${cls}`;
        }
        return el.tagName.toLowerCase();
    }

    function record(e, actionType) {
        const el = e.target;
        window.__recordedSteps.push({
            action: actionType,
            tag: el.tagName,
            id: el.id || null,
            name: el.getAttribute("name") || null,
            class_name: el.className || null,
            css_selector: getCssSelector(el),
            xpath: getXPath(el),
            text: (el.innerText || "").trim().slice(0, 100),
            value: el.value !== undefined ? el.value : null,
            timestamp: new Date().toISOString()
        });
    }

    document.addEventListener("click", (e) => record(e, "click"), true);
    document.addEventListener("change", (e) => record(e, "input_change"), true);
    document.addEventListener("input", (e) => record(e, "typing"), true);
}
"""


RAW_FILE = "recorded_steps.json"


def save_json(path, data):
    """Write JSON to disk immediately and confirm it landed on disk."""
    abs_path = os.path.abspath(path)
    with open(abs_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    print(f"  -> wrote {len(data) if isinstance(data, list) else ''} "
          f"items to {abs_path}")
    return abs_path


# ---------- Step 1: Record ----------
def record_steps(start_url="https://www.saucedemo.com/"):
    driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()))
    driver.get(start_url)

    all_events = []
    seen_count = 0

    print("Recording started. Interact with the page in the opened browser.")
    print("Press Ctrl+C here in the terminal when you're done.\n")
    print(f"Working directory (where files will be saved): {os.getcwd()}\n")

    try:
        while True:
            driver.execute_script(JS_LISTENER)  # re-inject in case of navigation
            events = driver.execute_script("return window.__recordedSteps || [];")

            if len(events) > seen_count:
                new_events = events[seen_count:]
                for ev in new_events:
                    print(f"[{ev['action']}] <{ev['tag']}> "
                          f"locator(css)={ev['css_selector']} "
                          f"value={ev['value']!r}")
                all_events.extend(new_events)
                seen_count = len(events)
                # Save after every batch of new events, so nothing is
                # lost even if the second Ctrl+C or a crash happens later.
                save_json(RAW_FILE, all_events)

            time.sleep(1)

    except KeyboardInterrupt:
        print("\nStopping recorder...")

    except Exception as e:
        print(f"\nRecorder stopped due to an error: {e}")

    finally:
        try:
            driver.quit()
        except Exception:
            pass

    return all_events


# ---------- Step 2: Clean ----------
def clean_steps(raw_steps):
    cleaned = []

    for step in raw_steps:
        action = step["action"]
        locator = step["css_selector"]

        if action in ("typing", "input_change"):
            if cleaned and cleaned[-1]["action"] == "input" and cleaned[-1]["css_selector"] == locator:
                cleaned[-1]["value"] = step["value"]
                cleaned[-1]["timestamp"] = step["timestamp"]
            else:
                cleaned.append({
                    "action": "input",
                    "tag": step["tag"],
                    "id": step["id"],
                    "name": step["name"],
                    "css_selector": step["css_selector"],
                    "xpath": step["xpath"],
                    "value": step["value"],
                    "timestamp": step["timestamp"],
                })

        elif action == "click":
            if cleaned and cleaned[-1]["action"] == "click" and cleaned[-1]["css_selector"] == locator:
                continue
            cleaned.append({
                "action": "click",
                "tag": step["tag"],
                "id": step["id"],
                "name": step["name"],
                "css_selector": step["css_selector"],
                "xpath": step["xpath"],
                "text": step.get("text", ""),
                "timestamp": step["timestamp"],
            })

    return cleaned


# ---------- Step 3: Generate a runnable Selenium test script ----------
def generate_selenium_script(cleaned_steps, start_url="https://www.saucedemo.com/"):
    lines = [
        "from selenium import webdriver",
        "from selenium.webdriver.common.by import By",
        "from selenium.webdriver.chrome.service import Service",
        "from webdriver_manager.chrome import ChromeDriverManager",
        "import time",
        "",
        "driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()))",
        f'driver.get("{start_url}")',
        "",
    ]

    for step in cleaned_steps:
        selector = step["css_selector"].replace('"', '\\"')
        if step["action"] == "click":
            lines.append(f'driver.find_element(By.CSS_SELECTOR, "{selector}").click()')
            lines.append("time.sleep(0.5)")
        elif step["action"] == "input":
            value = (step["value"] or "").replace('"', '\\"')
            lines.append(f'el = driver.find_element(By.CSS_SELECTOR, "{selector}")')
            lines.append("el.clear()")
            lines.append(f'el.send_keys("{value}")')
            lines.append("time.sleep(0.3)")
        lines.append("")

    lines.append("# driver.quit()  # uncomment to close browser at the end")
    return "\n".join(lines)


# ---------- Step 4: Build Excel report from cleaned steps ----------
def save_excel_report(cleaned_steps, path="recorded_steps.xlsx"):
    rows = []
    for i, step in enumerate(cleaned_steps, start=1):
        rows.append({
            "Step": i,
            "Action": step["action"],
            "Tag": step["tag"],
            "Id": step.get("id") or "",
            "Name": step.get("name") or "",
            "CSS Selector": step.get("css_selector") or "",
            "XPath": step.get("xpath") or "",
            "Value": step.get("value") or "",
            "Text": step.get("text") or "",
            "Timestamp": step.get("timestamp") or "",
        })

    df = pd.DataFrame(rows, columns=[
        "Step", "Action", "Tag", "Id", "Name",
        "CSS Selector", "XPath", "Value", "Text", "Timestamp",
    ])

    abs_path = os.path.abspath(path)
    with pd.ExcelWriter(abs_path, engine="openpyxl") as writer:
        df.to_excel(writer, sheet_name="Recorded Steps", index=False)

        ws = writer.sheets["Recorded Steps"]

        # Header formatting
        header_font = Font(name="Arial", bold=True, color="FFFFFF")
        header_fill = PatternFill(start_color="4472C4", end_color="4472C4", fill_type="solid")
        for cell in ws[1]:
            cell.font = header_font
            cell.fill = header_fill
            cell.alignment = Alignment(horizontal="center", vertical="center")

        # Body font + column widths
        body_font = Font(name="Arial", size=10)
        for row in ws.iter_rows(min_row=2):
            for cell in row:
                cell.font = body_font

        widths = {"A": 6, "B": 12, "C": 8, "D": 16, "E": 16,
                  "F": 24, "G": 40, "H": 20, "I": 30, "J": 24}
        for col, w in widths.items():
            ws.column_dimensions[col].width = w

        ws.freeze_panes = "A2"

    print(f"  -> wrote {len(df)} rows to {abs_path}")
    return abs_path


# ---------- Main ----------
def main():
    start_url = "https://www.saucedemo.com/"  # <-- change to your target URL

    raw_steps = record_steps(start_url)

    if not raw_steps:
        print("\nNo events were recorded (raw_steps is empty) — "
              "nothing to clean or generate. Did you interact with "
              "the page before pressing Ctrl+C?")
        return

    print()
    save_json(RAW_FILE, raw_steps)

    cleaned = clean_steps(raw_steps)
    save_json("clean_steps.json", cleaned)

    script = generate_selenium_script(cleaned, start_url)
    abs_path = os.path.abspath("generated_test.py")
    with open(abs_path, "w", encoding="utf-8") as f:
        f.write(script)
        f.flush()
        os.fsync(f.fileno())
    print(f"  -> wrote generated_test.py to {abs_path}")

    excel_path = save_excel_report(cleaned, "recorded_steps.xlsx")

    print("\nDone. Files saved:")
    print(f"  {os.path.abspath(RAW_FILE)}")
    print(f"  {os.path.abspath('clean_steps.json')}")
    print(f"  {abs_path}")
    print(f"  {excel_path}")


if __name__ == "__main__":
    main()
