// ---------------------------------------------------------------------------
// Transaction history ("My Executions") + file/screenshot downloads
// ---------------------------------------------------------------------------

export const transactionsApi = {
  list: (params = {}) => request(`/api/transactions${toQuery(params)}`),
  get: (transactionId) => request(`/api/transactions/${transactionId}`),

  // Fetches a file (a generated artifact, the exit report, a step
  // screenshot) as a blob and triggers a normal browser download - not a
  // plain <a href> to the endpoint directly, since that can't carry the
  // Authorization header this protected endpoint requires; this keeps
  // auth consistent with every other request in the app (Bearer header,
  // not a token embedded in the URL where it could end up in browser
  // history/server logs).
  async downloadFile(transactionId, fileName, folderPath, saveAsName) {
    const token = getToken();
    const headers = token ? { Authorization: `Bearer ${token}` } : {};
    const url = `${API_BASE}/api/transactions/${transactionId}/download${toQuery({ file_name: fileName, folder_path: folderPath })}`;

    let res;
    try {
      res = await fetch(url, { headers });
    } catch (e) {
      throw new ApiError(`Could not reach the backend at ${API_BASE}. Is it running? (${e.message})`, 0);
    }
    if (!res.ok) {
      let detail = `${res.status} ${res.statusText}`;
      try {
        detail = (await res.json()).detail || detail;
      } catch {
        /* no body */
      }
      throw new ApiError(detail, res.status);
    }
    const blob = await res.blob();
    const objectUrl = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = objectUrl;
    a.download = saveAsName || fileName;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(objectUrl);
  },

  // Same fetch-as-blob mechanism as downloadFile, but returns a data: URL
  // instead of triggering a save - for showing a screenshot inline (an
  // <img src=...>) rather than downloading it.
  async fetchImageDataUrl(transactionId, fileName, folderPath) {
    const token = getToken();
    const headers = token ? { Authorization: `Bearer ${token}` } : {};
    const url = `${API_BASE}/api/transactions/${transactionId}/download${toQuery({ file_name: fileName, folder_path: folderPath })}`;
    const res = await fetch(url, { headers });
    if (!res.ok) throw new ApiError(`${res.status} ${res.statusText}`, res.status);
    const blob = await res.blob();
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  },
};
