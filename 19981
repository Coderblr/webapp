#!/usr/bin/env python
"""Create the schema and seed transaction 9750 as a system prerequisite.

    python scripts/init_db.py
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from backend.core import db  # noqa: E402
from backend.core.config import settings  # noqa: E402
from backend.core.logging_conf import configure_logging, get_logger  # noqa: E402
from backend.knowledge import repository as repo  # noqa: E402

configure_logging()
log = get_logger("init_db")


def main() -> int:
    log.info("Applying schema to %s ...", settings.sqlite_db_path)
    db.init_schema()

    health = db.healthcheck()
    if not health.get("connected"):
        log.error("Database not reachable: %s", health.get("error"))
        return 1
    log.info("Connected: %s", health.get("version"))

    existing = repo.get_transaction(settings.password_change_transaction)
    if not existing:
        repo.create_transaction(
            transaction_id=settings.password_change_transaction,
            name="Mandatory Password Change",
            version="1.0",
            transaction_type="system_prerequisite",
            description=(
                "Forced Change Password window. Recorded once and attached "
                "automatically as a pre-step to every other transaction."
            ),
            status="draft",
            tags=["system", "prerequisite"],
        )
        log.info("Seeded transaction %s as a system prerequisite (status=draft "
                 "— record it once to activate).",
                 settings.password_change_transaction)
    else:
        log.info("Transaction %s already present (%s).",
                 settings.password_change_transaction, existing["status"])

    log.info("Done. Start the platform with:  python run.py")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
