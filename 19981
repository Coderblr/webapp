@app.put("/api/recordings/{recording_id}/steps/{step_number}")
def update_step(recording_id: str, step_number: int, req: UpdateStepRequest, request: Request) -> Dict[str, Any]:
    if not recording_store.exists(recording_id):
        raise HTTPException(404, "Recording not found")
