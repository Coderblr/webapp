"""
event_listener.py

Wraps bridge.js's document-level (capture-phase) event listeners, and
translates the raw browser events it queues into the platform's generic
ActionType vocabulary (CLICK, TYPE, SELECT, CHECK, ... - see
storage/models.py). This is the module that makes "manual recording"
possible: the user just uses the app normally in the Selenium-controlled
browser, and every meaningful interaction is captured here.
"""
from __future__ import annotations

from typing import Any, Dict, List, Optional

from selenium.webdriver.remote.webdriver import WebDriver

from backend.recorder import js_bridge
from backend.storage.models import ActionType

# Raw JS event type -> platform ActionType. Some JS event types (e.g.
# "typing") are transient/debounced signals used only to build up live
# "typing in progress" UI feedback; the *committed* value arrives via the
# "type"/"change" event and is what actually becomes an ActionRecord.
_TYPE_MAP: Dict[str, str] = {
    "click": ActionType.CLICK,
    "dblclick": ActionType.DOUBLE_CLICK,
    "contextmenu": ActionType.RIGHT_CLICK,
    "type": ActionType.TYPE,
    "select": ActionType.SELECT,
    "check": ActionType.CHECK,
    "uncheck": ActionType.UNCHECK,
    "hover": ActionType.HOVER,
    "scroll": ActionType.SCROLL,
    "submit": ActionType.SUBMIT,
    "press_enter": ActionType.PRESS_ENTER,
    "press_tab": ActionType.PRESS_TAB,
    # Capture -> Store -> Reuse (see recorder.py's correlation logic): the
    # user copying a value off the screen (Ctrl+C on a system-generated
    # application ID / reference number / OTP) is the signal that this
    # value must be re-read live at execution time, not replayed as a
    # stale recorded literal.
    "copy": ActionType.CAPTURE,
    # A file input's own `.value` is always a browser-redacted fake path -
    # bridge.js records this as its own event (with an explicit
    # PROVIDE_FILE_PATH placeholder) rather than letting it fall into the
    # generic "type" case, which used to silently record a non-functional
    # value that looked fine during recording but did nothing on replay.
    "upload": ActionType.UPLOAD,
}

# Raw events we intentionally do NOT turn into standalone ActionRecords
# (too noisy / superseded by a "committed" event later).
_IGNORED_RAW_TYPES = {"typing", "keydown"}


def start(driver: WebDriver) -> None:
    js_bridge.call(driver, "window.__UA__.startEventListeners(); return true;")


def drain(driver: WebDriver) -> List[Dict[str, Any]]:
    try:
        return js_bridge.call(driver, "return window.__UA__.drainEvents();") or []
    except Exception:
        return []


def to_action_type(raw_type: str) -> Optional[str]:
    if raw_type in _IGNORED_RAW_TYPES:
        return None
    return _TYPE_MAP.get(raw_type)
