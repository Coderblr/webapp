"""
Turns the raw locator candidates captured by the injected JS into an
ordered, deduplicated list of (strategy, value) pairs that the generated
Page Object will try in order at runtime. Keeping multiple strategies per
element (instead of a single selector) is what makes the recorded tests
resilient - if the top strategy breaks (e.g. an id gets removed), the
page object automatically falls back to the next one before ever
resorting to the self-healing agent.
"""
from __future__ import annotations
import re
from typing import List, Dict

# Highest priority first. "note" hints are used to break ties when two
# candidates share the same locator strategy.
PRIORITY = [
    ("CSS", "data-testid"),
    ("ID", None),
    ("NAME", None),
    ("CSS", "aria-label"),
    ("CSS", "placeholder"),
    ("XPATH", "text"),
    ("CSS", "generated-path"),
    ("XPATH", "generated-path"),
]

# Ids that LOOK author-assigned (e.g. id="submit-button") are a great, stable
# locator. Ids that look like they were auto-generated by a framework's
# internal counter are NOT - the same element can get a different id on the
# next page load depending on everything else rendered before it, which is
# exactly what breaks replay for e.g. Angular Material's
# id="mat-radio-9-input" or React 18's useId() ids like ":r1a:". These are
# deprioritized (tried LAST, after even the generated CSS/XPath path)
# instead of trusted as a top-priority strategy the way a real id normally
# would be.
_UNSTABLE_ID_PATTERNS = [
    re.compile(r"^mat-[\w-]+-\d+(-\w+)?$", re.I),   # Angular Material: mat-radio-9-input, mat-checkbox-3-input
    re.compile(r"^cdk-[\w-]*\d+$", re.I),           # Angular CDK overlay/portal ids
    re.compile(r"^:r[0-9a-z]+:$"),                  # React 18 useId(): :r1a:
    re.compile(r"^ember\d+$", re.I),                # Ember
    re.compile(r"^react-select-\d+-", re.I),        # react-select
    re.compile(r"^mui-\d+$", re.I),                 # MUI
    re.compile(r"^ng-\w+-\d+$", re.I),              # generic Angular-generated
]


def looks_like_unstable_id(value: str) -> bool:
    return any(p.match(value) for p in _UNSTABLE_ID_PATTERNS)


def order_locators(raw_locators: List[Dict]) -> List[Dict]:
    """Sort raw locator candidates by robustness priority and drop exact dupes."""
    seen = set()
    ranked = []
    for pref_strategy, pref_note in PRIORITY:
        for loc in raw_locators:
            if loc["strategy"] != pref_strategy:
                continue
            if pref_note and loc.get("note") != pref_note:
                continue
            if not pref_note and loc.get("note") not in (None, ""):
                continue
            if pref_strategy == "ID" and looks_like_unstable_id(loc["value"]):
                continue  # handled in the deprioritized pass below instead
            key = (loc["strategy"], loc["value"])
            if key in seen:
                continue
            seen.add(key)
            ranked.append(loc)

    # deprioritized: ids that look framework-auto-generated (see above)
    for loc in raw_locators:
        if loc["strategy"] == "ID" and looks_like_unstable_id(loc["value"]):
            key = (loc["strategy"], loc["value"])
            if key not in seen:
                seen.add(key)
                ranked.append(loc)

    # append anything not matched above (shouldn't normally happen)
    for loc in raw_locators:
        key = (loc["strategy"], loc["value"])
        if key not in seen:
            seen.add(key)
            ranked.append(loc)
    return ranked


def suggest_element_name(action_record: Dict, used_names: set) -> str:
    """Heuristic, LLM-free fallback name generator (used if no LLM key is configured)."""
    el = action_record["element"]
    action = action_record["action"]
    el_type = (el.get("type") or "").lower()

    base = (
        el.get("ariaLabel")
        or el.get("placeholder")
        or el.get("name")
        or el.get("text")
        or el.get("tag")
        or "element"
    )
    slug = "".join(c if c.isalnum() else "_" for c in base.lower()).strip("_")
    slug = "_".join(filter(None, slug.split("_")))[:40] or "element"

    if action == "type" and not slug.endswith("_input"):
        slug += "_input"
    elif action == "select" and not slug.endswith("_dropdown"):
        slug += "_dropdown"
    elif action == "keypress" and not slug.endswith("_field"):
        slug += "_field"
    elif action == "copy" and not slug.endswith("_source"):
        slug += "_source"
    elif action == "paste" and not slug.endswith("_input"):
        slug += "_input"
    elif action == "click":
        if el_type == "radio" and not slug.endswith("_radio"):
            slug += "_radio"
        elif el_type == "checkbox" and not slug.endswith("_checkbox"):
            slug += "_checkbox"
        elif el.get("tag") in ("button", "a") and not slug.endswith("_button"):
            slug += "_button"

    name = slug
    n = 2
    while name in used_names:
        name = f"{slug}_{n}"
        n += 1
    used_names.add(name)
    return name


def selector_for(strategy: str, value: str) -> str:
    """Turns a captured (strategy, value) pair into a Playwright selector
    string - kept behaviorally identical to
    generator/templates/page.tmpl's own _selector_for (duplicated there
    deliberately, so the generated recorded_page.py stays a self-contained
    file with no runtime import dependency on this package). This copy is
    for non-generated, in-process code that needs the same mapping - e.g.
    recorder/recorder.py resolving an element to screenshot for an OCR
    capture request during recording itself."""
    if strategy == "ID":
        return f'css=[id="{value}"]'
    if strategy == "NAME":
        return f'css=[name="{value}"]'
    if strategy == "CSS":
        return f"css={value}"
    if strategy == "XPATH":
        return f"xpath={value}"
    raise ValueError(f"Unknown locator strategy '{strategy}'")
