"""
playwright_executor.py (formerly selenium_executor.py)

Low-level bridge between a single Excel step-row and Playwright. Given a
resolved (locator_type, locator_value) pair, dispatches to the right
ActionEngine method based on the row's Action column. Also implements
Self-Healing Stages 1-2 (try primary locator, then each fallback locator)
since those are cheap/deterministic and don't need the full healing
pipeline in healing/self_healer.py.

Takes a `PlaywrightSession` (see recorder/browser_factory.py) rather than
a bare Page, because a handful of actions (SWITCH_WINDOW, NEW_TAB,
CLOSE_TAB) need to change which Page is "active" for every step after
them - Playwright has no single mutable "current window" the way
Selenium's driver did, so `session.page` IS that piece of mutable state,
updated in place by the tab-management helpers below.
"""
from __future__ import annotations

import logging
import time
from typing import Any, Dict, Optional, Tuple

from playwright.sync_api import Error as PlaywrightError

from backend.config import settings
from backend.execution.action_engine import ActionEngine
from backend.recorder import iframe_handler
from backend.recorder.browser_factory import PlaywrightSession
from backend.recorder.js_bridge import EvaluationContext
from backend.storage.models import ActionType

logger = logging.getLogger("universal_automation.playwright_executor")

# Actions that don't require resolving a locator/frame at all.
_NO_LOCATOR_ACTIONS = (
    ActionType.OPEN_URL, ActionType.WAIT, ActionType.SWITCH_WINDOW,
    ActionType.NEW_TAB, ActionType.CLOSE_TAB, ActionType.NAVIGATE_BACK, ActionType.NAVIGATE_FORWARD,
)


def resolve_frame(session: PlaywrightSession, step: Dict[str, Any]) -> Optional[EvaluationContext]:
    """Resolves the exact Frame/Page a step's element lives in from its
    recorded FramePath, starting from the current active page. Returns
    None if any segment of the path can no longer be resolved (e.g. the
    iframe no longer exists) - the caller treats that as a locator
    failure, same as before."""
    return iframe_handler.resolve_frame(session.page, step.get("frame_path"))


def _switch_to_latest_page(session: PlaywrightSession) -> None:
    pages = session.context.pages
    if pages:
        session.page = pages[-1]
        try:
            session.page.bring_to_front()
        except PlaywrightError:
            pass


def _wait_for_new_page_or_open_blank(session: PlaywrightSession, timeout: float) -> None:
    """Recorded when the recorder observed the page count go up - almost
    always a side effect of the *previous* step (e.g. clicking a login/SSO
    button that opens a popup), not something deliberately recreated here.
    Waits briefly for the real popup (already triggered by the previous
    step) to actually appear, and only opens a blank tab as a last resort
    if one genuinely never shows up - mirrors the old Selenium version's
    same reasoning, now via Playwright's own page-count/bring_to_front."""
    before = len(session.context.pages)
    deadline = time.time() + timeout
    while len(session.context.pages) <= before and time.time() < deadline:
        time.sleep(0.2)
    if len(session.context.pages) <= before:
        session.page = session.context.new_page()
    else:
        session.page = session.context.pages[-1]
    try:
        session.page.bring_to_front()
    except PlaywrightError:
        pass


def _close_current_page(session: PlaywrightSession) -> None:
    try:
        session.page.close()
    except PlaywrightError:
        pass
    remaining = session.context.pages
    if remaining:
        session.page = remaining[0]


def try_locator(engine: ActionEngine, session: PlaywrightSession, step: Dict[str, Any], locator_type: str, locator_value: str) -> Tuple[bool, str]:
    """Attempts to perform the step's action using a specific locator.
    Returns (success, error_message)."""
    action = step.get("action", "")
    value = step.get("value", "")

    context = None
    if action not in _NO_LOCATOR_ACTIONS:
        context = resolve_frame(session, step)
        if context is None:
            return False, "Unable to resolve the recorded frame hierarchy"

    try:
        if action == ActionType.OPEN_URL:
            session.page.goto(step.get("value") or step.get("page_url"))
        elif action == ActionType.CLICK:
            engine.click(context, locator_type, locator_value)
        elif action == ActionType.DOUBLE_CLICK:
            engine.double_click(context, locator_type, locator_value)
        elif action == ActionType.RIGHT_CLICK:
            engine.right_click(context, locator_type, locator_value)
        elif action == ActionType.TYPE:
            engine.type(context, locator_type, locator_value, value)
        elif action == ActionType.CLEAR:
            engine.clear(context, locator_type, locator_value)
        elif action == ActionType.SELECT:
            # `value` is the recorded option's value ATTRIBUTE (recorder.py
            # prefers it); select_option_text is that same option's visible
            # label, captured separately since the two very often differ
            # in real apps - see action_engine.select() for the fallback
            # chain between them.
            engine.select(context, locator_type, locator_value, option_text=step.get("select_option_text") or None, option_value=value or None)
        elif action == ActionType.CHECK:
            engine.check(context, locator_type, locator_value)
        elif action == ActionType.UNCHECK:
            engine.uncheck(context, locator_type, locator_value)
        elif action == ActionType.HOVER:
            engine.hover(context, locator_type, locator_value)
        elif action == ActionType.SCROLL:
            if locator_value:
                engine.scroll_to(context, locator_type, locator_value)
            else:
                session.page.mouse.wheel(0, 400)
        elif action == ActionType.PRESS_KEY:
            engine.press_key(context, locator_type, locator_value, value or "Tab")
        elif action == ActionType.PRESS_ENTER:
            engine.press_key(context, locator_type, locator_value, "Enter")
        elif action == ActionType.PRESS_TAB:
            engine.press_key(context, locator_type, locator_value, "Tab")
        elif action == ActionType.WAIT:
            time.sleep(float(value) if value else 1.0)
        elif action == ActionType.SUBMIT:
            engine.submit(context, locator_type, locator_value)
        elif action == ActionType.UPLOAD:
            engine.upload(context, locator_type, locator_value, value)
        elif action == ActionType.SWITCH_FRAME:
            pass  # frame context is resolved per-step from frame_path already; nothing further to do
        elif action == ActionType.SWITCH_WINDOW:
            _switch_to_latest_page(session)
        elif action == ActionType.NEW_TAB:
            _wait_for_new_page_or_open_blank(session, engine.timeout)
        elif action == ActionType.CLOSE_TAB:
            _close_current_page(session)
        elif action == ActionType.NAVIGATE_BACK:
            engine.navigate_back(session.page)
        elif action == ActionType.NAVIGATE_FORWARD:
            engine.navigate_forward(session.page)
        elif action == ActionType.CAPTURE:
            # Capture -> Store -> Reuse (see execution/variable_store.py):
            # stash the result on the step dict itself rather than
            # widening this function's (success, error) return contract -
            # `step` is already a fresh per-step dict by the time it
            # reaches here (Executor._run_step builds one per step), so
            # this is a safe, local side channel the caller reads right
            # after this call returns.
            step["_captured_value"] = engine.read_current_text(context, locator_type, locator_value)
        else:
            return False, f"Unknown action type: {action}"
        return True, ""
    except PlaywrightError as exc:
        return False, f"{type(exc).__name__}: {str(exc)[:300]}"


def execute_with_fallbacks(engine: ActionEngine, session: PlaywrightSession, step: Dict[str, Any]) -> Dict[str, Any]:
    """Self-healing Stage 1 + Stage 2: try the primary locator, then each
    fallback locator in order. Returns a dict describing the outcome,
    including which locator ultimately worked (if any) so the caller can
    decide whether a "soft heal" (fallback promoted to primary) is
    warranted."""
    action = step.get("action", "")
    if action in _NO_LOCATOR_ACTIONS:
        ok, err = try_locator(engine, session, step, step.get("primary_locator_type", ""), step.get("primary_locator", ""))
        return {"success": ok, "locator_type": step.get("primary_locator_type", ""), "locator_value": step.get("primary_locator", ""), "stage": "direct", "error": err}

    primary_type = step.get("primary_locator_type", "")
    primary_value = step.get("primary_locator", "")
    if primary_type and primary_value:
        ok, err = try_locator(engine, session, step, primary_type, primary_value)
        if ok:
            return {"success": True, "locator_type": primary_type, "locator_value": primary_value, "stage": "primary", "error": ""}
        last_error = err
    else:
        last_error = "No primary locator recorded"

    fallback_locators = step.get("fallback_locators", [])
    if fallback_locators:
        # See FALLBACK_WAIT_SECONDS in config.py: the primary attempt above
        # already burned a full EXPLICIT_WAIT_SECONDS finding nothing, so
        # each fallback gets a short, separate timeout instead of another
        # full wait apiece.
        original_timeout = engine.timeout
        engine.timeout = min(engine.timeout, settings.FALLBACK_WAIT_SECONDS)
        try:
            for fb in fallback_locators:
                ok, err = try_locator(engine, session, step, fb.get("type", ""), fb.get("value", ""))
                if ok:
                    return {"success": True, "locator_type": fb.get("type", ""), "locator_value": fb.get("value", ""), "stage": "fallback", "error": ""}
                last_error = err
        finally:
            engine.timeout = original_timeout

    return {"success": False, "locator_type": primary_type, "locator_value": primary_value, "stage": "exhausted", "error": last_error}
