@app.post("/api/change-plans/{plan_id}/apply")
async def apply_change_plan_item(
    plan_id: str,
    application: str,
    item_id: str,
    request: Request,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Apply ONE approved change plan item to its recording.
    Creates a new version before applying. Never modifies unapproved items."""
    app_access.require_application_access(current_user, application, "edit")
    from solution_analyzer.service import load_change_plan, save_change_plan
    from solution_analyzer.change_engine import ChangeEngine, ChangeError
    from solution_analyzer.models import ChangePlanItemModel
    from datetime import datetime, timezone

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    item_data = next((i for i in plan["items"] if i["item_id"] == item_id), None)
    if item_data is None:
        raise HTTPException(status_code=404, detail="Item not found in change plan")
    if item_data["approval_status"] != "APPROVED":
        raise HTTPException(
            status_code=400,
            detail="Item must be APPROVED before it can be applied."
        )
    if item_data.get("applied"):
        raise HTTPException(status_code=400, detail="Item has already been applied.")

    with get_session() as session:
        engine = ChangeEngine(session, current_user)
        try:
            item_model = ChangePlanItemModel(**item_data)
            result = await asyncio.to_thread(
                engine.apply_item, item_model, plan.get("cr_number")
            )
        except ChangeError as e:
            raise HTTPException(status_code=422, detail=str(e))
        except Exception as e:
            logger.exception("Change application failed for plan %s item %s", plan_id, item_id)
            raise HTTPException(status_code=500, detail=f"Apply failed: {e}")

    # Update plan item
    now = datetime.now(timezone.utc).isoformat()
    for item in plan["items"]:
        if item["item_id"] == item_id:
            item["applied"] = True
            item["applied_at"] = now
            item["new_version_number"] = result.get("new_version")
            item["diff_before"] = result.get("diff", {}).get("changed_steps")
            item["diff_after"] = result.get("diff", {})
            item["validation_status"] = "NOT_RUN"
            break

    all_applied = all(
        i.get("applied") or i.get("approval_status") == "REJECTED"
        for i in plan["items"]
    )
    if all_applied:
        plan["status"] = "APPLIED"

    save_change_plan(plan, application)

    ip = get_client_ip(request)
    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id,
            action="CHANGE_APPLIED", status="SUCCESS",
            details={"plan_id": plan_id, "item_id": item_id, "new_version": result.get("new_version")},
            endpoint=f"/api/change-plans/{plan_id}/apply", ip_address=ip,
        )
    return {**plan, "apply_result": result}


