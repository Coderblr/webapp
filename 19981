"""
Takes a raw recording (list of actions from recorder.Recorder) and produces:
  - output/features/recorded.feature
  - output/features/steps/recorded_steps.py
  - output/features/environment.py   (copied static file, see runner/environment.py)
  - output/pages/recorded_page.py
  - output/pages/locators.json

This is deterministic scaffolding; the only place an LLM is optionally
consulted is agent/step_namer.py (naming elements + phrasing steps).
"""
from __future__ import annotations
import base64
import json
import logging
import math
import re
import shutil
from pathlib import Path
from datetime import datetime

from jinja2 import Environment, FileSystemLoader

from recorder.locator_strategy import order_locators
from agent.step_namer import name_step, key_label

logger = logging.getLogger(__name__)

TEMPLATES_DIR = Path(__file__).parent / "templates"
ROOT = Path(__file__).parent.parent

# Floor for the measured recording-to-recording wait, so two actions that
# happened to be recorded a fraction of a second apart don't generate an
# unrealistically tight timeout.
MIN_WAIT_SECONDS = 5
# Used when no timing data is available at all (e.g. a hand-built recording).
DEFAULT_WAIT_SECONDS = 10


def build_artifacts(recording: dict, llm=None, output_dir: str = "output", mask_passwords: bool = True) -> dict:
    out = Path(output_dir)
    (out / "features" / "steps").mkdir(parents=True, exist_ok=True)
    (out / "pages").mkdir(parents=True, exist_ok=True)
    (out / "fixtures").mkdir(parents=True, exist_ok=True)

    target_url = recording["target_url"]
    actions = recording["actions"]

    # Best-effort: merge same-element 'type' actions that fired within a
    # short window of each other (see coalesce_consecutive_types's docstring)
    # in case this recording predates that fix, or was regenerated from a
    # previously-saved recording. Runs BEFORE variable annotation below so
    # {{var}} correlation sees the final, de-duplicated values.
    try:
        from recorder.variable_capture import coalesce_consecutive_types
        actions = coalesce_consecutive_types(actions)
    except Exception:
        pass

    # Best-effort: derive/refresh the Capture -> Store -> Reuse {{var}} metadata
    # (see recorder/variable_capture.py) in case this recording was produced
    # before that hook existed in Recorder.stop(), or was built by hand. Safe
    # to call even if it already ran - it's idempotent.
    try:
        from recorder.variable_capture import annotate_variables
        actions = annotate_variables(actions)
    except Exception:
        pass

    # Materialize any file(s) actually uploaded during recording into
    # output/fixtures/ under their original name (see recorder_injector.js's
    # file_upload handling) - this is what lets a tester upload literally
    # any file, with any name, and have replay just work with no manual
    # "go copy the file into fixtures/" step. Only skipped when a file was
    # too large to have been captured inline (see MAX_INLINE_BYTES in the
    # injector) or predates this feature - BasePage.upload_file()'s
    # FileNotFoundError message tells the user exactly what to do in that
    # fallback case.
    for action in actions:
        if action.get("action") != "file_upload":
            continue
        b64 = action.get("fileDataBase64")
        file_name = action.get("value")
        if not b64 or not file_name:
            continue
        try:
            file_bytes = base64.b64decode(b64)
            # Strip any path-like characters from the recorded name before
            # using it as a filename - defense in depth, since this is
            # ultimately attacker-controllable browser-reported input.
            # Deliberately NOT just Path(file_name).name: that only splits
            # on the CURRENT platform's separator - on Linux, a Windows-
            # style "C:\fakepath\name.pdf" string (exactly what a real
            # recorded file_upload value looks like, per
            # recorder_injector.js) has no "/" in it at all, so .name
            # would return the WHOLE fake path unchanged, not just the
            # filename. Splitting on both slash characters explicitly
            # works the same regardless of which OS actually runs this.
            safe_name = re.split(r"[\\/]", file_name)[-1] or "uploaded_file"
            (out / "fixtures" / safe_name).write_bytes(file_bytes)
        except Exception:
            # Corrupt/partial base64, disk issue, etc. - don't fail the
            # whole build over one file; upload_file()'s own error message
            # at replay time will make the problem obvious if it matters.
            pass

    used_names = set()
    steps = []
    locators_map = {}
    # element_name -> visible text/aria-label, for BasePage._ocr_click_fallback
    # (page.tmpl) - a last-resort, no-DOM-selector-required fallback for
    # click() when every locator candidate fails. Kept separate from
    # locators_map (not merged in until locators.json is written below) so
    # it never leaks into element_names -> the per-element click_X()/type_X()
    # convenience methods page.tmpl generates at the bottom of the file.
    ocr_hints = {}
    prev_ts = None

    # Tracks which browser tab/window index (0 = the one the recording
    # started on) replay currently considers "active", as we walk the
    # recording in order - lets each real interactive step know whether it
    # needs to switch tabs/windows first (see step["switch_to_page"] below),
    # and lets a "new_window"/"window_closed" synthetic action fold its
    # effect into the step it belongs with instead of needing its own.
    current_page_index = 0

    # Parallel to `actions` (NOT to `steps` - a "new_window" action folds
    # into the PRECEDING step and produces no step of its own, so the two
    # lists can differ in length) - used for the Excel report below, which
    # needs one label per ACTION, including the synthetic ones.
    excel_labels = []

    for action in actions:
        kind = action["action"]
        page_index = action.get("page_index", 0)
        frame_path = action.get("frame_path") or []

        # Explicit wait: how long the app actually took, during recording, to
        # reach the state this action needed (i.e. the gap between the
        # previous recorded action and this one) - so a step that recorded
        # slow (e.g. a 50s dashboard load) gets a matching wait_ready()
        # timeout, while a fast one doesn't sit around waiting needlessly.
        # Computed here (before the branches below) so it's available for
        # synthetic popup/dialog/window actions too, not just the "normal"
        # interactive ones further down.
        ts = action.get("ts")
        if prev_ts is None or ts is None:
            wait_seconds = DEFAULT_WAIT_SECONDS
        else:
            wait_seconds = max(MIN_WAIT_SECONDS, math.ceil((ts - prev_ts) / 1000.0))
        if ts is not None:
            prev_ts = ts

        # --- popup / new tab / new window --------------------------------
        # Doesn't get its own replay step: Playwright can only reliably
        # catch a new page by wrapping the ACTION THAT CAUSED IT in
        # context.expect_page() (see steps.tmpl's new_page_wrapper macro),
        # so this folds forward onto the step that was just appended
        # (almost always the click that opened it) instead. If this is
        # somehow the very first action in the whole recording (no
        # preceding step to fold onto - e.g. the app pops a window
        # immediately on load), falls back to a standalone step that just
        # waits for one to appear.
        if kind == "new_window":
            if steps:
                steps[-1]["opens_new_page"] = True
                steps[-1]["new_page_index"] = page_index
            else:
                steps.append({
                    "action": "new_window_wait",
                    "element_name": None,
                    "step_phrase": "waits for a new browser tab or window to open",
                    "wait_seconds": wait_seconds,
                    "new_page_index": page_index,
                })
            current_page_index = page_index
            excel_labels.append(f"(new browser tab/window #{page_index} opens)")
            continue

        # --- tab/window closed --------------------------------------------
        if kind == "window_closed":
            opener_index = action.get("opener_page_index", 0) or 0
            steps.append({
                "action": "window_closed",
                "element_name": None,
                "step_phrase": "closes the browser tab or window",
                "wait_seconds": wait_seconds,
                "closed_page_index": page_index,
                "switch_back_to_index": opener_index,
            })
            current_page_index = opener_index
            excel_labels.append(f"(browser tab/window #{page_index} closed)")
            continue

        # --- native alert/confirm/prompt/beforeunload dialog --------------
        if kind == "dialog":
            steps.append({
                "action": "dialog",
                "element_name": None,
                "step_phrase": "handles a browser dialog",
                "wait_seconds": wait_seconds,
                "dialog_type": action.get("dialog_type") or "alert",
                "dialog_message": action.get("value") or "",
            })
            excel_labels.append(f"(dialog: {action.get('dialog_type') or 'alert'})")
            continue

        # --- explicit delay/pause (e.g. imported from a UiPath-style Excel
        # flow's DELAY step - see generator/uipath_importer.py) - a plain
        # wait with no element/locator involved at all.
        if kind == "delay":
            delay_seconds = float(action.get("value") or 1)
            steps.append({
                "action": "delay",
                "element_name": None,
                "step_phrase": f"waits {delay_seconds:g} seconds",
                "wait_seconds": 0,  # the delay IS the wait - don't also apply the normal inter-step timing heuristic
                "delay_seconds": delay_seconds,
            })
            excel_labels.append(f"(delay {delay_seconds:g}s)")
            continue

        # --- page scroll (e.g. imported from a UiPath-style Excel flow's
        # SCROLL step - "DOWN-4"/"UP-2" etc., direction + a rough
        # magnitude - see generator/uipath_importer.py) - no element
        # involved, scrolls the whole page/viewport.
        if kind == "scroll":
            steps.append({
                "action": "scroll",
                "element_name": None,
                "step_phrase": f"scrolls {action.get('scroll_direction', 'down')}",
                "wait_seconds": wait_seconds,
                "scroll_direction": action.get("scroll_direction", "down"),
                "scroll_amount": int(action.get("scroll_amount", 1)),
            })
            excel_labels.append(f"(scroll {action.get('scroll_direction', 'down')})")
            continue

        # --- text assertion (e.g. imported from a UiPath-style Excel
        # flow's VERIFICATION step - see generator/uipath_importer.py) -
        # checks that an element's text/value contains the expected
        # string, without clicking/typing anything. Needs its own branch
        # (not the generic name_step() path below) because it's a pure
        # check, not an interactive action - there's no "value that was
        # typed", just an expected value to compare against.
        if kind == "assert_text":
            ordered = order_locators(action.get("locators") or [])
            # name_step() is intentionally never called for this action -
            # it's tuned for interactive elements (buttons,
            # inputs) and would produce a misleading name/phrase for a
            # pure assertion target. A plain, predictable name based on
            # the expected text is clearer to read in the generated code.
            base_name = re.sub(r"[^a-z0-9]+", "_", (action.get("value") or "assertion").lower()).strip("_") or "assertion"
            element_name = f"{base_name}_check"
            n = 2
            while element_name in locators_map or element_name in used_names:
                element_name = f"{base_name}_check_{n}"
                n += 1
            used_names.add(element_name)
            locators_map[element_name] = [
                {"strategy": l["strategy"], "value": l["value"], "frame_path": frame_path} for l in ordered
            ]
            switch_to_page = page_index != current_page_index
            current_page_index = page_index
            steps.append({
                "action": "assert_text",
                "element_name": element_name,
                "step_phrase": None,
                "wait_seconds": wait_seconds,
                "expected_text": action.get("value") or "",
                "page_index": page_index,
                "switch_to_page": switch_to_page,
                "opens_new_page": False,
                "new_page_index": None,
            })
            excel_labels.append(element_name)
            continue

        # --- OCR/visual text assertion - page-level, no DOM element/locator
        # at all (unlike assert_text above, which needs one). Verifies text
        # is visibly present SOMEWHERE on screen via OCR - for content with
        # no DOM node to check in the first place (canvas-rendered text,
        # image-based labels, scanned/embedded content). See
        # generator/templates/page.tmpl's BasePage.assert_ocr_text_visible.
        if kind == "assert_ocr_text":
            switch_to_page = page_index != current_page_index
            current_page_index = page_index
            expected_text = action.get("value") or ""
            steps.append({
                "action": "assert_ocr_text",
                "element_name": None,  # deliberately no locators_map entry - nothing to select, see docstring above
                "step_phrase": None,
                "wait_seconds": wait_seconds,
                "expected_text": expected_text,
                "page_index": page_index,
                "switch_to_page": switch_to_page,
                "opens_new_page": False,
                "new_page_index": None,
            })
            excel_labels.append(f"(OCR assertion: {expected_text})")
            continue

        # --- OCR capture (right-click on the page -> "Capture text with
        # OCR" - see recorder_injector.js's showOcrMenu and
        # recorder.py's _process_ocr_request). Needs its own branch (not
        # the generic name_step() path below) because its replay behavior
        # is fundamentally different from a normal "copy" capture -
        # screenshot + OCR, not a DOM/clipboard read - and it deserves its
        # own clearly distinct step wording rather than reusing "captures
        # the value of..." in a way that would misleadingly suggest a
        # plain DOM read. Still needs a real locator (to know what to
        # screenshot at replay time), so it's NOT folded away like
        # new_window/dialog are.
        if kind == "ocr_capture":
            var_name = action.get("captured_as") or "ocr_value"
            element_name = f"{var_name}_ocr_target"
            n = 2
            while element_name in locators_map or element_name in used_names:
                element_name = f"{var_name}_ocr_target_{n}"
                n += 1
            used_names.add(element_name)
            ordered = order_locators(action.get("locators") or [])
            locators_map[element_name] = [
                {"strategy": l["strategy"], "value": l["value"], "frame_path": frame_path} for l in ordered
            ]
            switch_to_page = page_index != current_page_index
            current_page_index = page_index
            steps.append({
                "action": "ocr_capture",
                "element_name": element_name,
                "step_phrase": None,
                "wait_seconds": wait_seconds,
                "var_name": var_name,
                "var_placeholder": "{{" + var_name + "}}",
                "var_placeholder_escaped": "{{{{" + var_name + "}}}}",
                "page_index": page_index,
                "switch_to_page": switch_to_page,
                "opens_new_page": False,
                "new_page_index": None,
            })
            excel_labels.append(element_name)
            continue

        # --- normal interactive action -------------------------------------
        naming = name_step(llm, action, used_names)
        element_name = naming["element_name"]
        ordered = order_locators(action["locators"])
        locators_map[element_name] = [
            {"strategy": l["strategy"], "value": l["value"], "frame_path": frame_path} for l in ordered
        ]
        is_keypress = action["action"] == "keypress"
        key_name = action.get("value") if is_keypress else None

        # If this action happened on a different tab/window than the one
        # replay currently has "active", the generated step needs to switch
        # to it FIRST (see steps.tmpl's maybe_switch macro) - covers both
        # continuing in a just-opened popup and coming back to the original
        # window after closing one.
        switch_to_page = page_index != current_page_index
        current_page_index = page_index

        # Capture -> Store -> Reuse: "copy" actions get the derived variable
        # name they were captured as; "paste"/"type" actions get the variable
        # name they were correlated to (if their recorded value matched an
        # earlier copy). Both drive a {{name}} placeholder used in the
        # generated feature/steps text and resolved live at playback time
        # (see runner/variables.py) instead of a hard-coded literal.
        var_name = None
        if action["action"] == "copy":
            var_name = action.get("captured_as")
        elif action["action"] in ("paste", "type"):
            var_name = action.get("resolved_var")
        var_placeholder = "{{" + var_name + "}}" if var_name else None
        if not var_name and action["action"] == "paste" and action.get("correlation_status") == "unresolved":
            logger.warning(
                "Recording '%s': paste on '%s' could not be correlated to an earlier COPY action - "
                "the generated test will replay the value recorded at capture time (%r) instead of a "
                "live runtime value.",
                recording.get("recording_name", "?"), element_name, action.get("value"),
            )
        # behave matches step text with the `parse` library, which treats "{{" / "}}"
        # in a @when(...) pattern as escaped literal single braces (str.format()-style) -
        # so the DECORATOR needs 4 braces to literally match the feature file's 2-brace
        # "{{name}}" text. Only the decorator pattern needs this; the runtime code that
        # builds/resolves the value uses var_placeholder as-is.
        var_placeholder_escaped = "{{{{" + var_name + "}}}}" if var_name else None

        # Radio/checkbox clicks are recorded with the RESULTING checked state
        # as their value (see recorder_injector.js's click listener) - route
        # these to an explicit "toggle" step (Playwright's idempotent
        # check()/uncheck() via BasePage.set_checked) instead of a plain
        # click, so replay sets the exact recorded state instead of blindly
        # toggling - a blind click is what risked a double-toggle if an
        # earlier click fallback tier actually succeeded before a later
        # tier ran anyway, and it can't tell "already correct" from "needs
        # a click" the way an explicit target state can.
        element_type = (action.get("element") or {}).get("type", "")
        is_toggle = action["action"] == "click" and element_type in ("radio", "checkbox")
        checked_value = bool(action.get("value")) if is_toggle else None

        # OCR fallback hint (see generator/templates/page.tmpl's
        # BasePage._ocr_click_fallback) - only for a plain click(), since
        # that's the only action with an OCR-coordinate fallback (toggles
        # go through set_checked(), not click()). Recorded from whatever
        # visible text/aria-label the element had, so replay can click by
        # SCREEN TEXT as a last resort if every DOM locator candidate
        # fails - the only way a canvas/image-button click (no real DOM
        # node to select at all) could ever be recovered.
        if action["action"] == "click" and not is_toggle:
            hint_text = ((action.get("element") or {}).get("text") or (action.get("element") or {}).get("ariaLabel") or "").strip()
            if hint_text:
                ocr_hints[element_name] = hint_text

        steps.append({
            "action": "toggle" if is_toggle else action["action"],
            "element_name": element_name,
            "value": action.get("value") or "",
            "checked_value": checked_value,
            "step_phrase": naming["step_phrase"],
            # Only set for "keypress" actions - the recorded key (e.g. "ENTER", "ARROW_DOWN",
            # "CTRL+A") and its human-readable label, used by feature.tmpl/steps.tmpl to
            # generate a step per key rather than assuming Enter.
            "key_name": key_name,
            "key_label": key_label(key_name) if key_name else None,
            # Only set when this action is part of a Capture -> Store -> Reuse chain.
            "var_name": var_name,
            "var_placeholder": var_placeholder,
            "var_placeholder_escaped": var_placeholder_escaped,
            # Explicit wait timeout (seconds) measured from the recording -
            # see BasePage.wait_ready in page.tmpl / steps.tmpl.
            "wait_seconds": wait_seconds,
            # Popup/new-tab/new-window support (see comments above) - which
            # tab/window this action runs on, whether the step needs to
            # switch to it first, and whether IT is the action that causes a
            # new tab/window to open (set retroactively above when a later
            # "new_window" action is folded onto this one).
            "page_index": page_index,
            "switch_to_page": switch_to_page,
            "opens_new_page": False,
            "new_page_index": None,
        })
        excel_labels.append(element_name)

    env = Environment(loader=FileSystemLoader(str(TEMPLATES_DIR)), trim_blocks=True, lstrip_blocks=True)

    def pyesc(value):
        """Escapes a value for safe embedding inside a double-quoted Python
        string literal in generated code (steps.tmpl). Plain interpolation
        of a raw value is unsafe: a backslash (e.g. a Windows file-upload
        path like C:\\fakepath\\image (55).png - see the new "file_upload"
        action) gets reinterpreted as a Python escape sequence when the
        generated .py file is parsed - \\f silently becomes an actual
        form-feed character, which then no longer matches the plain-text
        version of the same value in the .feature file, and behave reports
        the step as undefined. Escaping backslashes and double quotes up
        front keeps the parsed Python string identical to the original
        recorded value."""
        return str(value).replace("\\", "\\\\").replace('"', '\\"')

    env.filters["pyesc"] = pyesc

    feature_text = env.get_template("feature.tmpl").render(
        scenario_name="Recorded transaction",
        recorded_at=recording.get("recorded_at", datetime.now().isoformat()),
        target_url=target_url,
        steps=steps,
    )
    steps_text = env.get_template("steps.tmpl").render(steps=steps)
    page_text = env.get_template("page.tmpl").render(element_names=list(locators_map.keys()))

    (out / "features" / "recorded.feature").write_text(feature_text)
    (out / "features" / "steps" / "recorded_steps.py").write_text(steps_text)
    (out / "pages" / "recorded_page.py").write_text(page_text)
    # "__ocr_hints__" is a sibling key, not a real element - kept out of
    # locators_map itself throughout the loop above so it never appears in
    # element_names (the per-element click_X()/type_X() methods page.tmpl
    # generates). BasePage.__init__ pops it back off on load.
    locators_payload = {**locators_map, "__ocr_hints__": ocr_hints}
    (out / "pages" / "locators.json").write_text(json.dumps(locators_payload, indent=2))

    # environment.py is static (Playwright browser setup/teardown) - copy it in
    env_src = ROOT / "runner" / "environment.py"
    if env_src.exists():
        shutil.copy(env_src, out / "features" / "environment.py")

    (out / "pages" / "__init__.py").touch()

    excel_path = None
    try:
        # imported lazily (not at module load time) so a missing/broken
        # pandas or openpyxl install - or a stale extraction missing this
        # file - degrades to "no Excel report" instead of crashing the
        # whole backend at startup.
        from generator.excel_export import build_excel_report
        excel_path = build_excel_report(
            recording,
            element_names=excel_labels,
            output_path=str(out / "recorded_steps.xlsx"),
            mask_passwords=mask_passwords,
            actions=actions,
        )
    except Exception as e:
        print(f"[warning] Skipped Excel report ({type(e).__name__}: {e}). "
              f"Feature/steps/page files were still generated normally.")

    return {
        "feature_file": str(out / "features" / "recorded.feature"),
        "steps_file": str(out / "features" / "steps" / "recorded_steps.py"),
        "page_file": str(out / "pages" / "recorded_page.py"),
        "locators_file": str(out / "pages" / "locators.json"),
        "excel_report": excel_path,
        "element_count": len(locators_map),
        "step_count": len(steps),
    }
