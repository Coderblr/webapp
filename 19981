import { useEffect, useState } from "react";
import { recordingsApi } from "@/lib/api";
import { Panel, Disclosure, Callout, Spinner, Button, Field, TextInput, Select } from "@/components/ui";

const ACTION_LABELS = {
  click: "Click",
  type: "Type text",
  select: "Select dropdown option",
  keypress: "Press a key",
  delay: "Wait / delay",
  scroll: "Scroll page",
  window_closed: "Close current tab/window",
  assert_text: "Verify text is shown",
  file_upload: "Upload a file",
  copy: "Capture a value",
  ocr_capture: "Capture a value (OCR)",
};

// Which fields the Add/Edit form actually needs, per action type - keeps
// the form from showing a "Value" box for a scroll step or a "Direction"
// dropdown for a click, which would just be confusing clutter.
const NEEDS_SELECTOR = new Set(["click", "type", "select", "assert_text", "file_upload", "copy", "ocr_capture"]);
const NEEDS_VALUE = new Set(["type", "select", "assert_text", "file_upload"]);

function blankForm() {
  return {
    action: "click", label: "", value: "", locators: [], scroll_direction: "down", scroll_amount: 1,
    delay_seconds: 1, captured_as: "", selectorText: "",
  };
}

function summarizeLocators(locators) {
  if (!locators || locators.length === 0) return "(no selector)";
  const first = locators[0];
  const extra = locators.length > 1 ? ` (+${locators.length - 1} more)` : "";
  return `${first.strategy}: ${first.value}${extra}`;
}

/**
 * Lets someone add, delete, reorder, and edit any step in a saved
 * recording directly - so a small change (a value, a step order, a new
 * field on the form) doesn't require re-exporting/re-importing the whole
 * UiPath spreadsheet every time. Selectors are entered the SAME way the
 * Excel importer reads them - paste a <webctrl .../> snippet and it's
 * parsed into real locators (see /api/recordings/parse_selector) - so
 * this doesn't ask anyone to hand-write CSS/XPath.
 */
export default function StepEditor({ recordingFile, onSaved }) {
  const [steps, setSteps] = useState([]);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [loadError, setLoadError] = useState(null);
  const [notice, setNotice] = useState(null);

  const [editingIndex, setEditingIndex] = useState(null); // null = closed, -1 = adding, N = editing step N
  const [form, setForm] = useState(blankForm());
  const [parsing, setParsing] = useState(false);
  const [parseNotice, setParseNotice] = useState(null);

  useEffect(() => {
    if (recordingFile) load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [recordingFile]);

  async function load() {
    setLoading(true);
    setLoadError(null);
    setEditingIndex(null);
    try {
      const r = await recordingsApi.getSteps(recordingFile);
      setSteps(r.steps);
    } catch (e) {
      setLoadError(e.detail || e.message);
    } finally {
      setLoading(false);
    }
  }

  function startAdd() {
    setForm(blankForm());
    setParseNotice(null);
    setEditingIndex(-1);
  }

  function startEdit(i) {
    setForm({ ...blankForm(), ...steps[i], selectorText: "" });
    setParseNotice(null);
    setEditingIndex(i);
  }

  function cancelForm() {
    setEditingIndex(null);
  }

  function deleteStep(i) {
    if (!window.confirm(`Delete step ${i + 1} (${ACTION_LABELS[steps[i].action] || steps[i].action})?`)) return;
    setSteps(steps.filter((_, idx) => idx !== i));
    setNotice({ tone: "info", text: 'Step deleted from the list below - click "Save changes" to make it permanent.' });
  }

  function moveStep(i, delta) {
    const target = i + delta;
    if (target < 0 || target >= steps.length) return;
    const next = [...steps];
    [next[i], next[target]] = [next[target], next[i]];
    setSteps(next);
  }

  async function handleParseSelector() {
    if (!form.selectorText.trim()) return;
    setParsing(true);
    setParseNotice(null);
    try {
      const r = await recordingsApi.parseSelector(form.selectorText);
      if (r.locators.length === 0) {
        setParseNotice({ tone: "error", text: "Could not find a usable selector in that text - check it includes a <webctrl .../> tag." });
        return;
      }
      setForm((f) => ({ ...f, locators: r.locators, label: f.label || r.suggested_label }));
      setParseNotice({ tone: "success", text: `Found ${r.locators.length} locator candidate${r.locators.length > 1 ? "s" : ""} - see below.` });
    } catch (e) {
      setParseNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setParsing(false);
    }
  }

  function saveFormIntoList() {
    if (NEEDS_SELECTOR.has(form.action) && form.locators.length === 0) {
      setParseNotice({ tone: "error", text: "This step type needs a selector - paste one above and click \"Parse selector\" first." });
      return;
    }
    const { selectorText, ...stepData } = form;
    const next = [...steps];
    if (editingIndex === -1) next.push(stepData);
    else next[editingIndex] = stepData;
    setSteps(next);
    setEditingIndex(null);
    setNotice({ tone: "info", text: 'Step added to the list below - click "Save changes" to make it permanent.' });
  }

  async function saveAll() {
    setSaving(true);
    setNotice(null);
    try {
      const r = await recordingsApi.updateSteps(recordingFile, steps);
      setSteps(r.steps);
      setNotice({ tone: "success", text: `Saved - this recording now has ${r.steps.length} steps.` });
      if (onSaved) onSaved();
    } catch (e) {
      setNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setSaving(false);
    }
  }

  return (
    <Panel>
      <div className="px-5 py-4">
        <Disclosure title="Edit steps" defaultOpen>
      <div className="space-y-3">
        <p className="text-xs text-muted">
          Add, delete, reorder, or edit any step here - changes apply once you click &quot;Save changes&quot; below, no
          need to re-import the spreadsheet for a small edit.
        </p>

        {loading && <Spinner label="Loading steps..." />}
        {loadError && <Callout tone="error">Could not load steps: {loadError}</Callout>}

        {!loading && !loadError && (
          <>
            <div className="max-h-96 space-y-1 overflow-y-auto scroll-thin">
              {steps.map((s, i) => (
                <div key={i} className="flex items-center gap-2 rounded-sm border border-line bg-panel px-3 py-2">
                  <span className="w-6 shrink-0 text-xs text-muted">#{i + 1}</span>
                  <div className="min-w-0 flex-1">
                    <div className="truncate text-sm text-ink">
                      <span className="font-medium">{ACTION_LABELS[s.action] || s.action}</span>
                      {s.label ? ` — ${s.label}` : ""}
                      {s.value ? ` = "${s.value}"` : ""}
                    </div>
                    {NEEDS_SELECTOR.has(s.action) && (
                      <div className="truncate font-mono text-xs text-muted">{summarizeLocators(s.locators)}</div>
                    )}
                  </div>
                  <div className="flex shrink-0 items-center gap-1">
                    <button type="button" className="px-1 text-muted hover:text-ink disabled:opacity-30" disabled={i === 0} onClick={() => moveStep(i, -1)} title="Move up">
                      ↑
                    </button>
                    <button type="button" className="px-1 text-muted hover:text-ink disabled:opacity-30" disabled={i === steps.length - 1} onClick={() => moveStep(i, 1)} title="Move down">
                      ↓
                    </button>
                    <button type="button" className="px-2 text-xs font-medium text-brand-blue hover:underline" onClick={() => startEdit(i)}>
                      Edit
                    </button>
                    <button type="button" className="px-2 text-xs font-medium text-signal-rust hover:underline" onClick={() => deleteStep(i)}>
                      Delete
                    </button>
                  </div>
                </div>
              ))}
              {steps.length === 0 && <p className="px-1 py-3 text-sm text-muted">No steps yet - add one below.</p>}
            </div>

            {editingIndex === null && (
              <Button variant="secondary" onClick={startAdd} className="w-full">
                + Add step
              </Button>
            )}

            {editingIndex !== null && (
              <div className="space-y-3 rounded-sm border border-brand-blue/30 bg-brand-blueLight/40 p-3">
                <h4 className="text-sm font-semibold text-ink">{editingIndex === -1 ? "Add a step" : `Edit step ${editingIndex + 1}`}</h4>

                <Field label="Action">
                  <Select value={form.action} onChange={(e) => setForm((f) => ({ ...f, action: e.target.value }))}>
                    {Object.entries(ACTION_LABELS).map(([value, label]) => (
                      <option key={value} value={value}>
                        {label}
                      </option>
                    ))}
                  </Select>
                </Field>

                <Field label="Label (for your own reference)">
                  <TextInput value={form.label} onChange={(e) => setForm((f) => ({ ...f, label: e.target.value }))} placeholder="e.g. Submit button" />
                </Field>

                {NEEDS_VALUE.has(form.action) && (
                  <Field label={form.action === "file_upload" ? "File name (must exist in output/fixtures/)" : form.action === "assert_text" ? "Text expected to appear" : "Value"}>
                    <TextInput value={form.value || ""} onChange={(e) => setForm((f) => ({ ...f, value: e.target.value }))} />
                  </Field>
                )}

                {(form.action === "copy" || form.action === "ocr_capture") && (
                  <Field label="Variable name" hint="Reuse this later as {{name}} in another step's value.">
                    <TextInput value={form.captured_as || ""} onChange={(e) => setForm((f) => ({ ...f, captured_as: e.target.value }))} />
                  </Field>
                )}

                {form.action === "delay" && (
                  <Field label="Seconds to wait">
                    <TextInput
                      type="number"
                      min="0"
                      step="0.5"
                      value={form.delay_seconds}
                      onChange={(e) => setForm((f) => ({ ...f, delay_seconds: parseFloat(e.target.value) || 0 }))}
                    />
                  </Field>
                )}

                {form.action === "scroll" && (
                  <div className="grid grid-cols-2 gap-3">
                    <Field label="Direction">
                      <Select value={form.scroll_direction} onChange={(e) => setForm((f) => ({ ...f, scroll_direction: e.target.value }))}>
                        <option value="down">Down</option>
                        <option value="up">Up</option>
                      </Select>
                    </Field>
                    <Field label="Amount">
                      <TextInput
                        type="number"
                        min="1"
                        value={form.scroll_amount}
                        onChange={(e) => setForm((f) => ({ ...f, scroll_amount: parseInt(e.target.value, 10) || 1 }))}
                      />
                    </Field>
                  </div>
                )}

                {NEEDS_SELECTOR.has(form.action) && (
                  <Field
                    label="Selector"
                    hint='Paste the same <webctrl .../> snippet UiPath uses (from "present element" in your spreadsheet), then click Parse selector.'
                  >
                    <textarea
                      className="w-full rounded-sm border border-line bg-panel px-3 py-2 font-mono text-xs text-ink placeholder:text-muted focus:border-brand-blue"
                      rows={3}
                      value={form.selectorText}
                      onChange={(e) => setForm((f) => ({ ...f, selectorText: e.target.value }))}
                      placeholder="<html app='msedge.exe' />&#10;<webctrl id='username' tag='INPUT' />"
                    />
                    <div className="mt-1.5 flex items-center gap-2">
                      <Button variant="secondary" onClick={handleParseSelector} disabled={parsing || !form.selectorText.trim()}>
                        {parsing ? "Parsing..." : "Parse selector"}
                      </Button>
                      {form.locators.length > 0 && (
                        <span className="font-mono text-xs text-muted">Current: {summarizeLocators(form.locators)}</span>
                      )}
                    </div>
                    {parseNotice && (
                      <div className="mt-1.5">
                        <Callout tone={parseNotice.tone}>{parseNotice.text}</Callout>
                      </div>
                    )}
                  </Field>
                )}

                <div className="flex gap-2">
                  <Button onClick={saveFormIntoList}>{editingIndex === -1 ? "Add to list" : "Update step"}</Button>
                  <Button variant="secondary" onClick={cancelForm}>
                    Cancel
                  </Button>
                </div>
              </div>
            )}

            <div className="flex items-center gap-2 border-t border-line pt-3">
              <Button onClick={saveAll} disabled={saving}>
                {saving ? "Saving..." : "Save changes"}
              </Button>
              <Button variant="secondary" onClick={load} disabled={saving}>
                Discard &amp; reload
              </Button>
            </div>
            {notice && <Callout tone={notice.tone}>{notice.text}</Callout>}
          </>
        )}
      </div>
        </Disclosure>
      </div>
    </Panel>
  );
}
