SELECT 'MAIN' AS db_name, m.name AS table_name,
       p.name AS column_name, p.type, p.pk
FROM main.sqlite_master AS m
JOIN pragma_table_info(m.name, 'main') AS p
WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%'

UNION ALL

SELECT 'SECOND', m.name, p.name, p.type, p.pk
FROM db2.sqlite_master AS m
JOIN pragma_table_info(m.name, 'db2') AS p
WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%'

ORDER BY table_name, db_name;