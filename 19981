"""
locator_engine.py

Pure-Python locator generation and ranking.

Important design rules:
1. Never trust an ID merely because it exists.
2. Angular-generated classes/attributes are ignored.
3. Card/tile elements prefer exact visible text.
4. Generic CSS classes receive a low score.
5. Text + clickable/card ancestor is preferred for repeated card grids.
6. The executor MUST validate that the chosen locator matches exactly one
   element before clicking.
"""

from __future__ import annotations

import re
from typing import Any, Dict, List

from backend.storage.models import LocatorCandidate, LocatorStrategy


# ---------------------------------------------------------------------------
# Volatile / framework-generated identifiers
# ---------------------------------------------------------------------------

_VOLATILE_ID_PATTERNS = [
    # Common generated short IDs:
    re.compile(r"^[a-z0-9]{1,12}$", re.I),

    # UUID-like values:
    re.compile(
        r"^[a-f0-9]{8}-[a-f0-9]{4}-"
        r"[a-f0-9]{4}-[a-f0-9]{4}-"
        r"[a-f0-9]{12}$",
        re.I,
    ),

    # Long hexadecimal values:
    re.compile(r"^[a-f0-9]{20,}$", re.I),

    # Framework generated:
    re.compile(r"^(ember|react|vue|svelte)[-_]?\w*$", re.I),

    # Angular / Material generated IDs:
    re.compile(r"^(mat|cdk|ng)[-_]?[a-z0-9_-]+$", re.I),

    # Long digit runs:
    re.compile(r"\d{5,}"),
]


_VOLATILE_CLASS_NAMES = {
    "ng-star-inserted",
    "ng-untouched",
    "ng-touched",
    "ng-pristine",
    "ng-dirty",
    "ng-valid",
    "ng-invalid",
    "ng-pending",
    "ng-submitted",
}


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _looks_volatile(value: str) -> bool:
    if not value:
        return True

    return any(
        pattern.search(value)
        for pattern in _VOLATILE_ID_PATTERNS
    )


def _css_escape(value: str) -> str:
    """
    Minimal CSS escaping for generated selectors.
    """
    return re.sub(
        r'([#.:\[\]\(\)"\'\\])',
        r"\\\1",
        value,
    )


def _xpath_literal(value: str) -> str:
    """
    Safely convert arbitrary text into an XPath string literal.
    """

    if "'" not in value:
        return f"'{value}'"

    if '"' not in value:
        return f'"{value}"'

    parts = value.split("'")

    return "concat(" + ', "\'", '.join(
        f"'{part}'"
        for part in parts
    ) + ")"


def _clean_text(value: Any) -> str:
    if value is None:
        return ""

    return " ".join(str(value).split()).strip()


def _is_framework_class(value: str) -> bool:
    """
    Returns True for Angular/framework generated CSS classes.
    """

    if not value:
        return True

    lower = value.lower()

    if lower in _VOLATILE_CLASS_NAMES:
        return True

    prefixes = (
        "_ngcontent-",
        "_nghost-",
        "ng-",
        "mat-ripple",
        "cdk-",
    )

    return lower.startswith(prefixes)


def _is_card_like(info: Dict[str, Any], component_type: str) -> bool:
    """
    Detect card/tile/grid components.

    Particularly useful for the RLMS screen where many cards share:
        mat-card
        dashboard-content
        col-md-3
        ng-star-inserted
    """

    if component_type in {
        "card",
        "tile",
        "product_card",
    }:
        return True

    tag = _clean_text(info.get("tag")).lower()

    role = _clean_text(info.get("role")).lower()

    class_name = _clean_text(
        info.get("class_name")
    ).lower()

    text = _clean_text(info.get("text"))

    card_words = (
        "mat-card",
        "dashboard-content",
        "product-card",
        "card",
        "tile",
    )

    if any(word in class_name for word in card_words):
        return True

    if tag in {"article"} and text:
        return True

    if role in {"button", "listitem"} and text:
        return True

    return False


def _normalise_tag(tag: str) -> str:
    """
    Prevent malformed XPath tags.
    """

    tag = _clean_text(tag).lower()

    if re.fullmatch(r"[a-z][a-z0-9_-]*", tag):
        return tag

    return "*"


# ---------------------------------------------------------------------------
# Component classification
# ---------------------------------------------------------------------------

def classify_component(info: Dict[str, Any]) -> str:
    """
    Classify the captured DOM element.
    """

    tag = _clean_text(
        info.get("tag")
    ).lower()

    role = _clean_text(
        info.get("role")
    ).lower()

    type_attr = _clean_text(
        info.get("type")
    ).lower()

    class_name = _clean_text(
        info.get("class_name")
    ).lower()

    text = _clean_text(
        info.get("text")
    )

    # Explicit card information from bridge.js.
    if info.get("is_card") is True:
        return "card"

    if "mat-card" in class_name:
        return "card"

    if "dashboard-content" in class_name:
        return "card"

    if role == "listbox" or tag == "select":
        return "dropdown"

    if tag == "input":

        if type_attr == "checkbox":
            return "checkbox"

        if type_attr == "radio":
            return "radio"

        if type_attr == "file":
            return "file_upload"

        if type_attr in {
            "submit",
            "button",
            "reset",
        }:
            return "button"

        return "input"

    if tag == "textarea":
        return "input"

    if tag == "button" or role == "button":
        return "button"

    if tag == "a" or role == "link":
        return "link"

    if tag == "table":
        return "table"

    if tag in {"tr", "td", "th"}:
        return "table_cell"

    if tag in {"ul", "ol", "li"} or role == "listitem":
        return "list_item"

    if role == "tab":
        return "tab"

    if role == "menuitem":
        return "menu_item"

    if tag == "iframe":
        return "frame"

    if role in {"dialog", "alertdialog"} or tag == "dialog":
        return "dialog"

    if info.get("contenteditable"):
        return "rich_text"

    # A clickable element with short visible text is often a card/tile.
    if info.get("clickable") and text and len(text) <= 80:
        return "card"

    return "element"


# ---------------------------------------------------------------------------
# Human-readable element name
# ---------------------------------------------------------------------------

def generate_element_name(
    info: Dict[str, Any],
    component_type: str,
) -> str:
    """
    Generate a generic human-friendly element name.

    Never derives names from business vocabulary.
    """

    data_attrs = info.get("data_attrs") or {}

    candidates = [
        data_attrs.get("data-test-id"),
        data_attrs.get("data-testid"),
        data_attrs.get("data-qa"),
        info.get("name"),
        info.get("aria_label"),
        info.get("placeholder"),
        info.get("text"),
    ]

    base = next(
        (
            _clean_text(c)
            for c in candidates
            if _clean_text(c)
            and not _looks_volatile(_clean_text(c))
        ),
        None,
    )

    if not base:
        base = component_type

    slug = re.sub(
        r"[^a-zA-Z0-9]+",
        "_",
        str(base),
    ).strip("_").lower()

    slug = slug[:60]

    return (
        f"{slug}_{component_type}"
        if slug
        else component_type
    )


# ---------------------------------------------------------------------------
# Locator generation
# ---------------------------------------------------------------------------

def build_locators(
    info: Dict[str, Any],
) -> List[LocatorCandidate]:
    """
    Generate ranked locator candidates.

    IMPORTANT:
    This function does not require Selenium/WebDriver.

    The execution layer must still validate candidate uniqueness.
    """

    candidates: List[LocatorCandidate] = []

    tag = _normalise_tag(
        info.get("tag") or ""
    )

    component_type = classify_component(info)

    is_card = _is_card_like(
        info,
        component_type,
    )

    data_attrs = (
        info.get("data_attrs") or {}
    )

    # ------------------------------------------------------------------
    # 1. data-testid / data-test-id / data-qa
    # ------------------------------------------------------------------

    for key in (
        "data-testid",
        "data-test-id",
        "data-qa",
    ):
        value = _clean_text(
            data_attrs.get(key)
        )

        if value and not _looks_volatile(value):
            candidates.append(
                LocatorCandidate(
                    strategy=LocatorStrategy.DATA_TESTID,
                    value=f"[{key}='{_css_escape(value)}']",
                    reliability_score=1.00,
                )
            )

    # ------------------------------------------------------------------
    # 2. ID
    #
    # DO NOT assume ID is unique.
    # The executor must validate it.
    #
    # For card elements we intentionally give text/card locators
    # a higher priority because RLMS contains duplicated IDs.
    # ------------------------------------------------------------------

    elem_id = _clean_text(
        info.get("id")
    )

    if elem_id and not _looks_volatile(elem_id):

        id_score = 0.95

        if is_card:
            # RLMS has duplicated dashboardPersonalLoan IDs.
            # Keep ID as fallback but don't let it beat card identity.
            id_score = 0.82

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.ID,
                value=elem_id,
                reliability_score=id_score,
            )
        )

    # ------------------------------------------------------------------
    # 3. NAME
    # ------------------------------------------------------------------

    name = _clean_text(
        info.get("name")
    )

    if name:
        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.NAME,
                value=name,
                reliability_score=0.88,
            )
        )

    # ------------------------------------------------------------------
    # 4. Accessibility
    # ------------------------------------------------------------------

    aria_label = _clean_text(
        info.get("aria_label")
    )

    role = _clean_text(
        info.get("role")
    )

    if aria_label:

        value = (
            f"//*[@aria-label="
            f"{_xpath_literal(aria_label)}]"
        )

        if role:
            value += (
                f"[@role={_xpath_literal(role)}]"
            )

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.ACCESSIBILITY,
                value=value,
                reliability_score=0.94,
            )
        )

    elif role:

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.ACCESSIBILITY,
                value=(
                    f"//*[@role="
                    f"{_xpath_literal(role)}]"
                ),
                reliability_score=0.70,
            )
        )

    # ------------------------------------------------------------------
    # 5. Input-specific attributes
    # ------------------------------------------------------------------

    for attr in (
        "placeholder",
        "title",
        "alt",
        "type",
    ):

        value = _clean_text(
            info.get(attr)
        )

        if value:
            candidates.append(
                LocatorCandidate(
                    strategy=LocatorStrategy.ATTRIBUTE,
                    value=(
                        f"{tag}[{attr}="
                        f"{_xpath_literal(value)}]"
                    ),
                    reliability_score=0.76,
                )
            )

            # One attribute is generally enough.
            break

    # ------------------------------------------------------------------
    # 6. Card / tile text
    #
    # THIS IS THE IMPORTANT PART FOR YOUR RLMS SCREEN.
    # ------------------------------------------------------------------

    text = _clean_text(
        info.get("text")
    )

    if text and len(text) <= 80:

        xpath_text = _xpath_literal(text)

        # Exact direct text.
        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.TEXT,
                value=(
                    f"//{tag}"
                    f"[normalize-space(text())="
                    f"{xpath_text}]"
                ),
                reliability_score=0.89,
            )
        )

        # Exact text anywhere in the DOM.
        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.TEXT,
                value=(
                    f"//*[normalize-space(text())="
                    f"{xpath_text}]"
                ),
                reliability_score=0.84,
            )
        )

        # --------------------------------------------------------------
        # Card text + card ancestor.
        #
        # Example:
        #
        # Gold Loan
        #
        # ->
        # find Gold Loan text
        # ->
        # find its nearest mat-card/dashboard-content/card
        # --------------------------------------------------------------

        if is_card:

            card_xpath = (
                f"//*[normalize-space(text())="
                f"{xpath_text}]"
                f"/ancestor::*["
                f"self::mat-card"
                f" or self::button"
                f" or @role='button'"
                f" or contains("
                f"concat(' ', normalize-space(@class), ' '),"
                f"' mat-card '"
                f")"
                f" or contains("
                f"concat(' ', normalize-space(@class), ' '),"
                f"' dashboard-content '"
                f")"
                f" or contains("
                f"concat(' ', normalize-space(@class), ' '),"
                f"' product-card '"
                f")"
                f"][1]"
            )

            candidates.append(
                LocatorCandidate(
                    strategy=LocatorStrategy.RELATIVE_XPATH,
                    value=card_xpath,
                    reliability_score=0.98,
                )
            )

        # Link text.
        if tag == "a":

            candidates.append(
                LocatorCandidate(
                    strategy=LocatorStrategy.LINK_TEXT,
                    value=text,
                    reliability_score=0.91,
                )
            )

    # ------------------------------------------------------------------
    # 7. CSS class locator
    #
    # Deliberately LOW priority.
    # Generic classes such as:
    #
    # mat-card
    # dashboard-content
    # col-md-3
    # ng-star-inserted
    #
    # are repeated on this page.
    # ------------------------------------------------------------------

    class_name = _clean_text(
        info.get("class_name")
    )

    if class_name:

        classes = [
            c
            for c in class_name.split()
            if c
            and not _is_framework_class(c)
            and not _looks_volatile(c)
        ]

        if classes:

            # Use at most 3 stable classes.
            classes = classes[:3]

            css = (
                tag
                + "."
                + ".".join(
                    _css_escape(c)
                    for c in classes
                )
            )

            candidates.append(
                LocatorCandidate(
                    strategy=LocatorStrategy.CSS,
                    value=css,
                    reliability_score=0.45,
                )
            )

    # ------------------------------------------------------------------
    # 8. Existing browser-generated CSS path
    #
    # Fallback only.
    # ------------------------------------------------------------------

    css_path = _clean_text(
        info.get("css_path")
    )

    if css_path:

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.CSS,
                value=css_path,
                reliability_score=0.40,
            )
        )

    # ------------------------------------------------------------------
    # 9. XPath supplied by browser
    # ------------------------------------------------------------------

    xpath = _clean_text(
        info.get("xpath")
    )

    if xpath:

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.XPATH,
                value=xpath,
                reliability_score=0.35,
            )
        )

    # ------------------------------------------------------------------
    # 10. Relative XPath based on text
    # ------------------------------------------------------------------

    if text and len(text) <= 80:

        xpath_text = _xpath_literal(
            text[:80]
        )

        relative_xpath = (
            f"//{tag}[contains("
            f"normalize-space(.),"
            f"{xpath_text}"
            f")]"
        )

        candidates.append(
            LocatorCandidate(
                strategy=LocatorStrategy.RELATIVE_XPATH,
                value=relative_xpath,
                reliability_score=0.55,
            )
        )

    # ------------------------------------------------------------------
    # De-duplicate candidates
    # ------------------------------------------------------------------

    seen = set()
    unique: List[LocatorCandidate] = []

    for candidate in candidates:

        key = (
            candidate.strategy,
            candidate.value,
        )

        if key in seen:
            continue

        seen.add(key)
        unique.append(candidate)

    # ------------------------------------------------------------------
    # Sort by reliability
    # ------------------------------------------------------------------

    unique.sort(
        key=lambda c: c.reliability_score,
        reverse=True,
    )

    return unique