@app.post("/api/execute")
def execute_recording(req: ExecuteRequest, request: Request) -> Dict[str, Any]:
    if not recording_store.exists(req.recording_id):
        raise HTTPException(404, "Recording not found")

    only_step_numbers: Optional[List[int]] = None
    if req.change_set_id and not req.run_via_behave:
        paths = recording_store.paths(req.recording_id)
        change_set = change_applier.find_change_set(paths, req.change_set_id)
        if not change_set:
            raise HTTPException(404, f"Change-set '{req.change_set_id}' not found for this recording")
        only_step_numbers = list(change_set.get("added_step_numbers") or []) + list(change_set.get("removed_step_numbers") or [])
        if not only_step_numbers:
            raise HTTPException(400, "This change-set has no steps to run")

    execution_id = ExecutionManager.start(
        req.recording_id, browser=req.browser, test_data=req.test_data,
        ai_provider=req.ai_provider, run_via_behave=req.run_via_behave,
        remote_node_url=(req.remote_node_url or "").strip() or None,
        only_step_numbers=only_step_numbers,
    )
    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "execute_recording",
        recording_id=req.recording_id, details={"execution_id": execution_id, "run_via_behave": req.run_via_behave},
    )
    return {"execution_id": execution_id, "status": "running", "only_step_numbers": only_step_numbers}


