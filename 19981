@app.websocket("/api/agent/ws")
async def agent_ws(
    websocket: WebSocket,
    token: str = Query(...),
    agent_id: str = Query(...),
    hostname: str = Query(...),
    version: str = Query(...),
):
    current_user = validate_token_for_websocket(token)

    if current_user is None:
        await websocket.close(code=4401, reason="Not authenticated")
        return

    await websocket.accept()

    # Register this agent
    agent_registry.register(
        agent_id=agent_id,
        websocket=websocket,
        hostname=hostname,
        version=version,
        user_id=current_user.user_id,
    )

    try:
        while True:
            message = await websocket.receive_json()

            # Handle heartbeat / command responses
            ...
            
    except WebSocketDisconnect:
        agent_registry.unregister(agent_id)

    finally:
        agent_registry.unregister(agent_id)
