import { useCallback, useEffect, useState } from "react";
import Head from "next/head";
import Layout from "@/components/Layout";
import RequireAuth from "@/components/RequireAuth";
import { adminApi } from "@/lib/api";
import { fmtLocalDateTime } from "@/lib/time";
import { Button, Callout, DataTable, PageHeader, Panel, PanelHeader } from "@/components/ui";

function idleLabel(seconds) {
  if (seconds < 60) return `${seconds}s`;
  return `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
}

export default function AdminSessionsPage() {
  const [sessions, setSessions] = useState([]);
  const [error, setError] = useState(null);
  const [busyId, setBusyId] = useState(null);
  const [notice, setNotice] = useState(null);

  const load = useCallback(async () => {
    try {
      setSessions(await adminApi.listSessions());
      setError(null);
    } catch (e) {
      setError(e.detail || e.message);
    }
  }, []);

  useEffect(() => {
    load();
    const interval = setInterval(load, 15000); // auto-refresh - this is a "who's online right now" view
    return () => clearInterval(interval);
  }, [load]);

  async function handleRevoke(s) {
    if (!window.confirm(`Force-logout ${s.username}?`)) return;
    setBusyId(s.session_id);
    setNotice(null);
    try {
      await adminApi.revokeSession(s.session_id);
      setNotice({ tone: "success", text: `${s.username} has been signed out.` });
      await load();
    } catch (err) {
      setNotice({ tone: "error", text: err.detail || err.message });
    } finally {
      setBusyId(null);
    }
  }

  return (
    <RequireAuth adminOnly>
      <Layout>
        <Head>
          <title>Active sessions - AI Test Recorder</title>
        </Head>

        <PageHeader
          title="Sessions"
          description="Everyone currently signed in on the website (a logged-out user is not listed), refreshed every 15 seconds."
          action={(
      <Button variant="secondary" onClick={load}>
        Refresh now
      </Button>
          )}
        />

        {error && <Callout tone="error">{error}</Callout>}
        {notice && (
          <div className="mb-4">
            <Callout tone={notice.tone}>{notice.text}</Callout>
          </div>
        )}

        <Panel>
          <PanelHeader title={`${sessions.length} online`} />
          <div className="px-5 py-5">
            <DataTable
              columns={[
                { key: "user", label: "User" },
                { key: "username", label: "Username", mono: true },
                { key: "role", label: "Role" },
                { key: "agent", label: "Agent" },
                { key: "recording", label: "Recording" },
                { key: "logged_in_at", label: "Logged in", mono: true },
                { key: "idle", label: "Idle for", mono: true },
                { key: "ip", label: "IP address", mono: true },
                { key: "actions", label: "" },
              ]}
              rows={sessions.map((s) => ({
                user: s.full_name,
                username: s.username,
                role: s.role,
                agent: s.agent_connected ? <span className="text-xs font-medium text-emerald-600">Connected</span> : <span className="text-xs text-muted">—</span>,
                recording: s.recording_active ? (
                  <span className="inline-flex items-center gap-1.5 text-xs font-semibold text-signal-rust">
                    <span className="pulse-dot h-1.5 w-1.5 rounded-full bg-signal-rust" />
                    Live
                  </span>
                ) : (
                  <span className="text-xs text-muted">—</span>
                ),
                logged_in_at: fmtLocalDateTime(s.created_at),
                idle: idleLabel(s.idle_seconds),
                ip: s.ip_address || "—",
                actions: (
                  <button
                    className="text-xs font-medium text-signal-rust hover:underline disabled:opacity-40"
                    disabled={busyId === s.session_id}
                    onClick={() => handleRevoke(s)}
                  >
                    Force logout
                  </button>
                ),
              }))}
            />
          </div>
        </Panel>
      </Layout>
    </RequireAuth>
  );
}
