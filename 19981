@app.get("/api/recordings")
def get_recordings(current_user: CurrentUser = Depends(get_current_user)):
    return list_saved_recordings()


def _safe_recording_path(file: str) -> Path:
    """Resolves `file` (as returned by GET /api/recordings) and makes sure
    it's actually inside recordings/ - a defensive check against a crafted
    path (e.g. "../../.env") ever being read/written through this endpoint."""
    recordings_dir = (Path(__file__).resolve().parents[1] / "recordings").resolve()
    path = Path(file).resolve()
    if recordings_dir not in path.parents or path.suffix != ".json":
        raise HTTPException(status_code=400, detail="Invalid recording file")
    if not path.exists():
        raise HTTPException(status_code=404, detail="Recording not found")
    return path


@app.get("/api/recordings/data")
def get_recording_test_data(file: str, current_user: CurrentUser = Depends(get_current_user)):
    """Backs the editable data grid shown before running a saved recording
    (see generator/test_data.py) - every typed/selected value in the
    recording, editable right there instead of downloading the Excel
    report, changing values, and re-uploading."""
    path = _safe_recording_path(file)
    recording = json.loads(path.read_text())
    return {"file": str(path), "fields": extract_test_data(recording)}


@app.put("/api/recordings/data")
def update_recording_test_data(
    file: str, req: TestDataUpdateRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)
):
    """Writes edited values straight back into the saved recording JSON -
    this becomes the new baseline test data for every future run of this
    recording, not just a one-off override for the next click of Run."""
    path = _safe_recording_path(file)
    recording = json.loads(path.read_text())
    recording = apply_test_data(recording, req.values)
    path.write_text(json.dumps(recording, indent=2))

    ip = get_client_ip(request)
    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="TEST_DATA_UPDATED",
            status="SUCCESS", details={"recording_file": str(path), "fields_changed": len(req.values)},
            endpoint="/api/recordings/data", ip_address=ip,
        )
    return {"ok": True, "fields": extract_test_data(recording)}


@app.post("/api/run_recording")
def run_saved_recording(req: RunRecordingRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Runs a previously saved recording end-to-end (regenerate + execute)
    and returns the exit report, attributed to whoever is logged in - the
    frontend no longer picks a "run as" user, it's always the current
    session. Everything about the run (status, steps, files produced) is
    written to transactions/*.json (see runner/transaction_store.py) -
    NOT the database, which is reserved for auth/session/activity data.

    Any test-data edits (see /api/recordings/data above) are already
    persisted into the recording file itself by the time this runs, so
    there's nothing extra to pass through here - the run just reads
    whatever's currently saved."""
    ip = get_client_ip(request)
    try:
        report = run_recording(
            recording_file=req.recording_file,
            user_id=current_user.user_id,
            headless=req.headless,
        )
        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="RUN_RECORDING",
                status="SUCCESS" if report["status"] == "Success" else "FAILURE",
                details={"recording_file": req.recording_file, "transaction_id": report["transaction_id"]},
                endpoint="/api/run_recording", ip_address=ip,
            )
        return report
    except FileNotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))


# ------------------------------------------------------------------------
# Transaction history - read from transactions/*.json (see
# runner/transaction_store.py), NOT the database. The database only holds
# auth/session/activity data; recording-run history is plain files.
# ------------------------------------------------------------------------

@app.get("/api/transactions")
def get_transactions(user_id: Optional[int] = None, limit: int = 50, current_user: CurrentUser = Depends(get_current_user)):
    txns = transaction_store.list_transactions(user_id=user_id, limit=limit)
    return [
        {"transaction_id": t["transaction_id"], "user_id": t["user_id"],
         "transaction_name": t["transaction_name"], "status": t["status"],
         "date_time": t["date_time"]}
        for t in txns
    ]


@app.get("/api/transactions/{transaction_id}")
def get_transaction_report(transaction_id: int, current_user: CurrentUser = Depends(get_current_user)):
    txn = transaction_store.get_transaction(transaction_id)
    if txn is None:
        raise HTTPException(status_code=404, detail="Transaction not found")
    return txn


