"""Test Data Editor + Profile Manager endpoints (Screens 3 and 4)."""
from __future__ import annotations

from typing import Any

from fastapi import APIRouter, HTTPException

from ..agents import test_data_agent
from ..core.schemas import (
    Ack, ProfileIn, ProfileOut, SecretIn, SecretOut, TestDataSaveRequest,
)
from ..tdm import profiles as tdm_profiles, resolver, templates

router = APIRouter(prefix="/api/testdata", tags=["test-data"])
profile_router = APIRouter(prefix="/api/profiles", tags=["profiles"])
secret_router = APIRouter(prefix="/api/secrets", tags=["secrets"])


# ── test data ───────────────────────────────────────────────────────────
@router.get("/{transaction_id}")
def get_editor(transaction_id: str, environment: str = "PREPROD",
               profile: str | None = None) -> dict[str, Any]:
    result = test_data_agent(action="editor", transaction_id=transaction_id,
                             environment=environment, profile=profile)
    return result.get("view", {})


@router.post("/save")
def save(payload: TestDataSaveRequest) -> dict[str, Any]:
    result = test_data_agent(
        action="save",
        transaction_id=payload.transaction_id,
        environment=payload.environment,
        profile=payload.profile,
        values=[v.model_dump() for v in payload.values],
    )
    if not result.ok:
        raise HTTPException(500, result.get("error", "save failed"))
    return {"saved": result.get("saved"), "file": result.get("file")}


@router.get("/{transaction_id}/resolve")
def resolve_preview(transaction_id: str, environment: str = "PREPROD",
                    profile: str = "") -> dict[str, Any]:
    result = test_data_agent(action="resolve", transaction_id=transaction_id,
                             environment=environment, profile=profile,
                             strict=False)
    payload = dict(result)
    # never leak resolved sensitive values to the UI
    sensitive = set(payload.get("sensitive_fields", []))
    payload["values"] = {
        k: ("****" if k in sensitive else v)
        for k, v in (payload.get("values") or {}).items()
    }
    return payload


@router.get("/{transaction_id}/prompts")
def runtime_prompts(transaction_id: str, environment: str = "PREPROD",
                    profile: str = "") -> list[dict[str, Any]]:
    result = test_data_agent(action="prompts", transaction_id=transaction_id,
                             environment=environment, profile=profile)
    return result.get("prompts", [])


@router.get("/{transaction_id}/template")
def get_template(transaction_id: str, environment: str = "PREPROD") -> dict[str, Any]:
    return templates.read(transaction_id, environment)


@router.post("/{transaction_id}/refresh-field-metadata")
def refresh_field_metadata(transaction_id: str) -> dict[str, Any]:
    """Re-derive datatype/pattern/business_meaning for every field of this
    transaction from its already-recorded elements/actions, using the
    CURRENT field_meta.py classification rules, and re-save it.

    Field classification is computed once, at recording time, and stored
    — a transaction recorded before a field_meta.py classification fix
    landed keeps failing test-data validation with the OLD rule until its
    stored metadata is explicitly refreshed. This is that refresh, and it
    does not require re-recording the transaction.
    """
    try:
        return templates.recompute_field_metadata(transaction_id)
    except ValueError as exc:
        raise HTTPException(404, str(exc))


# ── profiles ────────────────────────────────────────────────────────────
@profile_router.get("")
def list_profiles() -> list[dict[str, Any]]:
    return [
        {
            "id": p["id"], "name": p["name"], "environment": p["environment"],
            "description": p.get("description"),
            "values": p.get("values_json") or {},
            "secret_keys": p.get("secret_keys", []),
        }
        for p in tdm_profiles.list_profiles()
    ]


@profile_router.post("")
def save_profile(payload: ProfileIn) -> dict[str, Any]:
    profile = tdm_profiles.upsert_profile(
        name=payload.name, environment=payload.environment,
        description=payload.description, values=payload.values,
        secrets=payload.secrets,
    )
    return {
        "id": profile.get("id"), "name": payload.name,
        "environment": payload.environment,
        "missing_credentials": tdm_profiles.missing_credentials(
            payload.name, payload.environment
        ),
    }


@profile_router.get("/{name}")
def get_profile(name: str) -> dict[str, Any]:
    profile = tdm_profiles.get_profile(name)
    if not profile:
        raise HTTPException(404, f"profile {name} not found")
    return {
        "id": profile["id"], "name": profile["name"],
        "environment": profile["environment"],
        "description": profile.get("description"),
        "values": profile.get("values_json") or {},
        "secrets": tdm_profiles.list_secrets("profile", name),
        "missing_credentials": tdm_profiles.missing_credentials(
            name, profile["environment"]
        ),
    }


@profile_router.delete("/{name}")
def delete_profile(name: str) -> Ack:
    tdm_profiles.delete_profile(name)
    return Ack(message=f"profile {name} deleted")


# ── secrets (never returned in plaintext) ───────────────────────────────
@secret_router.get("")
def list_secrets(scope: str | None = None,
                 scope_ref: str | None = None) -> list[dict[str, Any]]:
    return tdm_profiles.list_secrets(scope, scope_ref)


@secret_router.post("")
def set_secret(payload: SecretIn) -> Ack:
    tdm_profiles.set_secret(payload.scope, payload.scope_ref, payload.key,
                            payload.value)
    return Ack(message=f"{payload.key} stored (encrypted at rest)")


@secret_router.delete("")
def delete_secret(scope: str, key: str, scope_ref: str | None = None) -> Ack:
    tdm_profiles.delete_secret(scope, scope_ref, key)
    return Ack(message=f"{key} removed")
