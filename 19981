import { useEffect, useMemo, useRef, useState } from "react";
import { api } from "@/lib/api";
import { recordingsApi, executionsApi, transactionsApi } from "@/lib/api";
import ExecutionProgress, { ACTIVE as ACTIVE_STATUSES } from "@/components/ExecutionProgress";
import RuntimeInputDialog from "@/components/runtime/RuntimeInputDialog";
import ExecutionDetails from "@/components/ExecutionDetails";
import ValidationReport from "@/components/ValidationReport";
import { errorDetail, validateApi } from "@/lib/platformApi";
import ReportView from "@/components/ReportView";
import StepEditor from "@/components/StepEditor";
import RuntimeConfigPanel, { missingRequired, valuesToSend } from "@/components/runtime/RuntimeConfigPanel";
import ShareDialog from "@/components/ShareDialog";
import VersionHistory from "@/components/VersionHistory";
import Link from "next/link";
import { useAuth } from "@/context/AuthContext";
import {
  Button,
  Callout,
  Checkbox,
  Disclosure,
  Field,
  Panel,
  Select,
  Spinner,
  TextInput,
} from "@/components/ui";

import { fmtRecordedAt } from "@/lib/recordedAt";

// A small filter box that sits under a column heading.
function ColumnFilter({ value, onChange, placeholder = "Filter", label, className = "" }) {
  return (
    <input
      type="text"
      value={value}
      onChange={(e) => onChange(e.target.value)}
      placeholder={placeholder}
      aria-label={label}
      className={`w-full rounded-sm border border-line bg-white px-2 py-1 text-xs font-normal text-ink placeholder:text-muted focus:border-brand-blue focus:outline-none ${className}`}
    />
  );
}

const EMPTY_FILTERS = { no: "", app: "", name: "", by: "", when: "", steps: "" };

export default function RunSavedTab({ active = true }) {
  const { user } = useAuth();
  const isAdmin = user?.role === "admin";
  const [recordings, setRecordings] = useState([]);
  const [recordingsError, setRecordingsError] = useState(null);
  const [selectedRecFile, setSelectedRecFile] = useState("");
  // Configurable steps of the selected recording and the values chosen for its next run (RuntimeConfigPanel).
  const [runtimeVars, setRuntimeVars] = useState([]);
  const [runtimeValues, setRuntimeValues] = useState({});
  const [runtimeReload, setRuntimeReload] = useState(0);
  const [stepsReload, setStepsReload] = useState(0);   // bumped when test data is saved, so Edit steps reloads
  const [applicationNames, setApplicationNames] = useState([]);
  const [runHeadless, setRunHeadless] = useState(false);
  const [testData, setTestData] = useState([]);
  const [testDataLoading, setTestDataLoading] = useState(false);
  const [testDataError, setTestDataError] = useState(null);
  const [editValues, setEditValues] = useState({});
  const [savingData, setSavingData] = useState(false);
  const [saveDataNotice, setSaveDataNotice] = useState(null);
  const [saveDataError, setSaveDataError] = useState(null);
  const [runBusy, setRunBusy] = useState(false);
  const [runError, setRunError] = useState(null);
  const [report, setReport] = useState(null);
  const [job, setJob] = useState(null);                 // the background execution being watched
  const [connectionLost, setConnectionLost] = useState(false);
  const [controlBusy, setControlBusy] = useState(null);
  const pollToken = useRef(0);                          // bumping this stops an older polling loop
  const [validation, setValidation] = useState(null);       // the pre-run readiness report
  const [validating, setValidating] = useState(false);
  // Resume: run only from this step number; the first N steps (e.g. login) still run.
  const [resumeFrom, setResumeFrom] = useState("");
  const [resumeSetup, setResumeSetup] = useState("0");
  const [regenBusy, setRegenBusy] = useState(false);
  const [regenNotice, setRegenNotice] = useState(null);
  const [regenFiles, setRegenFiles] = useState(null);
  const [downloadingRegen, setDownloadingRegen] = useState(null);
  const [shareDialogOpen, setShareDialogOpen] = useState(false);
  const [exportBusy, setExportBusy] = useState(false);
  // "Create a navigation menu check" form + the selected check's baseline.
  const [menuApp, setMenuApp] = useState("Others");
  const [menuUrl, setMenuUrl] = useState("");
  const [menuName, setMenuName] = useState("");
  const [menuSelector, setMenuSelector] = useState("");
  const [menuStrict, setMenuStrict] = useState(false);
  const [menuBusy, setMenuBusy] = useState(false);
  const [menuNotice, setMenuNotice] = useState(null);
  const [baselineBusy, setBaselineBusy] = useState(false);
  const [baselineNotice, setBaselineNotice] = useState(null);
  // Deleting is ADMIN-ONLY (the buttons below never render for anyone else).
  const [delPicked, setDelPicked] = useState({});      // file -> true
  const [delBusy, setDelBusy] = useState(false);
  const [delNotice, setDelNotice] = useState(null);
  // Column filters of the table
  const [filters, setFilters] = useState(EMPTY_FILTERS);

  const selectedRecording = recordings.find((r) => r.file === selectedRecFile) || null;
  // The step number as the report shows it. A run that was itself resumed carries each row's ORIGINAL number
  // (`step_no`), so "Resume from step N" keeps pointing at the right step.
  const firstFailedStep = (() => {
    const rows = (report && report.steps) || [];
    const i = rows.findIndex((r) => ["Failed", "Error"].includes(r.status));
    return i >= 0 ? rows[i].step_no || i + 1 : null;
  })();

  async function loadRecordings() {
    try {
      const r = await api.getRecordings();
      setRecordings(r);
      setRecordingsError(null);
      if (r.length && !selectedRecFile) setSelectedRecFile(r[0].file);
    } catch (e) {
      setRecordingsError(e.detail || e.message);
    }
  }

  useEffect(() => {
    api.getApplications().then((r) => {
      const names = r.applications || [];
      setApplicationNames(names);
      setMenuApp((cur) => (names.includes(cur) ? cur : names[0] || ""));
    }).catch(() => {});
  }, []);

  // (Re)load the list every time this tab is shown, so a recording saved on the
  // Record screen appears without a page refresh.
  useEffect(() => {
    if (active) loadRecordings();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [active]);

  async function loadTestData(file) {
    setTestDataLoading(true);
    setTestDataError(null);
    setSaveDataNotice(null);
    setSaveDataError(null);
    try {
      const data = await api.getRecordingTestData(file);
      setTestData(data.fields);
      setEditValues(Object.fromEntries(data.fields.map((f) => [f.index, f.value])));
    } catch (e) {
      setTestData([]);
      setEditValues({});
      setTestDataError(e.detail || e.message);
    } finally {
      setTestDataLoading(false);
    }
  }

  useEffect(() => {
    setReport(null);
    setRegenNotice(null);
    setRegenFiles(null);
    setBaselineNotice(null);
    if (selectedRecFile) loadTestData(selectedRecFile);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedRecFile]);

  function updateValue(index, value) {
    setEditValues((prev) => ({ ...prev, [index]: value }));
    setSaveDataNotice(null);
  }

  async function saveTestDataOnly() {
    setSavingData(true);
    setSaveDataError(null);
    setSaveDataNotice(null);
    try {
      const data = await api.updateRecordingTestData(selectedRecFile, editValues);
      setTestData(data.fields);
      setStepsReload((n) => n + 1);          // the Edit steps grid must show the new values, not its old copy
      setSaveDataNotice("Test data saved - future runs of this recording will use these values too.");
    } catch (e) {
      setSaveDataError(e.detail || e.message);
    } finally {
      setSavingData(false);
    }
  }

  // Polls a background execution until it ends. A failed poll (server restart,
  // network blip) never ends the run - it only shows "lost contact" and retries
  // with a growing delay, because the test itself lives on the agent.
  async function watchJob(jobId) {
    const token = ++pollToken.current;
    let delay = 1500;
    let failures = 0;
    for (;;) {
      if (token !== pollToken.current) return;
      try {
        const j = await executionsApi.get(jobId);
        if (token !== pollToken.current) return;
        setJob(j);
        setConnectionLost(false);
        failures = 0;
        delay = 1500;
        if (["completed", "cancelled", "failed", "interrupted", "requires_investigation"].includes(j.status)) {
          if (j.transaction_id) {
            try {
              setReport(await transactionsApi.get(j.transaction_id));
            } catch (e) {
              setRunError(`The run ended but its report could not be loaded: ${e?.detail || e?.message}`);
            }
          } else if (j.message) {
            setRunError(j.message);
          }
          setRunBusy(false);
          loadRecordings();   // a menu check saves its baseline on the first run
          return;
        }
      } catch (e) {
        if (e?.status === 404) {                        // the job is gone (cleaned up) - stop watching
          setRunError("This execution is no longer available.");
          setRunBusy(false);
          return;
        }
        failures += 1;
        if (failures >= 2) setConnectionLost(true);
        delay = Math.min(delay * 1.5, 10000);
      }
      await new Promise((r) => setTimeout(r, delay));
    }
  }

  useEffect(() => { setValidation(null); }, [selectedRecFile]);
  // The panel loads the new recording's values itself (asynchronously, after this runs).
  useEffect(() => { setRuntimeVars([]); setRuntimeValues({}); }, [selectedRecFile]);

  async function handleFix(item) {
    setValidating(true);
    try {
      await validateApi.fix(selectedRecFile, item.fix);
      await loadRecordings();
      setValidation(await validateApi.run(selectedRecFile, { check_environment: validation?.coverage?.environment }));
    } catch (e) {
      setRunError(e?.detail || e?.message || "That fix could not be applied.");
    } finally {
      setValidating(false);
    }
  }

  // Re-attach to a run that is still going after a page reload / navigation.
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        // Only the user's OWN runs (mine) - for an admin the plain list holds everyone's, and re-attaching to
        // another user's run showed it here as running, with Stop / Pause on it.
        const r = await executionsApi.list({ limit: 5, mine: true });
        const live = (r.items || []).find((j) =>
          ACTIVE_STATUSES.includes(j.status));
        if (live && !cancelled) {
          setRunBusy(true);
          setJob(live);
          watchJob(live.job_id);
        }
      } catch (e) { /* not fatal - the user can still start a run */ }
    })();
    return () => { cancelled = true; pollToken.current += 1; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // `fileArg` is set when Run is pressed on a row of the table: that recording is
  // run as it is saved (the test-data / resume settings below belong to the
  // recording that is currently selected, so they only apply to that one).
  async function handleRun(fileArg) {
    const file = typeof fileArg === "string" ? fileArg : selectedRecFile;
    if (!file) return;
    const isSelected = file === selectedRecFile;
    if (!isSelected) setSelectedRecFile(file);
    setRunError(null);
    setReport(null);
    setJob(null);
    setValidation(null);
    setRunBusy(true);
    try {
      if (isSelected && testData.length > 0) await api.updateRecordingTestData(file, editValues);
      const from = isSelected ? parseInt(resumeFrom, 10) : NaN;
      const setup = isSelected ? parseInt(resumeSetup, 10) : 0;
      const extra = {};
      if (Number.isFinite(from) && from > 2) {
        extra.resume_from = from;
        extra.resume_setup = Number.isFinite(setup) && setup > 0 ? setup : 0;
      }
      // Values for this run - only for the recording whose panel the user filled in; a row's own Run button
      // runs another recording with its defaults.
      if (isSelected && runtimeVars.length > 0) {
        const missing = missingRequired(runtimeVars, runtimeValues);
        if (missing.length) {
          setRunError(`Choose a value for: ${missing.map((v) => v.display_label || v.variable_name).join(", ")} (Values for this run).`);
          setRunBusy(false);
          return;
        }
        extra.runtime_values = valuesToSend(runtimeValues);
      }
      const started = await executionsApi.start(file, runHeadless, "auto", extra);
      setJob({ job_id: started.job_id, status: started.status, progress: {}, metrics: {} });
      watchJob(started.job_id);
    } catch (e) {
      const d = errorDetail(e);
      if (d && d.code === "validation_failed" && d.validation) {
        // The server refused to start: show the same report the Validate button shows.
        setValidation({ can_run: false, counts: d.validation.counts, items: d.validation.items, notice: d.validation.notice,
                        coverage: { static: true, environment: false, application_flow: false } });
      }
      setRunError(e?.detail || e?.message || "Execution failed.");
      setRunBusy(false);
    }
  }

  async function controlJob(action) {
    if (!job) return;
    setControlBusy(action);
    try {
      await executionsApi[action](job.job_id);
    } catch (e) {
      setRunError(e?.detail || e?.message || `Unable to ${action} the execution.`);
    } finally {
      setControlBusy(null);
    }
  }

  async function handleRegenerate() {
    if (!selectedRecFile) return;
    setRegenNotice(null);
    setRegenFiles(null);
    setRegenBusy(true);
    try {
      const r = await recordingsApi.regenerate(selectedRecFile);
      setRegenNotice({
        tone: "success",
        text: `Regenerated (${r.build_result.step_count} steps) - download the scripts below, or just run this recording, which already uses the current code either way.`,
      });
      setRegenFiles({
        feature_file: r.build_result.feature_file,
        steps_file: r.build_result.steps_file,
        page_file: r.build_result.page_file,
        locators_file: r.build_result.locators_file,
      });
    } catch (e) {
      setRegenNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setRegenBusy(false);
    }
  }

  async function handleDownloadRegenFile(path, label) {
    setDownloadingRegen(path);
    try {
      await recordingsApi.downloadRegeneratedFile(path);
    } catch (e) {
      setRegenNotice({ tone: "error", text: `Could not download ${label}: ${e.detail || e.message}` });
    } finally {
      setDownloadingRegen(null);
    }
  }

  // ---- delete recordings (admin only) ------------------------------------
  const delPickedFiles = Object.keys(delPicked).filter((f) => delPicked[f]);

  async function handleDeleteRecordings(files) {
    if (!isAdmin || !files.length) return;
    const names = recordings.filter((r) => files.includes(r.file)).map((r) => `  • ${r.name}`).slice(0, 12);
    const more = files.length > names.length ? `\n  …and ${files.length - names.length} more` : "";
    if (!window.confirm(
      `Permanently delete ${files.length} recording(s)?\n\n${names.join("\n")}${more}\n\n` +
      "This cannot be undone. Past execution reports are kept.",
    )) return;
    setDelBusy(true);
    setDelNotice(null);
    try {
      const r = await recordingsApi.deleteRecordings(files);
      const gone = new Set(r.deleted.map((d) => d.file));
      setDelPicked({});
      if (gone.has(selectedRecFile)) { setSelectedRecFile(""); setReport(null); }
      const list = await api.getRecordings();
      setRecordings(list);
      if (gone.has(selectedRecFile)) setSelectedRecFile(list[0]?.file || "");
      setDelNotice({
        tone: r.failed.length ? "error" : "success",
        text:
          `Deleted ${r.deleted.length} recording(s).` +
          (r.failed.length ? ` ${r.failed.length} could not be deleted: ` + r.failed.map((f) => f.reason).join("; ") : ""),
      });
    } catch (e) {
      setDelNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setDelBusy(false);
    }
  }

  async function handleDownloadOne(rec) {
    try { await recordingsApi.exportRecording(rec.recording_id); }
    catch (e) { setRunError(e.detail || e.message); }
  }

  // ---- table: numbering, application list and column filters ------------
  // The "#" is the recording's place in the full list (not in the filtered view),
  // so typing a number in the # filter always finds that same recording.
  const numbered = useMemo(
    () => recordings.map((r, i) => ({ ...r, _no: i + 1, _when: fmtRecordedAt(r), _app: r.application || "Others" })),
    [recordings],
  );
  const appChoices = useMemo(() => Array.from(new Set(numbered.map((r) => r._app))).sort((a, b) => a.localeCompare(b)), [numbered]);
  const tableRows = useMemo(() => {
    const has = (hay, needle) => String(hay).toLowerCase().includes(needle.trim().toLowerCase());
    return numbered.filter(
      (r) =>
        (!filters.no.trim() || String(r._no) === filters.no.trim() || String(r._no).startsWith(filters.no.trim())) &&
        (!filters.app || r._app === filters.app) &&
        (!filters.name.trim() || has(r.name, filters.name)) &&
        (!filters.by.trim() || has(r.recorded_by || "", filters.by)) &&
        (!filters.when.trim() || has(r._when, filters.when)) &&
        (!filters.steps.trim() || String(r.action_count ?? 0).startsWith(filters.steps.trim())),
    );
  }, [numbered, filters]);
  const filtersActive = Object.values(filters).some((v) => v);
  const setFilter = (key) => (value) => setFilters((f) => ({ ...f, [key]: value }));
  const allShownPicked = tableRows.length > 0 && tableRows.every((r) => delPicked[r.file]);
  const colCount = isAdmin ? 8 : 7;

  async function handleCreateMenuCheck() {
    setMenuNotice(null);
    if (menuApp === "Others" && !menuUrl.trim()) {
      setMenuNotice({ tone: "error", text: "Enter the website address first." });
      return;
    }
    setMenuBusy(true);
    try {
      const r = await recordingsApi.createMenuCheck({
        app_name: menuApp === "Others" ? "" : menuApp,
        url: menuUrl,
        recording_name: menuName,
        menu_selector: menuSelector,
        strict_hover: menuStrict,
      });
      setMenuNotice({ tone: "success", text: `Created "${r.name}" for ${r.target_url} - it is selected in the table. Click "Run recording" to check the menu.` });
      setMenuUrl(""); setMenuName(""); setMenuSelector("");
      await loadRecordings();
      setSelectedRecFile(r.recording_file);
    } catch (e) {
      setMenuNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setMenuBusy(false);
    }
  }

  async function handleResetBaseline() {
    if (!selectedRecFile) return;
    if (!window.confirm("Forget the saved menu? The next run will save the menu as it is then, and compare later runs against that.")) return;
    setBaselineBusy(true);
    setBaselineNotice(null);
    try {
      await recordingsApi.resetMenuBaseline(selectedRecFile);
      setBaselineNotice({ tone: "success", text: "Baseline cleared - the next run saves a new one." });
      await loadRecordings();
    } catch (e) {
      setBaselineNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setBaselineBusy(false);
    }
  }

  async function handleExport() {
    if (!selectedRecording?.recording_id) return;
    setExportBusy(true);
    try { await recordingsApi.exportRecording(selectedRecording.recording_id); }
    catch (e) { setRunError(e.detail || e.message); }
    finally { setExportBusy(false); }
  }

  const thBase = "px-3 py-2 align-top";

  return (
    <div className="min-w-0 space-y-6">
      {/* ---- 1. Saved recordings table -------------------------------------- */}
      <Panel>
        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
          <div>
            <h2 className="text-sm font-semibold text-ink">Saved Recordings</h2>
            <p className="mt-0.5 text-xs text-muted">
              Use the boxes under each heading to filter. Click a row to open its test data and steps below, or press Run to execute it straight away.
            </p>
          </div>
          <div className="flex flex-wrap items-center gap-4">
            <Checkbox label="headless" checked={runHeadless} onChange={setRunHeadless} />
            {filtersActive && (
              <button type="button" className="text-xs font-medium text-brand-blue hover:underline" onClick={() => setFilters(EMPTY_FILTERS)}>
                Clear filters
              </button>
            )}
            {isAdmin && (
              <Button
                variant="secondary"
                onClick={() => handleDeleteRecordings(delPickedFiles)}
                disabled={delBusy || delPickedFiles.length === 0}
                className="!text-signal-rust"
              >
                {delBusy ? "Deleting…" : `🗑 Delete selected (${delPickedFiles.length})`}
              </Button>
            )}
          </div>
        </div>
        {recordingsError && <div className="px-5 pt-4"><Callout tone="error">Could not load recordings: {recordingsError}</Callout></div>}
        {delNotice && <div className="px-5 pt-4"><Callout tone={delNotice.tone}>{delNotice.text}</Callout></div>}
        {runError && <div className="px-5 pt-4"><Callout tone="error">Run failed: {runError}</Callout></div>}
        {validation && <div className="px-5 pt-4"><ValidationReport report={validation} onFix={handleFix} busy={validating} /></div>}
        {job && (
          <div className="px-5 pt-4">
            <ExecutionProgress
              job={job}
              connectionLost={connectionLost}
              busyAction={controlBusy}
              onPause={() => controlJob("pause")}
              onResume={() => controlJob("resume")}
              onCancel={() => controlJob("cancel")}
            />
          </div>
        )}
        {job?.status === "waiting_for_input" && job.input_request && !job.input_request.answered && (
          <RuntimeInputDialog
            key={job.input_request.request_id}
            jobId={job.job_id}
            request={job.input_request}
            onAnswered={() => setJob((j) => (j ? { ...j, status: "resuming", input_request: { ...j.input_request, answered: true } } : j))}
            onStop={() => controlJob("cancel")}
          />
        )}
        {runBusy && !job && <div className="px-5 pt-4"><Spinner label="Starting..." /></div>}
        <div className="px-2 py-3 sm:px-5">
          {recordings.length === 0 && !recordingsError ? (
            <p className="px-3 py-6 text-center text-sm text-muted">
              No saved recordings to show. Record one from the Record screen
              {!isAdmin && " — or ask an admin to give you access to an application"}.
            </p>
          ) : (
            <div className="max-h-[32rem] overflow-auto scroll-thin">
              <table className="w-full min-w-[52rem] border-collapse text-left text-sm">
                <thead className="sticky top-0 z-10 bg-panel shadow-[0_1px_0_0_#D8E1EF]">
                  <tr className="text-xs font-semibold text-slate-600">
                    {isAdmin && (
                      <th className={`${thBase} w-8`}>
                        <input
                          type="checkbox"
                          aria-label="Select all shown recordings"
                          checked={allShownPicked}
                          onChange={(e) =>
                            setDelPicked((prev) => {
                              const next = { ...prev };
                              tableRows.forEach((r) => { if (e.target.checked) next[r.file] = true; else delete next[r.file]; });
                              return next;
                            })
                          }
                        />
                      </th>
                    )}
                    <th className={`${thBase} w-20`}>
                      <div className="mb-1">#</div>
                      <ColumnFilter value={filters.no} onChange={setFilter("no")} placeholder="No." label="Filter by number" />
                    </th>
                    <th className={`${thBase} w-44`}>
                      <div className="mb-1">Application</div>
                      <select
                        value={filters.app}
                        onChange={(e) => setFilter("app")(e.target.value)}
                        aria-label="Filter by application"
                        className="w-full rounded-sm border border-line bg-white px-1.5 py-1 text-xs font-normal text-ink focus:border-brand-blue focus:outline-none"
                      >
                        <option value="">All</option>
                        {appChoices.map((a) => <option key={a} value={a}>{a}</option>)}
                      </select>
                    </th>
                    <th className={thBase}>
                      <div className="mb-1">Recording Name</div>
                      <ColumnFilter value={filters.name} onChange={setFilter("name")} placeholder="Search name" label="Filter by recording name" />
                    </th>
                    <th className={`${thBase} w-40`}>
                      <div className="mb-1">Recorded By</div>
                      <ColumnFilter value={filters.by} onChange={setFilter("by")} placeholder="Search user" label="Filter by user who recorded" />
                    </th>
                    <th className={`${thBase} w-52`}>
                      <div className="mb-1">Date &amp; Time</div>
                      <ColumnFilter value={filters.when} onChange={setFilter("when")} placeholder="e.g. 2026-10-22" label="Filter by date and time" />
                    </th>
                    <th className={`${thBase} w-28`}>
                      <div className="mb-1">Total Steps</div>
                      <ColumnFilter value={filters.steps} onChange={setFilter("steps")} placeholder="e.g. 25" label="Filter by total steps" />
                    </th>
                    <th className={`${thBase} text-right`}><div className="mb-1">Actions</div></th>
                  </tr>
                </thead>
                <tbody>
                  {tableRows.map((r) => (
                    <tr
                      key={r.file}
                      onClick={() => setSelectedRecFile(r.file)}
                      className={`cursor-pointer border-t border-line hover:bg-rail ${r.file === selectedRecFile ? "bg-brand-blueLight" : ""}`}
                    >
                      {isAdmin && (
                        <td className="px-3 py-3" onClick={(e) => e.stopPropagation()}>
                          <input
                            type="checkbox"
                            aria-label={`Select ${r.name}`}
                            checked={!!delPicked[r.file]}
                            onChange={(e) =>
                              setDelPicked((prev) => {
                                const next = { ...prev };
                                if (e.target.checked) next[r.file] = true; else delete next[r.file];
                                return next;
                              })
                            }
                          />
                        </td>
                      )}
                      <td className="px-3 py-3 text-muted">{r._no}</td>
                      <td className="px-3 py-3 font-medium text-ink">{r._app}</td>
                      <td className="max-w-xs break-words px-3 py-3 text-ink">
                        {r.name}
                        {r.migration_status && r.migration_status !== "NATIVE" && r.migration_status !== "UNKNOWN" && (
                          <span className="ml-2 rounded bg-rail px-1.5 py-0.5 text-[10px] font-semibold text-muted">{r.migration_status}</span>
                        )}
                      </td>
                      <td className="break-words px-3 py-3 text-ink">{r.recorded_by || <span className="text-muted">-</span>}</td>
                      <td className="whitespace-nowrap px-3 py-3 text-muted">{r._when}</td>
                      <td className="px-3 py-3 font-mono text-ink">{r.action_count ?? 0}</td>
                      <td className="px-3 py-3" onClick={(e) => e.stopPropagation()}>
                        <div className="flex items-center justify-end gap-2">
                          <Button onClick={() => handleRun(r.file)} disabled={runBusy} className="!px-4 !py-1.5">Run</Button>
                          <button
                            type="button"
                            title={r.recording_id ? "Download recording package" : "Download is not available for this older recording"}
                            disabled={!r.recording_id}
                            onClick={() => handleDownloadOne(r)}
                            className="rounded-lg border border-line p-2 text-brand-blue hover:border-brand-blue disabled:cursor-not-allowed disabled:opacity-30"
                          >
                            <svg viewBox="0 0 20 20" fill="currentColor" className="h-4 w-4"><path fillRule="evenodd" d="M10 3a1 1 0 011 1v7.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 11.586V4a1 1 0 011-1zM4 15a1 1 0 011 1v1h10v-1a1 1 0 112 0v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1a1 1 0 011-1z" clipRule="evenodd" /></svg>
                          </button>
                          {isAdmin && (
                            <button
                              type="button"
                              title="Delete recording (admin only)"
                              onClick={() => handleDeleteRecordings([r.file])}
                              className="rounded-lg border border-line p-2 text-signal-rust hover:border-signal-rust"
                            >
                              <svg viewBox="0 0 20 20" fill="currentColor" className="h-4 w-4"><path fillRule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clipRule="evenodd" /></svg>
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}
                  {tableRows.length === 0 && (
                    <tr><td colSpan={colCount} className="px-3 py-6 text-center text-sm text-muted">Nothing matches these filters.</td></tr>
                  )}
                </tbody>
              </table>
            </div>
          )}
          {recordings.length > 0 && (
            <p className="mt-2 px-1 text-xs text-muted">
              Showing {tableRows.length} of {recordings.length} recording{recordings.length === 1 ? "" : "s"}.
            </p>
          )}
        </div>
      </Panel>

      {/* ---- 2. Run controls for the recording picked in the table ----------- */}
      {selectedRecording && (
        <Panel>
          <div className="space-y-3 px-5 py-4">
            <div className="flex flex-wrap items-center gap-x-4 gap-y-2">
              <div className="min-w-0">
                <p className="truncate text-sm font-semibold text-ink">{selectedRecording.name}</p>
                <p className="text-xs text-muted">
                  {selectedRecording.application || "Others"} · {selectedRecording.action_count ?? 0} steps ·{" "}
                  {selectedRecording.is_owner ? "you own it" : selectedRecording.is_shared ? "shared with you" : "open to everyone with access to this application"}
                </p>
              </div>
              <div className="ml-auto flex flex-wrap items-center gap-2">
                <Button onClick={() => handleRun()} disabled={runBusy}>{runBusy ? "Running..." : "▶ Run recording"}</Button>
                {runBusy && job && <Button variant="secondary" onClick={() => controlJob("cancel")} disabled={!!controlBusy}>⬛ Stop</Button>}
                <Button variant="secondary" onClick={handleRegenerate} disabled={regenBusy} title="Refresh this recording's generated feature/steps/page files without running anything">
                  {regenBusy ? "Regenerating..." : "Regenerate"}
                </Button>
                {selectedRecording.recording_id && (
                  <Link href={`/recordings/${selectedRecording.recording_id}`} className="inline-flex items-center px-2 py-2 text-sm font-medium text-signal-slate underline decoration-line underline-offset-4 hover:text-ink">
                    View details →
                  </Link>
                )}
                {selectedRecording.is_owner && <Button variant="ghost" onClick={() => setShareDialogOpen(true)}>Share</Button>}
                <Button variant="ghost" onClick={handleExport} disabled={exportBusy}>{exportBusy ? "Exporting..." : "Export"}</Button>
              </div>
            </div>

            {shareDialogOpen && (
              <ShareDialog recordingId={selectedRecording.recording_id} recordingName={selectedRecording.name} onClose={() => setShareDialogOpen(false)} />
            )}

            {selectedRecording.recording_id && (
              <RuntimeConfigPanel
                key={`${selectedRecording.recording_id}-${runtimeReload}`}
                recordingId={selectedRecording.recording_id}
                values={runtimeValues}
                onChange={setRuntimeValues}
                onLoaded={setRuntimeVars}
              />
            )}

            {firstFailedStep && (
              <Callout tone="info">
                Last run first failed at step {firstFailedStep}.{" "}
                <button type="button" className="font-semibold text-brand-blue underline" onClick={() => setResumeFrom(String(firstFailedStep))}>
                  Resume from step {firstFailedStep}
                </button>
              </Callout>
            )}

            {selectedRecording.has_menu_check && (
              <div className="space-y-2">
                <Callout>
                  This is a navigation menu check.{" "}
                  {selectedRecording.menu_baseline_count > 0
                    ? `Baseline saved: ${selectedRecording.menu_baseline_count} menu links${selectedRecording.menu_baseline_saved_at ? ` (${selectedRecording.menu_baseline_saved_at} UTC)` : ""}. A link that disappears or points somewhere else is reported as failed.`
                    : "No baseline yet - the first run saves the menu as it is, and later runs are compared against it."}
                </Callout>
                {selectedRecording.menu_baseline_count > 0 && (
                  <Button variant="ghost" onClick={handleResetBaseline} disabled={baselineBusy}>
                    {baselineBusy ? "Clearing..." : "Menu changed on purpose? Reset baseline"}
                  </Button>
                )}
                {baselineNotice && <Callout tone={baselineNotice.tone}>{baselineNotice.text}</Callout>}
              </div>
            )}

            {regenNotice && <Callout tone={regenNotice.tone}>{regenNotice.text}</Callout>}
            {regenFiles && (
              <div className="flex flex-wrap gap-2">
                {[
                  { path: regenFiles.feature_file, label: "Feature file" },
                  { path: regenFiles.steps_file, label: "Steps (.py)" },
                  { path: regenFiles.page_file, label: "Page object (.py)" },
                  { path: regenFiles.locators_file, label: "Locators (.json)" },
                ].map(({ path, label }) =>
                  path && (
                    <button key={path} type="button"
                      className="rounded-sm border border-line bg-panel px-2.5 py-1 text-xs font-medium text-brand-blue hover:border-brand-blue/40 disabled:opacity-40"
                      disabled={downloadingRegen === path}
                      onClick={() => handleDownloadRegenFile(path, label)}>
                      {downloadingRegen === path ? "Downloading..." : `⬇ ${label}`}
                    </button>
                  )
                )}
              </div>
            )}

            <Disclosure title="Resume from a step (optional)" defaultOpen={!!resumeFrom}>
              <div className="grid gap-3 sm:grid-cols-2">
                <Field label="Start from step number" hint="Leave empty to run all steps. Steps before this are skipped and shown as Skipped in the report.">
                  <TextInput type="number" min="2" value={resumeFrom} onChange={(e) => setResumeFrom(e.target.value)} placeholder="e.g. 400" />
                </Field>
                <Field label="Always run the first N steps" hint="Use this for steps the page needs first, such as opening the site and logging in (e.g. 12).">
                  <TextInput type="number" min="0" value={resumeSetup} onChange={(e) => setResumeSetup(e.target.value)} />
                </Field>
                {resumeFrom && (
                  <button type="button" className="text-left text-xs font-medium text-brand-blue" onClick={() => setResumeFrom("")}>
                    Clear - run all steps
                  </button>
                )}
              </div>
            </Disclosure>
          </div>
        </Panel>
      )}

      {/* ---- 3. Test data (full width, below the table) ---------------------- */}
      {selectedRecFile && (
        <Panel>
          <div className="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
            <div>
              <h2 className="text-sm font-semibold text-ink">Test data</h2>
              <p className="mt-0.5 text-xs text-muted">The values this recording types/selects when it runs. Edit anything below, then hit <strong>Run recording</strong>.</p>
            </div>
            {testData.length > 0 && (
              <Button variant="secondary" onClick={saveTestDataOnly} disabled={savingData}>
                {savingData ? "Saving..." : "Save without running"}
              </Button>
            )}
          </div>
          <div className="px-5 py-4">
            {testDataLoading && <Spinner label="Loading test data..." />}
            {testDataError && <Callout tone="error">{testDataError}</Callout>}
            {saveDataError && <Callout tone="error">{saveDataError}</Callout>}
            {saveDataNotice && <Callout tone="success">{saveDataNotice}</Callout>}
            {!testDataLoading && !testDataError && testData.length === 0 && (
              <p className="text-sm text-muted">This recording has no typed or selected values to edit.</p>
            )}
            {testData.length > 0 && (
              <div className="mt-2 max-h-[28rem] w-full overflow-auto rounded-sm border border-line scroll-thin">
                <table className="w-full min-w-[40rem] border-collapse text-left text-sm">
                  <thead className="sticky top-0 bg-rail">
                    <tr>
                      <th className="w-12 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600">#</th>
                      <th className="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600">Field</th>
                      <th className="w-36 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600">Type</th>
                      <th className="w-[45%] px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600">Value</th>
                    </tr>
                  </thead>
                  <tbody>
                    {testData.map((f, i) => (
                      <tr key={f.index} className="border-t border-line odd:bg-panel even:bg-[#FBFDFF]">
                        <td className="px-3 py-2 text-xs text-muted">{i + 1}</td>
                        <td className="px-3 py-2 align-middle text-ink">{f.label}</td>
                        <td className="px-3 py-2 align-middle font-mono text-[13px] text-slate-600">{f.action}</td>
                        <td className="px-2 py-1.5">
                          <TextInput value={editValues[f.index] ?? ""} onChange={(e) => updateValue(f.index, e.target.value)} />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </Panel>
      )}

      {/* ---- 4. Excel-style step editor (full width, below the test data) ---- */}
      {selectedRecFile && <StepEditor recordingFile={selectedRecFile} reloadKey={stepsReload} onSaved={() => { loadTestData(selectedRecFile); loadRecordings(); setRuntimeReload((n) => n + 1); }} />}

      {selectedRecording?.recording_id && <VersionHistory recordingId={selectedRecording.recording_id} />}
      {job && job.job_id && <ExecutionDetails job={job} hideAssertions hideRerunExport />}
      {report && <ReportView key={report.transaction_id} report={report} />}
      {!selectedRecFile && recordings.length > 0 && (
        <Panel><div className="px-5 py-10 text-center text-sm text-muted">Pick a saved recording to review its test data and run it.</div></Panel>
      )}

      {/* ---- 5. Less-used tool, kept out of the way -------------------------- */}
      {(
        <Disclosure title="Create a navigation menu check (no recording needed)">
          <div className="grid gap-3 sm:grid-cols-2">
            <p className="text-xs text-muted sm:col-span-2">
              Checks every link in the site&apos;s menu - Personal Banking &gt; Accounts &gt; Saving Account and so on. On each
              run it opens the menus with the mouse, clicks every link and verifies the page that opens. Nobody has
              to hover or record anything.
            </p>
            <Field label="Application">
              <Select value={menuApp} onChange={(e) => setMenuApp(e.target.value)}>
                {applicationNames.map((name) => (
                  <option key={name} value={name}>{name}</option>
                ))}
              </Select>
            </Field>
            {menuApp === "Others" && (
              <Field label="Website address">
                <TextInput value={menuUrl} onChange={(e) => setMenuUrl(e.target.value)} placeholder="https://ca.statebank" />
              </Field>
            )}
            <Field label="Name">
              <TextInput value={menuName} onChange={(e) => setMenuName(e.target.value)} placeholder="Optional, e.g. Navbar regression" />
            </Field>
            <Field label="Menu selector" hint="Leave blank - the menu is found automatically. Fill in a CSS selector (e.g. nav or #main-menu) only if the wrong menu gets picked.">
              <TextInput value={menuSelector} onChange={(e) => setMenuSelector(e.target.value)} placeholder="Optional" />
            </Field>
            <div className="sm:col-span-2"><Checkbox label="Fail a link if its menu does not open on hover" checked={menuStrict} onChange={setMenuStrict} /></div>
            <div className="sm:col-span-2">
              <Button variant="secondary" onClick={handleCreateMenuCheck} disabled={menuBusy}>
                {menuBusy ? "Creating..." : "Create menu check"}
              </Button>
            </div>
            {menuNotice && <div className="sm:col-span-2"><Callout tone={menuNotice.tone}>{menuNotice.text}</Callout></div>}
          </div>
        </Disclosure>
      )}
    </div>
  );
}
