@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
}

html,
body {
  background: #f4f7fc;
  color: #0b1e3d;
}

body {
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
}

::selection {
  background: #163c8c;
  color: #f4f7fc;
}

/* Focus ring: visible, not decorative */
:focus-visible {
  outline: 2px solid #163c8c;
  outline-offset: 2px;
}

/* Thin scrollbars for log/output panels */
.scroll-thin::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
.scroll-thin::-webkit-scrollbar-track {
  background: transparent;
}
.scroll-thin::-webkit-scrollbar-thumb {
  background: #c3d2e8;
  border-radius: 4px;
}

@keyframes pulse-dot {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}
.pulse-dot {
  animation: pulse-dot 1.4s ease-in-out infinite;
}
