"""Automatic Code Generation (Section 6).

Turns an accepted recording into real artefacts inside the Python +
Selenium + `behave` execution framework (`python-framework/`):

    features/transactions/Transaction_<id>/Transaction<id>.feature
    features/steps/transaction_<id>_steps.py
    pages/transaction_<id>_page.py
    test-data/<ENV>/transaction_<id>.json

(No separate per-transaction runner file is generated — python-framework/run.py
is fully generic and drives any transaction id straight from its feature
file path.)

Rules:
  • The Framework Indexing Engine is queried FIRST — reuse beats duplication.
  • Existing files are updated, never blindly replaced; hand-written code
    between the CUSTOM markers is preserved.
  • The AI never regenerates the framework itself, only extends it.
"""
from __future__ import annotations

import re
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Optional
from jinja2 import Environment, FileSystemLoader, StrictUndefined

from ..core.config import settings
from ..core.logging_conf import get_logger
from ..framework_index import indexer
from ..recorder import locator_builder
from ..tdm import templates as tdm_templates
from . import naming

log = get_logger(__name__)

TEMPLATE_DIR = Path(__file__).parent / "templates"
_env = Environment(
    loader=FileSystemLoader(str(TEMPLATE_DIR)),
    undefined=StrictUndefined,
    trim_blocks=False,
    lstrip_blocks=False,
    keep_trailing_newline=True,
)

CUSTOM_START = "# === CUSTOM CODE START"
CUSTOM_END = "# === CUSTOM CODE END ==="


def _py_string(value: str) -> str:
    """Escape a value for embedding inside a Python double-quoted string
    literal.

    Gherkin patterns contain double quotes around field labels; unescaped
    they terminate the string and produce a SyntaxError in the generated
    step definition. Recorded element/validation text can also contain
    literal backslashes or embedded newlines — either would just as
    surely break the string literal open, so those are escaped too.
    Backslashes are escaped FIRST so a later replacement's own backslash
    doesn't get re-escaped.
    """
    return (
        (value or "")
        .replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )


ACTION_VERBS = {
    "click": "clicks",
    "type": "enters",
    "select": "selects",
    "check": "checks",
    "uncheck": "unchecks",
    "upload": "uploads",
    "submit": "submits",
    "navigate": "navigates to",
    "drag_drop": "drags",
}

# Files whose step definitions are INTENTIONALLY shared across every
# transaction — the same physical element genuinely is the same one
# every time (the global login form, the top-menu "Home" button, the
# generic negative-scenario helper). A step found in ANY OTHER file
# (i.e. another transaction's own transaction<id>_steps.py) is never
# safe to silently reuse — see the reuse-vs-disambiguate decision in
# _step_models() for the real bug this specifically fixes.
_SHARED_STEP_FILES = frozenset({
    "common_steps.py", "transaction_9750_steps.py", "negative_steps.py",
})

_STEP_DECORATOR_RE = re.compile(
    r'@(?:given|when|then|step)\s*\(\s*"((?:[^"\\]|\\.)*)"\s*\)'
)


def _scan_existing_step_patterns(exclude_files: set[Path] | None = None) -> dict[str, str]:
    """Direct, deterministic scan of every step file already on disk for
    `@given/@when/@then/@step("...")` patterns.

    The Framework Index (Section 8) is only refreshed by an explicit
    `python scripts/reindex.py` — relying on it ALONE to prevent behave's
    `AmbiguousStep` at generation time is unsafe: a transaction generated
    since the last reindex is invisible to `indexer.find_step_definition()`,
    so an identical step (e.g. a generic "user clicks \"Home\"") generated
    independently for two different transactions slips through undetected
    at generation time and only surfaces the moment `behave` tries to load
    BOTH files together at execution — aborting the whole run before a
    single scenario runs. This scan is cheap (a handful of files, done
    once per generation call) and always current.
    """
    exclude_files = {p.resolve() for p in (exclude_files or set())}
    steps_dir = settings.framework_src_path / "features" / "steps"
    found: dict[str, str] = {}
    if not steps_dir.exists():
        return found
    for path in steps_dir.glob("*.py"):
        if path.resolve() in exclude_files:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for match in _STEP_DECORATOR_RE.finditer(text):
            raw_pattern = match.group(1).replace('\\"', '"')
            found.setdefault(raw_pattern, str(path))
    return found


class GenerationResult(dict):
    """{artifact_type: file_path} plus a reuse report."""


# ── preserved custom blocks ─────────────────────────────────────────────
def _extract_custom(path: Path) -> str:
    if not path.exists():
        return ""
    text = path.read_text(encoding="utf-8", errors="ignore")
    start = text.find(CUSTOM_START)
    end = text.find(CUSTOM_END)
    if start == -1 or end == -1 or end < start:
        return ""
    block = text[text.find("\n", start) + 1 : end]
    return block.rstrip()


def _reinject_custom(rendered: str, custom: str) -> str:
    if not custom.strip():
        return rendered
    start = rendered.find(CUSTOM_START)
    end = rendered.find(CUSTOM_END)
    if start == -1 or end == -1:
        return rendered
    head = rendered[: rendered.find("\n", start) + 1]
    tail = rendered[end:]
    return head + custom + "\n" + tail


def _write(path: Path, content: str) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    custom = _extract_custom(path)
    path.write_text(_reinject_custom(content, custom), encoding="utf-8")
    log.info("Generated %s", path)
    return str(path)


# ── model building ──────────────────────────────────────────────────────
def _clean_label(value: Any) -> str:
    """Collapse whatever whitespace a recorded label/text came with —
    including embedded newlines/tabs — into single spaces.

    A recorded element's visible text can genuinely span multiple
    physical lines in the real UI (a wrapped button caption, a two-line
    field label) and that gets captured verbatim, newline and all. Left
    as-is, that newline lands directly inside a generated `.feature`
    file's step line — Gherkin is a LINE-based grammar, so the second
    half of the label then appears as its own line with no Given/When/
    Then/And keyword in front of it, and behave's parser rejects the
    whole file with a ParserError pointing at that orphaned continuation
    line rather than at the real cause.
    """
    return " ".join(str(value or "").split())


def _element_models(elements: list[dict[str, Any]]) -> list[dict[str, Any]]:
    models, used = [], set()
    for element in elements:
        key = element["element_key"]
        const = naming.constant(key.split("::")[-1])
        while const in used:
            const += "_X"
        used.add(const)
        locators = element.get("locators", [])
        if isinstance(locators, list) and locators and isinstance(locators[0], dict):
            python_locators = [
                {"python": locator_builder.to_python_by(loc)} for loc in locators[:5]
            ]
        else:
            python_locators = [{"python": '(By.XPATH, "//*")'}]
        models.append({
            "element_key": key,
            "constant": const,
            "getter": naming.method_for_action("get", key),
            "element_type": element.get("element_type"),
            "label": _clean_label(element.get("label")),
            "page_key": element.get("page_key"),
            "locators": python_locators,
        })
    return models


# The platform's OWN shared app-search box (owned by
# python-framework/pages/transaction_search_page.py under its own
# `search::transaction_box` element key) — a transaction's own
# RECORDING can end up capturing a SECOND, generic "type"/"click"
# action on this exact same physical element (its id/name is
# `appSearch`), alongside the platform's dedicated, already-correct
# "user searches for transaction ..." step. Left in, that duplicate
# action re-types into (and can reset/break) the very search that
# already navigated to the transaction — using a value that has no
# real test-data behind it, since it was never a genuine business
# field, producing an empty string that clears the search box and
# leaves the browser back on the app dashboard. Real, observed
# real-world symptom this exact filter fixes: a 40+ second
# "Could not resolve ...::accntname" failure immediately after a
# `user enters "" in "Enter screen number or part of screen name"`
# step that should never have been generated at all.
_RESERVED_ELEMENT_SIGNATURES: tuple[dict[str, str], ...] = (
    {"id": "appSearch"}, {"name": "appSearch"},
)


def _is_reserved_element(element: dict[str, Any]) -> bool:
    attrs = (element.get("meta") or {}).get("attributes") or element.get("attributes") or {}
    for sig in _RESERVED_ELEMENT_SIGNATURES:
        if all(attrs.get(k) == v for k, v in sig.items()):
            return True
    if "appSearchText" in (attrs.get("class") or ""):
        return True
    return False


def _strip_reserved_elements(
    elements: list[dict[str, Any]], field_metadata: list[dict[str, Any]] | None,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]] | None]:
    """Removes the reserved search-box element from both the element
    list (so no action referencing it generates a step — see
    `_step_models()`'s `if not element: continue`) and from
    field_metadata (so it never becomes an auto-generated negative
    scenario either)."""
    kept_elements = [e for e in elements if not _is_reserved_element(e)]
    dropped_keys = {e["element_key"] for e in elements if _is_reserved_element(e)}
    kept_fields = (
        [f for f in field_metadata if f.get("element_key") not in dropped_keys]
        if field_metadata else field_metadata
    )
    return kept_elements, kept_fields


def _action_models(
    actions: list[dict[str, Any]], element_models: list[dict[str, Any]]
) -> list[Optional[dict[str, Any]]]:
    """One entry per action, SAME LENGTH AND ORDER as `actions`.

    `_step_models()` below indexes into this list with the *same* index it
    uses for `actions` (`action_models[index]`), so this must never drop or
    reorder entries — an action with no matching element becomes `None`
    here rather than being skipped, otherwise every action after the first
    skip would line up with the wrong page-object method and the generated
    step definition would call a method that doesn't exist on the page
    object (`AttributeError` at run time).
    """
    by_key = {e["element_key"]: e for e in element_models}
    models: list[Optional[dict[str, Any]]] = []
    used = set()
    for action in actions:
        key = action.get("element_key") or ""
        element = by_key.get(key)
        if not element:
            models.append(None)
            continue
        verb = action.get("action", "click")
        if verb == "scroll":
            # A recorded scroll is real, useful EVIDENCE (kept in the
            # manifest/knowledge package as-is) — but it doesn't need
            # its OWN generated step: `_ensure_visible()`
            # (python-framework/core/base_page.py) already scrolls
            # every element into view automatically before every
            # interaction, so a step here would be redundant at best.
            # Worse than redundant if left to fall through to the
            # generic "unknown verb" branch below, which defaults to
            # `self.click(...)` — silently generating a CLICK on the
            # scrolled container instead, which is a real, wrong action.
            models.append(None)
            continue
        method = naming.method_for_action(verb, key)
        while method in used:
            method += "X"
        used.add(method)
        if verb == "type":
            params = ", value: str"
            body = f'self.type({element["constant"]}, value)'
        elif verb == "select":
            params = ", value: str"
            body = f'self.select_by_visible_text({element["constant"]}, value)'
        elif verb in ("check", "uncheck"):
            params = ""
            body = f'self.set_checkbox({element["constant"]}, {str(verb == "check")})'
        elif verb == "upload":
            params = ", file_path: str"
            body = f'self.upload_file({element["constant"]}, file_path)'
        elif verb == "drag_drop":
            target_key = action.get("target_element_key")
            target = by_key.get(target_key) if target_key else None
            params = ""
            if target:
                body = f'self.drag_and_drop({element["constant"]}, {target["constant"]})'
            else:
                # Recorded without a resolvable drop target (e.g. the
                # target element didn't survive dedup/filtering) — fall
                # back to a plain click on the source rather than
                # generating a call to drag_and_drop() with a target
                # constant that doesn't exist.
                body = f'self.click({element["constant"]})'
        else:
            params = ""
            body = f'self.click({element["constant"]})'
        models.append({
            "method": method,
            "params": params,
            "body": body,
            "comment": f"{verb} on {element.get('label') or key}",
        })
    return models


def _step_models(
    actions: list[dict[str, Any]],
    element_models: list[dict[str, Any]],
    action_models: list[Optional[dict[str, Any]]],
    transaction_id: str,
    existing_patterns: dict[str, str],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    """Return (gherkin steps, python step functions, reuse notes)."""
    by_key = {e["element_key"]: e for e in element_models}
    gherkin: list[dict[str, str]] = []
    py_steps: list[dict[str, Any]] = []
    reuse_notes: list[str] = []
    used_methods: set[str] = set()
    used_patterns: set[str] = set()

    for index, action in enumerate(actions):
        key = action.get("element_key") or ""
        element = by_key.get(key)
        if not element:
            continue
        verb = action.get("action", "click")
        label = _clean_label(element.get("label")) or key.split("::")[-1]
        page_key = element.get("page_key") or ""
        action_model = action_models[index] if index < len(action_models) else None
        page_method = action_model["method"] if action_model else None
        if page_method is None:
            continue

        # Two elements can legitimately share the same label on different
        # screens (e.g. "Submit", "Remarks", "Account Number" repeated
        # across pages in a banking UI). Since the Gherkin PATTERN is built
        # from the label alone, that produces two step definitions with the
        # identical @when/@given text — behave raises an AmbiguousStep
        # error at runtime, not at generation time, so it only surfaces
        # during execution. Disambiguate with page context, and an index
        # as a last-resort tiebreaker for a genuine same-label-same-page
        # duplicate.
        display_label = label

        def _pattern_for(lbl: str) -> str:
            if verb in ("type", "select", "upload"):
                # MUST match the placeholder text actually written into
                # the generated file byte-for-byte (see the `gherkin_
                # quoted_pattern` block below) — this `pattern` value is
                # also used as the reuse/dedup lookup key against
                # `existing_patterns` a few lines down. It used to build
                # a literal "{}" here and only convert it to "{value}"
                # later (for the file), so the dedup lookup was
                # comparing "...{}..." against disk-scanned "...{value}
                # ..." entries and never matched — every parameterised
                # step (type/select/upload) silently skipped dedup no
                # matter how many transactions already defined the exact
                # same field, while plain clicks (no placeholder, no
                # mismatch) deduped correctly. That's why "Home" (a
                # click) deduped fine but "Account Number" (a type action)
                # didn't.
                return f'user {ACTION_VERBS.get(verb, verb)} "{{value}}" in "{lbl}"'
            return f'user {ACTION_VERBS.get(verb, verb)} "{lbl}"'

        pattern = _pattern_for(display_label)
        # A collision with a step from ANOTHER transaction's own
        # generated file is only safe to silently REUSE if that file is
        # one of the intentionally-shared ones (common_steps.py, the
        # 9750 pre-step, negative_steps.py) — genuinely the same
        # physical element every time (the global "Home" nav button,
        # the shared login form, ...). A collision with a step in
        # ANOTHER transaction's own transaction<id>_steps.py is NOT
        # safe to reuse: two different screens legitimately share an
        # English label like "Account Number" or "Submit" while being
        # completely different physical elements with different
        # locators — reusing that step silently makes the NEW
        # transaction call the OLD transaction's page-object method
        # against the wrong element (real-world symptom this caused:
        # transaction 1010's "Account Number" click/type silently
        # reused transaction 400's, producing a ~30-60s hang while it
        # tried to resolve a locator that isn't on this screen, then
        # entered an empty value into whatever it eventually found).
        # Such a collision must be DISAMBIGUATED instead — same
        # page_key-suffix mechanism already used for a same-transaction
        # collision below, just also triggered by a cross-transaction one.
        def _unsafe_cross_txn_collision(p: str) -> bool:
            source = existing_patterns.get(p)
            return bool(source) and Path(source).name not in _SHARED_STEP_FILES

        if (pattern in used_patterns or _unsafe_cross_txn_collision(pattern)) and page_key:
            display_label = f"{label} ({page_key})"
            pattern = _pattern_for(display_label)
        if pattern in used_patterns or _unsafe_cross_txn_collision(pattern):
            display_label = f"{label} ({page_key or 'step'} #{index})"
            pattern = _pattern_for(display_label)
        used_patterns.add(pattern)

        if verb in ("type", "select", "upload"):
            variable = action.get("value_ref") or naming.variable(
                action.get("field_name") or label
            )
            text = f'user {ACTION_VERBS.get(verb, verb)} "<{variable}>" in "{display_label}"'
            params = ", value"
            body = f"page.{page_method}(data.resolve(value))"
        else:
            text = f'user {ACTION_VERBS.get(verb, verb)} "{display_label}"'
            params = ""
            body = f"page.{page_method}()"

        keyword = "when" if index == 0 else "step"
        gherkin.append({"keyword": "When" if index == 0 else "And", "text": text})

        # ── reuse check: disk scan (authoritative, always current) first,
        # then the Framework Index (Section 8) for anything the exact-text
        # scan didn't catch. See _scan_existing_step_patterns()'s docstring
        # for why the disk scan has to be the primary check.
        existing_file = existing_patterns.get(pattern)
        if existing_file and Path(existing_file).name in _SHARED_STEP_FILES:
            reuse_notes.append(
                f"Reused existing step definition in {Path(existing_file).name} "
                f"for: {pattern}"
            )
            continue
        try:
            existing = indexer.find_step_definition(pattern)
        except Exception:
            existing = []
        if existing:
            reuse_notes.append(
                f"Reused existing step definition "
                f"{existing[0].get('class_name') or existing[0].get('module')}"
                f".{existing[0]['method_name']} for: {pattern}"
            )
            continue

        method = naming.camel(f"step_{verb}_{label}_{index}")
        while method in used_methods:
            method += "X"
        used_methods.add(method)

        # `pattern` (computed above by `_pattern_for`) already has the
        # real "{value}" placeholder text for a type/select/upload verb —
        # it's the exact same string that goes into the generated file
        # below, which is what makes the dedup lookup above actually work.
        if verb in ("type", "select", "upload"):
            gherkin_quoted_pattern = pattern
            fn_params = ", value"
        else:
            gherkin_quoted_pattern = pattern
            fn_params = ""

        py_steps.append({
            "annotation": "when" if index == 0 else "step",
            "pattern": _py_string(gherkin_quoted_pattern),
            "method": method,
            "params": fn_params,
            "body": body,
        })

    return gherkin, py_steps, reuse_notes


def _validation_models(rules: list[dict[str, Any]]) -> list[dict[str, Any]]:
    models, used = [], set()
    for rule in rules:
        text = rule.get("message_text") or rule.get("expression") or ""
        if not text:
            continue
        method = naming.camel("is_" + (rule.get("severity") or "info") + "_" + text[:30])
        while method in used:
            method += "X"
        used.add(method)
        models.append({"method": method, "message_text": _py_string(text)})
    return models


def _synthesize_invalid_value(pattern: str | None) -> str:
    """A deliberately-wrong sample value for a field's pattern, used to
    drive a negative ("invalid format") scenario."""
    if not pattern:
        return "@@INVALID@@"
    has_digit_class = any(tok in pattern for tok in ("\\d", "0-9"))
    has_alpha_class = any(tok in pattern for tok in ("A-Za-z", "a-zA-Z", "A-Z", "a-z"))
    if has_digit_class and not has_alpha_class:
        return "ABCDEF"          # expects digits -> feed letters
    if has_alpha_class and not has_digit_class:
        return "123456"          # expects letters -> feed digits
    return "@@INVALID@@"


def _negative_scenarios(
    field_metadata: list[dict[str, Any]] | None,
    actions: list[dict[str, Any]],
    transaction_id: str,
) -> list[dict[str, Any]]:
    """Auto-derive negative-path scenarios from what's already known about
    each recorded field (required / pattern).

    Recording only ever captures the happy path a user walked through — it
    never sees what happens on a wrong input, because nobody deliberately
    breaks their own transaction while recording it. But every recorded
    field already carries a `required` flag and (often) a `pattern` from
    field_meta — enough to derive real negative coverage without asking
    anyone to record failure paths by hand. These reuse the generic,
    shared python-framework/features/steps/negative_steps.py rather than
    generating new per-transaction code, since the pattern is always
    identical: clear/corrupt a field, submit, confirm the app pushes back.
    """
    if not field_metadata:
        return []
    submit_key = None
    for action in reversed(actions):
        if action.get("action") == "click":
            submit_key = action.get("element_key")
            break
    if not submit_key:
        return []  # no known submit button -> nothing safe to generate

    # The search box (search::transaction_box) is a SHARED, platform-level
    # element — the persistent "search for a screen" control every
    # transaction starts from (TransactionSearchPage/common_steps.py), not
    # a field that belongs to THIS transaction's own form. If it shows up
    # in field_metadata (it can, once it's properly recorded), generating
    # a negative scenario for it produces an incoherent test: "search for
    # 400 successfully, then type garbage into that SAME search box and
    # click 400's unrelated Submit button" doesn't exercise anything real.
    PLATFORM_ELEMENT_PREFIXES = ("search::",)

    scenarios: list[dict[str, Any]] = []
    for meta in field_metadata:
        element_key = meta.get("element_key")
        field = meta.get("field") or ""
        if not element_key or element_key == submit_key:
            continue
        if any(element_key.startswith(p) for p in PLATFORM_ELEMENT_PREFIXES):
            continue
        if meta.get("required"):
            scenarios.append({
                "name": f"{field} is required",
                "steps": [
                    {"keyword": "Given",
                     "text": f'user searches for transaction "{transaction_id}"'},
                    {"keyword": "When",
                     "text": f'user clears "{element_key}" and submits via "{submit_key}"'},
                    {"keyword": "Then", "text": "a validation message is shown"},
                ],
            })
        pattern = meta.get("pattern")
        if pattern:
            bad_value = _synthesize_invalid_value(pattern)
            scenarios.append({
                "name": f"{field} rejects an invalid value",
                "steps": [
                    {"keyword": "Given",
                     "text": f'user searches for transaction "{transaction_id}"'},
                    {"keyword": "When",
                     "text": f'user enters an invalid value "{bad_value}" '
                             f'in "{element_key}" and submits via "{submit_key}"'},
                    {"keyword": "Then", "text": "a validation message is shown"},
                ],
            })
    return scenarios


def _python_module_name(class_name: str) -> str:
    """TransactionPage -> transaction_page (snake_case module file name)."""
    s1 = re.sub(r"(.)([A-Z][a-z]+)", r"\1_\2", class_name)
    return re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", s1).lower()


# ── public API ──────────────────────────────────────────────────────────
def regenerate_feature_only(transaction_id: str) -> dict[str, Any]:
    """Part 15's targeted patch for a validation_change — re-renders
    ONLY the `.feature` file (Gherkin + auto-derived negative scenarios)
    from whatever is currently stored (elements/actions/field_metadata,
    including a `set_field_requirement()` patch already applied),
    leaving the page object and step definitions file completely
    untouched — a narrower, safer change than `generate_all()`'s full
    regeneration of every artefact type for a change that only ever
    affects validation/Gherkin text, not locators or Python code.
    """
    if transaction_id == settings.password_change_transaction:
        raise ValueError(
            f"Transaction {transaction_id} is reserved for the mandatory "
            "password-change pre-step and is not patched through this path."
        )
    from ..knowledge import repository as repo
    from ..tdm import templates as tdm_templates

    txn = repo.get_transaction(transaction_id)
    if not txn:
        raise ValueError(f"Transaction {transaction_id} is not in the knowledge repository")
    transaction_pk = int(txn["id"])
    elements = repo.get_elements(transaction_pk)
    actions = repo.get_actions(transaction_pk)
    field_metadata = tdm_templates.get_field_metadata(transaction_id)
    elements, field_metadata = _strip_reserved_elements(elements, field_metadata)

    element_models = _element_models(elements)
    gherkin, _py_steps, _reuse = _step_models(
        actions, element_models,
        _action_models(actions, element_models), transaction_id,
        _scan_existing_step_patterns(),
    )
    negative_scenarios = _negative_scenarios(field_metadata, actions, transaction_id)
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

    txn_dir = settings.framework_src_path / "features" / "transactions" / f"Transaction_{transaction_id}"
    feature_text = _env.get_template("feature.j2").render(
        transaction_id=transaction_id,
        feature_name=f"Transaction {transaction_id} — {txn['name']}",
        scenario_name=f"Execute {txn['name']}",
        description=txn.get("description"),
        version=txn["version"],
        tags=[],
        steps=gherkin,
        negative_scenarios=negative_scenarios,
    )
    path = _write(txn_dir / naming.feature_file_name(transaction_id), feature_text)
    log.info("Targeted patch: regenerated ONLY the feature file for %s (%s)",
             transaction_id, path)
    return {"transaction_id": transaction_id, "feature": path,
            "negative_scenarios": len(negative_scenarios), "patched_at": now}


def generate_all(
    transaction_id: str,
    transaction_name: str,
    version: str,
    elements: list[dict[str, Any]],
    actions: list[dict[str, Any]],
    validations: list[dict[str, Any]] | None = None,
    environment: str = "PREPROD",
    field_metadata: list[dict[str, Any]] | None = None,
    description: str | None = None,
) -> GenerationResult:
    """Generate feature + page object + step definitions + test data."""
    if transaction_id == settings.password_change_transaction:
        # 9750 is the reserved forced-password-change pre-step (Section
        # 11.1) — its feature/page/steps are hand-written framework files
        # (python-framework/pages/transaction_9750_page.py,
        # features/steps/transaction_9750_steps.py,
        # features/transactions/Transaction_9750/Transaction9750.feature),
        # loaded by run.py for EVERY execution, not generated per-recording.
        # Running the normal codegen path against this id would overwrite
        # that seeded feature file (same Transaction_9750/ folder) and spin
        # up a second, independently-generated steps file whose step text
        # (e.g. a generic "user clicks \"Home\"") collides with whatever
        # else already defines it — behave's step registry is global across
        # every file in features/steps/, so that collision doesn't surface
        # as a generation error, it surfaces as `AmbiguousStep` the next
        # time ANY transaction executes, aborting the run before a single
        # scenario starts. If 9750's recorded locators genuinely need
        # updating (a real UI change on the password-change screen), patch
        # utils/locator_repository.py's registration in
        # pages/transaction_9750_page.py directly, or let self-healing
        # apply it — the same path already used for every other locator
        # drift — rather than regenerating the file wholesale.
        raise ValueError(
            f"Transaction {transaction_id} is reserved for the mandatory "
            "password-change pre-step and is not generated through the "
            "normal code-generation path. Update "
            "python-framework/pages/transaction_9750_page.py directly, or "
            "let self-healing apply a locator fix, instead of recording "
            "9750 as a regular transaction."
        )
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    elements, field_metadata = _strip_reserved_elements(elements, field_metadata)
    element_models = _element_models(elements)
    action_models = _action_models(actions, element_models)

    page_class = naming.transaction_class(transaction_id, "Page")
    steps_class = naming.transaction_class(transaction_id, "Steps")
    page_module = _python_module_name(page_class)
    steps_module = _python_module_name(steps_class)
    steps_file = settings.framework_src_path / "features" / "steps" / f"{steps_module}.py"

    # Excludes THIS transaction's own (about-to-be-overwritten) steps file
    # from the duplicate scan — regenerating a transaction must never see
    # its own prior version as "already defined elsewhere" and silently
    # drop its own step functions.
    existing_patterns = _scan_existing_step_patterns(exclude_files={steps_file})

    gherkin, py_steps, reuse_notes = _step_models(
        actions, element_models, action_models, transaction_id, existing_patterns
    )
    validation_models = _validation_models(validations or [])
    negative_scenarios = _negative_scenarios(field_metadata, actions, transaction_id)

    feature_name = f"Transaction {transaction_id} — {transaction_name}"

    txn_dir = settings.framework_src_path / "features" / "transactions" / f"Transaction_{transaction_id}"

    result = GenerationResult()

    # ── feature ─────────────────────────────────────────────────────────
    feature_text = _env.get_template("feature.j2").render(
        transaction_id=transaction_id,
        feature_name=feature_name,
        scenario_name=f"Execute {transaction_name}",
        description=description,
        version=version,
        tags=[],
        steps=gherkin,
        negative_scenarios=negative_scenarios,
    )
    result["feature"] = _write(
        txn_dir / naming.feature_file_name(transaction_id), feature_text
    )

    # ── page object ─────────────────────────────────────────────────────
    page_text = _env.get_template("page.py.j2").render(
        class_name=page_class,
        transaction_id=transaction_id,
        transaction_name=transaction_name,
        version=version,
        generated_at=now,
        elements=element_models,
        actions=[m for m in action_models if m is not None],
        validations=validation_models,
    )
    result["page_object"] = _write(
        settings.framework_src_path / "pages" / f"{page_module}.py",
        page_text,
    )

    # ── step definitions ────────────────────────────────────────────────
    steps_text = _env.get_template("steps.py.j2").render(
        class_name=steps_class,
        page_class=page_class,
        page_module=page_module,
        transaction_id=transaction_id,
        transaction_name=transaction_name,
        version=version,
        generated_at=now,
        steps=py_steps,
    )
    result["step_definition"] = _write(
        steps_file,
        steps_text,
    )

    # No per-transaction runner file any more — python-framework/run.py is
    # fully generic (`python run.py --transaction=<id> ...`).

    # ── test data template ──────────────────────────────────────────────
    if field_metadata:
        for env_name in (environment, "UAT", "PROD"):
            path = tdm_templates.scaffold_from_fields(
                transaction_id, env_name, field_metadata
            )
            if env_name == environment:
                result["test_data"] = path

    result["reuse_notes"] = reuse_notes
    result["metadata"] = {
        "transaction_id": transaction_id,
        "version": version,
        "generated_at": now,
        "elements": len(element_models),
        "page_actions": len(action_models),
        "gherkin_steps": len(gherkin),
        "negative_scenarios": len(negative_scenarios),
        "new_step_definitions": len(py_steps),
        "reused_step_definitions": len(reuse_notes),
    }
    log.info("Code generation complete for %s: %s", transaction_id, result["metadata"])
    return result


def repair_file(path: str, new_content: str) -> str:
    """Used by the Self-Healing / BRD flow to patch a single file."""
    return _write(Path(path), new_content)


def patch_locator(page_object_path: str, element_constant: str,
                  new_python_by: str) -> bool:
    """Swap one locator inside a generated page object (self-healing)."""
    path = Path(page_object_path)
    if not path.exists():
        return False
    text = path.read_text(encoding="utf-8")
    pattern = re.compile(
        r"(locator_repo\.register\(\s*" + re.escape(element_constant)
        + r"\s*,\s*\[)",
    )
    match = pattern.search(text)
    if not match:
        return False
    insert_at = match.end()
    patched = text[:insert_at] + f"\n            {new_python_by}," + text[insert_at:]
    path.write_text(patched, encoding="utf-8")
    log.info("Self-heal: promoted %s for %s", new_python_by, element_constant)
    return True
