import { useEffect, useState } from "react";
import { recordingsApi } from "@/lib/api";
import { DataTable, Disclosure, Panel, Spinner } from "@/components/ui";

/**
 * A recording's version history (see backend/recording_access.py's
 * snapshot_version - every meaningful edit creates one). Extracted from
 * RunSavedTab.js so both it and the recording details page
 * (pages/recordings/[id].js) show the exact same thing, not two
 * different copies of this logic.
 *
 * `bare`: renders just the Disclosure (no surrounding Panel) - for
 * embedding inside a page section that already provides its own Panel/
 * card chrome (e.g. the details page's Versions tab).
 */
export default function VersionHistory({ recordingId, bare = false }) {
  const [versions, setVersions] = useState([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    setVersions([]);
    if (!recordingId) return;
    setLoading(true);
    recordingsApi
      .listVersions(recordingId)
      .then(setVersions)
      .catch(() => setVersions([]))
      .finally(() => setLoading(false));
  }, [recordingId]);

  const content = (
    <Disclosure title={`Version history${versions.length ? ` (${versions.length})` : ""}`} defaultOpen={bare}>
      <div className="px-1 pb-2 pt-1">
        {loading && <Spinner label="Loading versions..." />}
        {!loading && versions.length === 0 && <p className="text-sm text-muted">No version history yet.</p>}
        {!loading && versions.length > 0 && (
          <DataTable
            columns={[
              { key: "version_number", label: "Version", mono: true },
              { key: "change_summary", label: "Change" },
              { key: "created_at", label: "When" },
            ]}
            rows={versions.map((v) => ({
              version_number: `v${v.version_number}`,
              change_summary: v.change_summary || "—",
              created_at: new Date(v.created_at).toLocaleString(),
            }))}
          />
        )}
      </div>
    </Disclosure>
  );

  if (bare) return content;
  return <Panel>{content}</Panel>;
}
