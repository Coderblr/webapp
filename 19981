"""
Launches a Playwright browser. Two modes, controlled by BROWSER= in .env:

  BROWSER=edge / chrome (default: edge)
    Drives the REAL, already-installed system browser via Playwright's
    "channel" option instead of downloading its own bundled Chromium build
    - same idea as the old webdriver-manager auto-download, except
    Playwright doesn't need a separate driver executable at all:
    `pip install playwright` + `playwright install msedge` (or `chrome`)
    is enough. Good for local/dev use where you want the exact browser
    people actually use.

  BROWSER=chromium
    Uses Playwright's OWN bundled Chromium (`playwright install chromium`)
    instead of a system browser channel. No dependency on system Edge/
    Chrome being installed, licensed, or launchable under whatever account
    runs the backend - which matters once this runs as a Windows Service
    (no interactive desktop, a service account that may not have Edge set
    up the same way a normal user profile does) or just as a more
    reproducible, version-pinned-to-Playwright headless target for
    server-hosted concurrent recording. Recommended for hosted deployments
    (see DEPLOYMENT_WINDOWS.md); BROWSER=edge remains the default for
    local single-user dev, where using the browser you actually see and
    click around in day to day is more convenient.
"""
from __future__ import annotations
import os
from dataclasses import dataclass
from typing import Optional

from playwright.sync_api import sync_playwright, Playwright, Browser, BrowserContext


def get_channel() -> Optional[str]:
    """Returns the Playwright `channel=` value to pass to launch(), or
    None to use Playwright's own bundled Chromium instead (BROWSER=chromium)."""
    browser = os.getenv("BROWSER", "edge").lower().strip()
    if browser == "edge":
        return "msedge"
    if browser == "chrome":
        return "chrome"
    if browser == "chromium":
        return None
    raise ValueError(f"Unsupported BROWSER='{browser}'. Use 'edge', 'chrome', or 'chromium'.")


@dataclass
class BrowserSession:
    """Bundles the three Playwright handles that need to be torn down together."""
    playwright: Playwright
    browser: Browser
    context: BrowserContext

    def new_page(self):
        return self.context.new_page()

    def close(self):
        try:
            self.context.close()
        except Exception:
            pass
        try:
            self.browser.close()
        except Exception:
            pass
        try:
            self.playwright.stop()
        except Exception:
            pass


def launch_browser(headless: bool = False, ignore_https_errors: bool = None) -> BrowserSession:
    """
    Starts Playwright and launches the configured browser channel.
    `no_viewport=True` + `--start-maximized` mirrors the old Selenium
    `--start-maximized` behavior (the window fills the screen instead of
    being locked to a fixed viewport size) - used for headed sessions
    (local dev, or an interactive desktop session).

    Headless sessions (required on a hosted server with no desktop -
    see recorder/recorder.py's live-view/CDP-screencast support) get a
    fixed, generous viewport instead, since there's no physical window to
    maximize - this is exactly what gets streamed to a remote user's
    browser as the live recording view.

    `ignore_https_errors`: internal/UAT environments very often have a
    certificate that doesn't validate cleanly (self-signed, internally-
    issued CA not trusted by the OS, hostname mismatch like
    ERR_CERT_COMMON_NAME_INVALID) - unlike a real browser, which lets you
    click through an "unsafe" warning, Playwright just fails the navigation
    outright unless this is enabled. Defaults to the IGNORE_HTTPS_ERRORS env
    var (see .env.example), itself defaulting to true, since this tool is
    for testing internal apps where that's the common case; set it to
    false in .env for a public-internet target where an invalid cert
    should actually fail the test.
    """
    channel = get_channel()
    if ignore_https_errors is None:
        ignore_https_errors = os.getenv("IGNORE_HTTPS_ERRORS", "true").lower().strip() != "false"
    pw = sync_playwright().start()
    launch_args = ["--start-maximized"] if not headless else []
    launch_kwargs = {"headless": headless, "args": launch_args}
    if channel is not None:
        launch_kwargs["channel"] = channel  # omitted entirely for BROWSER=chromium - uses Playwright's bundled build
    browser = pw.chromium.launch(**launch_kwargs)
    if headless:
        width = int(os.getenv("HEADLESS_VIEWPORT_WIDTH", "1440"))
        height = int(os.getenv("HEADLESS_VIEWPORT_HEIGHT", "900"))
        context = browser.new_context(viewport={"width": width, "height": height}, ignore_https_errors=ignore_https_errors)
    else:
        context = browser.new_context(no_viewport=True, ignore_https_errors=ignore_https_errors)

    # Without this, navigator.clipboard.writeText() (used by
    # recorder/recorder.py's _process_ocr_request, to let the person
    # recording paste an OCR-captured value into the next field with
    # Ctrl+V instead of retyping it) silently fails - Chromium requires
    # the "clipboard-write" permission to be explicitly granted to the
    # context, it's not implicitly available to page scripts even on a
    # trusted/first-party origin. Best-effort: some origins (e.g. a plain
    # http:// UAT environment without a secure context) may still reject
    # this - that's fine, the captured value is stored as a recording
    # variable regardless of whether the clipboard convenience worked.
    try:
        context.grant_permissions(["clipboard-write", "clipboard-read"])
    except Exception:
        pass

    return BrowserSession(playwright=pw, browser=browser, context=context)
