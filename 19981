def _nav_key(path) -> str:
    return " > ".join(str(p).strip().lower() for p in (path or []))


def _nav_host(url: str) -> str:
    try:
        host = (_nav_urlsplit(url).hostname or "").lower()
    except Exception:
        return ""
    return host[4:] if host.startswith("www.") else host


def _nav_strip_hash(url: str) -> str:
    return (url or "").split("#", 1)[0].rstrip("/")


def _nav_norm(url: str) -> str:
    """Host + path only - ignores http/https, 'www.', a trailing slash,
    the query string and the #fragment, so harmless differences are not
    reported as a changed link or a redirect."""
    try:
        parts = _nav_urlsplit(url or "")
    except Exception:
        return url or ""
    return _nav_host(url) + (parts.path or "").rstrip("/")


def _nav_link_kind(item: dict) -> str:
    """'link' for a menu entry that leads to a page; 'none' for one that
    only opens a submenu (no href, '#', javascript:); 'mail' for
    mailto:/tel: links, which are not opened."""
    raw = (item.get("raw_href") or "").strip()
    low = raw.lower()
    if not raw or raw == "#" or low.startswith("javascript:"):
        return "none"
    if low.startswith(("mailto:", "tel:", "sms:")):
        return "mail"
    return "link"


