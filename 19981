import { useEffect, useState } from "react";
import { api, recordingsApi } from "@/lib/api";
import { Button, Callout, Checkbox, Field, Select } from "@/components/ui";

/**
 * Owner-only sharing management for one recording - lists current shares
 * and lets the owner grant a new one (or update an existing user's
 * permissions, since POST .../share upserts) or revoke one.
 *
 * `inline`: when true, renders just the content (no modal backdrop/
 * positioning/close button) - for embedding directly in a page section
 * (the recording details page's Sharing tab) rather than only popping up
 * over the current page. Default (false) keeps the original modal
 * behavior (RunSavedTab.js's "Share" button), same conventions as
 * ReportView.js's screenshot modal (overlay + click-outside + explicit
 * close button).
 */
export default function ShareDialog({ recordingId, recordingName, onClose, inline = false }) {
  const [users, setUsers] = useState([]);
  const [shares, setShares] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const [targetUserId, setTargetUserId] = useState("");
  const [canExecute, setCanExecute] = useState(true);
  const [canEdit, setCanEdit] = useState(false);
  const [canExport, setCanExport] = useState(false);
  const [submitting, setSubmitting] = useState(false);

  async function load() {
    setLoading(true);
    setError(null);
    try {
      const [userList, shareList] = await Promise.all([api.getUsers(), recordingsApi.listShares(recordingId)]);
      setUsers(userList);
      setShares(shareList);
    } catch (e) {
      setError(e.detail || e.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [recordingId]);

  async function handleShare() {
    if (!targetUserId) return;
    setSubmitting(true);
    setError(null);
    try {
      await recordingsApi.shareRecording(recordingId, {
        user_id: Number(targetUserId),
        can_execute: canExecute,
        can_edit: canEdit,
        can_export: canExport,
      });
      setTargetUserId("");
      await load();
    } catch (e) {
      setError(e.detail || e.message);
    } finally {
      setSubmitting(false);
    }
  }

  async function handleRevoke(shareId) {
    setError(null);
    try {
      await recordingsApi.revokeShare(recordingId, shareId);
      await load();
    } catch (e) {
      setError(e.detail || e.message);
    }
  }

  const alreadySharedIds = new Set(shares.map((s) => s.shared_with_user_id));
  const shareableUsers = users.filter((u) => !alreadySharedIds.has(u.user_id));

  const body = (
    <>
      {!inline && (
        <div className="mb-3 flex items-center justify-between gap-4">
          <span className="truncate text-sm font-semibold text-ink">Share &ldquo;{recordingName}&rdquo;</span>
          <button type="button" className="shrink-0 text-sm font-medium text-muted hover:text-ink" onClick={onClose}>
            Close
          </button>
        </div>
      )}

      {error && (
        <div className="mb-3">
          <Callout tone="error">{error}</Callout>
        </div>
      )}

      {loading ? (
        <p className="text-sm text-muted">Loading...</p>
      ) : (
        <>
          <div className="mb-4 space-y-1.5">
            {shares.length === 0 && <p className="text-sm text-muted">Not shared with anyone yet.</p>}
            {shares.map((s) => (
              <div key={s.id} className="flex items-center justify-between gap-2 rounded-sm border border-line px-3 py-2 text-sm">
                <div className="min-w-0">
                  <div className="truncate font-medium text-ink">{s.shared_with_name || `User #${s.shared_with_user_id}`}</div>
                  <div className="text-xs text-muted">
                    {[s.can_execute && "Execute", s.can_edit && "Edit", s.can_export && "Export"].filter(Boolean).join(" · ") || "View only"}
                  </div>
                </div>
                <Button variant="ghost" onClick={() => handleRevoke(s.id)}>
                  Revoke
                </Button>
              </div>
            ))}
          </div>

          <div className="space-y-3 border-t border-line pt-3">
            <Field label="Share with">
              <Select value={targetUserId} onChange={(e) => setTargetUserId(e.target.value)}>
                <option value="">Select a user...</option>
                {shareableUsers.map((u) => (
                  <option key={u.user_id} value={u.user_id}>
                    {u.name}
                  </option>
                ))}
              </Select>
            </Field>
            <div className="flex flex-wrap gap-4">
              <Checkbox label="Execute" checked={canExecute} onChange={setCanExecute} />
              <Checkbox label="Edit" checked={canEdit} onChange={setCanEdit} />
              <Checkbox label="Export" checked={canExport} onChange={setCanExport} />
            </div>
            <Button onClick={handleShare} disabled={!targetUserId || submitting}>
              {submitting ? "Sharing..." : "Share"}
            </Button>
          </div>
        </>
      )}
    </>
  );

  if (inline) return body;

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-6"
      role="dialog"
      aria-modal="true"
      onClick={onClose}
    >
      <div
        className="max-h-full w-full max-w-md overflow-auto rounded-sm bg-panel p-4 shadow-xl"
        onClick={(e) => e.stopPropagation()}
      >
        {body}
      </div>
    </div>
  );
}
