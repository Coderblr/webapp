"""Pydantic contracts shared by the API layer and the agents."""
from __future__ import annotations

from datetime import datetime
from typing import Any, Literal, Optional

from pydantic import BaseModel, Field

Environment = Literal["PREPROD", "UAT", "PROD"]
TransactionType = Literal["business", "system_prerequisite", "system_cleanup"]
DataSource = Literal["framework", "profile", "runtime", "database", "api", "ai", "user"]


# ── recorder ────────────────────────────────────────────────────────────
class RecordingStartRequest(BaseModel):
    transaction_id: str = Field(..., examples=["1045"])
    transaction_name: str = Field(..., examples=["CIF Creation"])
    environment: Environment = "PREPROD"
    start_url: str
    transaction_type: TransactionType = "business"
    description: Optional[str] = None
    fullpage_crawl: bool = True
    capture_network: bool = True


class RecordingSession(BaseModel):
    session_uid: str
    transaction_id: str
    transaction_name: Optional[str] = None
    environment: Optional[str] = None
    status: str
    start_url: Optional[str] = None
    capture_dir: Optional[str] = None
    stats: dict[str, Any] = {}
    started_at: Optional[datetime] = None
    stopped_at: Optional[datetime] = None


class RecordedActionOut(BaseModel):
    sequence: int
    action: str
    element_key: Optional[str] = None
    field_name: Optional[str] = None
    value_ref: Optional[str] = None
    page_key: Optional[str] = None
    screenshot_after: Optional[str] = None


class KeepDiscardRequest(BaseModel):
    session_uid: str
    decision: Literal["keep", "discard"]
    reason: Optional[str] = None
    generate_code: bool = True


# ── transactions / knowledge ────────────────────────────────────────────
class TransactionOut(BaseModel):
    id: int
    transaction_id: str
    name: str
    description: Optional[str] = None
    version: str
    type: str
    status: str
    confidence: float = 1.0
    tags: list[str] = []
    workflow_path: list[Any] = []
    generated_files: dict[str, Any] = {}
    recorded_at: Optional[datetime] = None
    created_at: Optional[datetime] = None


class ElementOut(BaseModel):
    element_key: str
    tag: Optional[str] = None
    element_type: Optional[str] = None
    label: Optional[str] = None
    visible: bool = True
    enabled: bool = True
    interacted: bool = False
    locators: list[dict[str, Any]] = []


# ── test data ───────────────────────────────────────────────────────────
class TestDataFieldMeta(BaseModel):
    field: str
    datatype: Optional[str] = None
    required: bool = False
    pattern: Optional[str] = None
    business_meaning: Optional[str] = None
    sensitive: bool = False
    editable: bool = True
    source: DataSource = "user"
    source_config: dict[str, Any] = {}
    element_key: Optional[str] = None


class TestDataValueIn(BaseModel):
    field: str
    value: str
    sensitive: bool = False
    source: DataSource = "user"


class TestDataSaveRequest(BaseModel):
    transaction_id: str
    environment: Environment
    profile: Optional[str] = None
    values: list[TestDataValueIn]


class TestDataTemplateOut(BaseModel):
    transaction: str
    environment: str
    data: dict[str, dict[str, Any]]
    file_path: Optional[str] = None


class ManualLocatorRequest(BaseModel):
    strategy: str            # id | name | css | xpath | data | aria | text ...
    value: str
    priority: int = 1        # 1 = tried first, ahead of the recorder's own locators
    # Only used if the element doesn't exist yet (recorder never captured it):
    tag: str = "input"
    element_type: str = "textbox"
    label: str | None = None
    page_key: str | None = None
    action: str | None = None   # click | type | select ... defaults from element_type


class ProfileIn(BaseModel):
    name: str
    environment: Environment
    description: Optional[str] = None
    values: dict[str, str] = {}
    secrets: dict[str, str] = {}   # teller_id, teller_password, checker_id, ...


class ProfileOut(BaseModel):
    id: int
    name: str
    environment: str
    description: Optional[str] = None
    values: dict[str, Any] = {}
    secret_keys: list[str] = []    # names only, never values


# ── execution ───────────────────────────────────────────────────────────
class ExecutionRequest(BaseModel):
    transaction_id: str
    environment: Environment = "PREPROD"
    profile: str
    target_url: Optional[str] = None
    runtime_values: dict[str, str] = {}
    skip_password_change: bool = False    # audit-logged override
    skip_teller_reset: bool = False       # audit-logged override
    headless: bool = False


class ExecutionStepOut(BaseModel):
    sequence: int
    phase: str
    step_name: str
    status: str
    duration_ms: Optional[int] = None
    screenshot_ref: Optional[str] = None
    error_msg: Optional[str] = None
    detail: dict[str, Any] = {}


class ExecutionOut(BaseModel):
    execution_uid: str
    transaction_id: str
    environment: str
    status: str
    password_change_status: Optional[str] = None
    teller_reset_status: Optional[str] = None
    teller_reset_response: Optional[str] = None
    report_path: Optional[str] = None
    error_summary: Optional[str] = None
    metrics: dict[str, Any] = {}
    started_at: Optional[datetime] = None
    finished_at: Optional[datetime] = None
    steps: list[ExecutionStepOut] = []


# ── BRD ─────────────────────────────────────────────────────────────────
class BRDImpact(BaseModel):
    transaction_id: str
    transaction_name: Optional[str] = None
    change_type: Literal[
        "new_transaction", "workflow_change", "field_change",
        "validation_change", "locator_change", "no_change"
    ]
    affected_screens: list[str] = []
    affected_fields: list[str] = []
    requires_recording: bool = False
    risk: Literal["low", "medium", "high"] = "medium"
    rationale: str = ""
    proposed_changes: list[str] = []


class BRDAnalysisOut(BaseModel):
    brd_id: int
    filename: str
    status: str
    summary: str = ""
    impacts: list[BRDImpact] = []


# ── approvals / self-heal ───────────────────────────────────────────────
class ApprovalDecision(BaseModel):
    thread_id: str
    approval_type: Literal["recording_keep", "codegen", "self_heal"]
    decision: Literal["approved", "rejected", "discarded"]
    decided_by: Optional[str] = None
    notes: Optional[str] = None


class SelfHealEntry(BaseModel):
    element_key: str
    old_locator: str
    new_locator: str
    strategy: str
    confidence: float
    reason: str
    applied: bool = False


# ── secrets ─────────────────────────────────────────────────────────────
class SecretIn(BaseModel):
    scope: Literal["global", "profile", "environment"] = "profile"
    scope_ref: Optional[str] = None
    key: Literal[
        "teller_id", "teller_password", "teller_new_password",
        "checker_id", "checker_password", "cbs_reset_string",
    ]
    value: str


class SecretOut(BaseModel):
    scope: str
    scope_ref: Optional[str] = None
    key: str
    hint: str
    updated_at: Optional[datetime] = None


# ── generic ─────────────────────────────────────────────────────────────
class Ack(BaseModel):
    ok: bool = True
    message: str = ""
    data: dict[str, Any] = {}
