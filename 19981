def _css_attr_quote(value: str) -> str:
    """Safely double-quotes a string for use inside a CSS attribute selector."""
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def _xpath_literal(value: str) -> str:
    """Safely quotes a string for use inside an XPath expression, even if it contains quotes."""
    if '"' not in value:
        return f'"{value}"'
    if "'" not in value:
        return f"'{value}'"
    parts = value.split('"')
    return "concat(" + ', \'"\', '.join(f'"{p}"' for p in parts) + ")"


def _selector_for(strategy: str, value: str) -> str:
    """Turns a captured (strategy, value) pair into a Playwright selector string.
    Supports the full canonical locator taxonomy including TEXT, ROLE, ARIA."""
    if strategy == "ID":
        return f"css=[id={_css_attr_quote(value)}]"
    if strategy == "NAME":
        return f"css=[name={_css_attr_quote(value)}]"
    if strategy == "CSS":
        return f"css={value}"
    if strategy == "XPATH":
        return f"xpath={value}"
    if strategy == "TEXT":
        return f"text={value}"
    if strategy == "ROLE":
        if "[" in value:
            role, rest = value.split("[", 1)
            name = rest.rstrip("]")
            return f'role={role.strip()}[name="{name.strip()}"]'
        return f"role={value}"
    if strategy == "ARIA":
        return f'css=[aria-label={_css_attr_quote(value)}]'
    raise ValueError(f"Unknown locator strategy '{strategy}'")


# Substrings Playwright's own error messages use when an action gets cut
# short by the PAGE NAVIGATING AWAY mid-action - e.g. clicking a login/submit
# button that causes a full page load. This is Playwright's normal (if
# confusingly-worded) way of reporting that the frame/execution context it
# was tracking got torn down - it does NOT mean the click failed; it almost
# always means the click worked and the page had already moved on before
# Playwright finished its own bookkeeping for that action. Treating this as
# a real failure and retrying (or worse, re-querying the OLD page's selector
# on the NEW page) is what causes a working login/submit click to still
# report an error, or to hang for Playwright's own default action timeout
# waiting for an element that's gone because the page already navigated.
_NAVIGATION_INTERRUPTED_HINTS = (
    "execution context was destroyed",
    "most likely because of a navigation",
    "target closed",
    "frame was detached",
    "navigating frame was detached",
)


def _navigation_interrupted(exc: Exception) -> bool:
    return any(hint in str(exc).lower() for hint in _NAVIGATION_INTERRUPTED_HINTS)



class BasePage:
    def __init__(self, page: Page, timeout: int = 8, poll_interval: float = 0.25, heal_callback=None, max_wait_seconds: int = 90):
        self.page = page
        self.timeout = timeout
        self.poll_interval = poll_interval
        self.heal_callback = heal_callback  # optional fn(element_name, page) -> {"strategy":..., "value":...} or None
        self.locators = json.loads(_EFFECTIVE_LOCATORS_PATH.read_text())
        # element_name -> visible text/aria-label, recorded for plain
        # click() targets only (see generator/build.py) - consulted ONLY as
        # a last resort by _ocr_click_fallback below, after every DOM
        # locator candidate (including self-heal) has already failed. Not
        # a real element_name, so it's popped off self.locators here rather
        # than left in it (which would otherwise appear as a bogus element
        # in the click_X()/type_X() convenience methods at the bottom of
        # this file).
        self.ocr_hints = self.locators.pop("__ocr_hints__", {})
        # Which candidate locator actually resolved the most recent _find()
        # call - {"element_name", "strategy", "value", "self_healed"} or None.
        # Read (and reset) by the environment.py/agent_environment.py
        # after_step hook to build the execution report's per-step "locator
        # used" field - see runner/run_recording.py's _extract_steps.
        self.last_resolution = None
        self._last_hover_pos = None   # (x, y) of last hover — kept so nav menus stay open
        self._hover_chain = []        # ordered list of (x,y) for every hover in current nav sequence
        # Adaptive-wait ceiling for wait_ready() below - see its docstring.
        # Override e.g. RecordedPage(page, max_wait_seconds=180) if a
        # particular environment's APIs are known to run especially slow.
        self.max_wait_seconds = max_wait_seconds

    def switch_page(self, new_page: Page):
        """
        Redirects every subsequent element lookup/action to a DIFFERENT
        Playwright Page - used when a recorded flow interacts with a popup,
        a new tab/window opened via target="_blank"/window.open(), or
        switches back to the original window after closing one (see
        generator/build.py's page_index/opens_new_page handling and
        steps.tmpl's new_page_wrapper/maybe_switch macros, which call this
        automatically). All existing methods (click, type_text, etc.)
        keep working unchanged afterward - they just now resolve elements
        against `new_page` instead.
        """
        self.page = new_page

        # Make the selected Playwright page the foreground browser page.
        # This is programmatic browser-page switching; the user does not
        # need to move the physical mouse cursor to the target tab.
        try:
            if not new_page.is_closed():
                new_page.bring_to_front()
        except Exception:
            pass

    def _root_for(self, frame_path: list | None):
        """
        Resolves the Playwright object (Page, or a nested FrameLocator) that
        element lookups should actually run against, given the "frame_path"
        recorded for that element (a list of CSS selectors, outermost ->
        innermost, locating the chain of <iframe> elements to drill through -
        see Recorder._frame_path_for). Empty/missing frame_path (the normal
        case, and every locator recorded before iframe support existed)
        resolves to `self.page` itself, unchanged.
        """
        root = self.page
        for selector in (frame_path or []):
            root = root.frame_locator(selector)
        return root

    def _frame_root(self, element_name: str):
        """The frame_path is recorded per ACTION, not per element name, but
        every candidate locator saved for a given element_name came from the
        same action/frame, so the first candidate's frame_path speaks for
        all of them."""
        candidates = self.locators.get(element_name, [])
        frame_path = candidates[0].get("frame_path") if candidates else None
        return self._root_for(frame_path)

    def _find(self, element_name: str, require_visible: bool = True):
        """
        Polls ALL known locator strategies for this element together within a
        single shared time budget, instead of waiting the full timeout for
        each strategy in turn - this is what keeps lookups fast even when the
        first strategy or two no longer match the page. Returns a Playwright
        Locator resolved to a single (`.first`) element. If the element was
        recorded inside an iframe, resolves through the recorded
        "frame_path" first (see _root_for) instead of searching the page
        directly - a locator that's perfectly valid INSIDE an iframe's own
        document will simply never match anything on the parent page.
        """
        candidates = self.locators.get(element_name, [])
        root = self._frame_root(element_name)
        deadline = time.time() + self.timeout

        while time.time() < deadline:
            for cand in candidates:
                try:
                    sel = _selector_for(cand["strategy"], cand["value"])
                    # Shadow DOM piercing: if this element was recorded inside
                    # a shadow root, try both the direct selector and the
                    # Playwright shadow-piercing >> syntax.
                    in_shadow = cand.get("in_shadow_dom", False)
                    selectors_to_try = [sel]
                    if in_shadow and not sel.startswith("xpath="):
                        # css= selectors can pierce shadow DOM with >> combinator
                        raw_val = cand["value"]
                        selectors_to_try.append(f"css={raw_val}")
                    for s in selectors_to_try:
                        try:
                            loc = root.locator(s)
                            if loc.count() == 0:
                                continue
                            el = loc.first
                            if not require_visible or el.is_visible():
                                self.last_resolution = {
                                    "element_name": element_name, "strategy": cand["strategy"],
                                    "value": cand["value"], "self_healed": False,
                                }
                                return el
                        except PlaywrightError:
                            continue
                except PlaywrightError:
                    continue
            time.sleep(self.poll_interval)

        # Every known strategy failed within the time budget requiring
        # visibility. Before self-healing/giving up, try once more allowing
        # a NON-visible match: styled checkbox/radio widgets (Bootstrap,
        # MUI, Ant Design, and plenty of custom CSS) very commonly keep the
        # real <input type="radio"/"checkbox"> in the DOM but visually
        # hidden (opacity:0, 1x1px, clip-path, etc.) while a label/span
        # renders the visible control - the native input is still exactly
        # what needs to be interacted with, it's just never "visible" by
        # Playwright's definition. This relaxed pass is what makes those
        # work instead of just timing out.
        if require_visible:
            for cand in candidates:
                try:
                    loc = root.locator(_selector_for(cand["strategy"], cand["value"]))
                    if loc.count() > 0:
                        self.last_resolution = {
                            "element_name": element_name, "strategy": cand["strategy"],
                            "value": cand["value"], "self_healed": False,
                        }
                        return loc.first
                except PlaywrightError:
                    continue

        # still nothing - try self-healing if available. Note: self-healing
        # operates against the TOP-LEVEL page (it re-reads page.content()),
        # not the resolved iframe root - repairing a broken locator that
        # lives inside an iframe is out of scope for now.
        # ── 3-Stage Self-Healing Pipeline ────────────────────────────────────
        # Stage 1: Deterministic Playwright semantic locators (no LLM, no vision)
        # Stage 2: Non-LLM DOM candidate ranking with configurable scores
        # Stage 3: Structured LLM reasoning over Stage 2 candidates + vision
        # Every result validated before execution. Results cached. Metrics tracked.
        try:
            from agent.healer import run_healing_pipeline
            # Build element description from OCR hints and locator metadata
            ocr_hints = self.locators.get("__ocr_hints__") or {}
            elem_desc = {
                "text": ocr_hints.get(element_name, ""),
                "ariaLabel": "",
                "tag": "",
                "name": "",
                "placeholder": "",
                "type": "",
                "role": "",
                "title": "",
                "data-testid": "",
            }
            orig_sel = ""
            if candidates:
                try:
                    orig_sel = _selector_for(candidates[0]["strategy"], candidates[0]["value"])
                except Exception:
                    pass
            # Extract LLM from heal_callback if available
            _llm = None
            if self.heal_callback and hasattr(self.heal_callback, "__self__"):
                _llm = getattr(self.heal_callback.__self__, "_llm", None)
            elif hasattr(self, "_llm"):
                _llm = self._llm

            heal_result = run_healing_pipeline(
                page=self.page,
                element_name=element_name,
                element_description=elem_desc,
                original_selector=orig_sel,
                action="click",
                llm=_llm,
                iframe_path=candidates[0].get("frame_path") if candidates else [],
                in_shadow_dom=candidates[0].get("in_shadow_dom", False) if candidates else False,
            )
            if heal_result.get("success"):
                # Vision coordinate result
                if heal_result.get("coords") and not heal_result.get("selector"):
                    coords = heal_result["coords"]
                    self.page.mouse.click(coords[0], coords[1])
                    self.last_resolution = {
                        "element_name": element_name,
                        "strategy": heal_result.get("strategy", "vision"),
                        "value": str(coords), "self_healed": True,
                        "stage": heal_result.get("stage"),
                    }
                    return None
                # Selector/locator result
                if heal_result.get("locator"):
                    sel = heal_result.get("selector", "")
                    if sel:
                        try:
                            strat = "CSS" if not sel.startswith("xpath=") else "XPATH"
                            val = sel.removeprefix("css=").removeprefix("xpath=")
                            fix_entry = {
                                "strategy": strat, "value": val,
                                "frame_path": candidates[0].get("frame_path") if candidates else [],
                                "self_healed": True,
                                "heal_stage": heal_result.get("stage"),
                            }
                            self.locators.setdefault(element_name, []).insert(0, fix_entry)
                            _EFFECTIVE_LOCATORS_PATH.write_text(json.dumps(self.locators, indent=2))
                        except Exception:
                            pass
                    self.last_resolution = {
                        "element_name": element_name,
                        "strategy": heal_result.get("strategy", "healed"),
                        "value": sel or "", "self_healed": True,
                        "stage": heal_result.get("stage"),
                        "confidence": heal_result.get("confidence"),
                    }
                    return heal_result["locator"]
        except Exception as _heal_err:
            import logging as _log
            _log.getLogger(__name__).warning(f"[SELF-HEAL] Pipeline error: {_heal_err}")

        raise PlaywrightTimeoutError(
            f"Could not locate a visible element for '{element_name}' with any known strategy "
            f"({[c['strategy'] for c in candidates]}) within {self.timeout}s, and self-healing "
            f"did not resolve it. "
            f"If this element is inside a hover/dropdown menu, ensure hover steps are recorded "
            f"before this step so the menu is open when the click runs."
        )

    def wait_ready(self, element_name: str, timeout: int = None):
        """
        Blocks until `element_name` resolves via ANY known strategy (see
        _find above). Adaptive: starts with the (optionally larger) explicit
        timeout - normally the wait time measured from the original
        recording, so a step that recorded slow (e.g. an API-backed lookup)
        gets a matching wait while a fast one doesn't sit around waiting
        needlessly - but if that's not actually enough THIS run (real API/
        network timing varies - a backend that took 5s when this was
        recorded might take 20s under load later), keeps waiting beyond it,
        up to self.max_wait_seconds total, instead of failing the step the
        moment the originally-recorded duration elapses. It's almost always
        better to wait longer than to fail a step that would have succeeded
        a few seconds later.
        """
        original_timeout = self.timeout
        target = max(self.timeout, timeout or 0)
        self.timeout = min(target, self.max_wait_seconds)
        try:
            self._find(element_name)
            return
        except PlaywrightTimeoutError:
            if self.timeout >= self.max_wait_seconds:
                raise
        finally:
            self.timeout = original_timeout

        # Didn't show up within the expected/recorded time - give it the
        # rest of the adaptive budget before actually failing the step.
        remaining = self.max_wait_seconds - target
        self.timeout = remaining
        try:
            self._find(element_name)
        finally:
            self.timeout = original_timeout

    def _looks_visually_hidden(self, el) -> bool:
        """
        True for the common 'intentionally hidden but technically visible to
        Playwright' CSS patterns used by custom checkbox/radio widgets - a
        near-zero-size box, or one positioned far outside the document (e.g.
        the `position:absolute; left:-9999px` accessibility-hiding
        technique). Playwright's own is_visible() considers these VISIBLE
        (opacity and off-screen positioning don't affect the
        `visibility`/`display` properties it actually checks) - so without
        this, click()/set_checked() below would try to actually scroll the
        page to that off-screen position before clicking, which is exactly
        what makes the whole page visibly jump/scroll sideways for elements
        hidden this way.
        """
        try:
            box = el.bounding_box()
        except PlaywrightError:
            return True
        if box is None:
            return True
        if box["width"] < 2 or box["height"] < 2:
            return True
        if box["x"] < -1000 or box["y"] < -1000:
            return True
        return False

    def _safe_scroll(self, el):
        """
        Best-effort scroll, bounded by self.timeout instead of Playwright's
        ~30s default action timeout, and never lets a scroll failure bubble
        up and abort the whole step. This is what every action method below
        calls instead of a bare scroll_into_view_if_needed() - a hidden or
        off-screen element (a date-picker's real <input> behind a styled
        widget, a field that's disabled/invisible until an earlier field is
        filled, etc.) would otherwise make Playwright retry the scroll for
        its full default timeout before finally raising, hanging the entire
        step for ~30 seconds over something that was never meant to be
        scrolled to in the first place.
        """
        if self._looks_visually_hidden(el):
            return
        try:
            el.scroll_into_view_if_needed(timeout=self.timeout * 1000)
        except PlaywrightError:
            pass

    def click(self, element_name: str):
        # Try normal click first
        try:
            el = self._find(element_name)
        except PlaywrightTimeoutError:
            # Element not found — may be inside a CSS hover menu that
            # collapsed. Replay the FULL hover chain (all ancestor hovers
            # in recorded order) then retry. This handles 1, 2, 3+ levels.
            import time as _t
            chain = getattr(self, '_hover_chain', [])
            if chain:
                try:
                    for (hx, hy) in chain:
                        self.page.mouse.move(hx, hy)
                        _t.sleep(0.12)
                    # After replaying chain, give CSS transitions time to settle
                    _t.sleep(0.3)
                    el = self._find(element_name)
                except PlaywrightTimeoutError:
                    pass
                else:
                    # Found it — click with force (element visible only via :hover)
                    try:
                        el.click(force=True, timeout=self.timeout * 1000)
                        self._hover_chain = []   # chain consumed by click
                        self._last_hover_pos = None
                        return
                    except Exception:
                        pass
            # Try OCR fallback
            if self._ocr_click_fallback(element_name):
                return
            raise
        if not self._looks_visually_hidden(el):
            self._safe_scroll(el)
            try:
                el.click(timeout=self.timeout * 1000)
                self._hover_chain = []   # successful click ends the hover sequence
                self._last_hover_pos = None
                return
            except (PlaywrightTimeoutError, PlaywrightError) as e:
                if _navigation_interrupted(e):
                    # the click almost certainly worked - the page just
                    # navigated away (e.g. a login/submit button) before
                    # Playwright finished its own post-click bookkeeping.
                    # Treating this as a failure and retrying below would
                    # re-query THIS element on the NEW page it just navigated
                    # to, where it (correctly) no longer exists.
                    return
                try:
                    # element is present but something (overlay, animation,
                    # off-screen positioning) is blocking a native click -
                    # force bypasses the actionability checks that just failed.
                    el.click(force=True, timeout=self.timeout * 1000)
                    return
                except (PlaywrightTimeoutError, PlaywrightError) as e2:
                    if _navigation_interrupted(e2):
                        return
        # Either visually-hidden by design (skip straight here - no point
        # scrolling to reveal something meant to stay hidden), or the normal
        # path above failed. Dispatch a native click directly on the DOM node
        # via JS - this never scrolls/moves the page and bypasses Playwright's
        # actionability checks (including visibility) entirely. Per spec,
        # calling .click() on a checkbox/radio still triggers the browser's
        # normal toggle behavior, not just the click event, so this is
        # equivalent to a real user click. Explicit timeout here (rather than
        # Playwright's own 30s default) so a GENUINE failure - the element
        # really is gone, not just navigated past - fails in a reasonable
        # time instead of hanging.
        try:
            el.evaluate("node => node.click()", timeout=self.timeout * 1000)
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if not _navigation_interrupted(e):
                raise

    def _ocr_click_fallback(self, element_name: str) -> bool:
        """
        Last-resort locator strategy for click() ONLY, tried after every
        DOM candidate (and self-heal, if available) has already failed:
        if this element was recorded with visible text/aria-label (see
        generator/build.py's ocr_hints), screenshot the WHOLE page, OCR
        it, and click the best-matching text region's center by raw
        pixel coordinates (page.mouse.click) instead of Playwright's
        selector-based Locator API.

        This is the only way a canvas-rendered or image-based button (no
        real DOM node to select at all, so no CSS/XPath could ever have
        worked, and self-heal - which only proposes CSS/XPATH - can't
        help either) has any chance of being recovered.

        Needs no LLM/API key (unlike self-heal, see agent/self_healer.py),
        so this works identically whether replay is running server-side
        or via the desktop local agent (which never has an LLM key - see
        local_agent/agent_environment.py). It also needs no OCR
        dependency to be a HARD requirement: if easyocr/torch aren't
        installed (e.g. a lightweight local-agent build), the import
        below fails quietly and this just returns False, exactly as if
        no hint had been recorded at all - never raises its own error,
        since the ORIGINAL locator failure is always the more useful one
        to surface if this doesn't pan out.

        Returns True (and has already performed the click) on success,
        False otherwise.
        """
        hint = self.ocr_hints.get(element_name)
        if not hint:
            return False
        try:
            from recorder.ocr_engine import find_text_regions, best_match
        except Exception:
            return False
        try:
            png_bytes = self.page.screenshot(full_page=True, timeout=self.timeout * 1000)
            regions = find_text_regions(png_bytes)
            region = best_match(regions, hint)
        except Exception:
            return False
        if region is None:
            return False
        box = region["bbox"]
        x = box["x"] + box["width"] / 2
        y = box["y"] + box["height"] / 2
        try:
            self.page.mouse.click(x, y)
        except PlaywrightError:
            return False
        self.last_resolution = {
            "element_name": element_name, "strategy": "OCR", "value": region["text"],
            "self_healed": False, "ocr_confidence": region["confidence"],
        }
        return True

    def click_vision_fallback(self, element_name: str, label_hint: str = "") -> bool:
        """
        Pure Vision AI coordinate click - called when BOTH OCR text
        matching AND the DOM/self-heal path have failed. Separate from
        _ocr_click_fallback so it can also be reached directly from
        non-click actions (type, select) that encountered a locator
        failure and want to at least try clicking the element first.

        Returns True if Vision AI located the element with high/medium
        confidence and the click succeeded, False otherwise.
        """
        if not label_hint:
            hint = self.ocr_hints.get(element_name) or element_name
        else:
            hint = label_hint
        try:
            from agent.vision_fallback import vision_click_coordinates
            png_bytes = self.page.screenshot(full_page=True, timeout=self.timeout * 1000)
            viewport = self.page.viewport_size or {}
            coords = vision_click_coordinates(
                png_bytes,
                element_description=f"element_name='{element_name}', label='{hint}'",
                action_type="click",
                page_width=viewport.get("width"),
                page_height=viewport.get("height"),
            )
            if coords and coords.get("confidence") in ("high", "medium"):
                self.page.mouse.click(coords["x"], coords["y"])
                self.last_resolution = {
                    "element_name": element_name, "strategy": "VISION",
                    "value": coords.get("reasoning", hint),
                    "self_healed": False,
                    "vision_confidence": coords.get("confidence"),
                }
                return True
        except Exception:
            pass
        return False

    def click_if_present(self, element_name: str):
        """
        Like click() above, but for a step that's genuinely OPTIONAL - a
        popup, dialog, or \"Skip\"/\"OK\" style button that may or may not
        appear on a given run (e.g. a post-login interstitial that only
        shows sometimes). Imported from a UiPath CLICK-CONDITIONAL step
        (see generator/uipath_importer.py) - unlike a normal click(), NO
        failure to click is treated as an error here: this returns
        quietly instead of raising, so the rest of the flow continues
        normally whether or not this particular click happened. Still
        performs a REAL click using the exact same logic as click()
        whenever the element does resolve and IS clickable - the only
        difference is what happens when it isn't.

        Catches PlaywrightError (the base class), not just
        PlaywrightTimeoutError - a real failure seen in practice: the
        element simply never appearing within the timeout does raise
        TimeoutError (a subclass of Error), but a DIFFERENT failure - the
        element resolving but then failing to actually click for some
        other reason (detached from the DOM, a strict-mode violation,
        etc.) - raises plain Error instead, which a narrower `except
        PlaywrightTimeoutError` does NOT catch. Since this step is
        supposed to be a no-op whenever it can't cleanly click, ANY
        Playwright-level failure here should be swallowed the same way,
        not just a timeout specifically.
        """
        try:
            self.click(element_name)
        except PlaywrightError:
            pass

    def set_checked(self, element_name: str, checked: bool):
        """
        Sets a checkbox/radio to an explicit target state - idempotent by
        design (reads the current state first and does nothing further if
        it's already correct), which is what makes replay safe from the
        double-toggle a blind click() risks: if an earlier fallback tier
        actually succeeded before raising, or this step re-runs, checking
        the current state first means we never click a second time by
        mistake. Used instead of click() specifically for recorded
        radio/checkbox actions (see generator/build.py) - the recorded
        value is the RESULTING checked state captured right after the
        original click, not just "click happened".
        """
        el = self._find(element_name)
        if not self._looks_visually_hidden(el):
            self._safe_scroll(el)

        try:
            current = el.is_checked()
        except PlaywrightError:
            current = None
        if current == checked:
            return

        if not self._looks_visually_hidden(el):
            try:
                (el.check if checked else el.uncheck)(timeout=self.timeout * 1000)
                return
            except (PlaywrightTimeoutError, PlaywrightError) as e:
                if _navigation_interrupted(e):
                    return
                try:
                    (el.check if checked else el.uncheck)(timeout=self.timeout * 1000, force=True)
                    return
                except (PlaywrightTimeoutError, PlaywrightError) as e2:
                    if _navigation_interrupted(e2):
                        return

        # Last resort, and the direct path for visually-hidden elements:
        # re-verify the live state right before acting (in case an earlier
        # tier above partially succeeded despite raising) so this never
        # dispatches a click that isn't actually needed.
        try:
            already = bool(el.evaluate("node => !!node.checked", timeout=self.timeout * 1000))
        except PlaywrightError:
            already = None
        if already != checked:
            try:
                el.evaluate("node => node.click()", timeout=self.timeout * 1000)
            except (PlaywrightTimeoutError, PlaywrightError) as e:
                if not _navigation_interrupted(e):
                    raise

    def type_text(self, element_name: str, value: str):
        el = self._find(element_name)
        self._safe_scroll(el)
        try:
            el.fill(value, timeout=self.timeout * 1000)
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if _navigation_interrupted(e):
                return
            el.evaluate(
                "(node, val) => {"
                "  node.value = val;"
                "  node.dispatchEvent(new Event('input', {bubbles: true}));"
                "  node.dispatchEvent(new Event('change', {bubbles: true}));"
                "}",
                value,
                timeout=self.timeout * 1000,
            )

    def paste_text(self, element_name: str, value: str):
        """
        Like type_text(), but for a recorded PASTE action specifically:
        dispatches a real synthetic 'paste' ClipboardEvent instead of just
        setting the field's value. fill()/direct value-setting alone never
        fires a 'paste' event, so an app with its own onPaste handling
        (rich text editors, OTP boxes, format-on-paste fields like phone/
        currency inputs) wouldn't see anything happen with type_text()
        alone even though the DOM value looks right. If no listener calls
        preventDefault() on the synthetic event (i.e. nothing intercepted
        it), this applies the same default fill behavior itself, matching
        what a real unhandled paste does.
        """
        el = self._find(element_name)
        self._safe_scroll(el)
        try:
            el.evaluate(
                "(node, val) => {"
                "  node.focus();"
                "  const dt = new DataTransfer();"
                "  dt.setData('text/plain', val);"
                "  const evt = new ClipboardEvent('paste', {"
                "    clipboardData: dt, bubbles: true, cancelable: true"
                "  });"
                "  const notCancelled = node.dispatchEvent(evt);"
                "  if (notCancelled) {"
                "    node.value = val;"
                "    node.dispatchEvent(new Event('input', {bubbles: true}));"
                "    node.dispatchEvent(new Event('change', {bubbles: true}));"
                "  }"
                "}",
                value,
                timeout=self.timeout * 1000,
            )
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if not _navigation_interrupted(e):
                self.type_text(element_name, value)

    def press_key(self, element_name: str, key_name: str):
        """
        Sends a key or Ctrl/Shift combo (Enter, Backspace, Arrow Up/Down/Left/Right,
        Tab, Shift+Tab, Escape, Delete, Space, Home, End, F1-F12, Ctrl+A/C/V/X/P/S,
        etc.) to the element via Playwright's press() - key_name is one of the
        values the recorder captures (e.g. "ENTER", "BACKSPACE", "ARROW_UP", "CTRL+A").
        """
        key_name = (key_name or "").upper()
        el = self._find(element_name)
        self._safe_scroll(el)

        key = _COMBO_MAP.get(key_name) or _KEY_MAP.get(key_name)
        if key is None:
            raise ValueError(
                f"Unsupported key '{key_name}'. Known keys: {sorted(list(_KEY_MAP) + list(_COMBO_MAP))}"
            )
        try:
            el.press(key, timeout=self.timeout * 1000)
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if _navigation_interrupted(e):
                return
            el.evaluate("node => node.focus()", timeout=self.timeout * 1000)
            el.press(key, timeout=self.timeout * 1000)

    def press_enter(self, element_name: str):
        """Kept for backward compatibility - equivalent to press_key(element_name, "ENTER")."""
        self.press_key(element_name, "ENTER")

    def press_backspace(self, element_name: str):
        self.press_key(element_name, "BACKSPACE")

    def press_arrow_up(self, element_name: str):
        self.press_key(element_name, "ARROW_UP")

    def press_arrow_down(self, element_name: str):
        self.press_key(element_name, "ARROW_DOWN")

    def press_tab(self, element_name: str):
        self.press_key(element_name, "TAB")

    def press_shift_tab(self, element_name: str):
        self.press_key(element_name, "SHIFT+TAB")

    def press_escape(self, element_name: str):
        self.press_key(element_name, "ESCAPE")

    def press_ctrl_a(self, element_name: str):
        self.press_key(element_name, "CTRL+A")

    def press_ctrl_s(self, element_name: str):
        self.press_key(element_name, "CTRL+S")

    def press_ctrl_p(self, element_name: str):
        self.press_key(element_name, "CTRL+P")

    def hover_element(self, element_name: str,
                      recorded_cx=None, recorded_cy=None) -> None:
        """Generic multi-level hover execution for CSS :hover navigation menus.

        Root cause this solves
        ----------------------
        CSS :hover menus are purely coordinate-driven — the browser shows a
        submenu only while the mouse pointer is physically over the parent.
        Playwright's locator.hover() moves the CDP mouse to an element, but
        as soon as the NEXT _find() call runs (to locate the child menu item)
        it may call scroll_into_view_if_needed(), refocus the page, or
        trigger any internal Playwright bookkeeping that repositions the
        virtual cursor — causing the parent menu to collapse before the child
        is found.

        Solution
        --------
        1. Move the mouse to the element using page.mouse.move() at exact
           recorded pixel coordinates (or element bounding box centre if no
           recorded coords).  page.mouse.move() is a raw CDP mouse move — it
           does NOT trigger any scrolling, focusing, or Playwright
           bookkeeping.  The mouse stays where we put it.

        2. Poll for child visibility using getComputedStyle (not aria/class
           attributes) — catches pure CSS :hover menus that change neither.

        3. Store the FULL ordered hover chain in self._hover_chain so any
           subsequent hover or click step can replay the entire sequence of
           parent → child → grandchild moves before looking for its own
           element.  This is what handles 3+ level menus generically.

        4. Before every _find() call inside this method, replay the chain
           to ensure all ancestors are still hovered.

        Multi-level replay contract
        ---------------------------
        Each hover_element() call appends its own position to self._hover_chain.
        The click() method reads self._hover_chain and replays the full
        sequence before retrying a failed _find(), restoring the entire
        hover context regardless of depth.
        """
        import time as _time

        # ── Step 1: Locate element without disturbing mouse position ────────
        # Use _find() with a short timeout first so we don't wait 10s on an
        # element that's only visible after hovering.  We'll retry after moving
        # the mouse.
        el = None
        try:
            el = self._find(element_name)
        except Exception:
            pass

        # ── Step 2: Replay ancestor hover chain before moving ───────────────
        # If previous hover steps have been recorded in _hover_chain, move
        # the mouse through each one in order so their :hover state is
        # restored.  This is the fix for multi-level menus: each level that
        # came before MUST be physically hovered again before we can hover
        # the next level.
        for (prev_cx, prev_cy) in getattr(self, '_hover_chain', []):
            try:
                self.page.mouse.move(prev_cx, prev_cy)
                _time.sleep(0.08)   # small gap so CSS transitions can fire
            except Exception:
                pass

        # ── Step 3: Determine target coordinates ────────────────────────────
        cx, cy = None, None

        # Prefer recorded coordinates — they are the exact pixel position
        # the user's mouse was at during recording.
        if recorded_cx is not None and recorded_cy is not None:
            cx, cy = float(recorded_cx), float(recorded_cy)
        elif el is not None:
            try:
                box = el.bounding_box()
                if box:
                    cx = box["x"] + box["width"] / 2
                    cy = box["y"] + box["height"] / 2
            except Exception:
                pass

        if cx is None:
            # No coordinates — fall back to Playwright hover which at least
            # moves the cursor, even if it may cause minor layout shifts.
            try:
                if el is None:
                    el = self._find(element_name)
                el.hover(timeout=self.timeout * 1000)
            except Exception as _he:
                raise _he
            # Store in chain and return
            if not hasattr(self, '_hover_chain'):
                self._hover_chain = []
            self._hover_chain.append((0, 0))
            self._last_hover_pos = (0, 0)
            return

        # ── Step 4: Move mouse to target ────────────────────────────────────
        # page.mouse.move() is a raw CDP pointer move — no scrolling,
        # no focus change, no Playwright bookkeeping.  This is what keeps
        # CSS :hover alive on ancestor elements while we move to the child.
        self.page.mouse.move(cx, cy)

        # ── Step 5: Wait for child submenu to become visible ────────────────
        # Poll getComputedStyle — catches CSS :hover menus that change no
        # aria attributes or class names.
        deadline = _time.time() + 3.0
        submenu_visible = False
        while _time.time() < deadline:
            # Re-assert mouse position every poll cycle — some applications
            # scroll the page in response to focus changes and displace the
            # viewport, which can shift computed element positions.
            self.page.mouse.move(cx, cy)
            try:
                submenu_visible = self.page.evaluate("""
                    (pos) => {
                        // Check element at recorded coordinates
                        var hit = document.elementFromPoint(pos.cx, pos.cy);
                        if (!hit) return false;
                        // Walk up from hit element looking for a parent with
                        // a visible sibling/child submenu
                        var node = hit;
                        for (var depth = 0; depth < 8 && node && node !== document.body; depth++) {
                            var children = node.querySelectorAll(
                                'ul, ol, [class*="sub"], [class*="drop"],' +
                                '[class*="child"], [class*="menu"], [class*="flyout"]'
                            );
                            for (var i = 0; i < children.length; i++) {
                                var cs = window.getComputedStyle(children[i]);
                                if (cs.display !== 'none' &&
                                    cs.visibility !== 'hidden' &&
                                    parseFloat(cs.opacity || '1') > 0 &&
                                    children[i].offsetWidth > 0) {
                                    return true;
                                }
                            }
                            // Also check aria-expanded anywhere nearby
                            if (node.getAttribute && node.getAttribute('aria-expanded') === 'true') {
                                return true;
                            }
                            node = node.parentElement;
                        }
                        return false;
                    }
                """, {"cx": cx, "cy": cy})
                if submenu_visible:
                    break
            except Exception:
                pass
            _time.sleep(0.1)

        if not submenu_visible:
            # CSS transition may just be slow — give it one more fixed wait
            _time.sleep(0.35)
            self.page.mouse.move(cx, cy)

        # ── Step 6: Append this position to the hover chain ─────────────────
        # Every subsequent hover or click step will replay this chain in
        # order before attempting to locate its own target element.
        if not hasattr(self, '_hover_chain'):
            self._hover_chain = []
        self._hover_chain.append((cx, cy))
        self._last_hover_pos = (cx, cy)

        self.last_resolution = {
            "element_name": element_name, "strategy": "HOVER",
            "coords": (cx, cy), "self_healed": False,
        }

    def set_date(self, element_name: str, value: str, near_anchor: bool = False):
        """
        Set a date field to `value` (ISO format YYYY-MM-DD or the field's
        own format such as DD/MM/YYYY).  Bypasses the calendar popup
        entirely -- types directly into the underlying <input type="date">
        or masked text input, which is far more reliable across browsers.

        Strategy:
          1. Find the element (or, if near_anchor=True, the nearest date
             input to the anchor element).
          2. Determine the field format from its placeholder or type attr.
          3. Fill with real keystrokes (works for masked inputs).
          4. Fall back to setting the value directly via JS.
          5. Blur with Tab.
          6. Assert the field holds the correct date (raises AssertionError).
        """
        import re as _re
        from datetime import date as _d, datetime as _dt

        # Parse ISO date
        try:
            dt = _d.fromisoformat(value[:10])
        except ValueError:
            try:
                dt = _dt.strptime(value, "%d/%m/%Y").date()
            except ValueError:
                dt = None

        if dt is None:
            raise ValueError(f"set_date: cannot parse {value!r}")

        # Locate target element
        try:
            el = self._find(element_name)
        except Exception:
            if near_anchor:
                # Fall back to first date input on the page
                el = self.page.locator('input[type="date"], input[placeholder*="/"], input[placeholder*="-"]').first
            else:
                raise

        self._safe_scroll(el)
        input_type = el.evaluate("n => n.type") or ""
        placeholder = (el.evaluate("n => n.placeholder") or "").upper()

        if input_type == "date":
            # Native date input -- fill with ISO
            try:
                el.fill(dt.isoformat(), timeout=self.timeout * 1000)
            except Exception:
                el.evaluate(
                    "(n, v) => { n.value = v; n.dispatchEvent(new Event('change', {bubbles:true})); }",
                    dt.isoformat(), timeout=self.timeout * 1000,
                )
        else:
            # Masked / text input: determine display format
            if "YYYY" in placeholder or "YYYY-MM" in placeholder:
                fmt = f"{dt.year:04d}-{dt.month:02d}-{dt.day:02d}"
            elif "MM/DD/YYYY" in placeholder:
                fmt = f"{dt.month:02d}/{dt.day:02d}/{dt.year:04d}"
            else:  # default DD/MM/YYYY
                fmt = f"{dt.day:02d}/{dt.month:02d}/{dt.year:04d}"

            digits_only = _re.sub(r"\D", "", fmt)
            try:
                el.triple_click(timeout=self.timeout * 1000)
                el.type(fmt, timeout=self.timeout * 1000)
            except Exception:
                # Some masked inputs only accept digit keys
                try:
                    el.triple_click(timeout=self.timeout * 1000)
                    el.type(digits_only, timeout=self.timeout * 1000)
                except Exception:
                    el.evaluate(
                        "(n, v) => { n.value = v; n.dispatchEvent(new Event('input', {bubbles:true})); n.dispatchEvent(new Event('change', {bubbles:true})); }",
                        fmt, timeout=self.timeout * 1000,
                    )

            # Blur
            try:
                el.press("Tab", timeout=self.timeout * 1000)
            except Exception:
                pass

        self.last_resolution = {
            "element_name": element_name, "strategy": "SET_DATE", "value": value, "self_healed": False,
        }

    def capture_value(self, element_name: str) -> str:
        """
        Reads the CURRENT live value out of an element for the Capture ->
        Store -> Reuse variable pipeline (see runner/variables.py). Prefers
        Playwright DOM extraction - input_value() for inputs/textareas/selects,
        falling back to text_content() for non-input elements/labels - since
        that's the most reliable, headless-friendly way to read it. Only if
        the element exposes neither does this fall back to reading the
        browser's own clipboard, still entirely through Playwright
        (page.evaluate calling navigator.clipboard.readText() - no external
        clipboard library involved).
        """
        el = self._find(element_name)
        value = None
        try:
            value = el.input_value(timeout=self.timeout * 1000)
        except PlaywrightError:
            pass
        if not value:
            try:
                value = el.text_content(timeout=self.timeout * 1000)
            except PlaywrightError:
                value = None
        if value:
            return value
        try:
            return self.page.evaluate(
                "async () => {"
                "  try {"
                "    if (navigator.clipboard && navigator.clipboard.readText) {"
                "      return (await navigator.clipboard.readText()) || '';"
                "    }"
                "  } catch (e) {}"
                "  return '';"
                "}"
            ) or ""
        except Exception:
            return ""

    def capture_value_ocr(self, element_name: str) -> str:
        """
        Screenshots this element fresh and runs OCR on it - for a value
        with no real selectable DOM text (an image or canvas-rendered
        reference number, a scanned document field, etc.) that
        capture_value() above can't read at all, since there's no
        input_value()/text_content() to fall back to.

        Re-run LIVE every single test execution (a fresh screenshot, a
        fresh OCR pass), never reusing whatever was read at recording
        time - see recorder/ocr_engine.py's module docstring for why
        (these are typically values the application generates fresh on
        each run, the same reason capture_value() above always reads
        live too). Requires EasyOCR (pip install easyocr Pillow numpy) -
        imported lazily here so a recording with no OCR captures at all
        never needs those installed.
        """
        from recorder.ocr_engine import extract_text_from_png_bytes

        el = self._find(element_name)
        png_bytes = el.screenshot(timeout=self.timeout * 1000)
        return extract_text_from_png_bytes(png_bytes)

    def upload_file(self, element_name: str, file_name: str):
        """
        Handles a recorded file upload. Browsers never expose a chosen
        file's real absolute path to JavaScript (input.value is always a
        fabricated "C:\\fakepath\\<name>" string, for security) - only the
        NAME was ever recordable (see recorder_injector.js's 'file_upload'
        action). That means the actual bytes to upload can't be replayed
        from the recording alone; this looks for a real local file with
        that exact name so Playwright's set_input_files() (the only
        correct API for file inputs - fill()/type() do not work on them)
        has something real to attach.

        Search order for a file named `file_name`:
          1. FIXTURES_DIR (output/fixtures/) - the file used during
             recording is placed here automatically (see
             generator/build.py) whenever it was small enough to capture
             inline, so this is normally already populated by the time
             replay runs.
          2. The output directory itself, in case a file was dropped there
             directly rather than into fixtures/.

        Raises FileNotFoundError with a clear message if it isn't found
        anywhere, rather than silently skipping the upload.
        """
        search_dirs = [FIXTURES_DIR, Path(__file__).parent.parent]
        for directory in search_dirs:
            candidate = directory / file_name
            if candidate.exists():
                el = self._find(element_name)
                el.set_input_files(str(candidate))
                return
        raise FileNotFoundError(
            f"upload_file(\"{element_name}\", \"{file_name}\"): no file named "
            f"'{file_name}' found in {FIXTURES_DIR} or {search_dirs[1]}. "
            f"A browser can never report the real path it was uploaded from "
            f"during recording - place an actual file with this exact name "
            f"under {FIXTURES_DIR} before replaying this step."
        )

    def assert_text_contains(self, element_name: str, expected_text: str):
        """
        Asserts the element's visible text (or, for an input/textarea, its
        current value) contains `expected_text` - a pure check, no click
        or type involved. Used for a recorded/imported "VERIFICATION"-style
        step (e.g. confirming a "Data saved successfully" message actually
        appeared) - see generator/uipath_importer.py.

        Reads the element live, the same way capture_value() does, and
        raises a plain AssertionError (which behave reports as a normal
        failed step, with a clear message) rather than letting a
        Playwright-internal error surface if the text doesn't match.
        """
        el = self._find(element_name)
        try:
            actual = el.input_value(timeout=self.timeout * 1000)
        except PlaywrightError:
            actual = el.text_content(timeout=self.timeout * 1000) or ""
        actual_normalized = " ".join(actual.split())
        expected_normalized = " ".join(expected_text.split())
        if expected_normalized not in actual_normalized:
            raise AssertionError(
                f'Expected "{element_name}" to contain "{expected_text}", but its actual text was "{actual}".'
            )

    def assert_ocr_text_visible(self, expected_text: str, min_confidence: float = 0.35):
        """
        Page-level visual assertion, no DOM element/locator involved at
        all: screenshots the WHOLE page and confirms `expected_text` is
        visibly present somewhere on it via OCR. For content with no DOM
        node to check in the first place - canvas-rendered text,
        image-based labels/buttons, scanned or embedded content -
        assert_text_contains above can't help since there's nothing to
        select; this only needs the text to be genuinely ON SCREEN.

        Raises a plain AssertionError (reported by behave as a normal
        failed step, same as assert_text_contains) including what OCR
        actually read, so a failure is debuggable without needing to open
        the step's screenshot separately - though that screenshot IS
        still captured automatically for every step regardless (see
        runner/environment.py's after_step hook), providing the same
        visual evidence a failed DOM assertion already gets.
        """
        from recorder.ocr_engine import find_text_regions, best_match

        png_bytes = self.page.screenshot(full_page=True, timeout=self.timeout * 1000)
        regions = find_text_regions(png_bytes)
        match = best_match(regions, expected_text, min_confidence=min_confidence)
        if match is None:
            seen = ", ".join(r["text"] for r in regions if r["text"].strip()) or "(no text detected at all)"
            raise AssertionError(
                f'Expected "{expected_text}" to be visible on screen (via OCR), but it was not found. '
                f"Text OCR actually read on this page: {seen}"
            )

    def select_option(self, element_name: str, option_text: str):
        """
        Handles native <select> dropdowns via Playwright's select_option()
        (the reliable way - clicking/sending keys directly to a <select> is
        what usually causes "dropdown issues"). Falls back to selecting by
        value, then to a generic click-open-and-click-option approach for
        custom (non-native) dropdown widgets that aren't real <select>
        elements.
        """
        el = self._find(element_name)
        self._safe_scroll(el)

        tag_name = el.evaluate("node => node.tagName.toLowerCase()", timeout=self.timeout * 1000)
        if tag_name == "select":
            try:
                el.select_option(label=option_text, timeout=self.timeout * 1000)
                return
            except (PlaywrightTimeoutError, PlaywrightError) as e:
                if _navigation_interrupted(e):
                    return
            try:
                el.select_option(value=option_text, timeout=self.timeout * 1000)
                return
            except (PlaywrightTimeoutError, PlaywrightError) as e:
                if _navigation_interrupted(e):
                    return

        # Not a native <select>, or text/value didn't match an <option> exactly -
        # treat it as a custom dropdown: open it, then click the option by its text.
        try:
            el.click(timeout=self.timeout * 1000)
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if not _navigation_interrupted(e):
                raise
        # Search within the SAME iframe (if any) the dropdown itself lives
        # in, not the top page - a custom dropdown's option list almost
        # always renders inside that same document.
        root = self._frame_root(element_name)
        option = root.locator(f"xpath=//*[normalize-space(text())={_xpath_literal(option_text)}]")
        try:
            option.first.click(timeout=self.timeout * 1000)
        except (PlaywrightTimeoutError, PlaywrightError) as e:
            if not _navigation_interrupted(e):
                raise


