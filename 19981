@echo off
title AI Test Recorder - Local Agent
color 3F
echo.
echo ================================================
echo   AI Test Recorder - Local Agent
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0"

REM build-venv is inside the project folder (ai-test-recorder-pw\build-venv)
set VENV_PATH=%~dp0build-venv

if not exist "%VENV_PATH%\Scripts\activate.bat" (
    echo [ERROR] Virtual environment not found at: %VENV_PATH%
    echo Expected structure:
    echo   ai-test-recorder-pw\
    echo     build-venv\   ^<-- venv should be here
    echo     local_agent\
    pause
    exit /b 1
)

REM Check SERVER_URL is set
if "%SERVER_URL%"=="" (
    echo [WARNING] SERVER_URL is not set. Using default.
    set SERVER_URL=http://10.1.161.165:8000
    echo To set permanently run this once and restart:
    echo   setx SERVER_URL "http://10.1.161.165:8000"
    echo.
)

echo [1/2] Activating build-venv...
call "%VENV_PATH%\Scripts\activate.bat"

echo [2/2] Starting local agent...
echo.
echo  Server URL : %SERVER_URL%
echo  Press Ctrl+C to stop
echo.

:retry
python -m local_agent.main
echo.
echo [INFO] Agent stopped. Restarting in 5 seconds...
echo  Press Ctrl+C to exit
timeout /t 5 /nobreak >nul
goto retry
