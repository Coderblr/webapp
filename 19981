import { useEffect, useState } from "react";
import { recordingsApi } from "@/lib/api";
import { Callout, Spinner } from "@/components/ui";

const ACTION_LABELS = {
  click: "Click",
  type: "Type",
  select: "Select",
  keypress: "Key press",
  delay: "Wait",
  scroll: "Scroll",
  window_closed: "Close tab",
  assert_text: "Verify text",
  assert_ocr_text: "Verify text (OCR)",
  file_upload: "Upload file",
  copy: "Copy",
  ocr_capture: "Capture (OCR)",
};

/**
 * Read-only, numbered timeline of a recording's actions - reuses the
 * SAME data StepEditor.js's editable grid already fetches
 * (recordingsApi.getSteps), just rendered for reading rather than
 * editing. Purpose-built to surface the Capture -> Store -> Reuse
 * relationship (spec's "COPY/PASTE relationship" requirement) that
 * StepEditor's Excel-style grid has no room to show: a "copy" row
 * displays the {{variable}} it was captured as, and a "paste"/"type" row
 * whose value was runtime-resolved from an earlier copy (see
 * recorder/variable_capture.py, backend/api.py's resolved_var field)
 * displays which one.
 */
export default function ActionTimeline({ recordingFile }) {
  const [steps, setSteps] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [expanded, setExpanded] = useState(null);

  useEffect(() => {
    setSteps([]);
    setError(null);
    if (!recordingFile) return;
    setLoading(true);
    recordingsApi
      .getSteps(recordingFile)
      .then((r) => setSteps(r.steps))
      .catch((e) => setError(e.detail || e.message))
      .finally(() => setLoading(false));
  }, [recordingFile]);

  if (loading) return <Spinner label="Loading actions..." />;
  if (error) return <Callout tone="error">Could not load actions: {error}</Callout>;
  if (steps.length === 0) return <p className="text-sm text-muted">This recording has no actions yet.</p>;

  return (
    <div className="space-y-1.5">
      {steps.map((s, i) => {
        const isOpen = expanded === i;
        return (
          <div key={i} className="rounded-sm border border-line bg-panel">
            <button
              type="button"
              className="flex w-full items-center gap-3 px-3 py-2 text-left hover:bg-rail"
              onClick={() => setExpanded(isOpen ? null : i)}
            >
              <span className="w-8 shrink-0 font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</span>
              <span className="w-32 shrink-0 text-xs font-semibold uppercase tracking-wide text-signal-slate">
                {ACTION_LABELS[s.action] || s.action}
              </span>
              <span className="min-w-0 flex-1 truncate text-sm text-ink">{s.label || <span className="text-muted">—</span>}</span>
              {s.captured_as && (
                <span className="shrink-0 rounded-sm bg-brand-blueLight px-1.5 py-0.5 font-mono text-xs text-brand-blue">
                  {"{{" + s.captured_as + "}}"}
                </span>
              )}
              {s.resolved_var && (
                <span className="shrink-0 rounded-sm bg-[#EAF5F2] px-1.5 py-0.5 font-mono text-xs text-signal-tealDark">
                  ← {"{{" + s.resolved_var + "}}"}
                </span>
              )}
              <span className="shrink-0 text-muted">{isOpen ? "⌄" : "›"}</span>
            </button>
            {isOpen && (
              <div className="space-y-1 border-t border-line px-3 py-2 text-xs text-muted">
                {s.value != null && s.value !== "" && (
                  <div>
                    <span className="font-medium text-ink">Value: </span>
                    <span className="font-mono">{s.value}</span>
                  </div>
                )}
                {s.resolved_var && (
                  <div>
                    Resolved at runtime from the earlier <span className="font-mono">{"{{" + s.resolved_var + "}}"}</span> copy -
                    not the recording-time value shown above.
                  </div>
                )}
                {s.locators?.length > 0 && (
                  <div>
                    <span className="font-medium text-ink">Locators: </span>
                    {s.locators.map((l) => `${l.strategy}=${l.value}`).join("  |  ")}
                  </div>
                )}
                {(!s.locators || s.locators.length === 0) && <div>No locator - page-level action.</div>}
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}
