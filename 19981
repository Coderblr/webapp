"""
Shared recording-ownership/version/access-control helpers - used by
backend/api.py (the existing recordings/*.json-path-identified routes) AND
backend/recording_routes.py (the new recording_id-identified versioning/
sharing/export/import routes), so there's exactly one implementation of
"does this user have access" and "how does an edit become a new version",
not one per route file. Mirrors how backend/agent_registry.py is already a
shared module both backend/api.py and backend/agent_routes.py import from.

See database/models.py's Recording/RecordingVersion/RecordingShare
docstrings for the underlying schema and the legacy/unowned (owner_user_id
IS NULL -> open to everyone) backward-compat rule, and
database/repository.py for the raw CRUD this builds on.
"""
from __future__ import annotations
import hashlib
import json
from datetime import datetime
from pathlib import Path
from typing import Literal, Optional

from fastapi import HTTPException
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from database.models import Recording
from database import repository as repo

ROOT = Path(__file__).resolve().parents[1]
RECORDINGS_DIR = ROOT / "recordings"
VERSIONS_DIR = RECORDINGS_DIR / "versions"

Permission = Literal["view", "execute", "edit", "export"]


def resolve_within_recordings_dir(file: str) -> Path:
    """The one containment/existence check for a recordings/*.json path -
    backend/api.py's _safe_recording_path is a thin wrapper around this
    (single implementation, not two), and it's also used directly by
    run_saved_recording, which previously had no containment check of its
    own at all despite taking a raw path string from the client."""
    recordings_dir = RECORDINGS_DIR.resolve()
    path = Path(file).resolve()
    if recordings_dir not in path.parents or path.suffix != ".json":
        raise HTTPException(status_code=400, detail="Invalid recording file")
    if not path.exists():
        raise HTTPException(status_code=404, detail="Recording not found")
    return path


def get_or_create_recording(session: Session, path: Path, owner_user_id: Optional[int] = None) -> Recording:
    """Looks up the Recording row for this file path, creating one
    on-demand (as owner_user_id=None / legacy / open-to-everyone unless
    `owner_user_id` is given) if this is the first time it's been touched
    since this feature shipped - so every recording that already existed
    on disk "just works" without a separate startup backfill sweep.
    `owner_user_id` is only used on first-creation; ignored for a row that
    already exists.

    The check-then-insert below is NOT atomic, and this function is called
    once per file on every GET /api/recordings (backend/api.py) - a plain
    sync FastAPI route runs in a threadpool, so two near-simultaneous
    requests for the same not-yet-adopted file (a second browser tab, a
    background poll racing a page load, etc.) can both see "no row yet"
    and both attempt the INSERT, one of them hitting a UNIQUE constraint
    violation on file_path. Recover from that specific race by retrying
    the SELECT inside a SAVEPOINT (session.begin_nested()) rather than
    just letting it raise - a savepoint rollback only undoes THIS insert
    attempt, not the whole caller's session/transaction, which may already
    have created rows for other recordings earlier in the same request's
    loop (see backend/api.py's get_recordings)."""
    existing = repo.get_recording_by_path(session, str(path))
    if existing is not None:
        return existing
    try:
        with session.begin_nested():
            return repo.create_recording(session, owner_user_id=owner_user_id, name=path.stem, file_path=str(path))
    except IntegrityError:
        existing = repo.get_recording_by_path(session, str(path))
        if existing is not None:
            return existing
        raise


def check_access(recording: Recording, current_user, required: Permission) -> bool:
    if recording.owner_user_id is None:
        return True  # legacy/unowned - open to everyone, see Recording's docstring
    if current_user.is_admin or current_user.user_id == recording.owner_user_id:
        return True
    share = next((s for s in recording.shares if s.shared_with_user_id == current_user.user_id), None)
    if share is None:
        return False
    if share.expires_at is not None and share.expires_at < datetime.utcnow():
        return False
    if required == "view":
        return True  # any non-expired share grants at least view
    return bool(getattr(share, f"can_{required}", False))


def require_access(session: Session, path: Path, current_user, required: Permission) -> Recording:
    """get_or_create_recording + check_access, raising HTTPException(403)
    on denial - the one-liner every gated route in backend/api.py and
    backend/recording_routes.py calls."""
    recording = get_or_create_recording(session, path)
    if not check_access(recording, current_user, required):
        raise HTTPException(status_code=403, detail=f"You don't have {required} access to this recording.")
    return recording


def hash_actions(actions: list) -> str:
    return hashlib.sha256(json.dumps(actions, sort_keys=True, default=str).encode("utf-8")).hexdigest()


def snapshot_version(
    session: Session, *, recording: Recording, recording_json: dict, version_number: int,
    created_by_user_id: Optional[int], change_summary: Optional[str] = None,
) -> None:
    """Writes `recording_json` to a new version snapshot file under
    recordings/versions/<recording_id>/v<N>.json AND to the Recording's
    main file_path (so every existing reader keeps seeing "current" at the
    exact same path it always has - nothing about the main file's location
    or the fact that it holds the full/current content changes). Inserts
    the RecordingVersion row and bumps Recording.current_version_number/
    updated_at. Called both at initial creation (version_number=1) and on
    every edit (version_number=recording.current_version_number + 1)."""
    version_dir = VERSIONS_DIR / str(recording.recording_id)
    version_dir.mkdir(parents=True, exist_ok=True)
    version_path = version_dir / f"v{version_number}.json"
    payload = json.dumps(recording_json, indent=2, default=str)
    version_path.write_text(payload)
    Path(recording.file_path).write_text(payload)

    repo.create_recording_version(
        session, recording_id=recording.recording_id, version_number=version_number,
        file_path=str(version_path), created_by_user_id=created_by_user_id,
        change_summary=change_summary, recording_hash=hash_actions(recording_json.get("actions", [])),
    )
    repo.touch_recording(session, recording.recording_id, current_version_number=version_number)


def create_recording_with_initial_version(
    session: Session, *, owner_user_id: Optional[int], name: str, path: Path, recording_json: dict,
) -> Recording:
    """The 3 recording-creation call sites (stop_and_save's agent/server
    branches, UiPath import, and package import) all funnel through this -
    create the Recording row, then snapshot version 1 from the content
    that was just written to `path`."""
    recording = repo.create_recording(session, owner_user_id=owner_user_id, name=name, file_path=str(path))
    snapshot_version(
        session, recording=recording, recording_json=recording_json, version_number=1,
        created_by_user_id=owner_user_id, change_summary="Initial recording",
    )
    return recording
