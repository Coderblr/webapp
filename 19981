# ── recording ───────────────────────────────────────────────────────────
@router.post("/start")
def start_recording(payload: RecordingStartRequest) -> dict[str, Any]:
    if payload.transaction_id == settings.password_change_transaction:
        # See generator.py::generate_all()'s matching guard for the full
        # explanation — 9750's feature/page/steps are hand-written
        # framework files, never generated from a recording. Rejecting
        # here (before a recording session is even opened) surfaces the
        # problem immediately instead of after the person has already
        # walked through the whole password-change screen.
        raise HTTPException(
            400,
            f"Transaction {payload.transaction_id} is reserved for the "
            "mandatory password-change pre-step and can't be recorded as "
            "a regular transaction. If its locators need updating, patch "
            "python-framework/pages/transaction_9750_page.py directly, or "
            "let self-healing apply the fix during execution.",
        )

    def on_event(event: dict[str, Any]) -> None:
        hub.publish("recorder", event)

    # A fresh recording session — a client connecting late into THIS
    # session should never get a previous, unrelated session's tail end
    # replayed to it first.
    hub.clear_backlog("recorder")

    result = recorder_agent(
        action="start",
        transaction_id=payload.transaction_id,
        transaction_name=payload.transaction_name,
        start_url=payload.start_url,
        environment=payload.environment,
        transaction_type=payload.transaction_type,
        description=payload.description,
        fullpage_crawl=payload.fullpage_crawl,
        capture_network=payload.capture_network,
        capture_recorded_values=payload.capture_recorded_values,
        capture_sensitive_values=payload.capture_sensitive_values,
        on_event=on_event,
    )
    if not result.ok:
        raise HTTPException(500, result.get("error", "could not start recording"))
    return {
        "session": result["session"],
        "prior_knowledge": result.get("prior_knowledge", {}),
        "thread_id": f"rec_{payload.transaction_id}_{uuid.uuid4().hex[:6]}",
    }


