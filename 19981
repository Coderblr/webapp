/*
 * execution.js
 * "Select Recording -> Execute Recording" screen (spec sections 25-28):
 * recording dropdown, browser choice, custom test data, AI provider
 * override, live execution progress via WebSocket.
 */

let executionSocket = null;
let lastExecutionId = null;
let lastRecordingIdForReport = null;

// ---------------------------------------------------------------------
// Review & Edit Steps (spec: the Excel dataset is the editable source of
// truth for the fast execution path). The executor always re-reads
// execution.xlsx from disk right before running, so saving edits here
// takes effect on the very next "Execute Recording" click - no separate
// "apply" step needed.
// ---------------------------------------------------------------------
let editableSteps = []; // last-loaded full row dicts (every Excel column), edited in place
let removedStepRows = new Set(); // indices into editableSteps marked for deletion, applied on Save
let stepColumns = []; // full Excel column list for this recording, from GET .../steps

const STEPS_EDITABLE_COLUMNS = [
  { key: "Action", label: "Action" },
  { key: "Element_Name", label: "Element" },
  { key: "Primary_Locator_Type", label: "Locator Type" },
  { key: "Primary_Locator", label: "Primary Locator" },
  { key: "Value", label: "Value" },
  { key: "Test_Data_Key", label: "Test Data Key" },
  // Capture -> Store -> Reuse: Captured_As names the {{variable}} a CAPTURE
  // step's live-read value gets stored under; Resolved_Variable names the
  // variable a LATER step's value should be re-read from at execution time
  // instead of replaying the (possibly stale, e.g. a system-generated
  // application ID/OTP) literal in the Value column. Both are auto-filled
  // by the recorder's correlation logic but editable here like every other
  // column, e.g. to correct a false-positive match or wire one up by hand.
  { key: "Captured_As", label: "Captured As" },
  { key: "Resolved_Variable", label: "Resolved Variable" },
  // Optional_Step: type Y (or yes/true/1) to mark this step's element as
  // expected to sometimes be legitimately absent (a conditional table row,
  // one branch of a maker-checker flow, etc). A failed lookup then gets a
  // short wait, skips AI self-healing, and is reported as SKIP instead of
  // FAIL - see Executor._run_step() in the backend. Leave blank for a
  // normal step.
  { key: "Optional_Step", label: "Optional (Y/blank)" },
  { key: "Expected_Result", label: "Expected Result" },
];

// escapeHtml() is defined once in app.js (loaded before this file) and
// reused here.

async function loadStepsEditor() {
  const recording_id = document.getElementById("exec-recording").value;
  const statusEl = document.getElementById("steps-editor-status");
  const saveBtn = document.getElementById("btn-save-steps");
  if (!recording_id) { statusEl.textContent = "Select a recording first."; return; }
  statusEl.textContent = "Loading steps...";
  try {
    const res = await Api.get(`/api/recordings/${recording_id}/steps`);
    editableSteps = res.steps || [];
    stepColumns = res.columns || [];
    removedStepRows = new Set();
    renderStepsEditorTable();
    statusEl.textContent = editableSteps.length ? `Loaded ${editableSteps.length} step(s). Edit any cell (including the locator, if self-healing couldn't fix a broken one), tick Remove for a step that shouldn't run, or Add Step to insert a new one, then Save Changes.` : "This recording has no steps yet. Use Add Step to create one.";
    saveBtn.disabled = true;
  } catch (e) {
    document.getElementById("steps-editor-table").innerHTML = "";
    statusEl.textContent = "Failed to load steps: " + e.message;
  }
}

function renderStepsEditorTable() {
  const container = document.getElementById("steps-editor-table");
  if (!editableSteps.length) {
    container.innerHTML = "";
    return;
  }
  const rows = editableSteps.map((step, idx) => {
    const editableCells = STEPS_EDITABLE_COLUMNS.map(
      (c) => `<td><input type="text" data-row="${idx}" data-col="${c.key}" value="${escapeHtml(step[c.key])}"></td>`
    ).join("");
    const removed = removedStepRows.has(idx);
    return `<tr style="${removed ? "opacity:0.4;text-decoration:line-through;" : ""}">
      <td><input type="checkbox" data-remove-row="${idx}" ${removed ? "checked" : ""} title="Remove this step - it won't be executed"></td>
      <td>${escapeHtml(step.Step_Number)}</td>
      ${editableCells}
    </tr>`;
  }).join("");

  container.innerHTML = `
    <table>
      <thead><tr>
        <th>Remove</th><th>Step</th>
        ${STEPS_EDITABLE_COLUMNS.map((c) => `<th>${c.label}</th>`).join("")}
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;

  container.querySelectorAll("input[data-row]").forEach((input) => {
    input.addEventListener("input", () => {
      const row = Number(input.dataset.row);
      const col = input.dataset.col;
      editableSteps[row][col] = input.value;
      document.getElementById("btn-save-steps").disabled = false;
    });
  });

  container.querySelectorAll("input[data-remove-row]").forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      const row = Number(checkbox.dataset.removeRow);
      if (checkbox.checked) removedStepRows.add(row); else removedStepRows.delete(row);
      document.getElementById("btn-save-steps").disabled = false;
      renderStepsEditorTable();
    });
  });
}

function addStepRow() {
  if (!stepColumns.length) return; // Load Steps first so we know the column shape
  const maxStep = editableSteps.reduce((m, s) => Math.max(m, Number(s.Step_Number) || 0), 0);
  const blank = {};
  stepColumns.forEach((col) => { blank[col] = ""; });
  blank.Step_Number = maxStep + 1;
  blank.Action = "HOVER";
  // best-effort default so a brand-new step still lands on the right page;
  // the user can overwrite Primary_Locator_Type/Primary_Locator themselves.
  const last = editableSteps[editableSteps.length - 1];
  if (last) {
    blank.Page_URL = last.Page_URL || "";
    blank.Page_Title = last.Page_Title || "";
  }
  editableSteps.push(blank);
  renderStepsEditorTable();
  document.getElementById("btn-save-steps").disabled = false;
  document.getElementById("steps-editor-status").textContent = `Added step ${blank.Step_Number} (defaulted to Action=HOVER) — fill in Element/Locator Type/Primary Locator, then Save Changes.`;
}

async function saveStepsEditor() {
  const recording_id = document.getElementById("exec-recording").value;
  const statusEl = document.getElementById("steps-editor-status");
  if (!recording_id || !editableSteps.length) return;
  const stepsToSave = editableSteps.filter((_, idx) => !removedStepRows.has(idx));
  if (!stepsToSave.length) { statusEl.textContent = "Can't save - every step is marked Remove. Un-tick at least one."; return; }
  statusEl.textContent = "Saving...";
  try {
    await Api.put(`/api/recordings/${recording_id}/steps`, { steps: stepsToSave });
    editableSteps = stepsToSave;
    removedStepRows = new Set();
    renderStepsEditorTable();
    statusEl.textContent = `Saved. Execution will use these ${stepsToSave.length} step(s).`;
    document.getElementById("btn-save-steps").disabled = true;
  } catch (e) {
    statusEl.textContent = "Failed to save: " + e.message;
  }
}

async function refreshExecuteRecordingOptions() {
  const select = document.getElementById("exec-recording");
  try {
    const recordings = await Api.get("/api/recordings");
    select.innerHTML = recordings
      .filter((r) => r.status !== "recording")
      .map((r) => `<option value="${r.recording_id}">${r.name} (${r.total_steps || 0} steps)</option>`)
      .join("");
  } catch (e) {
    select.innerHTML = "<option>Unable to load recordings</option>";
  }
}

function connectExecutionSocket(executionId, recordingId) {
  if (executionSocket) executionSocket.close();
  executionSocket = new WebSocket(Api.wsUrl(`/ws/execution/${executionId}`));
  const bar = document.getElementById("exec-progress-bar");
  const summaryEl = document.getElementById("exec-progress-summary");
  const stepEl = document.getElementById("exec-current-step");

  executionSocket.onmessage = (msg) => {
    const evt = JSON.parse(msg.data);
    if (evt.type === "progress") {
      const pct = Math.round((evt.step_number / Math.max(evt.total_steps, 1)) * 100);
      bar.style.width = pct + "%";
      summaryEl.textContent = `Step ${evt.step_number} / ${evt.total_steps} — ${evt.status}`;
      stepEl.textContent = `Action: ${evt.action}  |  Element: ${evt.element_name || "-"}  |  Locator: ${evt.locator_used || "-"}  |  Status: ${evt.status}`;
    } else if (evt.type === "done") {
      summaryEl.textContent = `Execution finished with status: ${evt.status}`;
      document.getElementById("btn-terminate-execution").disabled = true;
      fetchExecutionResult(executionId, recordingId);
    } else if (evt.type === "error") {
      summaryEl.textContent = "Error: " + evt.message;
      document.getElementById("btn-terminate-execution").disabled = true;
    }
  };
}

async function fetchExecutionResult(executionId, recordingId) {
  document.getElementById("btn-terminate-execution").disabled = true;
  try {
    const result = await Api.get(`/api/executions/${executionId}`);
    if (result.status === "terminated") {
      // Excel path still produces a proper pass/fail/heal/skip summary
      // (remaining steps are just marked SKIP); the Behave path's result
      // is a raw {success, error, terminated} dict instead - handle both.
      const s = result.summary && typeof result.summary.passed === "number" ? result.summary : null;
      document.getElementById("exec-progress-summary").textContent = s
        ? `Terminated by user: ${s.passed || 0} passed, ${s.failed || 0} failed, ${s.healed || 0} healed, ${s.skipped || 0} skipped before stopping.`
        : "Execution terminated by user.";
      refreshDashboard();
    } else if (result.summary) {
      const s = result.summary;
      document.getElementById("exec-progress-summary").textContent =
        `Completed: ${s.passed || 0} passed, ${s.failed || 0} failed, ${s.healed || 0} healed, ${s.skipped || 0} skipped.`;
      // Auto-generate the downloadable report.
      await Api.post(`/api/executions/${executionId}/report?recording_id=${recordingId}`);
      refreshDashboard();
      if (typeof refreshReportsTable === "function") refreshReportsTable();
    } else if (result.status === "error") {
      // The run failed before it could produce a step summary - most often
      // a browser/driver launch failure (e.g. a bad CHROME_DRIVER_PATH /
      // EDGE_DRIVER_PATH, or Chrome/Edge not installed). Surface it clearly
      // instead of leaving the progress line stuck on "Starting execution...".
      document.getElementById("exec-progress-summary").textContent = "Execution failed: " + (result.error || "unknown error");
    }
  } catch (e) {
    document.getElementById("exec-progress-summary").textContent = "Failed to fetch execution result: " + e.message;
  }
}

document.addEventListener("DOMContentLoaded", () => {
  // Shares the same remembered value as the Recorder tab's field (same
  // localStorage key) - most people executing on their own PC recorded on
  // it too, so this saves re-typing it a second time.
  try {
    const savedNode = window.localStorage.getItem("ua_remote_node_url");
    if (savedNode) document.getElementById("exec-remote-node").value = savedNode;
  } catch (e) { /* localStorage unavailable - not critical */ }

  document.getElementById("btn-load-steps").addEventListener("click", loadStepsEditor);
  document.getElementById("btn-add-step").addEventListener("click", addStepRow);
  document.getElementById("btn-save-steps").addEventListener("click", saveStepsEditor);
  document.getElementById("exec-recording").addEventListener("change", () => {
    editableSteps = [];
    removedStepRows = new Set();
    stepColumns = [];
    document.getElementById("steps-editor-table").innerHTML = "";
    document.getElementById("steps-editor-status").textContent = "";
    document.getElementById("btn-save-steps").disabled = true;
  });

  document.getElementById("btn-execute").addEventListener("click", async () => {
    const recording_id = document.getElementById("exec-recording").value;
    const browser = document.getElementById("exec-browser").value;
    const ai_provider = document.getElementById("exec-ai-provider").value || null;
    const run_via_behave = document.getElementById("exec-via-behave").checked;
    const remote_node_url = document.getElementById("exec-remote-node").value.trim();
    let test_data = {};
    const raw = document.getElementById("exec-test-data").value.trim();
    if (raw) {
      try { test_data = JSON.parse(raw); } catch (e) { alert("Test Data must be valid JSON"); return; }
    }
    if (!recording_id) { alert("Select a recording first."); return; }

    try { window.localStorage.setItem("ua_remote_node_url", remote_node_url); } catch (e) { /* ignore */ }

    document.getElementById("exec-progress-summary").textContent = remote_node_url
      ? `Starting execution on ${remote_node_url}...`
      : "Starting execution...";
    document.getElementById("exec-progress-bar").style.width = "0%";
    document.getElementById("exec-current-step").textContent = "";

    try {
      const res = await Api.post("/api/execute", { recording_id, browser, test_data, ai_provider, run_via_behave, remote_node_url });
      lastExecutionId = res.execution_id;
      lastRecordingIdForReport = recording_id;
      document.getElementById("btn-terminate-execution").disabled = false;
      connectExecutionSocket(res.execution_id, recording_id);
    } catch (e) {
      document.getElementById("exec-progress-summary").textContent = "Failed to start execution: " + e.message;
    }
  });

  document.getElementById("btn-terminate-execution").addEventListener("click", async () => {
    if (!lastExecutionId) return;
    const btn = document.getElementById("btn-terminate-execution");
    btn.disabled = true;
    document.getElementById("exec-progress-summary").textContent = "Stopping execution...";
    try {
      const res = await Api.post(`/api/executions/${lastExecutionId}/terminate`);
      document.getElementById("exec-progress-summary").textContent = res.message || "Stop requested.";
      // The execution WebSocket's "done" event (and fetchExecutionResult)
      // will report the final terminated/completed status shortly; this is
      // just immediate feedback that the click registered.
    } catch (e) {
      document.getElementById("exec-progress-summary").textContent = "Failed to stop execution: " + e.message;
      btn.disabled = false;
    }
  });
});
