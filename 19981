@echo off
title AI Test Recorder - Frontend
color 2F
echo.
echo ================================================
echo   AI Test Recorder - Frontend
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0frontend"

if not exist "node_modules" (
    echo [INFO] node_modules not found. Installing packages...
    npm install
    if %errorlevel% neq 0 (
        echo [ERROR] npm install failed. Is Node.js installed?
        pause
        exit /b 1
    )
)

if not exist ".next" (
    echo [INFO] Building frontend for first time...
    npm run build
    if %errorlevel% neq 0 (
        echo [ERROR] npm build failed.
        pause
        exit /b 1
    )
)

echo [INFO] Starting frontend on http://localhost:3000
echo.
echo  Access URL : http://localhost:3000
echo  Press Ctrl+C to stop
echo.
npm start

echo.
echo [INFO] Frontend stopped.
pause
