import { useCallback, useEffect, useRef, useState } from "react";
import { WS_BASE } from "@/lib/api";
import { getToken } from "@/lib/auth-storage";
import { Callout } from "@/components/ui";

// Fallback remote viewport size, used only until the first real frame
// tells us the actual size (see recorder/browser_factory.py -
// HEADLESS_VIEWPORT_WIDTH/HEIGHT in .env - defaults match these).
const FALLBACK_WIDTH = 1440;
const FALLBACK_HEIGHT = 900;

// CDP virtual key codes for the handful of control keys that need a real
// key event rather than Input.insertText (see recorder/recorder.py's
// _dispatch_input). Printable characters never go through this map.
const SPECIAL_KEYS = {
  Backspace: 8, Tab: 9, Enter: 13, Escape: 27, Space: 32,
  ArrowLeft: 37, ArrowUp: 38, ArrowRight: 39, ArrowDown: 40, Delete: 46,
  Home: 36, End: 35, PageUp: 33, PageDown: 34,
};

const MOUSE_MOVE_THROTTLE_MS = 40; // ~25fps of mouse-move events is plenty and keeps the socket light

export default function LiveRecordingView({ active }) {
  const imgRef = useRef(null);
  const wsRef = useRef(null);
  const lastMoveRef = useRef(0);
  const remoteSizeRef = useRef({ width: FALLBACK_WIDTH, height: FALLBACK_HEIGHT });

  const [frameSrc, setFrameSrc] = useState(null);
  const [status, setStatus] = useState("connecting"); // connecting | live | error | closed
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!active) {
      setFrameSrc(null);
      setStatus("connecting");
      return undefined;
    }

    const token = getToken();
    const ws = new WebSocket(`${WS_BASE}/api/ws/record?token=${encodeURIComponent(token)}`);
    wsRef.current = ws;
    setStatus("connecting");
    setError(null);

    ws.onmessage = (event) => {
      setFrameSrc(`data:image/jpeg;base64,${event.data}`);
      setStatus("live");
    };
    ws.onerror = () => {
      setStatus("error");
      setError("Live view connection failed.");
    };
    ws.onclose = (event) => {
      setStatus("closed");
      if (event.code >= 4400) {
        setError(event.reason || "Live view disconnected.");
      }
    };

    return () => {
      ws.close();
      wsRef.current = null;
    };
  }, [active]);

  const send = useCallback((payload) => {
    if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {
      wsRef.current.send(JSON.stringify(payload));
    }
  }, []);

  function toRemoteCoords(e) {
    const img = imgRef.current;
    if (!img) return null; // no frame rendered yet - nothing to click/type into
    const rect = img.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return null; // not laid out yet
    const { width, height } = remoteSizeRef.current;
    const scaleX = width / rect.width;
    const scaleY = height / rect.height;
    return {
      x: Math.round((e.clientX - rect.left) * scaleX),
      y: Math.round((e.clientY - rect.top) * scaleY),
    };
  }

  function handleImgLoad() {
    if (imgRef.current) {
      remoteSizeRef.current = {
        width: imgRef.current.naturalWidth || FALLBACK_WIDTH,
        height: imgRef.current.naturalHeight || FALLBACK_HEIGHT,
      };
    }
  }

  function handleMouseDown(e) {
    e.preventDefault();
    const coords = toRemoteCoords(e);
    if (!coords) return;
    send({ type: "mousePressed", x: coords.x, y: coords.y, button: e.button === 2 ? "right" : "left", clickCount: 1 });
  }

  function handleMouseUp(e) {
    e.preventDefault();
    const coords = toRemoteCoords(e);
    if (!coords) return;
    send({ type: "mouseReleased", x: coords.x, y: coords.y, button: e.button === 2 ? "right" : "left", clickCount: 1 });
  }

  function handleMouseMove(e) {
    const now = Date.now();
    if (now - lastMoveRef.current < MOUSE_MOVE_THROTTLE_MS) return;
    lastMoveRef.current = now;
    const coords = toRemoteCoords(e);
    if (!coords) return;
    send({ type: "mouseMoved", x: coords.x, y: coords.y });
  }

  function handleWheel(e) {
    const coords = toRemoteCoords(e);
    if (!coords) return;
    send({ type: "mouseWheel", x: coords.x, y: coords.y, deltaX: e.deltaX, deltaY: e.deltaY });
  }

  function handleKeyDown(e) {
    // Printable, unmodified characters -> Input.insertText (reliably lands
    // in the focused field over CDP - see recorder/recorder.py). Anything
    // else (Backspace, Enter, Tab, arrows, Ctrl/Alt combos, ...) needs a
    // real key event instead.
    const isPrintable = e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey;
    if (isPrintable) {
      e.preventDefault();
      send({ type: "insertText", text: e.key });
      return;
    }
    if (e.key in SPECIAL_KEYS || e.ctrlKey || e.metaKey || e.altKey) {
      e.preventDefault();
      send({
        type: "keyDown",
        key: e.key,
        code: e.code,
        keyCode: SPECIAL_KEYS[e.key] || e.keyCode || 0,
      });
    }
  }

  return (
    <div className="space-y-2">
      <div className="flex items-center gap-2 text-xs">
        <span
          className={`h-1.5 w-1.5 rounded-full ${
            status === "live" ? "bg-signal-teal" : status === "error" ? "bg-signal-rust" : "bg-muted"
          }`}
        />
        <span className="font-medium uppercase tracking-wide text-muted">
          {status === "live" ? "Live" : status === "connecting" ? "Connecting..." : status === "error" ? "Error" : "Disconnected"}
        </span>
      </div>

      {error && <Callout tone="error">{error}</Callout>}

      <div
        className="relative overflow-hidden rounded-sm border border-line bg-[#0E1318]"
        style={{ aspectRatio: `${remoteSizeRef.current.width} / ${remoteSizeRef.current.height}` }}
        tabIndex={0}
        onMouseDown={handleMouseDown}
        onMouseUp={handleMouseUp}
        onMouseMove={handleMouseMove}
        onWheel={handleWheel}
        onKeyDown={handleKeyDown}
        onContextMenu={(e) => e.preventDefault()}
      >
        {frameSrc ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img
            ref={imgRef}
            src={frameSrc}
            onLoad={handleImgLoad}
            alt="Live recording view"
            draggable={false}
            className="h-full w-full select-none object-contain"
          />
        ) : (
          <div className="flex h-full min-h-[300px] items-center justify-center text-sm text-muted">
            Waiting for the remote browser...
          </div>
        )}
      </div>
      <p className="text-xs text-muted">
        Click into the view above, then interact normally - clicks, typing, and scrolling are sent to the real
        server-side browser and recorded exactly as if you were sitting at it.
      </p>
    </div>
  );
}
