"""
Shared OCR helper, used at BOTH:
  - RECORD time (recorder/recorder.py, when the user right-clicks an
    element on the page and chooses "Capture text with OCR" from the
    custom menu injected by recorder_injector.js)
  - REPLAY time (generator/templates/page.tmpl's
    BasePage.capture_value_ocr, called from the generated step - see
    generator/templates/steps.tmpl's "ocr_capture" branch)

One implementation, so both always extract text the exact same way - and
critically, REPLAY re-runs the OCR live every single time the test
executes (a fresh screenshot, fresh OCR pass) rather than reusing
whatever text was read during recording, the same way a plain
copy-captured value is re-read live rather than hard-coded (see
recorder/variable_capture.py's module docstring) - these are usually
values the application generates fresh each run (a new application
number, a new reference ID rendered into an image/canvas rather than
real DOM text), so baking in the recording-time value would make the
generated test increasingly wrong over time.

Uses EasyOCR - a pure-Python OCR engine (pip install easyocr, nothing
else to install separately, unlike Tesseract) built on PyTorch. This is a
genuine trade-off, not a strictly-better choice, worth understanding:
  - Nothing to install on the target machine beyond `pip install easyocr`
    (or whatever's bundled into local_agent's frozen build) - no separate
    binary, no PATH configuration, no corporate-security exclusion needed
    for a second executable.
  - But: it's a MUCH heavier dependency (EasyOCR pulls in PyTorch - use
    the CPU-only build, `pip install torch --index-url
    https://download.pytorch.org/whl/cpu`, NOT the default GPU build,
    which is several GB larger for zero benefit on a laptop with no GPU).
  - And: EasyOCR downloads its detection/recognition model weights
    (~100MB) from the internet the FIRST time a Reader() is ever created
    on a given machine, caching them (default: ~/.EasyOCR/model/, or
    wherever EASYOCR_MODULE_PATH points - see _get_reader below) for
    every run after that. On a machine with restricted/no internet
    access, this first-run download needs to be pre-staged (copy an
    already-populated ~/.EasyOCR/model/ folder over, or point
    EASYOCR_MODULE_PATH at a pre-staged location bundled with the
    installer) BEFORE the first OCR capture is ever attempted there.
  - Reader() initialization itself (loading those model weights into
    memory) takes a few seconds - too slow to redo on every single
    capture, so _get_reader() below creates it ONCE per process and
    reuses it for every subsequent OCR call in that process's lifetime.
"""
from __future__ import annotations
import io
import os
import threading

_reader = None
_reader_lock = threading.Lock()


def _staged_model_dir():
    """Folder of pre-staged EasyOCR weights, for PCs with no internet.
    Order: EASYOCR_MODULE_PATH, then an `easyocr_models` folder next to the
    packaged .exe (what build_desktop_installer.bat / the build instructions
    put there), then None (EasyOCR's own default + download)."""
    env = os.environ.get("EASYOCR_MODULE_PATH")
    if env:
        return env
    try:
        import sys
        exe_dir = os.path.dirname(os.path.abspath(sys.executable))
        for cand in (os.path.join(exe_dir, "easyocr_models"),
                     os.path.join(exe_dir, "_internal", "easyocr_models")):
            if os.path.isdir(cand) and any(f.endswith(".pth") for f in os.listdir(cand)):
                return cand
    except Exception:
        pass
    return None


def _get_reader():
    """Lazily creates ONE EasyOCR Reader for this process's whole
    lifetime (thread-safe) - Reader() itself is slow (loads model
    weights), so this must never be called fresh per-capture. English
    only by default; add languages via OCR_LANGUAGES (comma-separated
    EasyOCR language codes, e.g. "en,hi") if this ever needs to read
    non-English text."""
    global _reader
    if _reader is None:
        with _reader_lock:
            if _reader is None:
                import easyocr
                languages = os.environ.get("OCR_LANGUAGES", "en").split(",")
                model_dir = _staged_model_dir()  # pre-staged model weights, for a machine with no internet access
                _reader = easyocr.Reader(
                    [lang.strip() for lang in languages if lang.strip()],
                    gpu=False,  # laptops running this agent have no GPU worth using - forcing this off also skips a slow, pointless CUDA availability probe
                    model_storage_directory=model_dir,
                    download_enabled=model_dir is None or not os.path.isdir(model_dir),
                )
    return _reader


def ocr_available() -> bool:
    """Best-effort check - used by recorder.py to fail an OCR capture
    request clearly and immediately (rather than partway through) if
    EasyOCR genuinely can't run here (not installed, or model weights
    can't be obtained/found and there's no internet access to fetch
    them)."""
    try:
        _get_reader()
        return True
    except Exception:
        return False


def extract_text_from_png_bytes(png_bytes: bytes) -> str:
    """Runs OCR on a screenshot (PNG bytes, exactly what Playwright's
    `element.screenshot()` returns) and returns the extracted text.
    Multiple detected text regions (EasyOCR reports each line/word
    separately, with its own bounding box) are joined with a single space
    in top-to-bottom, left-to-right reading order - e.g. a reference
    number rendered as two visually-separate pieces ("REF" and "998877")
    comes back as one "REF 998877" string, not a list. Raises a clear,
    actionable RuntimeError - not a raw EasyOCR/PyTorch traceback - if OCR
    genuinely can't run here, since that's a different, more urgent
    problem than "OCR ran but the image had no readable text"."""
    try:
        from PIL import Image
        import numpy as np
    except ImportError as e:
        raise RuntimeError(
            "OCR support isn't fully installed on this machine - "
            "pip install easyocr Pillow numpy "
            "(see local_agent/requirements-agent.txt)."
        ) from e

    try:
        reader = _get_reader()
    except Exception as e:
        raise RuntimeError(explain_init_failure(e)) from e

    image = Image.open(io.BytesIO(png_bytes)).convert("RGB")
    image_array = np.array(image)

    try:
        # detail=0 returns just the recognized strings, already in EasyOCR's
        # own natural (top-to-bottom, left-to-right) reading order - no
        # manual bounding-box sorting needed.
        results = reader.readtext(image_array, detail=0)
    except Exception as e:
        raise RuntimeError(f"OCR failed while reading the captured image: {type(e).__name__}: {e}") from e

    return " ".join(results).strip()



def find_text_regions(png_bytes: bytes) -> list:
    """
    Runs OCR on a full-page screenshot and returns every detected text
    region with its bounding box and confidence score.

    Each returned dict:
        {
            "text":       str,
            "bbox":       {"x": int, "y": int, "width": int, "height": int},
            "confidence": float,   # 0.0-1.0 EasyOCR confidence
        }

    Returns [] silently if OCR is unavailable - never raises, because
    _ocr_click_fallback treats an empty list as "nothing found" and
    falls through to the next strategy cleanly.
    """
    try:
        from PIL import Image
        import numpy as np
    except ImportError:
        return []

    try:
        reader = _get_reader()
        image = Image.open(io.BytesIO(png_bytes)).convert("RGB")
        image_array = np.array(image)
        # detail=1 returns (corners, text, confidence) per region
        raw_results = reader.readtext(image_array, detail=1)
    except Exception:
        return []

    regions = []
    for corners, text, confidence in raw_results:
        if not text or not text.strip():
            continue
        # corners: [[x1,y1],[x2,y1],[x2,y2],[x1,y2]] clockwise from top-left
        xs = [int(c[0]) for c in corners]
        ys = [int(c[1]) for c in corners]
        x, y = min(xs), min(ys)
        w, h = max(xs) - x, max(ys) - y
        regions.append({
            "text": text.strip(),
            "bbox": {"x": x, "y": y, "width": max(w, 1), "height": max(h, 1)},
            "confidence": float(confidence),
        })
    return regions


def best_match(regions: list, hint: str, min_confidence: float = 0.3):
    """
    Finds the text region best matching `hint` (the recorded element
    text/aria-label) from find_text_regions() output.

    Matching tiers (highest to lowest priority):
    1. Exact case-insensitive match
    2. Hint is a substring of region text
    3. Region text is a substring of hint
    4. Word-level overlap ratio

    Regions below min_confidence are ignored. Returns the best
    matching region dict or None if nothing is confident enough.
    Deliberately conservative: returns None rather than a weak match
    so Vision AI gets a chance instead of clicking the wrong element.
    """
    if not hint or not regions:
        return None

    hint_lower = hint.strip().lower()
    hint_words = set(hint_lower.split())
    candidates = []

    for region in regions:
        if region["confidence"] < min_confidence:
            continue
        text = region["text"].strip().lower()
        if not text:
            continue

        if text == hint_lower:
            score = 1.0                                   # tier 1 exact
        elif hint_lower in text:
            score = 0.9 - (len(text) - len(hint_lower)) / max(len(text), 1) * 0.1
        elif text in hint_lower:
            score = 0.8 - (len(hint_lower) - len(text)) / max(len(hint_lower), 1) * 0.1
        else:
            text_words = set(text.split())
            overlap = len(hint_words & text_words) / max(len(hint_words), 1)
            if overlap == 0:
                continue
            score = overlap * 0.7

        # Blend match score with OCR confidence for final ranking
        blended = score * 0.85 + region["confidence"] * 0.15
        candidates.append((blended, region))

    if not candidates:
        return None

    candidates.sort(key=lambda x: x[0], reverse=True)
    best_score, best_region = candidates[0]

    # Reject suspiciously low matches - better to fall through to Vision AI
    if best_score < 0.35:
        return None

    return best_region


# ---------------------------------------------------------------------------
# Diagnosing "OCR will not start" - and a one-command self-check
# ---------------------------------------------------------------------------
# EasyOCR fails to start for four unrelated reasons that used to all get the
# same message ("check your internet / model weights"), which sent people down
# the wrong path - most often a PyTorch / torchvision mismatch ("operator
# torchvision::nms does not exist"), which has nothing to do with the network.
# explain_init_failure() tells them apart; run_self_check() lets an administrator
# prove OCR works on a build or a PC before anyone depends on it:
#     local_agent.exe --check-ocr          behave_worker.exe --check-ocr

CPU_INDEX = "https://download.pytorch.org/whl/cpu"


def _installed_versions() -> dict:
    """Package versions read from metadata only - never by importing them,
    because importing a broken torchvision is exactly what fails."""
    from importlib import metadata
    out = {}
    for name in ("torch", "torchvision", "easyocr", "numpy", "opencv-python-headless", "Pillow"):
        try:
            out[name] = metadata.version(name)
        except Exception:  # noqa: BLE001
            out[name] = None
    return out


def _split_version(v):
    """'2.4.1+cpu' -> ('2.4.1', 'cpu'); '0.19.1' -> ('0.19.1', '')."""
    base, _, tag = (v or "").partition("+")
    return base, tag


def expected_torchvision(torch_version):
    """The torchvision release that is built for a given torch release:
    torch 2.N.P pairs with torchvision 0.(N+15).P (2.4.1 -> 0.19.1, 2.5.1 -> 0.20.1,
    2.6.0 -> 0.21.0). None if the version can't be read."""
    base, _ = _split_version(torch_version)
    try:
        major, minor, patch = (int(x) for x in (base.split(".") + ["0", "0"])[:3])
    except ValueError:
        return None
    return f"0.{minor + 15}.{patch}" if major == 2 else None


def _mismatch_detail(versions: dict):
    """Why the installed torch and torchvision cannot work together, or None if they look consistent."""
    tv, tvv = versions.get("torch"), versions.get("torchvision")
    if not tv or not tvv:
        return None
    want = expected_torchvision(tv)
    (tv_base, tv_tag), (tvv_base, tvv_tag) = _split_version(tv), _split_version(tvv)
    if want and tvv_base != want:
        return f"torch {tv} is built to work with torchvision {want}, but torchvision {tvv} is installed"
    if tv_tag != tvv_tag:
        return (f"torch is the '{tv_tag or 'standard'}' build ({tv}) but torchvision is the "
                f"'{tvv_tag or 'standard'}' build ({tvv}) - they came from different places")
    return None


def explain_init_failure(exc: BaseException) -> str:
    """A plain-English, actionable message for 'EasyOCR could not start', based on what
    actually went wrong. Always ends with the original error so nothing is hidden."""
    text = f"{type(exc).__name__}: {exc}"
    low = text.lower()
    v = _installed_versions()
    versions = ", ".join(f"{k} {val}" for k, val in v.items() if val and k in ("torch", "torchvision", "easyocr", "numpy"))
    versions = f" (installed: {versions})" if versions else ""
    original = f" Original error: {text}"

    if "torchvision" in low and any(k in low for k in ("does not exist", "undefined symbol", "could not load this library", "nms", "torchvision._c")) \
            or "operator torchvision" in low:
        detail = _mismatch_detail(v)
        want = expected_torchvision(v.get("torch"))
        pair = (f"torch=={_split_version(v['torch'])[0]} torchvision=={want}" if want and v.get("torch")
                else "torch==2.4.1 torchvision==0.19.1")
        fix = f"pip uninstall -y torch torchvision, then pip install {pair} --index-url {CPU_INDEX}"
        return (
            "OCR cannot start because PyTorch and torchvision do not match each other"
            + (f": {detail}" if detail else "") + f"{versions}. This is a setup problem on the machine that built or runs "
            "the agent - it is NOT a network or model-file problem. Fix: install the two TOGETHER, from the same source, "
            f"in the Python environment that builds the agent ({fix}), then rebuild local_agent.exe and behave_worker.exe. "
            "Check it with: local_agent.exe --check-ocr." + original
        )
    if "numpy" in low and any(k in low for k in ("compiled using numpy", "multiarray failed", "_array_api", "numpy 1.x", "numpy 2")):
        return ("OCR cannot start because the installed NumPy is too new or too old for the installed PyTorch"
                f"{versions}. Install a NumPy that matches your PyTorch (for torch before 2.3 use numpy<2), "
                "then rebuild the agent. Check with: local_agent.exe --check-ocr." + original)
    if isinstance(exc, ImportError) and not isinstance(exc, OSError) and any(
            k in low for k in ("easyocr", "torch", "cv2", "no module named")):
        return ("OCR support is not part of this installation (a required package is missing)"
                f"{versions}. The agent must be built with EasyOCR, PyTorch and torchvision installed "
                "(see local_agent/requirements-agent.txt)." + original)
    if "winerror 126" in low or "winerror 127" in low or "winerror 1114" in low or "dll load failed" in low:
        return ("OCR cannot start because a Windows system library could not be loaded"
                f"{versions}. Install the 'Microsoft Visual C++ Redistributable (x64)' on this PC, "
                "or ask your administrator to rebuild the agent." + original)
    if any(k in low for k in ("urlopen", "max retries", "connection", "timed out", "getaddrinfo", "ssl", "name resolution", "unreachable")):
        return ("OCR cannot start because EasyOCR could not download its model files and there is no internet "
                "access. Copy an already-populated ~/.EasyOCR/model/ folder from a PC where OCR has worked, or set "
                "EASYOCR_MODULE_PATH to a pre-staged model folder shipped with the installer." + original)
    return (f"EasyOCR could not initialize{versions}. Run local_agent.exe --check-ocr for a full report. "
            "If this PC has no internet access, EasyOCR's model files must be pre-staged (copy ~/.EasyOCR/model/ "
            "from a PC where OCR has worked, or set EASYOCR_MODULE_PATH)." + original)


def _selfcheck_png() -> bytes:
    from PIL import Image, ImageDraw, ImageFont
    img = Image.new("RGB", (560, 150), "white")
    font = None
    for name in ("arial.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"):
        try:
            font = ImageFont.truetype(name, 64)
            break
        except Exception:  # noqa: BLE001
            continue
    if font is None:
        try:
            font = ImageFont.load_default(size=64)
        except TypeError:
            font = ImageFont.load_default()
    ImageDraw.Draw(img).text((24, 36), "OCR OK 4821", fill="black", font=font)
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return buf.getvalue()


def run_self_check() -> int:
    """`local_agent.exe --check-ocr` / `behave_worker.exe --check-ocr`: prints what is installed,
    reads a generated test image, and says PASS or FAIL with the reason. Exit code 0 = OCR works."""
    import sys
    import time
    v = _installed_versions()
    print("AI Test Recorder - OCR self-check")
    print(f"  Python {sys.version.split()[0]}  ({'packaged build' if getattr(sys, 'frozen', False) else 'running from source'})")
    for name in ("torch", "torchvision", "easyocr", "numpy", "opencv-python-headless", "Pillow"):
        print(f"  {name:<24}{v.get(name) or 'NOT INSTALLED'}")
    detail = _mismatch_detail(v)
    if detail:
        print(f"  !! torch/torchvision mismatch: {detail}")
    model_dir = _staged_model_dir() or os.path.join(os.path.expanduser("~"), ".EasyOCR", "model")
    n = len([f for f in os.listdir(model_dir) if f.endswith(".pth")]) if os.path.isdir(model_dir) else 0
    print(f"  model files            {n} found in {model_dir}" + ("" if n else "  (will be downloaded on first use - needs internet)"))
    print("Reading a test image (the first run can take a minute while models load)...")
    started = time.time()
    try:
        text = extract_text_from_png_bytes(_selfcheck_png())
    except Exception as e:  # noqa: BLE001
        print(f"\nRESULT: FAIL\n{e}")
        return 1
    ok = "4821" in text.replace(" ", "")
    print(f"\nRESULT: {'PASS' if ok else 'FAIL'} - read \"{text}\" in {time.time() - started:.1f}s"
          + ("" if ok else " (expected it to contain 4821)"))
    return 0 if ok else 1
