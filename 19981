"""
locator_matcher.py

Self-Healing Stage 4: "Inspect the current DOM and compare" - crawls the
live page the failed step is on, and ranks every current element against
the recorded element's signature using candidate_ranker's structural
similarity scoring. This runs entirely without AI so it's fast and free;
the AI stage (Stage 5) is only invoked when this stage's top score is
below the confidence threshold.
"""
from __future__ import annotations

from typing import Any, Dict, List, Optional

from backend.healing.candidate_ranker import CandidateScore, rank_candidates
from backend.recorder import dom_crawler
from backend.recorder.js_bridge import EvaluationContext
from backend.recorder.locator_engine import build_locators
from backend.storage.models import LocatorCandidate


def find_dom_candidates(context: EvaluationContext, page_id: str, max_candidates: int = 15, timeout_seconds: Optional[float] = None) -> List[Dict[str, Any]]:
    """Crawl the current page/frame and return raw ElementRecord dicts as
    candidates for comparison.

    timeout_seconds: see dom_crawler.crawl_current_context() / js_bridge.py
    - bounds the crawl so a genuinely slow/unresponsive live page can't
    hang self-healing indefinitely (None preserves unbounded behavior)."""
    records = dom_crawler.crawl_current_context(context, page_id, timeout_seconds=timeout_seconds)
    return [r.to_dict() for r in records][:max_candidates]


def best_match(old_signature: Dict[str, Any], context: EvaluationContext, page_id: str, max_candidates: int = 15, timeout_seconds: Optional[float] = None) -> List[CandidateScore]:
    candidates = find_dom_candidates(context, page_id, max_candidates, timeout_seconds=timeout_seconds)
    return rank_candidates(old_signature, candidates, top_n=5)


def candidate_to_locator(candidate: Dict[str, Any]) -> LocatorCandidate:
    """Given a winning candidate ElementRecord dict, return its single
    best locator to use as the healed replacement."""
    locators_raw = candidate.get("locators") or []
    if not locators_raw:
        # candidate came straight from bridge.js element info rather than
        # a full ElementRecord - build locators on the fly.
        built = build_locators(candidate)
        if built:
            return built[0]
        return LocatorCandidate(strategy="CSS", value=candidate.get("css_path", ""))
    best = max(locators_raw, key=lambda l: l.get("reliability_score", 0))
    return LocatorCandidate(strategy=best["strategy"], value=best["value"], reliability_score=best.get("reliability_score", 0.5))
