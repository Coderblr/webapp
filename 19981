@when('the user closes the current browser tab or window (step {{ loop.index }})')
def step_close_window_{{ loop.index }}(context):
    # Recorded browser tab/window #{{ step.closed_page_index }} being closed -
    # switch replay back to whichever tab/window opened it (#{{ step.switch_back_to_index }}).
    def _do():
        # Close the ACTUALLY ACTIVE Playwright page. This is important for
        # UiPath imports because the Excel format does not always encode the
        # popup/tab index that was opened by a document click.
        closing_page = context.page.page
{% if step.close_by_index %}
        # Recorded live: close the tab the user actually closed. They may
        # have gone back to another tab first and closed this one from the
        # tab strip - closing "the active tab" then would close the tab the
        # rest of the flow still needs.
        if {{ step.closed_page_index }} < len(context.recorder_pages):
            closing_page = context.recorder_pages[{{ step.closed_page_index }}]
{% endif %}
        if not closing_page.is_closed():
            closing_page.close()

        target_index = {{ step.switch_back_to_index }}
        if target_index < len(context.recorder_pages):
            target_page = context.recorder_pages[target_index]
            if not target_page.is_closed():
                context.page.switch_page(target_page)
        else:
            # Fallback to the first still-open page.
            for candidate in reversed(context.recorder_pages):
                if not candidate.is_closed():
                    context.page.switch_page(candidate)
                    break

    _run_step(context, "close browser tab/window (step {{ loop.index }})", _do)

