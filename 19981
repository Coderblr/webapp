<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Execution Report — {{ execution.transaction_id }} — {{ execution.execution_uid }}</title>
<style>
  :root{
    --bg:#0f1420; --panel:#171e2e; --panel2:#1e2637; --line:#2a3448;
    --text:#e6ecf7; --muted:#8b9ab5; --accent:#3b82f6;
    --pass:#22c55e; --fail:#ef4444; --warn:#f59e0b; --heal:#a855f7; --skip:#64748b;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);
       font:14px/1.55 "Segoe UI",system-ui,-apple-system,sans-serif}
  a{color:var(--accent)}
  header{padding:26px 32px;background:linear-gradient(135deg,#16203a,#0f1420);
         border-bottom:1px solid var(--line)}
  header h1{margin:0 0 6px;font-size:22px;font-weight:600}
  header .sub{color:var(--muted);font-size:13px}
  .badge{display:inline-block;padding:3px 11px;border-radius:999px;font-size:11px;
         font-weight:700;letter-spacing:.4px;text-transform:uppercase}
  .b-passed{background:rgba(34,197,94,.16);color:var(--pass)}
  .b-failed{background:rgba(239,68,68,.16);color:var(--fail)}
  .b-partial{background:rgba(245,158,11,.16);color:var(--warn)}
  .b-skipped,.b-queued,.b-running{background:rgba(100,116,139,.2);color:var(--skip)}
  .b-healed{background:rgba(168,85,247,.16);color:var(--heal)}
  main{padding:24px 32px;max-width:1400px;margin:0 auto}
  .grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
        margin-bottom:24px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;
        padding:16px 18px}
  .card .k{color:var(--muted);font-size:11px;text-transform:uppercase;
           letter-spacing:.6px;margin-bottom:6px}
  .card .v{font-size:22px;font-weight:600}
  section{background:var(--panel);border:1px solid var(--line);border-radius:10px;
          margin-bottom:20px;overflow:hidden}
  section > h2{margin:0;padding:14px 18px;font-size:14px;font-weight:600;
               background:var(--panel2);border-bottom:1px solid var(--line)}
  .body{padding:16px 18px}
  table{width:100%;border-collapse:collapse;font-size:13px}
  th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);
        vertical-align:top}
  th{color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;
     letter-spacing:.5px}
  tr.step{cursor:pointer}
  tr.step:hover{background:rgba(59,130,246,.06)}
  .detail{display:none;background:#131a29}
  .detail.open{display:table-row}
  .detail pre{margin:0;padding:12px;background:#0c1220;border-radius:6px;
              overflow:auto;font-size:12px;color:#cbd5e1;max-height:320px}
  .shot{max-width:100%;border:1px solid var(--line);border-radius:6px;margin-top:10px}
  .kv{display:grid;grid-template-columns:200px 1fr;gap:6px 16px;font-size:13px}
  .kv .k{color:var(--muted)}
  .bar{height:9px;background:#0c1220;border-radius:6px;overflow:hidden;display:flex}
  .bar i{display:block;height:100%}
  .muted{color:var(--muted)}
  .diff{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .diff div{background:#0c1220;border-radius:6px;padding:10px;font-family:ui-monospace,
            Consolas,monospace;font-size:12px;word-break:break-all}
  .old{border-left:3px solid var(--fail)}
  .new{border-left:3px solid var(--pass)}
  footer{padding:20px 32px;color:var(--muted);font-size:12px;
         border-top:1px solid var(--line)}
</style>
</head>
<body>
<header>
  <h1>Transaction {{ execution.transaction_id }}
    {%- if transaction %} — {{ transaction.name }}{% endif %}
    <span class="badge b-{{ execution.status }}">{{ execution.status }}</span>
  </h1>
  <div class="sub">
    {{ execution.execution_uid }} ·
    {{ execution.environment }} ·
    profile {{ profile.name if profile else '—' }} ·
    knowledge version {{ transaction.version if transaction else '—' }} ·
    started {{ execution.started_at }}
  </div>
</header>

<main>
  <div class="grid">
    <div class="card"><div class="k">Total Tests</div><div class="v">{{ test_summary.total_tests }}</div></div>
    <div class="card"><div class="k">Passed</div>
      <div class="v" style="color:var(--pass)">{{ test_summary.passed }}</div></div>
    <div class="card"><div class="k">Failed</div>
      <div class="v" style="color:var(--fail)">{{ test_summary.failed }}</div></div>
    <div class="card"><div class="k">Success Rate</div>
      <div class="v" style="color:{{ 'var(--pass)' if test_summary.success_rate == 100 else 'var(--fail)' }}">{{ test_summary.success_rate }}%</div></div>
  </div>

  <div class="grid">
    <div class="card"><div class="k">Steps</div><div class="v">{{ totals.steps }}</div></div>
    <div class="card"><div class="k">Passed</div>
      <div class="v" style="color:var(--pass)">{{ totals.passed }}</div></div>
    <div class="card"><div class="k">Failed</div>
      <div class="v" style="color:var(--fail)">{{ totals.failed }}</div></div>
    <div class="card"><div class="k">Self-healed</div>
      <div class="v" style="color:var(--heal)">{{ totals.healed }}</div></div>
    <div class="card"><div class="k">Total time</div>
      <div class="v">{{ (metrics.total_ms or metrics.total_step_ms or 0) // 1000 }}s</div></div>
  </div>

  <section>
    <h2>Pipeline outcome (Section 11)</h2>
    <div class="body">
      <div class="kv">
        <div class="k">Password change (9750)</div>
        <div><span class="badge b-{{ execution.password_change_status or 'skipped' }}">
          {{ execution.password_change_status or 'not reported' }}</span></div>
        <div class="k">Teller reset (CBS socket)</div>
        <div><span class="badge b-{{ 'passed' if execution.teller_reset_status == 'success'
                     else ('skipped' if execution.teller_reset_status == 'skipped'
                     else 'failed') }}">
          {{ execution.teller_reset_status or 'not attempted' }}</span></div>
        <div class="k">CBS response</div>
        <div class="muted">{{ execution.teller_reset_response or '—' }}</div>
        <div class="k">Data profile</div>
        <div>{{ profile.name if profile else '—' }}</div>
        <div class="k">Knowledge package</div>
        <div class="muted">{{ knowledge_dir or '—' }}</div>
        {% if execution.error_summary %}
        <div class="k">Error summary</div>
        <div style="color:var(--fail)">{{ execution.error_summary }}</div>
        {% endif %}
      </div>
      <div style="margin-top:14px" class="bar">
        {% set total = totals.steps if totals.steps else 1 %}
        <i style="width:{{ totals.passed * 100 // total }}%;background:var(--pass)"></i>
        <i style="width:{{ totals.healed * 100 // total }}%;background:var(--heal)"></i>
        <i style="width:{{ totals.failed * 100 // total }}%;background:var(--fail)"></i>
        <i style="width:{{ totals.skipped * 100 // total }}%;background:var(--skip)"></i>
      </div>
    </div>
  </section>

  <section>
    <h2>Step-by-step execution</h2>
    <div class="body" style="padding:0">
      <table>
        <thead>
          <tr><th style="width:44px">#</th><th style="width:220px">Phase</th>
              <th>Step</th><th style="width:90px">Status</th>
              <th style="width:90px">Duration</th></tr>
        </thead>
        <tbody>
        {% for step in steps %}
          <tr class="step" onclick="toggle('d{{ loop.index }}')">
            <td class="muted">{{ step.sequence }}</td>
            <td class="muted">{{ step.phase_label }}</td>
            <td>{{ step.step_name }}</td>
            <td><span class="badge b-{{ step.status }}">{{ step.status }}</span></td>
            <td class="muted">{{ step.duration_ms or 0 }} ms</td>
          </tr>
          <tr class="detail" id="d{{ loop.index }}">
            <td colspan="5">
              {% if step.error_msg %}
                <pre style="color:#fca5a5">{{ step.error_msg }}</pre>
              {% endif %}
              {% if step.detail %}
                <pre>{{ step.detail | tojson(indent=2) }}</pre>
              {% endif %}
              {% if step.screenshot_data %}
                <img class="shot" src="{{ step.screenshot_data }}" alt="screenshot">
              {% elif step.screenshot_ref %}
                <div class="muted" style="margin-top:8px">
                  Screenshot: {{ step.screenshot_ref }}</div>
              {% endif %}
              {% if not step.error_msg and not step.detail
                    and not step.screenshot_data %}
                <div class="muted">No additional detail captured.</div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  {% if self_heal %}
  <section>
    <h2>Self-healing actions (Section 12)</h2>
    <div class="body">
      {% for heal in self_heal %}
        <div style="margin-bottom:16px">
          <div style="margin-bottom:6px">
            <strong>{{ heal.element_key }}</strong>
            <span class="badge b-{{ 'healed' if heal.applied else 'skipped' }}">
              {{ 'applied' if heal.applied else 'awaiting approval' }}</span>
            <span class="muted">confidence {{ heal.confidence }}</span>
          </div>
          <div class="diff">
            <div class="old"><span class="muted">before</span><br>{{ heal.old_locator }}</div>
            <div class="new"><span class="muted">after</span><br>{{ heal.new_locator }}</div>
          </div>
          <div class="muted" style="margin-top:6px">{{ heal.reason }}</div>
        </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Performance metrics</h2>
    <div class="body">
      <div class="kv">
        {% for key, value in metrics.items() %}
          <div class="k">{{ key }}</div><div>{{ value }}</div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if generated_files %}
  <section>
    <h2>Framework artefacts used</h2>
    <div class="body">
      <div class="kv">
        {% for key, value in generated_files.items() %}
          <div class="k">{{ key }}</div><div class="muted">{{ value }}</div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
</main>

<footer>
  Generated {{ generated_at }} by the Enterprise AI Automation Engineering Platform ·
  Knowledge version {{ transaction.version if transaction else '—' }} ·
  Recording is required only for brand-new transactions or a full redesign.
</footer>

<script>
  function toggle(id){
    var row = document.getElementById(id);
    if (row) { row.classList.toggle('open'); }
  }
  window.__REPORT__ = {{ chart_data | safe }};
</script>
</body>
</html>
