def _load_applications() -> dict:
    """Application name -> URL, from config/applications.yaml. Missing/empty
    file just means an empty dropdown (frontend still offers "Others")."""
    if not APPLICATIONS_CONFIG.exists():
        return {}
    try:
        data = yaml.safe_load(APPLICATIONS_CONFIG.read_text()) or {}
        return data.get("applications") or {}
    except Exception:
        return {}


@app.get("/api/applications")
def get_applications(current_user: CurrentUser = Depends(get_current_user)):
    """Names for the frontend's dropdown - URLs never leave the backend for
    these; the frontend only ever sees/sends the app NAME (see
    StartRequest.app_name below), matching "URLs live in the backend"."""
    return {"applications": list(_load_applications().keys())}


@app.post("/api/start")
async def start_recording(req: StartRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """
    Requires a connected desktop agent (backend/agent_registry.py) - the
    whole point of the Electron/local-agent architecture: the actual
    browser launches on the USER'S OWN PC via their local agent, never
    here. This backend only sends a command and stores metadata
    (backend/recording_sessions.py's "mode"/"agent_id" fields) - no
    Recorder, no browser object, ever exists in this process for a
    production recording.

    ALLOW_SERVER_FALLBACK (.env, default false) is a LOCAL-DEV-ONLY escape
    hatch: with it set, a missing agent falls back to the original
    server-side headless Recorder + live-view path instead of erroring -
    useful for developing the recorder tab without also running the
    desktop app, but this must stay false for any real deployment (see
    docs/electron-local-agent-architecture.md).
    """
    applications = _load_applications()
    if req.app_name and req.app_name in applications:
        url = applications[req.app_name].strip()
    else:
        url = req.url.strip()
    if not url:
        raise HTTPException(status_code=400, detail="URL is required (select a known application or provide one for 'Others')")

    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    if state["recorder"] is not None or state.get("agent_recording_active"):
        raise HTTPException(status_code=400, detail="You already have a recording in progress - save or stop it first")

    ip = get_client_ip(request)
    conn = agent_registry.get_for_user(current_user.user_id)

    if conn is None and not ALLOW_SERVER_FALLBACK:
        raise HTTPException(status_code=409, detail=NO_AGENT_ERROR)

    # ---- AGENT mode ---------------------------------------------------------
    if conn is not None:
        try:
            response = await agent_registry.send_command(
                conn, "START_RECORDING", {"url": url, "headless": req.headless},
            )
        except (asyncio.TimeoutError, ConnectionError) as e:
            raise HTTPException(status_code=502, detail=f"Local agent did not respond: {e}")

        if not response.get("ok", False):
            raise HTTPException(status_code=400, detail=response.get("error", "Agent failed to start recording."))

        state["mode"] = "agent"
        state["agent_id"] = conn.agent_id
        state["agent_recording_active"] = True
        state["pending_recording_name"] = req.recording_name.strip() or None
        state["target_url"] = url
        conn.busy = True

        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="START_RECORDING",
                status="SUCCESS", details={"url": url, "recording_name": req.recording_name, "mode": "agent",
                                            "agent_id": conn.agent_id},
                endpoint="/api/start", ip_address=ip,
            )
        return {"ok": True, "message": f"Recording started on your local agent ({conn.hostname or conn.agent_id})."}

    # ---- SERVER mode - only reachable when ALLOW_SERVER_FALLBACK=true, since
    # the 409 above already returned for conn is None otherwise. Local-dev-only. ---
    active = recording_sessions.count_active_recordings()
    if active >= recording_sessions.MAX_CONCURRENT_RECORDINGS:
        raise HTTPException(
            status_code=503,
            detail=f"The server is at capacity ({active}/{recording_sessions.MAX_CONCURRENT_RECORDINGS} concurrent "
                   f"recordings) - please try again shortly.",
        )

    state["mode"] = "server"
    state["pending_recording_name"] = req.recording_name.strip() or None
    state["start_error"] = None
    state["launching"] = True

    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="START_RECORDING",
            status="SUCCESS", details={"url": url, "app_name": req.app_name, "recording_name": req.recording_name,
                                        "headless": req.headless, "mode": "server"},
            endpoint="/api/start", ip_address=ip,
        )

    def _launch():
        try:
            # A hosted server (see backend/recording_sessions.py's docs and
            # DEPLOYMENT_WINDOWS.md) typically has no desktop session for a
            # headed browser window to render into, and the live-view
            # WebSocket streams a headless browser just fine via CDP
            # screencast either way - so FORCE_HEADLESS_RECORDING (.env,
            # default true) overrides whatever the frontend's "headless"
            # checkbox sent. Set it to false only for local single-user dev
            # where seeing the real window is convenient.
            import os
            force_headless = os.environ.get("FORCE_HEADLESS_RECORDING", "true").lower().strip() != "false"
            effective_headless = True if force_headless else req.headless
            # Only bother with CDP screencast when actually headless - a
            # headed run already gives a real, visible browser window, so
            # the live-view widget would just be a redundant (and
            # occasionally flaky, e.g. across an unstable dev-reload) second
            # way to see the exact same thing. GET /api/status's "headless"
            # field tells the frontend whether to even show that panel.
            rec = Recorder(url, headless=effective_headless, enable_live_view=effective_headless).start()
            state["recorder"] = rec
            state["headless"] = effective_headless
        except Exception as e:
            # Previously this died silently in the background thread - the
            # frontend would show "Launching browser..." and mark the
            # recording as started regardless, so a failed launch (wrong
            # channel, Edge not installed, bad URL, etc.) only surfaced
            # later as a confusing 400 on Stop & Save. Now the frontend can
            # poll GET /api/status and see exactly why it failed.
            state["start_error"] = str(e)
        finally:
            state["launching"] = False

    threading.Thread(target=_launch, daemon=True).start()
    return {"ok": True, "message": f"Launching browser for {url}..."}


@app.get("/api/status")
def get_status(current_user: CurrentUser = Depends(get_current_user)):
    """Poll this after /api/start - a browser launch happens in a background
    thread (server mode) or on the agent (agent mode), so success/failure
    isn't known at the time /api/start returns. Also doubles as the general
    tool-status endpoint (recording in progress / has a build / last run
    result) - all scoped to the CALLER's own recording session (see
    backend/recording_sessions.py); this can never see another user's
    in-progress recording."""
    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    recording_active = state.get("recorder") is not None or state.get("agent_recording_active", False)
    return {
        "launching": state.get("launching", False),
        "recording_active": recording_active,
        "start_error": state.get("start_error"),
        "process_id": PROCESS_ID,
        "recording_in_progress": recording_active,
        "has_build": state.get("build_result") is not None,
        "last_run": state.get("last_run"),
        "headless": state.get("headless"),  # None until a recorder has actually launched (server mode only)
        "live_view_ws": "/api/ws/record" if state.get("recorder") is not None else None,
        "mode": state.get("mode", "server"),  # "server" or "agent" - lets the frontend skip the live-view panel entirely in agent mode (a real window is already open on the user's own PC)
    }


def _agent_conn_for_state(state: dict, current_user: CurrentUser):
    """Looks up the SAME agent connection a session started recording on -
    if it disconnected/reconnected with a new object since (e.g. the
    desktop app restarted), this deliberately fails clearly rather than
    silently sending the stop command to a stale/wrong connection."""
    if state.get("mode") != "agent":
        return None
    conn = agent_registry.get_for_user(current_user.user_id)
    if conn is None or conn.agent_id != state.get("agent_id"):
        return None
    return conn


@app.post("/api/stop")
async def stop_recording(request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Stops and DISCARDS the current recording without saving/generating
    anything - for abandoning a recording mid-flow (wrong URL, made a
    mistake, changed your mind). Use /api/stop_and_save instead to keep
    what was recorded."""
    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    ip = get_client_ip(request)

    if state.get("mode") == "agent":
        conn = _agent_conn_for_state(state, current_user)
        if conn is None or not state.get("agent_recording_active"):
            raise HTTPException(status_code=400, detail="No recording in progress (your local agent may have disconnected).")
        try:
            response = await agent_registry.send_command(conn, "STOP_RECORDING", {})
        except (asyncio.TimeoutError, ConnectionError) as e:
            raise HTTPException(status_code=502, detail=f"Local agent did not respond: {e}")
        finally:
            state["agent_recording_active"] = False
            conn.busy = False
        actions_discarded = len(response.get("actions", []))
    else:
        rec = state["recorder"]
        if rec is None:
            detail = "No recording in progress"
            if state.get("start_error"):
                detail += f" (the last start attempt failed: {state['start_error']})"
            elif state.get("launching"):
                detail += " (the browser is still launching - wait a moment and try again)"
            raise HTTPException(status_code=400, detail=detail)
        actions = rec.stop()
        state["recorder"] = None
        actions_discarded = len(actions)

    state["pending_recording_name"] = None

    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="STOP_RECORDING_DISCARDED",
            status="SUCCESS", details={"actions_discarded": actions_discarded, "mode": state.get("mode")},
            endpoint="/api/stop", ip_address=ip,
        )
    return {"ok": True, "actions_discarded": actions_discarded}


@app.post("/api/stop_and_save")
async def stop_and_save(request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """
    Split into per-stage try/excepts (stop -> save -> build) rather than one
    big try/except around everything: a failure in build_artifacts() (e.g.
    a bad recording, an LLM hiccup, a broken template) is a DIFFERENT
    problem from a failure stopping/saving the recording itself (browser
    crashed, agent disconnected mid-stop) - and critically, if generation
    fails the recording itself is still safely saved to disk, so the
    response should say so instead of just "500 Internal Server Error"
    with the JSON already lost. Every stage logs the full traceback to
    logs/error.log before turning it into an HTTPException - see
    logging.ini/logging_setup.py.
    """
    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    ip = get_client_ip(request)
    recording_name = state.pop("pending_recording_name", None)

    if state.get("mode") == "agent":
        conn = _agent_conn_for_state(state, current_user)
        if conn is None or not state.get("agent_recording_active"):
            raise HTTPException(status_code=400, detail="No recording in progress (your local agent may have disconnected).")
        try:
            response = await agent_registry.send_command(conn, "STOP_RECORDING", {})
        except (asyncio.TimeoutError, ConnectionError) as e:
            logger.exception("Agent STOP_RECORDING failed for user_id=%s", current_user.user_id)
            raise HTTPException(status_code=502, detail=f"Local agent did not respond: {e}")
        finally:
            state["agent_recording_active"] = False
            conn.busy = False

        if not response.get("ok", False):
            raise HTTPException(status_code=400, detail=response.get("error", "Agent failed to stop the recording."))

        actions = response.get("actions", [])
        target_url = response.get("target_url") or state.get("target_url") or ""
        try:
            # Persisted server-side either way (see recorder/recorder.py's
            # save_recording_json) - "Run Saved Recording", the generator,
            # and everything downstream never need to know whether a
            # recording was captured locally or by an agent.
            path = save_recording_json(target_url, actions, name=recording_name)
        except Exception:
            logger.exception("save_recording_json() failed for user_id=%s", current_user.user_id)
            raise HTTPException(status_code=500, detail="Failed to save the recording JSON - see logs/error.log")
    else:
        rec = state["recorder"]
        if rec is None:
            detail = "No recording in progress"
            if state.get("start_error"):
                detail += f" (the last start attempt failed: {state['start_error']})"
            elif state.get("launching"):
                detail += " (the browser is still launching - wait a moment and try again)"
            raise HTTPException(status_code=400, detail=detail)

        try:
            actions = rec.stop()
        except Exception:
            logger.exception("Recorder.stop() failed")
            state["recorder"] = None
            raise HTTPException(
                status_code=500,
                detail="Failed to stop the recorder (the browser may have crashed or been closed manually) - see logs/error.log",
            )

        try:
            path = rec.save(name=recording_name)
        except Exception:
            logger.exception("Recorder.save() failed")
            raise HTTPException(status_code=500, detail="Failed to save the recording JSON - see logs/error.log")
        finally:
            target_url = rec.target_url
            state["recorder"] = None

    recording = {
        "target_url": target_url,
        "recorded_at": Path(path).stem,
        "recording_name": recording_name,
        "actions": actions,
    }
    state["recording"] = recording

    # Own output/ subfolder per auth session (backend/recording_sessions.py)
    # so two people's Save & Generate never clobber each other's generated
    # feature/steps/page files.
    output_dir = recording_sessions.output_dir_for(current_user.session_id)
    llm = get_llm()
    try:
        build_result = await asyncio.to_thread(build_artifacts, recording, llm=llm, output_dir=output_dir)
    except Exception:
        logger.exception("build_artifacts() failed while generating feature/steps/page files for %s", path)
        raise HTTPException(
            status_code=500,
            detail=(
                f"Recording was saved to {path}, but generating the feature/steps/page files failed - "
                "see logs/error.log for the full traceback. You can retry generation later from "
                "the saved recording without re-recording."
            ),
        )
    state["build_result"] = build_result

    # Additive: surface the (now variable-annotated) actions and a quick
    # name -> captured-value summary so the frontend can show what was
    # recorded, including keyboard events and any Capture -> Store -> Reuse
    # {{var}} pairs, without needing a separate endpoint.
    variables_summary = {
        a["captured_as"]: a.get("value")
        for a in recording["actions"]
        if a.get("action") == "copy" and a.get("captured_as")
    }

    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="STOP_AND_SAVE",
            status="SUCCESS", details={"recording_file": path, "actions_captured": len(actions),
                                        "recording_name": recording_name, "mode": state.get("mode")},
            endpoint="/api/stop_and_save", ip_address=ip,
        )

    return {
        "ok": True,
        "recording_file": path,
        "actions_captured": len(actions),
        "build_result": build_result,
        "llm_used": llm is not None,
        "actions": recording["actions"],
        "variables": variables_summary,
    }


@app.post("/api/run")
async def run_check(req: RunRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Runs the just-generated Behave suite. Requires a connected desktop
    agent by default - packages the generated files' CONTENTS (not paths -
    the agent has no access to this server's filesystem) and has the local
    agent execute Behave on the user's own PC, against their own real
    browser. ALLOW_SERVER_FALLBACK (.env, local-dev-only, default false)
    permits the original server-side execution instead - see /api/start's
    docstring for why this must stay off in production."""
    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    output_dir = recording_sessions.output_dir_for(current_user.session_id)
    output_path = Path(output_dir)
    if state["build_result"] is None and not (output_path / "features" / "recorded.feature").exists():
        raise HTTPException(status_code=400, detail="Nothing generated yet - record and save first")

    ip = get_client_ip(request)
    conn = agent_registry.get_for_user(current_user.user_id)

    if conn is None and not ALLOW_SERVER_FALLBACK:
        raise HTTPException(status_code=409, detail=NO_AGENT_ERROR)

    if conn is not None:
        files = _collect_generated_files(output_path)
        try:
            response = await agent_registry.send_command(
                conn, "START_TEST", {"headless": req.headless, "files": files}, timeout=120,
            )
        except (asyncio.TimeoutError, ConnectionError) as e:
            logger.exception("Agent START_TEST failed for user_id=%s", current_user.user_id)
            raise HTTPException(status_code=502, detail=f"Local agent did not respond: {e}")
        result = {"ok": response.get("ok", False), "output": response.get("output", "")}
    else:
        try:
            result = await asyncio.to_thread(run_behave, output_dir=output_dir, headless=req.headless)
        except Exception:
            logger.exception("run_behave() failed for user_id=%s", current_user.user_id)
            raise HTTPException(status_code=500, detail="Failed to execute the generated test suite - see logs/error.log")

    state["last_run"] = result

    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="RUN_CHECK",
            status="SUCCESS" if result.get("ok") else "FAILURE",
            details={"headless": req.headless, "mode": "agent" if conn is not None else "server"},
            endpoint="/api/run", ip_address=ip,
        )
    return result


def _collect_generated_files(output_path: Path) -> dict:
    """Reads every generated feature/steps/page/locators file's CONTENT
    (not just its path - see run_check above) so it can be shipped to a
    local agent that has no access to this server's disk. Keys are
    relative paths so the agent can recreate the same layout in its own
    isolated workspace (see local_agent/execution_manager.py).

    Deliberately does NOT include "features/environment.py": the
    server's copy (generator/build.py, sourced from runner/environment.py)
    imports agent.llm_factory/agent.self_healer for LLM-backed self-healing
    - a hard dependency a packaged local_agent.exe deliberately does NOT
    bundle (see local_agent/local_agent.spec's excludes list and
    local_agent/agent_environment.py's module docstring for why). Sending
    it anyway and letting the agent overwrite it caused exactly the bug
    this comment is warning against: "ModuleNotFoundError: No module named
    'agent'" crashing Behave before before_all() ever calls
    launch_browser() - so Run/Run Saved Recording never opened a browser
    at all, even though Start Recording worked fine (no environment.py
    involved there). The agent always uses its OWN local, self-healing-free
    environment.py instead (local_agent/execution_manager.py's
    _write_workspace enforces this unconditionally, as a second layer of
    protection against this exact mistake)."""
    files = {}
    for rel in ("features/recorded.feature", "features/steps/recorded_steps.py",
                "pages/recorded_page.py", "pages/locators.json"):
        p = output_path / rel
        if p.exists():
            files[rel] = p.read_text()
    return files


@app.websocket("/api/ws/record")
async def ws_record(websocket: WebSocket, token: str = Query(...)):
    """Live view for a hosted, headless recording: streams CDP screencast
    JPEG frames to the client and forwards its mouse/keyboard events back
    to the real (server-side) browser - see recorder/recorder.py's
    get_frame/queue_input. This is what makes "record a flow" usable when
    the backend runs on a machine with no desktop session in front of the
    person doing the recording (the normal case once this is hosted rather
    than run on someone's own laptop).

    Browsers can't attach a custom Authorization header to a WebSocket
    handshake, so the JWT travels as ?token=... instead - auth/dependencies.py's
    validate_token_for_websocket runs the exact same checks (idle timeout,
    revocation, account status) as every other endpoint.
    """
    await websocket.accept()

    current_user = validate_token_for_websocket(token)
    if current_user is None:
        print("[live-view] rejected: invalid/expired/revoked token")
        await websocket.close(code=4401, reason="Not authenticated")
        return

    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    rec = state.get("recorder")
    if rec is None:
        print(f"[live-view] rejected: no active recording for user {current_user.username} (session {current_user.session_id})")
        await websocket.close(code=4404, reason="No active recording for this session")
        return

    print(f"[live-view] connected: user {current_user.username}, session {current_user.session_id}")

    async def sender():
        while True:
            frame = await asyncio.to_thread(rec.get_frame, 1.0)
            if state.get("recorder") is None:
                break
            if frame is not None:
                await websocket.send_text(frame)

    sender_task = asyncio.create_task(sender())
    try:
        while True:
            event = await websocket.receive_json()
            rec.queue_input(event)
    except WebSocketDisconnect:
        print(f"[live-view] disconnected: user {current_user.username}")
    except Exception as e:
        print(f"[live-view] error for user {current_user.username}: {e}")
    finally:
        sender_task.cancel()


