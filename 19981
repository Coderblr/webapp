"""
recording_store.py

Owns the on-disk layout of a single recording:

    recordings/<recording_id>/
        metadata.json
        locator_repository/
            locator_repository.json
        execution/
            execution.xlsx
        behave/
            feature.feature
            pages/*.py
            steps/*.py
        screenshots/
        dom/
        logs/

Also provides recording-management helpers (list / create / delete) used by
the FastAPI backend so multiple independent recordings never clobber each
other.
"""
from __future__ import annotations

import json
import shutil
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

from backend.config import settings
from backend.storage.models import RecordingMetadata, new_id


class RecordingPaths:
    """Resolves every path that belongs to a given recording_id."""

    def __init__(self, recording_id: str, base_dir: Optional[Path] = None):
        self.recording_id = recording_id
        self.root = (base_dir or settings.RECORDINGS_DIR) / recording_id

    @property
    def metadata_file(self) -> Path:
        return self.root / "metadata.json"

    @property
    def locator_repo_dir(self) -> Path:
        return self.root / "locator_repository"

    @property
    def locator_repo_file(self) -> Path:
        return self.locator_repo_dir / "locator_repository.json"

    @property
    def execution_dir(self) -> Path:
        return self.root / "execution"

    @property
    def execution_excel(self) -> Path:
        return self.execution_dir / "execution.xlsx"

    @property
    def behave_dir(self) -> Path:
        return self.root / "behave"

    @property
    def feature_file(self) -> Path:
        return self.behave_dir / "feature.feature"

    @property
    def pages_dir(self) -> Path:
        return self.behave_dir / "pages"

    @property
    def steps_dir(self) -> Path:
        return self.behave_dir / "steps"

    @property
    def screenshots_dir(self) -> Path:
        return self.root / "screenshots"

    @property
    def dom_dir(self) -> Path:
        return self.root / "dom"

    @property
    def logs_dir(self) -> Path:
        return self.root / "logs"

    @property
    def reports_dir(self) -> Path:
        return self.root / "reports"

    @property
    def changes_dir(self) -> Path:
        return self.root / "changes"

    @property
    def change_log_file(self) -> Path:
        """History of every BRD/Solution Document change-set applied to
        this recording - see backend/change_detection/change_applier.py."""
        return self.changes_dir / "change_log.json"

    def ensure_all(self) -> None:
        for d in (
            self.root,
            self.locator_repo_dir,
            self.execution_dir,
            self.behave_dir,
            self.pages_dir,
            self.steps_dir,
            self.screenshots_dir,
            self.dom_dir,
            self.logs_dir,
            self.reports_dir,
            self.changes_dir,
        ):
            d.mkdir(parents=True, exist_ok=True)


class RecordingStore:
    """CRUD operations for recording metadata + directory lifecycle."""

    def __init__(self, base_dir: Optional[Path] = None):
        self.base_dir = base_dir or settings.RECORDINGS_DIR
        self.base_dir.mkdir(parents=True, exist_ok=True)

    def create(
        self, name: str, target_url: str, browser: str = "chrome",
        owner_user_id: str = "", owner_username: str = "", application_id: str = "",
    ) -> RecordingMetadata:
        recording_id = new_id("rec_")
        meta = RecordingMetadata(
            recording_id=recording_id, name=name, target_url=target_url, browser=browser,
            owner_user_id=owner_user_id, owner_username=owner_username, application_id=application_id,
        )
        paths = RecordingPaths(recording_id, self.base_dir)
        paths.ensure_all()
        self.save_metadata(meta)
        return meta

    def paths(self, recording_id: str) -> RecordingPaths:
        return RecordingPaths(recording_id, self.base_dir)

    def save_metadata(self, meta: RecordingMetadata) -> None:
        paths = self.paths(meta.recording_id)
        paths.ensure_all()
        with open(paths.metadata_file, "w", encoding="utf-8") as f:
            json.dump(meta.to_dict(), f, indent=2)

    def load_metadata(self, recording_id: str) -> Optional[RecordingMetadata]:
        paths = self.paths(recording_id)
        if not paths.metadata_file.exists():
            return None
        with open(paths.metadata_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        return RecordingMetadata(**data)

    def list_recordings(self) -> List[Dict[str, Any]]:
        results = []
        if not self.base_dir.exists():
            return results
        for child in sorted(self.base_dir.iterdir()):
            if not child.is_dir():
                continue
            meta_file = child / "metadata.json"
            if meta_file.exists():
                try:
                    with open(meta_file, "r", encoding="utf-8") as f:
                        results.append(json.load(f))
                except (json.JSONDecodeError, OSError):
                    continue
        results.sort(key=lambda r: r.get("created_at", 0), reverse=True)
        return results

    def delete(self, recording_id: str) -> bool:
        paths = self.paths(recording_id)
        if paths.root.exists():
            shutil.rmtree(paths.root)
            return True
        return False

    def exists(self, recording_id: str) -> bool:
        return self.paths(recording_id).metadata_file.exists()

    def set_transaction_code(self, recording_id: str, transaction_code: str) -> Optional[RecordingMetadata]:
        """Tags a recording with a business transaction code/name (e.g.
        "1010") so a BRD/Solution Document mentioning that same code can be
        matched to it later - see change_detection/transaction_matcher.py."""
        meta = self.load_metadata(recording_id)
        if not meta:
            return None
        meta.transaction_code = transaction_code.strip()
        meta.updated_at = time.time()
        self.save_metadata(meta)
        return meta

    def set_application(self, recording_id: str, application_id: str) -> Optional[RecordingMetadata]:
        """Tags (or re-tags) a recording with which application it belongs
        to (see backend/applications/application_store.py) - the retroactive
        counterpart to picking one on the Recorder start form, for a
        recording made before that field existed or before its application
        had been added to the list yet. Blank clears the tag. Only stores
        the id (never a copy of the name), same reasoning as
        RecordingMetadata.application_id itself - renaming the application
        later still resolves correctly for this recording with no further
        action needed here."""
        meta = self.load_metadata(recording_id)
        if not meta:
            return None
        meta.application_id = (application_id or "").strip()
        meta.updated_at = time.time()
        self.save_metadata(meta)
        return meta

    def find_by_transaction_code(self, transaction_code: str) -> Optional[Dict[str, Any]]:
        """Case-insensitive exact match against every recording's tagged
        transaction_code. Returns the raw metadata dict (as list_recordings()
        does) or None if no recording is tagged with this code."""
        code = (transaction_code or "").strip().lower()
        if not code:
            return None
        for meta_dict in self.list_recordings():
            if str(meta_dict.get("transaction_code", "")).strip().lower() == code:
                return meta_dict
        return None
