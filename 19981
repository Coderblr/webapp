@echo off
title AI Test Recorder - Local Agent
color 3F
echo.
echo ================================================
echo   AI Test Recorder - Local Agent
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0"

if not exist "venv\Scripts\activate.bat" (
    echo [ERROR] Virtual environment not found at: %~dp0venv
    echo Please create it with: python -m venv venv
    pause
    exit /b 1
)

REM Check SERVER_URL is set
if "%SERVER_URL%"=="" (
    echo [WARNING] SERVER_URL environment variable is not set.
    echo Setting it to default: http://10.1.161.165:8000
    set SERVER_URL=http://10.1.161.165:8000
    echo To set permanently run:
    echo   setx SERVER_URL "http://10.1.161.165:8000"
    echo.
)

echo [INFO] Connecting to server: %SERVER_URL%
echo.

echo [1/2] Activating virtual environment...
call venv\Scripts\activate.bat

echo [2/2] Starting local agent...
echo.
echo  Server URL : %SERVER_URL%
echo  Press Ctrl+C to stop
echo.

:retry
python -m local_agent.main
echo.
echo [INFO] Agent disconnected. Restarting in 5 seconds...
echo  Press Ctrl+C to exit
timeout /t 5 /nobreak >nul
goto retry
