"use client";

/*
 * RecordingsTable.js
 * Shared table for the Dashboard's "Recent Recordings" (withActions=false)
 * and the full Recordings tab (withActions=true, with download links +
 * Delete). Ported from app.js's renderRecordingsTable().
 */

import { useState } from "react";
import { Api } from "@/lib/api";
import { dateTimeStr } from "@/lib/format";
import { useAuth } from "@/components/AuthProvider";

export default function RecordingsTable({ recordings, withActions = false, onChanged }) {
  const [deletingId, setDeletingId] = useState(null);
  const { user } = useAuth();
  // A regular user's list is already scoped server-side to just their own
  // recordings (see backend/app.py's list_recordings()) - an "Owner"
  // column would be redundant noise there. An admin's list spans every
  // user, so it's the one case worth showing who each row belongs to.
  const showOwner = user?.role === "admin";

  if (!recordings || !recordings.length) {
    return <div className="empty-note">No recordings yet. Start one from the Recorder tab.</div>;
  }

  async function handleDelete(recordingId, name) {
    if (!window.confirm(`Delete "${name}" permanently? This removes its Excel dataset, locator repository, and generated Behave artifacts. This cannot be undone.`)) {
      return;
    }
    setDeletingId(recordingId);
    try {
      await Api.del(`/api/recordings/${recordingId}`);
      if (onChanged) onChanged();
    } catch (e) {
      window.alert("Failed to delete: " + e.message);
    } finally {
      setDeletingId(null);
    }
  }

  return (
    <div className="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th><th>URL</th><th>Transaction Code</th><th>Status</th>
            <th>Steps</th><th>Pages</th><th>Executions</th><th>Created</th>
            {showOwner && <th>Owner</th>}
            {withActions && <th>Downloads</th>}
          </tr>
        </thead>
        <tbody>
          {recordings.map((r) => (
            <tr key={r.recording_id}>
              <td>{r.name}</td>
              <td>{r.target_url}</td>
              <td>{r.transaction_code || "-"}</td>
              <td><span className={`badge ${r.status}`}>{r.status}</span></td>
              <td>{r.total_steps || 0}</td>
              <td>{r.total_pages || 0}</td>
              <td>{r.total_executions || 0}</td>
              <td>{dateTimeStr(r.created_at)}</td>
              {showOwner && <td>{r.owner_username || "-"}</td>}
              {withActions && (
                <td>
                  <a className="link-btn" href={Api.href(`/api/recordings/${r.recording_id}/download/excel`)}>Excel</a>
                  <a className="link-btn" href={Api.href(`/api/recordings/${r.recording_id}/download/feature`)}>Feature</a>
                  <a className="link-btn" href={Api.href(`/api/recordings/${r.recording_id}/download/locator_repository`)}>Locator JSON</a>
                  <a className="link-btn" href={Api.href(`/api/recordings/${r.recording_id}/download/page_objects`)}>Page Objects</a>
                  <a className="link-btn" href={Api.href(`/api/recordings/${r.recording_id}/download/step_definitions`)}>Step Defs</a>
                  <button
                    type="button"
                    className="link-btn danger"
                    disabled={r.status === "recording" || deletingId === r.recording_id}
                    title={r.status === "recording" ? "Stop the recording before deleting it" : undefined}
                    onClick={() => handleDelete(r.recording_id, r.name)}
                  >
                    {deletingId === r.recording_id ? "Deleting..." : "Delete"}
                  </button>
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
