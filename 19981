    if not recording_store.exists(recording_id):
        raise HTTPException(404, "Recording not found")
    if not req.steps:
        raise HTTPException(400, "steps must be a non-empty list")
    paths = recording_store.paths(recording_id)
    store = ExcelStore(paths.execution_excel)
    store.write_rows(req.steps)
    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "replace_steps",
        recording_id=recording_id, details={"row_count": len(req.steps)},
