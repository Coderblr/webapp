"""
self_healer.py

Orchestrates Self-Healing Stages 3-7 (spec sections 20-21), invoked by the
executor only after Stages 1-2 (primary + fallback locators, handled in
execution/selenium_executor.py) have already failed:

  Stage 3: search the locator repository for same-page candidates
  Stage 4: crawl + rank the live DOM (deterministic similarity)
  Stage 5: AI-assisted candidate identification (LangChain + configurable
           provider) when deterministic confidence is inconclusive
  Stage 6: validate the winning candidate by actually resolving it in the
           browser (never trust the score alone)
  Stage 7: only return a healed locator if confidence clears the
           configured threshold; the caller (executor) then updates the
           locator repository AND the Excel file (spec section 21).

Every attempt - successful or not - should be logged by the caller into
HealingEvent / metadata_store so the dashboard's "Self-Healed" counters
and the report's failure/healing sections stay accurate.
"""
from __future__ import annotations

import logging
import time
from typing import Any, Dict, Optional

from backend.ai import langchain_agent
from backend.ai.prompt_templates import LOCATOR_RECOVERY_SYSTEM_PROMPT, locator_recovery_prompt
from backend.config import settings
from backend.execution import playwright_executor
from backend.execution.action_engine import ActionEngine
from backend.healing import locator_matcher
from backend.recorder.browser_factory import PlaywrightSession
from backend.storage.locator_store import LocatorRepository
from backend.storage.models import HealingEvent, new_id

logger = logging.getLogger("universal_automation.self_healer")


def heal(
    session: PlaywrightSession,
    engine: ActionEngine,
    step: Dict[str, Any],
    locator_repo: Optional[LocatorRepository],
    ai_provider: Optional[str] = None,
) -> Dict[str, Any]:
    """Attempt to recover a working locator for a failed step.

    Returns a dict:
        {
          "success": bool,
          "new_locator_type": str,
          "new_locator": str,
          "confidence": float,
          "healing_method": str,
          "reason": str,
        }

    `reason` is set to the literal string "session_lost" (instead of the
    usual human-readable explanation) whenever the browser session itself
    turns out to be gone - see the module-level _is_dead_session() check
    below. The caller (executor.py) relies on this exact value to set its
    own _session_dead flag and skip every remaining step immediately,
    rather than letting each one separately rediscover the same dead
    session through a full, doomed run of Stages 3-7.
    """
    if _page_already_gone(session):
        logger.warning(
            "Self-healing skipped for step %s: the browser page is already closed/gone - "
            "not attempting any recovery stage against a session that can't respond.",
            step.get("step_number"),
        )
        return _result(False, "", "", 0.0, "none", "session_lost")

    page_url = step.get("page_url", "")
    page_id = _page_id_from_url(page_url)
    old_signature = {
        "element_tag": step.get("element_tag", ""),
        "element_text": step.get("element_text", ""),
        "attributes": {"name": step.get("element_name", "")},
        "component_type": "",
    }

    # ---- Stage 3: locator repository search -----------------------
    if locator_repo:
        repo_candidates = locator_repo.find_candidates(page_id=page_id, limit=settings.HEALING_MAX_CANDIDATES)
        if repo_candidates:
            from backend.healing.candidate_ranker import rank_candidates
            ranked = rank_candidates(old_signature, repo_candidates, top_n=3)
            if ranked and ranked[0].score >= settings.HEALING_CONFIDENCE_THRESHOLD:
                winner = ranked[0]
                loc = locator_matcher.candidate_to_locator(winner.element)
                validated = _validate(session, engine, step, loc.strategy, loc.value)
                if validated:
                    return _result(True, loc.strategy, loc.value, winner.score, "repository", "; ".join(winner.reasons))

    # ---- Stage 4: live DOM similarity -------------------------------
    try:
        ranked_dom = locator_matcher.best_match(old_signature, session.page, page_id, settings.HEALING_MAX_CANDIDATES)
    except Exception as exc:
        if _is_dead_session(exc):
            logger.warning(
                "Self-healing aborted for step %s: the browser session is gone (%s) - not "
                "attempting Stage 5/6/7 against a page that can no longer respond.",
                step.get("step_number"), exc,
            )
            return _result(False, "", "", 0.0, "none", "session_lost")
        logger.warning("DOM crawl during healing failed: %s", exc)
        ranked_dom = []

    if ranked_dom and ranked_dom[0].score >= settings.HEALING_CONFIDENCE_THRESHOLD:
        winner = ranked_dom[0]
        loc = locator_matcher.candidate_to_locator(winner.element)
        validated = _validate(session, engine, step, loc.strategy, loc.value)
        if validated:
            return _result(True, loc.strategy, loc.value, winner.score, "dom_similarity", "; ".join(winner.reasons))

    # ---- Stage 5: AI-assisted recovery ------------------------------
    if ranked_dom and langchain_agent.is_provider_available(ai_provider):
        try:
            candidates_payload = [
                {"index": i, **{k: c.element.get(k) for k in ("tag", "text", "role", "attributes", "component_type")}}
                for i, c in enumerate(ranked_dom)
            ]
            response = langchain_agent.ask_json(
                LOCATOR_RECOVERY_SYSTEM_PROMPT,
                locator_recovery_prompt(
                    step.get("primary_locator_type", ""), step.get("primary_locator", ""),
                    old_signature, candidates_payload, page_url,
                ),
                provider=ai_provider,
            )
            idx = response.get("candidate_index", -1)
            ai_confidence = float(response.get("confidence", 0))
            if 0 <= idx < len(ranked_dom) and ai_confidence >= settings.HEALING_CONFIDENCE_THRESHOLD:
                winner = ranked_dom[idx]
                loc = locator_matcher.candidate_to_locator(winner.element)
                validated = _validate(session, engine, step, loc.strategy, loc.value)
                if validated:
                    return _result(True, loc.strategy, loc.value, ai_confidence, "ai_semantic", response.get("reasoning", ""))
        except langchain_agent.AIUnavailableError as exc:
            logger.info("AI healing stage skipped: %s", exc)
        except Exception as exc:
            logger.warning("AI healing stage failed: %s", exc)

    # ---- Stage 7: nothing cleared the confidence bar ----------------
    best_score = ranked_dom[0].score if ranked_dom else 0.0
    return _result(False, "", "", best_score, "none", "No candidate met the confidence threshold")


def _validate(session: PlaywrightSession, engine: ActionEngine, step: Dict[str, Any], locator_type: str, locator_value: str) -> bool:
    """Stage 6: never trust a score alone - confirm the candidate actually
    resolves to a present element in the live DOM before healing."""
    if not locator_value:
        return False
    try:
        context = playwright_executor.resolve_frame(session, step)
        return engine.is_present(context, locator_type, locator_value, timeout=3.0)
    except Exception:
        return False


def _page_id_from_url(url: str) -> str:
    import hashlib
    normalized = (url or "").split("?")[0].rstrip("/")
    return "page_" + hashlib.sha1(normalized.encode("utf-8")).hexdigest()[:16]


# Kept as its own copy rather than imported from executor.py's
# Executor._is_dead_session_error (a classmethod on an unrelated class, and
# importing execution.executor from here would risk a backend.execution <->
# backend.healing import cycle since executor.py already imports this
# module). Same substrings, same reasoning: no single Playwright exception
# subclass covers "browser/context/page is already gone" across every
# version this pins against, so a substring check is the reliable option.
_DEAD_SESSION_MARKERS = ("has been closed", "Target closed", "Connection closed", "Browser has been closed")


def _is_dead_session(exc: BaseException) -> bool:
    text = str(exc)
    return any(marker in text for marker in _DEAD_SESSION_MARKERS)


def _page_already_gone(session: PlaywrightSession) -> bool:
    """Cheap up-front check so heal() can skip Stages 3-7 entirely when the
    session is already known dead, instead of discovering that fact partway
    through (Stage 3's repository search doesn't touch the page at all, so
    it would otherwise run for nothing) - see heal()'s docstring."""
    try:
        return session.page.is_closed()
    except Exception:
        return False


def _result(success: bool, locator_type: str, locator_value: str, confidence: float, method: str, reason: str) -> Dict[str, Any]:
    return {
        "success": success,
        "new_locator_type": locator_type,
        "new_locator": locator_value,
        "confidence": round(confidence, 3),
        "healing_method": method,
        "reason": reason,
    }


def make_event(step_number: int, page_url: str, old_type: str, old_value: str, result: Dict[str, Any]) -> HealingEvent:
    return HealingEvent(
        healing_id=new_id("heal_"),
        step_number=step_number,
        page_url=page_url,
        old_locator_type=old_type,
        old_locator=old_value,
        new_locator_type=result.get("new_locator_type", ""),
        new_locator=result.get("new_locator", ""),
        confidence=result.get("confidence", 0.0),
        healing_method=result.get("healing_method", ""),
        reason=result.get("reason", ""),
        timestamp=time.time(),
        applied=result.get("success", False),
    )
