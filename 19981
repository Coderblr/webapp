// Builds the exit report client-side from the same JSON the API already
// returns (POST /api/run_recording) - no extra backend endpoint needed,
// and it works identically whether the report is opened in a new browser
// tab or downloaded as a file.

export function buildReportText(report) {
  const line = "=".repeat(72);
  const dash = "-".repeat(72);
  const lines = [
    line,
    "AI TEST RECORDER - EXIT REPORT",
    line,
    `Transaction ID : ${report.transaction_id}`,
    `Recording      : ${report.transaction_name}`,
    `Run by         : ${report.user}`,
    `Run at (UTC)   : ${report.date_time}`,
    `Overall Status : ${report.status}`,
    dash,
    `${"#".padEnd(4)}${"Playwright Step".padEnd(50)}${"Status".padEnd(10)}`,
    dash,
  ];
  report.steps.forEach((s, i) => {
    lines.push(`${String(i + 1).padEnd(4)}${s.step_name.slice(0, 48).padEnd(50)}${s.status.padEnd(10)}`);
    if (s.error_message) lines.push(`     -> ERROR: ${s.error_message}`);
  });
  lines.push(dash, `Passed: ${report.passed_count}   Failed: ${report.failed_count}   Total: ${report.step_count}`, line);
  return lines.join("\n");
}

function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

// A hand-rolled SVG donut chart (no charting library) so the report stays
// a single, self-contained HTML file that opens correctly straight from
// disk or a blob URL, with no external script/CSS dependency to fetch.
// Colors match the app's SBI-inspired palette (see tailwind.config.js) -
// hardcoded here since a standalone exported file has no Tailwind to draw
// on.
function donutChartSvg(passed, failed) {
  const total = passed + failed || 1;
  const radius = 70;
  const circumference = 2 * Math.PI * radius;
  const passedLen = (passed / total) * circumference;
  const passedPct = Math.round((passed / total) * 100);

  return `
    <svg viewBox="0 0 180 180" width="180" height="180" role="img" aria-label="Passed vs failed steps">
      <circle cx="90" cy="90" r="${radius}" fill="none" stroke="#F4D9D6" stroke-width="20" />
      <circle cx="90" cy="90" r="${radius}" fill="none" stroke="#B3271E" stroke-width="20"
        stroke-dasharray="${circumference} ${circumference}" transform="rotate(-90 90 90)" />
      <circle cx="90" cy="90" r="${radius}" fill="none" stroke="#1E8A5F" stroke-width="20"
        stroke-dasharray="${passedLen} ${circumference - passedLen}" transform="rotate(-90 90 90)" />
      <text x="90" y="86" text-anchor="middle" font-size="30" font-weight="700" fill="#0B1E3D"
        font-family="ui-monospace, Consolas, monospace">${passedPct}%</text>
      <text x="90" y="106" text-anchor="middle" font-size="12" fill="#5B6B85"
        font-family="Segoe UI, -apple-system, sans-serif">passed</text>
    </svg>`;
}

// A compact strip of one colored segment per step, in order - lets a
// reader spot at a glance roughly where in a long run things started
// failing, before even reading the table below it.
function stepSequenceBarHtml(steps) {
  if (!steps || steps.length === 0) return "";
  const segments = steps
    .map((s, i) => {
      const color = s.status === "Passed" ? "#1E8A5F" : "#B3271E";
      const title = `#${i + 1} ${escapeHtml(s.step_name)} — ${escapeHtml(s.status)}`;
      return `<div title="${title}" style="flex:1;background:${color};height:100%;"></div>`;
    })
    .join("");
  return `<div style="display:flex;gap:1px;height:12px;width:100%;border-radius:999px;overflow:hidden;border:1px solid #D8E1EF;background:#D8E1EF;margin:14px 0 4px;">${segments}</div>`;
}

export function buildReportHtml(report) {
  const overallOk = report.status === "Success";

  const stepRows = report.steps
    .map((s, i) => {
      const ok = s.status === "Passed";
      return `
        <tr>
          <td>${i + 1}</td>
          <td>${escapeHtml(s.step_name)}</td>
          <td><span class="badge ${ok ? "badge-pass" : "badge-fail"}">${escapeHtml(s.status)}</span></td>
          <td class="mono">${escapeHtml(s.error_message || "")}</td>
        </tr>`;
    })
    .join("");

  const fileRows = (report.files || [])
    .map((f) => `<tr><td>${escapeHtml(f.file_name)}</td><td class="mono">${escapeHtml(f.folder_path)}</td></tr>`)
    .join("");

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Exit Report - Transaction #${report.transaction_id}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    font-family: "Segoe UI", -apple-system, Inter, sans-serif;
    background: #F4F7FC; color: #0B1E3D; margin: 0; padding: 0;
  }
  .topbar {
    background: linear-gradient(90deg, #0E2A66 0%, #163C8C 60%, #1B4CA6 100%);
    color: #fff; padding: 14px 24px; display: flex; align-items: center; gap: 10px;
  }
  .topbar .mark {
    width: 28px; height: 28px; border-radius: 6px; background: rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;
    border: 1px solid rgba(255,255,255,0.35);
  }
  .topbar .name { font-weight: 600; font-size: 14px; letter-spacing: .01em; }
  .topbar .tag { font-size: 11px; color: rgba(255,255,255,0.75); margin-left: auto; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 32px 24px 40px; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  h2 { font-size: 14px; margin: 0 0 14px; }
  .sub { color: #5B6B85; font-size: 13px; margin-bottom: 24px; word-break: break-word; }
  .card { background: #fff; border: 1px solid #D8E1EF; border-radius: 6px; padding: 24px; margin-bottom: 20px; }
  .top { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .top-detail { flex: 1; min-width: 260px; }
  .metrics { display: grid; grid-template-columns: repeat(2, minmax(120px, 1fr)); gap: 12px; margin-top: 10px; }
  .metric { border: 1px solid #D8E1EF; padding: 12px 14px; border-radius: 6px; }
  .metric .n { font-family: ui-monospace, Consolas, monospace; font-size: 22px; font-weight: 600; }
  .metric .l { font-size: 11px; text-transform: uppercase; color: #5B6B85; letter-spacing: .04em; margin-top: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #D8E1EF; vertical-align: top; word-break: break-word; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #5B6B85; background: #EAF1FA; }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  .badge {
    display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 11px;
    font-weight: 600; text-transform: uppercase; border: 1px solid transparent;
  }
  .badge-pass { background: #E4F5EC; color: #146342; border-color: rgba(30,138,95,.35); }
  .badge-fail { background: #FBE8E6; color: #B3271E; border-color: rgba(179,39,30,.35); }
  .status-pill { display: inline-flex; padding: 5px 14px; border-radius: 4px; font-weight: 700; font-size: 13px; text-transform: uppercase; }
