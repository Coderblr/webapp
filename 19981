@router.post("/{session_uid}/pause")
def pause_recording(session_uid: str) -> dict[str, Any]:
    """Section 25 — preserves Start/Pause/Resume/Stop. The browser
    session stays open; only capture is suspended, so a person can
    navigate to the right screen or step away without every click in
    between becoming part of the recorded transaction."""
    result = recorder_agent(action="pause", session_uid=session_uid)
    if not result.ok:
        error = result.get("error", f"session {session_uid} not found")
        status = 404 if "unknown session" in error else 409
        raise HTTPException(status, error)
    return result.get("info", {})


