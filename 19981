"""SQLite access layer.

Ported from the original PostgreSQL/psycopg layer. The public API
(query, query_one, execute, insert_returning, executemany, jsonb,
init_schema, available, healthcheck, connection, cursor) is unchanged, so
every agent / route / repository module that calls `db.*` keeps working
without modification.

Because ~20 call sites still write SQL in Postgres dialect (`%s`
placeholders, `::jsonb` / `::vector` casts, `ILIKE`, `now()`), every
statement is passed through `_translate_sql()` before execution. This is
safe here because all SQL text in this codebase is authored by us, never
built from user input.

The AI agents never talk to the database directly through LangChain tools —
they call this module.  Section 3: "LangChain ... not used for DB/browser/
file ops".
"""
from __future__ import annotations

import json
import re
import sqlite3
import threading
from contextlib import contextmanager
from datetime import date, datetime
from pathlib import Path
from typing import Any, Iterable, Iterator, Optional, Sequence

from .config import PROJECT_ROOT, settings
from .logging_conf import get_logger

log = get_logger(__name__)

_conn: Optional[sqlite3.Connection] = None
_write_lock = threading.Lock()  # SQLite allows one writer at a time

# ── Postgres → SQLite SQL translation ───────────────────────────────────
_NOW_RE = re.compile(r"\bnow\(\)", re.IGNORECASE)
_ILIKE_RE = re.compile(r"\bILIKE\b", re.IGNORECASE)
_CAST_RE = re.compile(r"::(jsonb|vector)\b", re.IGNORECASE)


def _translate_sql(sql: str) -> str:
    sql = _CAST_RE.sub("", sql)          # %s::jsonb / %s::vector -> %s
    sql = sql.replace("%s", "?")         # psycopg -> sqlite3 placeholder style
    sql = _ILIKE_RE.sub("LIKE", sql)     # sqlite LIKE is already ASCII case-insensitive
    sql = _NOW_RE.sub("CURRENT_TIMESTAMP", sql)
    return sql


def _adapt_param(value: Any) -> Any:
    """psycopg auto-adapts lists/dicts/datetimes; sqlite3 does not."""
    if isinstance(value, (list, dict, tuple)):
        return json.dumps(value, ensure_ascii=False, default=str)
    if isinstance(value, (datetime, date)):
        return value.isoformat()
    if isinstance(value, bool):
        return int(value)
    return value


def _adapt_params(params: Sequence[Any] | None) -> tuple:
    return tuple(_adapt_param(p) for p in (params or ()))


def get_connection() -> sqlite3.Connection:
    global _conn
    if _conn is None:
        path = settings.sqlite_db_path
        path.parent.mkdir(parents=True, exist_ok=True)
        _conn = sqlite3.connect(str(path), check_same_thread=False, timeout=15.0)
        _conn.row_factory = sqlite3.Row
        _conn.execute("PRAGMA journal_mode=WAL")
        _conn.execute("PRAGMA foreign_keys=ON")
        log.info("SQLite database opened -> %s", path)
    return _conn


def close_pool() -> None:
    global _conn
    if _conn is not None:
        _conn.close()
        _conn = None


@contextmanager
def connection() -> Iterator[sqlite3.Connection]:
    yield get_connection()


@contextmanager
def cursor() -> Iterator[sqlite3.Cursor]:
    conn = get_connection()
    cur = conn.cursor()
    try:
        yield cur
    finally:
        cur.close()


def _rows_to_dicts(rows: list[sqlite3.Row]) -> list[dict[str, Any]]:
    return [dict(r) for r in rows]


def query(sql: str, params: Sequence[Any] | None = None) -> list[dict[str, Any]]:
    sql = _translate_sql(sql)
    p = _adapt_params(params)
    with _write_lock, cursor() as cur:
        cur.execute(sql, p)
        if cur.description is None:
            return []
        return _rows_to_dicts(cur.fetchall())


def query_one(sql: str, params: Sequence[Any] | None = None) -> Optional[dict[str, Any]]:
    rows = query(sql, params)
    return rows[0] if rows else None


def execute(sql: str, params: Sequence[Any] | None = None) -> int:
    sql = _translate_sql(sql)
    p = _adapt_params(params)
    with _write_lock:
        conn = get_connection()
        cur = conn.execute(sql, p)
        conn.commit()
        return cur.rowcount


def insert_returning(sql: str, params: Sequence[Any] | None = None) -> Optional[dict[str, Any]]:
    sql = _translate_sql(sql)
    p = _adapt_params(params)
    with _write_lock:
        conn = get_connection()
        cur = conn.execute(sql, p)
        row = None
        if cur.description is not None:
            row = cur.fetchone()
        conn.commit()
        return dict(row) if row is not None else None


def executemany(sql: str, rows: Iterable[Sequence[Any]]) -> None:
    payload = [_adapt_params(r) for r in rows]
    if not payload:
        return
    sql = _translate_sql(sql)
    with _write_lock:
        conn = get_connection()
        conn.executemany(sql, payload)
        conn.commit()


def jsonb(value: Any) -> str:
    """Serialize to the TEXT representation used for JSON columns."""
    return json.dumps(value if value is not None else {}, ensure_ascii=False, default=str)


# ── schema bootstrap ────────────────────────────────────────────────────
SCHEMA_FILE = PROJECT_ROOT / "db" / "schema.sql"


def init_schema(schema_file: Path | None = None) -> None:
    """Apply db/schema.sql (idempotent)."""
    path = schema_file or SCHEMA_FILE
    sql = path.read_text(encoding="utf-8")
    with _write_lock:
        conn = get_connection()
        conn.executescript(sql)
        conn.commit()
    log.info("Schema applied from %s", path)


_available_cache: tuple[float, bool] | None = None
AVAILABILITY_TTL = 30.0


def available() -> bool:
    """Cheap, cached "is the database reachable?" probe."""
    global _available_cache
    import time
    now = time.time()
    if _available_cache and (now - _available_cache[0]) < AVAILABILITY_TTL:
        return _available_cache[1]
    try:
        with _write_lock, cursor() as cur:
            cur.execute("SELECT 1")
        ok = True
    except Exception as exc:  # noqa: BLE001
        log.warning("SQLite unavailable: %s", exc)
        ok = False
    _available_cache = (now, ok)
    return ok


def invalidate_availability() -> None:
    global _available_cache
    _available_cache = None


def healthcheck() -> dict[str, Any]:
    try:
        row = query_one("SELECT sqlite_version() AS v")
        return {
            "connected": True,
            "version": f"SQLite {(row or {}).get('v')}",
            "extensions": ["vector (python-side, brute-force cosine)"],
        }
    except Exception as exc:  # pragma: no cover - depends on live DB
        return {"connected": False, "error": str(exc)}
