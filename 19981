"""
Turns raw "copy"/"paste" actions captured by the injected JS (see
recorder/recorder_injector.js's copy/cut/paste listeners) into the
Capture -> Store -> Reuse variable pipeline:

  1. A "copy" action's source field gets a stable {{name}} placeholder
     derived from its label, e.g. a field labeled "Generated Username"
     becomes {{username}}, "Generated Application ID" becomes
     {{application_id}}.
  2. Any LATER "paste" (or manually retyped "type") action whose recorded
     value exactly matches a previously copied value is tagged with that
     same placeholder, so the generator (generator/build.py) can emit a
     step that resolves it from the LIVE value captured earlier in that
     same run (see runner/variables.py) instead of a hard-coded literal.

This module only ADDS optional keys to the action dicts it's given
("captured_as" on copy actions, "resolved_var" on paste/type actions) - it
never removes or rewrites an existing key, so recordings without any
copy/paste in them (or JSON built before this feature existed) round-trip
completely unchanged. It's also idempotent: running it twice on the same
actions list keeps the same names, so generator/build.py can safely call it
again as a safety net for recordings that were produced without going
through Recorder.stop()'s hook.
"""
from __future__ import annotations
from typing import Dict, List

# Words stripped from a source field's label before it becomes a variable
# name, e.g. "Generated Username" -> "username", "Generated Application ID"
# -> "application_id".
_STOPWORDS = {
    "generated", "generate", "new", "auto", "your", "the", "a", "an",
    "current", "this", "field", "value", "display", "label", "output",
}


def _locator_identity(action: Dict):
    """A stable-ish key for 'is this the same physical element' - prefers the
    first (highest-priority) captured locator, since two different actions
    on the SAME element should always agree on it; falls back to the
    element description for the rare case no locator was captured at all."""
    locs = action.get("locators") or []
    if locs:
        top = locs[0]
        return (top.get("strategy"), top.get("value"))
    el = action.get("element") or {}
    return (el.get("tag"), el.get("name"), el.get("placeholder"), el.get("ariaLabel"))


def coalesce_consecutive_types(actions: List[Dict], window_ms: int = 3000) -> List[Dict]:
    """
    Merges a 'type' action into the immediately preceding one if both target
    the SAME element and happened within `window_ms` of each other, keeping
    the LATER value. Native/masked inputs (date pickers especially) commonly
    fire more than one 'change' event for what the user experienced as ONE
    edit - e.g. the browser reformatting "01092026" into "01/09/2026" right
    after typing, or a native date picker's day/month/year segments each
    firing their own change - which otherwise shows up as two separate,
    confusingly-duplicated "enters X into Y" steps for the same field.
    Only ADJACENT same-element 'type' actions are merged - an intervening
    click/keypress/other action on something else breaks the chain, since
    that's very likely a deliberate second visit to the field rather than
    the same edit settling.
    """
    merged: List[Dict] = []
    for action in actions:
        if (
            action.get("action") == "type"
            and merged
            and merged[-1].get("action") == "type"
            and _locator_identity(action) == _locator_identity(merged[-1])
            and (action.get("ts", 0) - merged[-1].get("ts", 0)) <= window_ms
        ):
            merged[-1] = {
                **merged[-1],
                "value": action.get("value"),
                "ts": action.get("ts"),
                "locators": action.get("locators") or merged[-1].get("locators"),
            }
            continue
        merged.append(action)
    return merged


def derive_variable_name(element: Dict, used_names: set) -> str:
    """Heuristic, LLM-free variable-name generator for a copy source element."""
    base = (
        element.get("ariaLabel")
        or element.get("placeholder")
        or element.get("name")
        or element.get("text")
        or element.get("tag")
        or "value"
    )
    tokens = "".join(c if c.isalnum() else " " for c in base.lower()).split()
    filtered = [t for t in tokens if t not in _STOPWORDS]
    tokens = filtered or tokens or ["value"]
    name = "_".join(tokens)[:40].strip("_") or "value"

    candidate = name
    n = 2
    while candidate in used_names:
        candidate = f"{name}_{n}"
        n += 1
    used_names.add(candidate)
    return candidate


def _normalize(value: str) -> str:
    """Whitespace-collapsed, case-folded form of a captured value, used as a
    fallback correlation key so a copy of "ABC123" still matches a paste
    that landed in the recording as " abc123 " (trimmed/re-cased by the
    target field) even though the exact strings differ."""
    return " ".join(value.split()).casefold()


def annotate_variables(actions: List[Dict]) -> List[Dict]:
    """
    Walks the recording in order and stamps "captured_as" / "resolved_var"
    onto the relevant action dicts in place (and also returns the list, for
    convenience). See module docstring for the full behavior.
    """
    used_names: set = set()
    captured_values: Dict[str, str] = {}       # exact copied text -> variable name
    captured_values_norm: Dict[str, str] = {}  # normalized copied text -> variable name

    for action in actions:
        kind = action.get("action")
        value = action.get("value")

        if kind in ("copy", "ocr_capture") and value:
            var_name = (
                action.get("captured_as")
                or captured_values.get(value)
                or captured_values_norm.get(_normalize(value))
            )
            if var_name:
                used_names.add(var_name)
            else:
                var_name = derive_variable_name(action.get("element", {}), used_names)
            captured_values[value] = var_name
            captured_values_norm[_normalize(value)] = var_name
            action["captured_as"] = var_name

        elif kind in ("paste", "type") and value:
            var_name = (
                action.get("resolved_var")
                or captured_values.get(value)
                or captured_values_norm.get(_normalize(value))
            )
            if var_name:
                action["resolved_var"] = var_name
            elif kind == "paste":
                # A real clipboard-paste DOM event (recorder_injector.js) that
                # didn't correlate to any earlier copy in this recording - the
                # generator falls back to the record-time literal for it, so
                # flag that here rather than letting it happen silently (see
                # generator/build.py's use of this field).
                action["correlation_status"] = "unresolved"

    return actions
