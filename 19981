<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Record Transaction</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<script src="js/api.js"></script>
<script>
const content = renderShell('record.html', 'Record Transaction',
  'Record each unique transaction ONCE — the capture becomes a permanent, versioned knowledge package');

content.innerHTML = `
  <div class="banner info">
    Recording is required only for a brand-new transaction, a full redesign, or when
    AI confidence drops below threshold. Locator, CSS, position, message and small
    workflow changes are self-healed — do not re-record for those.
  </div>

  <div class="grid g2">
    <div class="card">
      <h3>New recording session</h3>
      <div class="row">
        <div class="field"><label>Transaction ID</label>
          <input id="txnId" placeholder="1045" oninput="checkKnowledge()"></div>
        <div class="field"><label>Transaction name</label>
          <input id="txnName" placeholder="CIF Creation"></div>
      </div>
      <div class="row">
        <div class="field"><label>Environment</label>
          <select id="env"><option>PREPROD</option><option>UAT</option><option>PROD</option></select></div>
        <div class="field"><label>Type</label>
          <select id="txnType">
            <option value="business">business</option>
            <option value="system_prerequisite">system_prerequisite (e.g. 9750)</option>
            <option value="system_cleanup">system_cleanup</option>
          </select></div>
      </div>
      <div class="field"><label>Start URL</label>
        <input id="url" placeholder="https://preprod.example.sbi/portal"></div>
      <div class="field"><label>Description</label>
        <textarea id="desc" rows="2" placeholder="optional"></textarea></div>
      <div class="checkline"><input type="checkbox" id="crawl" checked>
        <span>Crawl the whole page (capture every interactable element, not only the ones clicked)</span></div>
      <div class="checkline"><input type="checkbox" id="net" checked>
        <span>Capture network activity (API calls, status codes, response times)</span></div>
      <div class="checkline"><input type="checkbox" id="captureValues">
        <span>Use the values I type during this recording as the default test data</span></div>
      <div class="checkline"><input type="checkbox" id="captureSensitiveValues">
        <span style="color:#c0392b">⚠ Also capture password/PIN/OTP values — only enable this if this
          environment uses DUMMY/test credentials only, never real ones. This has no effect
          unless the option above is also checked.</span></div>
      <div class="actions">
        <button id="startBtn" onclick="startRecording()">Start recording</button>
        <button class="ghost" id="crawlBtn" onclick="forceCrawl()" disabled>Crawl now</button>
        <button class="ghost" id="pauseBtn" onclick="pauseRecording()" disabled>Pause</button>
        <button class="ghost" id="resumeBtn" onclick="resumeRecording()" disabled style="display:none">Resume</button>
        <button class="danger" id="stopBtn" onclick="stopRecording()" disabled>Stop recording</button>
      </div>
      <div id="knowledge" class="hint"></div>
    </div>

    <div class="card">
      <h3>Live capture feed <span id="statusBadge" class="hint"></span></h3>
      <div class="grid g4" id="liveStats" style="margin-bottom:12px"></div>
      <div class="feed" id="feed"><div class="muted">Not recording.</div></div>
    </div>
  </div>

  <div class="card" id="decisionCard" style="display:none">
    <h3>Keep or Discard <span class="muted">— nothing reaches the framework until you decide</span></h3>
    <div id="qualitySummary" style="margin-bottom:14px"></div>

    <div class="actions" style="margin-bottom:14px">
      <button class="ghost" onclick="getAiSummary()" id="aiSummaryBtn">Get AI workflow summary</button>
    </div>
    <div id="aiSummaryOut" style="margin-bottom:14px"></div>

    <div id="stepsSummary" style="margin-bottom:14px"></div>
    <div id="captureSummary"></div>
    <div id="checkpointsSummary" style="margin-top:14px"></div>
    <div id="networkSummary" style="margin-top:14px"></div>
    <div id="componentsWithinSummary" style="margin-top:14px"></div>

    <div class="field" style="margin-top:14px"><label>Reason (optional, stored with the decision)</label>
      <input id="reason" placeholder="e.g. mis-click on the review screen"></div>
    <div class="checkline"><input type="checkbox" id="genCode" checked>
      <span>Generate Feature / Page Object / Step Definitions (pure Python, behave) after keeping</span></div>
    <div class="actions">
      <button class="ok" onclick="decide('keep')">Keep this recording</button>
      <button class="danger" onclick="decide('discard')">Discard</button>
    </div>
    <div id="codegenOut" style="margin-top:14px"></div>
  </div>`;

let session = null;
let lastManifest = null;
const feed = $('#feed');

openSocket('/api/recorder/live', event => {
  if (event.type === 'action') {
    append(`▸ ${event.action.toUpperCase()} — ${event.element || ''} `
         + `[${event.element_type || ''}] on ${event.page || ''}`);
  } else if (event.type === 'crawl') {
    append(`⌕ crawled "${event.page || ''}" — ${event.elements} element(s) known`);
  } else if (event.type === 'codegen') {
    append(`⚙ code generation ${event.ok ? 'OK' : 'FAILED'}`);
    renderCodegen(event);
  } else if (event.type === 'compile') {
    append(`⚙ compile ${event.ok ? 'OK' : 'FAILED'} — ${event.summary || ''}`);
  }
  refreshStats();
});

function append(line) {
  if (feed.firstChild && feed.firstChild.className === 'muted') feed.innerHTML = '';
  feed.appendChild(el('div', {}, [new Date().toLocaleTimeString() + '  ' + line]));
  feed.scrollTop = feed.scrollHeight;
}

async function checkKnowledge() {
  const id = $('#txnId').value.trim();
  if (!id) { $('#knowledge').innerHTML = ''; return; }
  try {
    const txn = await API.get('/api/transactions/' + encodeURIComponent(id));
    const k = txn.knowledge || {};
    $('#knowledge').innerHTML =
      `Already known: <strong>${txn.transaction.name}</strong> v${txn.transaction.version}
       (${txn.transaction.status}, confidence ${txn.transaction.confidence}).
       Recommended action: <strong>${k.action || 'reuse'}</strong>.
       Recording again creates version ${nextVersion(txn.transaction.version)} — the original is never overwritten.`;
  } catch (e) {
    $('#knowledge').innerHTML = 'Unknown transaction — this will be recorded as version 1.0.';
  }
}
function nextVersion(v) { const n = parseInt(String(v).split('.')[0], 10); return (isNaN(n) ? 1 : n + 1) + '.0'; }

async function startRecording() {
  const payload = {
    transaction_id: $('#txnId').value.trim(),
    transaction_name: $('#txnName').value.trim(),
    environment: $('#env').value,
    transaction_type: $('#txnType').value,
    start_url: $('#url').value.trim(),
    description: $('#desc').value.trim() || null,
    fullpage_crawl: $('#crawl').checked,
    capture_network: $('#net').checked,
    capture_recorded_values: $('#captureValues').checked,
    capture_sensitive_values: $('#captureSensitiveValues').checked,
  };
  if (!payload.transaction_id || !payload.transaction_name || !payload.start_url) {
    return toast('Transaction ID, name and start URL are required', 'err');
  }
  try {
    const result = await API.post('/api/recorder/start', payload);
    session = result.session;
    feed.innerHTML = '';
    append('Recording started — Edge is open. Perform the transaction normally.');
    $('#startBtn').disabled = true; $('#stopBtn').disabled = false;
    $('#crawlBtn').disabled = false; $('#pauseBtn').disabled = false;
    toast('Recording ' + session.session_uid, 'ok');
    refreshStats();
  } catch (e) { toast(e.message, 'err'); }
}

async function pauseRecording() {
  if (!session) return;
  try {
    await API.post('/api/recorder/' + session.session_uid + '/pause');
    $('#pauseBtn').style.display = 'none'; $('#resumeBtn').style.display = '';
    $('#resumeBtn').disabled = false;
    $('#statusBadge').textContent = '(paused)';
    append('Paused — clicks/typing are NOT being recorded until you Resume.');
  } catch (e) { toast(e.message, 'err'); }
}

async function resumeRecording() {
  if (!session) return;
  try {
    await API.post('/api/recorder/' + session.session_uid + '/resume');
    $('#resumeBtn').style.display = 'none'; $('#pauseBtn').style.display = '';
    $('#pauseBtn').disabled = false;
    $('#statusBadge').textContent = '';
    append('Resumed recording.');
  } catch (e) { toast(e.message, 'err'); }
}

async function refreshStats() {
  if (!session) return;
  try {
    const info = await API.get('/api/recorder/' + session.session_uid + '/status');
    const s = (info.info || info).stats || {};
    const currentPage = (info.info || info).current_page;
    $('#liveStats').innerHTML = [
      ['Pages', s.pages || 0], ['Elements', s.elements || 0], ['Actions', s.actions || 0],
      ['Checkpoints', s.checkpoints || 0], ['Network events', s.network_events || 0],
      ['Duplicates filtered', s.duplicates_filtered || 0],
    ].map(([k, v]) => `<div class="stat"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('');
    if (currentPage) $('#statusBadge').textContent = $('#statusBadge').textContent.includes('paused')
      ? $('#statusBadge').textContent : '— ' + currentPage;
  } catch (e) {}
}

async function forceCrawl() {
  if (!session) return;
  try { await API.post('/api/recorder/' + session.session_uid + '/crawl');
        append('Manual crawl requested'); refreshStats(); }
  catch (e) { toast(e.message, 'err'); }
}

async function stopRecording() {
  if (!session) return;
  try {
    const result = await API.post('/api/recorder/' + session.session_uid + '/stop');
    $('#stopBtn').disabled = true; $('#crawlBtn').disabled = true;
    $('#pauseBtn').style.display = 'none'; $('#resumeBtn').style.display = 'none';
    append('Recording stopped — review the capture below.');
    lastManifest = result.manifest || {};
    const s = result.stats || {};
    const q = result.quality || {};
    const qColor = q.classification === 'READY_FOR_GENERATION' ? 'ok'
      : q.classification === 'REVIEW_RECOMMENDED' ? 'warn' : 'err';
    $('#qualitySummary').innerHTML = q.overall_score != null ? `
      <div class="stat" style="display:inline-block">
        <div class="k">Recording quality</div>
        <div class="v">${Math.round(q.overall_score * 100)}%
          <span class="badge ${qColor}">${(q.classification || '').replace(/_/g, ' ')}</span></div>
      </div>` : '';
    $('#captureSummary').innerHTML = `
      <div class="grid g4" style="margin-bottom:14px">
        ${[['Pages', s.pages], ['Elements known', s.elements],
           ['Elements touched', s.elements_interacted], ['Actions', s.actions],
           ['Steps', s.steps], ['Checkpoints', s.checkpoints],
           ['Validations', s.validations], ['Network events', s.network_events]]
          .map(([k, v]) => `<div class="stat"><div class="k">${k}</div><div class="v">${v || 0}</div></div>`).join('')}
      </div>
      <table><thead><tr><th>#</th><th>Action</th><th>Field</th><th>Variable</th><th>Page</th></tr></thead>
      <tbody>${(result.actions || []).map(a => `<tr><td>${a.sequence}</td><td>${a.action}</td>
        <td>${a.field_name || ''}</td><td class="mono">${a.value_ref ? '&lt;' + a.value_ref + '&gt;' : ''}</td>
        <td class="muted">${a.page_key || ''}</td></tr>`).join('')
        || '<tr><td colspan="5" class="empty">No actions captured.</td></tr>'}</tbody></table>`;

    // Section 7 — grouped logical steps
    const steps = lastManifest.steps || [];
    $('#stepsSummary').innerHTML = steps.length ? `
      <h4>Steps (grouped)</h4>
      <table><thead><tr><th>#</th><th>Label</th><th>Actions</th></tr></thead>
      <tbody>${steps.map(st => `<tr><td>${st.step_id}</td><td>${st.label}</td>
        <td class="muted">${st.action_count} action(s)</td></tr>`).join('')}</tbody></table>` : '';

    // Sections 15/16 — checkpoints + business validations, shown SEPARATELY
    // from the actions table above (never mixed together — they're
    // expected outcomes, not actions).
    const checkpoints = lastManifest.checkpoints || [];
    const validations = lastManifest.validations || [];
    $('#checkpointsSummary').innerHTML = (checkpoints.length || validations.length) ? `
      <h4>Checkpoints &amp; validations detected</h4>
      <table><thead><tr><th>Type</th><th>Detail</th></tr></thead><tbody>
        ${checkpoints.map(c => `<tr><td><span class="badge">${c.type.replace(/_/g,' ')}</span></td>
          <td>${(c.expected_state && c.expected_state.text_contains) || JSON.stringify(c.expected_state || {})}</td></tr>`).join('')}
        ${validations.map(v => `<tr><td><span class="badge warn">business validation</span></td>
          <td>Field <b>${v.field}</b> — "${v.validation_message}"</td></tr>`).join('')}
      </tbody></table>` : '<div class="muted">No checkpoints or validation messages detected.</div>';

    // Section 18 — which recorded action triggered which network calls
    const correlations = lastManifest.network_correlations || [];
    $('#networkSummary').innerHTML = correlations.length ? `
      <h4>Action → network correlation</h4>
      <table><thead><tr><th>Action #</th><th>Network calls</th></tr></thead><tbody>
        ${correlations.map(c => `<tr><td>${c.action_sequence}</td>
          <td class="mono">${c.network_events.map(e => `${e.http_method||''} ${e.url} (${e.status})`).join('<br>')}</td></tr>`).join('')}
      </tbody></table>` : '';

    // Section 19 — component candidates found WITHIN this one recording
    const components = lastManifest.components || [];
    $('#componentsWithinSummary').innerHTML = components.length ? `
      <h4>Repeated UI patterns (candidate reusable components)</h4>
      <table><thead><tr><th>Pages</th><th>Shared elements</th></tr></thead><tbody>
        ${components.map(c => `<tr><td>${c.pages.join(' + ')}</td>
          <td class="muted">${c.shared_element_signature.join(', ')}</td></tr>`).join('')}
      </tbody></table>` : '';

    $('#decisionCard').style.display = 'block';
    $('#decisionCard').scrollIntoView({ behavior: 'smooth' });
  } catch (e) { toast(e.message, 'err'); }
}

async function getAiSummary() {
  if (!session) return;
  $('#aiSummaryBtn').disabled = true;
  $('#aiSummaryOut').innerHTML = '<div class="muted">Asking the AI to summarise the recorded workflow…</div>';
  try {
    const result = await API.post('/api/recorder/' + session.session_uid + '/interpret');
    const stepIntents = (result.steps || []).map(s =>
      `<li><span class="mono">${s.step_id}</span> — ${s.intent}</li>`).join('');
    $('#aiSummaryOut').innerHTML = `
      <div class="banner info"><b>Workflow summary:</b> ${result.workflow_summary || '(none)'}</div>
      ${stepIntents ? `<ul>${stepIntents}</ul>` : ''}
      <div class="hint">Grounded strictly in the recorded steps — nothing here can reference a
        step, field or locator that wasn't actually captured.</div>`;
  } catch (e) {
    $('#aiSummaryOut').innerHTML = `<div class="muted">AI summary unavailable: ${e.message}</div>`;
  } finally {
    $('#aiSummaryBtn').disabled = false;
  }
}

async function decide(decision) {
  if (!session) return;
  try {
    const result = await API.post('/api/recorder/decide', {
      session_uid: session.session_uid,
      decision,
      reason: $('#reason').value.trim() || null,
      generate_code: $('#genCode').checked,
    });
    if (decision === 'discard') {
      toast('Recording discarded — nothing was written to the framework', 'ok');
      $('#decisionCard').style.display = 'none';
      resetSession();
      return;
    }
    toast(`Kept as ${result.transaction_id} v${result.version}`, 'ok');
    $('#codegenOut').innerHTML =
      `<div class="banner info">Stored as <strong>${result.transaction_id} v${result.version}</strong>.
       ${result.fields.length} test-data field(s) detected.
       ${result.codegen_job ? 'Code generation running…' : ''}</div>`;
    if (result.codegen_job) {
      const job = await waitForJob(result.codegen_job);
      renderCodegen(job.result && job.result.generated);
    }
    resetSession();
  } catch (e) { toast(e.message, 'err'); }
}

function renderCodegen(generated) {
  if (!generated) return;
  const files = generated.files || {};
  const notes = generated.reuse_notes || [];
  $('#codegenOut').innerHTML = `
    <table><thead><tr><th>Artefact</th><th>File</th></tr></thead><tbody>
    ${Object.entries(files).map(([k, v]) =>
      `<tr><td class="muted">${k}</td><td class="mono">${v}</td></tr>`).join('')}
    </tbody></table>
    ${notes.length ? `<div class="banner info" style="margin-top:12px">
      <strong>Reused instead of duplicated:</strong><br>${notes.join('<br>')}</div>` : ''}`;
}

function resetSession() {
  session = null;
  $('#startBtn').disabled = false;
  $('#stopBtn').disabled = true;
  $('#crawlBtn').disabled = true;
}
refreshStats();
setInterval(refreshStats, 4000);
</script>
</body>
</html>
