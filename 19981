import { useEffect, useState } from "react";
import Head from "next/head";
import Link from "next/link";
import Layout from "@/components/Layout";
import RequireAuth from "@/components/RequireAuth";
import { useAuth } from "@/context/AuthContext";
import { adminApi, profileApi } from "@/lib/api";
import { Callout, DataTable, Metric, Panel, PanelHeader, StatusBadge } from "@/components/ui";

function greeting() {
  const h = new Date().getHours();
  if (h < 12) return "Good morning";
  if (h < 17) return "Good afternoon";
  return "Good evening";
}

function ActionCard({ href, title, description, accent }) {
  return (
    <Link
      href={href}
      className="group block rounded-sm border border-line bg-panel p-5 shadow-crisp transition-colors hover:border-brand-blue"
    >
      <div className={`mb-3 h-1.5 w-8 rounded-full ${accent}`} />
      <h3 className="text-sm font-semibold text-ink group-hover:text-brand-blueDark">{title}</h3>
      <p className="mt-1.5 text-sm text-muted">{description}</p>
    </Link>
  );
}

export default function DashboardPage() {
  const { user } = useAuth();
  const [myActivity, setMyActivity] = useState([]);
  const [myActivityError, setMyActivityError] = useState(null);
  const [stats, setStats] = useState(null);
  const [statsError, setStatsError] = useState(null);

  useEffect(() => {
    profileApi
      .activity(8)
      .then(setMyActivity)
      .catch((e) => setMyActivityError(e.detail || e.message));

    if (user && user.role === "admin") {
      adminApi
        .dashboardStats()
        .then(setStats)
        .catch((e) => setStatsError(e.detail || e.message));
    }
  }, [user]);

  return (
    <RequireAuth>
      <Layout>
        <Head>
          <title>Dashboard - AI Test Recorder</title>
        </Head>

        <div className="mb-8">
          <h1 className="text-2xl font-semibold tracking-tight text-ink">
            {greeting()}, {user?.first_name || "there"}.
          </h1>
          <p className="mt-1 text-sm text-muted">
            Here&rsquo;s what&rsquo;s happening with your test recordings.
          </p>
        </div>

        <div className="mb-8 grid gap-4 sm:grid-cols-3">
          <ActionCard
            href="/tool"
            title="Record a new session"
            description="Capture clicks and typing on any app, then generate a Behave + Playwright suite."
            accent="bg-brand-blue"
          />
          <ActionCard
            href="/tool"
            title="Run a saved recording"
            description="Re-run something you already recorded and get a full exit report."
            accent="bg-brand-gold"
          />
          <ActionCard
            href="/profile"
            title="Your profile & activity"
            description="Update your details and review everything you've done in the tool."
            accent="bg-signal-slate"
          />
        </div>

        {user?.role === "admin" && (
          <div className="mb-8">
            <div className="mb-3 flex items-center justify-between">
              <h2 className="text-sm font-semibold uppercase tracking-wide text-muted">Platform overview</h2>
              <Link href="/admin/users" className="text-sm font-medium text-brand-blue hover:text-brand-blueDark">
                Manage users &rarr;
              </Link>
            </div>
            {statsError && <Callout tone="error">Could not load platform stats: {statsError}</Callout>}
            {stats && (
              <>
                <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
                  <Metric label="Total users" value={stats.total_users} />
                  <Metric label="Online now" value={stats.online_now} />
                  <Metric label="Runs today" value={stats.runs_today} />
                  <Metric label="Passed today" value={stats.runs_success_today} />
                </div>
                <Panel className="mt-4">
                  <PanelHeader title="Recent activity across all users" />
                  <div className="px-5 py-4">
                    <DataTable
                      columns={[
                        { key: "username", label: "User" },
                        { key: "action", label: "Action", mono: true },
                        { key: "status", label: "Status" },
                        { key: "timestamp", label: "When", mono: true },
                      ]}
                      rows={stats.recent_activity.map((a) => ({
                        username: a.username || "—",
                        action: a.action,
                        status: <StatusBadge status={a.status === "SUCCESS" ? "Success" : "Failed"} />,
                        timestamp: new Date(a.timestamp).toLocaleString(),
                      }))}
                    />
                  </div>
                </Panel>
              </>
            )}
          </div>
        )}

        <div>
          <div className="mb-3 flex items-center justify-between">
            <h2 className="text-sm font-semibold uppercase tracking-wide text-muted">Your recent activity</h2>
            <Link href="/profile" className="text-sm font-medium text-brand-blue hover:text-brand-blueDark">
              View all &rarr;
            </Link>
          </div>
          {myActivityError && <Callout tone="error">Could not load your activity: {myActivityError}</Callout>}
          <Panel>
            <div className="px-5 py-4">
              <DataTable
                columns={[
                  { key: "action", label: "Action", mono: true },
                  { key: "status", label: "Status" },
                  { key: "timestamp", label: "When", mono: true },
                ]}
                rows={myActivity.map((a) => ({
                  action: a.action,
                  status: <StatusBadge status={a.status === "SUCCESS" ? "Success" : "Failed"} />,
                  timestamp: new Date(a.timestamp).toLocaleString(),
                }))}
              />
            </div>
          </Panel>
        </div>
      </Layout>
    </RequireAuth>
  );
}
