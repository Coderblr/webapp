<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Logs</title>
<link rel="stylesheet" href="css/style.css">
<style>
  #logView {
    background:#0c1220; border:1px solid var(--line, #2a3448); border-radius:8px;
    padding:14px; font-family:ui-monospace,Consolas,monospace; font-size:12px;
    line-height:1.6; white-space:pre-wrap; word-break:break-all;
    max-height:70vh; overflow:auto; color:#cbd5e1;
  }
  #logView .err-line { color:#fca5a5; }
  #logView .warn-line { color:#fcd34d; }
</style>
</head>
<body>
<script src="js/api.js"></script>
<script>
const content = renderShell('logs.html', 'Logs',
  'Backend log lines, persisted to storage/logs/ — console output alone disappears once the terminal scrolls past it.');

content.innerHTML = `
  <div class="card">
    <div class="row">
      <div class="field"><label>Show</label>
        <select id="kind" onchange="load()">
          <option value="all">All logs</option>
          <option value="errors">Errors only (WARNING+)</option>
        </select></div>
      <div class="field"><label>Last N lines</label>
        <select id="lines" onchange="load()">
          <option value="200">200</option>
          <option value="500" selected>500</option>
          <option value="1000">1000</option>
          <option value="5000">5000</option>
        </select></div>
      <div class="field"><label>Search</label>
        <input id="search" type="text" placeholder="filter text..." oninput="debouncedLoad()"></div>
      <div class="field"><label>Auto-refresh</label>
        <select id="autoRefresh" onchange="toggleAutoRefresh()">
          <option value="0">Off</option>
          <option value="5000">Every 5s</option>
          <option value="15000">Every 15s</option>
        </select></div>
    </div>
    <div id="meta" class="hint"></div>
  </div>

  <div class="card">
    <div class="actions" style="margin-bottom:10px">
      <button onclick="load()">Refresh now</button>
      <button class="ghost" onclick="copyLogs()">Copy to clipboard</button>
    </div>
    <div id="logView">Loading…</div>
  </div>`;

let autoRefreshTimer = null;
let debounceTimer = null;
let lastLines = [];

function debouncedLoad() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(load, 300);
}

function toggleAutoRefresh() {
  clearInterval(autoRefreshTimer);
  const ms = Number($('#autoRefresh').value);
  if (ms > 0) autoRefreshTimer = setInterval(load, ms);
}

function escapeHtml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function renderLine(line) {
  const escaped = escapeHtml(line);
  if (/\|\s*(ERROR|CRITICAL)\s*\|/.test(line)) return `<span class="err-line">${escaped}</span>`;
  if (/\|\s*WARNING\s*\|/.test(line)) return `<span class="warn-line">${escaped}</span>`;
  return escaped;
}

async function load() {
  const kind = $('#kind').value;
  const lines = $('#lines').value;
  const search = $('#search').value.trim();
  const params = new URLSearchParams({ kind, lines });
  if (search) params.set('search', search);
  try {
    const r = await API.get('/api/logs?' + params);
    lastLines = r.lines || [];
    $('#meta').innerHTML = `<span class="mono">${r.file}</span> ·
      ${r.exists ? (r.size_bytes / 1024).toFixed(1) + ' KB on disk' : 'not created yet'} ·
      showing ${r.returned_lines} line(s)`;
    const view = $('#logView');
    view.innerHTML = lastLines.length
      ? lastLines.map(renderLine).join('\n')
      : '<span class="muted">No log lines yet.</span>';
    view.scrollTop = view.scrollHeight;
  } catch (e) { toast(e.message, 'err'); }
}

function copyLogs() {
  if (!lastLines.length) return toast('Nothing to copy', 'err');
  navigator.clipboard.writeText(lastLines.join('\n'))
    .then(() => toast('Copied to clipboard', 'ok'))
    .catch(() => toast('Could not copy — select and copy manually', 'err'));
}

load();
</script>
</body>
</html>
