# ── recording ───────────────────────────────────────────────────────────
@router.post("/start")
def start_recording(payload: RecordingStartRequest) -> dict[str, Any]:
    def on_event(event: dict[str, Any]) -> None:
        hub.publish("recorder", event)

    result = recorder_agent(
        action="start",
        transaction_id=payload.transaction_id,
        transaction_name=payload.transaction_name,
        start_url=payload.start_url,
        environment=payload.environment,
        transaction_type=payload.transaction_type,
        description=payload.description,
        fullpage_crawl=payload.fullpage_crawl,
        capture_network=payload.capture_network,
        on_event=on_event,
    )
    if not result.ok:
        raise HTTPException(500, result.get("error", "could not start recording"))
    return {
        "session": result["session"],
        "prior_knowledge": result.get("prior_knowledge", {}),
        "thread_id": f"rec_{payload.transaction_id}_{uuid.uuid4().hex[:6]}",
    }


@router.get("/sessions")
def list_sessions() -> dict[str, Any]:
    return {"live": cdp_recorder.list_sessions(),
            "history": db.query(
                "SELECT * FROM recording_sessions ORDER BY started_at DESC LIMIT 50")}


@router.get("/{session_uid}/status")
def session_status(session_uid: str) -> dict[str, Any]:
    result = recorder_agent(action="status", session_uid=session_uid)
    if not result.ok:
        raise HTTPException(404, f"session {session_uid} not found")
    return result.get("info", {})


@router.post("/{session_uid}/crawl")
def force_crawl(session_uid: str) -> dict[str, Any]:
    result = recorder_agent(action="crawl", session_uid=session_uid)
    if not result.ok:
        raise HTTPException(404, f"session {session_uid} not found")
    return result.get("stats", {})


@router.post("/{session_uid}/stop")
def stop_recording(session_uid: str) -> dict[str, Any]:
    result = recorder_agent(action="stop", session_uid=session_uid)
    if not result.ok:
        raise HTTPException(400, result.get("error", "could not stop"))
    manifest = result["manifest"]
    return {
        "manifest": {k: v for k, v in manifest.items()
                     if k not in ("elements", "actions")},
        "stats": manifest.get("stats", {}),
        "elements_preview": manifest.get("elements", [])[:100],
        "actions": manifest.get("actions", []),
        "awaiting_decision": True,
        "message": "Review the capture, then Keep or Discard. Nothing reaches "
                   "the framework until you keep it.",
    }


@router.post("/decide")
def keep_or_discard(payload: KeepDiscardRequest) -> dict[str, Any]:
    """Human-in-the-loop gate (Section 5.11 / 17)."""
    if payload.decision == "discard":
        result = recorder_agent(action="discard", session_uid=payload.session_uid,
                                reason=payload.reason)
        return {"decision": "discard", "ok": result.ok}

    persisted = recorder_agent(action="persist", session_uid=payload.session_uid)
    if not persisted.ok:
        raise HTTPException(500, persisted.get("error", "could not persist"))

    response: dict[str, Any] = {
        "decision": "keep",
        "transaction_id": persisted["transaction_id"],
        "version": persisted["version"],
        "stats": persisted.get("stats", {}),
        "fields": persisted.get("fields", []),
    }
    if payload.generate_code:
        job_id = jobs.submit(
            "codegen", _generate_and_compile,
            transaction_id=persisted["transaction_id"],
        )
        response["codegen_job"] = job_id
    return response


def _generate_and_compile(transaction_id: str) -> dict[str, Any]:
    from ..agents import codegen_agent, compilation_agent
    generated = codegen_agent(transaction_id=transaction_id)
    hub.publish("recorder", {"type": "codegen", "ok": generated.ok,
                             "files": generated.get("files", {})})
    compiled = compilation_agent(transaction_id=transaction_id)
    hub.publish("recorder", {"type": "compile", "ok": compiled.ok,
                             "summary": compiled.get("result", {}).get("summary")})
    return {"generated": dict(generated), "compiled": dict(compiled)}


@router.websocket("/live")
async def recorder_feed(websocket: WebSocket) -> None:
    await hub.connect("recorder", websocket)
    try:
        while True:
            await websocket.receive_text()
    except WebSocketDisconnect:
        hub.disconnect("recorder", websocket)


# ── transaction library (Screen 2) ──────────────────────────────────────
@library.get("")
def list_transactions(status: str | None = None,
                      type: str | None = None) -> list[dict[str, Any]]:
    result = knowledge_agent(action="list", status=status, type=type)
    return result.get("transactions", [])


@library.get("/{transaction_id}")
def get_transaction(transaction_id: str) -> dict[str, Any]:
    txn = repo.get_transaction(transaction_id)
    if not txn:
        raise HTTPException(404, f"transaction {transaction_id} not found")
    transaction_pk = int(txn["id"])
    return {
        "transaction": txn,
        "versions": versioning.history(transaction_id),
        "elements": repo.get_elements(transaction_pk),
        "actions": repo.get_actions(transaction_pk),
        "validations": repo.get_validation_rules(transaction_pk),
        "knowledge": knowledge_agent(action="check",
                                     transaction_id=transaction_id),
    }


@library.get("/{transaction_id}/versions")
def transaction_versions(transaction_id: str) -> list[dict[str, Any]]:
    return versioning.history(transaction_id)


@library.get("/{transaction_id}/diff")
def transaction_diff(transaction_id: str, from_version: str,
                     to_version: str) -> dict[str, Any]:
    return versioning.version_diff(transaction_id, from_version, to_version)


@library.post("/{transaction_id}/promote")
def promote_version(transaction_id: str, version: str) -> Ack:
    versioning.promote(transaction_id, version)
    return Ack(message=f"{transaction_id} v{version} is now active")


@library.post("/{transaction_id}/regenerate")
def regenerate(transaction_id: str) -> dict[str, Any]:
    job_id = jobs.submit("codegen", _generate_and_compile,
                         transaction_id=transaction_id)
    return {"job": job_id}


@library.post("/{transaction_id}/elements/{element_key}/locator")
def add_manual_locator(
    transaction_id: str, element_key: str, payload: ManualLocatorRequest
) -> dict[str, Any]:
    """Attach a locator to an element — creating the element (and a
    matching recorded action, so codegen actually generates a step for
    it) if the recorder never captured it at all.

    For elements the automated crawl never triggered (hidden behind a
    toggle/icon, dynamically inserted, etc.) — paste in a locator
    inspected directly from DevTools instead of re-recording the whole
    transaction. Added at top priority, ahead of whatever the recorder
    did capture; existing fallback locators are kept, not replaced.
    Automatically regenerates + recompiles so it's live on the next
    execution.
    """
    try:
        result = repo.add_manual_locator(
            transaction_id, element_key, payload.strategy, payload.value,
            priority=payload.priority, tag=payload.tag,
            element_type=payload.element_type, label=payload.label,
            page_key=payload.page_key, action=payload.action,
        )
    except ValueError as exc:
        raise HTTPException(404, str(exc))
    job_id = jobs.submit("codegen", _generate_and_compile,
                         transaction_id=transaction_id)
    return {**result, "regenerate_job": job_id}


@library.delete("/{transaction_id}/version/{version}")
def delete_version(transaction_id: str, version: str) -> Ack:
    txn = repo.get_transaction(transaction_id, version)
    if not txn:
        raise HTTPException(404, "version not found")
    if txn["status"] == "active":
        raise HTTPException(400, "cannot delete the active version — promote "
                                 "another version first")
    db.execute("DELETE FROM transactions WHERE id=%s", (txn["id"],))
    return Ack(message=f"{transaction_id} v{version} deleted")
