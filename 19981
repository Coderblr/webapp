"""
excel_executor.py

Reads the execution.xlsx dataset (via storage/excel_store.py) and exposes
it as an ordered list of plain-dict "step" rows for the executor loop.
This is the top of the "Excel -> Pandas -> Selenium -> Execute action"
pipeline described in spec section 2/19: the normal execution path never
touches the full locator repository unless a locator fails.
"""
from __future__ import annotations

from pathlib import Path
from typing import Any, Dict, List

from backend.storage.excel_store import ExcelStore
from backend.storage.models import parse_frame_path

_TRUTHY_OPTIONAL_VALUES = {"y", "yes", "true", "1", "optional"}


def _parse_optional_flag(value: Any) -> bool:
    """A step is optional if its Optional_Step cell holds any of the usual
    human-typed "yes" spellings - blank/"N"/"no"/"false"/"0" (and anything
    else) means a normal, non-optional step, matching the existing
    Excel-is-plain-text convention used by every other column here."""
    return str(value).strip().lower() in _TRUTHY_OPTIONAL_VALUES


def _parse_disabled_flag(value: Any) -> bool:
    """Same "Y/yes/true/1" convention as Optional_Step, but a distinct
    column/meaning: Disabled means change_detection determined (and the
    user confirmed) that this step's element was REMOVED from the
    application per a BRD/Solution Document update - the executor should
    not even attempt the locator, not just give it a short timeout before
    giving up (that's what Optional_Step is for). See
    Executor._run_step()."""
    return str(value).strip().lower() in _TRUTHY_OPTIONAL_VALUES


class ExcelExecutor:
    def __init__(self, excel_path: Path):
        self.excel_path = excel_path
        self.store = ExcelStore(excel_path)

    def load_steps(self) -> List[Dict[str, Any]]:
        rows = self.store.read_rows()
        steps = []
        for row in rows:
            steps.append({
                "step_number": int(row.get("Step_Number", 0) or 0),
                "action": row.get("Action", ""),
                "page_url": row.get("Page_URL", ""),
                "page_title": row.get("Page_Title", ""),
                "element_name": row.get("Element_Name", ""),
                "element_text": row.get("Element_Text", ""),
                "element_tag": row.get("Element_Tag", ""),
                "primary_locator_type": row.get("Primary_Locator_Type", ""),
                "primary_locator": row.get("Primary_Locator", ""),
                "fallback_locators": self._parse_fallbacks(row),
                "value": row.get("Value", ""),
                "test_data_key": row.get("Test_Data_Key", ""),
                "captured_as": row.get("Captured_As", ""),
                "resolved_var": row.get("Resolved_Variable", ""),
                "frame_path": parse_frame_path(row.get("Frame_Path", "")),
                "window_context": row.get("Window_Context", ""),
                "modal_context": row.get("Modal_Context", ""),
                "wait_condition": row.get("Wait_Condition", ""),
                "select_option_text": row.get("Select_Option_Text", ""),
                "optional": _parse_optional_flag(row.get("Optional_Step", "")),
                "expected_result": row.get("Expected_Result", ""),
                "screenshot": row.get("Screenshot", ""),
                "disabled": _parse_disabled_flag(row.get("Disabled", "")),
                "disabled_reason": row.get("Disabled_Reason", ""),
                "change_status": row.get("Change_Status", "") or "UNCHANGED",
                "change_set_id": row.get("Change_Set_Id", ""),
            })
        return steps

    @staticmethod
    def _parse_fallbacks(row: Dict[str, Any]) -> List[Dict[str, str]]:
        out = []
        for col in ("Fallback_Locator_1", "Fallback_Locator_2", "Fallback_Locator_3"):
            raw = row.get(col, "")
            if raw and "::" in str(raw):
                t, v = str(raw).split("::", 1)
                if t and v:
                    out.append({"type": t, "value": v})
        return out

    def update_locator(self, step_number: int, new_type: str, new_value: str) -> bool:
        return self.store.update_locator(step_number, new_type, new_value)
