@app.post("/api/executions/{execution_id}/terminate")
def terminate_execution(execution_id: str, request: Request) -> Dict[str, Any]:
    state = ExecutionManager.get(execution_id)
    if not state:
        raise HTTPException(404, "Execution not found")
    if state["status"] != "running":
        return {"terminated": False, "message": f"Execution already {state['status']}; nothing to stop."}
    ExecutionManager.terminate(execution_id)
    user = request.state.user
    activity_log.record(user.user_id, user.username, "terminate_execution", details={"execution_id": execution_id})
    return {"terminated": True, "message": "Stop requested - remaining steps will be skipped."}


@app.websocket("/ws/execution/{execution_id}")
async def execution_progress_ws(websocket: WebSocket, execution_id: str):
    # Same reasoning as recording_events_ws above - AuthMiddleware doesn't
    # cover WebSocket scopes, so check the cookie by hand here too.
    user = user_from_cookies(websocket.cookies)
    if not user:
        await websocket.close(code=4401)
        return
    await websocket.accept()
    state = ExecutionManager.get(execution_id)
    if not state:
        await websocket.send_json({"type": "error", "message": "Execution not found"})
        await websocket.close()
        return
    q: "queue.Queue" = state["queue"]
    try:
        while True:
            try:
                evt = q.get_nowait()
                await websocket.send_json(evt)
                if evt.get("type") == "done":
                    break
            except queue.Empty:
                await asyncio.sleep(0.3)
    except WebSocketDisconnect:
        pass


