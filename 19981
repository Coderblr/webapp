_DOWNLOADABLE = {
    "excel": lambda p: p.execution_excel,
    "feature": lambda p: p.feature_file,
    "locator_repository": lambda p: p.locator_repo_file,
    "metadata": lambda p: p.metadata_file,
}


@app.get("/api/recordings/{recording_id}/download/{artifact}")
def download_artifact(recording_id: str, artifact: str):
    paths = recording_store.paths(recording_id)
    if artifact in _DOWNLOADABLE:
        file_path = _DOWNLOADABLE[artifact](paths)
        if not file_path.exists():
            raise HTTPException(404, f"{artifact} not generated yet")
        return FileResponse(str(file_path), filename=file_path.name)
    if artifact == "page_objects":
        return _zip_dir(paths.pages_dir, f"{recording_id}_page_objects.zip")
    if artifact == "step_definitions":
        return _zip_dir(paths.steps_dir, f"{recording_id}_step_definitions.zip")
    if artifact == "logs":
        return _zip_dir(settings.LOGS_DIR, f"{recording_id}_logs.zip")
    if artifact == "reports":
        return _zip_dir(paths.reports_dir, f"{recording_id}_reports.zip")
    raise HTTPException(404, "Unknown artifact type")


def _zip_dir(directory: Path, download_name: str):
    import shutil
    import tempfile

    has_content = directory.exists() and any(
        p.is_file() and p.name != "__init__.py" for p in directory.rglob("*")
    )
    if not has_content:
        raise HTTPException(404, "Nothing generated yet")
    tmp = Path(tempfile.mkdtemp()) / download_name.replace(".zip", "")
    archive_path = shutil.make_archive(str(tmp), "zip", root_dir=str(directory))
    return FileResponse(archive_path, filename=download_name)


