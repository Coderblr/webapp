package com.sbi.automation.utils;

import java.io.InputStream;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.Socket;
import java.nio.charset.StandardCharsets;

/**
 * Java-side CBS teller reset (Section 11.4).
 *
 * The authoritative reset is fired by the Python Execution Agent's cleanup
 * node, which always runs.  This class is the belt-and-braces fallback for
 * when a runner is launched manually, outside the platform.
 *
 * The reset string is never hard-coded — it arrives through the environment
 * from the encrypted secret store.
 */
public final class SocketResetClient {

    private SocketResetClient() { }

    public static boolean resetTeller(String host, int port, String resetString,
                                      String tellerId, int timeoutSeconds) {
        if (host == null || host.isEmpty() || port <= 0
                || resetString == null || resetString.isEmpty()) {
            // Under the platform this is the NORMAL path — Python's
            // ExecutionPipeline.teller_reset() is the authoritative,
            // guaranteed reset and never populates SBI_CBS_HOST/PORT/
            // RESET_STRING for the Java process. Recording a step here
            // used to add a confusing, always-"skipped" duplicate
            // "CBS teller reset" row right next to the real one in every
            // report. Only genuinely-attempted (standalone-mode) resets
            // get recorded below.
            return false;
        }
        String payload = resetString
                .replace("{TELLER_ID}", tellerId == null ? "" : tellerId)
                .replace("{TELLERID}", tellerId == null ? "" : tellerId);
        long started = System.currentTimeMillis();
        try (Socket socket = new Socket()) {
            socket.connect(new InetSocketAddress(host, port), timeoutSeconds * 1000);
            socket.setSoTimeout(timeoutSeconds * 1000);
            try (OutputStream out = socket.getOutputStream();
                 InputStream in = socket.getInputStream()) {
                out.write((payload.endsWith("\n") ? payload : payload + "\n")
                        .getBytes(StandardCharsets.UTF_8));
                out.flush();
                byte[] buffer = new byte[4096];
                int read = in.read(buffer);
                String response = read > 0
                        ? new String(buffer, 0, read, StandardCharsets.UTF_8).trim() : "";
                boolean ok = response.toUpperCase().contains("SUCCESS")
                        || response.toUpperCase().contains("OK")
                        || response.toUpperCase().contains("RESET");
                ExecutionContext.recordStep("teller_reset", "CBS teller reset",
                        ok ? "passed" : "failed",
                        System.currentTimeMillis() - started, "",
                        ok ? null : "CBS response: " + response);
                return ok;
            }
        } catch (Exception e) {
            ExecutionContext.recordStep("teller_reset", "CBS teller reset", "failed",
                    System.currentTimeMillis() - started, "", e.toString());
            return false;
        }
    }

    /** Never throws — safe to call from a finally block. */
    public static void resetTellerQuietly() {
        try {
            String host = System.getenv("SBI_CBS_HOST");
            String portValue = System.getenv("SBI_CBS_PORT");
            String resetString = System.getenv("SBI_CBS_RESET_STRING");
            String tellerId = System.getenv("SBI_TELLER_ID");
            int port = 0;
            if (portValue != null && !portValue.isEmpty()) {
                port = Integer.parseInt(portValue.trim());
            }
            resetTeller(host, port, resetString, tellerId, 30);
        } catch (Throwable ignored) {
            // cleanup must never mask the real failure
        }
    }
}
