export function Button({ children, variant = "primary", className = "", ...rest }) {
  const base =
    "inline-flex items-center justify-center gap-2 rounded-sm px-4 py-2 text-sm font-medium transition-colors duration-150 disabled:cursor-not-allowed disabled:opacity-40";
  const variants = {
    primary: "bg-brand-blue text-white hover:bg-brand-blueDark",
    secondary: "border border-line bg-panel text-ink hover:border-brand-blue",
    ghost: "text-signal-slate hover:text-ink underline decoration-line underline-offset-4",
  };
  return (
    <button className={`${base} ${variants[variant]} ${className}`} {...rest}>
      {children}
    </button>
  );
}

export function TextInput({ className = "", ...rest }) {
  return (
    <input
      className={`w-full rounded-sm border border-line bg-panel px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-brand-blue ${className}`}
      {...rest}
    />
  );
}

export function Select({ className = "", children, ...rest }) {
  return (
    <select
      className={`w-full rounded-sm border border-line bg-panel px-3 py-2 text-sm text-ink focus:border-brand-blue ${className}`}
      {...rest}
    >
      {children}
    </select>
  );
}

export function Field({ label, hint, children }) {
  return (
    <label className="block">
      <span className="mb-1.5 block text-sm font-medium text-ink">{label}</span>
      {children}
      {hint && <span className="mt-1 block text-xs text-muted">{hint}</span>}
    </label>
  );
}

export function Checkbox({ label, checked, onChange }) {
  return (
    <label className="flex cursor-pointer select-none items-center gap-2 text-sm text-ink">
      <input
        type="checkbox"
        checked={checked}
        onChange={(e) => onChange(e.target.checked)}
        className="h-4 w-4 rounded-sm border border-line accent-[#163C8C]"
      />
      {label}
    </label>
  );
}

export function Panel({ children, className = "" }) {
  return (
    <div className={`min-w-0 rounded-sm border border-line bg-panel shadow-crisp ${className}`}>{children}</div>
  );
}

export function PanelHeader({ title, caption }) {
  return (
    <div className="border-b border-line px-5 py-4">
      <h2 className="text-sm font-semibold tracking-tight text-ink">{title}</h2>
      {caption && <p className="mt-0.5 text-xs text-muted">{caption}</p>}
    </div>
  );
}

export function Callout({ tone = "info", children }) {
  const tones = {
    info: "border-line bg-rail text-slate-700",
    error: "border-signal-rust/30 bg-[#FBEEEA] text-signal-rust",
    success: "border-signal-teal/30 bg-[#EAF5F2] text-signal-tealDark",
  };
  return (
    <div className={`rounded-sm border px-3 py-2.5 text-sm ${tones[tone]}`} role="status">
      {children}
    </div>
  );
}

export function Metric({ label, value }) {
  return (
    <div className="border border-line bg-panel px-4 py-3">
      <div className="font-mono text-2xl font-semibold text-ink">{value}</div>
      <div className="mt-1 text-xs uppercase tracking-wide text-muted">{label}</div>
    </div>
  );
}

export function StatusBadge({ status }) {
  const ok = status === "Success" || status === "Passed";
  const failed = status === "Failed";
  const classes = ok
    ? "bg-[#EAF5F2] text-signal-tealDark border-signal-teal/30"
    : failed
      ? "bg-[#FBEEEA] text-signal-rust border-signal-rust/30"
      : "bg-rail text-slate-700 border-line";
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-sm border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${classes}`}>
      <span className={`h-1.5 w-1.5 rounded-full ${ok ? "bg-signal-teal" : failed ? "bg-signal-rust" : "bg-muted"}`} />
      {status}
    </span>
  );
}

export function Spinner({ label }) {
  return (
    <div className="flex items-center gap-2 text-sm text-muted">
      <span className="pulse-dot h-2 w-2 rounded-full bg-signal-amber" />
      {label}
    </div>
  );
}

export function Disclosure({ title, children, defaultOpen = false }) {
  return (
    <details className="group border border-line" open={defaultOpen}>
      <summary className="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-medium text-ink hover:bg-rail">
        {title}
        <span className="text-muted transition-transform group-open:rotate-180">⌄</span>
      </summary>
      <div className="border-t border-line px-4 py-3">{children}</div>
    </details>
  );
}

export function DataTable({ columns, rows }) {
  if (rows.length === 0) {
    return <p className="px-1 py-3 text-sm text-muted">Nothing to show yet.</p>;
  }
  return (
    <div className="w-full min-w-0 max-h-96 overflow-auto rounded-sm border border-line scroll-thin">
      <table className="w-full min-w-[36rem] border-collapse text-left text-sm">
        <thead className="sticky top-0 bg-rail">
          <tr>
            {columns.map((c) => (
              <th key={c.key} className="whitespace-nowrap px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600">
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr key={i} className="border-t border-line odd:bg-panel even:bg-[#FBFDFF]">
              {columns.map((c) => (
                <td
                  key={c.key}
                  className={`max-w-xs break-words px-3 py-2 align-top ${c.mono ? "font-mono text-[13px]" : ""}`}
                >
                  {row[c.key]}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
