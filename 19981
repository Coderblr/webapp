"""Login / logout page.

SEED page object:
the locators below are placeholders that the Locator Agent overwrites the
first time transaction 9750 is recorded against the real SBI environment.
Recording once replaces every guess here.
"""
from __future__ import annotations

from selenium.webdriver.common.by import By
from selenium.webdriver.remote.webdriver import WebDriver

from core.base_page import BasePage
from core.config_reader import get as config_get
from utils import locator_repository as locator_repo

USER_ID = "login::user_id"
PASSWORD = "login::password"
SUBMIT = "login::submit"
LOGOUT = "login::logout"
CHANGE_PASSWORD_TITLE = "login::change_password_title"


class LoginPage(BasePage):
    def __init__(self, driver: WebDriver):
        super().__init__(driver)
        self._register_locators()

    def _register_locators(self) -> None:
        if locator_repo.contains(USER_ID):
            return
        # Real locators confirmed from com.nbc.pages.common.LoginPage.java
        # (the actual production NBC framework) — put FIRST/highest
        # priority; the old guessed fallbacks stay in the list below them
        # in case a future UI change moves away from these exact ones.
        locator_repo.register(USER_ID, [
            (By.NAME, "loginId"),
            (By.ID, "userId"), (By.NAME, "username"),
            (By.CSS_SELECTOR, "input[type='text']"),
            (By.XPATH, "//label[contains(.,'User')]/following::input[1]"),
        ])
        locator_repo.register(PASSWORD, [
            (By.NAME, "password"),
            (By.ID, "password"),
            (By.CSS_SELECTOR, "input[type='password']"),
            (By.XPATH, "//label[contains(.,'Password')]/following::input[1]"),
        ])
        locator_repo.register(SUBMIT, [
            (By.ID, "login_button"),
            (By.ID, "loginBtn"), (By.NAME, "login"),
            (By.CSS_SELECTOR, "button[type='submit']"),
            (By.XPATH, "//button[contains(.,'Login') or contains(.,'Sign')]"),
            (By.XPATH, "//input[@type='submit']"),
        ])
        locator_repo.register(LOGOUT, [
            (By.ID, "logout"), (By.LINK_TEXT, "Logout"), (By.LINK_TEXT, "Sign Out"),
            (By.XPATH, "//a[contains(.,'Logout') or contains(.,'Sign Out')]"),
        ])
        locator_repo.register(CHANGE_PASSWORD_TITLE, [
            (By.ID, "changePassword"),
            (By.XPATH, "//*[contains(.,'Change Password')]"),
        ])

    def open(self, url: str | None) -> "LoginPage":
        target = url if url else config_get("app.url", "")
        if target:
            self.driver.get(target)
        self.wait_for_page()
        self._wait_for_login_form_rendered()
        return self

    def _wait_for_login_form_rendered(self, timeout: float = 20.0) -> None:
        """`wait_for_page()` only checks `document.readyState == "complete"`
        — satisfied the instant the base HTML/JS shell finishes loading,
        which for a HASH-ROUTED single-page app (this login URL ends in
        `#!` — confirmed real-world evidence: `.../login_cbs.action#!`)
        happens WELL BEFORE the client-side JS router has actually
        rendered the login FORM into the DOM. `readyState` says "done"
        almost immediately; the actual username/password fields don't
        exist yet for a few more moments while the SPA finishes its own
        routing/rendering pass. Interacting (or even just resolving a
        locator for) the username field before that finishes is exactly
        what an empty page TITLE alongside a "Locator failure:
        login::user_id" on the correct URL indicates — the shell loaded,
        the SPA hasn't rendered its content into it yet.

        Waits here for the username field to become genuinely FINDABLE
        before `open()` returns, so every caller (the login step itself,
        and the pre-scenario recovery navigation in environment.py)
        gets a page that's actually ready, not just one whose initial
        HTTP response finished.

        Deliberately does NOT call `self._find()` in this polling loop —
        `_find()`/`element_resolver.resolve()` itself waits up to
        `long_wait` (30s) per attempt when nothing matches, which
        combined with a retry loop here would badly overshoot this
        method's own `timeout`. Checking each registered candidate
        directly via `find_elements()` (plural — returns an empty list
        immediately rather than waiting) keeps every poll fast, so the
        actual time spent here stays close to the intended timeout.
        """
        import time as _time
        from utils import locator_repository as _locator_repo

        candidates = _locator_repo.get(USER_ID) or []
        deadline = _time.time() + timeout
        while _time.time() < deadline:
            for strategy, value in candidates:
                try:
                    if self.driver.find_elements(strategy, value):
                        return
                except Exception:
                    continue
            _time.sleep(0.3)
        # Never hard-fail the settle-wait itself — login_as()'s own
        # locator resolution (with its own full wait budget) is still
        # the real, authoritative attempt; this is just giving it the
        # best possible starting point.

    def login_as(self, user_id: str, password: str) -> "LoginPage":
        self.type(USER_ID, user_id)
        self.type(PASSWORD, password)
        self.click(SUBMIT)
        self.wait_for_page()
        return self

    def is_password_change_screen_visible(self) -> bool:
        """True while the forced Change Password window (transaction 9750) is open."""
        return self.is_text_present("Change Password") or self.is_text_present("change password")

    def logout(self) -> None:
        if self.exists(LOGOUT):
            self.click(LOGOUT)
            self.wait_for_page()
            self.recover_from_security_breach_if_present()

    def is_logged_in(self) -> bool:
        """True once a session is already active (the Logout link/button is
        present) — used to avoid re-submitting login credentials into a
        session that's already open."""
        return self.exists(LOGOUT)
