# ----------------------------------------------------------------------
# Frontend static hosting
# ----------------------------------------------------------------------
# NoCacheStaticFiles: plain StaticFiles sends no Cache-Control header at
# all, which leaves browsers free to apply their own heuristic caching to
# index.html/app.js/styles.css - in practice this means editing a frontend
# file on disk and reloading the page can silently keep serving the old
# cached copy from the browser's disk cache (no request even reaches this
# server), which is exactly the "I changed the code but nothing changed on
# screen" symptom. Force every static response to always be revalidated so
# a plain reload always reflects whatever is on disk right now.
class NoCacheStaticFiles(StaticFiles):
    async def get_response(self, path: str, scope):
        response = await super().get_response(path, scope)
        # Next.js's static export puts every built JS/CSS chunk under
        # _next/static/ with a content hash baked into the filename (e.g.
        # _next/static/chunks/app/page-a1b2c3.js) - a new build never
        # reuses an old filename, so these specific assets are safe (and
        # meant) to cache aggressively forever. Everything else (the HTML
        # pages themselves, favicon, etc.) keeps the no-cache behavior
        # above, so editing frontend code and rebuilding is always
        # reflected on the next reload rather than served from a stale
        # browser cache.
        if "/_next/static/" in path:
            response.headers["Cache-Control"] = "public, max-age=31536000, immutable"
        else:
            response.headers["Cache-Control"] = "no-cache, no-store, must-revalidate"
            response.headers["Pragma"] = "no-cache"
            response.headers["Expires"] = "0"
        return response


# IMPORTANT: this mount must be registered LAST. Starlette matches routes
# in registration order, and a mount at "/" is a catch-all prefix match -
# if it were registered before the /api/* routes above, every API request
# would be swallowed by StaticFiles (returning 404 for any path that
# isn't a literal file on disk) instead of ever reaching our handlers.
if settings.FRONTEND_DIR.exists():
    app.mount("/", NoCacheStaticFiles(directory=str(settings.FRONTEND_DIR), html=True), name="frontend")
