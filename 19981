"""
POST /api/auth/login            - username + password -> JWT
POST /api/auth/change-password  - temp/current password -> new password (also clears must_change_password)
POST /api/auth/logout           - revokes the current session
GET  /api/auth/me               - current user's profile (also counts as activity, refreshing the idle timer)

SSO (not implemented yet - see auth/config.py + auth/providers.py for the
integration plan; these three exist now purely as stable, documented
plumbing so only auth/providers.py:authenticate_sso needs writing later):
GET  /api/auth/sso/status        - lets the frontend know whether to show/enable the SSO button
GET  /api/auth/sso/login         - would redirect the browser to the IdP
GET|POST /api/auth/sso/callback  - the IdP's redirect-back target
"""
from __future__ import annotations

from fastapi import APIRouter, Depends, HTTPException, Request, status
from fastapi.responses import RedirectResponse

from database.db import get_session
from database import repository as repo
from database.models import User
from auth.providers import authenticate_local
from auth.security import hash_password, verify_password, validate_password_strength
from auth.jwt_utils import create_access_token
from auth.dependencies import get_current_user, get_client_ip, CurrentUser
from auth.config import SESSION_MAX_HOURS, AUTH_PROVIDER, FRONTEND_URL
from auth.schemas import LoginRequest, LoginResponse, ChangePasswordRequest, UserOut

router = APIRouter(prefix="/api/auth", tags=["auth"])


def _user_out(user: User) -> UserOut:
    return UserOut.model_validate(user)


def _issue_session_and_token(db, user: User, ip: str, user_agent: str, action: str) -> LoginResponse:
    """Shared by every auth path (local password today; SSO once
    auth/providers.py:authenticate_sso is implemented) - creates the
    UserSession + JWT the exact same way regardless of how the user was
    authenticated, so nothing about session handling, the idle timeout, or
    the admin "who's online" view needs to change when SSO is added.
    `action` is just which activity-log action to record (e.g. "LOGIN" vs
    a future "SSO_LOGIN")."""
    sess = repo.create_session(db, user.user_id, ip, user_agent, SESSION_MAX_HOURS)
    repo.mark_login(db, user.user_id)
    token = create_access_token(user_id=user.user_id, username=user.username, role=user.role, session_id=sess.session_id)
    repo.log_activity(
        db, user_id=user.user_id, session_id=sess.session_id, action=action, status="SUCCESS",
        endpoint=f"/api/auth/{'sso/callback' if action != 'LOGIN' else 'login'}", ip_address=ip,
    )
    return LoginResponse(access_token=token, must_change_password=user.must_change_password, user=_user_out(user))


@router.post("/login", response_model=LoginResponse)
def login(req: LoginRequest, request: Request):
    ip = get_client_ip(request)
    with get_session() as db:
        user = authenticate_local(db, req.username, req.password)
        if user is None:
            repo.log_activity(
                db, user_id=None, session_id=None, action="LOGIN_FAILED", status="FAILURE",
                details={"username": req.username}, endpoint="/api/auth/login", ip_address=ip,
            )
            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid username or password.")
        return _issue_session_and_token(db, user, ip, request.headers.get("user-agent"), action="LOGIN")


@router.post("/change-password")
def change_password(req: ChangePasswordRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    ip = get_client_ip(request)
    with get_session() as db:
        user = repo.get_user(db, current_user.user_id)
        if user is None:
            raise HTTPException(status_code=404, detail="User not found.")

        if not verify_password(req.current_password, user.password_hash or ""):
            repo.log_activity(
                db, user_id=user.user_id, session_id=current_user.session_id, action="PASSWORD_CHANGE_FAILED",
                status="FAILURE", endpoint="/api/auth/change-password", ip_address=ip,
            )
            raise HTTPException(status_code=400, detail="Current/temporary password is incorrect.")

        error = validate_password_strength(req.new_password)
        if error:
            raise HTTPException(status_code=400, detail=error)
        if req.new_password == req.current_password:
            raise HTTPException(status_code=400, detail="New password must be different from the current password.")

        repo.set_user_password(db, user.user_id, hash_password(req.new_password), must_change_password=False)
        repo.log_activity(
            db, user_id=user.user_id, session_id=current_user.session_id, action="PASSWORD_CHANGED",
            status="SUCCESS", endpoint="/api/auth/change-password", ip_address=ip,
        )
        return {"ok": True, "message": "Password changed successfully."}


@router.post("/logout")
def logout(request: Request, current_user: CurrentUser = Depends(get_current_user)):
    ip = get_client_ip(request)
    with get_session() as db:
        repo.revoke_session(db, current_user.session_id, reason="logout")
        repo.log_activity(
            db, user_id=current_user.user_id, session_id=current_user.session_id, action="LOGOUT",
            status="SUCCESS", endpoint="/api/auth/logout", ip_address=ip,
        )
    return {"ok": True}


@router.get("/me", response_model=UserOut)
def me(current_user: CurrentUser = Depends(get_current_user)):
    with get_session() as db:
        user = repo.get_user(db, current_user.user_id)
        if user is None:
            raise HTTPException(status_code=404, detail="User not found.")
        return _user_out(user)


