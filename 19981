"""Checkpointing so every workflow is resumable (Section 10).

If an execution stops halfway, it resumes from the last successful
checkpoint rather than restarting from scratch.  A file-backed SQLite
checkpoint store is used when available (durable across restarts);
otherwise an in-memory saver keeps the process working for that session.
"""
from __future__ import annotations

from typing import Any, Optional

from ..core.config import settings
from ..core.logging_conf import get_logger

log = get_logger(__name__)

_saver: Optional[Any] = None


def get_checkpointer() -> Any:
    global _saver
    if _saver is not None:
        return _saver
    try:
        from langgraph.checkpoint.sqlite import SqliteSaver
        checkpoint_path = str(settings.sqlite_db_path.with_name("checkpoints.db"))
        _saver = SqliteSaver.from_conn_string(checkpoint_path)
        # from_conn_string may return a context manager depending on version
        if hasattr(_saver, "__enter__"):
            _saver = _saver.__enter__()
        _saver.setup()
        log.info("LangGraph checkpointer: SQLite (%s)", checkpoint_path)
        return _saver
    except Exception as exc:  # noqa: BLE001
        log.warning("SQLite checkpointer unavailable (%s) — using memory saver", exc)
    from langgraph.checkpoint.memory import MemorySaver
    _saver = MemorySaver()
    return _saver


def config_for(thread_id: str, **extra: Any) -> dict[str, Any]:
    return {"configurable": {"thread_id": thread_id, **extra}}


def get_state(graph: Any, thread_id: str) -> dict[str, Any]:
    try:
        snapshot = graph.get_state(config_for(thread_id))
        return {
            "values": snapshot.values,
            "next": list(snapshot.next or ()),
            "created_at": getattr(snapshot, "created_at", None),
        }
    except Exception as exc:  # noqa: BLE001
        return {"error": str(exc)}


def resume(graph: Any, thread_id: str, update: dict[str, Any] | None = None) -> Any:
    """Resume an interrupted workflow, optionally applying a human decision."""
    config = config_for(thread_id)
    if update:
        graph.update_state(config, update)
    return graph.invoke(None, config)
