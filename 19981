"""
Shared data models for the platform.

These dataclasses are the contract every other module (recorder, generator,
execution, healing, reporting) builds on. Keeping them centralized is what
lets Layer A (locator repository) and Layer B (execution dataset) stay
logically separate while still referencing the same underlying concepts.

Nothing here is application-specific: no field is named after a business
concept (no "account_number", no "login_button"). Everything is generic
DOM/action vocabulary.
"""
from __future__ import annotations

import time
import uuid
from dataclasses import dataclass, field, asdict
from enum import Enum
from typing import Any, Dict, List, Optional


def new_id(prefix: str = "") -> str:
    suffix = uuid.uuid4().hex[:12]
    return f"{prefix}{suffix}" if prefix else suffix


def now_ts() -> float:
    return time.time()


# --------------------------------------------------------------------------
# Action vocabulary (Layer B - user execution recording)
class StrValueEnum(str, Enum):
    """Base for every (str, Enum) in this module. Plain `class X(str, Enum)`
    still uses Enum.__str__ by default (-> "ActionType.CLICK" instead of
    "CLICK"), which silently corrupts anything that interpolates a member
    into an f-string/format spec (Excel cells, generated code, report
    text). Overriding __str__ to return the value fixes str(), f-strings,
    and format-spec interpolation all at once, while asdict()/json.dumps
    already worked correctly (they serialize str subclasses by value)."""

    def __str__(self) -> str:  # pragma: no cover - trivial
        return str(self.value)


# --------------------------------------------------------------------------
class ActionType(StrValueEnum):
    OPEN_URL = "OPEN_URL"
    CLICK = "CLICK"
    DOUBLE_CLICK = "DOUBLE_CLICK"
    RIGHT_CLICK = "RIGHT_CLICK"
    TYPE = "TYPE"
    CLEAR = "CLEAR"
    SELECT = "SELECT"
    CHECK = "CHECK"
    UNCHECK = "UNCHECK"
    HOVER = "HOVER"
    SCROLL = "SCROLL"
    PRESS_KEY = "PRESS_KEY"
    PRESS_ENTER = "PRESS_ENTER"
    PRESS_TAB = "PRESS_TAB"
    WAIT = "WAIT"
    SUBMIT = "SUBMIT"
    UPLOAD = "UPLOAD"
    SWITCH_FRAME = "SWITCH_FRAME"
    SWITCH_WINDOW = "SWITCH_WINDOW"
    NEW_TAB = "NEW_TAB"
    CLOSE_TAB = "CLOSE_TAB"
    NAVIGATE_BACK = "NAVIGATE_BACK"
    NAVIGATE_FORWARD = "NAVIGATE_FORWARD"
    CAPTURE = "CAPTURE"               # reads an element's CURRENT live value/text into a {{variable}}
                                       # for later reuse - see Capture -> Store -> Reuse in recorder.py


class LocatorStrategy(StrValueEnum):
    ID = "ID"
    NAME = "NAME"
    CSS = "CSS"
    XPATH = "XPATH"
    RELATIVE_XPATH = "RELATIVE_XPATH"
    LINK_TEXT = "LINK_TEXT"
    PARTIAL_LINK_TEXT = "PARTIAL_LINK_TEXT"
    ACCESSIBILITY = "ACCESSIBILITY"       # aria-label / role based
    TEXT = "TEXT"                         # visible text based
    DATA_TESTID = "DATA_TESTID"
    ATTRIBUTE = "ATTRIBUTE"               # generic data-* / custom attribute
    SHADOW_PATH = "SHADOW_PATH"           # shadow DOM traversal path


class ReliabilityLevel(StrValueEnum):
    HIGH = "HIGH"
    MEDIUM_HIGH = "MEDIUM_HIGH"
    MEDIUM = "MEDIUM"
    LOW = "LOW"


# Base reliability weight per strategy - used by locator_engine to score.
STRATEGY_BASE_RELIABILITY: Dict[str, float] = {
    LocatorStrategy.DATA_TESTID: 0.97,
    LocatorStrategy.ID: 0.95,
    LocatorStrategy.NAME: 0.85,
    LocatorStrategy.ACCESSIBILITY: 0.80,
    LocatorStrategy.CSS: 0.70,
    LocatorStrategy.LINK_TEXT: 0.65,
    LocatorStrategy.ATTRIBUTE: 0.60,
    LocatorStrategy.TEXT: 0.55,
    LocatorStrategy.PARTIAL_LINK_TEXT: 0.50,
    LocatorStrategy.RELATIVE_XPATH: 0.45,
    LocatorStrategy.XPATH: 0.30,
    LocatorStrategy.SHADOW_PATH: 0.40,
}


def reliability_level(score: float) -> str:
    if score >= 0.85:
        return ReliabilityLevel.HIGH
    if score >= 0.65:
        return ReliabilityLevel.MEDIUM_HIGH
    if score >= 0.45:
        return ReliabilityLevel.MEDIUM
    return ReliabilityLevel.LOW


# --------------------------------------------------------------------------
# Layer A: Locator / DOM knowledge repository models
# --------------------------------------------------------------------------
@dataclass
class LocatorCandidate:
    strategy: str
    value: str
    reliability_score: float = 0.0
    reliability_level: str = ReliabilityLevel.LOW

    def __post_init__(self):
        # Normalize to a plain string value even if a LocatorStrategy enum
        # member was passed in - `class X(str, Enum)` members still use
        # Enum.__str__ (-> "LocatorStrategy.ID") unless coerced explicitly,
        # which would otherwise leak into Excel cells, JSON, and generated
        # Page Object locator dicts.
        if isinstance(self.strategy, LocatorStrategy):
            self.strategy = self.strategy.value
        else:
            self.strategy = str(self.strategy)

        if not self.reliability_score:
            self.reliability_score = STRATEGY_BASE_RELIABILITY.get(self.strategy, 0.4)
        level = reliability_level(self.reliability_score)
        self.reliability_level = level.value if isinstance(level, ReliabilityLevel) else str(level)

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


@dataclass
class FramePath:
    """Describes the full iframe nesting path required to reach an element."""
    path: List[Dict[str, Any]] = field(default_factory=list)  # each: {frame_locator, frame_index, id, name}
    nested_depth: int = 0

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)

    @property
    def is_top_level(self) -> bool:
        return self.nested_depth == 0 or not self.path


@dataclass
class ShadowPath:
    """Describes a shadow DOM traversal path (list of host selectors)."""
    hosts: List[str] = field(default_factory=list)
    final_selector: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)

    @property
    def is_shadow(self) -> bool:
        return bool(self.hosts)


@dataclass
class ElementRecord:
    element_id: str
    page_id: str
    dom_signature: str
    tag: str
    attributes: Dict[str, Any] = field(default_factory=dict)
    text: str = ""
    role: str = ""
    visible: bool = True
    enabled: bool = True
    interactable: bool = True
    bounding_box: Dict[str, float] = field(default_factory=dict)
    parent_signature: str = ""
    child_signatures: List[str] = field(default_factory=list)
    locators: List[LocatorCandidate] = field(default_factory=list)
    frame_path: Optional[FramePath] = None
    shadow_path: Optional[ShadowPath] = None
    component_type: str = ""       # e.g. "input", "button", "dropdown", "table_row" (structural, not business)
    discovered_at: float = field(default_factory=now_ts)
    last_seen_at: float = field(default_factory=now_ts)
    dynamic: bool = False          # discovered via mutation observer after initial crawl

    def best_locator(self) -> Optional[LocatorCandidate]:
        if not self.locators:
            return None
        return max(self.locators, key=lambda l: l.reliability_score)

    def to_dict(self) -> Dict[str, Any]:
        d = asdict(self)
        return d


@dataclass
class ModalRecord:
    modal_id: str
    page_id: str
    container_signature: str
    modal_type: str  # modal | popup | overlay | toast | dialog | side_panel | dropdown_overlay
    trigger_element_id: Optional[str] = None
    trigger_action_step: Optional[int] = None
    appeared_relative_to_action: str = "after"  # "before" | "after"
    child_element_ids: List[str] = field(default_factory=list)
    detected_via: List[str] = field(default_factory=list)  # which heuristics matched
    frame_path: Optional[FramePath] = None
    discovered_at: float = field(default_factory=now_ts)

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


@dataclass
class FrameRecord:
    frame_id: str
    page_id: str
    frame_locator: str
    frame_index: int
    parent_frame_id: Optional[str]
    nested_depth: int
    src: str = ""
