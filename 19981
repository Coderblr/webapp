import { createContext, useCallback, useContext, useEffect, useRef, useState } from "react";
import { useRouter } from "next/router";
import { authApi, setUnauthorizedHandler } from "@/lib/api";
import { getToken, setToken, clearToken } from "@/lib/auth-storage";

const AuthContext = createContext(null);

// Requirement: auto-logout after 5 minutes with no interaction. The server
// independently enforces the same 5-minute idle window on every API call
// (see auth/dependencies.py) - this client-side timer is what makes it
// happen even if the user just sits on a page making no requests at all,
// and gives a friendly warning before it fires.
const IDLE_LIMIT_MS = 12 * 60 * 60 * 1000; // 12 hours - keep in sync with IDLE_TIMEOUT_MINUTES in .env
const IDLE_WARNING_MS = 60 * 1000; // show a "you're about to be logged out" banner 60s ahead

export function AuthProvider({ children }) {
  const router = useRouter();
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [idleWarning, setIdleWarning] = useState(false);
  const lastActivityRef = useRef(Date.now());
  const idleWarnedRef = useRef(false);

  const goToLogin = useCallback(
    (message) => {
      clearToken();
      setUser(null);
      const query = message ? { reason: message } : {};
      router.replace({ pathname: "/login", query });
    },
    [router]
  );

  // Wire the API client's 401 handler straight to logout - a session that
  // the server considers dead (idle timeout, revoked, expired) should kick
  // the user out immediately no matter which page triggered the call.
  useEffect(() => {
    setUnauthorizedHandler((detail) => goToLogin(detail));
  }, [goToLogin]);

  // ---- bootstrap: is there a valid token already? ------------------------
  useEffect(() => {
    const token = getToken();
    if (!token) {
      setLoading(false);
      return;
    }
    authApi
      .me()
      .then((u) => setUser(u))
      .catch(() => clearToken())
      .finally(() => setLoading(false));
  }, []);

  // ---- idle timer ----------------------------------------------------------
  useEffect(() => {
    if (!user) return;

    const markActive = () => {
      lastActivityRef.current = Date.now();
      if (idleWarnedRef.current) {
        idleWarnedRef.current = false;
        setIdleWarning(false);
      }
    };

    const events = ["mousemove", "mousedown", "keydown", "scroll", "touchstart"];
    events.forEach((e) => window.addEventListener(e, markActive, { passive: true }));

    const interval = setInterval(() => {
      const idleFor = Date.now() - lastActivityRef.current;
      if (idleFor >= IDLE_LIMIT_MS) {
        goToLogin("Your session timed out due to inactivity. Please log in again.");
      } else if (idleFor >= IDLE_LIMIT_MS - IDLE_WARNING_MS) {
        idleWarnedRef.current = true;
        setIdleWarning(true);
      }
    }, 1000);

    return () => {
      events.forEach((e) => window.removeEventListener(e, markActive));
      clearInterval(interval);
    };
  }, [user, goToLogin]);

  async function login(username, password) {
    const data = await authApi.login(username, password);
    setToken(data.access_token);
    setUser(data.user);
    return data; // { must_change_password, user, ... }
  }

  async function logout() {
    try {
      await authApi.logout();
    } catch {
      /* best effort - clear locally regardless */
    }
    clearToken();
    setUser(null);
    router.replace("/login");
  }

  async function refreshUser() {
    const u = await authApi.me();
    setUser(u);
    return u;
  }

  return (
    <AuthContext.Provider value={{ user, loading, login, logout, refreshUser, idleWarning }}>
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error("useAuth must be used within AuthProvider");
  return ctx;
}
