"""Example integration of `core.popup_handler` into a generic Selenium
action wrapper.

This is deliberately kept separate from `BasePage` (rather than editing
its interaction methods directly) so it can be reviewed/adopted
independently — wire it in by having page objects call
`popup_aware_actions.click(...)` etc. instead of the raw `self.click`,
or by wrapping `BasePage._with_retry` itself once the approach is
confirmed on a couple of screens. Either integration point works
because both funnel every interaction through one place.
"""
from __future__ import annotations

import functools
import logging
from typing import Callable, TypeVar

from selenium.webdriver.remote.webdriver import WebDriver

from core import popup_handler

logger = logging.getLogger(__name__)

T = TypeVar("T")

# Short by design: this check runs around EVERY interaction, so it must
# stay cheap for the overwhelmingly common case (no popup at all).
# `popup_handler.is_popup_present` still polls up to this timeout when a
# popup genuinely is mid-render, so a real popup is never missed — this
# just bounds how long a *normal, popup-free* interaction pays before
# proceeding.
_DEFAULT_PRE_ACTION_TIMEOUT = 1.0
_DEFAULT_POST_ACTION_TIMEOUT = 1.0


def popup_guard(pre_timeout: float = _DEFAULT_PRE_ACTION_TIMEOUT,
                 post_timeout: float = _DEFAULT_POST_ACTION_TIMEOUT):
    """Decorator for any bound BasePage-style method whose first
    positional/keyword-free argument set includes `self.driver`.

    Wraps the call so that, transparently to every caller:
      1. Before the action runs, checks for (and handles) a popup that
         may already be blocking the page — e.g. a session-timeout
         warning that appeared while the previous step was still
         being read by a human/report, or a popup left over from a
         prior action that nothing yet cleared.
      2. Runs the wrapped action as normal.
      3. After the action runs, checks again — this is the common case
         a plain "check once before clicking Submit" approach misses:
         a popup that the action *itself* triggered (e.g. clicking
         Submit is exactly what opens a confirmation dialog).

    Popup checks never raise and never replace the action's own
    result/exception — if the wrapped action fails for a genuine
    reason, that failure still propagates normally.
    """
    def decorator(func: Callable[..., T]) -> Callable[..., T]:
        @functools.wraps(func)
        def wrapper(self, *args, **kwargs) -> T:
            driver: WebDriver = self.driver
            _safe_check(driver, pre_timeout, stage=f"before {func.__name__}")
            result = func(self, *args, **kwargs)
            _safe_check(driver, post_timeout, stage=f"after {func.__name__}")
            return result
        return wrapper
    return decorator


def _safe_check(driver: WebDriver, timeout: float, stage: str) -> None:
    """Runs check_and_handle_popup and swallows anything unexpected —
    a popup-guard check must never be the reason a real interaction
    fails. Any genuine driver/session failure will surface again
    immediately on the real action right after this anyway.
    """
    try:
        detected = popup_handler.check_and_handle_popup(driver, timeout=timeout)
        if detected:
            logger.info("popup_guard: popup detected and processed (%s)", stage)
    except Exception:  # noqa: BLE001 - guard must never break the real flow
        logger.debug("popup_guard: check failed (%s)", stage, exc_info=True)


# ── example usage against this framework's own BasePage ────────────────
#
#   from core.base_page import BasePage
#   from core.popup_aware_actions import popup_guard
#
#   class MyPage(BasePage):
#       @popup_guard()
#       def click(self, element_key: str) -> None:
#           return super().click(element_key)
#
#       @popup_guard()
#       def type(self, element_key: str, value: str | None) -> None:
#           return super().type(element_key, value)
#
# Every call site that already does `self.click("some::key")` or
# `self.type("some::key", value)` needs no change at all — the guard is
# transparent. The same pattern applies to `wait_for_visible`,
# `select_by_visible_text`, navigation helpers, or any other method on
# BasePage/a page object.
#
# For call sites that are NOT a page-object method (e.g. inside a
# `behave` step definition, or a plain polling loop watching for some
# condition), call the lower-level functions directly instead of going
# through the decorator:
#
#   from core import popup_handler
#
#   def step_wait_for_confirmation(context):
#       driver = context.driver
#       while not condition_met(driver):
#           if popup_handler.is_popup_present(driver, timeout=1):
#               popup_handler.handle_popup(driver)
#               continue
#           # ... normal polling logic ...
#
# Both integration points end up calling the same underlying
# `core.popup_handler` functions, so detection/handling behaviour is
# identical whether it fires from a decorated page-object method or a
# manual check inside a loop.
