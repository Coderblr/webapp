"""The transaction-search box every SBI workflow starts from (step 6/7 of
Section 11.1).

Unlike LoginPage /
per-transaction page objects, this file is hand-written and shared — it is
NEVER regenerated by recording a transaction. If the search box's real
locator ever changes, fix it here directly.
"""
from __future__ import annotations

import time

from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.remote.webdriver import WebDriver

from core.base_page import BasePage
from utils import locator_repository as locator_repo

SEARCH_BOX = "search::transaction_box"
SEARCH_GO = "search::go"

# There's no single reliable locator for "the" suggestion/autocomplete
# dropdown across every screen this search box can be used from (same
# situation as base_page.py's spinner/validation-message pattern lists)
# — check the common shapes a live-filtering results list actually takes.
_SUGGESTION_LIST_PATTERNS = [
    (By.CSS_SELECTOR, "ul.ui-autocomplete li:not(.ui-helper-hidden-accessible)"),
    (By.CSS_SELECTOR, "[role='listbox'] [role='option']"),
    (By.CSS_SELECTOR, ".autocomplete-suggestions .autocomplete-suggestion"),
    (By.CSS_SELECTOR, ".search-results li, .search-results .result-item"),
    (By.CSS_SELECTOR, ".typeahead .tt-suggestion, .twitter-typeahead .tt-suggestion"),
    (By.CSS_SELECTOR, "ul.dropdown-menu.show li a, ul.dropdown-menu.show li"),
]


class TransactionSearchPage(BasePage):
    def __init__(self, driver: WebDriver):
        super().__init__(driver)
        self._register_locators()

    def _register_locators(self) -> None:
        if locator_repo.contains(SEARCH_BOX):
            return
        locator_repo.register(SEARCH_BOX, [
            # Confirmed from the real DOM (Aug 2026):
            # <input id="appSearch" name="appSearch" class="appSearchText"
            #   placeholder="Enter screen number or part of screen name" ...>
            (By.ID, "appSearch"),
            (By.NAME, "appSearch"),
            (By.CSS_SELECTOR, "input.appSearchText"),
            # Old guessed seed locators, kept as further fallbacks:
            (By.ID, "txnSearch"), (By.NAME, "transactionId"), (By.ID, "menuSearch"),
            (By.CSS_SELECTOR, "input[placeholder*='ransaction']"),
            (By.CSS_SELECTOR, "input[placeholder*='earch']"),
            (By.CSS_SELECTOR, "input[placeholder*='screen']"),
        ])
        locator_repo.register(SEARCH_GO, [
            (By.ID, "txnGo"), (By.CSS_SELECTOR, "button[title*='earch']"),
            (By.XPATH, "//button[contains(.,'Go') or contains(.,'Search')]"),
        ])

    def _find_and_click_suggestion(self, transaction_id: str, timeout: float = 4.0) -> bool:
        """The real gap this fixes: typing into the search box previously
        went straight to pressing Enter / clicking a "Go" button — with
        NO awareness that a live-filtering suggestion list appears as you
        type, and that the app actually expects that specific entry to
        be CLICKED, not just typed-and-submitted. Waits briefly for any
        of the common suggestion-list shapes to appear, then clicks the
        best match (an item whose text contains the searched id) — or
        simply the first item if nothing matches by text exactly, since
        after typing a specific id there's usually exactly one real
        candidate anyway. Returns False (never raises) if no such list
        ever appears at all, so the existing Go-button/Enter fallback
        below still covers every screen that doesn't have this pattern.
        """
        deadline = time.time() + timeout
        while time.time() < deadline:
            for by, selector in _SUGGESTION_LIST_PATTERNS:
                try:
                    items = [el for el in self.driver.find_elements(by, selector) if el.is_displayed()]
                except Exception:
                    continue
                if not items:
                    continue
                match = next((el for el in items if transaction_id in (el.text or "")), items[0])
                try:
                    match.click()
                except Exception:
                    self.driver.execute_script("arguments[0].click();", match)
                return True
            time.sleep(0.2)
        return False

    def search_transaction(self, transaction_id: str) -> "TransactionSearchPage":
        """Confirmed, real behaviour (screenshot evidence, 12-Aug-2026):
        typing the transaction number into this search box and pressing
        Enter directly opens that transaction's screen — there is NO
        suggestion/autocomplete dropdown to click on this particular
        search box. Enter is tried FIRST for that reason; the dropdown-
        detection fallback below only runs if that didn't seem to work,
        rather than unconditionally waiting up to several seconds for a
        dropdown that (for this box) never actually appears — which was
        needlessly slowing down every single search before this fix.
        """
        self.type(SEARCH_BOX, transaction_id)
        url_before = self.driver.current_url
        if self.exists(SEARCH_GO):
            self.click(SEARCH_GO)
        else:
            self._find(SEARCH_BOX).send_keys(Keys.ENTER)
        self.wait_for_page()
        if self.driver.current_url != url_before:
            return self  # navigated — the confirmed, common case; done

        # Enter/Go didn't seem to navigate anywhere — fall back to
        # checking for a suggestion list, in case THIS particular screen
        # is one of the few that actually has one (kept as a safety net,
        # not the primary path any more).
        if self._find_and_click_suggestion(transaction_id):
            self.wait_for_page()
        return self

