"""Direct, raw CDP capture — a SUPPLEMENTARY pass alongside the existing
injector.js-based capture, not a replacement for it.

Why this exists: injector.js runs as JavaScript INSIDE the page —
browser same-origin policy means it fundamentally CANNOT see into a
CROSS-ORIGIN iframe's content (a supervisor-override / verification
widget served from a different subdomain, common in enterprise banking
apps, is exactly this shape). CDP itself runs at the BROWSER level, one
layer below page JavaScript, and genuinely isn't bound by that
restriction — `Accessibility.getFullAXTree` returns the WHOLE page's
accessible-node tree in one call, including nodes inside cross-origin
frames that no amount of `Page.addScriptToEvaluateOnNewDocument`-style
injection could ever reach.

Honest limitation, stated plainly rather than glossed over: the exact
shape of CDP's own response can vary subtly across Chromium/Edge
versions, and this module could only be verified here against my own
understanding of the documented protocol, not against a real, live
browser (this sandbox has none). It is deliberately defensive — every
CDP call and every field access is wrapped so a shape mismatch on a
real machine degrades to "this pass found nothing extra" rather than
breaking the (already working, already tested) injector.js-based
capture that runs regardless of whether this succeeds at all.
"""
from __future__ import annotations

from typing import Any

from ..core.logging_conf import get_logger

log = get_logger(__name__)


def capture_accessible_elements(driver) -> list[dict[str, Any]]:
    """Returns a list of element dicts in the SAME shape
    cdp_recorder.py's `_merge_element()` already expects (element_key-
    ready via label/element_type/locators/attributes), sourced entirely
    from CDP's own Accessibility + DOM domains rather than injected JS.
    Never raises — a failure at any point returns whatever was
    successfully gathered before it, or an empty list.
    """
    found: list[dict[str, Any]] = []
    try:
        driver.execute_cdp_cmd("Accessibility.enable", {})
        driver.execute_cdp_cmd("DOM.enable", {})
    except Exception as exc:
        log.debug("CDP direct capture: could not enable required domains: %s", exc)
        return found

    try:
        tree = driver.execute_cdp_cmd("Accessibility.getFullAXTree", {})
    except Exception as exc:
        log.debug("CDP direct capture: getFullAXTree failed: %s", exc)
        return found

    nodes = (tree or {}).get("nodes", [])
    # Only nodes with an INTERACTIVE-shaped role are worth surfacing as
    # candidate elements — the full AX tree includes every static text
    # node, container, and heading on the page too, which would just be
    # noise for this purpose (locator/action capture, not a full
    # accessibility audit).
    interactive_roles = {
        "button", "textbox", "checkbox", "radio", "combobox", "link",
        "menuitem", "tab", "switch", "searchbox", "listbox", "option",
    }
    for node in nodes:
        try:
            if node.get("ignored"):
                continue
            role = ((node.get("role") or {}).get("value") or "").lower()
            if role not in interactive_roles:
                continue
            name = (node.get("name") or {}).get("value") or ""
            backend_node_id = node.get("backendDOMNodeId")
            if backend_node_id is None:
                continue
            locators = _resolve_locators(driver, backend_node_id)
            if not locators:
                continue
            found.append({
                "element_key": f"cdp_axtree::{backend_node_id}",
                "label": name or role,
                "element_type": _role_to_element_type(role),
                "locators": locators,
                "meta": {"source": "cdp_accessibility_tree", "role": role},
            })
        except Exception as exc:  # noqa: BLE001
            log.debug("CDP direct capture: skipped one node: %s", exc)
            continue
    return found


def _resolve_locators(driver, backend_node_id: int) -> dict[str, str]:
    """CDP gives node identity as an opaque backendNodeId — turning that
    into an actual (id/name/class) locator requires resolving it to a
    JS object reference, then reading its attributes back out via
    `Runtime.callFunctionOn`. Every step here can legitimately fail for
    an ordinary reason (the node went stale between the tree snapshot
    and this resolution, it's inside a frame this particular call can't
    cross after all, ...) — caught and treated as "no locator for this
    one", never as a reason to abort the whole pass.
    """
    try:
        resolved = driver.execute_cdp_cmd(
            "DOM.resolveNode", {"backendNodeId": backend_node_id}
        )
        object_id = (resolved.get("object") or {}).get("objectId")
        if not object_id:
            return {}
        result = driver.execute_cdp_cmd(
            "Runtime.callFunctionOn",
            {
                "objectId": object_id,
                "functionDeclaration": (
                    "function() { return JSON.stringify({"
                    "id: this.id || null, name: this.name || null, "
                    "cls: (this.className || '').toString().split(' ')[0] || null"
                    "}); }"
                ),
                "returnByValue": True,
            },
        )
        import json
        payload = json.loads((result.get("result") or {}).get("value") or "{}")
    except Exception:
        return {}

    locators: dict[str, str] = {}
    if payload.get("id"):
        locators["id"] = payload["id"]
    if payload.get("name"):
        locators["name"] = payload["name"]
    if payload.get("cls"):
        locators["class"] = payload["cls"]
    return locators


def _role_to_element_type(role: str) -> str:
    return {
        "textbox": "textbox", "searchbox": "textbox", "checkbox": "checkbox",
        "radio": "radio", "combobox": "dropdown", "listbox": "dropdown",
        "button": "button", "link": "link",
    }.get(role, "button")
