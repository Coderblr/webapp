/**
 * Small, dependency-free SVG visualizations for the exit report - no
 * charting library needed, and using Tailwind utility classes for
 * fill/stroke means these automatically follow the app's theme colors
 * (see tailwind.config.js) rather than hardcoding hex values that would
 * drift out of sync with the rest of the UI.
 */

export function ReportDonut({ passed, failed, size = 156 }) {
  const total = passed + failed || 1;
  const radius = size * 0.38;
  const stroke = size * 0.13;
  const circumference = 2 * Math.PI * radius;
  const passedLen = (passed / total) * circumference;
  const passedPct = Math.round((passed / total) * 100);
  const center = size / 2;

  return (
    <svg viewBox={`0 0 ${size} ${size}`} width={size} height={size} role="img" aria-label="Passed vs failed steps">
      <circle cx={center} cy={center} r={radius} fill="none" className="stroke-signal-rust/25" strokeWidth={stroke} />
      <circle cx={center} cy={center} r={radius} fill="none" className="stroke-signal-rust" strokeWidth={stroke}
        strokeDasharray={`${circumference} ${circumference}`} transform={`rotate(-90 ${center} ${center})`} />
      <circle
        cx={center} cy={center} r={radius} fill="none" className="stroke-signal-teal" strokeWidth={stroke}
        strokeDasharray={`${passedLen} ${circumference - passedLen}`}
        strokeLinecap={passedLen > 0 && passedLen < circumference ? "round" : "butt"}
        transform={`rotate(-90 ${center} ${center})`}
      />
      <text x={center} y={center - 3} textAnchor="middle" className="fill-ink font-mono font-bold" style={{ fontSize: size * 0.19 }}>
        {passedPct}%
      </text>
      <text x={center} y={center + size * 0.13} textAnchor="middle" className="fill-muted" style={{ fontSize: size * 0.085 }}>
        passed
      </text>
    </svg>
  );
}

/** A compact, hoverable strip showing every step's pass/fail as one
 * colored segment in sequence - lets you spot exactly where in a long run
 * things started failing, at a glance, without reading the full table. */
export function StepSequenceBar({ steps }) {
  if (!steps || steps.length === 0) return null;
  return (
    <div className="flex h-3 w-full min-w-0 gap-px overflow-hidden rounded-full border border-line bg-line">
      {steps.map((s, i) => (
        <div
          key={i}
          className={`h-full flex-1 ${s.status === "Passed" ? "bg-signal-teal" : "bg-signal-rust"}`}
          title={`#${i + 1} ${s.step_name} — ${s.status}`}
        />
      ))}
    </div>
  );
}
