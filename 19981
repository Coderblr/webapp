@then('the flow should complete without errors')
def step_verify_no_errors(context):
    # Generic post-condition: no unhandled browser alert/JS error banner.
    # Checks the CURRENTLY ACTIVE tab/window (context.page.page - see
    # RecordedPage.switch_page), not always the original one, so this still
    # works for a flow that ends on a popup/new tab/new window.
    #
    # A recorded flow can legitimately end by closing its own tab/window
    # (see the "the user closes the current browser tab or window" step,
    # generated for a recorded window/tab-close action) - at that point
    # there is nothing left to check a title on, and that's a successful
    # end state, not a failure. Checking is_closed() first (a local state
    # check, safe to call on an already-closed page) avoids ever calling
    # .title() on a closed page in the first place - .title() talks to the
    # browser process and raises TargetClosedError there instead of
    # returning some default value, which would otherwise fail this
    # deliberately generic, no-op-by-default final check for a flow that
    # did nothing wrong.
    if context.page.page.is_closed():
        return
    assert context.page.page.title() is not None
    # Replace with an assertion specific to the target application
    # (e.g. checking a confirmation message or success banner).
