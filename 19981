import Link from "next/link";
import { useRouter } from "next/router";
import { useAuth } from "@/context/AuthContext";
import AgentStatus from "@/components/AgentStatus";

function NavLink({ href, children }) {
  const router = useRouter();
  const active = router.pathname === href || router.pathname.startsWith(href + "/");
  return (
    <Link
      href={href}
      className={`rounded-sm px-3 py-1.5 text-sm font-medium transition-colors ${
        active ? "bg-brand-blue text-white" : "text-ink hover:bg-rail"
      }`}
    >
      {children}
    </Link>
  );
}

export default function Layout({ children }) {
  const { user, logout, idleWarning } = useAuth();

  return (
    <div className="min-h-screen bg-paper">
      {/* Bank identity strip - kept slim and quiet; the working UI below does the heavy lifting */}
      <div className="bg-brand-blueDark px-6 py-1.5 text-center text-[11px] font-medium uppercase tracking-wide text-white/80">
        State Bank of India &middot; Internal Use Only
      </div>

      {idleWarning && (
        <div className="border-b border-brand-gold/40 bg-[#FBF2DF] px-6 py-2 text-center text-sm font-medium text-brand-gold">
          You&rsquo;ve been idle - you&rsquo;ll be signed out soon unless you move your mouse or press a key.
        </div>
      )}

      <header className="border-b border-line bg-panel">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
          <div className="flex items-center gap-6">
            <Link href="/dashboard" className="flex items-center gap-2">
              <div className="flex h-8 w-8 items-center justify-center rounded-sm bg-brand-blue font-mono text-xs font-semibold text-white">
                SBI
              </div>
              <span className="text-sm font-semibold tracking-tight text-ink">AI Test Recorder</span>
            </Link>
            <nav className="flex items-center gap-1">
              <NavLink href="/dashboard">Dashboard</NavLink>
              <NavLink href="/tool">Record &amp; Run</NavLink>
              <NavLink href="/profile">Profile</NavLink>
              {user && user.role === "admin" && (
                <>
                  <span className="mx-1 h-4 w-px bg-line" />
                  <NavLink href="/admin/users">Users</NavLink>
                  <NavLink href="/admin/sessions">Sessions</NavLink>
                  <NavLink href="/admin/agents">Agents</NavLink>
                  <NavLink href="/admin/activity">Activity</NavLink>
                </>
              )}
            </nav>
          </div>

          {user && (
            <div className="flex items-center gap-4">
              <AgentStatus />
              <div className="text-right leading-tight">
                <div className="text-sm font-medium text-ink">
                  {user.first_name} {user.last_name}
                </div>
                <div className="text-xs text-muted">
                  {user.username} {user.role === "admin" && <span className="text-brand-blue">&middot; admin</span>}
                </div>
              </div>
              <button
                onClick={logout}
                className="rounded-sm border border-line px-3 py-1.5 text-sm font-medium text-ink hover:border-signal-rust hover:text-signal-rust"
              >
                Log out
              </button>
            </div>
          )}
        </div>
      </header>

      <main className="mx-auto max-w-6xl px-6 py-8">{children}</main>
    </div>
  );
}
