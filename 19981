import { useEffect, useMemo, useState } from "react";
import { adminApi } from "@/lib/api";
import { Button, Callout, Panel, PanelHeader, Select } from "@/components/ui";

// Same names/order as backend/app_access.py PERMISSIONS. "delete" is never granted by default.
const PERMS = [
  ["view", "View"],
  ["record", "Record"],
  ["edit", "Edit"],
  ["execute", "Execute"],
  ["upload", "Upload/import"],
  ["export", "Export/report"],
  ["delete", "Delete"],
];
const DEFAULT_PERMS = ["view", "record", "edit", "execute", "upload", "export"];

/**
 * Admin > Users > "Application Access" for ONE user. UI only: every change is validated and authorised again by
 * the server (/api/admin/users/{id}/applications). Admin accounts can use every application regardless.
 */
export default function ApplicationAccessPanel({ user, onClose }) {
  const [registry, setRegistry] = useState([]);
  const [saved, setSaved] = useState({}); // application_id -> [permissions] (what the server has)
  const [draft, setDraft] = useState({}); // application_id -> [permissions] (what is ticked now)
  const [pick, setPick] = useState(""); // application chosen in the dropdown, not yet added
  const [busy, setBusy] = useState(false);
  const [loading, setLoading] = useState(true);
  const [loadFailed, setLoadFailed] = useState(false);
  const [notice, setNotice] = useState(null);

  async function load() {
    setLoading(true);
    setLoadFailed(false);
    try {
      // Pick up applications newly added to config/applications.yaml (idempotent; assigns nothing to anyone).
      try { await adminApi.syncApplicationRegistry(); } catch (_) { /* older server / transient: still load the list */ }
      const [reg, mine] = await Promise.all([adminApi.listApplicationRegistry(), adminApi.getUserApplications(user.user_id)]);
      const map = {};
      (mine.applications || []).forEach((a) => (map[a.application_id] = a.permissions));
      setRegistry(reg.filter((a) => a.status === "Active"));
      setSaved(map);
      setDraft(map);
    } catch (e) {
      setLoadFailed(true);
      const notFound = /not found/i.test(e.detail || e.message || "");
      setNotice({
        tone: "error",
        text: notFound
          ? "The server does not have the application-access API (404). Restart the backend with the updated code, then reopen this panel."
          : e.detail || e.message,
      });
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    setNotice(null);
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [user.user_id]);

  const available = useMemo(() => registry.filter((a) => !draft[a.application_id]), [registry, draft]);
  const assigned = useMemo(() => registry.filter((a) => draft[a.application_id]), [registry, draft]);
  const dirty = JSON.stringify(normalize(saved)) !== JSON.stringify(normalize(draft));

  function toggleApp(id) {
    setDraft((d) => {
      const n = { ...d };
      if (n[id]) delete n[id];
      else n[id] = [...DEFAULT_PERMS];
      return n;
    });
  }
  function addPicked() {
    if (!pick) return;
    setDraft((d) => ({ ...d, [pick]: [...DEFAULT_PERMS] }));
    setPick("");
  }
  function togglePerm(id, perm) {
    setDraft((d) => {
      const cur = new Set(d[id] || []);
      if (cur.has(perm)) cur.delete(perm);
      else cur.add(perm);
      if (cur.size) cur.add("view"); // any permission implies view
      if (perm === "view") cur.clear(); // un-ticking view removes the assignment's other rights too
      return { ...d, [id]: PERMS.map(([p]) => p).filter((p) => cur.has(p)) };
    });
  }

  async function save() {
    const assignments = Object.entries(draft)
      .filter(([, perms]) => perms.length)
      .map(([id, permissions]) => ({ application_id: Number(id), permissions }));
    if (!assignments.length && Object.keys(saved).length) {
      if (!window.confirm(`This removes ALL application access from ${user.username}. Continue?`)) return;
    }
    setBusy(true);
    setNotice(null);
    try {
      const res = await adminApi.replaceUserApplications(user.user_id, assignments, assignments.length === 0);
      const map = {};
      (res.applications || []).forEach((a) => (map[a.application_id] = a.permissions));
      setSaved(map);
      setDraft(map);
      setNotice({ tone: "success", text: `Saved. ${user.username} now has ${assignments.length} application(s).` });
    } catch (e) {
      setNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setBusy(false);
    }
  }

  async function revokeAll() {
    if (!window.confirm(`Revoke ALL application access from ${user.username}? Their running tests on those applications will be cancelled.`)) return;
    setBusy(true);
    setNotice(null);
    try {
      const res = await adminApi.revokeAllUserApplications(user.user_id);
      setNotice({ tone: "success", text: `Revoked ${res.revoked} application(s).` });
      await load();
    } catch (e) {
      setNotice({ tone: "error", text: e.detail || e.message });
    } finally {
      setBusy(false);
    }
  }

  return (
    <Panel>
      <PanelHeader
        title={`Application access - ${user.username}`}
        caption={
          user.role === "admin"
            ? "Administrators can use every application regardless of these assignments."
            : "A user can only see and use the applications ticked here. Nothing is granted by default."
        }
      />
      <div className="space-y-3 px-5 py-5">
        {notice && <Callout tone={notice.tone}>{notice.text}</Callout>}
        {loading ? (
          <p className="text-sm text-muted">Loading...</p>
        ) : (
          <>
            <div className="flex gap-2">
              <Select value={pick} onChange={(e) => setPick(e.target.value)} disabled={busy || loadFailed || available.length === 0}>
                <option value="">
                  {loadFailed
                    ? "Could not load applications"
                    : available.length === 0
                    ? "All registered applications are assigned"
                    : "Select an application to add..."}
                </option>
                {available.map((a) => (
                  <option key={a.application_id} value={a.application_id}>
                    {a.display_name || a.name}
                  </option>
                ))}
              </Select>
              <Button type="button" onClick={addPicked} disabled={busy || !pick}>
                Add
              </Button>
            </div>
            <p className="text-xs text-muted">
              The list comes from config/applications.yaml (plus applications found in your recordings). Add a new
              application there and reopen this panel - it appears here.
            </p>
            {assigned.length === 0 ? (
              <p className="text-sm text-muted">No applications assigned to this user.</p>
            ) : (
              <ul className="max-h-96 divide-y divide-line overflow-auto rounded-sm border border-line">
                {assigned.map((a) => (
                  <li key={a.application_id} className="px-3 py-2">
                    <div className="flex items-center justify-between gap-2">
                      <span className="text-sm font-medium text-ink">{a.display_name || a.name}</span>
                      <button
                        type="button"
                        className="text-xs font-medium text-signal-rust hover:underline disabled:opacity-40"
                        disabled={busy}
                        onClick={() => toggleApp(a.application_id)}
                      >
                        Remove
                      </button>
                    </div>
                    <div className="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
                      {PERMS.map(([p, label]) => (
                        <label key={p} className="flex items-center gap-1 text-xs text-ink">
                          <input
                            type="checkbox"
                            checked={draft[a.application_id].includes(p)}
                            onChange={() => togglePerm(a.application_id, p)}
                            disabled={busy}
                          />
                          {label}
                        </label>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        )}
        <div className="flex flex-wrap gap-2">
          <Button type="button" onClick={save} disabled={busy || !dirty}>
            {busy ? "Saving..." : "Save access"}
          </Button>
          <Button type="button" variant="secondary" onClick={() => setDraft(saved)} disabled={busy || !dirty}>
            Reset
          </Button>
          <Button type="button" variant="secondary" onClick={revokeAll} disabled={busy || Object.keys(saved).length === 0}>
            Revoke all
          </Button>
          <Button type="button" variant="secondary" onClick={onClose}>
            Close
          </Button>
        </div>
      </div>
    </Panel>
  );
}

function normalize(m) {
  return Object.keys(m)
    .sort()
    .map((k) => [k, [...m[k]].sort()]);
}
