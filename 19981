@app.post("/api/solution-documents/upload")
async def upload_solution_document(
    request: Request,
    file: UploadFile = File(...),
    application: str = Form(...),
    cr_number: str = Form(""),
    document_name: str = Form(""),
    current_user: CurrentUser = Depends(get_current_user),
):
    """Upload a solution document (PDF/DOCX/TXT/MD) for a given application.
    Stores it under recordings/<app>/solution_documents/ without running analysis yet."""
    app_access.require_application_access(current_user, application, "upload")
    from solution_analyzer.service import store_solution_document

    allowed_exts = {".pdf", ".docx", ".doc", ".txt", ".md"}
    suffix = Path(file.filename).suffix.lower()
    if suffix not in allowed_exts:
        raise HTTPException(
            status_code=400,
            detail=f"Unsupported file type {suffix!r}. Supported: {', '.join(sorted(allowed_exts))}"
        )

    tmp_path = Path(tempfile.gettempdir()) / f"solutiondoc_{uuid.uuid4().hex}{suffix}"
    try:
        contents = await file.read()
        tmp_path.write_bytes(contents)
        doc = store_solution_document(
            tmp_file_path=str(tmp_path),
            original_filename=file.filename,
            application=application,
            cr_number=cr_number.strip() or None,
            document_name=document_name.strip() or None,
            uploaded_by=current_user.username,
        )
        ip = get_client_ip(request)
        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id,
                action="SOLUTION_DOC_UPLOADED", status="SUCCESS",
                details={"doc_id": doc["id"], "application": application, "filename": file.filename},
                endpoint="/api/solution-documents/upload", ip_address=ip,
            )
        return doc
    finally:
        tmp_path.unlink(missing_ok=True)


