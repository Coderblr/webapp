    # ------------------------------------------------------------------
    # Hover / dropdown navigation menus
    #
    # Two things live here, both built on the same "open the menus above
    # this link" routine (_reveal_in_menu):
    #
    #   1. Auto-open for RECORDED steps. _find() calls _reveal_in_menu()
    #      whenever a recorded link/button exists in the page but is not
    #      visible - the normal state of an item inside a closed hover
    #      menu. The parents are found from the live DOM (not from
    #      recorded pixel positions), so a recording that only contains
    #      the final click replays correctly, with no hover steps at all,
    #      at any window size.
    #
    #   2. check_navigation_menu() - the "menu check" step. Finds the
    #      site's navigation menu at run time, then for every link in it:
    #      opens the menus above it with the real mouse, clicks it, and
    #      verifies the page that opened. Nothing is recorded by hand.
    # ------------------------------------------------------------------
    def _nav_shown(self, handle) -> bool:
        """True when `handle` is really on screen and can receive the
        mouse (laid out, not transparent, not clipped/covered at its
        centre) - stricter than Playwright's is_visible(), which still
        reports True for an item clipped by a collapsed (max-height: 0)
        menu or sitting under an overlay."""
        try:
            return bool(handle.evaluate(_NAV_SHOWN_JS))
        except Exception:
            return False

    def _nav_wait_shown(self, handle, seconds: float = 1.2) -> bool:
        end = time.time() + seconds
        while True:
            if self._nav_shown(handle):
                return True
            if time.time() >= end:
                return False
            time.sleep(0.08)

    def _nav_hover(self, handle) -> bool:
        """Puts the real mouse pointer on the centre of `handle`, using its
        position on screen right now. Returns False if it has no box."""
        try:
            box = handle.bounding_box()
        except Exception:
            box = None
        if not box or box["width"] < 1 or box["height"] < 1:
            return False
        cx = box["x"] + box["width"] / 2
        cy = box["y"] + box["height"] / 2
        try:
            # Two moves: the first lands on the element (mouseenter/
            # mouseover), the second is a real mousemove inside it, which
            # some script-driven menus wait for before opening.
            self.page.mouse.move(cx - 1, cy)
            self.page.mouse.move(cx, cy)
            return True
        except Exception:
            return False

    def _nav_release(self) -> None:
        """Drops any forced :hover state set by _nav_force_open. Safe to
        call at any time, including after the page has navigated away."""
        cdp = getattr(self, "_nav_cdp", None)
        self._nav_cdp = None
        if cdp is not None:
            try:
                cdp.detach()  # closing the session clears every forced state
            except Exception:
                pass

    def _nav_force_open(self, handle, include_self: bool = False) -> bool:
        """
        Opens the menus above `handle` without using the mouse pointer.

        Why: in a visible (non-headless) browser the REAL mouse wins. If
        the person's cursor is anywhere over the window, the browser keeps
        applying hover to whatever is under it, so a menu opened by an
        automated pointer move closes again straight away - the run then
        only moves forward while someone holds the real mouse on the menu.

        Two pointer-free mechanisms, both applied:
          - CSS menus: the browser is told to treat each parent item as
            hovered (CDP CSS.forcePseudoState - the "force element state
            :hover" switch from DevTools). The real cursor cannot undo it.
          - Script menus: mouseenter/mouseover events are sent directly to
            each parent.

        The forced state stays until _nav_release() (called after the
        click, and before the next menu is opened). Returns True if the
        hover state could be forced; False (e.g. element inside an iframe,
        or a non-Chromium browser) leaves the caller to fall back to
        moving the pointer.
        """
        self._nav_release()
        try:
            marked = handle.evaluate(_NAV_FORCE_TAG_JS, include_self)
        except Exception:
            return False
        if not marked:
            return False
        forced = False
        try:
            cdp = self.page.context.new_cdp_session(self.page)
            self._nav_cdp = cdp
            cdp.send("DOM.enable")
            cdp.send("CSS.enable")
            root = cdp.send("DOM.getDocument", {"depth": 0})["root"]["nodeId"]
            found = cdp.send("DOM.querySelectorAll", {"nodeId": root, "selector": "[data-atr-force]"})
            for node_id in found.get("nodeIds") or []:
                cdp.send("CSS.forcePseudoState", {"nodeId": node_id, "forcedPseudoClasses": ["hover", "focus-within"]})
                forced = True
        except Exception:
            self._nav_release()
        try:
            handle.evaluate(_NAV_SYNTH_HOVER_JS, include_self)
        except Exception:
            pass
        return forced

    def _reveal_in_menu(self, target, settle: float = 1.2) -> bool:
        """
        Makes `target` (a Locator or ElementHandle for a link/button)
        visible by opening the menus it sits inside, outermost first.
        Each parent is opened by hovering it; if hovering does nothing it
        is focused, and - only for a parent that is clearly a dropdown
        toggle and not a real link - clicked.

        Returns True when the target is on screen afterwards (also when
        it already was). Never raises.
        """
        try:
            handle = target.element_handle(timeout=2000) if hasattr(target, "element_handle") else target
        except Exception:
            return False
        if handle is None:
            return False
        if self._nav_shown(handle):
            return True
        try:
            chain = handle.evaluate_handle(_NAV_CHAIN_JS)
            props = chain.get_properties()
            triggers = []
            for key in sorted(props.keys(), key=lambda k: int(k) if str(k).isdigit() else 10 ** 6):
                element = props[key].as_element()
                if element is not None:
                    triggers.append(element)
        except Exception:
            return False
        if not triggers:
            return False

        # First choice: no pointer involved at all (see _nav_force_open).
        if _POINTER_FREE_MENUS:
            self._nav_force_open(handle)
            if self._nav_wait_shown(handle, settle):
                return True

        # Still closed: click-to-open toggles, and - last resort - moving
        # the pointer onto each parent in turn.
        for i, trigger in enumerate(triggers):
            nxt = triggers[i + 1] if i + 1 < len(triggers) else handle
            if self._nav_shown(nxt):
                continue  # this level is already open
            if not self._nav_shown(trigger):
                continue  # cannot point at something that is not on screen
            try:
                trigger.scroll_into_view_if_needed(timeout=1500)
            except Exception:
                pass
            try:
                info = trigger.evaluate(_NAV_TOGGLE_JS) or {}
            except Exception:
                info = {}
            clickable_toggle = bool((info.get("toggle") or info.get("dead_link")) and not info.get("is_link"))
            self._nav_hover(trigger)
            # A parent that is a real link can only open on hover, so give it
            # the full settle time; a toggle button usually opens on click,
            # so do not wait as long before trying that.
            if self._nav_wait_shown(nxt, 0.5 if clickable_toggle else settle):
                continue
            try:
                trigger.focus()
            except Exception:
                pass
            if self._nav_wait_shown(nxt, 0.3):
                continue
            if clickable_toggle:
                try:
                    trigger.click(timeout=1500)
                except Exception:
                    pass
                self._nav_wait_shown(nxt, settle)
        return self._nav_shown(handle)

    def _nav_dismiss_overlays(self) -> list:
        """Best effort: closes cookie banners / welcome pop-ups that sit on
        top of the page (Accept, Close, X ...). Only clicks buttons inside
        a floating cookie/consent/modal/pop-up box, never a real link."""
        try:
            return self.page.evaluate(_NAV_DISMISS_JS) or []
        except Exception:
            return []

    def _nav_discover(self, selector: str = "", retries: int = 4) -> dict:
        last = {}
        for _ in range(max(1, retries)):
            try:
                last = self.page.evaluate(_NAV_DISCOVER_JS, {"selector": selector or ""}) or {}
            except Exception as e:
                last = {"error": str(e), "items": []}
            if last.get("items") or last.get("error"):
                return last
            time.sleep(1.0)  # menu may still be rendering
        return last

    def check_navigation_menu(self, options: dict | None = None) -> dict:
        """
        Checks every link of the navigation menu on the page that is open
        right now (so it can follow recorded login steps).

        For each menu link: go back to the start page, open the menus
        above the link with the mouse, click it, and verify what opened -
        HTTP status, not an error/blank page, and (when a baseline is
        given) that the link still points where it did before. Links that
        open a new tab or download a file are handled too.

        options:
          menu_selector        CSS selector of the menu, if the automatic
                               pick is wrong (default: detect it)
          baseline             [{"path": [...], "href": "..."}] from an
                               earlier run - items that disappeared or
                               whose link changed are reported as failed
          strict_hover         fail an item whose menu does not open on
                               hover (default: check the link anyway and
                               add a note)
          max_items            safety cap (default 200)
          time_budget_seconds  stop starting new items after this long
          screenshots          "all" (default) | "failed" | "none"
          dismiss_popups       close cookie banners / pop-ups (default True)

        Returns {"home", "root", "rows", "discovered", "summary"} - one
        row per menu link. Raises AssertionError only when no menu could
        be found at all.
        """
        opts = dict(options or {})
        selector = (opts.get("menu_selector") or "").strip()
        strict_hover = bool(opts.get("strict_hover"))
        max_items = int(opts.get("max_items") or 200)
        budget = float(opts.get("time_budget_seconds") or 480)
        shots = str(opts.get("screenshots") or "all").lower()
        dismiss = opts.get("dismiss_popups", True)
        nav_wait = float(opts.get("navigation_wait_seconds") or 10)
        baseline = opts.get("baseline") or []

        page = self.page
        ctx = page.context
        started = time.time()

        try:
            page.wait_for_load_state("load", timeout=15000)
        except Exception:
            pass
        home = page.url
        home_host = _nav_host(home)

        dismissed = []
        if dismiss:
            time.sleep(0.5)  # pop-ups often appear just after load
            dismissed = self._nav_dismiss_overlays()

        disc = self._nav_discover(selector)
        items = disc.get("items") or []
        if not items:
            hint = disc.get("error") or (
                "No navigation menu was found on " + home + ". If the page has one, give its CSS "
                "selector (for example \"nav\" or \"#main-menu\") in the menu check's settings."
            )
            raise AssertionError(hint)

        # ---- what each click leads to (status of the page it opens) ----
        nav_resp = {}
        nav_fail = {}
        downloads = []

        # A brand-new tab's first request is sent before Playwright has a
        # frame for it, so request.frame raises for exactly the response we
        # care about. Those go into these two lists instead and are matched
        # to the new tab that opened after the click.
        early_resp = []
        early_fail = []

        def _on_response(resp):
            try:
                req = resp.request
                if not req.is_navigation_request():
                    return
                entry = (resp.status, resp.url, (resp.headers or {}).get("content-type", ""))
                try:
                    frame = req.frame
                except Exception:
                    early_resp.append(entry)
                    return
                if frame.parent_frame is None:
                    nav_resp[frame.page] = entry
            except Exception:
                pass

        def _on_failed(req):
            try:
                if not req.is_navigation_request():
                    return
                reason = req.failure or "request failed"
                try:
                    frame = req.frame
                except Exception:
                    early_fail.append(reason)
                    return
                if frame.parent_frame is None:
                    nav_fail[frame.page] = reason
            except Exception:
                pass

        def _on_download(download):
            downloads.append(download)

        def _on_page(new_page):
            try:
                new_page.on("download", _on_download)
            except Exception:
                pass

        ctx.on("response", _on_response)
        ctx.on("requestfailed", _on_failed)
        ctx.on("page", _on_page)
        page.on("download", _on_download)

        shots_dir = Path(__file__).resolve().parent.parent / "screenshots"

        def _lookup(found_items):
            table = {}
            for it in found_items:
                table.setdefault(_nav_key(it.get("path")), it)
            return table

        def _go_home():
            try:
                page.goto(home, wait_until="domcontentloaded", timeout=45000)
            except Exception as e:
                if not _navigation_interrupted(e):
                    raise
            try:
                page.wait_for_load_state("load", timeout=8000)
            except Exception:
                pass
            if dismiss:
                self._nav_dismiss_overlays()
            return _lookup(self._nav_discover(selector, retries=3).get("items") or [])

        def _park_mouse(on_page):
            # Move the pointer off the menu so an open dropdown closes (and
            # does not cover the screenshot of the page that just opened).
            try:
                size = on_page.evaluate("() => [window.innerWidth, window.innerHeight]")
                on_page.mouse.move(max(1, size[0] - 3), max(1, size[1] - 3))
            except Exception:
                pass

        base_map = {}
        for entry in baseline:
            base_map[_nav_key(entry.get("path"))] = entry.get("href") or ""

        links = [it for it in items if _nav_link_kind(it) == "link"]
        no_link = len([it for it in items if _nav_link_kind(it) != "link" and not it.get("has_children")])
        lookup = _lookup(items)
        on_home = True
        rows = []

        try:
            for index, item in enumerate(links):
                key = _nav_key(item.get("path"))
                href = item.get("href") or ""
                row = {
                    "path": " > ".join(item.get("path") or []), "href": href, "status": "Passed",
                    "error": "", "note": "", "final_url": "", "http_status": None,
                    "screenshot": "", "duration": 0.0,
                }
                rows.append(row)
                if index >= max_items:
                    row["status"] = "Skipped"
                    row["error"] = "Not checked - the menu has more than %d links (the limit for one run)." % max_items
                    continue
                if time.time() - started > budget:
                    row["status"] = "Skipped"
                    row["error"] = ("Not checked - the time limit for one run (%d seconds) was reached before this "
                                    "item. Raise AGENT_TEST_TIMEOUT_SECONDS on the server to allow longer runs." % int(budget))
                    continue

                t0 = time.time()
                errors, notes = [], []
                target = page
                opened_pages = []
                try:
                    if not on_home:
                        lookup = _go_home()
                        on_home = True
                    current = lookup.get(key)
                    if current is None:
                        raise AssertionError("The item could not be found in the menu again after returning to the start page.")
                    href = current.get("href") or href
                    row["href"] = href

                    if base_map:
                        old = base_map.get(key)
                        if old is None:
                            notes.append("new item - not in the saved baseline")
                        elif _nav_norm(old) != _nav_norm(href):
                            errors.append("The link changed: it pointed to %s before and points to %s now." % (old, href))

                    el = page.locator('[data-atr-nav="%s"]' % current["id"]).first
                    opened = self._reveal_in_menu(el)
                    if not opened and dismiss and self._nav_dismiss_overlays():
                        opened = self._reveal_in_menu(el)  # something was covering the menu

                    before = list(ctx.pages)
                    nav_resp.pop(page, None)
                    nav_fail.pop(page, None)
                    del downloads[:]
                    del early_resp[:]
                    del early_fail[:]
                    url_before = page.url

                    if opened:
                        try:
                            el.click(timeout=5000)
                        except Exception as e:
                            if not _navigation_interrupted(e):
                                el.evaluate("node => node.click()")
                                notes.append("a normal click was blocked, so the link was activated directly")
                    else:
                        if strict_hover:
                            errors.append("The menu above this item did not open on hover, so a user could not reach it.")
                        else:
                            notes.append("the menu did not open on hover - the link was opened directly")
                        try:
                            el.evaluate("node => node.click()")
                        except Exception as e:
                            if not _navigation_interrupted(e):
                                raise

                    # ---- what happened? new tab / download / navigation ----
                    outcome = None
                    deadline = time.time() + nav_wait
                    while time.time() < deadline:
                        opened_pages = [p for p in ctx.pages if p not in before]
                        if opened_pages:
                            outcome, target = "new_tab", opened_pages[-1]
                            break
                        if downloads:
                            outcome = "download"
                            break
                        if page in nav_resp or page in nav_fail:
                            outcome = "navigated"
                            break
                        try:
                            if page.url != url_before:
                                outcome = "url_changed"
                                break
                            page.wait_for_timeout(100)
                        except Exception:
                            time.sleep(0.1)

                    if outcome == "new_tab":
                        end = time.time() + 15
                        while (time.time() < end and target not in nav_resp and target not in nav_fail
                               and not early_resp and not early_fail and not downloads):
                            try:
                                target.wait_for_timeout(150)
                            except Exception:
                                break
                        if target not in nav_resp and early_resp:
                            nav_resp[target] = early_resp[-1]
                        if target not in nav_fail and early_fail:
                            nav_fail[target] = early_fail[-1]
                    if outcome in ("new_tab", "navigated", "url_changed"):
                        try:
                            target.wait_for_load_state("domcontentloaded", timeout=15000)
                        except Exception:
                            pass
                        try:
                            target.wait_for_timeout(300)  # lets a late download event arrive
                        except Exception:
                            pass

                    if downloads:
                        name = ""
                        try:
                            name = downloads[-1].suggested_filename
                        except Exception:
                            pass
                        notes.append("opens a file download" + (" (%s)" % name if name else ""))
                        for download in list(downloads):
                            try:
                                download.cancel()
                            except Exception:
                                pass
                        if outcome == "new_tab":
                            notes.append("opens in a new tab")
                    elif outcome is None:
                        if _nav_strip_hash(href) == _nav_strip_hash(url_before):
                            notes.append("the link points to the page that is already open")
                        else:
                            errors.append("Clicking this item did nothing - no page opened within %d seconds." % int(nav_wait))
                    else:
                        try:
                            final_url = target.url
                        except Exception:
                            final_url = ""
                        row["final_url"] = final_url
                        response = nav_resp.get(target)
                        failure = nav_fail.get(target)
                        external = bool(final_url) and _nav_host(final_url) != home_host and not final_url.startswith("chrome-error")
                        check_content = True
                        if response is None and failure:
                            errors.append("The page failed to load (%s)." % failure)
                            check_content = False
                        elif response is not None:
                            status, _resp_url, ctype = response
                            row["http_status"] = status
                            if status >= 400:
                                check_content = False
                                if external and status in (401, 403, 429):
                                    notes.append("the external site refused the automated visit (HTTP %d) - check it by hand" % status)
                                else:
                                    errors.append("The page returned HTTP %d." % status)
                            elif ctype and "html" not in ctype.lower():
                                check_content = False
                                notes.append("opens a %s file" % ctype.split(";")[0].strip())
                        if check_content:
                            try:
                                state = target.evaluate(_NAV_PAGE_STATE_JS) or {}
                            except Exception:
                                state = {}
                            doc_type = (state.get("content_type") or "").lower()
                            if doc_type and "html" not in doc_type:
                                notes.append("opens a %s file" % doc_type)
                            elif state:
                                headline = ((state.get("title") or "") + " | " + (state.get("h1") or "")).lower()
                                if _NAV_ERROR_PAGE_RE.search(headline):
                                    errors.append("The page opened but looks like an error page (title: \"%s\")." % (state.get("title") or state.get("h1") or ""))
                                elif not state.get("text_len") and not state.get("media"):
                                    errors.append("The page opened but is blank.")
                        if outcome == "new_tab":
                            notes.append("opens in a new tab")
                        if external:
                            notes.append("external site")
                        if final_url and _nav_norm(final_url) != _nav_norm(href) and not final_url.startswith("chrome-error"):
                            notes.append("redirected to " + final_url)
                except Exception as e:
                    message = str(e).strip().splitlines()[0][:300] if str(e).strip() else type(e).__name__
                    errors.append(message if isinstance(e, AssertionError) else "%s: %s" % (type(e).__name__, message))

                # ---- evidence + clean up, never allowed to fail the row ----
                if shots == "all" or (shots == "failed" and errors):
                    try:
                        _park_mouse(target)
                        shots_dir.mkdir(parents=True, exist_ok=True)
                        shot_name = "step_menu_%03d.png" % (index + 1)
                        target.screenshot(path=str(shots_dir / shot_name), timeout=8000)
                        row["screenshot"] = shot_name
                    except Exception:
                        pass
                for extra in opened_pages:
                    try:
                        extra.close()
                    except Exception:
                        pass
                try:
                    on_home = page.url == home and page not in nav_resp and page not in nav_fail
                except Exception:
                    on_home = False
                self._nav_release()  # close the menu that was held open for this link
                if on_home:
                    _park_mouse(page)

                if errors:
                    row["status"] = "Failed"
                    row["error"] = " ".join(errors)
                row["note"] = "; ".join(notes)
                row["duration"] = round(time.time() - t0, 2)
                self.last_resolution = None
        finally:
            self._nav_release()
            for event, handler in (("response", _on_response), ("requestfailed", _on_failed), ("page", _on_page)):
                try:
                    ctx.remove_listener(event, handler)
                except Exception:
                    pass
            try:
                page.remove_listener("download", _on_download)
            except Exception:
                pass

        # Items the baseline had that are not in the menu any more.
        if base_map:
            present = set(_nav_key(it.get("path")) for it in items)
            for entry in baseline:
                if _nav_key(entry.get("path")) not in present:
                    rows.append({
                        "path": " > ".join(entry.get("path") or []), "href": entry.get("href") or "",
                        "status": "Failed", "note": "", "final_url": "", "http_status": None, "screenshot": "",
                        "duration": 0.0,
                        "error": "This item was in the menu before (saved baseline) but is not in the menu now.",
                    })

        passed = len([r for r in rows if r["status"] == "Passed"])
        return {
            "home": home,
            "root": disc.get("root") or "",
            "rows": rows,
            "discovered": [{"path": it.get("path") or [], "href": it.get("href") or ""} for it in links],
            "summary": {
                "total": len(rows), "passed": passed, "failed": len(rows) - passed,
                "items_without_link": no_link, "popups_closed": dismissed,
                "seconds": round(time.time() - started, 1),
            },
        }


# ----------------------------------------------------------------------
# Helpers for the navigation-menu code above (module level so the long
# JavaScript snippets are not re-built on every call).
# ----------------------------------------------------------------------
import re as _nav_re
from urllib.parse import urlsplit as _nav_urlsplit

# Title / main heading of a page that "opened fine" (HTTP 200) but is
# really an error page.
_NAV_ERROR_PAGE_RE = _nav_re.compile(
    r"(^\s*(404|500|502|503)\b"
    r"|\b(page|file|resource)\s+not\s+found\b"
    r"|\b404\s+not\s+found\b"
