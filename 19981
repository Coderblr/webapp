  window.__flushActions = function () {
    var q = window.__recordedQueue;
    window.__recordedQueue = [];
    persistQueue();
    return q;
  };

  // Exposed so the Python side (recorder/recorder.py) can compute a stable
  // CSS path for an <iframe>/<frame> DOM ELEMENT from *inside the PARENT
  // frame's context* (Playwright's Frame.frame_element() returns that
  // element handle, but it has to be evaluated against the parent frame,
  // not the iframe's own document) - this is how mainframe/iframe support
  // builds a "frame_path" (a chain of selectors from the top page down to
  // the frame an action happened in) without needing any new JS of its
  // own; it just reuses the same cssPath() this file already uses for
  // in-page elements. See Recorder._frame_path_for.
  window.__recorderCssPathFor = cssPath;
})();
