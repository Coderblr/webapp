"""
Runs the generated behave suite and returns structured pass/fail output.

Uses a real subprocess so every run gets a genuinely fresh, isolated
Python process - important because behave keeps process-wide global state
(step registrations, and evidently more than just that - see the history
below) that leaks across runs sharing one process.

IMPORTANT for the local desktop agent (local_agent/): `sys.executable`
inside a PyInstaller-frozen executable (see local_agent/local_agent.spec)
is the path to the FROZEN .EXE ITSELF, not a real Python interpreter -
there is no separate "python.exe" to shell out to. `[sys.executable, "-m",
"behave", ...]` would try to re-launch the agent app with nonsense
arguments instead of actually running behave, which is exactly why "Start
Recording" (in-process, via recorder/recorder.py - no subprocess involved)
worked from a packaged local_agent.exe while "Run" (this file, subprocess-
based) did not.

Two things were tried and abandoned before landing on the current design -
documented here so nobody re-attempts them:

  1. In-process invocation (`behave.__main__.main()` called directly, no
     subprocess at all) when frozen. This worked for a SINGLE run, but a
     second test run in the same long-running agent process failed with
     "AmbiguousStep: ... has already been defined" - even after explicitly
     resetting `behave.step_registry.registry` before each call. Something
     else internal to behave (never fully identified - possibly a
     `Runner`/`ModelRunner`-level cache, possibly matcher-level state) was
     still holding onto the first run's step definitions. Chasing down and
     resetting every piece of undocumented internal state behave might
     accumulate is fragile and not a fight worth continuing.

  2. This settled on: have the frozen exe RE-INVOKE ITSELF as a subprocess
     with a hidden `--behave-worker <behave CLI args>` flag it recognizes
     (see local_agent/main.py) - `sys.executable` inside a frozen build
     correctly points at the exe's own path, so `[sys.executable,
     "--behave-worker", ...]` genuinely launches a fresh copy of the same
     .exe, which short-circuits straight to `behave.__main__.main()` and
     exits. This gives every test run its own real, fully independent OS
     process - identical isolation to the non-frozen path's real
     `python.exe` subprocess, just self-hosted instead of relying on a
     system Python that doesn't exist in a frozen build.
"""
from __future__ import annotations
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parent.parent


def run_behave_cli(behave_args: list[str], cwd: str, env_overrides: dict) -> dict:
    """Runs behave with `behave_args` (e.g. [features_dir, "--no-capture"]),
    returning {"returncode", "output"}. Always a real subprocess - see this
    module's docstring for why a frozen build spawns itself rather than a
    system Python."""
    full_env = {**os.environ, **env_overrides}

    if getattr(sys, "frozen", False):
        cmd = [sys.executable, "--behave-worker", *behave_args]
    else:
        cmd = [sys.executable, "-m", "behave", *behave_args]

    proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, env=full_env)
    return {"returncode": proc.returncode, "output": proc.stdout + "\n" + proc.stderr}


def run(output_dir: str = "output", headless: bool = False) -> dict:
    features_dir = Path(output_dir) / "features"
    if not features_dir.exists():
        return {"ok": False, "returncode": -1, "output": f"No features found at {features_dir}. Generate first."}

    result = run_behave_cli(
        [str(features_dir), "--no-capture"],
        cwd=str(ROOT),
        env_overrides={"HEADLESS": "true" if headless else "false"},
    )
    return {"ok": result["returncode"] == 0, "returncode": result["returncode"], "output": result["output"]}


if __name__ == "__main__":
    result = run()
    print(result["output"])
    sys.exit(result["returncode"])
