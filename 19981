@echo off
setlocal enableextensions
rem ====================================================================
rem  Makes ONE self-extracting setup .exe from the already-built app
rem  (electron\dist\win-unpacked). No NSIS, no internet needed.
rem  Needs 7-Zip installed (https://www.7-zip.org/).
rem
rem  Run from the electron folder:   ..\make_single_exe.bat
rem  or copy this file into electron\ and run:  make_single_exe.bat
rem  Result: dist\AI-Test-Recorder-Setup-Single.exe
rem ====================================================================
cd /d "%~dp0"

set "SEVENZ=%ProgramFiles%\7-Zip\7z.exe"
set "SFX=%ProgramFiles%\7-Zip\7z.sfx"
if not exist "%SEVENZ%" set "SEVENZ=%ProgramFiles(x86)%\7-Zip\7z.exe"
if not exist "%SFX%" set "SFX=%ProgramFiles(x86)%\7-Zip\7z.sfx"
if not exist "%SEVENZ%" goto :no7z
if not exist "%SFX%" goto :no7z
if not exist "dist\win-unpacked\AI Test Recorder.exe" goto :noapp
if not exist "dist\win-unpacked\resources\local_agent\local_agent.exe" goto :noagent

echo [1/3] Packing the app (can take several minutes)...
if exist dist\payload.7z del /q dist\payload.7z
"%SEVENZ%" a -t7z -mx=3 -mmt=on dist\payload.7z ".\dist\win-unpacked\*" >nul
if errorlevel 1 goto :fail

echo [2/3] Writing the installer settings...
> dist\sfx-config.txt (
echo ;!@Install@!UTF-8!
echo Title="AI Test Recorder"
echo BeginPrompt="Install AI Test Recorder on this PC?"
echo InstallPath="%%LOCALAPPDATA%%\AITestRecorder"
echo GUIFlags="8+32+64+256+4096"
echo OverwriteMode="1"
echo RunProgram="\"AI Test Recorder.exe\""
echo ;!@InstallEnd@!
)

echo [3/3] Building the single .exe...
copy /b "%SFX%" + dist\sfx-config.txt + dist\payload.7z dist\AI-Test-Recorder-Setup-Single.exe >nul
if errorlevel 1 goto :fail
del /q dist\payload.7z dist\sfx-config.txt

echo.
echo Done: electron\dist\AI-Test-Recorder-Setup-Single.exe
echo Testers double-click it; it installs to %%LOCALAPPDATA%%\AITestRecorder and starts the app.
exit /b 0

:no7z
echo ERROR: 7-Zip not found (needs 7z.exe and 7z.sfx in its install folder). Install it from https://www.7-zip.org/
exit /b 1
:noapp
echo ERROR: dist\win-unpacked\AI Test Recorder.exe is missing. Run "npm run build:zip" first.
exit /b 1
:noagent
echo ERROR: the agent is missing from dist\win-unpacked\resources\local_agent. Rebuild the agent first.
exit /b 1
:fail
echo ERROR: could not create the .exe. Read the messages above.
exit /b 1
