"""Semantic generated-code validation (Part 5).

The existing compiler (backend/codegen/compiler.py) checks Python
SYNTAX — but syntax-correct code can still be semantically broken in
ways that only surface deep inside a live browser session, wasting the
whole Section-11 pipeline before anyone finds out:

  - a Gherkin step with no matching (or an ambiguous) step definition
  - a step definition that calls a page-object method that doesn't exist
  - a locator that's empty, missing a strategy, or plainly fabricated
  - a <Placeholder> the feature file references that no test-data field
    actually supplies

This module catches all of those STATICALLY, right after codegen and
before compile/execute — for the cost of parsing files that are already
sitting on disk, not a browser session.

Reuses backend/framework_index/{python_parser,text_formats}.py rather
than re-implementing Python/Gherkin parsing a second time — those are
already the platform's single source of truth for "what does this file
actually define".
"""
from __future__ import annotations

import re
from pathlib import Path
from typing import Any

from ..core.config import settings
from ..core.logging_conf import get_logger
from ..framework_index import python_parser, text_formats
from ..knowledge import repository as repo
from ..tdm import templates as tdm_templates
from . import compiler

log = get_logger(__name__)

_GHERKIN_KEYWORD_RE = re.compile(r"^(Given|When|Then|And|But)\s+", re.I)
_PLACEHOLDER_RE = re.compile(r"<([A-Za-z_][A-Za-z0-9_]*)>")
_FABRICATED_MARKERS = ("todo", "placeholder", "fixme", "xxx", "fabricated",
                        "changeme", "dummy_locator", "unknown")


def _pattern_to_regex(pattern: str) -> re.Pattern[str]:
    """Converts a behave `parse`-style pattern (`user enters "{value}" in
    "Account Name"`) into a regex that matches an actual Gherkin step's
    text, so step-existence checking doesn't need a real behave runtime."""
    parts = re.split(r"(\{[a-zA-Z_][a-zA-Z0-9_]*(?::\w+)?\})", pattern)
    out = []
    for part in parts:
        if part.startswith("{") and part.endswith("}"):
            out.append(r".+?")
        else:
            out.append(re.escape(part))
    return re.compile("^" + "".join(out) + "$")


def collect_step_registry(steps_dir: Path) -> dict[str, list[str]]:
    """pattern -> [file:line, ...] across EVERY step file — this must be
    global, not scoped to one transaction, because behave itself loads
    every file under features/steps/ into one shared registry (this is
    exactly the mechanism that produced the real AmbiguousStep failures
    this platform hit — two independently-generated transactions each
    defining an identical step for a shared field label, and separately,
    a STALE leftover generated file — e.g. a transaction re-generated
    under a corrected id/naming convention, with its old file never
    deleted — silently reintroducing a duplicate no amount of correct
    NEW-generation logic can catch, since it's an old file sitting
    there, not something this run just produced).
    """
    registry: dict[str, list[str]] = {}
    if not steps_dir.exists():
        return registry
    for steps_file in sorted(steps_dir.glob("*.py")):
        try:
            for cls in python_parser.parse_file(steps_file):
                for method in cls.methods:
                    if method.gherkin_pattern:
                        registry.setdefault(method.gherkin_pattern, []).append(
                            f"{steps_file.name}:{method.line_start}"
                        )
        except Exception as exc:  # noqa: BLE001
            log.warning("Could not parse %s for step registry: %s", steps_file, exc)
    return registry


def find_ambiguous_steps(steps_dir: Path) -> dict[str, list[str]]:
    """Public entry point for anything OUTSIDE the full
    `validate_transaction()` flow that just wants the duplicate-step
    check on its own — e.g. execution/pipeline.py's preflight, which
    needs to catch a stale/orphaned generated file BEFORE handing off to
    behave (an `AmbiguousStep` there is a hard crash 30-90+ seconds into
    a live browser session, not a clean, immediate, actionable
    pre-flight failure). Returns only the patterns with more than one
    definition."""
    registry = collect_step_registry(steps_dir)
    return {p: locs for p, locs in registry.items() if len(locs) > 1}


def _collect_page_methods(page_path: Path) -> set[str]:
    if not page_path.exists():
        return set()
    methods: set[str] = set()
    for cls in python_parser.parse_file(page_path):
        methods.update(m.name for m in cls.methods)
    return methods


def _collect_called_page_methods(steps_path: Path) -> set[str]:
    """`page.something(...)` calls anywhere in a steps file — a plain
    regex is deliberately used here instead of a full AST call-graph:
    every generated steps file follows the fixed `page.<method>(...)`
    convention from steps.py.j2, so this is exact for generated code and
    still a reasonable best-effort for hand-edited CUSTOM CODE blocks."""
    if not steps_path.exists():
        return set()
    text = steps_path.read_text(encoding="utf-8", errors="ignore")
    return set(re.findall(r"\bpage\.([a-zA-Z_][a-zA-Z0-9_]*)\s*\(", text))


def _validate_locators(page_path: Path, transaction_id: str) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    if not page_path.exists():
        return errors, warnings

    known_keys: set[str] | None = None
    try:
        txn = repo.get_transaction(transaction_id)
        if txn:
            known_keys = {e["element_key"] for e in repo.get_elements(int(txn["id"]))}
    except Exception:
        known_keys = None  # knowledge repo not reachable — skip the cross-reference, don't fail the whole check

    text = page_path.read_text(encoding="utf-8", errors="ignore")
    for match in re.finditer(
        r'locator_repo\.register\(\s*(\w+)\s*,\s*\[(.*?)\]\s*\)', text, re.S
    ):
        constant_name, body = match.group(1), match.group(2)
        entries = re.findall(r'\(By\.([A-Z_]+)\s*,\s*"((?:[^"\\]|\\.)*)"\)', body)
        if not entries:
            errors.append(f"{page_path.name}: {constant_name} has no valid "
                           f"(By.X, \"value\") locator entries — empty or unparsable")
            continue
        for strategy, value in entries:
            if not value.strip():
                errors.append(f"{page_path.name}: {constant_name} has an empty locator value")
            elif any(marker in value.lower() for marker in _FABRICATED_MARKERS):
                errors.append(f"{page_path.name}: {constant_name} locator value "
                               f"'{value}' looks fabricated/placeholder, not a real "
                               f"recorded selector")

    if known_keys is not None:
        registered_element_keys = set(re.findall(r'^([A-Z_][A-Z0-9_]*)\s*=\s*"([^"]+)"',
                                                   text, re.M))
        for _const, key in registered_element_keys:
            if "::" in key and key not in known_keys:
                warnings.append(f"{page_path.name}: element_key '{key}' is not in the "
                                 f"knowledge repository for transaction {transaction_id} "
                                 f"— locator may have been hand-added rather than recorded")
    return errors, warnings


def _validate_test_data_placeholders(feature_path: Path, transaction_id: str) -> list[str]:
    errors: list[str] = []
    if not feature_path.exists():
        return errors
    text = feature_path.read_text(encoding="utf-8", errors="ignore")
    placeholders = set(_PLACEHOLDER_RE.findall(text))
    if not placeholders:
        return errors
    try:
        known_fields = {m["field"] for m in tdm_templates.get_field_metadata(transaction_id)}
    except Exception:
        return errors  # can't reach test-data metadata — don't fail the whole check on that
    for token in placeholders:
        if token not in known_fields:
            errors.append(f"{feature_path.name}: <{token}> has no matching test-data field "
                           f"— an AI-invented or stale variable would silently fail at "
                           f"execution time instead of being caught here")
    return errors


def validate_transaction(transaction_id: str) -> dict[str, Any]:
    """The main entry point — run every check for one transaction's
    generated artefacts and return Part 5's exact response shape."""
    errors: list[str] = []
    warnings: list[str] = []
    checks: dict[str, Any] = {}

    src = settings.framework_src_path
    txn_dir = src / "features" / "transactions" / f"Transaction_{transaction_id}"
    steps_dir = src / "features" / "steps"
    from ..codegen import naming
    page_class = naming.transaction_class(transaction_id, "Page")
    steps_class = naming.transaction_class(transaction_id, "Steps")
    from ..codegen.generator import _python_module_name
    page_path = src / "pages" / f"{_python_module_name(page_class)}.py"
    steps_path = steps_dir / f"{_python_module_name(steps_class)}.py"
    feature_files = sorted(txn_dir.glob("*.feature")) if txn_dir.exists() else []

    # A. Python syntax — delegates to the existing compiler (Part 5A)
    py_result = compiler.compile_transaction(transaction_id)
    checks["python_syntax"] = {"ok": py_result.ok, "files": py_result.files_compiled}
    if not py_result.ok:
        errors.extend(f"{e.file}:{e.line}: {e.message}" for e in py_result.errors)

    # B. Gherkin validity
    gherkin_ok = bool(feature_files)
    if not feature_files:
        errors.append(f"No .feature file found under {txn_dir}")
    for feature_path in feature_files:
        parsed = text_formats.parse_feature_file(feature_path)
        if not parsed["feature"]:
            errors.append(f"{feature_path.name}: no 'Feature:' line found")
            gherkin_ok = False
        if not parsed["scenarios"]:
            errors.append(f"{feature_path.name}: no Scenario found")
            gherkin_ok = False
        if not parsed["steps"]:
            warnings.append(f"{feature_path.name}: no steps found in any scenario")
    checks["gherkin_valid"] = gherkin_ok

    # C. Step-definition matching (missing / duplicate / ambiguous)
    registry = collect_step_registry(steps_dir)
    duplicates = {p: locs for p, locs in registry.items() if len(locs) > 1}
    if duplicates:
        for pattern, locations in duplicates.items():
            errors.append(f"Ambiguous step '{pattern}' defined in: {', '.join(locations)}")
    checks["duplicate_step_definitions"] = list(duplicates.keys())

    compiled_patterns = [(p, _pattern_to_regex(p)) for p in registry]
    missing_steps: list[str] = []
    for feature_path in feature_files:
        parsed = text_formats.parse_feature_file(feature_path)
        for raw_step in parsed["steps"]:
            step_text = _GHERKIN_KEYWORD_RE.sub("", raw_step).strip()
            if not any(rx.match(step_text) for _p, rx in compiled_patterns):
                missing_steps.append(f"{feature_path.name}: {raw_step}")
    if missing_steps:
        errors.extend(f"No step definition matches: {m}" for m in missing_steps)
    checks["missing_step_definitions"] = missing_steps

    # D. Page-object validation
    page_methods = _collect_page_methods(page_path)
    called_methods = _collect_called_page_methods(steps_path)
    unknown_calls = sorted(called_methods - page_methods) if page_methods else []
    if page_path.exists() and unknown_calls:
        errors.extend(f"{steps_path.name} calls page.{m}() which "
                       f"{page_path.name} does not implement" for m in unknown_calls)
    checks["page_object_methods_ok"] = not unknown_calls

    # E. Locator validation
    locator_errors, locator_warnings = _validate_locators(page_path, transaction_id)
    errors.extend(locator_errors)
    warnings.extend(locator_warnings)
    checks["locators_ok"] = not locator_errors

    # F. Test-data validation
    for feature_path in feature_files:
        errors.extend(_validate_test_data_placeholders(feature_path, transaction_id))
    checks["test_data_variables_ok"] = not any(
        "no matching test-data field" in e for e in errors
    )

    # G. Framework reuse — an ambiguous/duplicate step (checked in C above)
    # IS the concrete, detectable symptom of a missed reuse opportunity,
    # so it's not duplicated as a separate check here.
    checks["framework_reuse_checked"] = True

    return {"ok": not errors, "errors": errors, "warnings": warnings, "checks": checks}
