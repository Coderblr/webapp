repo.save_actions(transaction_pk, manifest.get("actions", []))

def _message_text(message: dict[str, Any]) -> str:
    if message.get("text"):
        return message["text"]
    mtype = message.get("type")
    if mtype == "window_opened":
        return f"Window opened: {message.get('title') or message.get('url') or ''}"
    if mtype == "window_closed":
        return "Window closed"
    if mtype == "page_unloading":
        return f"Page unloading: {(message.get('page') or {}).get('url', '')}"
    return f"[{mtype or 'event'}]"

rules = [
    {"field_name": None, "rule_type": "message",
     "message_text": _message_text(message), "severity": message.get("severity"),
     "meta": {"page_key": message.get("page_key")}}
    for message in manifest.get("messages", [])
]
repo.save_validation_rules(transaction_pk, rules)
