@echo off
setlocal enableextensions
rem Installs AI Test Recorder from AI-Test-Recorder.zip (next to this file) - no admin rights needed.
set "DEST=%LOCALAPPDATA%\AITestRecorder"
set "ZIP=%~dp0AI-Test-Recorder.zip"
if not exist "%ZIP%" (
  echo ERROR: AI-Test-Recorder.zip was not found next to this installer.
  pause
  exit /b 1
)
echo Installing AI Test Recorder to %DEST%
echo This can take a few minutes - please wait...
taskkill /F /IM "AI Test Recorder.exe" >nul 2>&1
taskkill /F /IM local_agent.exe >nul 2>&1
taskkill /F /IM behave_worker.exe >nul 2>&1
if not exist "%DEST%" mkdir "%DEST%"
tar -xf "%ZIP%" -C "%DEST%"
if errorlevel 1 (
  powershell -NoProfile -ExecutionPolicy Bypass -Command "Expand-Archive -LiteralPath '%ZIP%' -DestinationPath '%DEST%' -Force"
)
set "EXE="
for /r "%DEST%" %%F in ("AI Test Recorder.exe") do if not defined EXE if exist "%%~fF" set "EXE=%%~fF"
if not defined EXE (
  echo ERROR: the app was not found after extracting. Ask your admin for help.
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=(New-Object -ComObject WScript.Shell).CreateShortcut([Environment]::GetFolderPath('Desktop')+'\AI Test Recorder.lnk'); $s.TargetPath='%EXE%'; $s.WorkingDirectory=(Split-Path '%EXE%'); $s.Save()" >nul 2>&1
echo.
echo Done. A shortcut "AI Test Recorder" was added to your Desktop. Starting the app...
start "" "%EXE%"
exit /b 0
