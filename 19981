import { useEffect, useState } from "react";
import { transactionsApi } from "@/lib/api";
import { useAuth } from "@/context/AuthContext";
import ReportView from "@/components/ReportView";
import { Panel, PanelHeader, Callout, Spinner, StatusBadge, Button } from "@/components/ui";

/**
 * "My Executions" - every run the current user has performed (an admin
 * sees their own here too; broader admin-wide visibility already exists
 * separately in the admin panel). Backed by GET /api/transactions, which
 * is scoped server-side to the current user unless they're an admin
 * explicitly asking for someone else - so this component never needs to
 * pass user_id itself.
 */
export default function MyExecutionsTab() {
  const { user } = useAuth();
  const [transactions, setTransactions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const [selectedId, setSelectedId] = useState(null);
  const [selectedReport, setSelectedReport] = useState(null);
  const [reportLoading, setReportLoading] = useState(false);
  const [reportError, setReportError] = useState(null);

  useEffect(() => {
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function load() {
    setLoading(true);
    setError(null);
    try {
      const r = await transactionsApi.list({ limit: 100 });
      setTransactions(r);
    } catch (e) {
      setError(e.detail || e.message);
    } finally {
      setLoading(false);
    }
  }

  async function handleView(transactionId) {
    setSelectedId(transactionId);
    setSelectedReport(null);
    setReportError(null);
    setReportLoading(true);
    try {
      const r = await transactionsApi.get(transactionId);
      setSelectedReport(r);
    } catch (e) {
      setReportError(e.detail || e.message);
    } finally {
      setReportLoading(false);
    }
  }

  return (
    <div className="grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-[22rem_1fr]">
      <div className="min-w-0 space-y-4">
        <Panel>
          <PanelHeader
            title="My executions"
            caption={`Every recording ${user?.first_name ? `${user.first_name} has` : "you've"} run, most recent first.`}
          />
          <div className="min-w-0 px-5 py-5">
            {loading && <Spinner label="Loading your execution history..." />}
            {error && <Callout tone="error">Could not load execution history: {error}</Callout>}
            {!loading && !error && transactions.length === 0 && (
              <p className="text-sm text-muted">No executions yet - run a recording from the other tab and it'll show up here.</p>
            )}
            {!loading && !error && transactions.length > 0 && (
              <div className="max-h-[32rem] space-y-1 overflow-y-auto scroll-thin">
                {transactions.map((t) => (
                  <button
                    key={t.transaction_id}
                    type="button"
                    onClick={() => handleView(t.transaction_id)}
                    className={`block w-full rounded-sm border px-3 py-2.5 text-left transition-colors ${
                      selectedId === t.transaction_id ? "border-brand-blue bg-brand-blueLight" : "border-line bg-panel hover:border-brand-blue/40"
                    }`}
                  >
                    <div className="flex items-center justify-between gap-2">
                      <span className="min-w-0 truncate text-sm font-medium text-ink">{t.transaction_name}</span>
                      <StatusBadge status={t.status} />
                    </div>
                    <div className="mt-1 flex items-center justify-between gap-2 text-xs text-muted">
                      <span>{t.date_time}</span>
                      <span>
                        {t.passed_count ?? "—"}/{t.step_count ?? "—"} passed
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            )}
            <Button variant="secondary" onClick={load} className="mt-3 w-full" disabled={loading}>
              Refresh
            </Button>
          </div>
        </Panel>
      </div>

      <div className="min-w-0 space-y-4">
        {reportLoading && (
          <Panel>
            <div className="px-5 py-10">
              <Spinner label="Loading execution report..." />
            </div>
          </Panel>
        )}
        {reportError && (
          <Panel>
            <div className="px-5 py-5">
              <Callout tone="error">Could not load this execution's report: {reportError}</Callout>
            </div>
          </Panel>
        )}
        {!reportLoading && !reportError && selectedReport && <ReportView key={selectedReport.transaction_id} report={selectedReport} />}
        {!reportLoading && !reportError && !selectedReport && (
          <Panel>
            <div className="px-5 py-10 text-center text-sm text-muted">Pick an execution on the left to see its full report.</div>
          </Panel>
        )}
      </div>
    </div>
  );
}
