"""Field metadata inference (Section 7.2).

The recorder stores metadata about every input, never the raw value.
Banking data is ALWAYS supplied by the SBI user — this module classifies
fields so the platform knows what to ask for and how to validate it.
"""
from __future__ import annotations

import re
from typing import Any, Optional

from ..core.security import is_sensitive

# datatype → (regex pattern, business meaning, sensitive, ai_generatable)
DATATYPES: dict[str, tuple[str, str, bool, bool]] = {
    "PAN":        (r"[A-Z]{5}[0-9]{4}[A-Z]", "Permanent Account Number", False, False),
    "CIF":        (r"\d{11}", "Customer Information File number", True, False),
    "ACCOUNT":    (r"\d{9,18}", "Bank account number", True, False),
    "IFSC":       (r"[A-Z]{4}0[A-Z0-9]{6}", "IFSC code", False, False),
    "AADHAAR":    (r"\d{12}", "Aadhaar number", True, False),
    "MOBILE":     (r"[6-9]\d{9}", "Indian mobile number", False, False),
    "EMAIL":      (r"[^@\s]+@[^@\s]+\.[A-Za-z]{2,}", "Email address", False, True),
    "AMOUNT":     (r"\d+(\.\d{1,2})?", "Monetary amount", False, False),
    "BRANCHCODE": (r"\d{4,5}", "Branch code", False, False),
    "TELLERID":   (r"[A-Za-z0-9]{4,12}", "Teller / maker user id", True, False),
    "CHECKERID":  (r"[A-Za-z0-9]{4,12}", "Checker user id", True, False),
    "PASSWORD":   (r".{6,}", "Login password", True, False),
    "DATE":       (r"\d{2}[-/]\d{2}[-/]\d{4}", "Date value", False, False),
    "CURRENCY":   (r"[A-Z]{3}", "Currency code", False, False),
    "NAME":       (r"[A-Za-z .'-]{2,}", "Customer / person name", False, False),
    "TEXT":       (r".*", "Free text", False, False),
    "REMARKS":    (r".*", "Cosmetic remarks / narration", False, True),
}

_HINTS: list[tuple[re.Pattern[str], str]] = [
    # Must come before every specific-datatype hint below — a field name
    # ENDING in "Only"/"Flag"/"Indicator" is almost always a configuration
    # toggle (e.g. "PasswordLocalOverrideOnly" is a Y/N setting about WHEN
    # a password override applies, not a password value itself; likewise
    # "AccountLockFlag", "AmountCapIndicator"), even though it may contain
    # an unrelated datatype keyword like "password"/"account"/"amount" as
    # a substring earlier in the name. Force these through the permissive
    # TEXT pattern instead of whatever specific, over-strict pattern the
    # embedded keyword would otherwise trigger — a real toggle value
    # ("Y"/"N", "true"/"false", "1"/"0") would fail almost any of the
    # specific datatype patterns (e.g. PASSWORD's `.{6,}` minimum length).
    (re.compile(r"(only|flag|indicator)\s*$", re.I), "TEXT"),
    (re.compile(r"\bpan\b", re.I), "PAN"),
    (re.compile(r"\bcif\b|customer\s*info", re.I), "CIF"),
    (re.compile(r"account\s*(no|num|number)|\bacct\b", re.I), "ACCOUNT"),
    (re.compile(r"\bifsc\b", re.I), "IFSC"),
    (re.compile(r"aadha?ar|uid", re.I), "AADHAAR"),
    (re.compile(r"mobile|phone|contact\s*no", re.I), "MOBILE"),
    (re.compile(r"e-?mail", re.I), "EMAIL"),
    (re.compile(r"amount|amt|deposit|withdraw|balance|principal", re.I), "AMOUNT"),
    (re.compile(r"branch\s*code|\bsol\b", re.I), "BRANCHCODE"),
    (re.compile(r"teller|maker", re.I), "TELLERID"),
    # Must come before the generic "name" hint below — a login/user-ID
    # field's HTML `name`/`id` attribute very commonly looks like
    # "userName"/"userId"/"loginId" (a routine naming convention, not a
    # person's name), and that attribute value feeds straight into the
    # haystack infer_datatype() searches. Without this, such a field gets
    # misclassified as NAME (letters/spaces/dots/hyphens only), and any
    # real alphanumeric SBI user id then fails validation against that
    # letters-only pattern before it ever reaches the browser.
    (re.compile(r"user\s*-?\s*(id|name)|login\s*-?\s*(id|name)", re.I), "TELLERID"),
    (re.compile(r"checker|approver|supervisor", re.I), "CHECKERID"),
    (re.compile(r"pass\s*word|\bpwd\b|\bpin\b", re.I), "PASSWORD"),
    (re.compile(r"date|dob|\bdt\b", re.I), "DATE"),
    (re.compile(r"currency|\bccy\b", re.I), "CURRENCY"),
    (re.compile(r"remark|narration|comment|description", re.I), "REMARKS"),
    # Must come before the generic "name" hint below — navigation/search
    # fields like "Enter screen number or part of screen name" contain the
    # substring "name" but hold a transaction number or partial screen
    # title, not a person's name, and must not be forced through the
    # letters-only NAME pattern.
    (re.compile(r"screen\s*(no|number|name)|search\s*(box|field|transaction)",
                re.I), "TEXT"),
    (re.compile(r"name", re.I), "NAME"),
]

# Which sources are allowed to supply which datatype (Section 7.1)
USER_ONLY = {
    "PAN", "CIF", "ACCOUNT", "IFSC", "AADHAAR", "BRANCHCODE",
    "TELLERID", "CHECKERID", "PASSWORD", "AMOUNT", "MOBILE",
    "NAME", "DATE", "CURRENCY", "TEXT", "EMAIL",
}
# Section 7.1: AI may generate ONLY cosmetic, non-validated filler.
AI_ALLOWED = {"REMARKS"}


def infer_datatype(field_name: str, element_meta: dict[str, Any] | None = None) -> str:
    haystack = " ".join(
        str(x) for x in [
            field_name,
            (element_meta or {}).get("label"),
            ((element_meta or {}).get("attributes") or {}).get("name"),
            ((element_meta or {}).get("attributes") or {}).get("id"),
            ((element_meta or {}).get("attributes") or {}).get("placeholder"),
        ] if x
    )
    for pattern, datatype in _HINTS:
        if pattern.search(haystack):
            return datatype
    element_type = (element_meta or {}).get("element_type") or ""
    if element_type == "password":
        return "PASSWORD"
    if element_type == "calendar":
        return "DATE"
    return "TEXT"


def build(
    field_name: str,
    element_meta: dict[str, Any] | None = None,
    required: Optional[bool] = None,
    element_key: str | None = None,
    recorded_value: str | None = None,
    allow_sensitive_recorded_value: bool = False,
) -> dict[str, Any]:
    """Produce the Section 7.2 metadata block for one field."""
    meta = element_meta or {}
    datatype = infer_datatype(field_name, meta)
    pattern, meaning, sensitive_default, ai_ok = DATATYPES.get(
        datatype, DATATYPES["TEXT"]
    )
    element_pattern = meta.get("pattern") or (meta.get("attributes") or {}).get("pattern")
    sensitive = sensitive_default or is_sensitive(field_name)
    return {
        "field": field_name,
        "datatype": datatype,
        "required": bool(
            required if required is not None
            else meta.get("required") or (meta.get("attributes") or {}).get("required")
        ),
        "pattern": element_pattern or pattern,
        "business_meaning": meaning,
        "sensitive": bool(sensitive),
        "editable": not bool(meta.get("readonly")),
        "source": "ai" if datatype in AI_ALLOWED else "user",
        "source_config": {
            "ai_generatable": datatype in AI_ALLOWED,
            "user_only": datatype in USER_ONLY,
            "max_length": meta.get("maxlength"),
            "options": (meta.get("options") or None),
        },
        "element_key": element_key,
        # A sensitive field only ever gets its recorded_value stored when
        # the recording session ITSELF explicitly opted into
        # `capture_sensitive_values` — a deliberate, informed, per-
        # session choice (e.g. a UAT environment that only ever uses
        # dummy/test credentials, never real ones), never the default.
        "recorded_value": (
            recorded_value if (not sensitive or allow_sensitive_recorded_value) else None
        ),
    }


def validate(value: str, meta: dict[str, Any]) -> tuple[bool, str]:
    """Check a user-supplied value against the field's pattern."""
    if meta.get("required") and not (value or "").strip():
        return False, f"{meta['field']} is mandatory"
    if not value:
        return True, ""
    pattern = meta.get("pattern")
    if pattern:
        try:
            if not re.fullmatch(pattern, value):
                return False, (
                    f"{meta['field']} does not match expected format for "
                    f"{meta.get('datatype')} ({pattern})"
                )
        except re.error:
            return True, ""
    max_length = (meta.get("source_config") or {}).get("max_length")
    if max_length and len(value) > int(max_length):
        return False, f"{meta['field']} exceeds max length {max_length}"
    return True, ""


def ai_may_generate(meta: dict[str, Any]) -> bool:
    """Section 7.1 — AI generates only cosmetic, non-validated fields."""
    return bool((meta.get("source_config") or {}).get("ai_generatable")) and not meta.get(
        "sensitive"
    )
