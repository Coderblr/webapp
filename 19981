"""Microsoft Edge driver factory (thread-local — one WebDriver per
execution process).

No Maven/Gradle/JDK needed — Selenium + msedgedriver come straight from
``pip install selenium`` and the driver binary on PATH / ``SBI_EDGE_DRIVER``.
"""
from __future__ import annotations

import os
import threading

from selenium import webdriver
from selenium.webdriver.edge.options import Options as EdgeOptions
from selenium.webdriver.edge.service import Service as EdgeService

from utils import execution_context as ctx

_local = threading.local()


def get_driver() -> webdriver.Edge:
    driver = getattr(_local, "driver", None)
    if driver is None:
        driver = _create()
        _local.driver = driver
    return driver


def _bypass_proxy_for_local_webdriver() -> None:
    """Exclude localhost/127.0.0.1 from the corporate HTTP proxy.

    Same fix as backend/recorder/cdp_recorder.py::_bypass_proxy_for_local_webdriver
    — see that docstring for the full "Access Denied (authentication_failed)"
    explanation. This execution-side driver factory needs it independently:
    the recorder and the execution framework are separate processes, so the
    NO_PROXY fix applied in one does not carry over to the other.
    """
    for var in ("NO_PROXY", "no_proxy"):
        current = os.environ.get(var, "")
        entries = {e.strip() for e in current.split(",") if e.strip()}
        entries.update({"localhost", "127.0.0.1", "::1"})
        os.environ[var] = ",".join(sorted(entries))


def _create() -> webdriver.Edge:
    _bypass_proxy_for_local_webdriver()
    driver_path = ctx.get("edgeDriver", os.environ.get("SBI_EDGE_DRIVER"))

    options = EdgeOptions()
    options.add_argument("--start-maximized")
    options.add_argument("--disable-popup-blocking")
    options.add_argument("--disable-notifications")
    options.add_argument("--disable-extensions")
    options.add_argument("--no-first-run")
    options.add_argument("--no-default-browser-check")

    # Every one of these is scoped to THIS ONE isolated automation browser
    # session — a fresh Edge instance launched per execution, never a
    # shared or production browser — so relaxing them here doesn't expose
    # a real end user to anything. They exist because the target
    # environment (nbcppuatweb4.sbi.co.in, an internal UAT host) commonly
    # presents an internally-issued/self-signed certificate and other
    # browser-security UI that Chrome/Edge would otherwise surface as an
    # interstitial warning or a blocking prompt — which a human clicks
    # past without a second thought, but which silently stalls or breaks
    # unattended Selenium automation (a cert warning page has none of the
    # locators the recorded flow expects).
    #
    # DELIBERATELY NOT included (removed after a real, confirmed
    # incident): --disable-web-security and --allow-running-insecure-
    # content. Both disable the browser's OWN CORS/same-origin/mixed-
    # content enforcement — this app's own server-side session-security
    # layer (the "BCF0070: Security breached, user session invalidated"
    # message, seen specifically on LOGOUT) appears to rely on that
    # enforcement actually being intact to validate a request as
    # legitimate; a normal, unmodified browser (a manual logout) never
    # triggers it, only the automated one with these two flags did. If a
    # genuine mixed-content/CORS blocking issue shows up again on some
    # OTHER screen, re-add these ONE AT A TIME and confirm logout still
    # works cleanly before keeping either — don't restore both together
    # without re-testing, since this is exactly how the regression
    # slipped in the first time.
    options.add_argument("--ignore-certificate-errors")
    options.add_argument("--allow-insecure-localhost")
    options.add_argument("--disable-blink-features=BlockCredentialedSubresources")

    # Hides `navigator.webdriver` and the "Chrome/Edge is being controlled
    # by automated test software" infobar. Several enterprise banking UIs
    # (this one included, going by how brittle some interactions have
    # been) run client-side bot-detection or defensive JS that behaves
    # differently — extra validation, disabled fields, unexpected popups —
    # when it detects an automated browser; this is what actually
    # prevents that class of interference, not just cosmetic. Kept
    # (unlike the two removed above) — this affects only client-side JS
    # automation-detection signals, not the CORS/session-security layer
    # that produced the logout failure, so it isn't implicated the same
    # way. If logout issues persist even after removing the two flags
    # above, try removing this one too, one change at a time.
    options.add_argument("--disable-blink-features=AutomationControlled")
    options.add_experimental_option("excludeSwitches", ["enable-automation"])
    options.add_experimental_option("useAutomationExtension", False)

    if (ctx.get("headless", "false") or "false").lower() == "true":
        options.add_argument("--headless=new")
    options.add_experimental_option("prefs", {
        "credentials_enable_service": False,
        "profile.password_manager_enabled": False,
        # Notification/popup prompts blocked at the content-settings level
        # too (belt-and-braces alongside --disable-notifications above —
        # some prompts are governed by this preference specifically, not
        # the command-line flag).
        "profile.default_content_setting_values.notifications": 2,
    })

    service = EdgeService(executable_path=driver_path) if driver_path else EdgeService()
    driver = webdriver.Edge(service=service, options=options)

    # NO implicit wait — this codebase relies entirely on the explicit
    # waits in BasePage (wait / short_wait). Mixing implicit and explicit
    # waits is a known Selenium anti-pattern: it silently inflates every
    # failing locator attempt toward the implicit timeout regardless of
    # how short the explicit wait around it is set to.
    driver.set_page_load_timeout(90)
    return driver


def execute_cdp(command: str, params: dict) -> dict:
    """CDP escape hatch — used for network capture and DOM inspection."""
    driver = get_driver()
    try:
        return driver.execute_cdp_cmd(command, params or {})
    except Exception:
        return {}


def quit_quietly() -> None:
    driver = getattr(_local, "driver", None)
    if driver is not None:
        try:
            driver.quit()
        except Exception:
            # never let cleanup break the run
            pass
        finally:
            _local.driver = None
