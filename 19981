package com.sbi.automation.core;

import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.NoSuchElementException;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.TakesScreenshot;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.support.ui.WebDriverWait;

import com.sbi.automation.utils.ExecutionContext;
import com.sbi.automation.utils.LocatorRepository;

/**
 * Base class for every generated Page Object.
 *
 * The key method is {@link #findWithFallback(String)} — it walks the ranked
 * locator list produced by the recorder, so a UI tweak does not fail the run
 * and the platform can self-heal instead of demanding a re-recording.
 */
public abstract class BasePage {

    protected final WebDriver driver;
    protected final WebDriverWait wait;
    protected final WebDriverWait shortWait;

    protected BasePage(WebDriver driver) {
        this.driver = driver;
        this.wait = new WebDriverWait(driver, Duration.ofSeconds(30));
        this.shortWait = new WebDriverWait(driver, Duration.ofSeconds(3));
    }

    /* ── element resolution ─────────────────────────────────────────── */
    protected WebElement findWithFallback(String elementKey) {
        By[] strategies = LocatorRepository.get(elementKey);
        if (strategies == null || strategies.length == 0) {
            throw new NoSuchElementException("No locators registered for " + elementKey);
        }
        NoSuchElementException last = null;
        for (int i = 0; i < strategies.length; i++) {
            // Fail FAST on every strategy except the last one. A short poll
            // is enough to catch normal async rendering; waiting the full
            // 30s on EVERY failing strategy meant an element whose top
            // locators had drifted could burn strategies.length * 30s
            // before self-heal even got a chance to try the next one —
            // this was the actual cause of single steps taking 150-350s.
            WebDriverWait attemptWait = (i == strategies.length - 1) ? wait : shortWait;
            try {
                WebElement element = attemptWait.until(
                        ExpectedConditions.presenceOfElementLocated(strategies[i]));
                if (i > 0) {
                    ExecutionContext.recordFallback(elementKey, i, strategies[i].toString());
                }
                return element;
            } catch (Exception e) {
                last = new NoSuchElementException(
                        "Locator failed for " + elementKey + ": " + strategies[i], e);
            }
        }
        ExecutionContext.recordLocatorFailure(elementKey, dumpDom());
        throw last != null ? last
                : new NoSuchElementException("Could not resolve " + elementKey);
    }

    /* ── interactions ───────────────────────────────────────────────── */
    protected void click(String elementKey) {
        WebElement element = findWithFallback(elementKey);
        wait.until(ExpectedConditions.elementToBeClickable(element));
        try {
            element.click();
        } catch (Exception e) {
            ((JavascriptExecutor) driver).executeScript("arguments[0].click();", element);
        }
    }

    protected void type(String elementKey, String value) {
        WebElement element = findWithFallback(elementKey);
        element.clear();
        element.sendKeys(value == null ? "" : value);
    }

    protected void selectByVisibleText(String elementKey, String text) {
        new Select(findWithFallback(elementKey)).selectByVisibleText(text);
    }

    protected void setCheckbox(String elementKey, boolean checked) {
        WebElement element = findWithFallback(elementKey);
        if (element.isSelected() != checked) {
            element.click();
        }
    }

    protected void uploadFile(String elementKey, String absolutePath) {
        findWithFallback(elementKey).sendKeys(absolutePath);
    }

    protected String textOf(String elementKey) {
        return findWithFallback(elementKey).getText();
    }

    /* ── waits & assertions ─────────────────────────────────────────── */
    protected void waitForPage() {
        wait.until(d -> "complete".equals(
                ((JavascriptExecutor) d).executeScript("return document.readyState")));
    }

    protected boolean isTextPresent(String text) {
        try {
            return driver.getPageSource().contains(text);
        } catch (Exception e) {
            return false;
        }
    }

    protected boolean exists(String elementKey) {
        try {
            findWithFallback(elementKey);
            return true;
        } catch (Exception e) {
            return false;
        }
    }

    protected List<WebElement> findAll(By by) {
        return driver.findElements(by);
    }

    /* ── evidence ───────────────────────────────────────────────────── */
    public String screenshot(String name) {
        try {
            byte[] png = ((TakesScreenshot) driver).getScreenshotAs(OutputType.BYTES);
            return ExecutionContext.saveScreenshot(name, png);
        } catch (Exception e) {
            return "";
        }
    }

    protected String dumpDom() {
        try {
            return driver.getPageSource();
        } catch (Exception e) {
            return "";
        }
    }
}
