# ----------------------------------------------------------------------
# Live recorder event stream
# ----------------------------------------------------------------------
@app.websocket("/ws/recording/{recording_id}")
async def recording_events_ws(websocket: WebSocket, recording_id: str):
    # WebSocket handshakes don't go through AuthMiddleware (that's an HTTP
    # middleware, and this is a different ASGI scope type) - check the same
    # session cookie by hand before accepting, using the same
    # user_from_cookies() helper the HTTP side uses. See
    # backend/auth/dependencies.py's docstring for why one helper covers
    # both.
    user = user_from_cookies(websocket.cookies)
    if not user:
        await websocket.close(code=4401)
        return
    await websocket.accept()
    session = RecorderManager.get(recording_id)
    if not session:
        await websocket.send_json({"event_type": "error", "message": "Recording session not active"})
        await websocket.close()
        return
    try:
        while True:
            try:
                evt = session.events.get_nowait()
                await websocket.send_json(evt.to_dict())
            except queue.Empty:
                await asyncio.sleep(0.3)
                if session.status not in ("recording", "paused", "starting"):
                    break
    except WebSocketDisconnect:
        pass


