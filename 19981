@dataclass
class PageRecord:
    page_id: str
    url: str
    title: str = ""
    normalized_key: str = ""       # url path w/o volatile query params - used for page-object naming/dedup
    first_seen_at: float = field(default_factory=now_ts)
    last_seen_at: float = field(default_factory=now_ts)
    dom_snapshot_path: str = ""
    screenshot_path: str = ""
    element_ids: List[str] = field(default_factory=list)
    modal_ids: List[str] = field(default_factory=list)
    frame_ids: List[str] = field(default_factory=list)

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


# --------------------------------------------------------------------------
# Layer B: User execution recording models
# --------------------------------------------------------------------------
@dataclass
class ActionRecord:
    step_number: int
    action: str                       # ActionType
    timestamp: float = field(default_factory=now_ts)
    page_url: str = ""
    page_title: str = ""
    page_id: str = ""
    element_id: Optional[str] = None
    element_text: str = ""
    element_tag: str = ""
    element_name: str = ""            # human-friendly generated name, e.g. "email_input_1"
    primary_locator_type: str = ""
    primary_locator: str = ""
    fallback_locators: List[Dict[str, str]] = field(default_factory=list)  # [{type, value}]
    value: str = ""
    test_data_key: Optional[str] = None   # e.g. "{{USERNAME}}" placeholder key
    # Capture -> Store -> Reuse (see recorder.py's _derive_variable_name /
    # correlation logic, and execution/variable_store.py): a value the app
    # itself GENERATES fresh every run (an application ID, a reference
    # number, a freshly-issued OTP) can't be replayed as a static literal -
    # it's different every execution. When the user copies such a value
    # during recording, captured_as names the {{variable}} it's stored
    # under; any LATER step whose recorded value exactly matched that copy
    # gets resolved_var set to the same name, so at execution time it's
    # re-read live and re-typed live instead of replaying the stale
    # recorded string. Independent of test_data_key/Test Data overrides -
    # an explicit override still wins if both are present.
    captured_as: Optional[str] = None
    resolved_var: Optional[str] = None
    frame_path: Optional[FramePath] = None
    window_context: str = ""
    modal_context: Optional[str] = None
    wait_condition: str = ""
    # Marks a step whose target element is EXPECTED to sometimes be absent
    # on the live page - e.g. a denomination-table row that only renders
    # for certain amounts, or one branch of a conditional/maker-checker
    # workflow that the recorded run happened to take but a later run
    # might not. Never set by the recorder itself (there is no reliable
    # way to auto-detect "this element is conditionally absent" from a
    # single recording) - it is a manual designation the user adds in
    # Review & Edit Steps after seeing a step fail for a data/flow reason
    # rather than a locator bug. When true, a failed lookup gets a short
    # wait (OPTIONAL_STEP_WAIT_SECONDS), skips AI self-healing entirely,
    # and is reported as SKIP rather than FAIL - see Executor._run_step().
    is_optional: bool = False
    expected_result: str = ""
    screenshot: str = ""
    # BRD/SD change-detection bookkeeping (see backend/change_detection/) -
    # never set by the recorder itself, only by change_applier.py after a
    # document upload is reviewed and confirmed. A normal recorded step
    # always has is_disabled=False and change_status="UNCHANGED".
    is_disabled: bool = False        # True -> Executor skips instantly, no locator attempt at all
    disabled_reason: str = ""
    change_status: str = "UNCHANGED"  # "UNCHANGED" | "ADDED" | "REMOVED"
    change_set_id: str = ""

    def to_dict(self) -> Dict[str, Any]:
        d = asdict(self)
        return d

    def to_flat_row(self) -> Dict[str, Any]:
        """Flattened representation matching the Excel execution schema."""
        fb = self.fallback_locators or []
        return {
            "Step_Number": self.step_number,
            "Action": self.action,
            "Page_URL": self.page_url,
            "Page_Title": self.page_title,
            "Element_Name": self.element_name,
            "Element_Text": self.element_text,
            "Element_Tag": self.element_tag,
            "Primary_Locator_Type": self.primary_locator_type,
            "Primary_Locator": self.primary_locator,
            "Fallback_Locator_1": _fb_value(fb, 0),
            "Fallback_Locator_2": _fb_value(fb, 1),
            "Fallback_Locator_3": _fb_value(fb, 2),
            "Value": self.value,
            "Test_Data_Key": self.test_data_key or "",
            "Captured_As": self.captured_as or "",
            "Resolved_Variable": self.resolved_var or "",
            "Frame_Path": _frame_path_str(self.frame_path),
            "Window_Context": self.window_context,
            "Modal_Context": self.modal_context or "",
            "Wait_Condition": self.wait_condition,
            "Optional_Step": "Y" if self.is_optional else "",
            "Expected_Result": self.expected_result,
            "Screenshot": self.screenshot,
            "Disabled": "Y" if self.is_disabled else "",
            "Disabled_Reason": self.disabled_reason,
            "Change_Status": self.change_status,
            "Change_Set_Id": self.change_set_id,
        }


def _fb_value(fallbacks: List[Dict[str, str]], idx: int) -> str:
    if idx < len(fallbacks):
        f = fallbacks[idx]
        return f"{f.get('type', '')}::{f.get('value', '')}"
    return ""


def _frame_path_str(fp: Optional[FramePath]) -> str:
    """Serialized as JSON (not a display string) so the executor can
    losslessly reconstruct the FramePath to drive Selenium through the
    exact same iframe hierarchy that was recorded. Empty string means
    top-level document (no frames)."""
    if not fp or not fp.path:
        return ""
    import json as _json
    return _json.dumps(fp.to_dict())


def parse_frame_path(value: str) -> Optional["FramePath"]:
    if not value:
        return None
    import json as _json
    try:
        data = _json.loads(value)
        return FramePath(**data)
    except (ValueError, TypeError):
        return None


# --------------------------------------------------------------------------
# Recording metadata
# --------------------------------------------------------------------------
@dataclass
class RecordingMetadata:
    recording_id: str
    name: str
    target_url: str
    created_at: float = field(default_factory=now_ts)
    updated_at: float = field(default_factory=now_ts)
    status: str = "in_progress"   # in_progress | stopped | paused
    browser: str = "chrome"
    total_steps: int = 0
    total_pages: int = 0
    total_executions: int = 0
    last_execution_at: Optional[float] = None
    test_data_keys: List[str] = field(default_factory=list)
    # A business-facing transaction code/name (e.g. "1010", "Cash Deposit") -
    # never set by the recorder itself. Lets a BRD/Solution Document that
    # references "Transaction 1010" be matched to the right recording when
    # detecting element changes - see change_detection/transaction_matcher.py.
    # Blank means "not tagged yet"; a recording can still be executed
    # normally without one.
    transaction_code: str = ""
    # Who this recording belongs to (see backend/auth/) - set once, at
    # creation time, from the logged-in user who started the recording.
    # A regular user only ever sees/acts on recordings where
    # owner_user_id matches their own user_id; an admin sees every
    # recording regardless. owner_username is stored purely for display
    # (an admin's Recordings/Reports/Change Detection views show "by
    # <username>") so those pages don't need a UserStore lookup per row -
    # it is NEVER used for the access check itself, only owner_user_id is
    # (a username can change; the id it was created under can't).
    # Blank means "no owner recorded" - only an admin can see/act on a
    # recording in that state (see backend/app.py's _can_access_recording).
    owner_user_id: str = ""
    owner_username: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


