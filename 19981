"""Platform configuration.

All secrets are read from environment variables (or an optional .env file).
Nothing sensitive is ever returned unmasked to the frontend or written to logs.
"""
import os
import json
from pathlib import Path

try:
    from dotenv import load_dotenv
    load_dotenv()
except ImportError:
    pass

BASE_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = Path(os.getenv("PLATFORM_DATA_DIR", BASE_DIR / "data"))
DATA_DIR.mkdir(parents=True, exist_ok=True)
ARTIFACTS_DIR = DATA_DIR / "artifacts"          # screenshots, DOM snapshots, videos
ARTIFACTS_DIR.mkdir(exist_ok=True)
SETTINGS_FILE = DATA_DIR / "settings.json"       # non-secret, UI-editable settings

DB_URL = os.getenv("PLATFORM_DB_URL", f"sqlite:///{DATA_DIR / 'platform.db'}")

# ---- Azure OpenAI (secrets: env only) ----------------------------------
AZURE_OPENAI_ENDPOINT = os.getenv("AZURE_OPENAI_ENDPOINT", "")
AZURE_OPENAI_API_KEY = os.getenv("AZURE_OPENAI_API_KEY", "")
AZURE_OPENAI_DEPLOYMENT = os.getenv("AZURE_OPENAI_DEPLOYMENT", "")
AZURE_OPENAI_API_VERSION = os.getenv("AZURE_OPENAI_API_VERSION", "2024-06-01")


def mask_secret(value: str, show: int = 4) -> str:
    """Mask a secret for display: 'sk-abc...wxyz' style."""
    if not value:
        return ""
    if len(value) <= show * 2:
        return "*" * len(value)
    return f"{value[:show]}{'*' * 8}{value[-show:]}"


DEFAULT_SETTINGS = {
    "framework_path": "",                 # path to existing Java Selenium-Cucumber repo
    "edgedriver_path": "msedgedriver",    # local EdgeDriver
    "edge_binary_path": "",               # optional explicit Edge binary
    "default_headless": False,            # Module 22: live visible Edge by default
    "ai_confidence_threshold": 0.75,
    "mask_fields": ["password", "pin", "otp", "accountnumber", "account_no",
                    "customerid", "customer_id", "cvv", "ssn"],
    "notification_email": "",
    # --- Pure JDK runner (no Maven) ---
    "java_home": "",                      # optional JAVA_HOME; blank = java/javac on PATH
    "libs_path": "",                      # folder of jars; blank = <framework_path>/libs
    "glue_package": "stepdefinitions",    # Cucumber glue package in the framework
    # --- Execution-time credentials: login -> password change (if required) ---
    # Every live execution logs in with exec_user_id/exec_password. If the
    # forced password-change screen appears, the platform automatically calls
    # the recorded/generated transaction identified by
    # password_change_transaction_number (record it like any other
    # transaction — see core.PasswordChangeGate), which changes the password
    # to exec_new_password and re-logs in, then execution proceeds normally.
    # If the screen never appears, nothing happens and execution just runs.
    "exec_user_id": "",
    "exec_password": "",                  # current/default password — stored masked
    "exec_new_password": "",              # new password used after a forced change
    "password_change_transaction_number": "9750",
}

# Settings that must never be returned to the UI in clear text
SECRET_SETTINGS = ("exec_password", "exec_new_password")


def load_settings() -> dict:
    settings = dict(DEFAULT_SETTINGS)
    if SETTINGS_FILE.exists():
        try:
            settings.update(json.loads(SETTINGS_FILE.read_text()))
        except json.JSONDecodeError:
            pass
    return settings


def save_settings(patch: dict) -> dict:
    settings = load_settings()
    settings.update({k: v for k, v in patch.items() if k in DEFAULT_SETTINGS})
    SETTINGS_FILE.write_text(json.dumps(settings, indent=2))
    return settings


def public_ai_config() -> dict:
    """Azure OpenAI config safe to show in the UI — key always masked."""
    return {
        "endpoint": AZURE_OPENAI_ENDPOINT,
        "deployment": AZURE_OPENAI_DEPLOYMENT,
        "api_version": AZURE_OPENAI_API_VERSION,
        "api_key_masked": mask_secret(AZURE_OPENAI_API_KEY),
        "configured": bool(AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY
                           and AZURE_OPENAI_DEPLOYMENT),
    }
