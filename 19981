@echo off
title AI Test Recorder - Backend Server
color 1F
echo.
echo ================================================
echo   AI Test Recorder - Backend Server
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0"

REM venv is one level up from the project folder (in test_scripts\venv)
set VENV_PATH=%~dp0..\venv

if not exist "%VENV_PATH%\Scripts\activate.bat" (
    echo [ERROR] Virtual environment not found at: %VENV_PATH%
    echo Expected structure:
    echo   test_scripts\
    echo     venv\
    echo     ai-test-recorder-pw\  ^<-- this bat file is here
    pause
    exit /b 1
)

echo [1/3] Activating virtual environment from: %VENV_PATH%
call "%VENV_PATH%\Scripts\activate.bat"

echo [2/3] Checking dependencies...
python -c "import uvicorn, fastapi" 2>nul
if %errorlevel% neq 0 (
    echo [INFO] Installing dependencies...
    pip install -r requirements.txt
)

echo [3/3] Starting backend server...
echo.
echo  Access URL : http://10.1.161.165:8000
echo  API Docs   : http://10.1.161.165:8000/docs
echo  Press Ctrl+C to stop
echo.
python -m uvicorn backend.api:app --host 0.0.0.0 --port 8000

echo.
echo [INFO] Backend server stopped.
pause
