@dataclass
class ExecutionSummary:
    execution_id: str
    recording_id: str
    recording_name: str
    target_url: str
    browser: str
    start_time: float
    end_time: Optional[float] = None
    total_steps: int = 0
    passed: int = 0
    failed: int = 0
    skipped: int = 0
    healed: int = 0
    step_results: List[Dict[str, Any]] = field(default_factory=list)

    @property
    def duration_seconds(self) -> float:
        if self.end_time is None:
            return 0.0
        return round(self.end_time - self.start_time, 2)

    @property
    def pass_percentage(self) -> float:
        if self.total_steps == 0:
            return 0.0
        return round(100.0 * self.passed / self.total_steps, 2)

    @property
    def fail_percentage(self) -> float:
        if self.total_steps == 0:
            return 0.0
        return round(100.0 * self.failed / self.total_steps, 2)

    def to_dict(self) -> Dict[str, Any]:
        d = asdict(self)
        d["duration_seconds"] = self.duration_seconds
        d["pass_percentage"] = self.pass_percentage
        d["fail_percentage"] = self.fail_percentage
        return d
