"""
Shared OCR helper, used at BOTH:
  - RECORD time (recorder/recorder.py, when the user right-clicks an
    element on the page and chooses "Capture text with OCR" from the
    custom menu injected by recorder_injector.js)
  - REPLAY time (generator/templates/page.tmpl's
    BasePage.capture_value_ocr, called from the generated step - see
    generator/templates/steps.tmpl's "ocr_capture" branch; also
    BasePage._ocr_click_fallback - a last-resort locator strategy for
    click() when every DOM candidate fails - and
    BasePage.assert_ocr_text_visible - a page-level OCR/visual
    assertion, with no DOM element involved at all)

One implementation, so every caller always extracts text the exact same
way - and critically, REPLAY re-runs the OCR live every single time the
test executes (a fresh screenshot, fresh OCR pass) rather than reusing
whatever text was read during recording, the same way a plain
copy-captured value is re-read live rather than hard-coded (see
recorder/variable_capture.py's module docstring) - these are usually
values the application generates fresh each run (a new application
number, a new reference ID rendered into an image/canvas rather than
real DOM text), so baking in the recording-time value would make the
generated test increasingly wrong over time.

Uses EasyOCR - a pure-Python OCR engine (pip install easyocr, nothing
else to install separately, unlike Tesseract) built on PyTorch. This is a
genuine trade-off, not a strictly-better choice, worth understanding:
  - Nothing to install on the target machine beyond `pip install easyocr`
    (or whatever's bundled into local_agent's frozen build) - no separate
    binary, no PATH configuration, no corporate-security exclusion needed
    for a second executable.
  - But: it's a MUCH heavier dependency (EasyOCR pulls in PyTorch - use
    the CPU-only build, `pip install torch --index-url
    https://download.pytorch.org/whl/cpu`, NOT the default GPU build,
    which is several GB larger for zero benefit on a laptop with no GPU).
    This is exactly why OCR support stays OPTIONAL for local_agent (see
    local_agent/requirements-agent.txt) rather than a hard dependency -
    _ocr_click_fallback below is written to degrade silently (no
    fallback attempted, original error still raised) rather than error
    out, on a lightweight agent install that never installed this.
  - And: EasyOCR downloads its detection/recognition model weights
    (~100MB) from the internet the FIRST time a Reader() is ever created
    on a given machine, caching them (default: ~/.EasyOCR/model/, or
    wherever EASYOCR_MODULE_PATH points - see _get_reader below) for
    every run after that. On a machine with restricted/no internet
    access, this first-run download needs to be pre-staged (copy an
    already-populated ~/.EasyOCR/model/ folder over, or point
    EASYOCR_MODULE_PATH at a pre-staged location bundled with the
    installer) BEFORE the first OCR capture is ever attempted there.
  - Reader() initialization itself (loading those model weights into
    memory) takes a few seconds - too slow to redo on every single
    capture, so _get_reader() below creates it ONCE per process and
    reuses it for every subsequent OCR call in that process's lifetime.
"""
from __future__ import annotations
import hashlib
import io
import os
import threading
from collections import OrderedDict
from typing import Optional

_reader = None
_reader_lock = threading.Lock()

# Minimum EasyOCR confidence (0-1) for a region to count as a genuine match
# in best_match() below - picked conservatively low since UI text (small
# fonts, icon+label buttons) often scores lower than scanned-document text,
# but still high enough to reject obvious noise/garbage detections.
DEFAULT_MIN_CONFIDENCE = 0.35

# Bounded cache of find_text_regions() results, keyed by a hash of the exact
# screenshot bytes - a byte-identical screenshot (checked twice within the
# same run, e.g. a click fallback immediately followed by an OCR assertion
# on an unchanged page) skips re-running OCR entirely; any genuinely
# different screenshot has different bytes, so this can never serve stale
# results. Bounded (not per-run-scoped) since this module is a
# process-lifetime singleton shared across every recording/replay in that
# process, same as _reader above.
_OCR_CACHE_MAX = 64
_ocr_cache: "OrderedDict[str, list]" = OrderedDict()
_ocr_cache_lock = threading.Lock()


def _cache_get(key: str):
    with _ocr_cache_lock:
        value = _ocr_cache.get(key)
        if value is not None:
            _ocr_cache.move_to_end(key)
        return value


def _cache_put(key: str, value: list) -> None:
    with _ocr_cache_lock:
        _ocr_cache[key] = value
        _ocr_cache.move_to_end(key)
        while len(_ocr_cache) > _OCR_CACHE_MAX:
            _ocr_cache.popitem(last=False)


def _normalize(text: str) -> str:
    """Whitespace-collapsed, case-folded form used for matching - mirrors
    recorder/variable_capture.py's _normalize, same rationale (a UI often
    re-renders/re-wraps text slightly from how it was recorded)."""
    return " ".join(text.split()).casefold()


def _get_reader():
    """Lazily creates ONE EasyOCR Reader for this process's whole
    lifetime (thread-safe) - Reader() itself is slow (loads model
    weights), so this must never be called fresh per-capture. English
    only by default; add languages via OCR_LANGUAGES (comma-separated
    EasyOCR language codes, e.g. "en,hi") if this ever needs to read
    non-English text."""
    global _reader
    if _reader is None:
        with _reader_lock:
            if _reader is None:
                import easyocr
                languages = os.environ.get("OCR_LANGUAGES", "en").split(",")
                model_dir = os.environ.get("EASYOCR_MODULE_PATH")  # pre-staged model weights, for a machine with no internet access
                _reader = easyocr.Reader(
                    [lang.strip() for lang in languages if lang.strip()],
                    gpu=False,  # laptops running this agent have no GPU worth using - forcing this off also skips a slow, pointless CUDA availability probe
                    model_storage_directory=model_dir,
                    download_enabled=model_dir is None or not os.path.isdir(model_dir),
                )
    return _reader


def ocr_available() -> bool:
    """Best-effort check - used by recorder.py to fail an OCR capture
    request clearly and immediately (rather than partway through) if
    EasyOCR genuinely can't run here (not installed, or model weights
    can't be obtained/found and there's no internet access to fetch
    them)."""
    try:
        _get_reader()
        return True
    except Exception:
        return False


def find_text_regions(png_bytes: bytes) -> list[dict]:
    """Structured OCR: every detected text region with its confidence and
    bounding box, e.g.:
        {"text": "Submit", "normalized_text": "submit", "confidence": 0.94,
         "bbox": {"x": 100, "y": 200, "width": 120, "height": 40}}
    Unlike extract_text_from_png_bytes's plain joined string, this is what
    BasePage._ocr_click_fallback (a last-resort locator strategy) and
    BasePage.assert_ocr_text_visible (a page-level OCR/visual assertion)
    need - "which region, if any, actually matches the text I'm looking
    for, and how confident was the read." Cached by a hash of the exact
    screenshot bytes (see module docstring). Preprocessing (grayscale +
    contrast normalization) is applied before handing the image to
    EasyOCR - a small, safe accuracy improvement for typical UI
    screenshots; full skew/rotation correction is deliberately not
    attempted (UI screenshots are always axis-aligned).

    Raises the same RuntimeError as extract_text_from_png_bytes if OCR
    genuinely can't run here (missing deps, EasyOCR init failure) - see
    that function's docstring for the exact conditions."""
    cache_key = hashlib.sha1(png_bytes).hexdigest()
    cached = _cache_get(cache_key)
    if cached is not None:
        return cached

    try:
        from PIL import Image, ImageOps
        import numpy as np
    except ImportError as e:
        raise RuntimeError(
            "OCR support isn't fully installed on this machine - "
            "pip install easyocr Pillow numpy "
            "(see local_agent/requirements-agent.txt)."
        ) from e

    try:
        reader = _get_reader()
    except Exception as e:
        raise RuntimeError(
            f"EasyOCR could not initialize ({type(e).__name__}: {e}). If this machine has no "
            "internet access, EasyOCR's model weights need to be pre-staged - copy an already-"
            "populated ~/.EasyOCR/model/ folder from a machine that has run OCR successfully "
            "once, or set EASYOCR_MODULE_PATH to a pre-staged model directory bundled with the "
            "installer."
        ) from e

    image = Image.open(io.BytesIO(png_bytes)).convert("L")  # grayscale
    image = ImageOps.autocontrast(image)
    image_array = np.array(image)

    try:
        # detail=1 returns (bbox_points, text, confidence) per region -
        # bbox_points is 4 (x, y) corner points in top-to-bottom,
        # left-to-right reading order (EasyOCR's natural detection order,
        # same order detail=0 used to hand back as a flat string list).
        raw = reader.readtext(image_array, detail=1)
    except Exception as e:
        raise RuntimeError(f"OCR failed while reading the captured image: {type(e).__name__}: {e}") from e

    regions = []
    for bbox_points, text, confidence in raw:
        # EasyOCR returns numpy scalar types (np.int32/np.float64) for
        # corner coordinates - cast to plain Python numbers so this dict is
        # safely JSON-serializable and safe to pass straight into
        # Playwright's mouse.click(x, y) (page.tmpl's _ocr_click_fallback),
        # neither of which reliably accepts numpy types.
        xs = [float(p[0]) for p in bbox_points]
        ys = [float(p[1]) for p in bbox_points]
        regions.append({
            "text": text,
            "normalized_text": _normalize(text),
            "confidence": float(confidence),
            "bbox": {"x": min(xs), "y": min(ys), "width": max(xs) - min(xs), "height": max(ys) - min(ys)},
        })

    _cache_put(cache_key, regions)
    return regions


def best_match(regions: list[dict], hint: str, min_confidence: float = DEFAULT_MIN_CONFIDENCE) -> Optional[dict]:
    """Picks the highest-confidence region whose normalized text contains
    (or is contained by) `hint`, among regions clearing `min_confidence` -
    or None if nothing qualifies. A PURE function (no I/O, no OCR call) so
    it's directly unit-testable with hand-built region lists, independent
    of EasyOCR/a browser/a real screenshot - this is deliberately where
    the actual "did we find what we were looking for" decision lives,
    kept separate from find_text_regions' OCR I/O."""
    target = _normalize(hint)
    if not target:
        return None
    candidates = [
        r for r in regions
        if r["confidence"] >= min_confidence and (target in r["normalized_text"] or r["normalized_text"] in target)
    ]
    if not candidates:
        return None
    return max(candidates, key=lambda r: r["confidence"])


def extract_text_from_png_bytes(png_bytes: bytes) -> str:
    """Runs OCR on a screenshot (PNG bytes, exactly what Playwright's
    `element.screenshot()` returns) and returns the extracted text.
    Multiple detected text regions are joined with a single space in
    EasyOCR's own top-to-bottom, left-to-right reading order - e.g. a
    reference number rendered as two visually-separate pieces ("REF" and
    "998877") comes back as one "REF 998877" string, not a list.

    Implemented on top of find_text_regions() - same OCR call, same
    caching, same preprocessing - so this function's own contract (a
    plain string, nothing else) is unchanged for its existing callers
    (recorder/recorder.py's _process_ocr_request, page.tmpl's
    capture_value_ocr)."""
    regions = find_text_regions(png_bytes)
    return " ".join(r["text"] for r in regions).strip()
