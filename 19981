@echo off
title AI Test Recorder - Launch All
echo.
echo ================================================
echo   AI Test Recorder - Starting All Services
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0"

echo [1/3] Starting Backend Server...
start "AI Test Recorder - Backend" cmd /k "start_backend.bat"
timeout /t 5 /nobreak >nul

echo [2/3] Starting Frontend...
start "AI Test Recorder - Frontend" cmd /k "start_frontend.bat"
timeout /t 3 /nobreak >nul

echo [3/3] Starting Local Agent...
start "AI Test Recorder - Agent" cmd /k "start_agent.bat"

echo.
echo All three services started in separate windows.
echo.
echo   Backend  : http://10.1.161.165:8000
echo   Frontend : http://localhost:3000
echo   Agent    : Connecting to backend...
echo.
echo Close each window individually to stop a service.
pause
