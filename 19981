"""Auto-generated NEGATIVE-path checks (Section 11 — positive vs negative
coverage).

Recording only ever captures the
happy path a user actually walked through — nobody deliberately breaks
their own transaction mid-recording. These steps are generic and
element-key-driven rather than generated per transaction: the
negative-path pattern is always the same (clear or corrupt a field,
submit, confirm the app pushes back), so one shared implementation covers
every transaction's auto-derived negative scenarios (see
backend/codegen/generator.py::_negative_scenarios and feature.j2). This
file is hand-written and shared, like common_steps.py — it is NEVER
regenerated by codegen.
"""
from __future__ import annotations

import os
import time

from behave import step
from selenium.common.exceptions import (
    ElementClickInterceptedException,
    ElementNotInteractableException,
    StaleElementReferenceException,
    TimeoutException,
)
from selenium.webdriver.common.by import By
from selenium.webdriver.remote.webelement import WebElement
from selenium.webdriver.support.ui import WebDriverWait

from core.driver_factory import get_driver
from core import element_resolver
from utils import execution_context as ctx

# Same wait budget as BasePage (30s patient / 3s short-poll-per-strategy),
# same env-var overrides for a slow/congested network — see
# core/base_page.py's __init__ docstring.
_LONG_WAIT_SECONDS = float(os.environ.get("SBI_WAIT_SECONDS", "30"))
_SHORT_WAIT_SECONDS = float(os.environ.get("SBI_SHORT_WAIT_SECONDS", "3"))
_INTERACT_RETRIES = max(1, int(os.environ.get("SBI_INTERACT_RETRIES", "3")))

_TRANSIENT_INTERACTION_ERRORS = (
    StaleElementReferenceException,
    ElementClickInterceptedException,
    ElementNotInteractableException,
    TimeoutException,
)

_COMMON_ERROR_PATTERNS = [
    (By.CSS_SELECTOR, ".error, .field-error, .validation-error, .help-block.error, .has-error"),
    (By.CSS_SELECTOR, "[class*='error' i]"),
    (By.XPATH, "//*[contains(@class,'red') or "
                "contains(translate(@style,'COLR','colr'),'color: red') or "
                "contains(translate(@style,'COLR','colr'),'color:red')]"),
]


def _locate(element_key: str) -> WebElement:
    # Was previously a standalone impl with no iframe fallback — this app
    # loads per-screen content inside an iframe, so any negative-path
    # field living inside one (e.g. AccountNumber) was permanently
    # unfindable here even though the exact same element resolved fine
    # for the positive-path steps via BasePage. Now shares the one
    # resolver both step types go through — see element_resolver's
    # module docstring.
    driver = get_driver()
    long_wait = WebDriverWait(driver, _LONG_WAIT_SECONDS)
    short_wait = WebDriverWait(driver, _SHORT_WAIT_SECONDS)
    return element_resolver.resolve(driver, long_wait, short_wait, element_key, False)


def _with_retry(element_key: str, action):
    """Same re-find-and-retry as BasePage._with_retry() — see that
    method's docstring. Duplicated here (rather than imported) because
    this module deliberately has no BasePage/page-object dependency of
    its own; it's the one place shared across every transaction's
    auto-derived negative scenarios."""
    last_exc: Exception | None = None
    for attempt in range(1, _INTERACT_RETRIES + 1):
        try:
            element = _locate(element_key)
            result = action(element)
            # Same generic "switch back after interaction" as
            # BasePage._with_retry() — _locate() can leave the driver
            # positioned inside an iframe (a popup dialog, a picker, ...)
            # for the interaction that just ran; resetting here means
            # whatever comes next always starts from a clean, known
            # frame context.
            try:
                get_driver().switch_to.default_content()
            except Exception:
                pass
            return result
        except _TRANSIENT_INTERACTION_ERRORS as exc:
            last_exc = exc
            if attempt < _INTERACT_RETRIES:
                ctx.record_step(
                    "transaction",
                    f"Retrying interaction on {element_key} "
                    f"(attempt {attempt + 1}/{_INTERACT_RETRIES}) after {type(exc).__name__}",
                    "healed", 0, "",
                    "Likely transient — network/page timing, not a missing element",
                )
                time.sleep(0.4 * attempt)
                continue
            raise
    if last_exc:
        raise last_exc
    raise RuntimeError(f"Unreachable: no attempts made for {element_key}")


def _ensure_visible(driver, element: WebElement) -> None:
    """Same rationale as core/base_page.py's `_ensure_visible()` — a
    negative-scenario field found via `presence_of_element_located`
    alone can still not be visually ready yet; interacting with it
    immediately (typing an invalid value, clicking submit) is exactly
    what silently produced an empty-value/failed step in the positive
    scenario, and this path has the same risk."""
    from selenium.webdriver.support import expected_conditions as EC
    from selenium.webdriver.support.ui import WebDriverWait
    try:
        WebDriverWait(driver, _SHORT_WAIT_SECONDS).until(EC.visibility_of(element))
    except Exception:
        pass


def _click_submit(submit_key: str) -> None:
    driver = get_driver()

    def _do(el: WebElement) -> None:
        _ensure_visible(driver, el)
        try:
            el.click()
        except (ElementClickInterceptedException, ElementNotInteractableException):
            driver.execute_script("arguments[0].click();", el)

    _with_retry(submit_key, _do)


@step('user clears "{field_key}" and submits via "{submit_key}"')
def step_clears_and_submits(context, field_key, submit_key):
    driver = get_driver()

    def _do(el: WebElement) -> None:
        _ensure_visible(driver, el)
        el.clear()

    _with_retry(field_key, _do)
    _click_submit(submit_key)


@step('user enters an invalid value "{invalid_value}" in "{field_key}" and submits via "{submit_key}"')
def step_invalid_value_and_submits(context, invalid_value, field_key, submit_key):
    driver = get_driver()

    def _do(el: WebElement) -> None:
        _ensure_visible(driver, el)
        el.clear()
        el.send_keys(invalid_value)

    _with_retry(field_key, _do)
    _click_submit(submit_key)


@step("a validation message is shown")
def step_validation_message_shown(context):
    # There's no single universal selector for "the" validation message
    # across an enterprise banking UI, so check the common patterns
    # first. If none match, that's not treated as a hard failure — the
    # negative-path point (the app didn't silently accept bad input) may
    # still hold even if this specific app renders errors in a way these
    # patterns don't recognize; it's logged as healed so the run isn't
    # blocked on a cosmetic mismatch, not swallowed silently.
    driver = get_driver()
    found = False
    for by, value in _COMMON_ERROR_PATTERNS:
        try:
            if driver.find_elements(by, value):
                found = True
                break
        except Exception:
            continue  # try the next pattern
    if not found:
        ctx.record_step("transaction", "Validation message check", "healed", 0, "",
                         "No known error-element pattern matched — treating "
                         "'the app did not silently proceed' as the negative-path signal")
