@app.get("/api/recordings")
def get_recordings(current_user: CurrentUser = Depends(get_current_user)):
    """Every recording the current user has at least VIEW access to -
    legacy/unowned recordings (created before ownership tracking existed),
    ones they own, and ones shared with them (admins see everything). The
    dict shape is unchanged/additive (recording_id/is_owner/is_shared are
    new keys alongside the existing file/name/target_url/action_count) so
    nothing already reading this response breaks - see
    backend/recording_access.py for the ownership model."""
    recordings = list_saved_recordings()
    visible = []
    _access = app_access.for_user(current_user)      # one query for the whole list
    _names: dict = {}                                 # owner_user_id -> username (one lookup per person)
    with get_session() as session:
        for r in recordings:
            # Application level FIRST, on the server, before a row is even looked up for the file.
            if not app_access.recording_allowed(current_user, Path(r["file"]), "view", r.get("application"), _access):
                continue
            rec = recording_access.get_or_create_recording(session, Path(r["file"]))
            if not recording_access.check_access(rec, current_user, "view", application_access=_access,
                                                 json_app=r.get("application")):
                continue
            oid = rec.owner_user_id
            if oid and oid not in _names:
                _u = repo.get_user(session, oid)
                _names[oid] = getattr(_u, "username", None) or ""
            visible.append({
                **r,
                "recording_id": rec.recording_id,
                "recorded_by": _names.get(oid, "") if oid else "",   # who recorded it ("" = older, unowned)
                "is_owner": rec.owner_user_id == current_user.user_id,
                "is_shared": rec.owner_user_id is not None and rec.owner_user_id != current_user.user_id,
                "owner_user_id": rec.owner_user_id,
                # Admins only - the same rule POST /api/recordings/delete enforces.
                # Nobody else can delete a recording, not even its owner.
                "can_delete": bool(current_user.is_admin),
            })
    return visible


def _safe_recording_path(file: str) -> Path:
    """Resolves `file` (as returned by GET /api/recordings) and makes sure
