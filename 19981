"""
Behave environment hooks for LOCAL AGENT execution. Copied into an
execution workspace's features/environment.py by
local_agent/execution_manager.py INSTEAD OF runner/environment.py -
identical Playwright browser setup/teardown, but deliberately WITHOUT
self-healing, so the local agent (and therefore the end user's desktop
installation) never needs the `agent/` AI package or an LLM API key at
all - both stay strictly server-side, matching the requirement that users
receive only local_agent/ + recorder/ + runner/, never backend/,
database/, generator/, or agent/.

Trade-off, stated plainly: a locator that's gone stale will simply fail
the step here, instead of being auto-repaired mid-run the way a
server-executed test can be (see runner/environment.py, used server-side
and by ALLOW_SERVER_FALLBACK's dev-only path). See
docs/electron-local-agent-architecture.md's "Remaining work" for the
proper fix (an agent -> server "propose a locator fix" callback endpoint)
if closing that gap becomes a priority - it's a real, deliberate
architecture decision, not an oversight.
"""
import os
import sys
from pathlib import Path

# make both the "project root" (for `recorder`) and the output dir (for
# `pages`) importable - same mechanism runner/environment.py uses (see
# local_agent/execution_manager.py's module docstring for why `cwd` at
# invocation time, not this path arithmetic, is what actually makes
# `recorder` importable - this insert is still needed for `pages`).
_features_dir = Path(__file__).resolve().parent
_output_dir = _features_dir.parent
_project_root = _output_dir.parent
sys.path.insert(0, str(_project_root))
sys.path.insert(0, str(_output_dir))

from recorder.browser_factory import launch_browser

from pages.recorded_page import RecordedPage
from runner.variables import VariableStore


def before_all(context):
    headless = os.getenv("HEADLESS", "false").lower() == "true"
    context.browser_session = launch_browser(headless=headless)
    context.raw_page = context.browser_session.new_page()
    # heal_callback=None (vs runner/environment.py's LLM-backed one) - see
    # this file's module docstring for why.
    context.page = RecordedPage(context.raw_page, heal_callback=None)
    context.variables = VariableStore()

    # Auto-accept native alert/confirm/prompt/beforeunload dialogs - both on
    # the original page and on any popup/new tab/new window opened during
    # this run - mirrors recorder/recorder.py's own _on_dialog (an
    # unhandled dialog suspends the page indefinitely, hanging the run).
    # Kept identical to runner/environment.py's version even though this
    # file otherwise deliberately omits self-healing - dialog handling
    # doesn't need an LLM, so there's no reason for local execution to
    # behave differently here.
    context.raw_page.on("dialog", lambda dialog: dialog.accept())
    context.browser_session.context.on("page", lambda p: p.on("dialog", lambda dialog: dialog.accept()))
    # Ordered list of every browser tab/window page.tmpl's BasePage.switch_page()
    # has been pointed at during this run - see steps.tmpl's maybe_switch/
    # new_page_wrapper macros, which append to and index into this.
    context.recorder_pages = [context.raw_page]


def after_all(context):
    try:
        context.browser_session.close()
    except Exception:
        pass


def after_step(context, step):
    """See runner/environment.py's after_step - identical logic, kept in
    sync deliberately (screenshot capture doesn't need an LLM, so there's
    no reason for local execution to behave differently here, the same
    principle already applied to dialog handling above)."""
    context.step_counter = getattr(context, "step_counter", 0) + 1
    status_name = getattr(step.status, "name", str(step.status))
    if status_name not in ("passed", "failed", "error"):
        return
    try:
        screenshots_dir = _output_dir / "screenshots"
        screenshots_dir.mkdir(parents=True, exist_ok=True)
        active_page = context.page.page if hasattr(context, "page") and context.page else context.raw_page
        active_page.screenshot(path=str(screenshots_dir / f"step_{context.step_counter:03d}.png"))
    except Exception:
        pass
