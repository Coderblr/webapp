"""
Central configuration for the Universal AI-Powered Web Automation Platform.

All configuration is environment-driven (see .env.example). Nothing
application-specific (no business domain, no site names) lives here -
this module only knows about infrastructure concerns: paths, browser
defaults, and AI provider credentials.

NOTE: this build has value masking disabled throughout (recorder,
executor, logs) - it's configured for UAT use, where recorded/executed
values are written to the Excel dataset, logs, and reports as-is. Do not
point this configuration at a production environment.
"""
from __future__ import annotations

import os
from pathlib import Path

from dotenv import load_dotenv

# Load .env from the project root (one level above backend/) if present.
_PROJECT_ROOT = Path(__file__).resolve().parent.parent
load_dotenv(_PROJECT_ROOT / ".env")


def _bool(name: str, default: bool) -> bool:
    val = os.getenv(name)
    if val is None:
        return default
    return val.strip().lower() in ("1", "true", "yes", "on")


def _resolve(path_str: str) -> Path:
    p = Path(path_str)
    if not p.is_absolute():
        p = (Path(__file__).resolve().parent / p).resolve()
    return p


class Settings:
    """Runtime settings, resolved once at import time."""

    # --- General ---
    APP_ENV: str = os.getenv("APP_ENV", "development")
    APP_HOST: str = os.getenv("APP_HOST", "0.0.0.0")
    APP_PORT: int = int(os.getenv("APP_PORT", "8000"))
    LOG_LEVEL: str = os.getenv("LOG_LEVEL", "INFO")

    PROJECT_ROOT: Path = _PROJECT_ROOT
    RECORDINGS_DIR: Path = _resolve(os.getenv("RECORDINGS_DIR", "../recordings"))
    REPORTS_DIR: Path = _resolve(os.getenv("REPORTS_DIR", "../reports"))
    LOGS_DIR: Path = _resolve(os.getenv("LOGS_DIR", "../logs"))
    FRONTEND_DIR: Path = _PROJECT_ROOT / "frontend"

    # --- Browser ---
    DEFAULT_BROWSER: str = os.getenv("DEFAULT_BROWSER", "chrome")
    BROWSER_HEADLESS: bool = _bool("BROWSER_HEADLESS", False)
    IMPLICIT_WAIT_SECONDS: float = float(os.getenv("IMPLICIT_WAIT_SECONDS", "2"))
    EXPLICIT_WAIT_SECONDS: float = float(os.getenv("EXPLICIT_WAIT_SECONDS", "10"))
    # Used only for fallback locator attempts (selenium_executor.py's
    # execute_with_fallbacks), never for the primary locator. The primary
    # attempt gets the full EXPLICIT_WAIT_SECONDS since a page may
    # genuinely still be loading. By the time a fallback is tried, that
    # full wait has already happened once for this step - waiting another
    # complete EXPLICIT_WAIT_SECONDS for EACH of up to 3 fallback locators
    # in turn (up to 30+ seconds on top of the primary's own 10s) is what
    # made data-heavy screens with several failing/ambiguous locators (many
    # radio buttons, a variable-length row table, ...) take minutes to
    # execute - almost all of that time was spent waiting out timeouts,
    # not doing anything. A short, separate timeout here keeps fallback
    # attempts fast without shortening the one wait that actually matters
    # (the primary locator's).
    FALLBACK_WAIT_SECONDS: float = float(os.getenv("FALLBACK_WAIT_SECONDS", "3"))

    # Manual driver binary paths. When set, browser_factory.py uses these
    # directly instead of asking webdriver-manager to auto-download a
    # matching driver - required on machines with no internet access or
    # where outbound downloads are blocked (e.g. corporate/offline setups).
    # Leave blank to keep the automatic download behavior.
    CHROME_DRIVER_PATH: str = os.getenv("CHROME_DRIVER_PATH", "").strip()
    EDGE_DRIVER_PATH: str = os.getenv("EDGE_DRIVER_PATH", "").strip()

    # --- AI ---
    DEFAULT_AI_PROVIDER: str = os.getenv("DEFAULT_AI_PROVIDER", "azure_openai")
    AI_ENABLED: bool = _bool("AI_ENABLED", True)

    AZURE_OPENAI_API_KEY: str = os.getenv("AZURE_OPENAI_API_KEY", "")
    AZURE_OPENAI_ENDPOINT: str = os.getenv("AZURE_OPENAI_ENDPOINT", "")
    AZURE_OPENAI_DEPLOYMENT: str = os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o")
    AZURE_OPENAI_API_VERSION: str = os.getenv("AZURE_OPENAI_API_VERSION", "2024-05-01-preview")

    ANTHROPIC_API_KEY: str = os.getenv("ANTHROPIC_API_KEY", "")
    CLAUDE_MODEL: str = os.getenv("CLAUDE_MODEL", "claude-sonnet-4-5")

    DEEPSEEK_API_KEY: str = os.getenv("DEEPSEEK_API_KEY", "")
    DEEPSEEK_BASE_URL: str = os.getenv("DEEPSEEK_BASE_URL", "https://api.deepseek.com")
    DEEPSEEK_MODEL: str = os.getenv("DEEPSEEK_MODEL", "deepseek-chat")

    # --- Self-healing ---
    HEALING_CONFIDENCE_THRESHOLD: float = float(os.getenv("HEALING_CONFIDENCE_THRESHOLD", "0.75"))
    HEALING_MAX_CANDIDATES: int = int(os.getenv("HEALING_MAX_CANDIDATES", "15"))

    @classmethod
    def ensure_dirs(cls) -> None:
        for d in (cls.RECORDINGS_DIR, cls.REPORTS_DIR, cls.LOGS_DIR):
            d.mkdir(parents=True, exist_ok=True)


settings = Settings()
settings.ensure_dirs()
