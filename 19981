"""Base class for every generated Page Object.

The key method is ``_find(element_key)``
— it walks the ranked locator list produced by the recorder (via
``core.element_resolver``), so a UI tweak does not fail the run and the
platform can self-heal instead of demanding a re-recording.
"""
from __future__ import annotations

import os
import time

from selenium.common.exceptions import (
    ElementClickInterceptedException,
    ElementNotInteractableException,
    StaleElementReferenceException,
    TimeoutException,
)
from selenium.webdriver.remote.webdriver import WebDriver
from selenium.webdriver.remote.webelement import WebElement
from selenium.webdriver.support.ui import WebDriverWait, Select
from selenium.webdriver.support import expected_conditions as EC

from core import element_resolver
from utils import execution_context as ctx

# Exceptions that mean "the element was found, but something about page
# timing (very often network slowness — a slow AJAX response re-rendering
# the DOM right as Selenium tries to act) made the interaction itself
# fail" — worth a fresh look-up and another try, unlike a genuine
# "this element doesn't exist" failure.
_TRANSIENT_INTERACTION_ERRORS = (
    StaleElementReferenceException,
    ElementClickInterceptedException,
    ElementNotInteractableException,
    TimeoutException,
)


class BasePage:
    def __init__(self, driver: WebDriver):
        self.driver = driver
        # Wait durations are configurable via environment variables
        # rather than hard-coded, so a congested/slow network doesn't
        # need a code change — just SBI_WAIT_SECONDS /
        # SBI_SHORT_WAIT_SECONDS set higher for that run/profile.
        long_wait_s = float(os.environ.get("SBI_WAIT_SECONDS", "30"))
        short_wait_s = float(os.environ.get("SBI_SHORT_WAIT_SECONDS", "3"))
        self.wait = WebDriverWait(driver, long_wait_s)
        self.short_wait = WebDriverWait(driver, short_wait_s)
        # How many times an interaction re-finds the element and tries
        # again after a transient failure, before giving up for real.
        self._interact_retries = max(1, int(os.environ.get("SBI_INTERACT_RETRIES", "3")))

    # ── element resolution ──────────────────────────────────────────────
    def _find(self, element_key: str, silent: bool = False) -> WebElement:
        return element_resolver.resolve(self.driver, self.wait, self.short_wait,
                                         element_key, silent)

    def _with_retry(self, element_key: str, action, silent: bool = False):
        """Runs `action(element)` against a FRESHLY re-resolved element,
        retrying on a transient failure instead of the same possibly-stale
        WebElement reference.

        The most common "the locator found the element, but the
        interaction still failed" case on a slow/laggy connection isn't a
        bad locator at all — it's that the page kept re-rendering (a late
        AJAX response, a re-painted overlay) in the gap between resolving
        the element and Selenium actually clicking/typing into it. A
        WebElement handle from a moment ago can go stale or become
        covered by then. Re-finding on every attempt picks up whatever
        the DOM looks like right now rather than replaying against a
        snapshot, and a short backoff between attempts gives a slow
        network/animation time to actually settle instead of hammering
        the same not-yet-ready state repeatedly.
        """
        last_exc: Exception | None = None
        for attempt in range(1, self._interact_retries + 1):
            try:
                element = self._find(element_key, silent=silent)
                result = action(element)
                # Generic "switch back after interaction" — if `_find()`
                # resolved this element inside an iframe (a popup dialog,
                # a lookup/picker, ...), it deliberately leaves the driver
                # POSITIONED there for the interaction that just ran. Once
                # that interaction is done, resetting to the top-level
                # document here means the NEXT interaction — on this same
                # element, a sibling inside the popup, or something
                # entirely outside it once the popup closes — always
                # starts its own resolve() from a clean, known state
                # rather than silently staying stuck inside a frame that
                # may no longer even exist. Harmless (a cheap no-op) when
                # the element was never inside a frame to begin with.
                try:
                    self.driver.switch_to.default_content()
                except Exception:
                    pass
                return result
            except _TRANSIENT_INTERACTION_ERRORS as exc:
                last_exc = exc
                if attempt < self._interact_retries:
                    ctx.record_step(
                        "transaction",
                        f"Retrying interaction on {element_key} "
                        f"(attempt {attempt + 1}/{self._interact_retries}) "
                        f"after {type(exc).__name__}",
                        "healed", 0, "",
                        "Likely transient — network/page timing, not a missing element",
                    )
                    time.sleep(0.4 * attempt)  # small linear backoff
                    continue
                raise
        if last_exc:
            raise last_exc
        raise RuntimeError(f"Unreachable: no attempts made for {element_key}")

    # ── interactions ─────────────────────────────────────────────────────
    def _ensure_visible(self, element: WebElement) -> None:
        """Waits for an element to actually be VISIBLE — not just
        present in the DOM — before any interaction touches it.

        `_find()`/`element_resolver.resolve()` only waits for
        `presence_of_element_located`, which is satisfied the instant an
        element exists in the DOM tree, whether or not it has actually
        finished rendering, is still behind a loading overlay, or is
        mid-CSS-transition. Interacting immediately after "presence" —
        especially typing, which was previously not waited on AT ALL
        here — was the direct cause of a real, observed failure: a
        field that visually wasn't ready yet accepted a `.clear()` +
        `.send_keys()) call that silently didn't register any text,
        producing an empty value even though the step "succeeded"
        procedurally. `EC.visibility_of` re-checks `is_displayed()`
        until it's actually true (or the wait times out), which is
        Selenium's own definition of "this is now something a real user
        could actually see and act on" — not a replacement for
        `element_to_be_clickable()` (still used in click() below, which
        additionally checks enabled-state), just the same category of
        guard applied consistently to every kind of interaction, not
        only clicks.
        """
        try:
            self.wait.until(EC.visibility_of(element))
        except Exception:
            # Same philosophy as click()'s clickability wait below: some
            # real pages never cleanly satisfy this (an element that's
            # genuinely usable despite a CSS quirk Selenium doesn't
            # recognise as "visible") — don't fail the step on the wait
            # itself, still attempt the interaction.
            pass
        self._scroll_into_view(element)
        self._wait_until_stable(element)
        self._wait_for_overlay_transition()

    def _scroll_into_view(self, element: WebElement) -> None:
        """Explicit `scrollIntoView()` — Selenium's native click DOES
        auto-scroll an element into view as part of its own W3C
        WebDriver-spec behaviour, but only reliably for the MAIN page
        scroll. A field inside a CUSTOM scrollable container (a
        scrollable data table, a scrollable modal body, a scrollable
        dropdown list — all common in this kind of enterprise banking
        UI) can still be technically "in the DOM" and even pass
        `is_displayed()` while sitting outside its OWN container's
        visible scroll area, which the browser's built-in click-time
        auto-scroll doesn't always handle correctly. JS's own
        `scrollIntoView()` walks EVERY scrollable ancestor, not just the
        window, which is what actually makes "the field needs a scroll
        to be shown" reliable across every interaction, not only clicks.
        `{block: 'center'}` centers it rather than just barely-visible-
        at-the-edge, giving `_wait_until_stable()` right after this a
        real settled position to compare against instead of one that's
        still right at a container's scroll boundary.
        """
        try:
            self.driver.execute_script(
                "arguments[0].scrollIntoView({block: 'center', inline: 'nearest'});",
                element,
            )
        except Exception:
            # Never worth failing the whole interaction over — the
            # element might already be fully in view (a no-op scroll is
            # harmless), or genuinely non-scrollable-to for some reason;
            # the interaction attempt right after this is still the
            # real, authoritative one.
            pass

    def _wait_until_stable(self, element: WebElement, timeout: float = 0.3) -> None:
        """A genuine fluent wait — Selenium's own term for a polling
        wait with a bounded timeout — for the element's position/size to
        stop CHANGING, not just for it to be visible. `EC.visibility_of`
        only checks `is_displayed()`, which can already be True while a
        field is still SETTLING — sliding into place as part of a layout
        reflow, resizing as a sibling element finishes loading, or
        simply not yet interactive because the app hasn't finished
        wiring up its event handlers. Typing into a field that's still
        moving/settling is exactly the class of "script is putting
        input even before the field is loaded" symptom this addresses:
        comparing its bounding rect across two checks a beat apart, and
        only proceeding once it's identical (i.e. genuinely at rest).

        Deliberately fast-pathed for the OVERWHELMINGLY common case — a
        field that's already stable, which is nearly every field, nearly
        every time: the first comparison uses a tiny 30ms gap rather
        than an unconditional longer sleep, so a genuinely settled field
        costs barely anything extra. Only a field that's ACTUALLY still
        changing pays for further, slightly longer-spaced checks, capped
        at a low 0.3s total rather than left open-ended — this exists to
        catch real settling, not to become a second source of the exact
        "everything feels slow" complaint that made the overlay-wait's
        own budget get cut down at the same time as this was added.
        """
        try:
            previous = element.rect
        except Exception:
            return  # can't read geometry — nothing more this check can do
        deadline = time.time() + timeout
        poll = 0.03
        while time.time() < deadline:
            time.sleep(poll)
            try:
                current = element.rect
            except Exception:
                return  # went stale mid-check — the caller's own
                         # retry-on-stale-element handles this, not here
            if current == previous:
                return
            previous = current
            poll = 0.08  # subsequent checks space out a bit more once
                         # we know it's genuinely still moving
        # Never seen it settle within the budget — proceed anyway rather
        # than blocking indefinitely; the interaction that follows still
        # has its own retry-on-transient-failure safety net.

    # There's no single reliable selector for "a modal/popup that's
    # currently opening" across every screen either (same situation as
    # the spinner/validation-message pattern lists elsewhere in this
    # class) — check the common shapes a transitioning overlay actually
    # takes. This exists because of a real, repeating failure pattern:
    # a NEW popup (a Bootstrap-style dialog, a dropdown/suggestion list)
    # appears as the direct result of the action just before it, and
    # code immediately tried to interact with something INSIDE that
    # popup before its own open/fade transition had actually finished —
    # `_find()` can return an element that's technically present but
    # still moving/fading, which the plain `EC.visibility_of` check
    # above doesn't catch (a Bootstrap-modal-in-transition can already
    # report `is_displayed() == True` while its CSS opacity/transform
    # transition is still running). Waiting for the known "still
    # transitioning" classes to clear first is what actually prevents
    # clicking/typing into an overlay before it's settled into place.
    _TRANSITIONING_OVERLAY_SELECTORS = (
        ".modal.fade.showing, .modal.fade.in.showing",
        ".bootstrap-dialog.type-loading",
        ".modal-backdrop.fade:not(.show)",
        "[aria-busy='true']",
    )

    def _wait_for_overlay_transition(self, timeout: float = 0.5) -> None:
        """Reduced from an earlier 2.0s default — a genuine CSS fade/
        transition on this kind of overlay settles in 150-350ms in
        practice; a MUCH longer budget only ever mattered for the
        (rare) worst case, while taxing the overwhelmingly common case
        just as heavily. A REAL, confirmed cost of the longer timeout:
        if any element on a given screen happens to persistently match
        one of the selectors above WITHOUT ever actually clearing (e.g.
        a permanently-present, always-`aria-busy` loading-indicator
        container that isn't a genuine per-interaction overlay at all —
        a real anti-pattern some Bootstrap-based apps have), this loop
        used to burn its FULL timeout on every single interaction across
        the ENTIRE screen, not just once — which is exactly the "every
        field feels slow" symptom this was found from. Halving the
        budget halves that worst case; a genuinely transitioning overlay
        still gets several poll cycles to clear within it.
        """
        deadline = time.time() + timeout
        while time.time() < deadline:
            still_transitioning = False
            for selector in self._TRANSITIONING_OVERLAY_SELECTORS:
                try:
                    if self.driver.find_elements("css selector", selector):
                        still_transitioning = True
                        break
                except Exception:
                    continue
            if not still_transitioning:
                return
            time.sleep(0.1)

    def click(self, element_key: str) -> None:
        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            try:
                self.wait.until(EC.element_to_be_clickable(element))
            except Exception:
                # Some real pages never satisfy Selenium's strict "clickable"
                # check (a fading overlay, a border-case visibility quirk) even
                # though the element is genuinely usable — don't fail the step
                # here; still attempt the click below.
                pass
            try:
                element.click()
            except (ElementClickInterceptedException, ElementNotInteractableException):
                self.driver.execute_script("arguments[0].click();", element)

        self._with_retry(element_key, _do)

    def type(self, element_key: str, value: str | None) -> None:
        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            element.clear()
            element.send_keys(value or "")
            # A slow-rendering/JS-validated field can silently drop or
            # reformat what was just typed (a masking script re-writing
            # the value on its own `input`/`change` handler, for
            # instance) — verifying what's actually IN the field now
            # catches that immediately, as a `StaleElementReferenceException`-
            # style transient (caught and retried by `_with_retry`,
            # which re-finds a FRESH element and tries again) rather
            # than silently reporting success with an empty/wrong value.
            actual = element.get_attribute("value") or ""
            if value and not actual:
                raise StaleElementReferenceException(
                    f"Typed value did not register (field reads back empty) for {element_key}"
                )

        self._with_retry(element_key, _do)

    def select_by_visible_text(self, element_key: str, text: str) -> None:
        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            Select(element).select_by_visible_text(text)
            # Same "did it actually register" concern as type() above —
            # a custom/JS-driven dropdown widget (very common on an
            # enterprise banking screen; not every "dropdown" is a plain
            # native <select>) can silently fail to update its
            # underlying value even though the click/select call itself
            # didn't raise. Reading back the currently-selected option's
            # text and comparing catches that as a transient (retried
            # via a freshly re-found element) rather than reporting
            # success with the wrong option still selected.
            selected = Select(element).first_selected_option.text.strip()
            if selected != text.strip():
                raise StaleElementReferenceException(
                    f"Selection did not register for {element_key} "
                    f"(expected {text!r}, still shows {selected!r})"
                )

        self._with_retry(element_key, _do)

    def set_checkbox(self, element_key: str, checked: bool) -> None:
        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            if element.is_selected() != checked:
                element.click()
            # Verify the click actually flipped the state — a checkbox/
            # radio driven by a JS widget (rather than a plain native
            # input) can visually toggle without the underlying
            # `is_selected()` state actually changing, same class of
            # "looked like it worked but didn't" issue as typing/select.
            if element.is_selected() != checked:
                raise StaleElementReferenceException(
                    f"Checkbox/radio state did not register for {element_key} "
                    f"(wanted checked={checked})"
                )

        self._with_retry(element_key, _do)

    def upload_file(self, element_key: str, absolute_path: str) -> None:
        # Deliberately NO visibility wait here, unlike every other
        # interaction in this class — a file input is very commonly
        # hidden-by-design (`opacity:0`/`display:none`, styled via a
        # custom "Choose file" button overlay that triggers it) and
        # that's the NORMAL case for this element type, not a loading-
        # timing problem to wait out. Waiting for visibility here would
        # just burn the full wait budget on every single upload for no
        # benefit.
        self._with_retry(element_key, lambda element: element.send_keys(absolute_path))

    def drag_and_drop(self, source_key: str, target_key: str) -> None:
        from selenium.webdriver.common.action_chains import ActionChains

        source = self._find(source_key)
        self._ensure_visible(source)
        target = self._find(target_key)
        self._ensure_visible(target)
        ActionChains(self.driver).drag_and_drop(source, target).perform()
        try:
            self.driver.switch_to.default_content()
        except Exception:
            pass

    def text_of(self, element_key: str) -> str:
        return self._with_retry(element_key, lambda element: element.text)

    # ── waits & assertions ──────────────────────────────────────────────
    def wait_for_page(self) -> None:
        try:
            self.driver.switch_to.default_content()
        except Exception:
            pass
        self.wait.until(lambda d: d.execute_script("return document.readyState") == "complete")

    def recover_from_security_breach_if_present(self) -> bool:
        """Explicit, PROACTIVE check — as distinct from
        element_resolver.py's REACTIVE version, which only ever fires as
        a side-effect of some LATER element lookup failing. That's a real
        gap for an action like logout: it's typically the LAST step in a
        scenario, so there's often no subsequent element resolution to
        ever trigger the reactive check at all — the real,
        confirmed-in-production trigger ("BCF0070: Security breached,
        user session invalidated", seen specifically on an automated
        logout, never a manual one) would otherwise go completely
        undetected and unrecorded, which is exactly what happened before
        this existed: the page WAS being silently refreshed by the
        reactive path on whatever NEXT resolve() call happened to run
        (which is why it "goes away on refresh" but never showed up in
        the report), with nothing to show it had occurred at all.

        Call this explicitly right after any action that's known to be
        a common trigger point (logout here; any other page is free to
        call this too — it's on BasePage, not logout-specific).
        Returns True if a breach message was found (and a refresh was
        attempted), False otherwise.
        """
        from core import element_resolver
        try:
            page_text = self.driver.page_source
        except Exception:
            return False
        evidence = element_resolver._looks_like_security_breach(page_text)
        if not evidence:
            return False
        ctx.record_step(
            "transaction",
            "Security/session anomaly detected after logout — refreshing to recover",
            "healed", 0, "", f"evidence={evidence!r}",
        )
        try:
            self.driver.refresh()
            self.wait.until(
                lambda d: d.execute_script("return document.readyState") == "complete"
            )
        except Exception:
            pass
        return True

    def is_text_present(self, text: str) -> bool:
        try:
            return text in self.driver.page_source
        except Exception:
            return False

    def exists(self, element_key: str) -> bool:
        try:
            self._find(element_key, silent=True)
            return True
        except Exception:
            return False

    def find_all(self, by: str, value: str) -> list[WebElement]:
        return self.driver.find_elements(by, value)

    # ── NBC-framework compatibility layer ─────────────────────────────────
    # The following mirror the vocabulary of the original Java BasePage
    # (com.nbc.base.BasePage) that TopMenu/HomePage/PasswordChangePage/
    # SupOverridePage/ElectronicJournalPage/etc. were written against, so
    # those page objects port over with (nearly) unchanged call sites —
    # just element_key strings instead of raw `By` locator fields, so they
    # still go through _find()/element_resolver and keep self-healing.
    def send_keys(self, element_key: str, value: str | None) -> None:
        self.type(element_key, value)

    def send_keys_enter(self, element_key: str, value: str | None) -> None:
        from selenium.webdriver.common.keys import Keys

        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            element.clear()
            element.send_keys((value or "") + Keys.ENTER)

        self._with_retry(element_key, _do)

    def press_tab(self) -> None:
        from selenium.webdriver.common.keys import Keys
        try:
            self.driver.switch_to.active_element.send_keys(Keys.TAB)
        except Exception:
            pass

    def get_element_text(self, element_key: str) -> str:
        return self.text_of(element_key)

    def get_element_value(self, element_key: str) -> str:
        try:
            return self._with_retry(
                element_key, lambda element: element.get_attribute("value") or "", silent=True
            )
        except Exception:
            return ""

    def is_element_displayed(self, element_key: str) -> bool:
        try:
            return self._find(element_key, silent=True).is_displayed()
        except Exception:
            return False

    def hover(self, element_key: str) -> None:
        from selenium.webdriver.common.action_chains import ActionChains

        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            ActionChains(self.driver).move_to_element(element).perform()

        try:
            self._with_retry(element_key, _do)
        except Exception:
            pass

    def select_by_value(self, element_key: str, value: str) -> None:
        def _do(element: WebElement) -> None:
            self._ensure_visible(element)
            Select(element).select_by_value(str(value))

        self._with_retry(element_key, _do)

    def wait_for_clickable(self, element_key: str) -> None:
        try:
            element = self._find(element_key)
            self.wait.until(EC.element_to_be_clickable(element))
        except Exception:
            pass  # click() itself falls back to a JS click regardless

    def wait_for_visible(self, element_key: str) -> None:
        try:
            self.wait.until(lambda d: self._find(element_key).is_displayed())
        except Exception:
            pass

    def wait_for_invisibility(self, element_key: str) -> None:
        try:
            self.wait.until(lambda d: not self.is_element_displayed(element_key))
        except Exception:
            pass

    def wait_specific_time(self, seconds: float) -> None:
        import time
        time.sleep(seconds)

    # There's no single reliable id/class for "the" spinner across every
    # NBC screen, so this checks the common patterns used across the app
    # and simply returns once none of them are visible any more (or after
    # a bounded timeout) — same "check the known patterns, don't hard-fail
    # on a miss" approach as negative_steps.py's validation-message check.
    _SPINNER_LOCATORS = [
        ("css selector", ".spinner, .loading, .loader, [class*='spinner']"),
        ("css selector", "[class*='loading' i]"),
        ("id", "loadingDiv"),
    ]

    def wait_for_spinner_to_disappear(self, timeout: float = 20.0) -> None:
        import time
        deadline = time.time() + timeout
        while time.time() < deadline:
            any_visible = False
            for by, value in self._SPINNER_LOCATORS:
                try:
                    for el in self.driver.find_elements(by, value):
                        if el.is_displayed():
                            any_visible = True
                            break
                except Exception:
                    continue
                if any_visible:
                    break
            if not any_visible:
                return
            time.sleep(0.2)

    def close_x(self, element_key: str) -> None:
        """Click a popup's "X" close control — same as click(), kept as a
        separate name for 1:1 call-site parity with the original Java."""
        self.click(element_key)

    # There's no single reliable id/class for "the" page header/title
    # across every NBC screen either (same situation as the spinner check
    # above) — check the common patterns and confirm the expected text
    # appears in whichever one is actually on this screen.
    _HEADER_LOCATORS = [
        ("css selector", "h1, h2, .page-title, .panel-title, [class*='header-title']"),
        ("xpath", "//*[contains(@class,'bootstrap-dialog-title')]"),
    ]

    def validate_page_header(self, expected_title: str) -> bool:
        expected = (expected_title or "").strip()
        for by, value in self._HEADER_LOCATORS:
            try:
                for el in self.driver.find_elements(by, value):
                    if el.is_displayed() and expected.lower() in (el.text or "").strip().lower():
                        ctx.record_step("assertion", f"Page header matches: {expected}",
                                         "passed", 0, "", None)
                        return True
            except Exception:
                continue
        ctx.record_step("assertion", f"Page header matches: {expected}", "failed", 0, "",
                         "No visible header element contained the expected title")
        raise AssertionError(f"Page header did not match expected title: {expected}")

    def assert_element(self, element_key: str, message: str = "") -> None:
        if not self.is_element_displayed(element_key):
            ctx.record_step("assertion", message or f"Element present: {element_key}",
                             "failed", 0, "", f"Not present/visible: {element_key}")
            raise AssertionError(message or f"Expected element not present: {element_key}")
        ctx.record_step("assertion", message or f"Element present: {element_key}", "passed", 0, "", None)

    def assert_element_text(self, element_key: str, expected: str, mode: str = "equals",
                             message: str = "") -> None:
        actual = ""
        mode = (mode or "equals").lower()
        try:
            if mode == "value":
                actual = self.get_element_value(element_key)
            else:
                actual = self.get_element_text(element_key)
        except Exception:
            pass
        expected = expected or ""
        if mode == "contains":
            ok = expected in actual
        elif mode == "startswith":
            ok = actual.strip().startswith(expected)
        elif mode == "amount":
            # Loose numeric-string comparison — the app renders amounts
            # with commas/decimals inconsistently across screens.
            norm = lambda s: (s or "").replace(",", "").replace(".00", "").strip()
            ok = norm(actual) == norm(expected)
        elif mode == "dropdownvalue":
            ok = expected in actual
        else:  # equals / value
            ok = actual.strip() == expected.strip()
        detail = f"expected='{expected}' actual='{actual}' mode={mode}"
        if not ok:
            ctx.record_step("assertion", message or "Text assertion", "failed", 0, "", detail)
            raise AssertionError(f"{message or 'Text assertion failed'}: {detail}")
        ctx.record_step("assertion", message or "Text assertion", "passed", 0, "", None)

    # ── evidence ─────────────────────────────────────────────────────────
    def screenshot(self, name: str) -> str:
        try:
            png = self.driver.get_screenshot_as_png()
            return ctx.save_screenshot(name, png)
        except Exception:
            return ""

    def dump_dom(self) -> str:
        try:
            return self.driver.page_source
        except Exception:
            return ""
