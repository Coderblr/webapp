@echo off
title AI Test Recorder - Backend Server
color 1F
echo.
echo ================================================
echo   AI Test Recorder - Backend Server
echo   State Bank of India - Internal Use Only
echo ================================================
echo.

cd /d "%~dp0"

if not exist "venv\Scripts\activate.bat" (
    echo [ERROR] Virtual environment not found at: %~dp0venv
    echo Please create it with: python -m venv venv
    pause
    exit /b 1
)

echo [1/3] Activating virtual environment...
call venv\Scripts\activate.bat

echo [2/3] Checking dependencies...
python -c "import uvicorn, fastapi" 2>nul
if %errorlevel% neq 0 (
    echo [INFO] Installing dependencies...
    pip install -r requirements.txt
)

echo [3/3] Starting backend server on http://0.0.0.0:8000
echo.
echo  Access URL : http://10.1.161.165:8000
echo  API Docs   : http://10.1.161.165:8000/docs
echo  Press Ctrl+C to stop
echo.
python -m uvicorn backend.api:app --host 0.0.0.0 --port 8000

echo.
echo [INFO] Backend server stopped.
pause
