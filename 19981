-- ═══════════════════════════════════════════════════════════════════════
--  Enterprise AI Automation Engineering Platform — Knowledge Repository
--  SQLite (ported from PostgreSQL + pgvector)
--  Section 15 of the Master Build Specification
-- ═══════════════════════════════════════════════════════════════════════


-- ── 1. TRANSACTIONS ────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS transactions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_id  TEXT        NOT NULL,          -- e.g. '1045', '9750'
    name            TEXT        NOT NULL,
    description     TEXT,
    version         TEXT        NOT NULL DEFAULT '1.0',
    build           TEXT,
    type            TEXT        NOT NULL DEFAULT 'business',
        -- 'business' | 'system_prerequisite' | 'system_cleanup'
    status          TEXT        NOT NULL DEFAULT 'draft',
        -- draft | pending_review | active | superseded | needs_rerecording
    confidence      NUMERIC(4,3) DEFAULT 1.000,     -- overall, aggregated (Part 13)
    workflow_confidence  NUMERIC(4,3),               -- did the step sequence hold together
    locator_confidence   NUMERIC(4,3),               -- Part 8/9 locator reliability, averaged
    data_confidence      NUMERIC(4,3),               -- test-data validation pass rate
    execution_confidence NUMERIC(4,3),               -- raw step pass rate
    healing_confidence   NUMERIC(4,3),               -- confidence of applied self-heals
    knowledge_json  TEXT       NOT NULL DEFAULT '{}',
    workflow_path   TEXT       NOT NULL DEFAULT '[]',
    knowledge_dir   TEXT,                          -- storage/knowledge/<txn>/<ver>
    generated_files TEXT       NOT NULL DEFAULT '{}',
    tags            TEXT        NOT NULL DEFAULT '[]',
    recorded_at     TEXT,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (transaction_id, version)
);
CREATE INDEX IF NOT EXISTS idx_txn_txnid   ON transactions (transaction_id);
CREATE INDEX IF NOT EXISTS idx_txn_status  ON transactions (status);
CREATE INDEX IF NOT EXISTS idx_txn_type    ON transactions (type);
CREATE INDEX IF NOT EXISTS idx_txn_version ON transactions (version);

-- ── 2. PAGES captured during a recording ───────────────────────────────
CREATE TABLE IF NOT EXISTS pages (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    page_key        TEXT        NOT NULL,          -- stable slug for the screen
    title           TEXT,
    url             TEXT,
    sequence        INT         NOT NULL DEFAULT 0,
    dom_ref         TEXT,                          -- file ref to full DOM snapshot
    screenshot_ref  TEXT,
    frames          TEXT       NOT NULL DEFAULT '[]',
    shadow_roots    TEXT       NOT NULL DEFAULT '[]',
    meta            TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_pages_txn ON pages (transaction_pk);

-- ── 3. ELEMENTS (whole-page crawl, not only clicked elements) ──────────
CREATE TABLE IF NOT EXISTS elements (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    page_pk         BIGINT      REFERENCES pages(id) ON DELETE CASCADE,
    element_key     TEXT        NOT NULL,
    tag             TEXT,
    element_type    TEXT,        -- button | textbox | dropdown | checkbox | ...
    label           TEXT,
    visible         BOOLEAN     DEFAULT TRUE,
    enabled         BOOLEAN     DEFAULT TRUE,
    interacted      BOOLEAN     DEFAULT FALSE,     -- touched in this recording?
    element_meta    TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_elements_txn  ON elements (transaction_pk);
CREATE INDEX IF NOT EXISTS idx_elements_page ON elements (page_pk);
CREATE INDEX IF NOT EXISTS idx_elements_key  ON elements (element_key);

-- ── 4. LOCATORS (multi-strategy fallback repository) ───────────────────
CREATE TABLE IF NOT EXISTS locators (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    element_pk          BIGINT      NOT NULL REFERENCES elements(id) ON DELETE CASCADE,
    transaction_pk      BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    strategy            TEXT        NOT NULL,      -- id|name|css|xpath|relative_xpath|text|aria|data
    value               TEXT        NOT NULL,
    priority            INT         NOT NULL DEFAULT 100,
    reliability_score   NUMERIC(4,3) NOT NULL DEFAULT 0.500,
    success_count       INT         NOT NULL DEFAULT 0,
    failure_count       INT         NOT NULL DEFAULT 0,
    last_used_at        TEXT,
    active              BOOLEAN     NOT NULL DEFAULT TRUE,
    created_at          TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_loc_element ON locators (element_pk, priority);
CREATE INDEX IF NOT EXISTS idx_loc_txn     ON locators (transaction_pk);
CREATE INDEX IF NOT EXISTS idx_loc_key     ON locators (element_pk, strategy);

-- ── 5. RECORDED ACTIONS / workflow steps ───────────────────────────────
CREATE TABLE IF NOT EXISTS recorded_actions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    sequence        INT         NOT NULL,
    action          TEXT        NOT NULL,          -- click|type|select|check|navigate|wait|assert
    element_key     TEXT,
    field_name      TEXT,
    value_ref       TEXT,                          -- variable name, NEVER a raw value
    page_key        TEXT,
    dom_before_ref  TEXT,
    dom_after_ref   TEXT,
    screenshot_before TEXT,
    screenshot_after  TEXT,
    network_ref     TEXT,
    meta            TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_actions_txn ON recorded_actions (transaction_pk, sequence);

-- ── 6. VALIDATION RULES ────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS validation_rules (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    field_name      TEXT,
    rule_type       TEXT,                          -- mandatory|format|business|message
    expression      TEXT,
    message_text    TEXT,
    severity        TEXT        DEFAULT 'error',   -- error|warning|success|info
    meta            TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_valrules_txn ON validation_rules (transaction_pk);

-- ── 7. TEST DATA — field metadata (Section 7.2) ────────────────────────
CREATE TABLE IF NOT EXISTS test_data_fields (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,
    field           TEXT        NOT NULL,
    datatype        TEXT,                          -- PAN | CIF | AMOUNT | TEXT | DATE ...
    required        BOOLEAN     NOT NULL DEFAULT FALSE,
    pattern         TEXT,
    business_meaning TEXT,
    sensitive       BOOLEAN     NOT NULL DEFAULT FALSE,
    editable        BOOLEAN     NOT NULL DEFAULT TRUE,
    source          TEXT        NOT NULL DEFAULT 'user',
        -- framework | profile | runtime | database | api | ai | recorded
    source_config   TEXT       NOT NULL DEFAULT '{}',
    element_key     TEXT,
    recorded_value  TEXT,
        -- the value the human actually typed during recording — ONLY
        -- ever populated for non-sensitive fields, ONLY when the
        -- recorder's opt-in "use typed values as default test data"
        -- setting was on for that session (Part: manual-recording
        -- value reuse). NEVER populated for password/PIN/OTP/etc.
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (transaction_pk, field)
);

-- ── 8. DATA PROFILES (Section 7.6) ─────────────────────────────────────
CREATE TABLE IF NOT EXISTS test_data_profiles (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    name            TEXT        NOT NULL UNIQUE,   -- e.g. SBI_PREPROD
    environment     TEXT        NOT NULL,          -- PREPROD | UAT | PROD
    description     TEXT,
    values_json     TEXT       NOT NULL DEFAULT '{}',  -- non-sensitive
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS test_data_values (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    profile_pk      BIGINT      REFERENCES test_data_profiles(id) ON DELETE CASCADE,
    transaction_id  TEXT,
    environment     TEXT        NOT NULL,
    field           TEXT        NOT NULL,
    value_plain     TEXT,                          -- non-sensitive only
    value_encrypted TEXT,                          -- sensitive values, Fernet
    sensitive       BOOLEAN     NOT NULL DEFAULT FALSE,
    source          TEXT        NOT NULL DEFAULT 'user',
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (profile_pk, transaction_id, environment, field)
);
CREATE INDEX IF NOT EXISTS idx_tdv_lookup
    ON test_data_values (transaction_id, environment);

-- ── 9. SECRETS (Section 11.3) — never plaintext ────────────────────────
CREATE TABLE IF NOT EXISTS secrets (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    scope           TEXT        NOT NULL,          -- global | profile | environment
    scope_ref       TEXT,                          -- profile name / environment
    key             TEXT        NOT NULL,          -- teller_id|teller_password|checker_id|
                                                   -- checker_password|cbs_reset_string
    value_encrypted TEXT        NOT NULL,
    hint            TEXT,                          -- masked preview for the UI
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (scope, scope_ref, key)
);

-- ── 10. EXECUTIONS ─────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS executions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    execution_uid   TEXT        NOT NULL UNIQUE,
    transaction_id  TEXT        NOT NULL,
    transaction_pk  BIGINT      REFERENCES transactions(id) ON DELETE SET NULL,
    environment     TEXT        NOT NULL,
    profile_pk      BIGINT      REFERENCES test_data_profiles(id) ON DELETE SET NULL,
    status          TEXT        NOT NULL DEFAULT 'queued',
        -- queued|running|passed|failed|aborted|partial
    thread_id       TEXT,                          -- LangGraph checkpoint thread
    report_id       TEXT,
    report_path     TEXT,
    password_change_status TEXT,                   -- 9750 sub-step result
    teller_reset_status    TEXT,
    teller_reset_response  TEXT,
    error_summary   TEXT,
    error_category  TEXT,                           -- Part 6: structured error classification
                                                      -- (LOCATOR|TIMEOUT|AUTHENTICATION|...) —
                                                      -- see backend/execution/error_classifier.py
    metrics         TEXT       NOT NULL DEFAULT '{}',
    started_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    finished_at     TEXT
);
CREATE INDEX IF NOT EXISTS idx_exec_txn    ON executions (transaction_id);
CREATE INDEX IF NOT EXISTS idx_exec_status ON executions (status);
CREATE INDEX IF NOT EXISTS idx_exec_start  ON executions (started_at DESC);
CREATE INDEX IF NOT EXISTS idx_exec_env    ON executions (environment);
CREATE INDEX IF NOT EXISTS idx_exec_errcat ON executions (error_category);

-- ── 11. EXECUTION STEPS ────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS execution_steps (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    execution_pk    BIGINT      NOT NULL REFERENCES executions(id) ON DELETE CASCADE,
    sequence        INT         NOT NULL,
    phase           TEXT        NOT NULL DEFAULT 'transaction',
        -- launch|login|password_change|relogin|search|transaction|logout|teller_reset|report
    step_name       TEXT        NOT NULL,
    status          TEXT        NOT NULL,          -- passed|failed|skipped|healed
    duration_ms     INT,
    screenshot_ref  TEXT,
    error_msg       TEXT,
    error_category  TEXT,                           -- Part 6: per-step classification
    element_key     TEXT,                           -- Part 8: execution-history lookup by element
    detail          TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_steps_exec   ON execution_steps (execution_pk, sequence);
CREATE INDEX IF NOT EXISTS idx_steps_errcat ON execution_steps (error_category);
CREATE INDEX IF NOT EXISTS idx_steps_elkey  ON execution_steps (element_key);

-- ── 12. SELF-HEALING LOG (Section 12) ──────────────────────────────────
CREATE TABLE IF NOT EXISTS self_heal_log (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_pk  BIGINT      REFERENCES transactions(id) ON DELETE CASCADE,
    execution_pk    BIGINT      REFERENCES executions(id) ON DELETE SET NULL,
    element_key     TEXT,
    old_locator     TEXT,
    new_locator     TEXT,
    strategy        TEXT,
    reason          TEXT,
    confidence      NUMERIC(4,3),
    applied         BOOLEAN     NOT NULL DEFAULT FALSE,
    approved_by     TEXT,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_heal_txn ON self_heal_log (transaction_pk);
CREATE INDEX IF NOT EXISTS idx_heal_elkey ON self_heal_log (element_key);

-- ── 13. BRD UPLOADS (Section 11.5) ─────────────────────────────────────
CREATE TABLE IF NOT EXISTS brd_uploads (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    filename            TEXT        NOT NULL,
    file_ref            TEXT        NOT NULL,
    content_hash        TEXT,
    parsed_text         TEXT,
    parsed_impact_json  TEXT       NOT NULL DEFAULT '{}',
    status              TEXT        NOT NULL DEFAULT 'uploaded',
        -- uploaded|analysed|approved|rejected|applied
    approved_by         TEXT,
    created_at          TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ── 13b. BRD IMPACT MATRIX (Part 14) ────────────────────────────────────
-- Structured, queryable rows alongside brd_uploads.parsed_impact_json
-- (kept, unchanged, as the raw AI response) — this table is what
-- Part 15's patch-plan builder and Part 16's regression scan actually
-- query, rather than re-parsing a JSON blob every time.
CREATE TABLE IF NOT EXISTS brd_impact_matrix (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    brd_pk              INTEGER     NOT NULL REFERENCES brd_uploads(id) ON DELETE CASCADE,
    requirement         TEXT,
    transaction_id      TEXT,
    screen              TEXT,
    element_key         TEXT,
    workflow            TEXT,
    current_behavior    TEXT,
    expected_behavior   TEXT,
    change_type         TEXT,
        -- new_transaction|workflow_change|field_change|validation_change|
        -- locator_change|no_change
    confidence          NUMERIC(4,3),
    risk                TEXT,           -- low|medium|high
    created_at          TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_impact_brd ON brd_impact_matrix (brd_pk);
CREATE INDEX IF NOT EXISTS idx_impact_txn ON brd_impact_matrix (transaction_id);
CREATE INDEX IF NOT EXISTS idx_impact_elkey ON brd_impact_matrix (element_key);

-- ── 14. FRAMEWORK INDEX (Section 8) ────────────────────────────────────
CREATE TABLE IF NOT EXISTS framework_artifacts (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    artifact_type   TEXT        NOT NULL,
        -- feature|page_object|step_definition|runner|utility|hook|property|test_data
    name            TEXT        NOT NULL,
    package         TEXT,
    file_path       TEXT        NOT NULL,
    content_hash    TEXT,
    transaction_id  TEXT,
    tags            TEXT        NOT NULL DEFAULT '[]',
    summary         TEXT,
    meta            TEXT       NOT NULL DEFAULT '{}',
    indexed_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (file_path)
);
CREATE INDEX IF NOT EXISTS idx_fw_type ON framework_artifacts (artifact_type);
CREATE INDEX IF NOT EXISTS idx_fw_txn  ON framework_artifacts (transaction_id);

CREATE TABLE IF NOT EXISTS framework_methods (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    artifact_pk     BIGINT      NOT NULL REFERENCES framework_artifacts(id) ON DELETE CASCADE,
    class_name      TEXT        NOT NULL,
    method_name     TEXT        NOT NULL,
    signature       TEXT,
    return_type     TEXT,
    annotations     TEXT        NOT NULL DEFAULT '[]',
    gherkin_pattern TEXT,                          -- for step definitions
    line_start      INT,
    line_end        INT,
    body_summary    TEXT
);
CREATE INDEX IF NOT EXISTS idx_fwm_artifact ON framework_methods (artifact_pk);
CREATE INDEX IF NOT EXISTS idx_fwm_gherkin  ON framework_methods (gherkin_pattern);

CREATE TABLE IF NOT EXISTS framework_relations (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    from_class      TEXT        NOT NULL,
    to_class        TEXT        NOT NULL,
    relation        TEXT        NOT NULL,          -- imports|extends|implements|calls|uses
    detail          TEXT
);
CREATE INDEX IF NOT EXISTS idx_fwr_from ON framework_relations (from_class);

-- ── 15. AI DECISIONS (continuous learning) ─────────────────────────────
CREATE TABLE IF NOT EXISTS ai_decisions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    agent           TEXT        NOT NULL,
    context_type    TEXT,                          -- recording|codegen|execution|heal|brd
    transaction_id  TEXT,
    prompt_summary  TEXT,
    decision        TEXT,
    rationale       TEXT,
    confidence      NUMERIC(4,3),
    outcome         TEXT,                          -- success|failure|unknown
    meta            TEXT       NOT NULL DEFAULT '{}',
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_ai_txn   ON ai_decisions (transaction_id);
CREATE INDEX IF NOT EXISTS idx_ai_agent ON ai_decisions (agent);

-- ── 16. HUMAN APPROVALS (Section 17) ───────────────────────────────────
CREATE TABLE IF NOT EXISTS approvals (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    thread_id       TEXT        NOT NULL,
    approval_type   TEXT        NOT NULL,   -- recording_keep|codegen|self_heal
    subject_ref     TEXT,
    payload         TEXT       NOT NULL DEFAULT '{}',
    decision        TEXT,                   -- pending|approved|rejected|discarded
    decided_by      TEXT,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    decided_at      TEXT
);
CREATE INDEX IF NOT EXISTS idx_appr_thread ON approvals (thread_id);

-- ── 17. VECTOR STORE (RAG, Section 9) ──────────────────────────────────
-- NOTE: dimension must match AZURE_OPENAI_EMBEDDING_DEPLOYMENT.
--       text-embedding-3-large = 3072, text-embedding-3-small = 1536.
CREATE TABLE IF NOT EXISTS knowledge_embeddings (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    namespace       TEXT        NOT NULL,
        -- element|dom|workflow|brd|framework|decision|report
    ref_type        TEXT,
    ref_id          TEXT,
    transaction_id  TEXT,
    content         TEXT        NOT NULL,
    meta            TEXT       NOT NULL DEFAULT '{}',
    embedding       TEXT,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_emb_ns  ON knowledge_embeddings (namespace);
CREATE INDEX IF NOT EXISTS idx_emb_txn ON knowledge_embeddings (transaction_id);
-- CREATE INDEX idx_emb_vec ON knowledge_embeddings

-- ── 18. RECORDING SESSIONS ─────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS recording_sessions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    session_uid     TEXT        NOT NULL UNIQUE,
    transaction_id  TEXT        NOT NULL,
    transaction_name TEXT,
    environment     TEXT,
    status          TEXT        NOT NULL DEFAULT 'recording',
        -- recording|stopped|kept|discarded|converted
    start_url       TEXT,
    capture_dir     TEXT,
    stats           TEXT       NOT NULL DEFAULT '{}',
    started_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    stopped_at      TEXT
);

-- ── trigger: keep updated_at fresh (native SQLite triggers) ────────────
DROP TRIGGER IF EXISTS trg_txn_touch;
CREATE TRIGGER trg_txn_touch AFTER UPDATE ON transactions
BEGIN
    UPDATE transactions SET updated_at = CURRENT_TIMESTAMP WHERE id = NEW.id;
END;

DROP TRIGGER IF EXISTS trg_profile_touch;
CREATE TRIGGER trg_profile_touch AFTER UPDATE ON test_data_profiles
BEGIN
    UPDATE test_data_profiles SET updated_at = CURRENT_TIMESTAMP WHERE id = NEW.id;
END;

DROP TRIGGER IF EXISTS trg_secrets_touch;
CREATE TRIGGER trg_secrets_touch AFTER UPDATE ON secrets
BEGIN
    UPDATE secrets SET updated_at = CURRENT_TIMESTAMP WHERE id = NEW.id;
END;
