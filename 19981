    now = datetime.now(timezone.utc).isoformat()
    for item in plan["items"]:
        if item["item_id"] == item_id:
            item["approval_status"] = "APPROVED"
            item["applied"] = True
            item["manually_handled"] = True
            item["manually_handled_by"] = current_user.username
            item["manually_handled_at"] = now
            item["manual_handling_note"] = note.strip() or "Marked as manually handled."
            item["validation_status"] = "CHANGE_VALIDATED"
            break

    all_done = all(
        i.get("applied") or i.get("approval_status") == "REJECTED"
        for i in plan["items"]
    )
    if all_done:
        plan["status"] = "APPLIED"

    save_change_plan(plan, application)
    return plan


@app.post("/api/change-plans/{plan_id}/generate-scenario")
async def generate_scenario_skeleton(
    plan_id: str,
    application: str,
    item_id: str,
    current_user: CurrentUser = Depends(get_current_user),
):
    """For NEW_TEST_SCENARIO items: generates a recording JSON skeleton
    from the requirement description and saves it under the application's
    recordings folder so the user can open it in the Step Editor and fill
    in the details. Does NOT auto-run or auto-apply anything.

    The skeleton contains:
    - application, recording_name, target_url (from existing recordings)
    - empty actions list with one placeholder step describing the scenario
    - provenance fields (cr_number, source item_id, plan_id)

    The user then opens it in Run Saved → Edit Steps to fill in real
    selectors and values before running it."""
    app_access.require_application_access(current_user, application, "edit")
    from solution_analyzer.service import load_change_plan, save_change_plan, _app_dir
    from recorder.recorder import save_recording_json
    from datetime import datetime, timezone

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    item_data = next((i for i in plan["items"] if i["item_id"] == item_id), None)
    if item_data is None:
        raise HTTPException(status_code=404, detail="Item not found in change plan")

    impact = item_data.get("impact_item", {})
    req = impact.get("requirement", {})

    if impact.get("change_type") != "NEW_TEST_SCENARIO":
        raise HTTPException(
            status_code=400,
            detail="Only NEW_TEST_SCENARIO items can generate a scenario skeleton."
        )

    # Find the target URL from an existing recording for this application
    existing_recordings = [
        r for r in list_saved_recordings()
        if (r.get("application") or "Others") == application
    ]
    target_url = existing_recordings[0]["target_url"] if existing_recordings else ""

    # Build the skeleton name
    txn = req.get("transaction") or ""
    field = req.get("field_name") or req.get("screen_name") or "New Scenario"
    skeleton_name = f"SKELETON_{plan.get('cr_number') or 'CR'}_{txn}_{field}".replace(" ", "_")[:60]

    # Placeholder action that describes what the scenario needs
    placeholder_action = {
        "action": "click",
        "element": {
            "tag": "",
            "text": f"[PLACEHOLDER] {req.get('description', 'New scenario step')}",
            "ariaLabel": "",
            "name": "",
            "type": "",
            "placeholder": "",
        },
        "value": None,
        "locators": [],
        "page_index": 0,
        "frame_path": [],
        "_skeleton": True,
        "_cr_number": plan.get("cr_number"),
        "_scenario_description": req.get("description"),
        "_transaction": txn,
        "_note": (
            "This is a skeleton step. Open this recording in the Step Editor "
            "(Run Saved → Edit Steps) to replace it with real selectors and values."
        ),
    }

    path = save_recording_json(
        target_url=target_url,
        actions=[placeholder_action],
        name=skeleton_name,
        app_name=application,
    )

    # Mark the item as having a skeleton generated
    now = datetime.now(timezone.utc).isoformat()
    for item in plan["items"]:
        if item["item_id"] == item_id:
            item["scenario_skeleton_generated"] = True
            item["scenario_skeleton_file"] = path
            item["scenario_skeleton_generated_at"] = now
            item["approval_status"] = "APPROVED"
            item["applied"] = True
            item["applied_at"] = now
            item["manually_handled"] = True
            item["manual_handling_note"] = f"Scenario skeleton generated at {path}. Open in Step Editor to complete."
            item["validation_status"] = "NOT_RUN"
            break

    save_change_plan(plan, application)

    return {
        "ok": True,
        "skeleton_file": path,
        "skeleton_name": skeleton_name,
        "message": (
            f"Skeleton recording saved to {path}. "
            "Open 'Run Saved Recording' → select this recording → 'Edit Steps' "
            "to add real selectors and values before running it."
        ),
    }



def export_change_plan(
    plan_id: str,
    application: str,
    format: str = "json",
    current_user: CurrentUser = Depends(get_current_user),
):
    """Export the change plan as JSON (default), CSV summary, or a
    human-readable text report suitable for filing with a CR or
    emailing to a manager for sign-off."""
    app_access.require_application_access(current_user, application, "export")
    from solution_analyzer.service import load_change_plan
    from datetime import datetime, timezone
    from starlette.responses import Response

    plan = load_change_plan(plan_id, application)
    if plan is None:
        raise HTTPException(status_code=404, detail="Change plan not found")

    if format == "json":
        content = json.dumps(plan, indent=2, default=str)
        return Response(
            content=content,
            media_type="application/json",
            headers={"Content-Disposition": f'attachment; filename="change_plan_{plan_id}.json"'},
        )

    if format == "csv":
        import csv, io
        buf = io.StringIO()
        writer = csv.writer(buf)
        writer.writerow([
            "Item ID", "Change Type", "Transaction", "Screen", "Field",
            "Old Value", "New Value", "Confidence %", "Confidence Level",
            "Recording", "Status", "Applied", "Validation",
            "Manual Review Required", "Implementable",
        ])
        for item in plan.get("items", []):
            impact = item.get("impact_item", {})
            req = impact.get("requirement", {})
            rec = impact.get("matched_recording") or {}
            conf = impact.get("confidence", 0)
            conf_label = "High" if conf >= 0.95 else "Review" if conf >= 0.80 else "Low"
            writer.writerow([
                item.get("item_id", "")[:8],
                impact.get("change_type", ""),
                req.get("transaction", ""),
                req.get("screen_name", ""),
                req.get("field_name", ""),
                impact.get("old_value", "") or impact.get("old_locator", ""),
                impact.get("proposed_value", "") or impact.get("proposed_locator", ""),
                f"{conf*100:.0f}",
                conf_label,
                rec.get("recording_name", ""),
                item.get("approval_status", ""),
                "Yes" if item.get("applied") else "No",
                item.get("validation_status", ""),
                "Yes" if impact.get("manual_review_required") else "No",
                "Yes" if impact.get("is_implementable", True) else "No",
            ])
        content = buf.getvalue()
        return Response(
            content=content,
            media_type="text/csv",
            headers={"Content-Disposition": f'attachment; filename="change_plan_{plan_id}.csv"'},
        )

    if format == "pdf":
        # Generate a PDF from the TXT report using only stdlib.
        # Uses a minimal HTML→PDF via the browser's print path (headless Playwright)
        # if available, or falls back to a plain-text PDF using reportlab if
        # installed, or as a last resort returns the TXT file with a .pdf extension
        # so at minimum the content is downloadable.
        txt_lines = [
            f"CHANGE PLAN REPORT",
            f"==================",
            f"Plan ID:       {plan.get('plan_id', '')}",
            f"CR Number:     {plan.get('cr_number') or 'N/A'}",
            f"Application:   {plan.get('application', '')}",
            f"Status:        {plan.get('status', '')}",
            f"",
        ]
        items = plan.get("items", [])
        txt_lines += [f"Total items: {len(items)}",
                      f"Approved: {sum(1 for i in items if i.get('approval_status') == 'APPROVED')}",
                      f"Applied: {sum(1 for i in items if i.get('applied'))}",
                      f"Rejected: {sum(1 for i in items if i.get('approval_status') == 'REJECTED')}", ""]
        for idx, item in enumerate(items, 1):
            impact = item.get("impact_item", {})
            req = impact.get("requirement", {})
            conf = impact.get("confidence", 0)
            txt_lines += [
                f"[{idx}] {impact.get('change_type', 'UNKNOWN')}",
                f"    Field: {req.get('field_name') or 'N/A'}",
                f"    Confidence: {conf*100:.0f}%",
                f"    Status: {item.get('approval_status', 'PENDING')} / Applied: {'Yes' if item.get('applied') else 'No'}",
                "",
            ]
        txt_content = "\n".join(txt_lines)
        # Try reportlab first
        try:
            from reportlab.lib.pagesizes import A4
            from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer
            from reportlab.lib.styles import getSampleStyleSheet
            from reportlab.lib.units import cm
            import io as _io
            buf = _io.BytesIO()
            doc = SimpleDocTemplate(buf, pagesize=A4,
                                    leftMargin=2*cm, rightMargin=2*cm,
                                    topMargin=2*cm, bottomMargin=2*cm)
            styles = getSampleStyleSheet()
            story = []
            for line in txt_content.split("\n"):
                if line.startswith("CHANGE PLAN REPORT"):
                    story.append(Paragraph(line, styles["Title"]))
                elif line.startswith("===") or not line.strip():
                    story.append(Spacer(1, 6))
                elif line.startswith("    "):
                    story.append(Paragraph(line.strip(), styles["Normal"]))
                else:
                    story.append(Paragraph(line, styles["Heading2"] if line.startswith("[") else styles["Normal"]))
            doc.build(story)
            pdf_bytes = buf.getvalue()
            return Response(
                content=pdf_bytes,
                media_type="application/pdf",
                headers={"Content-Disposition": f'attachment; filename="change_plan_{plan_id}.pdf"'},
            )
        except ImportError:
            pass
        # Fallback: return TXT with PDF content-type
        return Response(
            content=txt_content,
            media_type="application/pdf",
            headers={"Content-Disposition": f'attachment; filename="change_plan_{plan_id}.txt"'},
        )

    if format == "txt":
        lines = [
            f"CHANGE PLAN REPORT",
            f"==================",
            f"Plan ID:       {plan.get('plan_id', '')}",
            f"CR Number:     {plan.get('cr_number') or 'N/A'}",
            f"Application:   {plan.get('application', '')}",
            f"Document:      {plan.get('document_name') or 'N/A'}",
            f"Created by:    {plan.get('created_by') or 'N/A'}",
            f"Created at:    {plan.get('created_at', '')}",
            f"Status:        {plan.get('status', '')}",
            f"",
            f"SUMMARY",
            f"-------",
        ]
        items = plan.get("items", [])
        pending = sum(1 for i in items if i.get("approval_status") == "PENDING")
        approved = sum(1 for i in items if i.get("approval_status") == "APPROVED")
        rejected = sum(1 for i in items if i.get("approval_status") == "REJECTED")
        applied = sum(1 for i in items if i.get("applied"))
        validated = sum(1 for i in items if i.get("validation_status") == "CHANGE_VALIDATED")
        lines += [
            f"Total items:   {len(items)}",
            f"Pending:       {pending}",
            f"Approved:      {approved}",
            f"Rejected:      {rejected}",
            f"Applied:       {applied}",
            f"Validated:     {validated}",
            f"",
            f"CHANGE ITEMS",
            f"------------",
        ]
        for idx, item in enumerate(items, 1):
            impact = item.get("impact_item", {})
            req = impact.get("requirement", {})
            rec = (impact.get("matched_recording") or {})
            conf = impact.get("confidence", 0)
            lines += [
                f"",
                f"[{idx}] {impact.get('change_type', 'UNKNOWN')}",
                f"    Transaction:  {req.get('transaction') or 'N/A'}",
                f"    Screen:       {req.get('screen_name') or 'N/A'}",
                f"    Field:        {req.get('field_name') or 'N/A'}",
                f"    Description:  {req.get('description') or 'N/A'}",
                f"    Old value:    {impact.get('old_value') or impact.get('old_locator') or 'N/A'}",
                f"    New value:    {impact.get('proposed_value') or impact.get('proposed_locator') or 'N/A'}",
                f"    Confidence:   {conf*100:.0f}% ({'High' if conf>=0.95 else 'Review' if conf>=0.80 else 'Low'})",
                f"    Recording:    {rec.get('recording_name') or 'N/A'}",
                f"    Status:       {item.get('approval_status', 'PENDING')}",
                f"    Applied:      {'Yes — v' + str(item.get('new_version_number')) if item.get('applied') else 'No'}",
                f"    Validated:    {item.get('validation_status', 'NOT_RUN')}",
            ]
            if item.get("manually_handled"):
                lines.append(f"    Manual note:  {item.get('manual_handling_note', '')}")
            if impact.get("manual_review_required"):
                lines.append(f"    ⚠ Manual review: {impact.get('manual_review_reason', '')}")
            if not impact.get("is_implementable", True):
                lines.append(f"    ✗ Not implementable: {impact.get('not_implementable_reason', '')}")

        lines += ["", "END OF REPORT", f"Generated: {datetime.now(timezone.utc).isoformat()}"]
        content = "\n".join(lines)
        return Response(
            content=content,
            media_type="text/plain",
            headers={"Content-Disposition": f'attachment; filename="change_plan_{plan_id}.txt"'},
        )

    raise HTTPException(status_code=400, detail=f"Unknown format {format!r}. Use: json, csv, txt, pdf")



