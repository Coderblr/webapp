# Changes every time this process starts (fresh launch, or uvicorn --reload
# restarting the worker). The frontend remembers this from when it started a
# recording and compares it later - if it's different, the backend process
# restarted mid-recording (in-memory STATE, including the open browser, is
# gone), which needs a distinct message from "recording just failed to
# launch" so this doesn't turn into a confusing generic error again.
PROCESS_ID = str(uuid.uuid4())

# The Next.js frontend runs on a different origin, so allow it to call this
# API from the browser. CORS_ALLOWED_ORIGINS (.env) is a comma-separated
# allowlist for production (e.g. "https://recorder.yourbank.internal") -
# defaults to "*" for local dev only. Tighten this before hosting anywhere
# real: with credentials/Bearer tokens, a wildcard origin is fine (no
# cookies are used - the JWT travels in an explicit header/query param,
# never automatically attached by the browser like a cookie would be), but
# a real allowlist is still better hygiene once you know the frontend's
# actual origin.
import os as _os
_cors_origins = _os.environ.get("CORS_ALLOWED_ORIGINS", "*")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"] if _cors_origins.strip() == "*" else [o.strip() for o in _cors_origins.split(",") if o.strip()],
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.on_event("startup")
async def _on_startup():
    """Runs the stale-agent reaper for the lifetime of the process (see
    backend/agent_registry.py's reap_stale_agents) - catches a dropped
    agent connection that the WebSocket layer itself never cleanly
    detected (some network failures don't deliver a close frame)."""
    asyncio.ensure_future(agent_registry.reap_stale_agents())


@app.on_event("shutdown")
def _on_shutdown():
    """
    Runs on a graceful stop (Ctrl+C in the terminal, or uvicorn --reload
    restarting the worker process) - closes every still-open recorder
    browser session (there can be several now - one per concurrently
    recording user, see backend/recording_sessions.py) and releases the
    database's connection pool, so no Edge/Chrome process or
    database/test_recorder.db is left locked behind.
    """
    _cleanup_all()


def _cleanup_all(timeout: float = 15):
    """Shared by the ASGI shutdown event above (normal Ctrl+C stop) AND
    shutdown_guard's Windows console-close handler below (terminal window
    closed directly) - whichever fires first runs this exactly once."""
    recording_sessions.stop_all(timeout=timeout)
    close_db()


# Covers the case Ctrl+C/ASGI shutdown can't: the terminal window being
# closed directly. Windows only gives ~5s to clean up in that case, so use
# a shorter timeout than the normal graceful-stop path above.
register_cleanup(lambda: _cleanup_all(timeout=3))


