@step("the teller is logged in to the application")
def step_teller_is_logged_in(context):
    started = time.time()
    login = _login_page()

    # If the 9750 password-change pre-step already ran in THIS same browser
    # session, the teller is already logged in (with the NEW password) by
    # the time this Background step runs for the target transaction's
    # scenarios. Re-submitting credentials here used to blindly type the
    # OLD (now-invalid) password into whatever text input the login
    # field's loose fallback selector happened to match on the
    # already-loaded transaction screen — corrupting a real field like
    # AccountNumber and causing failures further into the run. Skip login
    # entirely when a session is already active.
    if login.is_logged_in():
        ctx.record_step("login", "Already logged in — skipping re-login", "passed",
                         int((time.time() - started) * 1000), "", None)
        return

    url = ctx.get("url", os.environ.get("SBI_TARGET_URL"))
    teller_id = os.environ.get("SBI_TELLER_ID")
    # Use the NEW password once 9750 has been attached to this run
    # (it changes the password before this step ever runs standalone on
    # its own) — otherwise the ORIGINAL password, for a transaction
    # executed with the password-change pre-step skipped/unavailable.
    prestep_attached = bool(ctx.prestep())
    password = (os.environ.get("SBI_TELLER_NEW_PASSWORD") if prestep_attached
                else os.environ.get("SBI_TELLER_PASSWORD"))
    assert teller_id, "Teller ID was not supplied by the platform"

    login.open(url)
    login.login_as(teller_id, password)
    ctx.record_step("login", "Login with teller credentials", "passed",
                     int((time.time() - started) * 1000), "", None)


@step("the mandatory password change is completed")
def step_password_change_completed(context):
    """Transaction 9750 runs as a separate feature ahead of this one.
    Here we only assert that the application is past the change screen."""
    login = _login_page()
    still_on_change_screen = login.is_password_change_screen_visible()
    ctx.record_step("password_change", "Password change window cleared",
                     "failed" if still_on_change_screen else "passed", 0, "",
                     "Application is still showing the Change Password window"
                     if still_on_change_screen else None)
    assert not still_on_change_screen, "Password change window is still open"


