<div style={styles.legalBox}>
  <div style={styles.legalHeader}>
    <span style={styles.warningIcon}>⚠</span>
    <span>Legal Warning</span>
  </div>

  <ul style={styles.legalList}>
    <li>
      This application is for the use of <strong>authorised users</strong>{" "}
      for <strong>authorised purposes only</strong>.
    </li>

    <li>
      All activities performed on this application may be{" "}
      <strong>recorded and monitored by the Bank</strong>.
    </li>

    <li>
      Users must not access or use the application{" "}
      <strong>without proper authorisation</strong>.
    </li>

    <li>
      Using the application without authority or beyond the user's
      authorised access is a violation of the Bank's IT policy.
    </li>

    <li>
      Such violations may result in <strong>legal and/or disciplinary
      action</strong> as per the Bank's policy.
    </li>
  </ul>
</div>




legalBox: {
  marginTop: "28px",
  padding: "18px 22px",
  background: "#f8fafc",
  border: "1px solid #e2e8f0",
  borderLeft: "4px solid #f59e0b",
  borderRadius: "10px",
  color: "#64748b",
  fontSize: "13px",
  lineHeight: "1.6",
},

legalHeader: {
  display: "flex",
  alignItems: "center",
  gap: "8px",
  marginBottom: "12px",
  color: "#334155",
  fontWeight: "600",
  fontSize: "15px",
},

warningIcon: {
  fontSize: "16px",
},

legalList: {
  margin: 0,
  paddingLeft: "20px",
},

legalList li: {
  marginBottom: "8px",
},