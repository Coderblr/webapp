class StepEditModel(BaseModel):
    """One editable step - the frontend's step editor sends the WHOLE list
    back on every save (add/delete/reorder/edit are all just "the list is
    now different"), rather than separate add/delete/update endpoints -
    simpler to implement correctly and matches how /api/recordings/data
    already works for test-data values. Fields not relevant to a given
    `action` (e.g. `value` for a "delay" step) are simply ignored when
    reconstructing the recording's actions."""
    action: str
    label: str = ""  # human-readable name shown in the editor and used for step naming - NOT saved verbatim, just informs element.text
    value: Optional[str] = None
    locators: list[dict] = []  # [{"strategy": "ID", "value": "username"}, ...]
    raw_selector: Optional[str] = None  # the exact <webctrl .../> text, if this step came from (or was edited via) a pasted UiPath selector - see uipath_importer.py's same field
    scroll_direction: Optional[str] = None
    scroll_amount: Optional[int] = None
    delay_seconds: Optional[float] = None
    captured_as: Optional[str] = None  # variable name, for "copy"/"ocr_capture" steps
    # The recorded action this row came from (sent back unchanged by the editor). Saving MERGES the row's edits
    # onto it, so everything the editor has no column for - iframe path, tab number, date format, element
    # details - survives an edit instead of being thrown away.
    original: Optional[dict] = None
    # Runtime configurable step (automation/runtime_config.py) - None/"configurable": false = an ordinary step.
    runtime_config: Optional[dict] = None
    # Check rows (automation/checks.py): the check's settings; "remember value" rows: the capture's settings.
    assertion: Optional[dict] = None
    capture_cfg: Optional[dict] = None
    check_suggestion: Optional[dict] = None    # an AI suggestion waiting for the tester's decision


