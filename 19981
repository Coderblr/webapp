"""Structured error classification (Part 6).

Replaces "it failed, here's a string" with a category the rest of the
platform can actually make decisions from — most importantly, whether
self-healing should even ATTEMPT anything. A LOCATOR failure and an
AUTHENTICATION failure both "fail a step", but only one of them should
ever trigger a locator-healing attempt; treating them the same was the
platform's biggest source of self-healing doing the wrong thing.

Deterministic, rule-based — this module never calls the LLM. It reads an
error message / exception type-name / step context and returns a
structured decision. Semantic self-healing (Part 10) consumes this
output; it does not duplicate this reasoning.
"""
from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Any

# Category -> whether it's typically recoverable at all, and whether it's
# EVER appropriate to hand to AI-assisted healing. These are defaults;
# individual rules below can still override per-match via `recoverable=`/
# `requires_ai=` on the ErrorClassification returned.
CATEGORIES = (
    "LOCATOR", "ELEMENT_NOT_INTERACTABLE", "STALE_ELEMENT", "TIMEOUT",
    "FRAME", "SHADOW_DOM", "NAVIGATION", "AUTHENTICATION", "SESSION_EXPIRED",
    "TEST_DATA", "VALIDATION", "BUSINESS_RULE", "ASSERTION", "APPLICATION_ERROR",
    "NETWORK", "WEBDRIVER", "ENVIRONMENT", "CODE_GENERATION",
    "STEP_DEFINITION", "UNKNOWN",
)


@dataclass
class ErrorClassification:
    category: str
    subcategory: str = ""
    confidence: float = 0.5
    recoverable: bool = False
    requires_ai: bool = False
    requires_rerecord: bool = False
    # Human-readable explanation of WHY this category was chosen — shown
    # in the report and passed to whatever consumes the classification,
    # so a person reviewing a failure isn't left guessing why the
    # platform decided (say) not to attempt healing.
    reason: str = ""
    matched_rule: str = ""

    def to_dict(self) -> dict[str, Any]:
        return {
            "category": self.category,
            "subcategory": self.subcategory,
            "confidence": self.confidence,
            "recoverable": self.recoverable,
            "requires_ai": self.requires_ai,
            "requires_rerecord": self.requires_rerecord,
            "reason": self.reason,
        }


@dataclass
class _Rule:
    category: str
    pattern: re.Pattern[str]
    subcategory: str = ""
    recoverable: bool = False
    requires_ai: bool = False
    requires_rerecord: bool = False
    confidence: float = 0.9
    reason: str = ""


# Ordered — first match wins, so more specific patterns are listed before
# their more general supersets (e.g. StaleElementReferenceException
# before the generic "element" fallback).
_RULES: list[_Rule] = [
    # Checked FIRST, before STALE_ELEMENT/ELEMENT_NOT_INTERACTABLE/LOCATOR —
    # "All registered locators failed" is also literally true of a session-
    # expired failure (nothing on a logged-out page matches a transaction
    # screen's locators either), so the generic LOCATOR rule would otherwise
    # win first and mask the real, more specific cause.
    _Rule("SESSION_EXPIRED",
          re.compile(r"logout_cbs\.action|session.*(expir|timeout|ended)|"
                     r"logged.?out|please.?login.?again", re.I),
          reason="The application session ended (redirected to a logout URL) "
                 "partway through the transaction — not a genuinely missing/"
                 "broken locator. Every 'Locator failure' AFTER this point is a "
                 "consequence of being on the wrong (logged-out) page, not a "
                 "real element-not-found; no locator fix can address it. If "
                 "this repeats, the transaction is likely taking longer "
                 "(accumulated waits/retries/healing) than the application's "
                 "own session/idle timeout allows.",
          recoverable=False, requires_ai=False, confidence=0.9),
    _Rule("STALE_ELEMENT",
          re.compile(r"StaleElementReferenceException", re.I),
          reason="Element reference went stale between resolve and interaction — "
                 "almost always a timing issue, not a genuinely broken locator.",
          recoverable=True, confidence=0.95),
    _Rule("ELEMENT_NOT_INTERACTABLE",
          re.compile(r"ElementNotInteractableException|ElementClickInterceptedException", re.I),
          reason="Element exists but something (an overlay, a not-yet-settled "
                 "animation) blocked the interaction.",
          recoverable=True, confidence=0.9),
    _Rule("LOCATOR",
          re.compile(r"NoSuchElementException|No locators registered|"
                     r"All registered locators failed|Could not resolve", re.I),
          reason="No registered locator strategy could find the element at all.",
          recoverable=True, requires_ai=False, confidence=0.9),
    _Rule("FRAME",
          re.compile(r"NoSuchFrameException|frame.*not.*found|switch_to\.frame", re.I),
          reason="An iframe the step expected wasn't present/reachable.",
          recoverable=True, confidence=0.7),
    _Rule("SHADOW_DOM",
          re.compile(r"shadow.?root|shadowRoot", re.I),
          reason="Element lives inside a shadow DOM boundary that wasn't pierced.",
          recoverable=True, requires_ai=True, confidence=0.6),
    _Rule("TIMEOUT",
          re.compile(r"TimeoutException|timed out|Runner timed out", re.I),
          reason="An explicit wait exceeded its budget.",
          recoverable=True, confidence=0.8),
    _Rule("AUTHENTICATION",
          re.compile(r"[Aa]ccess [Dd]enied|authentication_failed|invalid.*credential|"
                     r"login.*fail|incorrect.*password", re.I),
          reason="Credential/login rejection — never a locator problem, and "
                 "changing automation code cannot fix bad/expired credentials.",
          recoverable=False, requires_ai=False, confidence=0.9),
    _Rule("TEST_DATA",
          re.compile(r"does not match expected format|Test data field .* was not supplied|"
                     r"was not supplied for transaction", re.I),
          reason="A supplied (or missing) test-data value failed validation "
                 "against its expected pattern — a data problem, not a UI problem.",
          recoverable=False, requires_ai=False, confidence=0.9),
    _Rule("STEP_DEFINITION",
          re.compile(r"AmbiguousStep|StepNotImplementedError|"
                     r"no matching step (definition|implementation)", re.I),
          reason="Gherkin step text has no (or more than one) matching Python "
                 "step definition — a code-generation problem, not a runtime one.",
          recoverable=False, requires_rerecord=False, confidence=0.9),
    _Rule("CODE_GENERATION",
          re.compile(r"ParserError|SyntaxError|IndentationError", re.I),
          reason="Generated Python/Gherkin failed to parse — a code-generation defect.",
          recoverable=False, confidence=0.9),
    _Rule("NAVIGATION",
          re.compile(r"ERR_CONNECTION|ERR_NAME_NOT_RESOLVED|about:blank|"
                     r"unexpectedly navigated|net::ERR", re.I),
          reason="The browser ended up on an unexpected URL/page.",
          recoverable=True, confidence=0.6),
    _Rule("WEBDRIVER",
          re.compile(r"WebDriverException|SessionNotCreatedException|"
                     r"chromedriver|msedgedriver", re.I),
          reason="The browser/driver process itself failed to start or crashed.",
          recoverable=False, confidence=0.8),
    _Rule("NETWORK",
          re.compile(r"ConnectionError|ConnectionRefusedError|socket\.timeout|"
                     r"Access Denied \(authentication_failed\)", re.I),
          reason="A network-level failure (proxy, DNS, connection refused).",
          recoverable=True, confidence=0.6),
    _Rule("ENVIRONMENT",
          re.compile(r"ModuleNotFoundError|ImportError|not installed|"
                     r"No module named", re.I),
          reason="A required package/tool isn't available in this environment.",
          recoverable=False, confidence=0.85),
    _Rule("ASSERTION",
          re.compile(r"AssertionError|assert_element|assertEqual|does not match", re.I),
          reason="An explicit assertion about the application's behaviour failed — "
                 "changing automation code to make this pass would hide a real "
                 "application/business-rule issue, not fix a broken test.",
          recoverable=False, requires_ai=False, confidence=0.7),
    _Rule("VALIDATION",
          re.compile(r"validation message|expected error message|rejects an invalid value", re.I),
          reason="A negative-path validation check didn't behave as expected.",
          recoverable=False, confidence=0.6),
]


def classify(error_text: str | None, context: dict[str, Any] | None = None) -> ErrorClassification:
    """`context` is optional extra signal (e.g. {"phase": "transaction",
    "step_name": "..."}); currently used only to refine the subcategory,
    never to override a text-based match — the actual error message is
    always the primary source of truth."""
    text = error_text or ""
    context = context or {}

    for rule in _RULES:
        if rule.pattern.search(text):
            return ErrorClassification(
                category=rule.category,
                subcategory=context.get("phase", ""),
                confidence=rule.confidence,
                recoverable=rule.recoverable,
                requires_ai=rule.requires_ai,
                requires_rerecord=rule.requires_rerecord,
                reason=rule.reason,
                matched_rule=rule.pattern.pattern,
            )

    # BUSINESS_RULE: deliberately has no reliable text signature (the
    # application's own message text is different for every screen) — it's
    # inferred only when nothing else matched AND the failure happened on
    # an assertion/validation-shaped step; otherwise this correctly falls
    # through to UNKNOWN rather than guessing.
    step_name = (context.get("step_name") or "").lower()
    if any(k in step_name for k in ("validate", "assert", "verify", "confirm")):
        return ErrorClassification(
            category="APPLICATION_ERROR",
            subcategory=context.get("phase", ""),
            confidence=0.4,
            recoverable=False,
            requires_ai=False,
            reason="Failed on a validate/verify/confirm step with no recognised "
                   "exception signature — likely the application's own business "
                   "logic rejecting the scenario, not an automation defect.",
        )

    return ErrorClassification(
        category="UNKNOWN",
        confidence=0.2,
        recoverable=False,
        requires_ai=False,
        reason="No known error signature matched — needs human review before "
               "any automated healing is attempted.",
    )


def healing_policy(classification: ErrorClassification) -> dict[str, Any]:
    """Part 6's worked examples, turned into an actual decision the
    execution pipeline / self-healing agent can act on directly."""
    if classification.category in ("AUTHENTICATION",):
        return {"action": "stop", "reason": "Authentication failures must stop the "
                                             "run, not be healed or retried blindly."}
    if classification.category == "SESSION_EXPIRED":
        return {"action": "stop", "reason": "The session ended mid-transaction — a "
                                             "locator swap cannot fix this; re-running "
                                             "sooner, or reducing what happens before "
                                             "this point, is the real remedy."}
    if classification.category in ("BUSINESS_RULE", "ASSERTION", "APPLICATION_ERROR"):
        return {"action": "capture_and_stop",
                "reason": "Do not automatically change automation code in response "
                          "to the application's own business logic or an explicit "
                          "assertion — that would hide a real issue."}
    if classification.category == "LOCATOR":
        return {"action": "attempt_locator_healing"}
    if classification.category in ("TIMEOUT", "STALE_ELEMENT", "ELEMENT_NOT_INTERACTABLE"):
        return {"action": "retry", "reason": "Transient — safe to retry per the "
                                              "existing retry policy before escalating."}
    if classification.category in ("TEST_DATA", "STEP_DEFINITION", "CODE_GENERATION",
                                    "ENVIRONMENT", "WEBDRIVER"):
        return {"action": "stop", "reason": "Not something locator-healing can "
                                             "address — needs a data/codegen/"
                                             "environment fix, not a browser retry."}
    return {"action": "capture_and_stop",
            "reason": "Unrecognised failure — capture evidence, do not guess."}
