        raise HTTPException(404, f"Step {step_number} not found in this recording's Excel dataset")
    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "update_step",
        recording_id=recording_id, details={"step_number": step_number, "updates": req.updates},
    )
    return {"updated": True, "step_number": step_number}


