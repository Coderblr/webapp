"""
Uses the configured LLM (if any) to turn a raw recorded action into:
  - a short, stable element name (snake_case, used as the Page Object method/locator key)
  - a natural-language Gherkin step phrase

Falls back to deterministic heuristics (recorder/locator_strategy.py) when
no LLM is configured, so the whole pipeline still works with zero API keys.
"""
from __future__ import annotations
import json
from typing import Dict, List

from recorder.locator_strategy import suggest_element_name

# Human-readable labels for the non-character keys the recorder/injector captures
# (see recorder/recorder_injector.js CAPTURED_KEYS) and that the generated Page
# Object can replay via Playwright's press() (see generator/templates/page.tmpl).
KEY_LABELS = {
    "ENTER": "Enter",
    "BACKSPACE": "Backspace",
    "ARROW_UP": "Arrow Up",
    "ARROW_DOWN": "Arrow Down",
    "ARROW_LEFT": "Arrow Left",
    "ARROW_RIGHT": "Arrow Right",
    "TAB": "Tab",
    "SHIFT+TAB": "Shift+Tab",
    "ESCAPE": "Escape",
    "DELETE": "Delete",
    "SPACE": "Space",
    "HOME": "Home",
    "END": "End",
    "CTRL+A": "Ctrl+A",
    "CTRL+C": "Ctrl+C",
    "CTRL+V": "Ctrl+V",
    "CTRL+X": "Ctrl+X",
    "CTRL+P": "Ctrl+P",
    "CTRL+S": "Ctrl+S",
}
KEY_LABELS.update({f"F{i}": f"F{i}" for i in range(1, 13)})


def key_label(key_name: str) -> str:
    """Human-friendly label for a recorded keypress value, e.g. 'ARROW_UP' -> 'Arrow Up'."""
    return KEY_LABELS.get((key_name or "").upper(), key_name or "a key")


SYSTEM_PROMPT = """You are a test-automation assistant. Given a single recorded browser
action (click, type, select, keypress, copy, or paste) with details about the target element, respond with STRICT JSON only:
{"element_name": "snake_case_name", "step_phrase": "natural language phrase"}

Rules:
- element_name: short, stable, snake_case, descriptive (e.g. "amount_input", "submit_button",
  "gender_radio", "terms_checkbox", "country_dropdown")
- step_phrase: describes the action for a Gherkin step, e.g. "enters the amount", "clicks the Submit button",
  "presses Enter on the search field", or "selects the country". For type/select actions, DO NOT include the
  literal value in step_phrase (the value is inserted separately). keypress actions represent the user pressing
  a non-character key (Enter, Backspace, Arrow Up, Arrow Down, Arrow Left, Arrow Right, Tab, Escape, Delete, Space,
  Home, End, an F1-F12 function key, or a Ctrl combo such as CTRL+A/CTRL+P/CTRL+S/SHIFT+TAB) on that element - the
  specific key is given in "value" (e.g. "ENTER", "ARROW_DOWN", "CTRL+A"); phrase it naturally, e.g. "presses
  Backspace on the search field". copy actions represent the user copying the current value out of a field (its
  live value is captured and stored as a variable at playback time, not baked in as a literal) - phrase it like
  "captures the value of the generated username field". paste actions represent the user pasting a previously
  copied value into a field - phrase it like "pastes the copied value into the username field". select actions
  represent choosing an option from a native <select> dropdown. click actions on an element with type "radio" or
  "checkbox" represent selecting that radio option or toggling that checkbox, not a generic click.
No prose, no markdown fences, JSON only."""


def _heuristic_phrase(action_record: Dict) -> str:
    el = action_record["element"]
    action = action_record["action"]
    el_type = (el.get("type") or "").lower()
    label = el.get("text") or el.get("ariaLabel") or el.get("placeholder") or el.get("name") or el.get("tag") or "element"

    if action == "type":
        return f"enters a value into the {el.get('placeholder') or el.get('name') or label}"
    if action == "select":
        return f"selects an option from the {el.get('name') or el.get('ariaLabel') or label}"
    if action == "keypress":
        key = action_record.get("value") or "ENTER"
        return f"presses {key_label(key)} on the {label}"
    if action == "copy":
        return f"captures the value of the {label}"
    if action == "paste":
        return f"pastes the copied value into the {el.get('placeholder') or el.get('name') or 'field'}"
    if action in ("assert_text", "assert_ocr_text"):
        return f"verifies {label} is visible"
    if action == "scroll":
        return f"scrolls the page"
    if action == "delay":
        return f"waits {action_record.get('value') or ''}s"
    if action == "window_closed":
        return "closes the browser tab"
    if action == "date":
        return f"sets the date in {label}"
    if action == "click":
        if el_type == "radio":
            return f"selects the {label} option"
        if el_type == "checkbox":
            return f"toggles the {label}"
        return f"clicks the {label}"
    return f"interacts with the {label}"


def name_step(llm, action_record: Dict, used_names: set) -> Dict:
    # Fast path 1: no LLM configured — use deterministic heuristic.
    if llm is None:
        name = suggest_element_name(action_record, used_names)
        return {"element_name": name, "step_phrase": _heuristic_phrase(action_record)}

    # Fast path 2: element already has a meaningful human-readable label
    # (ariaLabel, text, placeholder, name).  For UiPath imports this is the
    # Object Name column value; for native recordings it's what the injector
    # captured.  The LLM would produce roughly the same result from this
    # information at the cost of a ~0.7s API call per step — skip it.
    el = action_record.get("element") or {}
    existing_label = (
        el.get("ariaLabel") or
        el.get("text") or
        el.get("placeholder") or
        el.get("name") or
        ""
    ).strip()
    # Only skip LLM if the label is meaningfully descriptive (not just a
    # single character, a number, or a generic tag like "button"/"input").
    GENERIC = {"button", "input", "submit", "click", "a", "span", "div",
               "link", "text", "element", "field", "ok", "yes", "no"}
    label_is_useful = (
        len(existing_label) >= 3 and
        existing_label.lower() not in GENERIC and
        not existing_label.isdigit()
    )
    if label_is_useful:
        name = suggest_element_name(action_record, used_names)
        return {"element_name": name, "step_phrase": _heuristic_phrase(action_record)}

    # LLM path: element has no useful label (e.g. unlabelled icon buttons,
    # elements identified only by CSS/XPath) — LLM can infer from context.
    user_content = json.dumps({
        "action": action_record["action"],
        "element": action_record["element"],
        "value": action_record.get("value"),
    })
    try:
        resp = llm.invoke([
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": user_content},
        ])
        text = resp.content.strip()
        if text.startswith("```"):
            text = text.strip("`").split("\n", 1)[-1]
        data = json.loads(text)
        name = data["element_name"]
        base = name
        n = 2
        while name in used_names:
            name = f"{base}_{n}"
            n += 1
        used_names.add(name)
        return {"element_name": name, "step_phrase": data["step_phrase"]}
    except Exception:
        # LLM hiccup - don't fail the whole pipeline, fall back to heuristic
        name = suggest_element_name(action_record, used_names)
        return {"element_name": name, "step_phrase": _heuristic_phrase(action_record)}
