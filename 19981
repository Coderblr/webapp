"""
Runs the generated behave suite and returns structured pass/fail output.

Uses a real subprocess (`sys.executable -m behave ...`) normally - this is
what lets behave's own CLI/formatters work completely unmodified, and
keeps each run in a totally clean process (no leftover step-registry state
from a previous run).

IMPORTANT for the local desktop agent (local_agent/): `sys.executable`
inside a PyInstaller-frozen executable (see local_agent/local_agent.spec)
is the path to the FROZEN .EXE ITSELF, not a real Python interpreter -
there is no "python.exe" to shell out to. `[sys.executable, "-m", "behave",
...]` would try to re-launch the agent app with nonsense arguments instead
of actually running behave, which is exactly why "Start Recording" (in-
process, via recorder/recorder.py - no subprocess involved) worked from a
packaged local_agent.exe while "Run" (this file, subprocess-based) did
not: the subprocess never got anywhere near actually launching Playwright.

run_behave_cli() below detects a frozen build (`sys.frozen`, set by
PyInstaller) and calls behave's own programmatic entry point
(`behave.__main__.main`) IN-PROCESS instead - no subprocess, no
sys.executable problem. Since that reuses the current process across
multiple test runs on a long-running agent, it also resets behave's global
step registry before each call (see _reset_step_registry) - without that,
a second run would fail with spurious "ambiguous step" errors from the
first run's step definitions never being cleared.
"""
from __future__ import annotations
import contextlib
import io
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parent.parent


def _reset_step_registry() -> None:
    """Only relevant for the in-process (frozen-exe) path below - a normal
    subprocess run starts a brand new Python process each time, so this
    isn't needed there. Behave keeps its @given/@when/@then registrations
    in one process-wide registry; without resetting it, running a SECOND
    test in the same long-running agent process would see both runs' step
    definitions at once and fail with "ambiguous step" errors."""
    try:
        import behave.step_registry as step_registry
        step_registry.registry.steps = {"given": [], "when": [], "then": [], "step": []}
    except Exception:
        pass  # best-effort - a failure here shouldn't block the actual test run


def run_behave_cli(behave_args: list[str], cwd: str, env_overrides: dict) -> dict:
    """Runs behave with `behave_args` (e.g. [features_dir, "--no-capture"]),
    returning {"returncode", "output"}. See this module's docstring for why
    there are two code paths."""
    if getattr(sys, "frozen", False):
        from behave.__main__ import main as behave_main

        _reset_step_registry()
        old_cwd = os.getcwd()
        old_env = {k: os.environ.get(k) for k in env_overrides}
        stdout_buf, stderr_buf = io.StringIO(), io.StringIO()
        returncode = 1
        try:
            os.chdir(cwd)
            os.environ.update(env_overrides)
            with contextlib.redirect_stdout(stdout_buf), contextlib.redirect_stderr(stderr_buf):
                try:
                    result = behave_main(behave_args)
                    returncode = result if isinstance(result, int) else 0
                except SystemExit as e:
                    returncode = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        finally:
            os.chdir(old_cwd)
            for k, v in old_env.items():
                if v is None:
                    os.environ.pop(k, None)
                else:
                    os.environ[k] = v
        return {"returncode": returncode, "output": stdout_buf.getvalue() + "\n" + stderr_buf.getvalue()}

    full_env = {**os.environ, **env_overrides}
    proc = subprocess.run(
        [sys.executable, "-m", "behave", *behave_args],
        cwd=cwd, capture_output=True, text=True, env=full_env,
    )
    return {"returncode": proc.returncode, "output": proc.stdout + "\n" + proc.stderr}


def run(output_dir: str = "output", headless: bool = False) -> dict:
    features_dir = Path(output_dir) / "features"
    if not features_dir.exists():
        return {"ok": False, "returncode": -1, "output": f"No features found at {features_dir}. Generate first."}

    result = run_behave_cli(
        [str(features_dir), "--no-capture"],
        cwd=str(ROOT),
        env_overrides={"HEADLESS": "true" if headless else "false"},
    )
    return {"ok": result["returncode"] == 0, "returncode": result["returncode"], "output": result["output"]}


if __name__ == "__main__":
    result = run()
    print(result["output"])
    sys.exit(result["returncode"])
