import { useState } from "react";
import { transactionsApi } from "@/lib/api";
import { buildReportText, buildReportHtml, downloadBlob, openReportInBrowser } from "@/lib/report";
import { ReportDonut, StepSequenceBar } from "@/components/ReportCharts";
import { Panel, PanelHeader, DataTable, Disclosure, Callout, Button, StatusBadge, Metric } from "@/components/ui";

/**
 * The full "Exit report" display - donut chart, step-sequence strip,
 * Automation Log (each executed step's own screenshot, viewable inline),
 * Files Produced (each downloadable), and raw Behave output. Used both
 * right after a fresh run (RunSavedTab.js) and when reviewing a past
 * execution (MyExecutionsTab.js) - identical either way, since both are
 * just the SAME transaction shape returned by
 * runner/run_recording.py / GET /api/transactions/{id}.
 */
export default function ReportView({ report }) {
  const [screenshotModal, setScreenshotModal] = useState(null); // {dataUrl, stepName} | null
  const [screenshotLoadingFor, setScreenshotLoadingFor] = useState(null);
  const [downloadingFile, setDownloadingFile] = useState(null);
  const [actionError, setActionError] = useState(null);

  async function handleViewScreenshot(step, index) {
    if (!step.screenshot || !report?.screenshots_folder) return;
    setScreenshotLoadingFor(index);
    setActionError(null);
    try {
      const dataUrl = await transactionsApi.fetchImageDataUrl(report.transaction_id, step.screenshot, report.screenshots_folder);
      setScreenshotModal({ dataUrl, stepName: step.step_name });
    } catch (e) {
      setActionError(`Could not load screenshot: ${e.detail || e.message}`);
    } finally {
      setScreenshotLoadingFor(null);
    }
  }

  async function handleDownloadFile(fileName, folderPath) {
    setDownloadingFile(fileName);
    setActionError(null);
    try {
      await transactionsApi.downloadFile(report.transaction_id, fileName, folderPath);
    } catch (e) {
      setActionError(`Could not download "${fileName}": ${e.detail || e.message}`);
    } finally {
      setDownloadingFile(null);
    }
  }

  if (!report) return null;

  return (
    <Panel>
      <PanelHeader title="Exit report" caption={`Transaction #${report.transaction_id} · ${report.date_time} UTC`} />
      <div className="min-w-0 space-y-6 px-5 py-5">
        <div className="flex flex-wrap items-center gap-6 rounded-sm border border-line bg-rail/60 p-4">
          <ReportDonut passed={report.passed_count} failed={report.failed_count} />
          <div className="min-w-0 flex-1 space-y-3">
            <div className="flex flex-wrap items-center gap-3">
              <StatusBadge status={report.status} />
              <span className="text-sm text-muted">
                Run by <strong className="font-medium text-ink">{report.user}</strong>
              </span>
            </div>
            <StepSequenceBar steps={report.steps} />
            <div className="grid grid-cols-3 gap-2 sm:max-w-sm">
              <Metric label="Steps" value={report.step_count} />
              <Metric label="Passed" value={report.passed_count} />
              <Metric label="Failed" value={report.failed_count} />
            </div>
          </div>
        </div>

        <div className="min-w-0">
          <h3 className="mb-2 text-sm font-semibold text-ink">Automation log</h3>
          {actionError && (
            <div className="mb-2">
              <Callout tone="error">{actionError}</Callout>
            </div>
          )}
          <DataTable
            columns={[
              { key: "n", label: "#" },
              { key: "step", label: "Playwright step" },
              { key: "status", label: "Status" },
              { key: "error", label: "Error", mono: true },
              { key: "screenshot", label: "Screenshot" },
            ]}
            rows={report.steps.map((s, i) => ({
              n: i + 1,
              step: s.step_name,
              status: <StatusBadge status={s.status} />,
              error: s.error_message || "",
              screenshot: s.screenshot ? (
                <button
                  type="button"
                  className="text-xs font-medium text-brand-blue hover:underline disabled:opacity-40"
                  disabled={screenshotLoadingFor === i}
                  onClick={() => handleViewScreenshot(s, i)}
                >
                  {screenshotLoadingFor === i ? "Loading..." : "View"}
                </button>
              ) : (
                <span className="text-xs text-muted">—</span>
              ),
            }))}
          />
        </div>

        <Disclosure title={`Files produced (${report.files.length})`}>
          <DataTable
            columns={[
              { key: "file_name", label: "File" },
              { key: "folder_path", label: "Folder", mono: true },
              { key: "download", label: "" },
            ]}
            rows={report.files.map((f) => ({
              file_name: f.file_name,
              folder_path: f.folder_path,
              download: (
                <button
                  type="button"
                  className="text-xs font-medium text-brand-blue hover:underline disabled:opacity-40"
                  disabled={downloadingFile === f.file_name}
                  onClick={() => handleDownloadFile(f.file_name, f.folder_path)}
                >
                  {downloadingFile === f.file_name ? "Downloading..." : "Download"}
                </button>
              ),
            }))}
          />
        </Disclosure>

        <Disclosure title="Raw Behave output">
          <pre className="max-h-96 w-full min-w-0 overflow-auto whitespace-pre-wrap break-words rounded-sm bg-[#0B1A33] p-4 font-mono text-xs text-[#D7E1EF] scroll-thin">
            {report.raw_output}
          </pre>
        </Disclosure>

        <div className="flex flex-wrap gap-2">
          <Button onClick={() => openReportInBrowser(report)}>Open report in browser</Button>
          <Button
            variant="secondary"
            onClick={() =>
              downloadBlob(`transaction_${report.transaction_id}_exit_report.html`, buildReportHtml(report), "text/html")
            }
          >
            Download (.html)
          </Button>
          <Button
            variant="secondary"
            onClick={() =>
              downloadBlob(`transaction_${report.transaction_id}_exit_report.txt`, buildReportText(report), "text/plain")
            }
          >
            Download (.txt)
          </Button>
        </div>
      </div>

      {screenshotModal && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-6"
          role="dialog"
          aria-modal="true"
          onClick={() => setScreenshotModal(null)}
        >
          <div className="max-h-full max-w-full overflow-auto rounded-sm bg-panel p-3 shadow-xl" onClick={(e) => e.stopPropagation()}>
            <div className="mb-2 flex items-center justify-between gap-4">
              <span className="truncate text-sm font-medium text-ink">{screenshotModal.stepName}</span>
              <button
                type="button"
                className="shrink-0 text-sm font-medium text-muted hover:text-ink"
                onClick={() => setScreenshotModal(null)}
              >
                Close ✕
              </button>
            </div>
            <img src={screenshotModal.dataUrl} alt={screenshotModal.stepName} className="max-h-[80vh] max-w-full" />
          </div>
        </div>
      )}
    </Panel>
  );
}
