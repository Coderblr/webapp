# ─────────────────────────────────────────────────────────────────────────
#  Enterprise AI Automation Engineering Platform - environment
#  Copy to .env and fill in.  NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="Enterprise AI Automation Engineering Platform"
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ── SQLite (knowledge repository + in-process vector search) ────────────
SQLITE_PATH=./storage/ai_automation.db

# ── Azure OpenAI (ONLY LLM provider) ─────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIM=3072
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Secrets encryption (Fernet key) ──────────────────────────────────────
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# ── Java framework (pure Java, NO Maven / NO Gradle) ─────────────────────
FRAMEWORK_ROOT=./java-framework
FRAMEWORK_SRC=./java-framework/src
FRAMEWORK_LIB=./java-framework/lib
FRAMEWORK_BUILD=./java-framework/build
FRAMEWORK_TESTDATA=./java-framework/test-data
JAVA_HOME=
JAVAC_BIN=javac
JAVA_BIN=java

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
KNOWLEDGE_ROOT=./storage/knowledge

# ── Browser / recorder ───────────────────────────────────────────────────
EDGE_DRIVER_PATH=
EDGE_BINARY_PATH=
RECORDER_CDP_PORT=9222
RECORDER_CAPTURE_NETWORK=true
RECORDER_FULLPAGE_CRAWL=true
BROWSER_IMPLICIT_WAIT=10

# ── CBS teller-reset socket client ───────────────────────────────────────
CBS_SOCKET_HOST=
CBS_SOCKET_PORT=0
CBS_SOCKET_TIMEOUT=30
CBS_SOCKET_ENCODING=utf-8

# ── AI confidence thresholds ─────────────────────────────────────────────
SELF_HEAL_CONFIDENCE_THRESHOLD=0.75
RERECORD_CONFIDENCE_THRESHOLD=0.55
AUTO_APPROVE_LOW_RISK=false
