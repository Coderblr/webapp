"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { Api } from "@/lib/api";
import RecordingsTable from "@/components/RecordingsTable";

// Sentinel filter values, distinct from any real application_id (which is
// always "app_..." - see application_store.new_id()).
const FILTER_ALL = "";
const FILTER_UNTAGGED = "__untagged__";

export default function RecordingsPage() {
  const [recordings, setRecordings] = useState([]);
  const [applications, setApplications] = useState([]);
  const [applicationFilter, setApplicationFilter] = useState(FILTER_ALL);

  const refresh = useCallback(() => {
    Api.get("/api/recordings").then(setRecordings).catch(() => {});
  }, []);

  useEffect(() => { refresh(); }, [refresh]);
  useEffect(() => {
    Api.get("/api/applications").then((data) => setApplications(data.applications || [])).catch(() => {});
  }, []);

  const filteredRecordings = useMemo(() => {
    if (applicationFilter === FILTER_ALL) return recordings;
    if (applicationFilter === FILTER_UNTAGGED) return recordings.filter((r) => !r.application_id);
    return recordings.filter((r) => r.application_id === applicationFilter);
  }, [recordings, applicationFilter]);

  return (
    <section>
      <h1>Recordings</h1>
      <div className="form-row">
        <label>Filter by Application</label>
        <select value={applicationFilter} onChange={(e) => setApplicationFilter(e.target.value)}>
          <option value={FILTER_ALL}>— All applications —</option>
          {applications.map((a) => (
            <option key={a.application_id} value={a.application_id}>{a.name}</option>
          ))}
          <option value={FILTER_UNTAGGED}>Untagged (no application set yet)</option>
        </select>
      </div>
      <RecordingsTable recordings={filteredRecordings} withActions onChanged={refresh} />
    </section>
  );
}
