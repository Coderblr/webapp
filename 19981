"""
Central auth configuration - every JWT/session/SSO knob lives here, read
from environment variables (.env, see .env.example) with sane local-dev
defaults.

SSO note (read this before wiring up SBI SSO later):
  AUTH_PROVIDER stays "local" until an SSO integration is added. The
  intended shape when that happens is:

    1. The IdP (ADFS / Azure AD / whatever SBI standardizes on) redirects
       back to POST /api/auth/sso/callback with a SAML assertion or OIDC
       code (see auth/providers.py - authenticate_sso() is the single
       function to implement).
    2. That function resolves/creates the local User row (matched on
       `username` = the IdP's ADID/UPN claim) exactly like
       authenticate_local() does today, and hands back the same User
       object.
    3. From there everything is identical to the local-password path:
       backend/auth_routes.py's _issue_session_and_token() creates the
       UserSession + JWT the same way regardless of which provider
       authenticated the user.

  Nothing about session handling, the idle timeout, JWT shape, or the
  admin/activity views needs to change for SSO - only authenticate_sso()
  gets filled in, and AUTH_PROVIDER gets set to "sso" (or a per-request
  toggle if both need to coexist during rollout).
"""
import os

AUTH_PROVIDER = os.environ.get("AUTH_PROVIDER", "local")  # "local" | "sso"

JWT_SECRET_KEY = os.environ.get("JWT_SECRET_KEY", "dev-only-secret-change-me-in-.env")
JWT_ALGORITHM = "HS256"

# The JWT's own expiry is intentionally longer than the idle timeout below -
# actual session liveness is enforced server-side via UserSession, so an
# unused-but-valid token still gets rejected once idle. This is just an
# outer ceiling.
ACCESS_TOKEN_MAX_MINUTES = int(os.environ.get("ACCESS_TOKEN_MAX_MINUTES", "480"))  # 8h

# The headline requirement: auto-logout after this many minutes of no
# authenticated requests.
IDLE_TIMEOUT_MINUTES = int(os.environ.get("IDLE_TIMEOUT_MINUTES", "5"))

# Absolute session ceiling regardless of activity (forces a fresh login
# periodically even if the user never goes idle).
SESSION_MAX_HOURS = int(os.environ.get("SESSION_MAX_HOURS", "12"))

# Where the frontend lives - only used to build the redirect target once
# SSO is implemented (IdP -> /api/auth/sso/callback -> this URL + a token,
# landing on the frontend's /sso/complete page). Not used by anything
# today.
FRONTEND_URL = os.environ.get("FRONTEND_URL", "http://localhost:3000")

MIN_PASSWORD_LENGTH = int(os.environ.get("MIN_PASSWORD_LENGTH", "8"))
