"""
Vision AI fallback layer - the intelligence tier that runs when every
DOM-based locator strategy (including LLM self-healing from
agent/self_healer.py) has already failed.

Unlike self_healer.py, which reads the page's HTML and proposes a new
CSS/XPath selector, this module sends an ACTUAL SCREENSHOT to a vision-
capable model (Claude claude-sonnet-4-6 via Anthropic, or gpt-4o via Azure if
configured) and asks it to identify WHERE on screen the target element is.
The response is pixel coordinates, not a selector - so this works even
when:
  - The element is rendered purely in canvas/SVG/image with no DOM node
    a CSS/XPath selector could ever address
  - The page markup has changed so drastically that NO selector-based
    approach (including LLM self-healing) can propose anything valid
  - The element exists but has been visually repositioned or reflowed

Two modes, automatically selected:
  1. CLICK mode (action="click"): the model returns {x, y} pixel
     coordinates to click. The caller uses page.mouse.click(x, y) -
     same mechanism as _ocr_click_fallback in page.tmpl, but guided by
     the model's visual understanding rather than naive OCR text matching.
  2. LOCATE mode (action="locate"): the model is shown the screenshot
     and asked to propose a CSS or XPath selector for the visible element
     - effectively self-healing with visual context, not just HTML source.
     Falls back gracefully to click-coordinate mode if the model can't
     propose a reliable selector.

Requires:
  - ANTHROPIC_API_KEY (preferred, uses Claude's native vision) OR
  - AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT with a gpt-4o-vision
    capable deployment (LLM_PROVIDER=azure, same as self_healer.py)
  OR
  - VISION_PROVIDER and VISION_API_KEY for a separate, vision-specific
    key/provider if you want a different model for vision vs. text tasks

Returns None if no vision provider is configured - the caller treats this
as "tier not available" and falls through to the next tier (or raises the
original error) - never raises its own error, same contract as
_ocr_click_fallback.
"""
from __future__ import annotations

import base64
import json
import logging
import os
from typing import Optional

logger = logging.getLogger(__name__)


def _vision_available() -> bool:
    return bool(
        os.getenv("ANTHROPIC_API_KEY")
        or (os.getenv("AZURE_OPENAI_API_KEY") and os.getenv("AZURE_OPENAI_ENDPOINT"))
        or os.getenv("VISION_API_KEY")
    )


def _encode_screenshot(png_bytes: bytes) -> str:
    return base64.standard_b64encode(png_bytes).decode("ascii")


def _ask_claude(png_bytes: bytes, prompt: str) -> Optional[str]:
    """Send a screenshot + prompt to Claude claude-sonnet-4-6 via Anthropic's API
    and return the raw text response, or None on any failure."""
    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        return None
    try:
        import anthropic
        client = anthropic.Anthropic(api_key=api_key)
        message = client.messages.create(
            model="claude-sonnet-4-6",
            max_tokens=256,
            messages=[{
                "role": "user",
                "content": [
                    {
                        "type": "image",
                        "source": {
                            "type": "base64",
                            "media_type": "image/png",
                            "data": _encode_screenshot(png_bytes),
                        },
                    },
                    {"type": "text", "text": prompt},
                ],
            }],
        )
        return message.content[0].text.strip() if message.content else None
    except Exception as e:
        logger.debug(f"[vision] Claude call failed: {e}")
        return None


def _ask_azure_vision(png_bytes: bytes, prompt: str) -> Optional[str]:
    """Send a screenshot + prompt to Azure OpenAI (gpt-4o-vision) and
    return the raw text response, or None on any failure."""
    api_key = os.getenv("AZURE_OPENAI_API_KEY")
    endpoint = os.getenv("AZURE_OPENAI_ENDPOINT")
    deployment = os.getenv("AZURE_OPENAI_VISION_DEPLOYMENT",
                           os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o"))
    api_version = os.getenv("AZURE_OPENAI_API_VERSION", "2024-08-01-preview")
    if not (api_key and endpoint):
        return None
    try:
        import requests
        url = f"{endpoint.rstrip('/')}/openai/deployments/{deployment}/chat/completions?api-version={api_version}"
        payload = {
            "messages": [{
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {
                        "type": "image_url",
                        "image_url": {
                            "url": f"data:image/png;base64,{_encode_screenshot(png_bytes)}",
                            "detail": "high",
                        },
                    },
                ],
            }],
            "max_tokens": 256,
        }
        r = requests.post(url, headers={"api-key": api_key, "Content-Type": "application/json"},
                          json=payload, timeout=30)
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip()
    except Exception as e:
        logger.debug(f"[vision] Azure vision call failed: {e}")
        return None


def _call_vision(png_bytes: bytes, prompt: str) -> Optional[str]:
    """Try each configured vision provider in priority order:
    1. Anthropic (Claude claude-sonnet-4-6) - preferred, cleanest vision API
    2. Azure OpenAI (gpt-4o-vision) - if already configured for self-healing
    Returns the raw response text or None if nothing is configured/works."""
    if os.getenv("ANTHROPIC_API_KEY"):
        result = _ask_claude(png_bytes, prompt)
        if result:
            return result

    if os.getenv("AZURE_OPENAI_API_KEY") and os.getenv("AZURE_OPENAI_ENDPOINT"):
        result = _ask_azure_vision(png_bytes, prompt)
        if result:
            return result

    return None


def vision_click_coordinates(
    png_bytes: bytes,
    element_description: str,
    action_type: str = "click",
    page_width: Optional[int] = None,
    page_height: Optional[int] = None,
) -> Optional[dict]:
    """
    Given a full-page screenshot and a description of the element we're
    looking for, asks the vision model to return PIXEL COORDINATES for
    where to click/interact.

    Returns {"x": int, "y": int, "confidence": str, "reasoning": str}
    or None if vision isn't configured or the model can't locate the element.

    `element_description` should be as specific as possible - the element
    name slug, its label/text, and its action type all help the model:
    e.g. "a button labelled 'Submit Proposal' (action: click)" is much
    better than just "submit_proposal_button".

    `page_width`/`page_height` are included in the prompt when available
    so the model knows the coordinate space it's working in - prevents
    misinterpretation of coordinates on high-DPI screenshots.
    """
    if not _vision_available():
        return None

    size_hint = ""
    if page_width and page_height:
        size_hint = f" The screenshot is {page_width}x{page_height} pixels."

    prompt = f"""You are helping an automated browser test find an element that failed to locate via CSS/XPath selectors.

Look at this screenshot of the current web page.{size_hint}

I need to perform a {action_type} action on: {element_description}

Find this element in the screenshot and return the pixel coordinates of its CENTER in strict JSON only:
{{"x": <integer>, "y": <integer>, "confidence": "high"|"medium"|"low", "reasoning": "<one short sentence>"}}

Rules:
- x and y must be integers within the screenshot bounds
- confidence: "high" if you can clearly see exactly this element, "medium" if you're reasonably sure, "low" if you're guessing
- If you truly cannot identify the element, return {{"x": null, "y": null, "confidence": "none", "reasoning": "<why>"}}
- No prose, no markdown, just JSON."""

    try:
        raw = _call_vision(png_bytes, prompt)
        if not raw:
            return None

        # Strip any markdown fences the model may have added
        text = raw.strip()
        if text.startswith("```"):
            text = text.strip("`").split("\n", 1)[-1].rsplit("\n", 1)[0]

        data = json.loads(text)
        x = data.get("x")
        y = data.get("y")
        confidence = data.get("confidence", "medium")
        reasoning = data.get("reasoning", "")

        if x is None or y is None or confidence == "none":
            logger.info(f"[vision] Model could not locate '{element_description}': {reasoning}")
            return None

        logger.info(f"[vision] Located '{element_description}' at ({x},{y}) confidence={confidence}: {reasoning}")
        return {
            "x": int(x), "y": int(y),
            "confidence": confidence, "reasoning": reasoning,
            "strategy": "VISION",
        }
    except Exception as e:
        logger.debug(f"[vision] Coordinate parsing failed: {e} | raw={raw!r}")
        return None


def vision_propose_selector(
    png_bytes: bytes,
    element_description: str,
    page_html_snippet: str,
) -> Optional[dict]:
    """
    Visual self-healing: given a screenshot + HTML snippet + element
    description, ask the model to propose a new CSS/XPath selector by
    combining what it sees visually with what's in the DOM.

    Returns {"strategy": "CSS"|"XPATH", "value": str, "reasoning": str}
    or None if unavailable or model can't propose a reliable selector.

    This is strictly better than text-only self-healing (agent/self_healer.py)
    for pages where the visible layout makes the element obvious but the
    HTML has changed in a way that makes purely text-based reasoning hard
    (e.g. generated class names, deeply nested structures, or dynamic IDs
    that weren't visible in the recorded HTML).
    """
    if not _vision_available():
        return None

    prompt = f"""You are debugging a broken Playwright locator. A test is trying to interact with an element that can no longer be found by its recorded CSS/XPath selectors.

Here is:
1. A screenshot of the CURRENT page (look at this carefully)
2. A snippet of the current page HTML

Element we're looking for: {element_description}

Current page HTML (first 8000 chars):
{page_html_snippet[:8000]}

Using both the screenshot AND the HTML, propose a single reliable CSS or XPath selector that will locate this element.

Respond with STRICT JSON only:
{{"strategy": "CSS"|"XPATH", "value": "<selector>", "reasoning": "<one short sentence why this will work>"}}

If you truly cannot identify a reliable selector, return:
{{"strategy": null, "value": null, "reasoning": "<why>"}}

No prose, no markdown, just JSON."""

    try:
        raw = _call_vision(png_bytes, prompt)
        if not raw:
            return None

        text = raw.strip()
        if text.startswith("```"):
            text = text.strip("`").split("\n", 1)[-1].rsplit("\n", 1)[0]

        data = json.loads(text)
        strategy = data.get("strategy")
        value = data.get("value")
        reasoning = data.get("reasoning", "")

        if not strategy or not value:
            logger.info(f"[vision] Could not propose selector for '{element_description}': {reasoning}")
            return None

        logger.info(f"[vision] Proposed {strategy} selector for '{element_description}': {value} | {reasoning}")
        return {"strategy": strategy, "value": value, "reasoning": reasoning}
    except Exception as e:
        logger.debug(f"[vision] Selector proposal parsing failed: {e} | raw={raw!r}")
        return None
