"""Logs viewer (backend + errors-only, both persisted to storage/logs/ by
backend/core/logging_conf.py's RotatingFileHandlers)."""
from __future__ import annotations

from typing import Any

from fastapi import APIRouter, HTTPException

from ..core.config import settings

router = APIRouter(prefix="/api/logs", tags=["logs"])

_FILES = {
    "all": "backend.log",
    "errors": "errors.log",
}


def _tail_lines(path, lines: int) -> list[str]:
    """Reads only the last `lines` lines without loading the whole
    (potentially many-MB, rotated-at-10MB) file into memory at once."""
    import collections

    if not path.exists():
        return []
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        return list(collections.deque(fh, maxlen=lines))


@router.get("")
def get_logs(kind: str = "all", lines: int = 500,
             search: str | None = None) -> dict[str, Any]:
    """kind: "all" (everything) or "errors" (WARNING/ERROR/CRITICAL only).
    `lines` caps how far back to read (most-recent-first isn't done here —
    returned in natural, oldest-first file order, same as `tail`)."""
    filename = _FILES.get(kind)
    if not filename:
        raise HTTPException(400, f"Unknown log kind '{kind}' — use 'all' or 'errors'")
    lines = max(1, min(lines, 5000))
    path = settings.logs_path / filename

    entries = _tail_lines(path, lines)
    if search:
        needle = search.lower()
        entries = [line for line in entries if needle in line.lower()]

    return {
        "kind": kind,
        "file": str(path),
        "exists": path.exists(),
        "size_bytes": path.stat().st_size if path.exists() else 0,
        "returned_lines": len(entries),
        "lines": entries,
    }


@router.get("/files")
def list_log_files() -> dict[str, Any]:
    """What's actually on disk, including rotated backups
    (backend.log.1, backend.log.2, ...) — mainly so a much older error
    isn't assumed lost just because it scrolled out of the active file."""
    settings.logs_path.mkdir(parents=True, exist_ok=True)
    files = []
    for path in sorted(settings.logs_path.glob("*.log*")):
        files.append({
            "name": path.name,
            "size_bytes": path.stat().st_size,
            "modified": path.stat().st_mtime,
        })
    return {"directory": str(settings.logs_path), "files": files}
