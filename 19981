import { useCallback, useEffect, useState } from "react";
import Head from "next/head";
import Layout from "@/components/Layout";
import RequireAuth from "@/components/RequireAuth";
import { adminApi } from "@/lib/api";
import { Button, Callout, DataTable, Panel, PanelHeader } from "@/components/ui";

function timeAgoLabel(unixSeconds) {
  const seconds = Math.max(0, Math.floor(Date.now() / 1000 - unixSeconds));
  if (seconds < 60) return `${seconds}s ago`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  return `${hours}h ago`;
}

export default function AdminAgentsPage() {
  const [agents, setAgents] = useState([]);
  const [error, setError] = useState(null);
  const [busyId, setBusyId] = useState(null);
  const [notice, setNotice] = useState(null);

  const load = useCallback(async () => {
    try {
      setAgents(await adminApi.listAgents());
      setError(null);
    } catch (e) {
      setError(e.detail || e.message);
    }
  }, []);

  useEffect(() => {
    load();
    const interval = setInterval(load, 10000); // this is a "who's connected right now" view
    return () => clearInterval(interval);
  }, [load]);

  async function handleDisconnect(agent) {
    if (!window.confirm(`Disconnect ${agent.full_name}'s desktop agent (${agent.hostname})? It will try to reconnect automatically.`)) {
      return;
    }
    setBusyId(agent.agent_id);
    setNotice(null);
    try {
      await adminApi.disconnectAgent(agent.agent_id);
      setNotice({ tone: "success", text: `Disconnected ${agent.hostname} - it will reconnect on its own if it's still running.` });
      await load();
    } catch (err) {
      setNotice({ tone: "error", text: err.detail || err.message });
    } finally {
      setBusyId(null);
    }
  }

  async function handleReset(agent) {
    if (
      !window.confirm(
        `Reset ${agent.full_name}'s desktop agent (${agent.hostname})? This closes any browser it has open and clears a stuck "busy" state. ` +
          `Use this if it shows "busy" but isn't actually recording/running anything - unlike Disconnect, this actually clears that.`
      )
    ) {
      return;
    }
    setBusyId(agent.agent_id);
    setNotice(null);
    try {
      await adminApi.resetAgent(agent.agent_id);
      setNotice({ tone: "success", text: `Reset ${agent.hostname} - it should now show as idle.` });
      await load();
    } catch (err) {
      setNotice({ tone: "error", text: err.detail || err.message });
    } finally {
      setBusyId(null);
    }
  }

  const onlineCount = agents.filter((a) => !a.stale).length;

  return (
    <RequireAuth adminOnly>
      <Layout>
        <Head>
          <title>Desktop agents - AI Test Recorder</title>
        </Head>

        <div className="mb-6 flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-semibold tracking-tight text-ink">Desktop agents</h1>
            <p className="mt-1 text-sm text-muted">
              Every user's local desktop agent connection, refreshed every 10 seconds - this is what actually runs
              recordings and tests on each person's own PC.
            </p>
          </div>
          <Button variant="secondary" onClick={load}>
            Refresh now
          </Button>
        </div>

        {error && <Callout tone="error">{error}</Callout>}
        {notice && (
          <div className="mb-4">
            <Callout tone={notice.tone}>{notice.text}</Callout>
          </div>
        )}

        <Panel>
          <PanelHeader title={`${onlineCount} online${agents.length !== onlineCount ? ` / ${agents.length} total` : ""}`} />
          <div className="px-5 py-5">
            {agents.length === 0 && !error && (
              <p className="text-sm text-muted">No desktop agents have connected yet.</p>
            )}
            {agents.length > 0 && (
              <DataTable
                columns={[
                  { key: "user", label: "User" },
                  { key: "username", label: "Username", mono: true },
                  { key: "hostname", label: "Hostname", mono: true },
                  { key: "version", label: "Version", mono: true },
                  { key: "status", label: "Status" },
                  { key: "busy", label: "Busy" },
                  { key: "last_seen", label: "Last heartbeat", mono: true },
                  { key: "actions", label: "" },
                ]}
                rows={agents.map((a) => ({
                  user: a.full_name,
                  username: a.username,
                  hostname: a.hostname || "—",
                  version: a.version || "—",
                  status: a.stale ? (
                    <span className="inline-flex items-center gap-1.5 text-xs font-semibold text-signal-rust">
                      <span className="h-1.5 w-1.5 rounded-full bg-signal-rust" />
                      Stale
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1.5 text-xs font-semibold text-signal-tealDark">
                      <span className="pulse-dot h-1.5 w-1.5 rounded-full bg-signal-teal" />
                      Online
                    </span>
                  ),
                  busy: a.busy ? (
                    <span className="text-xs font-medium text-signal-amber">Recording/running</span>
                  ) : (
                    <span className="text-xs text-muted">Idle</span>
                  ),
                  last_seen: timeAgoLabel(a.last_seen),
                  actions: (
                    <div className="flex gap-3">
                      <button
                        className="text-xs font-medium text-brand-blue hover:underline disabled:opacity-40"
                        disabled={busyId === a.agent_id}
                        onClick={() => handleReset(a)}
                      >
                        Reset
                      </button>
                      <button
                        className="text-xs font-medium text-signal-rust hover:underline disabled:opacity-40"
                        disabled={busyId === a.agent_id}
                        onClick={() => handleDisconnect(a)}
                      >
                        Disconnect
                      </button>
                    </div>
                  ),
                }))}
              />
            )}
          </div>
        </Panel>
      </Layout>
    </RequireAuth>
  );
}
