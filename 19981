# -*- mode: python ; coding: utf-8 -*-
#
# PyInstaller spec for freezing local_agent into a standalone
# local_agent.exe, so an end user's PC needs no Python installation at all
# (see docs/electron-local-agent-architecture.md's "Packaging" section).
#
# IMPORTANT: this spec has NOT been built or tested here - doing so
# requires an actual Windows machine (PyInstaller's Windows target must
# run on Windows, or under Wine with real limitations). Treat this as a
# verified-on-your-machine starting point once you build it, not an
# artifact that's already been confirmed working.
#
# Usage (on a Windows machine, from the project root, inside a venv with
# local_agent/requirements-agent.txt + pyinstaller installed):
#
#   pip install -r local_agent\requirements-agent.txt
#   pip install pyinstaller
#   pyinstaller local_agent\local_agent.spec
#
# Produces dist\local_agent\local_agent.exe (one-folder build, not
# one-file - Playwright's own browser binaries are large enough that a
# one-folder build is the more practical choice; electron-builder's
# extraResources then bundles that whole dist\local_agent\ folder instead
# of raw .py files + a system Python - see electron/package.json).

from pathlib import Path
from PyInstaller.utils.hooks import collect_submodules

# ---------------------------------------------------------
# Project paths
# ---------------------------------------------------------
#
# PyInstaller provides SPECPATH while executing the .spec file.
#
# SPECPATH:
#   C:\...\ai-test-recorder-pw\local_agent
#
# Therefore:
#   PROJECT_ROOT = C:\...\ai-test-recorder-pw
#   AGENT_ROOT   = C:\...\ai-test-recorder-pw\local_agent
#
SPEC_DIR = Path(SPECPATH).resolve()
PROJECT_ROOT = SPEC_DIR.parent
AGENT_ROOT = SPEC_DIR

# ---------------------------------------------------------
# Validate important files before building - fail fast with a clear
# message instead of a confusing mid-build PyInstaller error if this spec
# is ever run from the wrong location or against a stale checkout.
# ---------------------------------------------------------
MAIN_PY = AGENT_ROOT / "main.py"
INJECTOR_JS = PROJECT_ROOT / "recorder" / "recorder_injector.js"
AGENT_ENVIRONMENT = AGENT_ROOT / "agent_environment.py"

if not MAIN_PY.exists():
    raise FileNotFoundError(f"local_agent main.py not found: {MAIN_PY}")
if not INJECTOR_JS.exists():
    raise FileNotFoundError(f"recorder_injector.js not found: {INJECTOR_JS}")
if not AGENT_ENVIRONMENT.exists():
    raise FileNotFoundError(f"agent_environment.py not found: {AGENT_ENVIRONMENT}")

# ---------------------------------------------------------
# Hidden imports
# ---------------------------------------------------------
# Playwright does some dynamic importing (its driver-process bridge, the
# generated sync API wrappers) that PyInstaller's static analysis can
# miss - collect_submodules pulls in everything under the package rather
# than hoping the single explicit entry below is sufficient.
hiddenimports = (
    collect_submodules("playwright")
    + ["playwright.sync_api"]
    # Behave is now invoked via its own programmatic entry point
    # (behave.__main__.main) rather than as an external `python -m behave`
    # subprocess when running from this frozen exe - see
    # runner/run_tests.py's run_behave_cli for why (sys.executable inside a
    # frozen build points at this exe, not a real Python interpreter, so
    # shelling out to "behave" never worked from a packaged build). That
    # means behave's own submodules need to be statically bundled here too,
    # not just importable at dev-time.
    + collect_submodules("behave")
    # CRITICAL: local_agent/agent_environment.py is bundled as a DATA file
    # (see `datas` below) - copied to disk at runtime and loaded by Behave
    # from OUTSIDE this frozen bundle, not `import`ed by any of local_agent's
    # own .py source. PyInstaller's static analysis only bundles modules it
    # can see being imported somewhere in the traced source graph, so it has
    # NO WAY of knowing agent_environment.py needs these at runtime - both
    # were missing from earlier builds one at a time
    # ("ModuleNotFoundError: No module named 'agent'", then "... 'runner.variables'"),
    # each crashing Behave before before_all() ever launched a browser.
    # Listed explicitly (NOT via collect_submodules("runner")/("recorder"))
    # because runner/ also contains run_recording.py and
    # transaction_store.py, which import database/generator/agent (the
    # central-server-only packages this build deliberately excludes below)
    # - blanket-collecting the whole package risks either breaking this
    # build outright (those imports may not even be installed in a minimal
    # requirements-agent.txt venv) or silently bundling server code that
    # has no business being on an end user's PC. If agent_environment.py
    # ever starts importing something new from runner/ or recorder/, add
    # it here explicitly rather than switching back to collect_submodules.
    + [
        "runner.variables",
        "runner.run_tests",
        "recorder.browser_factory",
        "recorder.recorder",
        "recorder.locator_strategy",
        "recorder.variable_capture",
    ]
)

# ---------------------------------------------------------
# Analysis
# ---------------------------------------------------------
a = Analysis(
    [str(MAIN_PY)],
    pathex=[
        str(PROJECT_ROOT),
        str(AGENT_ROOT),
    ],
    binaries=[],
    datas=[
        # Recorder injector used by the local agent (read as a text file
        # at runtime - see recorder/recorder.py's INJECTOR_PATH; not a
        # .py module PyInstaller would bundle automatically).
        (
            str(INJECTOR_JS),
            "recorder",
        ),
        # Agent environment module/data
        (
            str(AGENT_ENVIRONMENT),
            "local_agent",
        ),
    ],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # Central-server-only packages that must NOT be shipped to an end
        # user's PC (see local_agent/agent_environment.py's docstring for
        # why "agent" - the AI/self-healing package - specifically is
        # excluded: local execution deliberately runs without self-healing
        # so no LLM key/dependency needs to exist client-side). If any of
        # these accidentally get pulled in by a stray import, this list is
        # what catches it at build time as a missing-module error instead
        # of silently shipping backend code to end users.
        "fastapi",
        "sqlalchemy",
        "jwt",
        "bcrypt",
        "jinja2",
        "pandas",
        "openpyxl",
        "backend",
        "database",
        "agent",
        "generator",
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=None,
    noarchive=False,
)

# ---------------------------------------------------------
# PYZ
# ---------------------------------------------------------
pyz = PYZ(
    a.pure,
    a.zipped_data,
    cipher=None,
)

# ---------------------------------------------------------
# EXE
# ---------------------------------------------------------
exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="local_agent",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=True,  # keep a console window for now so connection/errors are visible - revisit once the Electron UI surfaces agent logs well enough to hide it
    disable_windowed_traceback=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

# ---------------------------------------------------------
# COLLECT
# ---------------------------------------------------------
coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name="local_agent",
)

# ---------------------------------------------------------
# NOT HANDLED BY THIS SPEC (see docs/electron-local-agent-architecture.md)
# ---------------------------------------------------------
#   - Playwright's own browser binaries (`playwright install msedge`) are
#     NOT bundled by PyInstaller - they need a separate install step,
#     either bundled as additional `datas`/`binaries` entries (large - a
#     full Chromium-based browser download) or run once at application
#     first-launch with a visible progress indicator. Decide which before
#     relying on this spec for a real installer.
