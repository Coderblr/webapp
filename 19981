<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reports Dashboard</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<script src="js/api.js"></script>
<script>
const content = renderShell('reports.html', 'Reports Dashboard',
  'Every execution, every self-heal, every lesson learned');

content.innerHTML = `
  <div class="grid g4" id="stats"></div>

  <div class="card">
    <h3>Executions</h3>
    <div class="row" style="margin-bottom:12px">
      <div class="field" style="margin:0"><label>Transaction filter</label>
        <input id="filter" placeholder="e.g. 400" oninput="load()"></div>
    </div>
    <table><thead><tr><th>Execution</th><th>Transaction</th><th>Env</th><th>Status</th>
      <th>9750</th><th>Teller reset</th><th>Duration</th><th>Started</th><th></th></tr></thead>
      <tbody id="rows"><tr><td colspan="9" class="muted">loading…</td></tr></tbody></table>
  </div>

  <div id="drill"></div>

  <div class="grid g2">
    <div class="card">
      <h3>Per-transaction reliability</h3>
      <table><thead><tr><th>Transaction</th><th>Runs</th><th>Passed</th><th>Last run</th></tr></thead>
        <tbody id="byTxn"><tr><td colspan="4" class="muted">loading…</td></tr></tbody></table>
    </div>
    <div class="card">
      <h3>Continuous learning</h3>
      <div id="insights" class="muted">loading…</div>
    </div>
  </div>`;

async function load() {
  try {
    const stats = await API.get('/api/reports/dashboard');
    const t = stats.totals || {};
    $('#stats').innerHTML = [
      ['Total Tests', t.total || 0], ['Passed', t.passed || 0], ['Failed', t.failed || 0],
      ['Success Rate', (t.success_rate ?? 0) + '%'],
      ['Self-heals applied', stats.self_heals_applied || 0],
    ].map(([k, v]) => `<div class="stat"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('');
    $('#byTxn').innerHTML = (stats.by_transaction || []).map(r => `
      <tr><td class="mono">${r.transaction_id}</td><td>${r.runs}</td>
        <td>${r.passed}</td><td class="muted">${fmtTime(r.last_run)}</td></tr>`).join('')
      || '<tr><td colspan="4" class="empty">No data.</td></tr>';
  } catch (e) {}

  const filter = $('#filter').value.trim();
  try {
    const runs = await API.get('/api/execution?limit=100'
      + (filter ? '&transaction_id=' + encodeURIComponent(filter) : ''));
    $('#rows').innerHTML = runs.length ? runs.map(r => `
      <tr><td class="mono">${r.execution_uid}</td><td>${r.transaction_id}</td>
        <td class="muted">${r.environment}</td><td>${badge(r.status)}</td>
        <td>${badge(r.password_change_status || 'skipped')}</td>
        <td>${badge(r.teller_reset_status || 'skipped')}</td>
        <td class="muted">${fmtMs((r.metrics || {}).total_ms)}</td>
        <td class="muted">${fmtTime(r.started_at)}</td>
        <td class="right"><button class="ghost sm" onclick="drill('${r.execution_uid}')">drill down</button>
          <a class="btn sm" href="/api/reports/${r.execution_uid}" target="_blank">report</a></td></tr>`).join('')
      : '<tr><td colspan="9" class="empty">No executions match.</td></tr>';
  } catch (e) { toast(e.message, 'err'); }

  try {
    const ins = (await API.get('/api/reports/insights')).insights || {};
    $('#insights').innerHTML = `
      <div><strong>Transactions needing re-recording</strong><br>
        ${(ins.needs_rerecording || []).map(t =>
          `<span class="pill">${t.transaction_id} — confidence ${t.confidence}</span>`).join('')
          || '<span class="muted">none — self-healing is keeping up</span>'}</div>
      <div style="margin-top:12px"><strong>Most-healed elements</strong><br>
        ${(ins.most_healed_elements || []).slice(0, 8).map(h =>
          `<span class="pill">${h.element_key} ×${h.heals}</span>`).join('') || '<span class="muted">none</span>'}</div>
      <div style="margin-top:12px"><strong>Failure-prone steps</strong>
        <table style="margin-top:6px"><tbody>${(ins.flaky_steps || []).slice(0, 8).map(s =>
          `<tr><td>${s.step_name}</td><td class="right muted">${s.failures}/${s.runs}</td></tr>`).join('')
          || '<tr><td class="muted">none</td></tr>'}</tbody></table></div>`;
  } catch (e) {}
}

async function drill(uid) {
  try {
    const e = await API.get('/api/execution/' + uid);
    const totals = {
      passed: e.steps.filter(s => s.status === 'passed').length,
      failed: e.steps.filter(s => s.status === 'failed').length,
      healed: e.steps.filter(s => s.status === 'healed').length,
      skipped: e.steps.filter(s => s.status === 'skipped').length,
    };
    $('#drill').innerHTML = `
      <div class="card">
        <h3>${e.execution_uid} ${badge(e.status)}
          <span class="muted">transaction ${e.transaction_id} · ${e.environment}</span></h3>
        <div class="grid g4" style="margin-bottom:14px">
          ${Object.entries(totals).map(([k, v]) =>
            `<div class="stat"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('')}
        </div>
        <table><thead><tr><th>#</th><th>Phase</th><th>Step</th><th>Status</th>
          <th>Duration</th><th>Error</th></tr></thead>
          <tbody>${e.steps.map(s => `<tr><td class="muted">${s.sequence}</td>
            <td class="muted">${s.phase}</td><td>${s.step_name}</td>
            <td>${badge(s.status)}</td><td class="muted">${fmtMs(s.duration_ms)}</td>
            <td class="muted">${(s.error_msg || '').slice(0, 160)}</td></tr>`).join('')}</tbody></table>

        ${(e.self_heal || []).length ? `<h3 style="margin-top:18px">Self-healing actions</h3>
          ${e.self_heal.map(h => `
            <div style="margin-bottom:12px">
              <div><strong>${h.element_key}</strong> ${badge(h.applied ? 'healed' : 'skipped')}
                <span class="muted">confidence ${h.confidence}</span></div>
              <div class="split" style="margin-top:6px">
                <div class="old"><span class="muted">before</span><br>${h.old_locator}</div>
                <div class="new"><span class="muted">after</span><br>${h.new_locator}</div>
              </div>
              <div class="muted" style="margin-top:4px">${h.reason || ''}</div>
            </div>`).join('')}` : ''}

        <div class="actions">
          <a class="btn sm" href="/api/reports/${e.execution_uid}" target="_blank">Open full HTML report</a>
          <button class="ghost sm" onclick="learn('${e.execution_uid}')">Feed back into knowledge</button>
        </div>
      </div>`;
    $('#drill').scrollIntoView({ behavior: 'smooth' });
  } catch (err) { toast(err.message, 'err'); }
}

async function learn(uid) {
  try {
    const r = await API.post(`/api/execution/${uid}/learn`);
    toast(`Knowledge updated — confidence now ${r.confidence}`, 'ok');
    load();
  } catch (e) { toast(e.message, 'err'); }
}
load();
</script>
</body>
</html>
