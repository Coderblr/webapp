package com.sbi.automation.runners;

import java.io.File;
import java.util.ArrayList;
import java.util.List;

import com.sbi.automation.core.DriverFactory;
import com.sbi.automation.utils.ExecutionContext;
import com.sbi.automation.utils.SocketResetClient;

/**
 * The runner the Execution Agent launches.  PURE JAVA — no Maven, no Gradle.
 *
 * It chains the mandatory password-change transaction (9750) IN THE SAME
 * BROWSER SESSION before the requested transaction, which is exactly the real
 * SBI flow of Section 11.1:
 *
 *   launch → URL → login → forced password change (9750) → re-login
 *          → search transaction → execute → logout
 *
 * Usage:
 *   java -cp "lib/*;build" com.sbi.automation.runners.PlatformRunner \
 *        --transaction=400 --env=PREPROD --profile=SBI_PREPROD \
 *        --prestep=9750 --execution=exec_400_...
 */
public class PlatformRunner {

    private static final String TXN_ROOT = "src/com/sbi/automation/transactions";
    private static final String GLUE = "com.sbi.automation.steps";
    private static final String HOOKS = "com.sbi.automation.hooks";

    public static void main(String[] args) {
        ExecutionContext.initFromArgs(args);
        String transaction = ExecutionContext.transaction();
        String prestep = ExecutionContext.prestep();

        int exitCode = 1;
        try {
            List<String> cucumberArgs = new ArrayList<>();

            /* 1. mandatory password change, attached automatically */
            if (prestep != null && !prestep.isEmpty()) {
                File presteFeature = featureFor(prestep);
                if (presteFeature.exists()) {
                    cucumberArgs.add(presteFeature.getAbsolutePath());
                    ExecutionContext.recordStep("password_change",
                            "Transaction " + prestep + " attached as pre-step",
                            "passed", 0, "", null);
                } else {
                    ExecutionContext.recordStep("password_change",
                            "Transaction " + prestep + " feature not found",
                            "skipped", 0, "",
                            presteFeature.getAbsolutePath());
                }
            }

            /* 2. the requested transaction */
            File feature = featureFor(transaction);
            if (!feature.exists()) {
                throw new IllegalStateException(
                        "Feature file not found: " + feature.getAbsolutePath()
                        + " — record transaction " + transaction + " first.");
            }
            cucumberArgs.add(feature.getAbsolutePath());

            cucumberArgs.add("--glue");
            cucumberArgs.add(GLUE);
            cucumberArgs.add("--glue");
            cucumberArgs.add(HOOKS);
            cucumberArgs.add("--plugin");
            cucumberArgs.add("pretty");
            cucumberArgs.add("--plugin");
            cucumberArgs.add("json:" + ExecutionContext.reportPath("cucumber.json"));
            cucumberArgs.add("--plugin");
            cucumberArgs.add("html:" + ExecutionContext.reportPath("cucumber.html"));
            cucumberArgs.add("--monochrome");

            exitCode = io.cucumber.core.cli.Main.run(
                    cucumberArgs.toArray(new String[0]),
                    Thread.currentThread().getContextClassLoader());
        } catch (Throwable t) {
            ExecutionContext.recordFatal(t);
        } finally {
            /* 3. always tear down and always attempt the teller reset */
            DriverFactory.quitQuietly();
            SocketResetClient.resetTellerQuietly();
            ExecutionContext.flush();
        }
        System.exit(exitCode);
    }

    private static File featureFor(String transactionId) {
        return new File(TXN_ROOT + File.separator + "Transaction_" + transactionId,
                "Transaction" + transactionId + ".feature");
    }
}
