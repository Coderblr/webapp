@app.on_event("startup")
async def _on_startup():
    """Runs the stale-agent reaper for the lifetime of the process (see
    backend/agent_registry.py's reap_stale_agents) - catches a dropped
    agent connection that the WebSocket layer itself never cleanly
    detected (some network failures don't deliver a close frame).

    Also sweeps transactions/ once for any run left "Running" by a previous
    process that never reached a terminal status - i.e. got hard-killed or
    the machine restarted mid-execution, rather than failing cleanly (which
    runner/run_recording.py already handles on its own). See
    transaction_store.mark_interrupted_running_transactions()."""
    asyncio.ensure_future(agent_registry.reap_stale_agents())
    flagged = execution_jobs.mark_interrupted_jobs()
    if flagged:
        logger.warning(f"Flagged {flagged} execution(s) as requires_investigation at startup (backend restarted mid-run).")
    try:
        from backend import excel_runs as _excel_runs
        _n = _excel_runs.mark_interrupted()
        if _n:
            logger.warning(f"Marked {_n} Excel run(s) as interrupted at startup (backend restarted mid-run).")
    except Exception:
        logger.exception("Excel run housekeeping failed (continuing)")
    execution_jobs.cleanup_old_jobs()
    execution_jobs.cleanup_old_evidence()
    try:
        from automation import assets as _assets, testdata as _testdata
        _assets.cleanup_temp()
        _testdata.sweep_expired()
        _days = int(_os.environ.get('TESTDATA_RETENTION_DAYS', '0') or 0)
        if _days:
            _assets.purge_expired(_days)
    except Exception:
        logger.exception('Test-data housekeeping failed (continuing)')
    swept = transaction_store.mark_interrupted_running_transactions()
    if swept:
        logger.warning(f"Marked {swept} transaction(s) as Interrupted at startup (left Running by a previous process).")


@app.on_event("shutdown")
def _on_shutdown():
    """
    Runs on a graceful stop (Ctrl+C in the terminal, or uvicorn --reload
    restarting the worker process) - closes every still-open recorder
    browser session (there can be several now - one per concurrently
    recording user, see backend/recording_sessions.py) and releases the
    database's connection pool, so no Edge/Chrome process or
    database/test_recorder.db is left locked behind.
    """
    _cleanup_all()


def _cleanup_all(timeout: float = 15):
    """Shared by the ASGI shutdown event above (normal Ctrl+C stop) AND
    shutdown_guard's Windows console-close handler below (terminal window
    closed directly) - whichever fires first runs this exactly once."""
    recording_sessions.stop_all(timeout=timeout)
    close_db()


# Covers the case Ctrl+C/ASGI shutdown can't: the terminal window being
# closed directly. Windows only gives ~5s to clean up in that case, so use
# a shorter timeout than the normal graceful-stop path above.
register_cleanup(lambda: _cleanup_all(timeout=3))


