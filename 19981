    name: str
    url: str


@app.post("/api/applications")
def add_application(req: NewApplicationRequest, request: Request, current_user: CurrentUser = Depends(get_current_admin)):
    """Adds an application (name -> URL) to config/applications.yaml and to the application registry, so it
    appears in the Record tab's dropdown (and in Admin > Users > Applications, where an admin then gives it to
    users). Recordings for it are saved under recordings/<name>/. Admin only - no need to edit the YAML by hand."""
    name = " ".join(req.name.split())
    url = req.url.strip()
    if not name or len(name) > 50 or not re.fullmatch(r"[A-Za-z0-9 _.\-]+", name):
        raise HTTPException(status_code=400, detail="Application name: letters, numbers, space, - _ . only (max 50).")
    if name.lower() == "others":
        raise HTTPException(status_code=400, detail="'Others' is reserved - choose another name.")
    if not re.match(r"^https?://", url, re.I):
        raise HTTPException(status_code=400, detail="URL must start with http:// or https://")
    blocked = _urlpolicy_check(url)
    if blocked:
        raise HTTPException(status_code=400, detail=blocked)
    apps = _load_applications()
    if any(k.lower() == name.lower() for k in apps):
        raise HTTPException(status_code=409, detail=f"Application '{name}' already exists.")
    apps[name] = url
    APPLICATIONS_CONFIG.write_text(
        "# Application name -> target URL (dropdown in the Record tab).\n"
        + yaml.safe_dump({"applications": apps}, sort_keys=False, allow_unicode=True),
        encoding="utf-8",
    )
    with get_session() as session:
        try:
            existing = repo.get_application_by_name(session, name)
            if existing is None:
                repo.create_application(session, name=name, base_url=url)
            else:
                # Added again after an admin hid it (Admin > Applications): show it again, with the new address.
                existing.status = "Active"
                existing.base_url = url
        except ValueError:
            pass   # already in the registry (e.g. added there first) - the config entry is what was missing
        repo.log_activity(session, user_id=current_user.user_id, session_id=current_user.session_id,
                          action="APPLICATION_CREATED", status="SUCCESS", details={"application": name},
                          endpoint="/api/applications", ip_address=get_client_ip(request))
    return {"ok": True, "applications": list(apps.keys())}


def _urlpolicy_check(url: str):
    from automation import urlpolicy as _urlpolicy
    return _urlpolicy.check_target(url)


@app.post("/api/start")
async def start_recording(req: StartRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """
    Requires a connected desktop agent (backend/agent_registry.py) - the
    whole point of the Electron/local-agent architecture: the actual
    browser launches on the USER'S OWN PC via their local agent, never
    here. This backend only sends a command and stores metadata
    (backend/recording_sessions.py's "mode"/"agent_id" fields) - no
    Recorder, no browser object, ever exists in this process for a
    production recording.

    ALLOW_SERVER_FALLBACK (.env, default false) is a LOCAL-DEV-ONLY escape
    hatch: with it set, a missing agent falls back to the original
    server-side headless Recorder + live-view path instead of erroring -
    useful for developing the recorder tab without also running the
    desktop app, but this must stay false for any real deployment (see
    docs/electron-local-agent-architecture.md).
    """
    # Application access FIRST: the application must be registered and the user must hold "record" on it
    # (400 unknown / 404 cannot view / 403 cannot record) - before any URL is resolved or any agent is contacted.
    dest_app = app_access.resolve_destination(current_user, req.app_name, "record")
    req.app_name = "" if app_access.app_key(dest_app) == app_access.app_key(app_access.OTHERS) else dest_app
    applications = {app_access.app_key(k): v for k, v in _load_applications().items()}
    if req.app_name and app_access.app_key(req.app_name) in applications:
        url = applications[app_access.app_key(req.app_name)].strip()
    else:
        url = req.url.strip()
    if not url:
        raise HTTPException(status_code=400, detail="URL is required (select a known application or provide one for 'Others')")
    from automation import urlpolicy as _urlpolicy
    _blocked = _urlpolicy.check_target(url)
    if _blocked:
        raise HTTPException(status_code=400, detail=_blocked)

    state = recording_sessions.get_state(current_user.session_id, current_user.user_id)
    if state["recorder"] is not None or state.get("agent_recording_active"):
        raise HTTPException(status_code=400, detail="You already have a recording in progress - save or stop it first")

    ip = get_client_ip(request)
    conn = agent_registry.get_for_user(current_user.user_id)

    if conn is None and not ALLOW_SERVER_FALLBACK:
        raise HTTPException(status_code=409, detail=NO_AGENT_ERROR)

    # ---- AGENT mode ---------------------------------------------------------
    if conn is not None:
        try:
            # Opening the browser can take over a minute when Edge stalls handing over its first tab (the agent
            # then starts it another way - recorder/browser_factory.py). Waiting only the general 30 s reported
            # "did not respond" while the agent was still about to open the application.
            response = await agent_registry.send_command(
                conn, "START_RECORDING", {"url": url, "headless": req.headless},
                timeout=AGENT_START_RECORDING_TIMEOUT_SECONDS,
            )
        except (asyncio.TimeoutError, ConnectionError) as e:
            raise HTTPException(status_code=502, detail=f"Local agent did not respond: {e}")

        if not response.get("ok", False):
            raise HTTPException(status_code=400, detail=response.get("error", "Agent failed to start recording."))

        state["mode"] = "agent"
        state["agent_id"] = conn.agent_id
        state["agent_recording_active"] = True
        state["pending_recording_name"] = req.recording_name.strip() or None
        state["pending_app_name"] = req.app_name.strip() or ""
        state["app_name"] = dest_app
        state["target_url"] = url
        conn.busy = True

        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="START_RECORDING",
                status="SUCCESS", details={"url": url, "recording_name": req.recording_name, "mode": "agent",
                                            "agent_id": conn.agent_id},
                endpoint="/api/start", ip_address=ip,
            )
        return {"ok": True, "message": f"Recording started on your local agent ({conn.hostname or conn.agent_id})."}

    # ---- SERVER mode - only reachable when ALLOW_SERVER_FALLBACK=true, since
    # the 409 above already returned for conn is None otherwise. Local-dev-only. ---
    active = recording_sessions.count_active_recordings()
    if active >= recording_sessions.MAX_CONCURRENT_RECORDINGS:
        raise HTTPException(
            status_code=503,
            detail=f"The server is at capacity ({active}/{recording_sessions.MAX_CONCURRENT_RECORDINGS} concurrent "
                   f"recordings) - please try again shortly.",
        )

    state["mode"] = "server"
    state["pending_recording_name"] = req.recording_name.strip() or None
    state["pending_app_name"] = req.app_name.strip() or ""
    state["app_name"] = dest_app
    state["start_error"] = None
    state["launching"] = True

    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="START_RECORDING",
            status="SUCCESS", details={"url": url, "app_name": req.app_name, "recording_name": req.recording_name,
                                        "headless": req.headless, "mode": "server"},
            endpoint="/api/start", ip_address=ip,
        )

    def _launch():
        try:
            # A hosted server (see backend/recording_sessions.py's docs and
            # DEPLOYMENT_WINDOWS.md) typically has no desktop session for a
            # headed browser window to render into, and the live-view
            # WebSocket streams a headless browser just fine via CDP
            # screencast either way - so FORCE_HEADLESS_RECORDING (.env,
            # default true) overrides whatever the frontend's "headless"
            # checkbox sent. Set it to false only for local single-user dev
            # where seeing the real window is convenient.
            import os
            force_headless = os.environ.get("FORCE_HEADLESS_RECORDING", "true").lower().strip() != "false"
            effective_headless = True if force_headless else req.headless
            # Only bother with CDP screencast when actually headless - a
            # headed run already gives a real, visible browser window, so
            # the live-view widget would just be a redundant (and
            # occasionally flaky, e.g. across an unstable dev-reload) second
            # way to see the exact same thing. GET /api/status's "headless"
            # field tells the frontend whether to even show that panel.
            rec = Recorder(url, headless=effective_headless, enable_live_view=effective_headless).start()
            state["recorder"] = rec
            state["headless"] = effective_headless
        except Exception as e:
            # Previously this died silently in the background thread - the
            # frontend would show "Launching browser..." and mark the
            # recording as started regardless, so a failed launch (wrong
            # channel, Edge not installed, bad URL, etc.) only surfaced
            # later as a confusing 400 on Stop & Save. Now the frontend can
            # poll GET /api/status and see exactly why it failed.
            state["start_error"] = str(e)
        finally:
            state["launching"] = False

    threading.Thread(target=_launch, daemon=True).start()
    return {"ok": True, "message": f"Launching browser for {url}..."}


@app.get("/api/dashboard-summary")
def get_dashboard_summary(current_user: CurrentUser = Depends(get_current_user)):
    """Returns counts the dashboard widget shows — pending change plan items
    across all applications, grouped so the user can see at a glance what
    needs attention without visiting the Solution Documents page."""
    from solution_analyzer.service import list_solution_documents, load_change_plan

    summary = {
        "pending_approvals": 0,   # items waiting for approve/reject
        "approved_not_applied": 0, # approved but apply not yet run
        "applied_not_validated": 0, # applied but validation not yet run
        "applications_with_activity": [],
    }

    recordings_root = ROOT / "recordings"
    if not recordings_root.exists():
        return summary

    # Walk every application folder (only the ones this user may view)
    app_activity = {}
    _access = app_access.for_user(current_user)
    for app_dir in recordings_root.iterdir():
        if not app_dir.is_dir():
            continue
        if not _access.allows(app_dir.name, "view"):
            continue
        change_analysis_dir = app_dir / "change_analysis"
        if not change_analysis_dir.exists():
            continue
        app_name = app_dir.name

        for plan_file in change_analysis_dir.glob("*.json"):
            if "_extraction.json" in plan_file.name:
                continue
            try:
                import json as _j
                plan = _j.loads(plan_file.read_text())
                for item in plan.get("items", []):
                    impact = item.get("impact_item", {})
                    if not impact.get("is_implementable", True) or item.get("manually_handled"):
                        continue
                    status = item.get("approval_status", "PENDING")
                    applied = item.get("applied", False)
                    validation = item.get("validation_status", "NOT_RUN")
                    manual = impact.get("manual_review_required", False)

                    if status == "PENDING" and not manual:
                        summary["pending_approvals"] += 1
                        app_activity[app_name] = app_activity.get(app_name, 0) + 1
                    elif status == "APPROVED" and not applied and not manual:
                        summary["approved_not_applied"] += 1
                        app_activity[app_name] = app_activity.get(app_name, 0) + 1
                    elif applied and validation == "NOT_RUN":
                        summary["applied_not_validated"] += 1
            except Exception:
                continue

    summary["applications_with_activity"] = [
        {"application": k, "pending_count": v}
        for k, v in sorted(app_activity.items(), key=lambda x: -x[1])
    ]
    return summary


@app.get("/api/status")
