"""
The agent's single persistent outbound connection to the backend (spec
section 8) - the agent always connects TO the server; the server never
needs an inbound connection to the user's PC (works fine through NAT/
corporate firewalls with no port-forwarding, since it's just an outgoing
WSS connection like any browser tab makes).

State machine (spec section 8): CONNECTING -> CONNECTED -> (on drop)
RECONNECTING -> CONNECTING -> ... with exponential backoff, or
DISCONNECTED once stop() is called deliberately (app shutdown). BUSY is a
local-agent-level state (see command_handler.py's `busy` flag) surfaced
separately, not a transport-level state - a busy agent stays CONNECTED,
it just declines new work.
"""
from __future__ import annotations
import asyncio
import json
from enum import Enum
from typing import Awaitable, Callable, Optional
from urllib.parse import urlencode

import websockets
from websockets.exceptions import ConnectionClosed

from local_agent.logger import get_logger

logger = get_logger("server_connection")


class AgentState(str, Enum):
    CONNECTING = "CONNECTING"
    CONNECTED = "CONNECTED"
    RECONNECTING = "RECONNECTING"
    DISCONNECTED = "DISCONNECTED"
    ERROR = "ERROR"


class ConnectionManager:
    def __init__(
        self,
        ws_url: str,
        token: str,
        agent_id: str,
        hostname: str,
        version: str,
        on_command: Callable[[dict], Awaitable[Optional[dict]]],
        initial_backoff: float = 1.0,
        max_backoff: float = 30.0,
    ):
        self.ws_url = ws_url
        self.token = token
        self.agent_id = agent_id
        self.hostname = hostname
        self.version = version
        self.on_command = on_command  # async callable(message) -> response dict (with request_id) or None
        self.initial_backoff = initial_backoff
        self.max_backoff = max_backoff

        self.state = AgentState.DISCONNECTED
        self._stop = False

    def _url(self) -> str:
        params = urlencode({
            "token": self.token, "agent_id": self.agent_id,
            "hostname": self.hostname, "version": self.version,
        })
        return f"{self.ws_url}/api/agent/ws?{params}"

    async def run_forever(self) -> None:
        """The agent's main loop for its whole lifetime - connect, serve
        commands until the connection drops for any reason, then
        reconnect with exponential backoff, forever, until stop() is
        called (app shutdown - see client.py)."""
        backoff = self.initial_backoff
        while not self._stop:
            self.state = AgentState.CONNECTING
            logger.info(f"Connecting to {self.ws_url} (agent_id={self.agent_id})...")
            try:
                async with websockets.connect(self._url(), open_timeout=15) as ws:
                    self.state = AgentState.CONNECTED
                    logger.info("Connected to central server.")
                    backoff = self.initial_backoff  # reset only after a successful connection
                    heartbeat_task = asyncio.ensure_future(self._heartbeat_loop(ws))
                    try:
                        await self._receive_loop(ws)
                    finally:
                        heartbeat_task.cancel()
            except ConnectionClosed as e:
                logger.warning(f"Connection closed by server: code={e.code} reason={e.reason!r}")
                self.state = AgentState.ERROR
                if e.code == 4401:
                    logger.error("Authentication rejected - the stored token may be expired or revoked. "
                                 "Restart the desktop app to log in again.")
            except (OSError, asyncio.TimeoutError) as e:
                logger.warning(f"Could not reach the central server: {e}")
                self.state = AgentState.ERROR
            except Exception:
                logger.exception("Unexpected error in connection loop")
                self.state = AgentState.ERROR

            if self._stop:
                break
            self.state = AgentState.RECONNECTING
            logger.info(f"Reconnecting in {backoff:.1f}s...")
            await asyncio.sleep(backoff)
            backoff = min(backoff * 2, self.max_backoff)

        self.state = AgentState.DISCONNECTED
        logger.info("Connection manager stopped.")

    async def _receive_loop(self, ws) -> None:
        async for raw in ws:
            try:
                message = json.loads(raw)
            except json.JSONDecodeError:
                logger.warning(f"Ignoring malformed (non-JSON) message from server: {raw[:200]!r}")
                continue
            response = await self.on_command(message)
            if response is not None:
                await ws.send(json.dumps(response))

    async def _heartbeat_loop(self, ws, interval: float = 20.0) -> None:
        """Sends a periodic WebSocket ping frame (not a JSON message) so
        the underlying TCP connection is kept alive through corporate
        proxies/load balancers that close idle connections.

        Previously this sent a JSON HEARTBEAT message with request_id=null,
        which the server correctly ignored as a housekeeping message — but
        because the server's receive loop calls agent_registry.touch() ONLY
        after resolving a response (i.e. only for messages that have a
        request_id), a null-request_id heartbeat never updated last_seen,
        so the server-side stale-agent reaper would eventually mark this
        connection as dead even though it was still alive.

        Now we send a proper WebSocket-level ping frame (ws.ping()) which:
        1. Keeps the TCP connection alive through any proxy that would
           otherwise close an 'idle' connection (proxies see the ping/pong
           at the transport layer, not the JSON application layer)
        2. Causes the server to respond with a pong frame automatically
           (websockets library handles this transparently on both sides)
        3. Does NOT go through the JSON message path at all, so there is
           no risk of the server seeing it as a malformed command

        We ALSO send a JSON HEARTBEAT with a real non-null request_id
        every interval*3 seconds so agent_registry.touch() is called and
        last_seen is kept current for the admin's agent listing/monitoring.
        """
        tick = 0
        try:
            while True:
                await asyncio.sleep(interval)
                tick += 1
                # Transport-level ping every interval seconds — use a timeout
                # so a broken connection never hangs this coroutine forever.
                try:
                    await asyncio.wait_for(ws.ping(), timeout=10.0)
                except asyncio.TimeoutError:
                    logger.debug("[heartbeat] ping timed out — connection likely dead")
                    break
                except Exception:
                    break  # connection closed, stop the loop cleanly
                # JSON heartbeat with a real request_id every 3 intervals
                # so the server's receive loop calls touch() via resolve_response
                if tick % 3 == 0:
                    import uuid
                    await ws.send(json.dumps({
                        "type": "HEARTBEAT",
                        "request_id": f"hb-{uuid.uuid4().hex[:8]}",
                        "payload": {},
                    }))
        except asyncio.CancelledError:
            pass
        except Exception as e:
            logger.debug(f"Heartbeat loop ending: {e}")

    def stop(self) -> None:
        """Deliberate shutdown (app quitting) - distinct from a dropped
        connection, which reconnects instead of stopping."""
        self._stop = True
