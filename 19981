@app.post("/api/recordings/uipath_sheets")
async def list_uipath_recording_sheets(file: UploadFile = File(...), current_user: CurrentUser = Depends(get_current_user)):
    """Lists every sheet name in an uploaded UiPath-style Excel workbook,
    WITHOUT importing anything yet - the frontend calls this right after
    the person picks a file, to show a sheet picker (a specific sheet,
    several, or "all of them") before committing to an actual import. A
    real UiPath test suite is very often organized as one sheet per test
    case/scenario, all in a single .xlsx file - see
    generator/uipath_importer.py's list_uipath_sheets."""
    if not file.filename.lower().endswith((".xlsx", ".xlsm")):
        raise HTTPException(status_code=400, detail="Please upload an Excel file (.xlsx or .xlsm).")

    tmp_path = Path(tempfile.gettempdir()) / f"uipath_sheets_{uuid.uuid4().hex}.xlsx"
    try:
        contents = await file.read()
        tmp_path.write_bytes(contents)
        try:
            sheets = await asyncio.to_thread(list_uipath_sheets, str(tmp_path))
        except Exception:
            logger.exception("Could not read sheet list from %s", file.filename)
            raise HTTPException(status_code=400, detail="Could not read this file as an Excel workbook.")
        return {"sheets": sheets}
    finally:
        tmp_path.unlink(missing_ok=True)


@app.post("/api/recordings/import_uipath")
async def import_uipath_recording(
    request: Request,
    file: UploadFile = File(...),
    recording_name: str = Form(""),
    sheet_names: str = Form(""),
    app_name: str = Form(""),
    current_user: CurrentUser = Depends(get_current_user),
):
    """Converts an uploaded UiPath-style Excel test-steps sheet
    (Steps / NAME / Action-Method / present element / input columns) into
    a normal recording JSON via generator/uipath_importer.py, and saves
    it exactly like a live-recorded session would be (same
    save_recording_json, same recordings/ folder) - so it's immediately
    usable everywhere else in the app: "Run Saved Recording", the test-
    data grid, Regenerate, the exit report. Nothing downstream needs to
    know this recording came from a spreadsheet instead of a browser.

    `sheet_names`: comma-separated sheet names to import (from
    /api/recordings/uipath_sheets above) - each becomes its OWN saved
    recording. Leave empty to import just the workbook's active sheet
    (the original, single-sheet-file behavior). Pass every sheet name to
    import "all sheets".

    Returns one entry per sheet in `results` - a sheet that turns out not
    to be a real test-steps sheet at all (e.g. a reference/notes tab)
    gets an `error` there instead of aborting the whole batch; the other
    sheets in the same file still import normally."""
    if not file.filename.lower().endswith((".xlsx", ".xlsm")):
        raise HTTPException(status_code=400, detail="Please upload an Excel file (.xlsx or .xlsm).")

    # Destination application: registered + the user needs "upload" on it - checked before anything is written.
    _dest = app_access.resolve_destination(current_user, app_name, "upload")
    app_name = "" if app_access.app_key(_dest) == app_access.app_key(app_access.OTHERS) else _dest

    ip = get_client_ip(request)
    tmp_path = Path(tempfile.gettempdir()) / f"uipath_import_{uuid.uuid4().hex}.xlsx"
    try:
        contents = await file.read()
        tmp_path.write_bytes(contents)

        requested_sheets = [s.strip() for s in sheet_names.split(",") if s.strip()]
        base_name = recording_name or file.filename.rsplit(".", 1)[0]

        if not requested_sheets:
            # Original, single-(active)-sheet behavior - unchanged for
            # anyone/anything still calling this without sheet_names.
            try:
                single = await asyncio.to_thread(import_uipath_excel, str(tmp_path), recording_name or None)
            except ValueError as e:
                raise HTTPException(status_code=400, detail=str(e))
            except Exception:
                logger.exception("UiPath Excel import failed for %s", file.filename)
                raise HTTPException(status_code=500, detail="Failed to parse this spreadsheet - see logs/error.log for details.")
            sheet_results = [{"sheet_name": None, "recording": single["recording"], "warnings": single["warnings"], "error": None}]
        else:
            try:
                sheet_results = await asyncio.to_thread(
                    import_uipath_excel_sheets, str(tmp_path), requested_sheets, base_name,
                )
            except Exception:
                logger.exception("UiPath Excel multi-sheet import failed for %s", file.filename)
                raise HTTPException(status_code=500, detail="Failed to parse this spreadsheet - see logs/error.log for details.")

        results = []
        with get_session() as session:
            for entry in sheet_results:
                if entry["error"] is not None:
                    results.append({"sheet_name": entry["sheet_name"], "error": entry["error"]})
                    continue
                recording = entry["recording"]
                saved_name = recording.get("recording_name") or base_name
                path = save_recording_json(
                    recording["target_url"], recording["actions"],
                    name=saved_name, app_name=app_name,
                )
                # Keep a copy of the original xlsx under the application's
                # imports/ folder so it can be re-imported or referenced later
                # without the user needing to keep the file themselves.
                if app_name.strip():
                    from recorder.recorder import _slugify as _s
                    imports_dir = Path("recordings") / _s(app_name.strip()) / "imports"
                    imports_dir.mkdir(parents=True, exist_ok=True)
                    dest_xlsx = imports_dir / file.filename
                    if not dest_xlsx.exists():
                        shutil.copy2(tmp_path, dest_xlsx)
                recording_access.create_recording_with_initial_version(
                    session, owner_user_id=current_user.user_id, name=saved_name,
                    path=Path(path), recording_json=recording,
                )
                results.append({
                    "sheet_name": entry["sheet_name"], "recording_file": path,
                    "action_count": len(recording["actions"]), "warnings": entry["warnings"], "error": None,
                })

            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="UIPATH_IMPORTED",
                status="SUCCESS", details={
                    "source_file": file.filename, "sheet_count": len(results),
                    "success_count": sum(1 for r in results if r["error"] is None),
                },
                endpoint="/api/recordings/import_uipath", ip_address=ip,
            )
        return {"ok": True, "results": results}
    finally:
        tmp_path.unlink(missing_ok=True)


@app.post("/api/recordings/regenerate")
async def regenerate_recording(req: RegenerateRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Re-runs ONLY the generation step (generator/build.py) against a saved
    recording's CURRENT JSON, writing fresh feature/steps/page/locators
    files - without executing anything. Exists for exactly the situation
    that prompted it: a fix lands in generator/templates/*.tmpl (or
    anywhere else build_artifacts touches), and the person wants to
    confirm existing saved recordings pick it up WITHOUT re-recording them
    from scratch AND without waiting through a full (possibly multi-
    minute) test execution just to see whether generation itself succeeds.

    Note this is generation only - "Run Saved Recording" (POST
    /api/run_recording below) already calls build_artifacts() fresh on
    EVERY run on its own, so a code/template fix takes effect automatically
    the next time a recording is actually run, with no extra step required.
    This endpoint is for explicit, immediate confirmation - and for
    refreshing the feature/steps/page files on disk without also spending
    the time (and, if AI step-naming is on, the LLM cost) of a real
    execution - not a prerequisite for the fix to apply."""
    path = _safe_recording_path(req.recording_file)
    with get_session() as session:
        recording_access.require_access(session, path, current_user, "view")
    recording = json.loads(path.read_text())

    # A stable, reused-on-every-regenerate location (unlike "Run Saved
    # Recording"'s output/runs/<transaction_id>/, which intentionally gets
    # a fresh folder per run so run history doesn't overwrite itself) -
    # regenerating the same recording twice should just refresh the same
    # files in place, since nothing here is meant to be kept as history.
    from recorder.recorder import _slugify
    slug = _slugify(recording.get("recording_name") or path.stem)
    # Per-application folder: the download route below authorises by this first path segment.
    _apps = sorted(app_access.applications_of_recording(path, recording.get("application")))
    output_dir = str(Path("output") / "regenerated" / _apps[0] / slug)

    llm = get_llm() if _os.environ.get("AI_STEP_NAMING", "true").strip().lower() != "false" else None
    try:
        build_result = await asyncio.to_thread(build_artifacts, recording, llm=llm, output_dir=output_dir)
    except Exception:
        logger.exception("Regenerate failed for %s", path)
        raise HTTPException(status_code=500, detail="Regeneration failed - see logs/error.log for the full traceback.")

    ip = get_client_ip(request)
    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="RECORDING_REGENERATED",
            status="SUCCESS", details={"recording_file": str(path), "output_dir": output_dir,
                                        "step_count": build_result.get("step_count")},
            endpoint="/api/recordings/regenerate", ip_address=ip,
        )
    return {"ok": True, "output_dir": output_dir, "build_result": _public_build_result(build_result)}


@app.get("/api/recordings/regenerate/download")
def download_regenerated_file(path: str, current_user: CurrentUser = Depends(get_current_user)):
    """Downloads one file produced by /api/recordings/regenerate above (a
    generated .feature/steps.py/recorded_page.py/locators.json) - lets
    someone grab the exact script reflecting their current edits (from the
    step editor, test-data grid, or a UiPath import) without needing to
    run the recording first. Any logged-in user can download from
    output/regenerated/ - unlike a transaction's own files, these aren't
    tied to a specific run or a specific person, they're just the current
    state of a shared recording anyone with access to this tool can open
    and edit.

    Path safety: the resolved path must land inside output/regenerated/ -
    never anywhere else on disk, regardless of what `path` claims."""
    requested = Path(path).resolve()
    allowed_root = (ROOT / "output" / "regenerated").resolve()
    if requested != allowed_root and allowed_root not in requested.parents:
        raise HTTPException(status_code=400, detail="Invalid file path.")
    # output/regenerated/<application>/<recording>/... - the first folder names the application; the user needs
    # export access to it (files from the old, application-less layout are admin-only).
    try:
        _first = requested.relative_to(allowed_root).parts[0]
    except (ValueError, IndexError):
        raise HTTPException(status_code=400, detail="Invalid file path.")
    app_access.require_application_access(current_user, _first, "export")
    if not requested.exists() or not requested.is_file():
        raise HTTPException(status_code=404, detail="File not found - try regenerating again.")
    return FileResponse(path=str(requested), filename=requested.name)


@app.post("/api/run_recording")
async def run_saved_recording(req: RunRecordingRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Runs a previously saved recording end-to-end (regenerate + execute)
    and returns the exit report, attributed to whoever is logged in - the
    frontend no longer picks a "run as" user, it's always the current
    session. Everything about the run (status, steps, files produced) is
    written to transactions/*.json (see runner/transaction_store.py) -
    NOT the database, which is reserved for auth/session/activity data.

    Requires a connected desktop agent by default (ALLOW_SERVER_FALLBACK
    is the local-dev-only escape hatch - see /api/start's docstring) - the
    Behave/Playwright execution happens on the user's own PC via
    local_agent/execution_manager.py's run_test_with_json_report, which
    returns the exact same {returncode, stdout, stderr, json} shape the
    server-side path always produced, so the exit report this generates is
    identical either way.

    Any test-data edits (see /api/recordings/data above) are already
    persisted into the recording file itself by the time this runs, so
    there's nothing extra to pass through here - the run just reads
    whatever's currently saved."""
    path = recording_access.resolve_within_recordings_dir(req.recording_file)
    with get_session() as session:
        recording_access.require_access(session, path, current_user, "execute")

    ip = get_client_ip(request)
    conn = agent_registry.get_for_user(current_user.user_id)
    resume = None
    if req.resume_from and int(req.resume_from) > 2:
        resume = {"from_step": int(req.resume_from), "setup_steps": max(0, int(req.resume_setup or 0))}

    if conn is None and not ALLOW_SERVER_FALLBACK:
        raise HTTPException(status_code=409, detail=NO_AGENT_ERROR)

    if conn is not None:
        # Agent execution goes through the background-job driver (backend/execution_jobs.py):
        # no fixed 10-minute cap, progress/checkpoints, survives agent reconnects, bounded
        # result transfer. This legacy endpoint simply waits for the job; the web UI uses
        # POST /api/executions + polling instead, so it never holds a request open.
        if execution_jobs.active_job_for_user(current_user.user_id):
            raise HTTPException(status_code=409, detail="You already have an execution in progress.")
        job = execution_jobs.start_job(user_id=current_user.user_id, username=current_user.username,
                                       recording_file=str(path), headless=req.headless, screenshots="auto",
                                       loop=asyncio.get_running_loop(), resume=resume)
        while True:
            await asyncio.sleep(1)
            j = execution_jobs.get_job(job["job_id"]) or job
            if j.get("status") in execution_jobs.TERMINAL_STATUSES:
                break
        txn = transaction_store.get_transaction(j["transaction_id"]) if j.get("transaction_id") else None
        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="RUN_RECORDING",
                status="SUCCESS" if j.get("result_status") == "Success" else "FAILURE",
                details={"recording_file": req.recording_file, "transaction_id": j.get("transaction_id"),
                         "job_id": j["job_id"], "mode": "agent"},
                endpoint="/api/run_recording", ip_address=ip,
            )
        if txn is None:
            raise HTTPException(status_code=502, detail=j.get("message") or "The execution did not produce a report.")
        return txn

    execute_fn = None   # ALLOW_SERVER_FALLBACK dev mode: run_recording executes behave in this process
    try:
        report = await asyncio.to_thread(
            run_recording,
            recording_file=req.recording_file,
            user_id=current_user.user_id,
            headless=req.headless,
            execute_fn=execute_fn,
            resume=resume,
        )
        with get_session() as session:
            repo.log_activity(
                session, user_id=current_user.user_id, session_id=current_user.session_id, action="RUN_RECORDING",
                status="SUCCESS" if report["status"] == "Success" else "FAILURE",
                details={"recording_file": req.recording_file, "transaction_id": report["transaction_id"],
                         "mode": "agent" if conn is not None else "server"},
                endpoint="/api/run_recording", ip_address=ip,
            )
        return report
    except FileNotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except TimeoutError:
        raise HTTPException(
            status_code=502,
            detail=(f"The test did not finish within {AGENT_TEST_TIMEOUT_SECONDS // 60} minutes, so the server stopped waiting "
                    f"(the local agent may still be running it). For long recordings raise AGENT_TEST_TIMEOUT_SECONDS "
                    f"on the server (seconds, e.g. 3600) and restart it."),
        )
    except ConnectionError as e:
        raise HTTPException(status_code=502, detail=f"Local agent disconnected while running the test: {e}")


# ------------------------------------------------------------------------
# Navigation menu check - a saved "recording" that needs NO recording.
#
# Its single "menu_check" step finds the site's navigation menu on the live
# page at run time and checks every link in it: opens the parent menus with
# the mouse, clicks the link, verifies the page that opens (see
# generator/build.py and page.tmpl's BasePage.check_navigation_menu). It is
# saved as an ordinary recording file, so "Run Saved Recording", the exit
# report, sharing, versions and export all work on it unchanged.
# ------------------------------------------------------------------------

class MenuCheckCreateRequest(BaseModel):
    url: str = ""
    app_name: str = ""        # one of GET /api/applications, or "" with a custom url
    recording_name: str = ""
    menu_selector: str = ""   # optional CSS selector of the menu - blank = find it automatically
    strict_hover: bool = False  # fail a link whose parent menu does not open on hover


class MenuBaselineResetRequest(BaseModel):
    recording_file: str


@app.post("/api/menu_check")
def create_menu_check(req: MenuCheckCreateRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Creates a navigation menu check for an application. Nothing is
    launched here - no browser, no agent needed - it only writes the saved
    recording; run it from "Run Saved Recording" like any other."""
    _dest = app_access.resolve_destination(current_user, req.app_name, "record")
    applications = {app_access.app_key(k): v for k, v in _load_applications().items()}
    app_name = "" if app_access.app_key(_dest) == app_access.app_key(app_access.OTHERS) else _dest
    if app_name and app_access.app_key(app_name) in applications:
        url = applications[app_access.app_key(app_name)].strip()
    else:
        url = req.url.strip()
    if not url:
        raise HTTPException(status_code=400, detail="URL is required (select a known application or provide one for 'Others')")
    if "://" not in url:
        url = "https://" + url  # "ca.statebank" -> "https://ca.statebank"

    name = req.recording_name.strip()
    if not name:
        from urllib.parse import urlsplit
        name = f"Menu check - {app_name or urlsplit(url).hostname or url}"

    import time as _time
    actions = [{
        "ts": int(_time.time() * 1000),
        "action": "menu_check",
        "value": None,
        "element": {"tag": "", "type": "", "text": "Navigation menu", "placeholder": "", "name": "", "ariaLabel": ""},
        "locators": [],
        "url": url,
        "page_index": 0,
        "frame_path": [],
    }]
    settings = {"menu_selector": req.menu_selector.strip(), "strict_hover": bool(req.strict_hover)}
    try:
        path = save_recording_json(
            url, actions, name=name, app_name=app_name,
            extra={"source_type": "menu_check", "menu_check": settings},
        )
    except Exception:
        logger.exception("Could not save the menu check for user_id=%s", current_user.user_id)
        raise HTTPException(status_code=500, detail="Failed to save the menu check - see logs/error.log")

    recording = json.loads(Path(path).read_text())
    with get_session() as session:
        recording_access.create_recording_with_initial_version(
            session, owner_user_id=current_user.user_id, name=name, path=Path(path), recording_json=recording,
        )
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="MENU_CHECK_CREATED",
            status="SUCCESS", details={"recording_file": path, "url": url, "app_name": app_name},
            endpoint="/api/menu_check", ip_address=get_client_ip(request),
        )
    # Same absolute form GET /api/recordings lists files in (see
    # runner/run_recording.py's list_saved_recordings), so the frontend can
    # select the new entry by this value straight away.
    listed_path = str((ROOT / path).resolve()) if not Path(path).is_absolute() else path
    return {"ok": True, "recording_file": listed_path, "name": name, "target_url": url}


@app.post("/api/menu_check/reset_baseline")
def reset_menu_check_baseline(req: MenuBaselineResetRequest, request: Request, current_user: CurrentUser = Depends(get_current_user)):
    """Forgets the saved baseline (the menu as it was on the first run) so
    the NEXT run saves a new one. Use after an intended menu change -
    until then, a removed item or a changed link keeps being reported as a
    failure, which is the point of the baseline."""
    path = _safe_recording_path(req.recording_file)
    with get_session() as session:
        recording_access.require_access(session, path, current_user, "edit")
    recording = json.loads(path.read_text())
    settings = recording.get("menu_check") or {}
    removed = len(settings.get("baseline") or [])
    settings.pop("baseline", None)
    settings.pop("baseline_saved_at", None)
    recording["menu_check"] = settings
    path.write_text(json.dumps(recording, indent=2))
    with get_session() as session:
        repo.log_activity(
            session, user_id=current_user.user_id, session_id=current_user.session_id, action="MENU_BASELINE_RESET",
            status="SUCCESS", details={"recording_file": str(path), "items_removed": removed},
            endpoint="/api/menu_check/reset_baseline", ip_address=get_client_ip(request),
        )
    return {"ok": True, "items_removed": removed}


# ------------------------------------------------------------------------
# Transaction history - read from transactions/*.json (see
# runner/transaction_store.py), NOT the database. The database only holds
# auth/session/activity data; recording-run history is plain files.
# ------------------------------------------------------------------------

def _authorized_txn(transaction_id: int, current_user: CurrentUser, permission: str) -> dict:
    """The run record, if it is the user's own (admins: anyone's) AND they still hold `permission` on the
    application it ran against. Revoking an assignment therefore blocks old reports/files immediately.
    404 either way - nothing reveals that an inaccessible run exists."""
    txn = transaction_store.get_transaction(transaction_id)
    if txn is None:
        raise HTTPException(status_code=404, detail="Transaction not found")
    if current_user.role != "admin":
        if txn.get("user_id") != current_user.user_id:
            raise HTTPException(status_code=404, detail="Transaction not found")
        if not app_access.authorize_applications(current_user, app_access.applications_of_transaction(txn),
                                                 permission, quiet=True):
            raise HTTPException(status_code=404, detail="Transaction not found")
    return txn


@app.get("/api/transactions")
def get_transactions(
    user_id: Optional[int] = None, limit: int = 50, recording_id: Optional[int] = None,
    current_user: CurrentUser = Depends(get_current_user),
):
    """Lists past executions ("My Executions" on the frontend, and the
    recording details page's Reports tab when recording_id is given) - a
    plain user only ever sees their OWN runs, regardless of what user_id
    they pass in: this silently overrides it to their own id rather than
    erroring, since the frontend's default "show me my history" call
    doesn't need to pass one at all. Only an admin can look up another
    user's history by passing user_id explicitly - matching the same
    "admins can see everything, everyone else sees their own" pattern
    used throughout the admin panel."""
    if current_user.role != "admin":
        user_id = current_user.user_id
    txns = transaction_store.list_transactions(user_id=user_id, limit=limit, recording_id=recording_id)
    if current_user.role != "admin":
        _access = app_access.for_user(current_user)
        txns = [t for t in txns if app_access.authorize_applications(
            current_user, app_access.applications_of_transaction(t), "view", _access, quiet=True)]
    return [
        {"transaction_id": t["transaction_id"], "recording_id": t.get("recording_id"), "user_id": t["user_id"],
         "transaction_name": t["transaction_name"], "status": t["status"],
         "date_time": t["date_time"], "passed_count": t.get("passed_count"),
         "failed_count": t.get("failed_count"), "step_count": t.get("step_count")}
        for t in txns
    ]


@app.get("/api/transactions/{transaction_id}")
def get_transaction_report(transaction_id: int, current_user: CurrentUser = Depends(get_current_user)):
    txn = _authorized_txn(transaction_id, current_user, "view")
    return txn


@app.get("/api/transactions/{transaction_id}/download")
def download_transaction_file(
    transaction_id: int, file_name: str, folder_path: str, current_user: CurrentUser = Depends(get_current_user)
):
    """Downloads one file produced by a run - a generated feature/steps/
    page file, the exit report, a step screenshot, or the original
    recording JSON (see runner/run_recording.py's `files` list, which is
    exactly where the frontend gets the folder_path/file_name pairs it
    passes here - "Files produced" and each Automation Log row's
    screenshot both use this same endpoint).

    A plain user can only download files belonging to THEIR OWN
    transaction (matching get_transaction_report's same ownership check)
    - an admin can download from any transaction. Path safety: the
    resolved path must land inside this transaction's own output folder
    (output/runs/<id>/, which covers generated files AND screenshots) or
    inside recordings/ (the original recording JSON) - never anywhere
    else on disk, regardless of what folder_path/file_name claim."""
    txn = _authorized_txn(transaction_id, current_user, "export")

    requested = (Path(folder_path) / file_name).resolve()
    allowed_roots = [
        # New layout: output/runs/<app>/<transaction_id>/
        (ROOT / "output" / "runs").resolve(),
        (ROOT / "recordings").resolve(),
    ]
    if not any(requested == root or root in requested.parents for root in allowed_roots):
        raise HTTPException(status_code=400, detail="Invalid file path for this transaction.")
    if not requested.exists() or not requested.is_file():
        raise HTTPException(status_code=404, detail="File not found - it may have been cleaned up since this run.")

    return FileResponse(path=str(requested), filename=requested.name)


@app.get("/api/transactions/{transaction_id}/download_flow")
def download_flow_zip(transaction_id: int, current_user: CurrentUser = Depends(get_current_user)):
    """Packages everything produced for a single run into one ZIP and
    streams it back so the user can download the complete flow in one click:
      recording JSON  (the source recording, so they can re-import/share it)
      generated scripts  (feature file, steps.py, page object, locators.json)
      screenshots  (one per executed step)
      exit report  (the .txt summary)

    Saved on the SERVER under output/runs/<app>/<id>/ - the user's PC keeps
    nothing after a run. The zip is built on the fly and never stored on disk.
    Ownership check matches get_transaction_report: plain users only see their
    own runs, admins see all."""
    import io, zipfile as _zf

    txn = _authorized_txn(transaction_id, current_user, "export")

    buf = io.BytesIO()
    added = 0
    with _zf.ZipFile(buf, "w", compression=_zf.ZIP_DEFLATED) as zf:

        # 1. Recording JSON (the source recording)
        for f_entry in (txn.get("files") or []):
            p = Path(f_entry.get("folder_path", "")) / f_entry.get("file_name", "")
            if p.exists() and p.suffix == ".json" and p.parent.resolve().is_relative_to((ROOT / "recordings").resolve()):
                zf.write(p, f"recording/{p.name}")
                added += 1
                break  # only the first (the recording JSON itself)

        # 2. Generated scripts + locators
        run_dir = None
        for f_entry in (txn.get("files") or []):
            candidate = Path(f_entry.get("folder_path", ""))
            if "runs" in candidate.parts:
                # Walk up to find the transaction root (the dir containing features/)
                for d in [candidate] + list(candidate.parents):
                    if (d / "features").exists() or (d / "pages").exists():
                        run_dir = d
                        break
            if run_dir:
                break

        if run_dir and run_dir.exists():
            for rel in ("features/recorded.feature", "features/steps/recorded_steps.py",
                        "pages/recorded_page.py", "pages/locators.json"):
                fp = run_dir / rel
                if fp.exists():
                    zf.write(fp, f"scripts/{fp.name}")
                    added += 1

            # 3. Screenshots
            shots_dir = run_dir / "screenshots"
            if txn.get("screenshots_folder"):
                shots_dir = Path(txn["screenshots_folder"])
            if shots_dir.exists():
                for shot in sorted(shots_dir.glob("step_*.png")):
                    zf.write(shot, f"screenshots/{shot.name}")
                    added += 1

            # 4. Exit report
            report_p = run_dir / "exit_report.txt"
            if not report_p.exists() and txn.get("report_file"):
                report_p = Path(txn["report_file"])
            if report_p.exists():
                zf.write(report_p, "exit_report.txt")
                added += 1

    if added == 0:
        raise HTTPException(status_code=404, detail="No files found for this transaction - they may have been cleaned up.")

    buf.seek(0)
    app_name = txn.get("transaction_name", "flow").replace(" ", "_")
    zip_name = f"{app_name}_{transaction_id}_flow.zip"
    from starlette.responses import StreamingResponse
    return StreamingResponse(
        buf,
        media_type="application/zip",
        headers={"Content-Disposition": f'attachment; filename="{zip_name}"'},
    )


@app.get("/api/admin/applications")
def get_applications_summary(current_user: CurrentUser = Depends(get_current_user)):
    """Admin-only summary of every application folder on disk - how many
    recordings, how many runs, when last used. The frontend admin page uses
    this to give an overview of which applications are being tested and
    how active each one is."""
    if current_user.role != "admin":
        raise HTTPException(status_code=403, detail="Admin only.")

    recordings_root = ROOT / "recordings"
    runs_root = ROOT / "output" / "runs"

    # Collect all recordings grouped by application
    apps: dict = {}  # app_name -> {recordings, runs, last_run_at}

    if recordings_root.exists():
        # Subfolder recordings
        for subdir in recordings_root.iterdir():
            if not subdir.is_dir() or subdir.name in ("versions", "imports"):
                continue
            count = len(list(subdir.glob("*.json")))
            if count:
                apps.setdefault(subdir.name, {"recording_count": 0, "run_count": 0, "last_run_at": None})
                apps[subdir.name]["recording_count"] += count
        # Flat (Others) recordings
        flat = len(list(recordings_root.glob("*.json")))
        if flat:
            apps.setdefault("Others", {"recording_count": 0, "run_count": 0, "last_run_at": None})
            apps["Others"]["recording_count"] += flat

    # Collect run counts and last_run_at per application
    if runs_root.exists():
        for app_dir in runs_root.iterdir():
            if not app_dir.is_dir():
                continue
            app_key = app_dir.name
            apps.setdefault(app_key, {"recording_count": 0, "run_count": 0, "last_run_at": None})
            for run_dir in app_dir.iterdir():
                if not run_dir.is_dir():
                    continue
                apps[app_key]["run_count"] += 1
                report = run_dir / "exit_report.txt"
                if report.exists():
                    mtime = report.stat().st_mtime
                    from datetime import datetime as _dt
                    ts = _dt.utcfromtimestamp(mtime).isoformat()
                    if apps[app_key]["last_run_at"] is None or ts > apps[app_key]["last_run_at"]:
                        apps[app_key]["last_run_at"] = ts

    return [{"application": k, **v} for k, v in sorted(apps.items())]


