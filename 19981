"""Execution + step persistence, shared by the pipeline and the API."""
from __future__ import annotations

import uuid
from datetime import datetime, timezone
from typing import Any, Optional

from ..core import db
from ..core.logging_conf import get_logger

log = get_logger(__name__)

PHASES = (
    "launch", "login", "password_change", "relogin", "search",
    "transaction", "logout", "teller_reset", "report",
)


def new_uid(transaction_id: str) -> str:
    return f"exec_{transaction_id}_{datetime.now(timezone.utc):%Y%m%d_%H%M%S}_" \
           f"{uuid.uuid4().hex[:6]}"


def create(
    transaction_id: str,
    environment: str,
    profile_name: str | None,
    thread_id: str,
    transaction_pk: Optional[int] = None,
) -> dict[str, Any]:
    profile_pk = None
    if profile_name:
        row = db.query_one(
            "SELECT id FROM test_data_profiles WHERE name=%s", (profile_name,)
        )
        profile_pk = row["id"] if row else None
    uid = new_uid(transaction_id)
    execution = db.insert_returning(
        """
        INSERT INTO executions
          (execution_uid, transaction_id, transaction_pk, environment,
           profile_pk, status, thread_id)
        VALUES (%s,%s,%s,%s,%s,'running',%s)
        RETURNING *
        """,
        (uid, transaction_id, transaction_pk, environment.upper(),
         profile_pk, thread_id),
    )
    log.info("Execution %s created", uid)
    return execution or {}


def add_step(
    execution_pk: int,
    sequence: int,
    phase: str,
    step_name: str,
    status: str,
    duration_ms: int | None = None,
    screenshot_ref: str | None = None,
    error_msg: str | None = None,
    detail: dict[str, Any] | None = None,
) -> int:
    row = db.insert_returning(
        """
        INSERT INTO execution_steps
          (execution_pk, sequence, phase, step_name, status, duration_ms,
           screenshot_ref, error_msg, detail)
        VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s::jsonb)
        RETURNING id
        """,
        (execution_pk, sequence, phase, step_name, status, duration_ms,
         screenshot_ref, (error_msg or "")[:4000] or None,
         db.jsonb(detail or {})),
    )
    return int((row or {}).get("id", 0))


def finish(
    execution_pk: int,
    status: str,
    error_summary: str | None = None,
    metrics: dict[str, Any] | None = None,
    report_path: str | None = None,
    report_id: str | None = None,
) -> None:
    db.execute(
        """
        UPDATE executions
        SET status=%s, error_summary=%s, metrics=%s::jsonb,
            report_path=%s, report_id=%s, finished_at=now()
        WHERE id=%s
        """,
        (status, (error_summary or "")[:4000] or None, db.jsonb(metrics or {}),
         report_path, report_id, execution_pk),
    )


def set_password_change(execution_pk: int, status: str) -> None:
    db.execute(
        "UPDATE executions SET password_change_status=%s WHERE id=%s",
        (status, execution_pk),
    )


def set_teller_reset(execution_pk: int, status: str, response: str) -> None:
    db.execute(
        "UPDATE executions SET teller_reset_status=%s, teller_reset_response=%s"
        " WHERE id=%s",
        (status, (response or "")[:2000], execution_pk),
    )


def get(execution_uid: str) -> Optional[dict[str, Any]]:
    execution = db.query_one(
        "SELECT * FROM executions WHERE execution_uid=%s", (execution_uid,)
    )
    if not execution:
        return None
    execution["steps"] = db.query(
        "SELECT * FROM execution_steps WHERE execution_pk=%s ORDER BY sequence",
        (execution["id"],),
    )
    execution["self_heal"] = db.query(
        "SELECT * FROM self_heal_log WHERE execution_pk=%s ORDER BY created_at",
        (execution["id"],),
    )
    return execution


def recent(limit: int = 50, transaction_id: str | None = None) -> list[dict[str, Any]]:
    if transaction_id:
        return db.query(
            "SELECT * FROM executions WHERE transaction_id=%s"
            " ORDER BY started_at DESC LIMIT %s",
            (transaction_id, limit),
        )
    return db.query(
        "SELECT * FROM executions ORDER BY started_at DESC LIMIT %s", (limit,)
    )


def dashboard_stats() -> dict[str, Any]:
    totals = db.query_one(
        """
        SELECT COUNT(*) AS total,
               COUNT(*) FILTER (WHERE status='passed')  AS passed,
               COUNT(*) FILTER (WHERE status='failed')  AS failed,
               COUNT(*) FILTER (WHERE status='running') AS running
        FROM executions
        """
    ) or {}
    total_n = totals.get("total") or 0
    passed_n = totals.get("passed") or 0
    totals["success_rate"] = round(passed_n * 100 / total_n) if total_n else 0
    by_txn = db.query(
        """
        SELECT transaction_id,
               COUNT(*) AS runs,
               COUNT(*) FILTER (WHERE status='passed') AS passed,
               MAX(started_at) AS last_run
        FROM executions GROUP BY transaction_id ORDER BY last_run DESC LIMIT 25
        """
    )
    heals = db.query_one("SELECT COUNT(*) AS n FROM self_heal_log WHERE applied") or {}
    return {
        "totals": totals,
        "by_transaction": by_txn,
        "self_heals_applied": heals.get("n", 0),
    }
