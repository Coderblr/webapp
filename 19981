"""
excel_store.py

Persistence for Layer B - the user execution recording dataset.

    Excel <-> Pandas DataFrame <-> List[ActionRecord]

This is intentionally the *only* place that knows the Excel column schema,
so the executor, the recorder's artifact writer, and the self-healing
"update Excel" step all share one implementation.
"""
from __future__ import annotations

from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd

from backend.storage.models import ActionRecord, FramePath

EXECUTION_COLUMNS = [
    "Step_Number",
    "Action",
    "Page_URL",
    "Page_Title",
    "Element_Name",
    "Element_Text",
    "Element_Tag",
    "Primary_Locator_Type",
    "Primary_Locator",
    "Fallback_Locator_1",
    "Fallback_Locator_2",
    "Fallback_Locator_3",
    "Value",
    "Test_Data_Key",
    "Captured_As",
    "Resolved_Variable",
    "Frame_Path",
    "Window_Context",
    "Modal_Context",
    "Wait_Condition",
    "Optional_Step",
    "Expected_Result",
    "Screenshot",
]


class ExcelStore:
    """Reads/writes the execution.xlsx dataset for a recording."""

    def __init__(self, excel_path: Path):
        self.excel_path = excel_path

    # ------------------------------------------------------------------
    def write(self, actions: List[ActionRecord]) -> None:
        rows = [a.to_flat_row() for a in actions]
        df = pd.DataFrame(rows, columns=EXECUTION_COLUMNS)
        self.excel_path.parent.mkdir(parents=True, exist_ok=True)
        with pd.ExcelWriter(self.excel_path, engine="openpyxl") as writer:
            df.to_excel(writer, index=False, sheet_name="Execution")
            self._autosize(writer, df)

    @staticmethod
    def _autosize(writer: pd.ExcelWriter, df: pd.DataFrame) -> None:
        ws = writer.sheets["Execution"]
        for i, col in enumerate(df.columns, start=1):
            max_len = max([len(str(col))] + [len(str(v)) for v in df[col].astype(str).tolist()])
            ws.column_dimensions[ws.cell(row=1, column=i).column_letter].width = min(max_len + 2, 60)

    def read(self) -> pd.DataFrame:
        if not self.excel_path.exists():
            return pd.DataFrame(columns=EXECUTION_COLUMNS)
        return pd.read_excel(self.excel_path, sheet_name="Execution", engine="openpyxl")

    def read_rows(self) -> List[Dict[str, Any]]:
        df = self.read()
        return df.fillna("").to_dict(orient="records")

    def update_locator(
        self, step_number: int, new_locator_type: str, new_locator: str
    ) -> bool:
        """Used by the self-healing update cycle: once a healed locator is
        validated it is written back into the Excel so future executions
        are fast again."""
        df = self.read()
        if df.empty:
            return False
        mask = df["Step_Number"] == step_number
        if not mask.any():
            return False
        df.loc[mask, "Primary_Locator_Type"] = new_locator_type
        df.loc[mask, "Primary_Locator"] = new_locator
        with pd.ExcelWriter(self.excel_path, engine="openpyxl") as writer:
            df.to_excel(writer, index=False, sheet_name="Execution")
            self._autosize(writer, df)
        return True

    def update_row(self, step_number: int, updates: Dict[str, Any]) -> bool:
        """Applies a partial edit (only the given columns) to one row -
        used by the "edit before execution" UI so a user can fix a value
        the recorder missed/mis-captured (spec: the Excel dataset is the
        editable source of truth for the fast execution path) without
        having to resend every column for every other row."""
        df = self.read()
        if df.empty:
            return False
        mask = df["Step_Number"] == step_number
        if not mask.any():
            return False
        for col, val in updates.items():
            if col not in EXECUTION_COLUMNS or col == "Step_Number":
                continue
            df.loc[mask, col] = val
        with pd.ExcelWriter(self.excel_path, engine="openpyxl") as writer:
            df.to_excel(writer, index=False, sheet_name="Execution")
            self._autosize(writer, df)
        return True

    def write_rows(self, rows: List[Dict[str, Any]]) -> None:
        """Overwrites the whole sheet from already-flat row dicts (e.g. the
        full edited table posted back by the "edit before execution" UI).
        Unlike `write()` this does not go through ActionRecord - callers
        are expected to have started from `read_rows()` output so the
        column shape already matches."""
        clean_rows = []
        for row in rows:
            clean_rows.append({col: row.get(col, "") for col in EXECUTION_COLUMNS})
        df = pd.DataFrame(clean_rows, columns=EXECUTION_COLUMNS)
        self.excel_path.parent.mkdir(parents=True, exist_ok=True)
        with pd.ExcelWriter(self.excel_path, engine="openpyxl") as writer:
            df.to_excel(writer, index=False, sheet_name="Execution")
            self._autosize(writer, df)

    def append(self, action: ActionRecord) -> None:
        rows = self.read_rows()
        rows.append(action.to_flat_row())
        df = pd.DataFrame(rows, columns=EXECUTION_COLUMNS)
        with pd.ExcelWriter(self.excel_path, engine="openpyxl") as writer:
            df.to_excel(writer, index=False, sheet_name="Execution")
            self._autosize(writer, df)
