@app.post("/api/recordings/start")
def start_recording(req: StartRecordingRequest, request: Request) -> Dict[str, Any]:
    if not req.target_url.strip():
        raise HTTPException(400, "target_url is required")
    try:
        session = RecorderManager.start_recording(
            req.name or "Untitled Recording", req.target_url.strip(), req.browser,
            remote_node_url=(req.remote_node_url or "").strip() or None,
        )
    except Exception as exc:
        logger.error("Failed to start recording: %s", exc)
        raise HTTPException(500, f"Failed to launch browser/recorder: {exc}")
    user = request.state.user
    activity_log.record(
        user.user_id, user.username, "start_recording",
        recording_id=session.recording_id, details={"name": req.name, "target_url": req.target_url},
    )
    return {"recording_id": session.recording_id, "status": session.status}


@app.post("/api/recordings/{recording_id}/pause")
def pause_recording(recording_id: str) -> Dict[str, Any]:
    session = RecorderManager.get(recording_id)
    if not session:
        raise HTTPException(404, "Recording session not active")
    session.pause()
    return {"status": session.status}


@app.post("/api/recordings/{recording_id}/resume")
def resume_recording(recording_id: str) -> Dict[str, Any]:
    session = RecorderManager.get(recording_id)
    if not session:
        raise HTTPException(404, "Recording session not active")
    session.resume()
    return {"status": session.status}


@app.post("/api/recordings/{recording_id}/stop")
def stop_recording(recording_id: str, request: Request) -> Dict[str, Any]:
    summary = RecorderManager.stop_recording(recording_id)
    if summary is None:
        raise HTTPException(404, "Recording session not active")
    user = request.state.user
    activity_log.record(user.user_id, user.username, "stop_recording", recording_id=recording_id)
    return summary


@app.delete("/api/recordings/{recording_id}/actions/{step_number}")
def delete_recorded_action(recording_id: str, step_number: int) -> Dict[str, Any]:
    """Deletes one already-recorded action from an in-progress recording
    session - e.g. a transaction that failed partway through and shouldn't
    be saved/replayed. Only works while the recording is still active;
    once stopped, edit the Excel dataset instead (Execute Recording ->
    Review & Edit Steps -> tick Remove)."""
    session = RecorderManager.get(recording_id)
    if not session:
        raise HTTPException(404, "Recording session not active - actions can only be deleted while recording is in progress. Once stopped, use Review & Edit Steps instead.")
    ok = session.delete_action(step_number)
    if not ok:
        raise HTTPException(404, f"Step {step_number} not found in the current recording")
    return {"deleted": True, "step_number": step_number, "remaining_steps": len(session.actions)}


