"""
Application registry bootstrap / reconciliation (idempotent - safe on every start, safe to run repeatedly).

What it does
  * Creates the `applications` / `user_application_access` tables (db.init_db does that via create_all - this
    module only fills the registry).
  * Registers: every application in config/applications.yaml, the built-in "Others", and every application that
    already EXISTS in the data - a recordings/<folder>/ directory or a recording JSON "application" field.
  * Names are reconciled case-insensitively (and "DIGI GOV" == "DIGI_GOV" == "digi-gov", see app_names.app_key)
    so legacy data never creates a second row for the same application; genuinely different names stay separate.
    The canonical spelling is the first one found, preferring config/applications.yaml.
  * Never creates a row because a request touched a folder, and never deletes or changes existing rows' names.

What it deliberately does NOT do
  * It does NOT assign any application to any user. Existing non-admin users have no application access until an
    administrator grants it (Admin > Users > Application Access, or tools/grant_application_access.py).
    That is the explicit, administrator-controlled migration policy - see docs/APPLICATION-ACCESS.md.
"""
from __future__ import annotations

import json
import logging
from datetime import datetime
from pathlib import Path
from typing import Optional

from sqlalchemy.orm import Session

from database.app_names import OTHERS, app_key, clean_name
from database.models import Application

log = logging.getLogger("app_access")
ROOT = Path(__file__).resolve().parents[1]
RECORDINGS_DIR = ROOT / "recordings"
APPLICATIONS_YAML = ROOT / "config" / "applications.yaml"
_SKIP_DIRS = {"versions", "imports", "solution_documents", "change_analysis", "fixtures", "__pycache__"}


def _yaml_apps() -> dict[str, str]:
    try:
        import yaml
        if APPLICATIONS_YAML.exists():
            data = yaml.safe_load(APPLICATIONS_YAML.read_text(encoding="utf-8")) or {}
            return {str(k): (str(v).strip() if v else "") for k, v in (data.get("applications") or {}).items()}
    except Exception:  # noqa: BLE001 - a bad config file must not stop the server starting
        log.exception("Could not read config/applications.yaml for the application registry")
    return {}


def discover_names() -> list[tuple[str, Optional[str], str]]:
    """(name, base_url, source) in priority order: yaml, Others, recording folders, recording JSON fields."""
    found: list[tuple[str, Optional[str], str]] = []
    for name, url in _yaml_apps().items():
        found.append((clean_name(name), url or None, "config"))
    found.append((OTHERS, None, "builtin"))
    if RECORDINGS_DIR.is_dir():
        for d in sorted(RECORDINGS_DIR.iterdir()):
            if d.is_dir() and d.name not in _SKIP_DIRS:
                found.append((clean_name(d.name.replace("_", " ") if " " not in d.name else d.name), None, "folder"))
        for f in RECORDINGS_DIR.rglob("*.json"):
            if any(part in _SKIP_DIRS for part in f.parts):
                continue
            try:
                app = (json.loads(f.read_text(encoding="utf-8")) or {}).get("application")
            except (OSError, ValueError, AttributeError):
                continue
            if app and str(app).strip():
                found.append((clean_name(str(app)), None, "recording"))
    return found


def reconcile_applications(session: Session) -> dict:
    """Insert registry rows that do not exist yet (matched by app_key). Returns counts."""
    existing = {a.name_key: a for a in session.query(Application).all()}
    created, updated = 0, 0
    for name, url, source in discover_names():
        key = app_key(name)
        row = existing.get(key)
        if row is None:
            # A folder name like "DIGI_GOV" is only used if nothing better (yaml / JSON spelling) registered first.
            row = Application(name=name, name_key=key, display_name=name, base_url=url, status="Active")
            session.add(row)
            session.flush()
            existing[key] = row
            created += 1
        elif url and row.base_url != url and (source == "config" or not row.base_url):  # yaml is the source of truth for URLs
            row.base_url = url
            row.updated_at = datetime.utcnow()
            updated += 1
    return {"created": created, "updated": updated, "total": len(existing)}


def run(session: Session) -> dict:
    out = reconcile_applications(session)
    if out["created"]:
        log.info("[app-access] registered %d new application(s); %d total", out["created"], out["total"])
    return out
