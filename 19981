# Fixed pause applied after every click/double-click/right-click during
# execution (see ActionEngine.click()/double_click()/right_click()),
# on top of whatever Playwright's own actionability retries already
# took. Real target apps (esp. ones talking to a slow backend) can take
# a moment AFTER a click before the resulting nav/re-render/toast is
# actually settled - a step that fires immediately can outrun that,
# hitting an element that's mid-transition or not yet updated. This is
# a blunt, deliberately simple fix: give the app a fixed window to
# catch up before the NEXT step's locator gets resolved, rather than
# something adaptive. Set to "0" to disable entirely.
POST_CLICK_WAIT_SECONDS: float = float(os.getenv("POST_CLICK_WAIT_SECONDS", "3"))
