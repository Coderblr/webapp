"""Recorder Agent — drives the recording session (Section 5 / 10)."""
from __future__ import annotations

from typing import Any

from ..core import db
from ..knowledge import repository as repo, versioning
from ..recorder import cdp_recorder, semantic_interpreter
from ..tdm import field_meta, templates as tdm_templates
from .base import AgentResult, BaseAgent


class RecorderAgent(BaseAgent):
    name = "RecorderAgent"
    context_type = "recording"

    def run(self, action: str = "start", **kwargs: Any) -> AgentResult:
        if action == "start":
            return self._start(**kwargs)
        if action == "stop":
            return self._stop(**kwargs)
        if action == "status":
            session = cdp_recorder.get_session(kwargs["session_uid"])
            return AgentResult(ok=bool(session),
                               info=session.info() if session else {})
        if action == "crawl":
            session = cdp_recorder.get_session(kwargs["session_uid"])
            return AgentResult(ok=bool(session),
                               stats=session.force_crawl() if session else {})
        if action == "pause":
            session = cdp_recorder.get_session(kwargs["session_uid"])
            if not session:
                return AgentResult(ok=False, error=f"unknown session {kwargs['session_uid']}")
            return AgentResult(ok=True, info=session.pause())
        if action == "resume":
            session = cdp_recorder.get_session(kwargs["session_uid"])
            if not session:
                return AgentResult(ok=False, error=f"unknown session {kwargs['session_uid']}")
            return AgentResult(ok=True, info=session.resume())
        if action == "persist":
            return self._persist(**kwargs)
        if action == "discard":
            return self._discard(**kwargs)
        return AgentResult(ok=False, error=f"unknown action {action}")

    # ── start / stop ────────────────────────────────────────────────────
    def _start(self, **kwargs: Any) -> AgentResult:
        transaction_id = kwargs["transaction_id"]
        from ..knowledge import rag
        knowledge = rag.knows_transaction(transaction_id)
        self.record(
            f"Recording requested for {transaction_id}; prior knowledge = "
            f"{knowledge['level']}",
            transaction_id=transaction_id, rationale=str(knowledge),
        )
        info = cdp_recorder.start_session(**kwargs)
        return AgentResult(ok=True, session=info, prior_knowledge=knowledge)

    def _stop(self, session_uid: str, **_: Any) -> AgentResult:
        manifest = cdp_recorder.stop_session(session_uid)
        return AgentResult(ok=True, manifest=manifest,
                           awaiting_decision=True,
                           message="Recording stopped — Keep or Discard "
                                   "before anything is converted to code.")

    # ── keep (persist into the knowledge repository) ────────────────────
    def _persist(self, session_uid: str, **_: Any) -> AgentResult:
        session = cdp_recorder.get_session(session_uid)
        if session is None:
            return AgentResult(ok=False, error=f"unknown session {session_uid}")
        manifest = session.store.read_manifest() or session.build_manifest()

        transaction_id = manifest["transaction_id"]
        txn = versioning.open_new_version(
            transaction_id=transaction_id,
            name=manifest["transaction_name"],
            transaction_type=manifest.get("transaction_type", "business"),
            description=manifest.get("description"),
        )
        transaction_pk = int(txn["id"])
        version = txn["version"]

        db.execute(
            "UPDATE transactions SET workflow_path=%s::jsonb,"
            " knowledge_json=%s::jsonb WHERE id=%s",
            (db.jsonb(manifest.get("workflow_path", [])),
             db.jsonb(manifest.get("stats", {})), transaction_pk),
        )

        page_pks: dict[str, int] = {}
        for page in manifest.get("pages", []):
            page_pks[page["page_key"]] = repo.save_page(transaction_pk, page)
        for element in manifest.get("elements", []):
            repo.save_element(
                transaction_pk, page_pks.get(element.get("page_key")), element
            )
        repo.save_actions(transaction_pk, manifest.get("actions", []))

        rules = [
            {"field_name": None, "rule_type": "message",
             "message_text": message["text"], "severity": message.get("severity"),
             "meta": {"page_key": message.get("page_key")}}
            for message in manifest.get("messages", [])
        ]
        repo.save_validation_rules(transaction_pk, rules)

        # field metadata for the TDM engine (Section 7.2)
        elements_by_key = {e["element_key"]: e for e in manifest.get("elements", [])}
        allow_sensitive = bool(
            manifest.get("capture_recorded_values") and manifest.get("capture_sensitive_values")
        )
        fields: list[dict[str, Any]] = []
        seen: set[str] = set()
        for action in manifest.get("actions", []):
            if action.get("action") not in ("type", "select", "upload"):
                continue
            name = action.get("value_ref") or action.get("field_name")
            if not name or name in seen:
                continue
            seen.add(name)
            element = elements_by_key.get(action.get("element_key") or "", {})
            fields.append(field_meta.build(
                name, element.get("meta"), element_key=action.get("element_key"),
                recorded_value=(action.get("meta") or {}).get("recorded_value"),
                allow_sensitive_recorded_value=allow_sensitive,
            ))
        tdm_templates.save_field_metadata(transaction_pk, fields)

        repo.write_package_file(transaction_id, version, "manifest.json", manifest)
        repo.write_package_file(transaction_id, version, "locators.json",
                                manifest.get("elements", []))
        repo.write_package_file(transaction_id, version, "workflow.json",
                                manifest.get("workflow_path", []))
        repo.embed_transaction_knowledge(transaction_pk, transaction_id)

        # Section 24 — optional, post-recording only (never per-event).
        # Grounded strictly in the already-captured steps; see that
        # module's docstring for the hallucination guard. Failure here
        # must never block Keep — the recording is already fully usable
        # without it.
        interpretation = None
        try:
            interpretation = semantic_interpreter.interpret(manifest)
        except Exception as exc:  # noqa: BLE001
            self.log.warning("Semantic interpretation failed (continuing): %s", exc)
        if interpretation:
            repo.write_package_file(transaction_id, version, "interpretation.json",
                                    interpretation)
            if interpretation.get("workflow_summary"):
                try:
                    from ..core import vectorstore
                    vectorstore.upsert(
                        "workflow", interpretation["workflow_summary"],
                        ref_type="ai_interpretation", ref_id=transaction_id,
                        transaction_id=transaction_id, source="ai_interpretation",
                        meta={"steps": interpretation.get("steps", [])},
                    )
                except Exception as exc:  # noqa: BLE001
                    self.log.warning("Could not embed workflow interpretation: %s", exc)

        db.execute(
            "UPDATE recording_sessions SET status='kept' WHERE session_uid=%s",
            (session_uid,),
        )
        self.record(
            f"Kept recording {session_uid} as {transaction_id} v{version}",
            transaction_id=transaction_id, outcome="success", confidence=1.0,
            meta=manifest.get("stats", {}),
        )
        return AgentResult(
            ok=True, transaction_pk=transaction_pk, transaction_id=transaction_id,
            version=version, fields=fields, manifest=manifest,
            stats=manifest.get("stats", {}),
        )

    # ── discard ─────────────────────────────────────────────────────────
    def _discard(self, session_uid: str, reason: str | None = None, **_: Any) -> AgentResult:
        session = cdp_recorder.get_session(session_uid)
        if session:
            session.store.discard()
            cdp_recorder.drop_session(session_uid)
        db.execute(
            "UPDATE recording_sessions SET status='discarded' WHERE session_uid=%s",
            (session_uid,),
        )
        self.record(f"Discarded recording {session_uid}", rationale=reason,
                    outcome="success")
        return AgentResult(ok=True, discarded=session_uid, reason=reason)
