"""Modules 1–14 — AI Knowledge Capture Engine.

Launches a real Microsoft Edge via the local msedgedriver, injects the capture
script into every document, polls the event buffer, and persists:
actions, all locator strategies, full-page crawls, DOM before/after snapshots,
screenshots, popup/validation messages, test data (masked), dropdown/table
knowledge, network calls (via performance logs), and performance metrics.
"""
import asyncio
import hashlib
import json
import logging
import re
import threading
import time
from pathlib import Path

from selenium import webdriver
from selenium.webdriver.edge.options import Options as EdgeOptions
from selenium.webdriver.edge.service import Service as EdgeService

from .. import config
from ..models import (Element, Locator, NetworkCall, PageSnapshot, Recording,
                      RecordedAction, SessionLocal, TestDataField,
                      ValidationMessage, now)
from . import locators as locator_engine
from . import ui_versioning

log = logging.getLogger("platform.recorder")
CAPTURE_JS = (Path(__file__).parent / "capture_script.js").read_text()

_active: dict[int, "RecorderSession"] = {}


def _artifact(recording_id: int, name: str, data: bytes | str) -> str:
    d = config.ARTIFACTS_DIR / f"rec_{recording_id}"
    d.mkdir(exist_ok=True)
    p = d / name
    if isinstance(data, str):
        p.write_text(data, encoding="utf-8")
    else:
        p.write_bytes(data)
    return str(p)


def _mask_value(field_name: str, value: str, settings: dict) -> tuple[str, bool]:
    key = re.sub(r"[^a-z0-9]", "", (field_name or "").lower())
    for m in settings["mask_fields"]:
        if re.sub(r"[^a-z0-9]", "", m) in key:
            return "***MASKED***", True
    return value, False


class RecorderSession:
    """One live recording session in a dedicated Edge window."""

    def __init__(self, recording_id: int, transaction: str, url: str):
        self.recording_id = recording_id
        self.transaction = transaction
        self.url = url
        self.stop_flag = threading.Event()
        self.live_status = {"actions": 0, "screens": 0, "elements": 0, "messages": 0}
        self._seen_screens: set[str] = set()
        self._last_dom: str | None = None

    # ---------- driver ----------
    def _driver(self):
        settings = config.load_settings()
        opts = EdgeOptions()
        opts.add_argument("--start-maximized")
        # dedicated profile so it never conflicts with the Execution Engine session
        opts.add_argument(f"--user-data-dir={config.DATA_DIR / 'edge_recorder_profile'}")
        opts.set_capability("ms:loggingPrefs", {"performance": "ALL"})  # Module 12
        if settings.get("edge_binary_path"):
            opts.binary_location = settings["edge_binary_path"]
        service = EdgeService(executable_path=settings["edgedriver_path"])
        driver = webdriver.Edge(service=service, options=opts)
        # inject capture script into every new document
        driver.execute_cdp_cmd("Page.addScriptToEvaluateOnNewDocument", {"source": CAPTURE_JS})
        return driver

    # ---------- main loop ----------
    def run(self):
        settings = config.load_settings()
        db = SessionLocal()
        driver = None
        try:
            driver = self._driver()
            driver.get(self.url)

            driver.execute_script(CAPTURE_JS)  # first page
            self._capture_page(db, driver)     # Module 4 crawl on load
            last_url = driver.current_url
            while not self.stop_flag.is_set():
                time.sleep(0.7)
                try:
                    if driver.current_url != last_url:      # navigation → crawl (M4, M11)
                        last_url = driver.current_url
                        driver.execute_script(CAPTURE_JS)
                        self._capture_page(db, driver)
                    events = driver.execute_script(
                        "var e=(window.__aikce||{}).events||[];"
                        "if(window.__aikce)window.__aikce.events=[];return e;")
                    for ev in events or []:
                        self._persist_event(db, driver, ev, settings)
                except Exception as e:  # page transition race — reinject and continue
                    if "no such window" in str(e).lower():
                        break
                    try:
                        driver.execute_script(CAPTURE_JS)
                    except Exception:
                        pass
            db.query(Recording).filter_by(id=self.recording_id).update(
                {"status": "stopped", "stopped_at": now()})
            db.commit()
        finally:
            if driver:
                try:
                    driver.quit()
                except Exception:
                    pass
            db.close()
            _active.pop(self.recording_id, None)

    # ---------- persistence ----------
    def _capture_page(self, db, driver):
        """Module 4/5/6/24: full-page crawl + DOM + screenshot + UI version."""
        try:
            page = driver.execute_script("return window.__aikce.crawlPage();")
        except Exception:
            return
        screen = (page.get("title") or page["url"]).strip()[:120] or "unknown"
        idx = len(self._seen_screens)
        dom_path = _artifact(self.recording_id, f"dom_{idx}_{hashlib.md5(page['url'].encode()).hexdigest()[:8]}.html",
                             page["dom"])
        shot = driver.get_screenshot_as_png()
        shot_path = _artifact(self.recording_id, f"screen_{idx}.png", shot)
        snap = PageSnapshot(recording_id=self.recording_id,
                            transaction_number=self.transaction,
                            screen_name=screen, url=page["url"],
                            dom_path=dom_path, html_path=dom_path,
                            screenshot_path=shot_path,
                            element_inventory={"count": len(page["inventory"]),
                                               "perf": page.get("perf", {})})
        db.add(snap)
        # register every crawled element + all its locators (M3/M15)
        for meta in page["inventory"]:
            locator_engine.register_element(db, self.transaction, screen, meta)
        db.commit()
        self._seen_screens.add(screen)
        self.live_status["screens"] = len(self._seen_screens)
        self.live_status["elements"] += len(page["inventory"])
        self._last_dom = page["dom"]
        # Module 24: version this screen proactively
        ui_versioning.register_ui_version(db, screen, "recording", page["dom"], shot_path)
        # Module 12: drain performance log → network calls
        self._capture_network(db, driver)

    def _capture_network(self, db, driver):
        try:
            logs = driver.get_log("performance")
        except Exception:
            return
        reqs: dict[str, dict] = {}
        for entry in logs:
            try:
                msg = json.loads(entry["message"])["message"]
            except Exception:
                continue
            p = msg.get("params", {})
            if msg.get("method") == "Network.requestWillBeSent":
                r = p.get("request", {})
                if any(x in r.get("url", "") for x in ("api", "rest", "graphql", "service", "soap", "json")):
                    reqs[p["requestId"]] = {"method": r.get("method"), "url": r.get("url"),
                                            "start": p.get("timestamp", 0),
                                            "headers": {k: ("***" if "auth" in k.lower() or "cookie" in k.lower() else v)
                                                        for k, v in r.get("headers", {}).items()}}
            elif msg.get("method") == "Network.responseReceived" and p.get("requestId") in reqs:
                r = reqs.pop(p["requestId"])
                resp = p.get("response", {})
                url = r["url"].lower()
                db.add(NetworkCall(
                    recording_id=self.recording_id, transaction_number=self.transaction,
                    api_type="graphql" if "graphql" in url else "soap" if "soap" in url or url.endswith(".asmx") else "rest",
                    method=r["method"], url=r["url"], status_code=resp.get("status"),
                    response_time_ms=round((p.get("timestamp", 0) - r["start"]) * 1000, 1),
                    headers_masked=r["headers"]))
        db.commit()

    def _persist_event(self, db, driver, ev: dict, settings: dict):
        t = ev.get("target") or {}
        screen = (ev.get("title") or ev.get("url") or "")[:120]
        element = locator_engine.register_element(db, self.transaction, screen, t) if t.get("tag") else None

        if ev["type"] == "message":                       # Module 7
            shot = _artifact(self.recording_id, f"msg_{ev['seq']}.png",
                             driver.get_screenshot_as_png())
            text = ev["extra"].get("text", "")
            kind = ("failure" if re.search(r"fail|error|invalid|denied", text, re.I)
                    else "success" if re.search(r"success|complete|saved", text, re.I)
                    else "warning" if re.search(r"warn", text, re.I) else "info")
            code = (re.search(r"\b[A-Z]{2,5}-?\d{2,6}\b", text) or [None])
            db.add(ValidationMessage(recording_id=self.recording_id,
                                     transaction_number=self.transaction, kind=kind,
                                     text=text, error_code=code.group(0) if code else None,
                                     screenshot_path=shot))
            self.live_status["messages"] += 1
            db.commit()
            return

        value_masked, sensitive = None, False
        if ev["type"] == "change":                        # Module 8/9
            raw = ev["extra"].get("value", "")
            field = t.get("name") or t.get("id") or t.get("label") or t.get("placeholder") or "field"
            value_masked, sensitive = (raw, True) if ev["extra"].get("sensitive") \
                else _mask_value(field, raw, settings)
            db.add(TestDataField(
                transaction_number=self.transaction, screen_name=screen,
                field_name=field, value_masked=value_masked, sensitive=sensitive,
                input_type=t.get("input_type"), mandatory=bool(t.get("required")),
                max_length=t.get("maxlength"), pattern=t.get("pattern"),
                dropdown_options=t.get("options"),
                validation_rules={"required": bool(t.get("required")),
                                  "maxlength": t.get("maxlength"),
                                  "pattern": t.get("pattern")}))

        # Module 5/6: before/after DOM + screenshots
        dom_after = None
        try:
            dom_after = driver.execute_script("return document.documentElement.outerHTML")
        except Exception:
            pass
        shot_after = _artifact(self.recording_id, f"act_{ev['seq']}.png",
                               driver.get_screenshot_as_png())
        dom_before_path = _artifact(self.recording_id, f"dom_before_{ev['seq']}.html",
                                    self._last_dom or "")
        dom_after_path = _artifact(self.recording_id, f"dom_after_{ev['seq']}.html",
                                   dom_after or "")
        self._last_dom = dom_after

        desc = f"{ev['type']} on <{t.get('tag')}> '{(t.get('label') or t.get('text') or t.get('placeholder') or '')[:60]}'"
        db.add(RecordedAction(
            recording_id=self.recording_id, sequence=ev["seq"],
            action_type=ev["type"], page_name=screen, screen_name=screen,
            url=ev.get("url"), description=desc,
            expected_behaviour="Element responds and workflow continues",
            element_id=element.id if element else None,
            value_masked=value_masked,
            dom_before_path=dom_before_path, dom_after_path=dom_after_path,
            screenshot_after=shot_after, extra=ev.get("extra", {})))
        db.commit()
        self.live_status["actions"] += 1


# ---------- public API ----------
def start_recording(transaction: str, url: str) -> int:
    db = SessionLocal()
    rec = Recording(transaction_number=transaction, target_url=url)
    db.add(rec)
    db.commit()
    rid = rec.id
    db.close()
    session = RecorderSession(rid, transaction, url)
    _active[rid] = session
    threading.Thread(target=session.run, daemon=True).start()
    return rid


def stop_recording(recording_id: int) -> bool:
    s = _active.get(recording_id)
    if s:
        s.stop_flag.set()
        return True
    return False


def live_status(recording_id: int) -> dict:
    s = _active.get(recording_id)
    return {"active": bool(s), **(s.live_status if s else {})}
